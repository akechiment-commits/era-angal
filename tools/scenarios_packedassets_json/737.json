  {
    "command": "update_character",
    "id": "center",
    "character": 5,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「僕が卒業したあとも、君咲学院の子たちをそうやって支えてあげてほしい。」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「僕の大好きな、みんなのことを。お願いだよ？」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「あぁ、これで一切の不安がなくなった」"
