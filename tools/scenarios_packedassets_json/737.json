  {
    "command": "update_character",
    "id": "center",
    "character": 5,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「だから、どうしても。いちどぐらいは、勝ちたかったんだ……」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 5,
