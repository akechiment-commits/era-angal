  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「あ～……くたびれた。もう、格好つける余裕もないよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 5,
    "dress": "old-w",
