  {
    "command": "play_voice",
    "asset_code": "web:voice/character/34/habit-10.wav"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "だからお兄ちゃん先輩が試食してくれたら、すっごく助かります"
