  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「理解してもらうことを諦めたんスよ」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「そんなふうに取りかえしがつかなくなるまで、あたしはあの子を放ったらかしにしてしまった」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「今さら……あたしには、あの子にしてあげられることは何もない」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あの子はちがう言語をもつ、ちがう環境で生きている、この惑星に迷いこんだ宇宙人」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしの親友だったあの子は、るりは、そんなふうに遠ざかっていった」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「光の速さで遠ざかるあの子に追いつくには、」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「抱きとめて声をかけるには、光を超える速さで追いかけなくちゃいけなかったのに」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしには、そんな根気はなかった。知恵も勇気もなかった。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「それを理解して、ぜんぶどうでもよくなった。気がつけば、こんな無気力になってたッスよ」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしは、るりと関わることで自分の無力さを思いしった。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「どう足掻いても届かないものがあるって、知ってしまったんスよ」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしには何もできない。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「宇宙の果てに飛んでったあの子を、追いかけることもできない。あたしは、意気地なしッス」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あの子を『あんなふう』にしたのは、あたしなのに」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「謝ることも、できない」"
  },
