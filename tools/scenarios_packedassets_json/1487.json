  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（レンタルした携帯電話と、持参したゲーム機の接続完了。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（こんだけカスタムすれば、ある程度は情報戦だってできる）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（あとで、携帯電話いじった罰金を支払わされるかもだけど）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（いいもん。もしものときはプレミアついてる大事な大事な大事なゲーム機とか、ゴスとか売っちゃう。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（世界にひとりしかいない、先輩を助けるためだもん）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（ふふふ、さすがに天宮先輩ってひともスタンドアローンにしてたゲーム機にまでは手出しできなかったっぽい。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-t-shirt",
    "pose": 0,
    "active": true,
    "expression": "old-t-shirt_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（この子たちは、綺麗なカラダだ……♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-t-shirt",
    "pose": 0,
    "active": true,
