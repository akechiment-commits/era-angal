    "expression": "old-t-shirt_expression/angry",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（コンピ研を甘く見ないでよ、頭のいかれた白兎め～！）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（ネット上に分割保存してたデータをかき集めて、再構築完了！）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（ネットの世界は広大だから！　誰にもすべては見通せない、壊せない！　神さまにだって！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-t-shirt",
    "pose": 0,
    "active": true,
    "expression": "old-t-shirt_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（ゲームは、これからが本番だ……☆）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（あぁ、落ちつく……。やっぱりネットに繋がってないと、頭がおかしくなりそうだった。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（頑丈なだけが取り柄のレンタル携帯電話なのに、愛おしく見えてきた……♪）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（すりすり……♪）"
