    "active": true,
    "expression": "old-t-shirt_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（すぐそばでガチャガチャしちゃって、ちょっと申し訳なかったな）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（藍乃さん……。関係ないのに、ううん『友達だから』って。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（危険な、こんな海外まで一緒にきてくれたんだもん）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（これ以上は、迷惑かけないようにしなきゃ）"
