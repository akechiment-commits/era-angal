    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「わたしもよくコンタクトレンズ落としちゃいますけど――」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 32,
