  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「お、おろろ～？」"
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「な、何やってるんですか、えぇっと先輩？」"
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「屋上の芝生に頭つっこんだりして、捜しものですか？」"
  },
  {
    "command": "update_character",
