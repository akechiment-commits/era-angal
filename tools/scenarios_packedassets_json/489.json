    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「おろ～？　え？　ピッコロですか？　楽しげなのを、演奏すればいいんですか？」"
