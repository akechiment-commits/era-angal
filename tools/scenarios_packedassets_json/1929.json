    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「お年頃ね、三波さんも……」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 13,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
