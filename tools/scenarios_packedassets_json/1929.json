    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「ともあれ、わたくしは絵のモデルには慣れているから。そんなに気を遣わなくても結構よ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 22,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
