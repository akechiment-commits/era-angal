    "dress": "default",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": 6,
      "y": 500
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "ええ。わたしだって、何もせずにのんびり過ごすこともあるんですよ。たまには勉強も部活もせずに、太陽の光を浴びてリラックスする時間も必要ですよね"
