    "pose": 0,
    "active": true,
    "expression": "old-swim_expression/normal",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「わたし、ペンギンさんの捜索を再開したいと思うの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「これ、防水性の携帯電話なの。ひびきんぐ……わたしの友達が、選んでくれたの。」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「水中でも壊れないものを、って」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「番号、教えておくの」"
  },
