    "active": true,
    "expression": "old-swim_expression/surprise",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「というか、あきらかに似顔絵ではない抽象画っぽいものを描いてる気がするの」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-swim",
    "pose": 0,
    "active": true,
    "expression": "old-swim_expression/amazed",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「あのう。あなた……この眼鏡の子の、恋人さん？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-swim",
    "pose": 0,
    "active": true,
    "expression": "old-swim_expression/sad",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「ちがうの？　よくわからないけど、ただ絵の完成を待っていても時間の無駄なの。」"
