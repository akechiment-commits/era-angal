    "dress": "old-swim",
    "pose": 0,
    "active": true,
    "expression": "old-swim_expression/sad",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「ずいぶん、無駄に時間ばかり浪費してしまったの。でも、ちっとも似顔絵は完成しないの。」"
  },
  {
    "command": "update_character",
