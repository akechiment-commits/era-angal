  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「転校生くんも、優しく手ぇ握ってあげてね。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「しずくちゃんを怯えさせないように、……転校生くんには言うまでもないだろうけど」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「しずくちゃん。怖かったら、ゆっくりでもいいよ。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしも、いつもみんなより遅れちゃって、すぐに疲れて止まっちゃうの」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも、みんなのそばにいたいから」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ゆっくりでも歩くよ、胸を張って前を見て。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「苦しくても歯を食いしばって、できれば笑顔で、生きようって決めたから」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そうして今、あなたのそばにいる」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「何度でも言うよ。わたし、生きててよかった」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「生まれてきて、よかった」"
