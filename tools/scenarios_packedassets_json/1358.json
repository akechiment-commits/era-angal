  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ごめんね。手ぇ繋がれるの、苦手だって知ってるけど。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「しずくちゃんの嫌な記憶を、幸せな思い出に塗り替えてみせるからね♪」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「お願い、しずくちゃん。パパとママと、手を繋ごう♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 16,
    "dress": "old-hot",
    "pose": 0,
    "active": true,
    "expression": "old-hot_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしたちは、あなたのほんとのパパやママじゃないけど」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「哀しい記憶を、ほんのちょっぴり……。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あったかいもので上書きすることぐらいはできるって、思いたいよ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「しずくちゃんに、ママって呼ばれて嬉しかった。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたし、きっと長生きできなくて、子供なんかつくれるかわからないから」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「だから、とっても有り難かった……。『おままごと』みたいな、わたしたち。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも、この気持ちは嘘でもお遊びでもないよ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほんの一瞬でも、いいから。あるかどうかもわからない、幸せな未来の空想をさせて」"
  },
