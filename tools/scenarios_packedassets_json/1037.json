  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「……ん、んん？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あれ？　ここ、保健室じゃない？　どこだろう？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「見るからに、おかしな空間だ……。変な植物とか、いっぱい生えてるし。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「くるみちゃんが植えた新種の草花とかじゃないよね、これ？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「どうも生っぽくないというか、遊園地っぽいというか？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「もしかして、これって夢？　わたし、まだ寝てるのかな……？」"
