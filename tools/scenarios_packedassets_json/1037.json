  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-alice",
    "pose": 0,
    "active": true,
    "expression": "old-alice_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ちょっと寝すぎかも、でも真夏は寝ても寝ても疲れがとれないんだよね～♪」"
