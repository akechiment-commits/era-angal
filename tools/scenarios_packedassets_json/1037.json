    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「日差しを浴びただけでフラフラするんだもん、保健室まで辿りつくだけで一苦労だったよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-alice",
    "pose": 0,
    "active": true,
    "expression": "old-alice_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「たしか。保健室に到着して、ベッドで誰か寝てるのを見つけて……。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「看病してるうちに、疲れて寝ちゃったんだっけ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-alice",
    "pose": 0,
    "active": true,
    "expression": "old-alice_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「赤ちゃんみたいだなぁ、わたし。」"
