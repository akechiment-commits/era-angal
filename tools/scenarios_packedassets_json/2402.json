    "character": 56,
    "dress": "winter-civvies",
    "pose": "2",
    "expression": null,
    "expression_position": {
      "x": -16,
      "y": 498
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "いいけどさ。そういうのって、ちょっと珍しくて嬉しくはあるし"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 56,
