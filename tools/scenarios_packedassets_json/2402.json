    "position": {
      "x": -16,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "わっ、事情ぐらい聞きなよ。『わかりました』って財布ごと差しださないでよ、わたしが悪い女だったらどうするの。便利に貢がせて、際限なく搾り取っちゃうよ"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 56,
