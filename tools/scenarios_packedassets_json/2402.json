  {
    "command": "play_voice",
    "asset_code": "web:voice/character/56/emo_worry-1.wav"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "そうだけどさ。でもさ、う～むむ……。女の子どうしと、男の子と女の子じゃやっぱりちがうよ"
