    "active": false,
    "expression": "old-shinsengumi_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「しぃ～っ、静かにして！　あたしが『ここ』にいるってこと、内緒にしてね～？」"
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「あと、『局長さん』って呼ばないでね～？」"
  },
  {
    "command": "update_character",
    "id": "right",
