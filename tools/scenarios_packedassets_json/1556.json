    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ごめんね、休んでばっかりで。わたし、体力ないから……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ここのお茶とお団子、絶品なんだよ。転校生くんも、食べてね♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「お代は心配しないで、わたしお給料もらってるから。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほとんど、お医者さんで使っちゃってるけど。生活に困るほどじゃないから、遠慮しないでね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「はい、あ～ん♪」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（ふふふ。何だか子供ができたみたい、嬉しいなぁ。子供なんて、つくれないと思ってたよ。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（出産に耐えられる身体じゃないしね、わたしには立場もある）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（でも。もしかしたら、『未来のわたし』が……。わたしの、子孫で。）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（つまり、わたしも子供をつくれたとかだったらいいな）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（いや、転校生くんの馬鹿みたいな妄想を信じたわけじゃないけど。幸せな夢を見るぐらい、いいよね？）"
  },
