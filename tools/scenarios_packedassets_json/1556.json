    "id": "2133",
    "timezone": "2"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「コホ、コホ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ふぅ……。一晩ゆっくり寝たら、どうにか体調が戻ってきたよ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「心配かけてごめんね、えっと転校生くん」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「転校生くんが看病してくれたおかげで、動けるぐらいには快復したよ♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「お医者さんには、まだ寝てなくちゃって言われたんだけど。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「横になってると、気分が『どんより』しちゃうからね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「だからお散歩に、付きあってね。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「いちおう新撰組による、城下町の警邏っていうかたちになるかな。お給料ぶんは、働かないとね～♪」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも転校生くん、何でわたしに優しくしてくれるの？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしたち、どっかで会ったことあるかな。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そんなわけないよね、わたし子供のころは外にでたこともなかったし。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「城下町でも、あなたを見かけた覚えはないし～？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「何となぁく、わたしもなぜか親近感をおぼえちゃうんだけど。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「前世で夫婦だったりしたのかな、な～んて……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「悠木さんは、あなたを倒幕派が送りこんだ間諜なんじゃないかって疑ってるみたいだけどね。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あっ悠木さんってわかるよね、うちの新撰組の副長さん」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「局長さんが滅多に顔をださないから、新撰組はだいたい悠木さんが取り仕切ってるよ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほんとは幕府のお偉いさんらしくてね、わたしたち新撰組の後ろ盾になってくれてる」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「だからまぁ、あんまり最前線に立たないでほしいんだけど……。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「偉いひとなんだから、自分を大事にしてもらわないと」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも、悠木さんは斬りあいが好きみたい。あんまり、血なまぐさいのはどうかと思うんだけど」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「気が抜けないよ。悠木さんが大暴れするせいで、新撰組は野獣か怪物みたいに怖がられてるし。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほら、町のひとたちも遠巻きにしてるでしょ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「もっと仲良く、できたらいいんだけど。町の平和を守る、新撰組なんだから」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「英雄だ、正義の味方だってチヤホヤされたいわけじゃないけど。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「みんなには笑顔でいてほしいな、わたしはそのために新撰組に入ったんだ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「って、ごめんね。わたしばっかり喋ってるね、何だか転校生くんは話しやすいなぁ……♪」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほんとに間諜だったら、とっても優秀だね。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ふふふ、わたし転校生くんの監視も命じられてるの。怪しい動きはしないでね、そばにいてね？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも、変な話だよね。転校生くん、未来からきたんだって？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あなたはそう主張してるけど、ちょっと意味がわからないなぁ……。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あなたが、何百年も未来からきたなんて」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「たしかにちょっと、転校生くんって浮き世離れしてるけど」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（う～ん……。未来から、時を超えてきたとか。にわかには、信じられないなぁ。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（でもたしかに、当たり前の常識みたいなこと落っことしてるみたいだし）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（逆に、聞いたこともない知識とかもってるし。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（『君咲学院』って何だろう、寺子屋みたいなものらしいけど。『君咲幕府』とは、ちがうのかな？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（そんな『君咲学院』っていうところで、未来のわたし……わたしの子孫？）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（わたしと同じ顔、同じ名前をした子が転校生くんと一緒にお勉強してるとか）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（何だか、変な感じ。でも、ちょっとそんな『未来のわたし』が羨ましいな）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（刀で武装して、町のひとたちに恐れられながら……。血なまぐさい戦いを、しなくていいんだから）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（な～んて……。まぁ、この転校生くんって子はそういう妄想に取り憑かれてるだけなんだろうけど。）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（可哀想だなぁ、優しくしてあげよう）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（わたしまで引きずられちゃ、駄目だよね。幸せな未来なんて、知りたくなかったな。）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（わたしはこの時代を、この現実を生きていかなくちゃいけないんだから）"
  },
  {
    "command": "set_still_image",
    "id": "card/normal/1154"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あっ、お団子がきた」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
