    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わひ!?　うわっ、局長さん！」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「何事ですかっ、ていうか今までどこで何してたんですか？　副長さんが、寂しがってましたよ～？」"
