      "x": -6,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「あんまり顔色よくないもん、ひよのちゃん。心配だなぁ、ちゃんとご飯食べてる？」"
  },
  {
    "command": "update_character",
    "id": "right",
