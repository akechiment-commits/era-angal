    "active": true,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「そうだ、あたしが檻のなかに入ればいいんだ！　近くから描きたい！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 23,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「後でそうしよう、でも今は目の前のこの見晴らしのいい景色を描くよ～♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 23,
    "dress": "old-civvies",
