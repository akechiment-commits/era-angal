  {
    "command": "talk",
    "speaker": "もも",
    "text": "「て、転校生！　とりあえず、画材とか買ってきてってば！」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「あと今あたし、すごい恥ずかしいこと言ってた気がするけど！」"
