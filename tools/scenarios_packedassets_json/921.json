    "active": true,
    "expression": "old-civvies_expression/embarrassed",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「あ、あたし、ちっちゃいし……。いつも絵の具まみれで、きれいにしてないし！」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「だから、えっと！　やめて！　こういうの苦手だよ～っ！」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「う、ううう～？」"
  },
  {
    "command": "update_character",
