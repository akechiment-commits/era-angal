    "pose": "2",
    "expression": "winter_expression/embarrassed",
    "expression_position": {
      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "ねぇ、お母さん。ぎゅって抱きしめていいかな。手術室に入るまで、お母さんの心臓の音を聞いていたい気分なんだ"
  },
  {
