  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「弛んでますね、もっと『しっかり』していただかないと困ります」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「本日は三年生がいないため、生徒会の業務が滞りぎみなのです。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あなたにも、手伝ってほしかったのですけど」"
