    "pose": 0,
    "active": true,
    "expression": "old-coat_expression/angry",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「このようにペンキをぶちまけたりして、公共の場を汚すのは感心しません。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「また、美化委員会から苦情がきますよ？」"
