  {
    "command": "update_character",
    "id": "center",
    "character": 2,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「んしょ、っと。あれっ、どうやって着るのかしらこれ。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「難しいわね、こんな服ふだんは着ないし……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
