    "character": 2,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（ううんチップと交換してもらえば、また『君咲カジノ』で遊べるわね♪）"
