  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「どうも、『部活荒らし』とかをやらかした素行不良な連中……」"
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「ぶっちゃけラクロス部のやつらを、更生させるための催しっぽいですよ」"
