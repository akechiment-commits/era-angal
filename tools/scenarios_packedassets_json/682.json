    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「問題児たちに『巫女さん』の真似事をさせて、『良い子』にしようって感じじゃないですか～？」"
