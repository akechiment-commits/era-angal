  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「主催も生徒会じゃなくて、学院側……つまり、教師たちみたいですにゃあ♪」"
