    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「だもんで、『巫女修行』のお手伝いをすることになったんですよ～？」"
