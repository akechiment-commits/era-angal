  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/amazed",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「以前、二年生の問題児たちが『メイド喫茶』で働くことで更生した～って事実があるじゃないですか。」"
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「それで味を占めたんじゃないですかね～、教師たちは？」"
