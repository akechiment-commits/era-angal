    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「『メイド喫茶』の焼き直しですよね～、そう都合よくいかないだろうとは思うんですけど。」"
