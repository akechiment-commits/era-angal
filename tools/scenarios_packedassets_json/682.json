  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「うにゃあ、便利に使われてますね～♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「あたしも、そんなに『巫女修行』については詳しくないですよ。」"
