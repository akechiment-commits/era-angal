  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/surprise",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「……あたしの手は貸しませんよ？　猫じゃないもん！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 21,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「ふむ、ふむ？」"
  },
  {
    "command": "talk",
    "speaker": "みけ",
    "text": "「先輩ってば『巫女修行』っていうのが何なのか知らないのに、呼びだされて『のこのこ』きたんですか？」"
