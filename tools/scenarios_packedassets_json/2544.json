      "x": -10,
      "y": 470
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "明日にでも、本人に話を通そう。驚かせてしまうかな、私はずっと『あの子』を騙していたようなものだし……。泣かれてしまったら、堪らないね"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 58,
    "dress": "winter",
    "pose": "2",
    "expression": null,
    "expression_position": {
      "x": -10,
      "y": 470
