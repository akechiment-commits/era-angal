    "active": true
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "でも、見てのとおりに、さくらさんは潔癖なところがあるから"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "不真面目な他の部員がゆるせずに、何度も喧嘩をしていたわ"
