    "expression_position": {
      "x": 0,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「あたし生物部のひととか、動物園や牧場のひとと仲がいいから。」"
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「その猫とか、おまえも、平和に暮らせる場所へ案内してあげるっ！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 30,
