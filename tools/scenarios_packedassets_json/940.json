    "expression_position": {
      "x": 0,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「この場所は、ね。砂賀先輩が言うには、宝物みたいに貴重な場所だから」"
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「ここで暮らして、貴重な植物を食べたりして……。」"
