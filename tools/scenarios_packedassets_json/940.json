    }
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「世界は広くて、面白いよっ！」"
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「だから勇気をだして外へ行こうよ、あたしそれを伝えにきたんだっ！」"
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「それが、あたしの『忘れもの』……♪」"
  },
  {
    "command": "update_character",
