  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「おぉ、グラウンドが雪で真っ白になってる！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-w",
