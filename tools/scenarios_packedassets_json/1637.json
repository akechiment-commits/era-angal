    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「でも。明日もきっと、楽しいわ。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「君咲学院は、誰もが笑顔で青春を満喫できる学び舎に、なったのだから……。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 9,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「不安になる必要はないの、寂しがることもないのよ」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「笑っていて、カロアさん。女の子は、笑顔がいちばんラブリーなのよ。よし、よし♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 54,
