  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「あたしが、『魔王』が、カロアさんの怖がるものをぜんぶ追っ払っちゃうわ。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「だから平気よ、心配いらないから。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「安心して、かわいい笑顔を見せてね♪」"
