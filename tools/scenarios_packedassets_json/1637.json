  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「さっきまで賑やかだったのが静かになっちゃったから、寂しくなったかしら？」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「カロアさんは、家はどのへんなの？　ちゃんと送ってくからね♪」"
