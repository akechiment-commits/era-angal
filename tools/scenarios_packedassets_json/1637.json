    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「うん。そうね、あたしも同じ気持ちよ。ちゃんと伝わってるわよ、カロアさん」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 9,
    "dress": "old-default",
    "pose": 0,
    "active": true,
