  {
    "command": "talk",
    "speaker": "こよい",
    "text": "うち、そんなん知らんもん。そういうんじゃなくて……。もっとちゃんと、普通に、他のみんなと同じように。どこにでもいる高校生みたいに、楽しみたかったんよ"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 45,
