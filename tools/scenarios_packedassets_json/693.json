  {
    "command": "talk",
    "speaker": "かな",
    "text": "「そうね。君咲学院のみんなを、家族だと思ってくれたらいいわ。」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「あたしのことも、『お母さま』みたいに思ってもいいのよ♪」"
