    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「う～ん、あたしにもよくわからんね～？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 23,
    "dress": "old-s-civvies",
