    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「悠木くんの姿を見たとたんに、驚いて逃げてっちゃったけど。なんか見覚えあるひとだったし、」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「もしかしたら君咲学院の生徒だったのかな？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": -6,
