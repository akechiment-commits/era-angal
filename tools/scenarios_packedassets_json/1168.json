    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "『そんな体育祭で責任あるチームリーダーを務め、見事、チームを優勝に導いた人物は……』"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "『最もリーダーシップがあり、カリスマ性があり、実行力のある下級生といえるでしょう！』"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "『そんな体育祭におけるチームリーダーは、』"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "『全校生徒の支持を集め次期の生徒会長に選ばれる場合がおおい！』"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "『それが体育祭の伝説、というかジンクスです！』"
  },
