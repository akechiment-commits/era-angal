  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "ねぇ、堀田。あたしこそ、ごめんね。空気を悪くしちゃってたわね、あたし昔っからそうなのよ。周りに合わせられなくて、『自分が、自分が』ってなっちゃう"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "volley",
    "pose": "1",
    "expression": "volley_expression/sad2",
    "expression_position": {
      "x": -16,
      "y": 500
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "あんたの言うとおりよ、あたしは自分のことばっかりね"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "volley",
    "pose": "1",
