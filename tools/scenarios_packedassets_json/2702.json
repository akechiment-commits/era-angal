  {
    "command": "talk",
    "speaker": "なな",
    "text": "寂しさに慣れないでくださいよ、団長"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 3,
    "dress": "bath",
    "pose": "1",
    "expression": "bath_expression/sad2",
    "expression_position": {
