  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "そしたら、あたしを探しにきたいいんちょが……。そんなあたしたちを見て心配して、救急車とか呼んじゃって、大騒ぎになりましたよね"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 3,
    "dress": "bath",
    "pose": "1",
    "expression": "bath_expression/honest",
    "expression_position": {
      "x": -10,
      "y": 476
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "団長、覚えてますか。そうやって、あたしたちは出会ったんですよ"
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "握りしめられた手は、しばらく痛くて動かせませんでした。団長の指の跡が、ずうっと残っちゃいました"
