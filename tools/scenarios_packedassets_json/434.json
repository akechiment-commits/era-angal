  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「わたしの姿を見ると、『誰かと思ったよ』と言われたのです。」"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「三波先輩が似合ってると言ってくれていたのは、実はお世辞だったのか判断しかねて……」"
