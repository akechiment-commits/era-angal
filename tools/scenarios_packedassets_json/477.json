  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「でも、月光は人間の精神をおかしくさせる。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「だから満月の夜には、事件や事故が多発する。今回の事件も、『そういうこと』だったんだろうね」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「いくつもの事故が、偶然が、積み重なって事件になった」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「真犯人は、お月さまだ」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ひ〜ちゃんが主催した、お月見。」"
