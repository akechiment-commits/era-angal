  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「……あたし、地下で何があったかはよく覚えてないけど」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ずっと夢を見てた気がする、とっても怖い夢。」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「知らない子供たちと手を繋いで、『花いちもんめ』で遊んでた。」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「あの子がほしい、あの子じゃわからん、ってね？」"
