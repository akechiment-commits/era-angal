  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「もっともっと、永遠に遊んでいようって誘われたけど」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「家でお姉ちゃんが待ってるからごめんね、って……。『ばいばい』しちゃった、それがすこし申し訳ないの」"
