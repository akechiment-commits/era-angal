    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「ふむふむ……ああ、そういうこと」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「大会前で忙しい僕に、生徒会のみんなから差し入れがあるってことだね」"
