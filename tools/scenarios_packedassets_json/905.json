    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「それで、どうしたのかな。もしかして、生徒会の方でなにかトラブルでもあったの？」"
  },
  {
    "command": "update_character",
    "id": "center",
