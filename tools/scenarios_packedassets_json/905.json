    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「ありがとう。袋いっぱいのお菓子だね……すごく助かるよ♪」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「大会が終わったら、すぐに味わわせてもらおうかな☆」"
