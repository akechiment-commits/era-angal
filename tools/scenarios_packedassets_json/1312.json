    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「『まさか、これが『君咲サスペンス劇場』の幕開けになることを、』」"
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「『この時点で予想できた生徒はいただろうか……』」"
