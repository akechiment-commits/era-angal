    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「それにしても、ちかちゃん……」"
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「起こそうとしても目を開けないんだけど、もしかして宝石に関係して何かあったのかな？」"
