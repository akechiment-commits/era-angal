  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あたしも、大ファンだよ。顔をあげて、笹芽さん」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「周りをよく見ろよ。あんたに注目してる、この体育館に集まった生徒のひとりだって……。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あんたを憎んで、嫌って、悪意を向けてるか？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「退屈で、同じことの繰り返しみたいな学校生活を……。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あんたが彩って、物語に仕立てあげて、あたしたちに届けてくれる」"
