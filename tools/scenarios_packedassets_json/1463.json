  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（あぁ……）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（これはきっと、罰なんですね。）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（わたしなんかが、ずっと憧れてた夜霧さんとすこしでも仲良くなれて。）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（物語のなかに、招いてもらえたみたいで）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（浮かれて、はしゃいで……。もっともっとって、求めちゃったから。）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（神さまが、そんなわたしに天罰を）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（身の程を知れって。たっぷり恥をかいて、また教室の隅っこの薄暗がりに戻れって……。）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（世界中が、わたしにそう言っているんですね？）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（これが、部長の望みなら。わたし、甘んじて受け入れます。）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（部長には、いっぱいいっぱい大切なものをもらったから）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（幸せな時間を……。ふたりで走り回って、いっしょに企画を考えて、記事の文章をこねくりまわして）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（部長の青春のなかに、ちょっぴりお邪魔して居場所を与えてもらいました）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（そのすべてを持ち去って、部長は卒業していく。塵ひとつ残さずに、わたしを粉々にして。）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（それでいいんです、もともと分不相応だったんですぅ）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（わたしなんかが、わたしなんかが……）"
  },
