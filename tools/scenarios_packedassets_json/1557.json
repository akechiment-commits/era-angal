    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「はい……。たしかに、仰る意味はわかりますけど」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-gambler",
    "pose": 0,
    "active": true,
    "expression": "old-gambler_expression/joyful",
