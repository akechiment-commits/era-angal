    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-gambler",
    "pose": 0,
    "active": true,
    "expression": "old-gambler_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「あんたも丑三つ時に、他のみんなと一緒に完全武装して町の外れにある墓場に集合ね。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
