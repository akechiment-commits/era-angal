    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あっ、はい。了解しました。わたし、仕事はちゃんとやります！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-gambler",
    "pose": 0,
    "active": true,
    "expression": "old-gambler_expression/normal",
    "expression_position": {
