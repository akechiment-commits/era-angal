    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「なぜだっ、どうして逃げるのだ！　私のことが嫌いなのか～っ!?」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「ちがうの、『つけ』にしてる飲み代ちゃんと払ってとか言いたいわけじゃないの！　だから逃げないで！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「ただ、私はぎんさんとお友達になりたいだけなのだ……！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「ぎんさん、いつも陽気に笑ってるように見えるけど！　たまに、すごく寂しそうだから！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「慰めてあげたい、ううん元気にしてあげたい！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 24,
    "dress": "old-oiran",
    "pose": 0,
    "active": true,
    "expression": "old-oiran_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「だって私、ひとを元気にするのが自分の使命だって信じてるから！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 24,
    "dress": "old-oiran",
    "pose": 0,
    "active": true,
    "expression": "old-oiran_expression/sad",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「親に遊廓に売られて、つらいことも苦しいことも『いっぱい』あった！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「でも、私が元気にしてあげたひとが『ありがとう』って笑顔になってくれるのが嬉しかった！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「それだけが、心の支えなんだよおお！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「お願い、元気にさせて！　私の元気ぜんぶあげるっ、有り余ってるから！　だから……！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 24,
    "dress": "old-oiran",
    "pose": 0,
    "active": true,
    "expression": "old-oiran_expression/cry",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「うあああ～ん！　ぎんさ～ん！　逃げないでっ、私と友達になってよおお！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「元気にしてあげる！　つらい浮き世を、一瞬だけでも忘れさせてあげるからぁああ！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「うう、ぐじゅ！　ぎんさ～ん……！」"
  },
  {
