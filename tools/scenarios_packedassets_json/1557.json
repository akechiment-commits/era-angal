    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あ、はい。すみません……。わたし、がんばりますね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-gambler",
    "pose": 0,
    "active": true,
