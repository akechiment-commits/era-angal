    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「良い子。あっ、そうそう……。ちょっと重要な情報を掴んじゃったから、トモにこの書簡を渡しといて。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-gambler",
    "pose": 0,
    "active": true,
    "expression": "old-gambler_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「新撰組総出の、大一番になりそうだわさ～♪」"
