    }
  },
  {
    "command": "talk",
    "speaker": "かすみ",
    "text": "「いつだって、生きることは食べること。わたしは、おいしい料理を食べないと生きられない。」"
  },
  {
    "command": "talk",
    "speaker": "かすみ",
