    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "かすみ",
    "text": "「くふふ、せめて論理的に否定してほしいのよ～……？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 71,
