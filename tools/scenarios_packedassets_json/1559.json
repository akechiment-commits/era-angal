    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「ありがと。船のなかで勉強したんだ、父がもともとこの国の人間でね。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 48,
    "dress": "old-juban",
