    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そっか。いや礼儀云々の前に、ちょっと聞いてて違和感があるからね。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 48,
    "dress": "old-juban",
    "pose": 0,
    "active": true,
