    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「ちゃんと通じてるなら、よかった～♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 48,
    "dress": "old-juban",
    "pose": 0,
    "active": false,
