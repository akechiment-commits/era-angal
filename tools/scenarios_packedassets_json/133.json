  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ごめんね、転校生くん——」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「保健委員の仕事、手伝わせちゃって。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「やっぱり薬品の瓶とか、重いものを運ぶのは女の子だけじゃ無理だから」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ん？　何見てるの？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「これ——見覚えのないポスターだね。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「手作りっぽいけど、えぇっと『クスリの逆はリ・ス・ク♪　サプリメント、とりすぎていませんか？』だって」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「たしかにそうだよね。わたしもサプリはよく飲むけど、」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-default",
    "pose": 0,
    "active": true,
