    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「大量の錠剤をじゃらじゃらと口に押しこめてると、何だか疚しいことをしてるような気分になるもん」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ん？　つづきがある——変な、ぐるぐる模様と」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「『サプリメントに頼らなくても元気になれる！　みんなで宇宙線を浴びて健康になろう！　」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「宇宙線健康法に興味がおありのかたはご連絡を——オカルト研究会　時国そら』」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「うわ、怪しい。雑誌の裏とかに載ってる変な広告みたい」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あぁ、オカルト研究会の——よく無断で大掲示板とかに変なポスター貼ってるんだよね。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「『いっしょに宇宙人を捜そう！』とか『ムー大陸は実在した！』とか、ついに保健室まできたんだ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「オカルト研究会の時国そら先輩、うちの学校でも有名な変なひとだけど——」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「何が楽しくて、こういうことしてるんだろうね？」"
  },
  {
