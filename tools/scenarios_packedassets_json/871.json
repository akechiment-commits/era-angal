    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「いつも無理してがんばってる部長に、これ以上は苦労を背負いこませたくないから」"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「部長の重荷を、ちょっとでも肩代わりしてあげたいから」"
  },
  {
    "command": "talk",
    "speaker": "あいか",
