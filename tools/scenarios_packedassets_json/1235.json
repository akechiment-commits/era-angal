    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「あたしもそんな四六時中、ガミガミ罵詈雑言ばっかり吐いてねぇわよ」"
  },
  {
    "command": "update_character",
    "id": "right",
