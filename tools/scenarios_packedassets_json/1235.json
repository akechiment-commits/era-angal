    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「何よ、脚本に不安があんの？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「気になる点があるなら今日中に言っときなさいよ、舞台の幕が開いてからじゃ遅いのよ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w",
    "pose": 0,
    "active": false,
