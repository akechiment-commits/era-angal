    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「でも不出来な脚本で上演されて、損するのは、恥をかくのはあんたなのよ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
