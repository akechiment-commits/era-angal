    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「転校生さんが運んでくれて、助かっちゃいました。すごいなぁ、男のひとって……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
