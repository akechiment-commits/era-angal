    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「たくさん借りすぎちゃって、ひとりじゃ重くて何往復もするしかなくて、大変だったんです」"
