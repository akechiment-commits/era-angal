    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「それがとっても、幸せなんです……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-default",
