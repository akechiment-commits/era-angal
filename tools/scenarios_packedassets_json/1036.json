    "active": true,
    "expression": "old-s-civvies_expression/amazed",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「ちぇっ、顔を覚えられてやんの。」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「保健室でサボってんのばれたら大目玉だから、さも保健委員のように振る舞ってみたのに～？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 5,
    "dress": "old-track",
    "pose": 0,
    "active": true,
    "expression": "old-track_expression/normal",
