    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「いや、家にいても暇なんで。今日はバイトいれてないし、てきとうにブラブラ散歩してたんスけど」"
  },
  {
    "command": "update_character",
