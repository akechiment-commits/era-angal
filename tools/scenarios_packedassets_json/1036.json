    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「とはいえ、この炎天下に放置したら命に関わるし。」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「たまたま見つけたあたしが、苦労してここまで運んできたってわけです」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 47,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/amazed",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「ほんと、マジで大変だった……。おかげでヘバって、こうして休んでるんですけど」"
