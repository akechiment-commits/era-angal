    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「怖いなぁ、生徒会役員は」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 47,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
