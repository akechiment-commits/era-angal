    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「あぁ、そうだね。ごめんね、気が回らなくて」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 5,
    "dress": "old-track",
    "pose": 0,
    "active": true,
    "expression": "old-track_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「君はたしか帰宅部だろう、部活動でもあるまいし……。」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「どうして、夏休みなのに君咲学院にいるのかな？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 5,
