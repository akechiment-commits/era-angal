    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「あはは。いや、ちょっと寝不足でね。」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「夏休みちゅうに、溜まってた生徒会や陸上部の書類仕事をぜんぶやっちゃおうと思って徹夜したの」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「そしたら熱中症っぽくなっちゃったから、うちの部長に『無理しないで……』って怖い顔で迫られてね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 5,
    "dress": "old-track",
    "pose": 0,
    "active": true,
    "expression": "old-track_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「仕方なく、保健室にきたわけだよ。すこし休めば、快復すると思うし」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 5,
