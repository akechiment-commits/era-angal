    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「まぁ後輩の子に格好つけたがるのは、理解できなくもないけど」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 47,
    "dress": "old-s-civvies",
