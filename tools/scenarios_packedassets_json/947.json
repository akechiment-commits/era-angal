    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「同じ手段だと、怪しまれるかしらね？　どうしよっかなぁ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 11,
