    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「そっか。がんばってね、熊ちゃん」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「あたしも手伝いたいとこだけど、さすがにもう眠気が限界だから帰るよ。」"
  },
  {
    "command": "talk",
