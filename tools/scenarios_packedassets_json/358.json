  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「あれっ、神樹さん？　『こんなとこで何してるの？』は、こっちの台詞だよお？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": false,
    "expression": "old-hero_expression/normal",
