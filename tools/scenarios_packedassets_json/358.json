  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「とおりゃあっ☆」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「ふぅっ、だいたい消火できたかなあ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「見た目ほど、たいした火事じゃなくてよかったよお。」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「大慌てで校内から、こんなにいっぱい消化器とか持ってくることなかったなあ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「むう、あちこち焼け焦げて戦場跡みたいになっちゃったよお？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「すこし畑のほうまで類焼しちゃってるなあ、……まあ焼き畑ってあるからだいじょうぶだよねえ？」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「でもほんと、オカ研のひとたち何でこんなとこで火遊びしてたんだろお？」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「早めに気づいてよかったよお。」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「校舎の屋上で『ふははは！』ってしてたら、林のなかで火の手があがってるの見えたんだけどお」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「消化器を運んだり、土を掘りかえして浴びせたり、かんぺきな消火活動だった気がするよお！」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「こんなふうな腕力の活かしかたもあるんだなあ、わたし力持ちでよかったよお♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/surprise",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「あれえ？　燃えてたのって、先っぽが折れてどっか行っちゃってたあの笹だったのお？」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「短冊がいっぱい吊されてるし、間違いないよお！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/angry",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「みんなの願いごとを、燃やしちゃうなんてえ！　おのれオカ研、絶対に許さん！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「……でもまあ事故かもしれないし、オカ研ばかり責めても仕方ないよねえ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「とりあえず、燃え残った短冊を集めようっと。よいしょお♪」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「うん、いい感じ。意外と楽しいかもお、『七夕セブン』！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「神樹さんに、コスチュームをもらって。」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「『正義の味方に変身して、みんなの願いを叶えるのだ！』なんて言われたときには、びっくりしたけどお」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「泣いてるだけじゃあ、気が滅入っちゃうだけだもんねえ。大暴れしたら、けっこうスッキリしたよお♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（わたしの強すぎる腕力は……。ひとに迷惑かけてばっかりだし、やっぱり好きになれないけどお）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（神樹さんのお姉さんが、言ってくれたんだあ）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（欠点も、磨けば長所になる。捨てちゃうのは勿体ない、って）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（きっと、わたしが生まれもっていたこの腕力は、神さまからの贈りものなんだって。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（意味が、価値があるんだって。そんなこと言ってもらえたの、生まれて初めてだよお♪）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（このパワーを、せめてみんなの役に立てよう！　な〜んて、アメコミのヒーローみたいだよお♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-hero",
    "pose": 0,
    "active": true,
    "expression": "old-hero_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（この腕力で、わたしはみんなの願いを叶える。わたしが台無しにしちゃった、たくさんの願いを）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（拾い集めたのと、神樹さんのお姉さんから託されたのと、この焼け跡で回収したの……）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（ぜんぶの短冊に書かれた願いを、わたしは叶える！　『七夕セブン』として！）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（残る願いは、あと９４２個！）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（そのすべてを叶えるまで、『七夕セブン』の戦いはつづくのだ……！）"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "（ちょっと、おかしな方向にいってる気がするけど。がんばるぞおっ☆）"
  },
