  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「こちらに関しては、教師たちが口出しすることは禁止です」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「生徒会がその責任を負い、生徒会役員の監督のもとに執り行う」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「そして、お互いの領分に関しては、それぞれ干渉しない」"
