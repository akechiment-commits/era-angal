  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「ふん、いい迷惑よ。いつもそうなのよ、あいつ。」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「無駄に行動力あるくせに、間の抜けたことをするのよ。それでいつも失敗すんのよ、馬鹿馬鹿しい」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「他人を踏みにじってることにすら、気づかないのよ」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「それもぜんぶ、鶴海ひまりってのが円城寺をちゃんと負かさなかったからよ。」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「懲らしめて、コテンパンにして、もう二度と動けないぐらいに痛めつけてやればよかったのに」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「自業自得よ。だから罰ゲームでもないけど、」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「鶴海ひまりを『事件』の『犯人』に仕立ててやろうとしたのよ。」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「当代の生徒会長の、実力を見定めたかったしね」"
