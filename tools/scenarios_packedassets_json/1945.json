  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/surprise",
    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「もしかして、わたしたちのために全裸になる決心がついたのかな!?」"
