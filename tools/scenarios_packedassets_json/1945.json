    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「大歓迎だよぉ、ちょっとモチーフに悩んじゃってるの～♪」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
