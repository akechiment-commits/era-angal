    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（えぇっとえぇっと、何だろう？）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（わかんない、過去のわたしったら安請けあいしすぎ！　今は、それどころじゃないんだけどなぁ？）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あれっ、ダーリン……じゃなくて転校生くん？　ど、どうかしたの？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「わざわざ、美術室にくるなんて珍しいね。用事があるなら、教室で言えばよかったのに～？」"
  },
  {
    "command": "update_character",
    "id": "center",
