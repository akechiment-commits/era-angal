    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「君、以前わたしたちに寄ってたかって脱がされかけてから……。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「怖がって、美術室に近づかなくなったのにね」"
