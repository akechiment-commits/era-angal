  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「こうやって歩いてると、思いだします」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「まだ、ちいさな子供だったころ。いつも、こうやって歩いてました」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「右手に、パパ。左手に、ママ。いつも、わたしは真ん中で両親を見あげてました」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「パパとママは、あんまり仲がよくなくて」"
