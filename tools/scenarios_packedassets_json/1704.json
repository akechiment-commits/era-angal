  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「あぁ……。ぼくが慌てふためいて騒いでたの、廊下にまで聞こえてたんだ。」"
