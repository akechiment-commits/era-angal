  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「それで気になって、様子を見にきたんですか？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「お節介なひと……。まぁ、お陰さまで何とかなりそうですから～♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/angry",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「ふんっ、だ！　でも恩着せがましくしないでねっ、」"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「ぼくは翼の折れた堕天使（ルシフェル）！　誰とも馴れあわない！」"
