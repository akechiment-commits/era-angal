  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/angry",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「やめて～っ、馴れ馴れしくしないでよ～！　がるるる！」"
