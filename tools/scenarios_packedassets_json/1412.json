    "expression_position": {
      "x": 0,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「今じゃこいつらのほうが、あたしより地下トンネルについて詳しいんじゃないかなっ♪」"
