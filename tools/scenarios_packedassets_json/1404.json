  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「すぴい、すやすや……♪」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「……んん。ちがうのお姉ちゃん、お姉ちゃんの巫女服を着ていたのは自分のとまちがえちゃっただけ。」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ただの事故だから、だからセーフだからうふふうふふふ♪」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ちがうの下着は、下着は自分のだからお姉ちゃんのじゃないから……」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「だから無理やり脱がしちゃイヤ～ンうふふふうふふふ♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
    "expression": "old-pajamas_expression/surprise",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「……んあっ？」"
