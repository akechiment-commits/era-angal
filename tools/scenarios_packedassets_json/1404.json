  {
    "command": "set_background",
    "display_name": "神社（廊下）",
    "id": "2032",
    "timezone": "1"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「お疲れさま、転校生くん」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ううん。『お帰りなさい』かな」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ご飯、できてるよ。それとも、お風呂にする？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ふふ。もうあんまり授業がないわたしたち三年生とちがって、転校生くんは今日も学校だもんね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/sad",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「お風呂に入ってる、時間はないかな」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「忙しいのに、神社の雪かきを頼んじゃってごめんね。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「わたしといちかだけじゃ、なかなか手が回らなくて」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ひ～ちゃんとか湖南さんとか、剣道部のひととかにも手伝ってもらえたんだけど……。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「女の子だけじゃ、力仕事は難しいね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「うん。ちょうど両親が神事で出払ってて、にっちもさっちもいかなかったんだ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/sad",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「神社と下界を繋ぐ石段が雪で埋まっちゃって、食べ物も生活用品も調達できなくてね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「あやうく、飢え死にしちゃうところだった……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「まぁ、さすがにその前に業者さんとか呼ぶつもりだったけど。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「転校生くんががんばってくれたから、その必要もなくて助かっちゃったよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ほんとうに、ありがとうね。良い子、良い子……♪」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ぼくちゃんは、良い子……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/surprise",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「あっ、ごめん。触っちゃって、ビックリしたよね。たくさん雪が、頭とか肩とかについてたから」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/sad",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「お詫びに、わたしの髪に触ってもいいよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「えへへ。いつも撫でてばかりだから、撫でられるのは新鮮だな……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/surprise",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「おっと。こんなことしてる場合じゃないかな、急がないと学校に遅刻しちゃうよね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「転校生くん、いちかを起こしてきてくれる？　たぶん、まだ『ぐっすり』だから。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「わたしは、お弁当を包んじゃうね……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/normal",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「うん。雪かきをしてくれたお礼には、ぜんぜん足りないだろうけど。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「お弁当、邪魔じゃなければ持っていって」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/sad",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「毎朝、自分のぶんといちかのぶんをつくってるけど。今日はわたし、登校する必要ないのに。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「いつもの癖でたくさん料理しちゃって、困ってたんだ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「だから、よかったら……♪」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ふふ。転校生くんは、何でも受け入れるんだね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/sad",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「でも。独りで抱えきれなかったり、嫌だったら、ちゃんと『無理』って言わなきゃ駄目だよ」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「それがずっと言えなくて。わたしは馬鹿みたいに、神さまみたいなこと、していたから。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「『生き神』なんて、呼ばれて」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-miko",
    "pose": 0,
    "active": true,
    "expression": "old-miko_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「だけど。わたしも転校生くんも……神さまなんかじゃない、からね♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
    "expression": "old-pajamas_expression/sleepy",
