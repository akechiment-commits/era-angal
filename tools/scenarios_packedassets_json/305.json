    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「ちゃあんと勧善懲悪っぽいことしてんじゃん、さすがは体育委員会期待の星だよ♪」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「おまえはそういう運命なんだよ、似合ってるよ〜？　あたしゃ、おまえに期待してんだぜ〜？」"
  },
  {
    "command": "update_character",
    "id": "right",
