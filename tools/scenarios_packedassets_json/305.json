    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「さて、と」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/expressionless",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「ちと、生臭い話をさせてもらうぜ。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「一号は純情だかんな、あいつにはあんまり聞かせたくね〜し。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「かといって、あいつに完全に内緒にしとくと、あとで絶対に文句言うしな。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「面倒なんだよ一号のやつ、そこが可愛いんだけどな〜？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「とにかく、だ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「『生徒会長再任選挙』関係のドタバタが収まって、ようやく一安心ってとこだろうけどよ〜？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/expressionless",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「ちと、またきな臭い事態が起きようとしてる」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「またぞろ学校中を巻きこむ大騒動になっても面倒くせ〜し、」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「災いの芽は早めに摘んどこう、ってことであんたを呼びだしたわけだ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「『何で自分を？』って顔だな。おいおい、謙虚なのも過ぎると嫌味だぜ、転校生くん。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あんたは間違いなくこの学校の中心にいる。あんたは、いわば台風の目なんだ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「『生徒会長再任選挙』だって、」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あくまで表立って動いてたのは生徒会と『対立候補』たちだったが、あんたが与えた影響はおおきい。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「この学校で、唯一の男子。誰も、あんたを無視できない。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「とくに今回は、あんたにとっても他人事じゃね〜しな」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あんたが協力してる、生徒会にとっても無視できない話だぜ？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「面倒だと思うけど、ちっと耳を貸してくれよ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「今回の厄介なトラブルは……そうだな、」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「新聞部ならこんなふうに名前をつけて騒ぎたてるんだろうな」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「『帰宅部争奪戦』、な〜んてな」"
  }
]