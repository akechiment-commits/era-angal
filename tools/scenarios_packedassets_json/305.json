    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「うう、あのことは思いだしたくないから言わないでください！」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ていうか、あたしはパシリさせられるために呼ばれたんですか？」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「体育委員会の活動だって聞いたから、わざわざ剣道部の練習を途中で脱けだしてきたのに……」"
  },
