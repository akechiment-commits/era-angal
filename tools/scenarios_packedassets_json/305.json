    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「『生き神』妹とか名乗ってよ〜、オカ研の連中と揉めたりしてただろ、おまえ。」"
  },
  {
    "command": "update_character",
    "id": "right",
