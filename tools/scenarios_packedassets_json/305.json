    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「おまえはいずれあたしの跡を継いで『正義の味方』になるんだからよ〜？　い〜だろ、ヒーローっぽくて♪」"
  },
  {
    "command": "update_character",
