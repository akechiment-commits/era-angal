    "pose": 0,
    "active": true,
    "expression": "old-coat_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「転校生さんがいると、まるで刀を構えているときのように安心します……♪」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「しょうじき、たいへん頼もしいです。」"
  },
