    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「展示に関してわからないところがあれば、気軽にご質問ください♪」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「それでは、ごゆっくりお楽しみください～♪」"
  },
  {
    "command": "update_character",
