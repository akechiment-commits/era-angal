  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ずっと導いてあげたかった、そばにいたかったよ！　ことりん！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「でも、これで終わり！　あたしは時代の流れに乗り遅れた、あなたはこれから先も求められる！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「だから、これでお終いなの！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「寂しいけど、『さよなら』しなくちゃいけないの！」"
  },
