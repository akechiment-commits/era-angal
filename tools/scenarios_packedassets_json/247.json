    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「う〜、目がかすんで文字がよく読めない……。ごめんね、代わりに読んでくれる？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-w",
    "pose": 0,
    "active": true,
