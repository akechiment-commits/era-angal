  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（あぁ、マンボウかわいいなぁ……♪）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（この独特の『ぬぼぉっ』とした造形！）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（尾びれとかがなくて、いかにも神さまがてきとうにデザインした感じです！）"
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（逆さまに浮かんだりして『もしかして死んでる？』と疑わせるような、）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（やる気のない生き様も愛おしいですね……♪）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（一日中ずっと、マンボウだけを眺めて暮らしたいです……♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/surprise",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（おっと、つい夢中になってしまいました。そうでした、三波先輩の恋路を応援するのでした。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/amazed",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（先輩たちは、どこに……？）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（いけませんね。集中すると周りが見えなくなってしまうのは、悪い癖です）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/normal",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（冴木先輩も、それは同じですが。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（先輩なら『天才肌だなぁ』となりますが、わたしの場合はただの『粗忽者』です）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（しっかりしないと、いけませんね……三波先輩のように）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（あるいは、冴木先輩のような……）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（ぼうっとしていても言い訳がきくような、天才的な才気がほしいです）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（先輩たちみたいに、なりたいです）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/normal",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（尊敬できる先達がいるというのは、よいことです。目的もなく、ただ流されて生きてきましたから。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（君咲学院で、美術部に入るまでは）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（両親は、立派なお医者さん。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（わたしは、その跡を継ぐために真面目な良い子となって、ひたすら勉強をしていました）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（でも。それは自ら望んだことではなく、けして楽しくはなかったのです）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/normal",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（わたしがこうして絵を描いたりするのは、両親からすれば、ただの回り道なのでしょう。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（無駄な時間をすごしているように、思われるのでしょう）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（けれど、ぼんやりと過ごしていた入学当初。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（いろんな部活が、こぞって新入生を勧誘しているなか……）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（目的を忘れて、夢中で巨大な立体物をこねくりまわしていた、美術部の先輩たちに出会ってしまったのです）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（無駄なものを、高々と積みあげて……。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（でも、とても楽しそうでした。輝いていました。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（わたしも、あのひとたちのなかに交じりたかった）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（でも、最初は興味半分でした。こんなに夢中になるなんて、思ってもみなかったのですけど）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（わたしは、幸せものです。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（こんな充実感を教えてくれた先輩たちには、どれだけ感謝しても足りません。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（せめて、すこしでも恩返しがしたいのですけど）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（難しいです。わたしは、自分のことすら覚束ない未熟者です。）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（どれだけ考えても、気の利いた答えは見いだせません）"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "（不甲斐ないです。）"
  },
