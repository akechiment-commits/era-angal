  {
    "command": "talk",
    "speaker": "まり",
    "text": "「あんたの大事にしてた本を破いちゃったことも、気にしててねぇ。」"
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「あたし、いろんな本屋さんに付きあわされたよ、こないだ。」"
