  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしが誘導しますので、安全なところまで避難してください」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほぇ？　はい、わたしは八朔つゆりですけど。えぇっと、どこかでお会いしたことありましたっけ……？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
