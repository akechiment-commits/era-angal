  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あなた、そこの男のひと。えっと、危ないですよ。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そんなところに『ぼう』っと立ってると、火事に巻きこまれちゃいますよ～？」"
