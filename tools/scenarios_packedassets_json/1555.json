  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「って、自己紹介してる場合じゃないよ。えぇと、とにかく民間人のかたは待避を……？」"
