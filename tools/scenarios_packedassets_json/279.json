    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「いいなぁ、わたしもちょっと着てみたいかも。な〜んちゃって♪」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 16,
