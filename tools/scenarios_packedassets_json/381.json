  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「風紀委員の抜き打ち服装検査をするわよ！　整列しなさい！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「明日までに直してきなさい、名前はチェックしたからね——はい次のひと！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ちょっと！　あんたスカート丈が短すぎよ！　見せびらかすほどの足じゃないでしょ！」"
  },
  {
    "command": "update_character",
    "id": "center",
