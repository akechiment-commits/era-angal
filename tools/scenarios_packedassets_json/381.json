    "pose": 0,
    "active": true,
    "expression": "old-default_expression/angry",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「んん？　こらーっ、あんた服装が校則違反ってレベルじゃないわよ！」"
  },
  {
    "command": "update_character",
    "id": "center",
