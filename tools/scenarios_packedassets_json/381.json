    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「男子の服装についてはどんな校則があったかしら——ちょっと待って。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ん〜、まだ校則が制定されてないのね。学校側に早めに規定をつくるように意見しとかなきゃ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 11,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/angry",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ちょっと！　どこ行くのよっ、まだ話は終わってないわよ！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 11,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「規定がないからってだらしない格好するのはゆるさないわっ、」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしの独断と偏見で服装チェックしてやるんだから！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「えぇっと——」"
