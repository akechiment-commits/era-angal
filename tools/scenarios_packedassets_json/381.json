    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「何で男子の制服着てんのよ！　……って、あれ？　あんた男子？　あぁ、転校生の——」"
  },
  {
    "command": "update_character",
    "id": "center",
