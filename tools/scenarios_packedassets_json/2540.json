      "x": 4,
      "y": 442
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "わたしは遺伝的な、生まれつきの虚弱体質だから……。悪くなることはあっても、一生、良くなることはないっていう話だったんだけどね"
  },
  {
    "command": "update_character",
