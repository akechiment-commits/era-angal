  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「あのさ、ちょっと頼まれごとをしてくんないかな？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
