  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「それだけで、満足だったのだけど」"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「あなたは、いつもわたしに気づいて、近づいてきてしまう」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
