    "pose": "1",
    "expression": "winter_expression/honest",
    "expression_position": {
      "x": 0,
      "y": 520
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "おおはしゃぎしましょう。お別れは寂しいけれど、卒業は悲劇ではないのだから"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "winter",
    "pose": "2",
    "expression": "winter_expression/joyful",
