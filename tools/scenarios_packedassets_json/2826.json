  {
    "command": "talk",
    "speaker": "れいか",
    "text": "ご機嫌よう、君咲学院の皆さん"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "卒業生代表、円城寺れいかよ"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "winter",
    "pose": "1",
    "expression": "winter_expression/surprise1",
