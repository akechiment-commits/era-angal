    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あれ……雨、やんでるね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-child",
    "pose": 0,
    "active": true,
    "expression": "old-child_expression/surprise",
    "expression_position": {
      "x": -6,
