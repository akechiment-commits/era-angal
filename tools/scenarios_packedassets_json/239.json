  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「そこの、あなた。早川さんを見ませんでしたか？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「そうですよ。あなたですよ、あ・な・た。他に誰がいるって言うのですか？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「周りに誰もいないじゃないですか。まったくもう……」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「そう。一年Ａ組の早川きこさん。知っていますよね？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「あの子ってば、いつもマイペースだしドジばっか踏むし、忘れ物もおおいんですよ」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「でも、やろうと思ったことには一生懸命で、」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「部活だって自主練習を陰でたくさんしているんです。」"
  },
  {
    "command": "update_character",
