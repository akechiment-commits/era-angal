  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あの日……。あずさは受験生だったけど。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（やりたいことも、なくて。どの高校に進めばいいか、迷ってて。あちこち、見て回ってた……）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（受験生のための、学校案内とか、説明会とかに参加して）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（でも、よくわからなくて）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（君咲学院は、広くて迷いやすいので有名だって、知らなくて。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（やっぱり、迷子になっちゃって。蹲って、泣いてたんです）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（そしたら。『あのひと』に、声をかけられて）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（笑顔を、もらって）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あのひとが、大好きになって。夢中になって……。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（用もないのに、何度も会いに行って。君咲学院の生徒でもないのに、入り浸ってました）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あのひとと会って、お話しするたびに嬉しくなって。居心地が、よくて。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/expressionless",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（君咲学院に、入学しようって決めたんです）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あのひとは、毎日、楽しそうでした。茶道部の部室で、歌ったり遊んだり、お喋りしたり……。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（毎日、刺激的で、幸せで、輝いてました）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あのひとは、いつだってキラキラ笑顔で、青春を謳歌してました。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（羨ましかった、あのひとみたいになりたかった）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あのひとのそばにいれば、あずさも……って、そう思ってたのに）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（だから、がんばって勉強して。君咲学院を、受験したのに）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/expressionless",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（勉強に集中するために、合格するまでは、あのひとに会いにいかないって決めて。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（見事、合格して会いに行って……驚かせる、つもりで）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（無事に合格して、真っ先に茶道部の部室を訪ねたら）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（様変わり、していて。あのひとも、いなくなってました）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あのひとは問題を起こして、どこかに転校させられたって、噂で聞きました）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（何があったのかは、わからないです。誰も、あのひとのことは語りたがらなかった。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（触れられたくない、過去のようでした）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（だから今でも、どうしてあのひとがいなくなってしまったのかは、わからないまま……）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（受験に合格して、入学してしまったから。今さら、あのひとを追いかけることもできなくて。）"
