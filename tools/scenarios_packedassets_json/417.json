    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（うう。何で、こんなことに……？）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（君咲学院に入学できれば、楽しいことばっかり、って信じてたのに）"
