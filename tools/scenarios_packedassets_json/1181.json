    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「そ、それはそうだけど。やむにやまれぬ事情があって……。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「誰にも、手当てされてるところを見られたくなかったのよ？」"
