    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「転校生さん。あなた、ほんとに何も変なことはしてなかったんでしょうね？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sports",
    "pose": 0,
    "active": true,
    "expression": "old-sports_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ともあれ。転校生さん、今はお手空きでしょうか。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sports",
    "pose": 0,
    "active": true,
    "expression": "old-sports_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「もし他に用事などないようでしたら、次の種目……『二人三脚』に協力をお願いできませんか？」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「どうも欠席や、出場回数の制限のために戦線離脱するものが重なりましてね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sports",
    "pose": 0,
    "active": true,
    "expression": "old-sports_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「手が足りないのですよ、いえ『二人三脚』だけに脚が足りないと表現しましょうか……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sports",
    "pose": 0,
    "active": true,
    "expression": "old-sports_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「おほん。ともかく、そういう事情ですので。お手伝いいただければ幸いです、」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あなたも雑用ばかりでなく競技に参加して汗を流すのも一興でしょう？」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ちなみに、『二人三脚』ではわたしとペアを組んでいただきます」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あなたは、生徒会の関係者といえますからね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sports",
    "pose": 0,
    "active": true,
    "expression": "old-sports_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「他の女の子とイチャイチャしていたら、世間様に何と言われるか」"
