  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ふむ。そそくさと去っていきましたね、怪しい……。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ずいぶん仲がよろしいようですね、まぁわたしには関係ありませんけど」"
