    "pose": 0,
    "active": false,
    "expression": "old-n-armband_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「有り難うございます。……ひまり先輩は、こんなもん持ち歩いてたのですね」"
  },
  {
    "command": "update_character",
    "id": "right",
