  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「う～む、れいかの性格なら冗談というのもありえるけどなあ。」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「いくらなんでも、れいかでもこんなことで冗談は言わんだろう」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 4,
