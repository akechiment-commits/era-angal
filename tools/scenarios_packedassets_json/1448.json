    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「いえあの、もらえるならもらいたいですけど」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
