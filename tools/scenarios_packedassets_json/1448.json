    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「本気だ。そして、れいかは『やる』と言ったら本気でやるぞ。」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「どんな馬鹿げたことでもできる、権力と行動力もある」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/amazed",
