    "active": true,
    "expression": "old-n-armband_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「生徒会長の証の腕章を外したら、何だか物足りなくなりそうだったのでな……。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 4,
    "dress": "old-n-armband",
    "pose": 0,
    "active": true,
