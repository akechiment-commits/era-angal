  {
    "command": "talk",
    "speaker": "そら",
    "text": "「よく、知らない。わたし、ちょっと色々あってこの屋上に逃げてきたの。」"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「そしたら、もう先にこの子がいて、寝てたの。ゆん、ゆん」"
