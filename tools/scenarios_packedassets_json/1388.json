    "expression": "old-w_expression/angry",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「文句ならある！　若いうちからそんな贅沢を覚えちゃ駄目だっ、金銭感覚がおかしくなるぞ！」"
  },
  {
    "command": "update_character",
    "id": "right",
