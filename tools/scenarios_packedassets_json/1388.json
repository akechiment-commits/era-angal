    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「でもまぁ、潮時だったのかも。尾行とかさ……。」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あたし、ことりんの親でも何でもないんだもん。あんたの言うとおりだよ、ちょっと過保護すぎたかも」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ことりんには、ことりんの人生があるんだもんね」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「わかってるよ。納得してる、あたしだってお子さまじゃないんだから」"
  },
  {
    "command": "update_character",
