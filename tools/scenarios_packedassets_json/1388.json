    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「いいでしょ、べつに。買い物でストレス発散……。」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「まったく、ポテトを取りあってことりんを見失っちゃうなんて大失態！」"
