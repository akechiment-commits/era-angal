  {
    "command": "update_character",
    "id": "right",
    "character": 24,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/angry",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "update_character",
