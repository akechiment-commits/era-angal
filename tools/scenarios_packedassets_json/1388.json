  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ことりんはことりん、あたしはあたし！　そうでしょ、最初からそうだったんだよ！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あたしが勘違いしてただけ、『ふたりでひとつ』だってね！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「そうでしょ？　そうだったんだよ！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あたしが馬鹿だったんだ、ことりんと一心同体のつもりで何を考えてるかもわかんない！」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「何も相談してくれない、勝手なことばっかりする！　だから、ことりんが何を考えてるかわかんない！」"
