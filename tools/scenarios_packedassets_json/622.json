  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あっ、そうだ……」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 66,
    "dress": "old-santa",
    "pose": 0,
    "active": true,
