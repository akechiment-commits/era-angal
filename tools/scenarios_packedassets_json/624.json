    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「あけましておめでとう。いつも、妹……いちかが、体育委員会でお世話になっています。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「今後とも、ご指導ご鞭撻のほどお願いします」"
