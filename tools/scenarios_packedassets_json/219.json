  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（でも、あたしは勝つんだ！　その気持ちが大事なんだ！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（オカ研の時国先輩によると、この要石＝ピラミッドの真上で、むかし儀式が執り行われたっていう）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（たぶん、土木工事の前とかにやる、うちの神社でもよくやる、ふつうの祈祷だろうけど）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（オカ研は、なぜか神様みたいに思われてるお姉ちゃんに、その儀式をさせようとしてた。）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（でも、お姉ちゃんは神様みたいに扱われるの、嫌がってるもん）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（ようやく、ふつうの女の子として、好きな弓道を楽しめるようになったんだ。）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（だから、こんなアホなことに関わらせちゃいけないんだ……！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（いつも、あたしはお姉ちゃんに守ってもらってた。だから、たまにはお姉ちゃんを守りたいよ）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（そう思ったから、お姉ちゃんの代理をつとめるってオカ研と約束して、ここに立ってるんだ！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（だから、雛壇を降りるわけにはいかない。あたしが、儀式を最後までやるんだ。）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（あたしが、あたしがお雛さまなんだ！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「だから、負けないんだから……！」"
