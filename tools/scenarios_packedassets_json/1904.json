    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「あんた、勉強はしなくていいの？　今年、あたしら受験生よ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 25,
