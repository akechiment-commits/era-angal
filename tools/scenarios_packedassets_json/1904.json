    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「夏を、暑さを楽しみたまえよ。それもまた風流、美しい四季を堪能するといい」"
  },
  {
    "command": "update_character",
    "id": "right",
