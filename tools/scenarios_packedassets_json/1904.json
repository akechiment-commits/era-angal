    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「ふんっ、いいでしょ！　あんたしかいないんだしっ、誰に迷惑がかかるってわけでもないわ！」"
  },
  {
    "command": "update_character",
