    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「自分の存在を根本から否定するようなことを言うねぇ、深鳥くん。」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「あまり図書室で騒がないでくれたまえ、喚くともっと体温があがるよ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 25,
    "dress": "old-default",
    "pose": 0,
    "active": true,
