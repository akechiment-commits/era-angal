    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「あ～、暑い暑い暑い！　溶けちゃいそう！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 25,
    "dress": "old-default",
    "pose": 0,
    "active": false,
