    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「だからまだ、ほんのすこぉし……。このまま、不思議な、煮え切らない関係のまま。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいりは、マルちゃんのそばにいます。いつか、この子が巣立つその日までは」"
  }
