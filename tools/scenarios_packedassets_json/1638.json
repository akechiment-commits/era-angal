    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「ふふ、背だけおおきくなっちゃって。でも、まだまだお子ちゃまですの。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「勘違いして大騒ぎして、ちいさなことに一喜一憂して、疲れて寝ちゃうまで走り回って」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「でも。そんなマルちゃんが、とっても愛おしい……。」"
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「ねぇ転校生くん、幼なじみって不思議ですね。家族よりも遠いけど、お友達よりも近いような」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「どういう距離感で付きあっていいのか、わかりませんね」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「マルちゃんも……馴れ馴れしく近づかないで、なんて言ってたくせに。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「近所だからって、同じ君咲学院に入ってきて」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「どうしたいのかしら、マルちゃんは……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「目に見える距離でドタバタされると、放っておくこともできませんの」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいり気を遣って、あんまり学校では近づかないようにしてるのに。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「今日みたいに、押しかけてきたりしますし」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「マルちゃんも、まだ迷ってるんでしょうね。でも必死に考えて、答えを見つけようとしている。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「全力で行動して、いちばん『しっくり』くるかたちを探している」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいりが先に『それ』を見つけて、教えてあげられたらいいんですけど……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいりから『ぽん』と与えられた答えを、マルちゃんは受け取らないでしょう」"
  },
  {
    "command": "update_character",
    "id": "center",
