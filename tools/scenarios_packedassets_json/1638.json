  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「あら。起きましたのね、転校生くん」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「ぐっすり寝てましたね～、毎日がんばってますもんね。たまには、お休みも必要ですのよ。」"
  },
  {
    "command": "update_character",
    "id": "center",
