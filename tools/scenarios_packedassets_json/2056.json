    "command": "update_character",
    "id": "center",
    "character": 65,
    "dress": "pajamas",
    "pose": "1",
    "expression": "pajamas_expression/sad1",
    "expression_position": {
      "x": -16,
      "y": 454
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "（ひとりでも、何でもできたのにね。ん～、しかしペン太とゴン太がうるさい。何だろう、お腹がすいたのかな？）"
