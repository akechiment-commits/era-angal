  {
    "command": "update_character",
    "id": "left",
    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「むかし、ボクが打ちのめされて、生きていく気力すら失いそうだったとき。」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「手を差しのべてくれたのは、セラだった。」"
