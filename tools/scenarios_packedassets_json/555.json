  {
    "command": "update_character",
    "id": "left",
    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ちゃんと両目で前を、未来を見られるようになったんだ」"
