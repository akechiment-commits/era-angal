  {
    "command": "talk",
    "speaker": "すず",
    "text": "「セラ、それはちがう。謝るな、おまえは何も悪いことをしてないんだ」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「おまえに軽音部に誘われて、ボクは救われた。」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「おまえがいなくちゃ、ボクはほんとうに憎しみだけに支配されてたよ。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「感謝してるんだ、だから『ごめん』なんて言うな」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 66,
    "dress": "old-w",
    "pose": 0,
    "active": true,
