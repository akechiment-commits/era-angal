    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「そうだぞ、ワクワクするだろ。ボクたちの未来は、輝いてる」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「その輝きのなかで、いっしょに青春を謳歌するんだ。」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「それを楽しみにして、ボクはおまえが帰ってくるのをずっと待ってる」"
