    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「んん。それは今日だけで、じゅうぶん理解したけれど」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 468
    }
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「きっと楽しいひとたちが、愉快な日々を送ってるのね。君咲学院、では」"
