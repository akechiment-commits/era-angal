    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「感謝してるんだ、心から」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 10,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「今度は、ボクがおまえを支える。そのぐらいには、成長したつもりだ」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ボクはもう、蹲っているだけの弱虫じゃない。」"
