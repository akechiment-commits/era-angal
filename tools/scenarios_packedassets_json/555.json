    "expression_position": {
      "x": 0,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「おまえがいない間に、君咲学院はちょっと面白いところになったんだぞ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 4,
