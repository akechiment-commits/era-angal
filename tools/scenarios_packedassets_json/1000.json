  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「海で暮らしてた単純生物が陸にあがって、」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「知的生物に進化するまでの長い時間のなかで忘れてしまった……」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「母なる海に戻るための方法を、伝授してあげるっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「だけど遺伝子に刻みこまれた、水泳の作法を……。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「その姿勢のまま、本気でキックして」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「それだけで、充分。あとは余計なことをせず、流れに身を任せるっち」"
