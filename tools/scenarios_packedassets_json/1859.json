  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あっそ。だから共感して、同じ失敗を繰り返さないようにしたかった？　善意の心とやらを発揮して？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/angry",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ふざけないでよ。これはあたしの人生よ。あんたが勝手に左右するような問題じゃない。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あんたの後悔をあたしにまで押し付けないで」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしはね、そうやって後ろ向きなのが大嫌いなのよ。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「いつだってみんな過去のことばかり見て、ちっとも現実を見ていない！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「つらい現実から目を背けようとしてるだけよ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしはどんなにつらくても、大変でも……それを受け入れて、強く生きる。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「だってそうしないと、ずっと縮こまって生きなくちゃいけなくなる。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「生まれや育ちまでは変えらんないからね。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「周囲の偏見に反発して、自分の弱さを受け入れて、がむしゃらに生きて……」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「……そうすることで、いままで必死で進んできた」"
  },
  {
