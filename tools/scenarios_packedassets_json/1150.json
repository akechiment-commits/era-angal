  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「あっ、無視したわねっ？　良い度胸じゃない、この湖南やこをスルーするなんて！」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 62,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/angry",
    "expression_position": {
      "x": -4,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「こっちは本気よっ、やるったらやるわよ！　かかってきなさいよ、『番長』～！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
