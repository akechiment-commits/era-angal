    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「ん～？　あんたはどうも、『単刀直入』じゃないと伝わらないみたいだわさ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/angry",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「今回だけは見逃してあげるから、失せろって言ってるわさ」"
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「……ぶっ殺しちゃうぞ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": false,
    "expression": "old-past_expression/angry",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 62,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/angry",
    "expression_position": {
      "x": -4,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「それよ！　最初からそう言いなさいよ、『のらりくらり』しちゃってさ？」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「いいわ、殺せるもんなら殺してみなさいよ！　あたしは死んでも止まらないわよ！」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 62,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「あたしは、欲しいものをぜんぶ手に入れる！　あたし以外の全人類を踏みつぶしてでもね！」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「だって生まれてきたんだから！　たったいちどの人生なんだから！」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 62,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/angry",
    "expression_position": {
      "x": -4,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「遠慮して、後悔して、貴重な一分一秒を無駄にしつづけるだけの生命なら！」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「そんなもん、自分から投げ捨ててやるわっ！」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「『殺す』？　上等じゃないっ、こっちはいつでも『そのつもり』よっ！」"
