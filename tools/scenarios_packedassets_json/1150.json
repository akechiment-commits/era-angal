    "pose": 0,
    "active": false,
    "expression": "old-past_expression/angry",
    "expression_position": {
      "x": -4,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「にゃはは～☆　なかなか面白い子だねぇ、湖南ちゃん？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「でもね、あたしにも譲れないものがある」"
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「ずっとむかしに約束したんだ。」"
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「いろんな『しがらみ』に雁字搦めにされてた、誰よりも一息つける場所を求めてた『あの子』と」"
  },
  {
