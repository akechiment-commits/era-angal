    "active": true
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（意外と、できたよね。ちゃんと、普通に）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 14,
    "dress": "future",
    "pose": "1",
    "expression": "future_expression/sad1",
