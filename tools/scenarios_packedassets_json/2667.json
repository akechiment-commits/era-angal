    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（ねぇ、みなちゃん）"
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（もう、いいのかな……。昔みたいに、わたしたちが双子だからって物珍しがって、変な目でみるような嫌なやつらもいなくなったし）"
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（いま、わたしたちの周りにいるのは優しくて、あったかい連中だけだし）"
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（もう『怪しげな双子だぞ～！』って、無理して言い張らなくてもいいのかな）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 14,
    "dress": "future",
    "pose": "1",
    "expression": "future_expression/sad2",
    "expression_position": {
      "x": -4,
      "y": 426
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（そっちが化け物みたいに、人間じゃないみたいに見るならお望みどおりに振る舞ってやるって……）"
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（もっと不気味になってやるって、意固地にならなくてもいいのかな）"
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（かわいいかわいい妹と、わたし自身を守るためにかけた魔法を……。もう、解除してもいいのかな）"
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "（とっくの昔に、魔法も超能力も使えなくなってるし）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 14,
    "dress": "future",
    "pose": "1",
    "expression": "future_expression/sad1",
