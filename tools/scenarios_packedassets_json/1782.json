    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「うひっ!?　あれは……生徒会長さん？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そこに直れ、新聞部！　また許可なく勝手な内容の記事を書きよって～っ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「というか、確認のために生徒会に提出された記事とぜんぜんちがうだろこれ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「手のこんだことをしよってっ、生徒たちを無駄に不安がらせる記事を書くなあ～っ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「『帰宅部争奪戦』とやらについては書くなと言っただろうがっ、偽の記事をでっちあげてまで書くことか!?」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「この掲示板に貼られた新聞も、引っぺがすからなあ～っ！」"
  },
