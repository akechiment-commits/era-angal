  {
    "command": "play_voice",
    "asset_code": "web:voice/story/kimisaki1/voice_scenario_2001_15.mp3"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ボクも、あの憎むべき『女王陛下』も、ヤコぶ～も、あのアホもな……。」"
