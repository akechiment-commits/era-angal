    "command": "play_voice",
    "asset_code": "web:voice/story/kimisaki1/voice_scenario_2001_7.mp3"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「傷だってもう癒えている、眼帯も包帯ももういらない」"
