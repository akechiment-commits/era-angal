  {
    "command": "play_voice",
    "asset_code": "web:voice/story/kimisaki1/voice_scenario_2001_6.mp3"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ボクはふつうの大学生になる、色ちがいのこの目にはカラーコンタクトでもはめてな……。」"
