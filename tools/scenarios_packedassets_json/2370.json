    }
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "（ちづちゃん先輩だったら……。何か、いちばんモヤッとしますね）"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "（ちづちゃん先輩、明るいし一緒にいて楽しいし……。あれで意外としっかりしてるし、面倒見がいいし）"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "（かわいいですしね、お嫁さんにしたいって思っちゃうかも？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 49,
