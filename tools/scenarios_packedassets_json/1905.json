  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「先輩たちも誰も、あんたのせいだなんて思ってないわ。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「だから泣きやんで、元気だしましょ。あんたに泣かれると、あたしだって」"
