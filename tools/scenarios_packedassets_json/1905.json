  {
    "command": "talk",
    "speaker": "かな",
    "text": "「みんなの足を引っぱっちゃったのよ、あたしのせいよ！」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「あたし悔しくって情けなくって、もうもうもう！　頭が変になりそうよっ、ううう～！」"
