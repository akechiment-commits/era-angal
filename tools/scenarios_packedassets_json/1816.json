    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「例の『プラネタリウム』はあたしら天文部が仕切って準備してほしいって、八雲ちゃんに言われてるんスけど」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ひとりじゃ大変だし面倒だしで、うちの部員の星ちゃんにも手伝ってもらうつもりなんスよ」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「そんで星ちゃんに電話したんスけど、繋がらなかったんで。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「星ちゃんと同じクラスの転校生くんを、とりあえず呼びだしてみたんスよ」"
  },
  {
    "command": "update_character",
    "id": "left",
