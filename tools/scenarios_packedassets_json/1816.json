  {
    "command": "update_character",
    "id": "left",
    "character": 59,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしもよく天体望遠鏡を運んだりとか手伝ってもらってるッスから……。ふつうに、連絡先を知ってたんスよね」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ついでに、転校生くんに星ちゃんをつれてくるよう頼んだんスよ。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「転校生くんが誘えば星ちゃんもきっと断らないし、芋づる式にどっちも巻きこめるッス」"
  },
  {
    "command": "update_character",
