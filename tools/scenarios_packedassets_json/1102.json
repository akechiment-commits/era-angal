  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『足長おじさんへのお手紙は、すらすら書けちゃいます』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『あなたが読んでくれる、反応してくれるから』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『感謝しています。ありがとう、わたしの大好きな足長おじさん』"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『話が逸れちゃいました。えっとですね、それで相談したい悩みというのは』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『以前、お手紙にも書いた……。マロンのことを、覚えているでしょうか？』"
