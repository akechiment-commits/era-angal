  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『あの子を愛してくれる、誰かがそばにいるのなら』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『わたしは、それでいいんです』"
