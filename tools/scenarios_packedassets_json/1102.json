  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『足長おじさんへ』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『今日も、お手紙を書きます』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『まだ残暑がつらい時分ですが、如何お過ごしでしょう。』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『わたしは、ちょっぴり体調を崩しがちです』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『といっても、ぜんぜん心配しなくても大丈夫です。』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『季節の変わり目は、いつも風邪とかひいちゃうんです』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『だから慣れてるから、大丈夫なんですけど。』"
  },
  {
    "command": "update_character",
