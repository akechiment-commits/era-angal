    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『あの子を、ずっと見かけないんです』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『夏休みの前は、いつでも会えたのに。』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『始業式が始まって、いつもの場所に行ってみたんですが、マロンはどこにもいなくって』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『わたし、心配です』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『こんなこと相談しても、足長おじさんを困らせちゃうだけかもしれませんね。』"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『でも、どこかでマロンを見かけたら、わたしに教えてくれると嬉しいです』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『会えなくてもいいんです。』"
