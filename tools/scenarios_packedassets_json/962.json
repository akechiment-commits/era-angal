  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「どうか、お姉ちゃんを幸せにしてあげてください！」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「お姉ちゃんみたいな愚図で卑怯で最低で駄目なひとでも幸せになれるなら、」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「お姉ちゃんと『そういうところ』も似てしまった、わたしだって！」"
