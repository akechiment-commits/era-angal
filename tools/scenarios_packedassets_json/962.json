    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「お姉ちゃんの、旦那さま！」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「うちのお姉ちゃんなんかを愛してあげられる奇特なひとは、あなただけです！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
