    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「せっかくの計画が『おじゃん』ですよ、マジウゼェです♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
    "dress": "old-wedding",
    "pose": 0,
    "active": true,
