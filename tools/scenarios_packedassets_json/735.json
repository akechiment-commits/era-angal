  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「いくらぼたんでも、食べきれないほどにね」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「僕ひとりぐらい増えたって、君の取りぶんは減りはしないさ。」"
