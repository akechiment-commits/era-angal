    "pose": 0,
    "active": true,
    "expression": "old-track_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「れいかに頼めば、パティシエさんを通してレシピをもらえるかもね」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「一回きりのはずのパーティに並べられる、多種多様な最高のケーキ。」"
