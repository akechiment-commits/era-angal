    "command": "update_character",
    "id": "right",
    "character": 5,
    "dress": "old-track",
    "pose": 0,
    "active": true,
    "expression": "old-track_expression/joyful",
    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「それを何度でも、ぼたんの望むかぎり再現できるようになる……ってことだよ」"
