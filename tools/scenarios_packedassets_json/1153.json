  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「だけど、今日……。やっぱりちづるは、まちがってなかったって思えたよ。」"
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「あなたたちの、おかげで」"
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「手当てと、お茶と、お菓子と、優しさと……。」"
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「あなたたちの存在が、どれだけ嬉しかったかわかるかな？」"
