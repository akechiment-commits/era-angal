    "expression_position": {
      "x": 0,
      "y": 456
    }
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「たまに後悔するけどね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 60,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 456
    }
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "「やこちゃんと付き合ってるせいで、ちづるまで『問題児』だと思われちゃってるし～♪」"
