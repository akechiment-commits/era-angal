    "active": false,
    "expression": "old-sp-civvies_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「『古いタイプのアイドル』って……まぁ、そうかもしれませんけど」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civvies_expression/sad",
