  {
    "command": "update_character",
    "id": "left",
    "character": 57,
    "dress": "old-travel",
    "pose": 0,
    "active": true,
    "expression": "old-travel_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「来年度からは、うちはもう守ってあげられないっちよ。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「留年してるうえ後輩に侮られてるようじゃあ、他の子にまで馬鹿にされちゃうっちよ～？」"
