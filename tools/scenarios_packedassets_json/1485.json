  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「深読みしすぎっちよ、うちは面倒ごとが嫌なだけっち。うちは、うちのためだけに泳ぎたいから」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 57,
    "dress": "old-travel",
    "pose": 0,
    "active": true,
    "expression": "old-travel_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「『部長』の肩書きは、あんたには重荷だったっちね。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「ごめんね、いろいろ押しつけちゃって。あんたが、部長なんて『がら』じゃないこと知ってたのに」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「うちは嫌なことから逃げて、あんたを見殺しにして……。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「ひとりだけ、気ままに過ごしてたっち。そんな、薄情者だっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「うちは優しくなんてないっちよ、金魚ちん」"
  },
  {
