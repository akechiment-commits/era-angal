    "pose": 0,
    "active": true,
    "expression": "old-travel_expression/normal",
    "expression_position": {
      "x": 12,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「しゃっちん、好意の示しかたが２パターンあるっち。さいきん気づいたんだけど。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「『獲物として好き』か、『尊敬』だっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「どっちも愛情表現ではあるっちけど、しゃっちんのそれは過激っちからね。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「『獲物として好き』になられると、生傷こさえることになるっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「あんたや、あの猫塚ちんみたいな子のことは『獲物として好き』みたい。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「でもうちや転校生くんみたいに『尊敬』されると、たっぷり甘えてくれる」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「真っ直ぐに、魚雷みたいに突っこんでくるっち。その衝撃を、受け止められるなら……。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「すっごく嬉しいっちよ、あの子からの好意は」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「全身、粉々になっちゃうぐらいの愛情をくれるっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「そういう種類の、生き物っち。生態がわかれば、御しかたもわかる。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「だからあんたも、しゃっちんから『尊敬』されるようにがんばるっちよ」"
  },
  {
    "command": "update_character",
