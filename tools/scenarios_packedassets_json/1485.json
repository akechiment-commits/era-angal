    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「うう。『尊敬』かぁ、難しいの。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 63,
    "dress": "old-travel",
    "pose": 0,
    "active": true,
    "expression": "old-travel_expression/surprise",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「あっ、もしかして……。ひびきんぐ、そのためにわたしを『部長』にしたの？」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「偉い、立派な立場をわたしに与えて。いかりちゃんに、『尊敬』されるように……？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 63,
    "dress": "old-travel",
    "pose": 0,
    "active": false,
    "expression": "old-travel_expression/surprise",
    "expression_position": {
