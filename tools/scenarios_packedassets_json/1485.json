    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「イルカに噛まれたなら、ちゃんと手当てしないと駄目っちよ。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「やつら意外と凶悪な歯並びしてるっち、肉食っちからね」"
