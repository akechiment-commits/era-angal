    "expression_position": {
      "x": 12,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「今日はゆっくり寝ないとね～、それかどっか怪我でもした？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 57,
    "dress": "old-travel",
    "pose": 0,
    "active": true,
