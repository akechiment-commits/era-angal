    "pose": 0,
    "active": false,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「わかりませんよ～だ、あたし馬鹿だし。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「義務教育も受けてないしね、ことりんが何を言いたいかもわかんない」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「それがちょっとだけ、寂しい。あたしは、冷たく凍える高い空に、ことりんを引っぱりあげた。」"
  },
  {
