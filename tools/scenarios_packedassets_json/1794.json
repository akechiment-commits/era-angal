    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「つばさしゃんは、おら以外にあったかいものを知らねぇがら……。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「上だけを、空だけを見てるがら、きっとわかんねぇんだ」"
