    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ふぅん。でもまぁ、しかし……。つまんなそうな学校だよね、あたしたちに相応しくな～い」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「近所にアイドル養成学校があるんだし、そっちのがいいのに。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あれっ、でもあそこって男性アイドル専門だっけ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/surprise",
