    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「よく知らねぇだ。それに、仕事でもアイドル、学校でもアイドルじゃあ気疲れしちまうだよ。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 64,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「たまには『ふつうの高校生』でも、いいだろ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-default",
    "pose": 0,
    "active": true,
