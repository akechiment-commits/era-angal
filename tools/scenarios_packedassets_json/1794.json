    "pose": 0,
    "active": false,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「『ふつうの高校生』ねぇ、な～んか変な感じ。」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ここの制服着てさ、真面目に授業受けてる自分とか想像できない」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「まだドラマの配役とかのほうが、感情移入できるよ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「しっくりこないなぁ、『着慣れない服』って感じ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": -34,
      "y": 460
    }
