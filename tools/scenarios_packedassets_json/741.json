    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「まぁ、返却されない本が戻ってくるまでの穴埋めですし」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 33,
