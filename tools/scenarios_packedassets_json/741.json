    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「よかったぁ……。って、図書室で騒いじゃいけませんよね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 33,
