    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「おおきさ順でテキトーに並べればいいのかな？　よぉし、ちゃっちゃと詰めちゃいますよ！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 33,
