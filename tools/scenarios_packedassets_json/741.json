    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「ごめんなさい、癖なんです！　男のひと見ると『お兄ちゃん』て言っちゃうんです！」"
