    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「……ん？　今あたし『お兄ちゃん』って言いました？」"
  },
  {
    "command": "update_character",
