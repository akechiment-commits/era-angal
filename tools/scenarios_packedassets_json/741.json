    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「でもあいかちゃん、喘息ぎみなので」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「埃っぽい古書を運んでたら息切れして保健室に行っちゃったんです」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 33,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「あんまり無理させたら可哀想だし」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「あたしが代わりに本の収納をやっといてあげようと思ったんですけど——」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 33,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「ん〜、どういう順番で並べたらいいんでしょう？」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「あたし普段ぜんぜん本読まないから、見分けつかないっていうか」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 33,
