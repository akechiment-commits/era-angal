    }
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「そうなんです。一学年ぜんぶが丸一日、ずうっとサーカスの見物をするとか。」"
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「うちの学校、そういうの多いですよね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 40,
    "dress": "old-w",
    "pose": 0,
    "active": false,
    "expression": "old-w_expression/normal",
