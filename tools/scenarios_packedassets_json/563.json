    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 44,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「授業サボれるから楽でいいですけどねぇ、」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「能とか歌舞伎とかはわたしたちも見物させられたことはありますけど。」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「サーカス、っていうのは初めて聞きましたねぇ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 64,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
