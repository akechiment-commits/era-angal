    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「あの子の入部届が受理されてから、まだ一ヶ月も経ってませんものね……？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
