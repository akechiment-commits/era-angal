    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「…………」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「それでも、放っておけないの？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「じゃあ——とりあえず、これ。時国先輩に、渡して。」"
  },
  {
    "command": "update_character",
