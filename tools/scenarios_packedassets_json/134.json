    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あっ、携帯電話鳴ってるよ？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そのメールも時国先輩から？　ちょ、ちょっと見ていいかな？」"
  },
  {
    "command": "update_character",
    "id": "center",
