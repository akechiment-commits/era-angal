    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「うわっ、すごい重箱！　そのなかに、びっしりと詰まった宇宙食！」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「うわ、二段目は豚足だけ！　三段目は——得体のしれないドロドロがいっぱい！」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ど、どど、どうしたのこれ？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「え？　時国先輩がつくってくれたの？　どうしてそんなことになってるの？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-default",
