    "active": true,
    "expression": "old-w-civvies_expression/normal",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「ってことで、今回は他にネタもないからてきとうに場繋ぎの記事をつくるつもりよ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/expressionless",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「何か美術部の子が絵画コンクールの最終選考に残ったんだって、」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「その子に意気ごみとか感想とか聞くわけよ」"
