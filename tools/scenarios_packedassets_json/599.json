    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「ほんと、自分で言ってて嫌になるほど退屈なネタだわ。」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「校内新聞としては、真っ当なのかもしれないけどさ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/expressionless",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「今日、その子がこの水族館にきてるんだって。」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「つうか、この水族館が絵画コンクールを主催してるみたいよ。」"
