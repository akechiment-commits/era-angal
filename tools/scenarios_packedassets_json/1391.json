  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「どうして高校生活は三年間しかないっ、一年は三百六十五日しかないっ、一日は二十四時間しかない！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「理不尽なのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「もっともっといっぱい、やりたいことがあった！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「企画してた行事だけで、その書類だけで生徒会の本棚が埋まっちゃうのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「文芸部の活動もしたかった、書きたい物語がいっぱいいっぱいあった！」"
