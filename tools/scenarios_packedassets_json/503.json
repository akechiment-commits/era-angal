    "pose": 0,
    "active": true,
    "expression": "old-idol_expression/sad",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「もう、学校でやったライブじゃちゃんと喋ってたじゃん〜？」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「べつにもう、トーク解禁してもいいと思うんだけどなぁ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
