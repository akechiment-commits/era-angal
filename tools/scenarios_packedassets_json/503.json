  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "『あれは、特例です。事務所にも、あとで叱られました』"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "『仕事中は喋らない、という契約書にハンコも押しました』"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "『それより営業トークばかりしないで、次の曲に入れ、との指示です』"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
