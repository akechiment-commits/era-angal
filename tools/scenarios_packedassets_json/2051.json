    "position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "『先輩も、よくこの『秘密の勉強会』に参加されるのですか？』"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 64,
    "dress": "default",
    "pose": "1",
    "expression": "default_expression/serious",
    "expression_position": {
      "x": 4,
      "y": 492
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "『ふむふむ。転校したてのころ、私と同じように遅れていた教科を重点的に勉強していて……』"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "『それが習慣になって、定期的に『秘密の勉強会』に参加されているのですね』"
