  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「大丈夫ですの～。ゆうちゃん、歌うの大好きですから。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいりは知ってますの、それなりに長い付きあいですし」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「ゆうちゃんね……。いつも誰よりも早く部室にきて、熱心に練習してますのよ」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「一生懸命だと思われるのが、恥ずかしいのかしらね。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「他の子がくると、『やる気なくなっちゃった』とか言って寝ちゃうんですけど」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「みんなが帰ったあととか、思いだしたように起き上がって居残って練習してますのよ。歌と、伴奏のね。」"
  },
