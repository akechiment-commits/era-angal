  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「どうでしょう……。ゆうちゃん、あんまり自分のことを喋ってくれませんから。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「誰かと歌声をあわせようとして、ずれてしまうのが怖いのかしら」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「あわせられない、わかりあえない、誰かと一緒に歌声を響かせることなんてできないって……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「諦めてる、ううん、やっぱり怖がってるのかしらね」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「あの子はね……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「自分とそっくり『同じ』ような従姉妹のお姉さんに、」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「ぴったりくっつくようにして幼少期を過ごしていたみたいですの」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「自分が存在しないみたいに、お姉さんと『同じ』ことばっかりして……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「お姉さんと『同じ』になって、『同じ』人生を歩もうとしてましたの」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「髪型も言動も真似て、すでにお姉さんが耕した……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「安全だってわかってる、整備された道だけを歩いてきたみたいですの」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「でも。お姉さんは嫁いでいって、ゆうちゃんは取り残されて……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「きっと、どうしたらいいかわからないんですの」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「マルちゃんと遠ざかったころの、かいりと同じように」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「右も左もわからなくて、真っ暗闇のなか……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「これまでずっとお手本にしていた、お姉さんと離れ離れになって。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「一歩も動けなくなって、独りぼっちで泣いてますの」"
  },
