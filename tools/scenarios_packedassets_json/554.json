    }
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あたしたち、ずいぶん長い付きあいだけれど。中学生のころからだから、もう何年になるかなぁ。」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「クロちゃんはむかしから、刺々しかったよね」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「他人を拒絶することでしか、自分の心を守れなかった。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 468
    }
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「その瞳もそうだけど……他人とちがうから、他人と関わると傷つくだけだった」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あたし、ずっとクロちゃんのことが気になってたの。でも、最後まで何もしなかった。」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「見てるだけだった、クロちゃんの抱えた哀しみに巻きこまれる覚悟がなかったの」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「そんなクロちゃんを、『あのひと』が……救った。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 468
    }
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あたしがずっとできなかったことを、あっさりとやり遂げた。あたしは、ほっとしたけれど」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 468
    }
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「『あのひと』も、いまはもう遠ざかっちゃった」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「クロちゃんは、すべての居場所をなくして途方にくれてた。翼が折れたみたいに、蹲ってた。」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あたしはそれを見て、堪らなくなって、勇気をだして軽音部に誘ったの」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あたしの居場所に、あなたを招いたの。」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「軽音部が、あなたの折れた翼を癒す居場所になることを祈ってね」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「もっと早く、そうするべきだった。だから、ごめんねクロちゃん」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あたしは意気地なしだった、ずっと。すぐそばにいたのに、手を差しのべることを躊躇ってた。」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「クロちゃんが傷ついて、苦しんでるのを、ただ見ていたの」"
  }
