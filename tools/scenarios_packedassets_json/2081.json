    "active": true
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "そう思ってさ、じゃ～ん♪　今日はお弁当をおおめにつくってきたんだよね、よかったら食べて？"
  },
  {
    "command": "update_character",
