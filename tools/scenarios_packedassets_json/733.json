    "expression_position": {
      "x": 8,
      "y": 510
    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（とはいえ、もう残りの周回数はわずか。何とか後続を引き離し、ぼたんは目と鼻の先。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（勝負を仕掛けるなら、今しかない）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
