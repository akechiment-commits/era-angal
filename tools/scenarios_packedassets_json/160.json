      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（ふふ）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（やはり『ルカ』は福音を届けるイエス様の使徒のひとり——）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（ひねくれて、迷うことがあっても、神はきっと導いてくださいます）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（あなたのなかにいる神と、きちんと向きあえたようですね）"
  },
