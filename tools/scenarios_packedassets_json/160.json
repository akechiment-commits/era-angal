  {
    "command": "talk",
    "speaker": "るか",
    "text": "（今なら、歌える気がするんだ）"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（ごめんね。ぐしゃぐしゃに丸めて捨てちゃった、ぼくの歌。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-santa",
    "pose": 0,
    "active": true,
    "expression": "old-santa_expression/normal",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（神さまに愛されなかったぼくたちが、何かを捨てちゃあいけないんだ。）"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（ぼくたちだけにしか、歌えない歌がある。）"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（すず先輩は、そんな歌を拾いあげて愛する、ぼくたちの堕天使（ルシフェル）さまなんだ……）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 28,
    "dress": "old-santa",
    "pose": 0,
    "active": true,
    "expression": "old-santa_expression/joyful",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（ぼくはもう逃げない、迷わないよ。）"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（ぐしゃぐしゃに丸めて、雪みたいに積もったぼくの弱さと嘘のなかから、）"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "（たいせつなものを見つけたから）"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「ろっくん・ろ〜るっ！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 18,
    "dress": "old-santa",
    "pose": 0,
    "active": true,
    "expression": "old-santa_expression/joyful",
