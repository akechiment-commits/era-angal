  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "昨日、あの子が変な様子になってたのは、それが理由。『悪いもの』に憑かれたんだ、こんなふうに説明しても納得してはもらえないかもしれないけど"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "miko",
    "pose": "1",
    "expression": "miko_expression/serious",
    "expression_position": {
