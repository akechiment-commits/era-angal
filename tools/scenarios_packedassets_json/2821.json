      "y": 498
    },
    "active": true
  },
  {
    "command": "play_voice",
    "asset_code": "web:voice/character/8/emo_response-3.wav"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "昔から、同じようなことは何度もあった。わたしは、それに対処する方法を両親から学び、また経験から体得している。お姉ちゃんとして、ずっと妹を守ってきたの"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "たとえば昨日は、『悪いもの』が嫌がるものを学校の周りに配置して、結界を敷いて逃がさないようにしてたよ"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "そうやって『悪いもの』を閉じこめてから、祓うつもりだった。いつも、そうやっていちかに憑いたものに対処してきたの"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "miko",
    "pose": "2",
    "expression": "miko_expression/sad1",
    "expression_position": {
