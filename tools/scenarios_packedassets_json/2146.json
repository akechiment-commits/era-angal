  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "おっと。ごめんね、つい立ち話をしちゃって。転校生くん、あんまりお喋りは好きじゃなさそうだもんねぇ。駄目だねぇ、井戸端会議をしちゃあ♪"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 55,
    "dress": "civvies",
    "pose": "1",
    "expression": "civvies_expression/joyful",
