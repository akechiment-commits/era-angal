  {
    "command": "play_voice",
    "asset_code": "web:voice/character/55/emo_puzzle-2.wav"
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "そっかぁ、行きもお母さんの車できたから……。転校生くん、帰りかたがわかんなくなっちまったのかい。そりゃあ難儀だねぇ、だから途方に暮れてたんだねぇ？"
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "転校生くん、このへんは不案内なんだね。そりゃ仕方ないよ、転校生だもんねぇ？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 55,
    "dress": "civvies",
    "pose": "2",
    "expression": "civvies_expression/expressionless",
    "expression_position": {
      "x": 0,
      "y": 518
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "ふぅん、ちっちゃいころはこのへんで暮らしてたのかい。あぁ、でも離れてた時期が長かったなら仕方ないよ。このへん、ずいぶん様変わりしちまったからねぇ？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 55,
    "dress": "civvies",
    "pose": "2",
    "expression": "civvies_expression/sad1",
