    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「手伝ってくれたみんなにバイト代を支払ったら、今日の儲けは『すっからかん』アルけど。」"
  },
  {
    "command": "update_character",
    "id": "center",
