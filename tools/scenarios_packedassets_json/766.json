    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「やっぱり店の外観が怪しいせいか、普段はそこまでお客さんが入らないアルからね～。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 48,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/joyful",
    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「おかげでドタバタしちゃったアルけど、ワタシも新鮮で楽しかったアル～♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 48,
