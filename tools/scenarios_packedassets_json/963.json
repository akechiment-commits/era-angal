    "character": 1,
    "dress": "old-wedding",
    "pose": 0,
    "active": true,
    "expression": "old-wedding_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「その日まで、わたしが大切に保管しておくよ。」"
