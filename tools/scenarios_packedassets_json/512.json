    }
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あれ、転校生くん？　どど、どうして顔を近づけてくるのっ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
