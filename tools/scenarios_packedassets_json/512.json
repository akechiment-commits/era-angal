    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「な、何か抱きつかれてる……？　感動の再会、かな？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-civvies2",
    "pose": 0,
    "active": true,
    "expression": "old-civvies2_expression/joyful",
    "expression_position": {
