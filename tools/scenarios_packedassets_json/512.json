    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「これからも、すこしでも支えさせてね。ううん、お互いに支えあっていけたらいいな」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしじゃ、頼りにならないかもしれないけど。」"
  },
  {
    "command": "talk",
