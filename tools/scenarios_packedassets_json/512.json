  },
  {
    "command": "set_still_image",
    "id": "card/evolved/497"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あっ、こっちに気づいた。手を振ってるよ、かわいいなぁ〜♪」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ふふ。軽音部みんなで、手を繋いで帰ってくよ。だからたぶん、もう迷子にならないよね」"
  },
  {
    "command": "update_character",
    "id": "center",
