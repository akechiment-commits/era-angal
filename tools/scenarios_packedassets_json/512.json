    "expression": "old-civvies2_expression/embarrassed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「だ、だめ〜っ！」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「たしかにお世話になってるしお礼もしたいけど、まだキスとかしちゃヤだぁ〜っ!?」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-civvies2",
    "pose": 0,
    "active": true,
    "expression": "old-civvies2_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あ、ありゃ？　もしかして、寝ちゃってる？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「な、なぁんだ。びっくりした……。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あぁ恥ずかし、わたしったら変な勘違いしちゃって。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-civvies2",
    "pose": 0,
    "active": true,
    "expression": "old-civvies2_expression/embarrassed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そうだよね、んもう馬鹿みたい。あぁ、顔が熱いっ！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-civvies2",
    "pose": 0,
    "active": true,
    "expression": "old-civvies2_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「やっぱり、疲れてるんだろうね。さすがの転校生くんも、おねむだね。良い子、良い子♪」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしにも、ちょっとでも寄りかかってくれるんだなぁ。何だか、嬉しいな♪」"
