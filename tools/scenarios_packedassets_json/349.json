      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「ん、んん？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "old-default",
    "pose": 0,
    "active": true,
