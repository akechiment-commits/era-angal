    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "『うん。初めて出会ったときに、ふたりでつくった曲だよね？』"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "『どうりで、聞き覚えがあると思ったよ。そっか、いつも頭のなかに流れてた曲だよ。』"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "『それが当たり前になってて、すぐにわからなかったよ』"
