      "x": 4,
      "y": 492
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "ていうが。べつに食レポの依頼がきたわげじゃねぇのに、何でこんな練習をしなくちゃいけねぇんだ？"
  },
  {
    "command": "talk",
