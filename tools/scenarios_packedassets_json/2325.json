    "asset_code": "web:voice/character/65/emo_worry-1.wav"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "ん～……こういうのは、人真似じゃ意味ないよ。あたしをお手本にしても、『あたしっぽいコメント』ができるようになるだけでしょ？"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "a-civvies",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": -16,
      "y": 454
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "せっかくコンビなんだから、それぞれが異なるコメントをしたほうがいいよ。あたし褒め殺しも毒舌もいけるから、ことりんの方向性をまず定めるのが先かな"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "ことりんの逆方向のコメントをあたしが言えば、キャラ分けができるでしょ？"
