  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "それなのに……。つばさしゃん、ラジオ番組の出演依頼とが請けるし。今日だって何かのドラマのちょい役として出演するどがいって、演技指導を受けるんだろ？"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "a-civvies",
    "pose": "1",
    "expression": "a-civvies_expression/serious",
    "expression_position": {
