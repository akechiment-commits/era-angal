      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（今回は、わたしはどうしよう。『生徒会長再任選挙』のときは、おかしくなって暴走してみんなに迷惑かけちゃったし……）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（見ないふり、聞かないふりがいいのかな）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "default",
    "pose": "1",
    "expression": "default_expression/sad1",
    "expression_position": {
      "x": 0,
      "y": 496
