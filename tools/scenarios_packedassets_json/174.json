  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「『久坂あやめが一年生をいじめてた！』って噂になっちゃうから……。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「ただでさえ私、みんなに怖がられてるのに……」"
