    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「そうじゃなくて——えぇっと、ごめんね。誤解させちゃったわね」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「あのね、私は生物部なんだけど。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「うさちゃんとか、つい甘やかして餌をあげすぎちゃうの。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「そしたら、ぶくぶく太っちゃって……」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「それじゃあ健康によくないし、ダイエットをさせたいのだけど。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「私、そういうのあんまり詳しくなくて」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「だから、料理研究部の小野さんなら、」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「そういうダイエット食品とかに詳しいんじゃないかって——」"
  },
  {
