  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「大丈夫ですか？　ずいぶん、のぼせてしまったようですね。」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「いつまでも、無理をしてサウナなどに居座っているからですよ……？」"
