  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「うるさぁい！　あんたがいつまでもサウナにいるから、」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「あたしが先にギブアップするわけにはいかない！　と思って、ずっと長々と付きあってたんでしょ～!?」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「まりあなんかに負けるわけにはいかないのよ、このあたしが！」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「おかげで脱水症状だわ、頭痛が酷くって最悪だわ！　訴えてやるんだから！」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「そうよ忘れてたわよ、あんた意外と我慢強いのよねっ？」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「サウナのなかでもずっと涼しい顔しちゃってさ、針で刺しても感じないんじゃないのっ!?」"
  },
  {
    "command": "update_character",
