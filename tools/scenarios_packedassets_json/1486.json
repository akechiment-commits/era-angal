    }
  },
  {
    "command": "set_still_image",
    "id": "card/evolved/1115"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「怖かった……。誰も応援してくれなかった、教師も親もだ～れも！」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「あんた、自分が世界でいちばん不幸だって顔をして！」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「全然そんなことないのに、あんたはまだ君咲学院に残れるのに！」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「あったかいところで、のうのうと……。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「恥ずかしげもなく留年なんかしちゃって、一回こっきりの人生を無駄遣いして」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「回り道してさ！　うちが、手ぇ引いてあげたのに！」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「あんたが、あんたがいつかうちの手ぇ引いてくれるかもって。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「成長して、強くなって、一緒に泳いでくれるかもって……。期待したのに、寂しかったのに」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「怖かったのに。いつまでも膝を抱えて、水底で泣きべそかいてばっかりで」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「泣きたいのは、うちのほうだっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「置き去りにされるのは、うちのほうだっち！」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「ううっ、うあぁぁああん……！」"
  },
