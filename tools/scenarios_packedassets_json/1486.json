  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「…………」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「何で、そんなこと言うっちか。忘れちゃってもいい、って……？」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「忘れられると、思ってるっちか。あんたみたいな、変なやつを」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「金魚ちん。自分ばっかり泣いて……。うちが、うちが寂しくないとでも思ってるっちか」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「うちが、どんな気持ちでいたか、あんた知りもしないくせに。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「勝手に手ぇはなして、あんただけ、あったかいところに留まって」"
  },
  {
