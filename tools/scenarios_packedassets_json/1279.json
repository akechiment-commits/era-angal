  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（あたしを変えたのは、こんなふうにしたのは、ほとりちゃんなのに。その責任をとらない、ずっとずっと。）"
  },
  {
    "command": "update_character",
