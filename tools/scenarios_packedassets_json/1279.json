    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（…………）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（ほとりちゃんに怒るのは、お門ちがいなのかもしれない。理性で、論理で、そう判断するしかない。）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（あたしと、ほとりちゃんは、根本的なところで『ちがう』んだ）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（同じ星に、生まれて）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（だけど。夜空の星みたいに、すれちがうしかない）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（そういう運命だったんだ。）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（ちいさな子供だったころ、手を繋いで野原を走り回った。触れあって、そばにいた。）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（あれが、ありえない奇跡だったんだ）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（そう思って、諦めて、折りあいをつけて。この人生が終わるまで、遠い光をただ愛でるだけ……）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（それでもいいって思い始めてたのに、どうしてまたあたしの前に姿を見せたの？）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（期待させて、また傷つけて、あたしを苦しめてそんなに楽しい？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 67,
    "dress": "old-f-coat",
    "pose": 0,
    "active": true,
    "expression": "old-f-coat_expression/angry",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（何もできないくせに！　『ふつうのひと』のくせに！　もう近づかないでよ、甘い言葉で惑わさないで！）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（二度と顔なんか見せないでほしかった！　あたしのことなんか忘れてほしかった！）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（あたしなんかに縛られずに！　ほとりちゃんは、幸せになるべきひとなのに！）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（笑顔で、生きていくべきひとなのに！　あたしが歪めてしまった、これ以上はもう嫌！）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（残酷すぎる、あたしの心は耐えられない！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 67,
    "dress": "old-f-coat",
