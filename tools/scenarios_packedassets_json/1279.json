    "active": true,
    "expression": "old-f-coat_expression/angry",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（何が、『仲直り』だ）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（何が『遠くても、いつだって、あんたのことを想ってた』だ！）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（白々しい、信じられない！　ずっと、あたしを放っておいたくせに！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 67,
    "dress": "old-f-coat",
    "pose": 0,
    "active": true,
    "expression": "old-f-coat_expression/sad",
