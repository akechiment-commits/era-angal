    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「えっ？　あの、ぼく楽器はあんまりっ？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 28,
    "dress": "old-nurse",
    "pose": 0,
    "active": true,
    "expression": "old-nurse_expression/sad",
    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「ぎ、ギターとかは練習してるんですけど！　あと、お兄ちゃんの作曲ソフトをいじらせてもらったりとか……？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-nurse",
    "pose": 0,
    "active": true,
    "expression": "old-nurse_expression/normal",
    "expression_position": {
      "x": 4,
