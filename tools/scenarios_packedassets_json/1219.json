    }
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「さっき病室で、小鳩さんが部長さんを『お姉ちゃん』って呼んでるの見て……。」"
  },
  {
    "command": "talk",
    "speaker": "るか",
