  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（転校生くん、ひとりで苦しんでるかなって思って、行ったのに）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（君には看病してくれる人がいたんだね）"
