  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（あ、隠れた——つもりなのかな、あれ。）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（円城寺さん目立つから、まったく隠れられてないんだけど。）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（指摘するべき？　う〜ん、でもなぁ……）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（あ。そういえばこないだ、）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（円城寺さんがつくったケーキを『不味いねこれ』って言っちゃったんだっけ）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（もしかして、あれを気にしてるのかな——円城寺さん、）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（あまりひとから批判されたことなさそうだし。）"
  },
  {
    "command": "update_character",
