    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「あっごめん、何か地雷踏んじゃった？　あんまり触れちゃいけない話題だよね、それ？」"
