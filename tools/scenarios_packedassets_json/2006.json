  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「申し訳ない！　駄目だな〜、あたし！　ほんと、気遣いが足りない！」"
