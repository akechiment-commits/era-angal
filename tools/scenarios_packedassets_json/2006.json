    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「ゆきちゃんといえば、あいつこのへんのゲーセンでいつも遊んでるんだよね。今日もいるかも。」"
