    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「うっそ、血ぃ繋がってないの？」"
