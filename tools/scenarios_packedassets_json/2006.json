  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「よせやい、惚れちゃうぞ〜♪」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「ゆきちゃんに、怒られちゃう」"
  },
  {
    "command": "update_character",
