  {
    "command": "set_still_image",
    "id": "card/normal/1367"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「う〜、わからん。あたしが、何でバカ親父のためにこんなに悩まなくちゃいけないわけっ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
