    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「せっかくだから、暇そうだったら誘って一緒にデートしよ〜♪」"
