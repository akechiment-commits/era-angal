  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「あんたはさ〜、家族の誕生日とかどうしてる？　けっこう、お姉さんとは仲良しみたいだけど……？」"
