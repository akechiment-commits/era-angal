  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「働きづめだとぶっ倒れちゃうよ、たまには息抜きしないとね〜♪」"
