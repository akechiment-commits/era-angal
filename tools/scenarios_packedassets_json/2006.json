    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「いつもは理由つけてすっぽかしてたんだけどさ、それも何かね〜？」"
