  {
    "command": "update_character",
    "id": "center",
    "character": 47,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「えっ、それはこっちの台詞って？　いつも、がんばってバイトとかして偉いって？」"
