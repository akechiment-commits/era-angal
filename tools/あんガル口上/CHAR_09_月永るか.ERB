;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_9
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「ふふっ、今日はありがとう、先輩♪　また会いたいな……」
	CASE 1
		PRINTFORML 「（先輩と一緒の時間、あっという間に終わっちゃった……）またね、先輩～♪」
	CASE 2
		PRINTFORML 「先輩、お疲れさま！　今日はすっごく楽しかった……次もよろしくね、約束だよ？」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「じゃ、じゃあ、ぼくはこのへんで……。お疲れさまでした、転校生のひと」
	CASE 1
		PRINTFORML 「えっと、もう行きますね？　すず先輩が待ってるかもだし……バイバイっ？」
	CASE 2
		PRINTFORML 「（はぁ、緊張した……）今日はありがとうございました、それじゃっ」
	ENDSELECT
ENDIF
RETURN
