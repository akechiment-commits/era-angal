;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 月永るか　NO:9　?年1-B　軽音部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_9
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「あれっ、転校生のひと……？　な、何でぼくに話しかけるの～？　ぼ、ぼくは軽音部の月永るかですけど……えっと、何かご用ですか？」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「な、何でぼくがこのお部屋にいるんですか……？　ぼく、迷いこんじゃったみたいで～？　はうっ、転校生のひとっ!?」
	ELSE
		PRINTFORML 「えっと……すず先輩のおつかいで来ました。軽音部の月永るかです、よろしくお願いしますね……？」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_9
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_9
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生の先輩……♪　えへへ、また会えたね～」
	ELSEIF A == 1
		PRINTFORML 「（せ、先輩のお顔を見ると、どきどきしちゃう……）こ、こんにちは！」
	ELSE
		PRINTFORML 「先輩、こんにちは！　今日もぼくに会いに来てくれたの……？　うう、嬉しいけど照れちゃう」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生のひと……？　な、何の用ですか？　ぼ、ぼくべつに先輩と仲良くないからねっ？」
	ELSEIF A == 1
		PRINTFORML 「えっ、また来たんですか？　んもう、なんでぼくのところに来るの～？」
	ELSE
		PRINTFORML 「（がるるる……）あ、何でもないです。今日は何ですか？」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_9
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「お、おはようございます、転校生の先輩……♪　えへへ、朝から会えるなんて」
	CASE 1
		PRINTFORML 「先輩、おはよう！　今日も一日、よろしくね～♪」
	CASE 2
		PRINTFORML 「（朝は苦手だけど、先輩のお顔を見ると元気が出る……）おはよ、せ、先輩」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「あ、おはようございます……？　な、なんで朝からぼくに話しかけるの～？」
	CASE 1
		PRINTFORML 「ふぁ……おはようございますぅ。眠たいから、あんまり話しかけないでください～」
	CASE 2
		PRINTFORML 「（朝は苦手……）あ、おはよう、転校生のひと。はう、目があった」
	ENDSELECT
ENDIF
RETURN

;------------------------------------------------------------
; 休憩（SHOPで休憩を選んだとき）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REST_9
IF TALENT:TARGET:153
	PRINTFORML 「先輩、お疲れさま♪　ちょっと休憩しよっか？　ふふっ、お話したいな～」
ELSE
	PRINTFORML 「えっと、ちょっと休憩しません……？　ぼく、息切れしちゃって、はぁはぁ……」
ENDIF
RETURN

;------------------------------------------------------------
; 昼食（LUNCH_EAT_昼食・食事 経由・昼に呼ばれる）
