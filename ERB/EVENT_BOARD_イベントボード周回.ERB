;==================================================
; EVENT_BOARD_イベントボード周回.ERB v3
; 新仕様:
;   体力消費 → エリア進行 → ミッション発生
;   → 気力消費 → 発揮値を積む → ミッション達成 → PTゲット
;   エリア進捗が100%になると踏破報酬 → リセット
;
; 使用変数:
;   TFLAG:91 = イベントタイプ(0:収拾/1:バトル/2:宝探し/3:すごろく)
;   TSTR:99  = 選択中イベント名
;   FLAG:32  = 月間イベントPT累計（月初リセット）
;   FLAG:33  = すごろく盤面位置(タイプ3のみ, 0-19)
;   FLAG:34  = ミッション進捗（累積発揮値）
;   FLAG:35  = ミッション目標値
;   FLAG:36  = ミッション種別(0=なし/1=通常/2=特大/3=緊急)
;   FLAG:38  = エリア進捗（0～99、100で踏破報酬・リセット）
;   FLAG:64  = 通常ミッションLv（月初リセット）
;   FLAG:65  = 特大ミッションLv（月初リセット）
;   FLAG:66  = 緊急ミッションLv（月初リセット）
;   FLAG:67  = 月変更検知用（前回月）
;   FLAG:68  = 選択中イベントの月内インデックス(0-5)
;   FLAG:71～76 = 今月各イベントポイント（月初リセット）
;==================================================

@EVENT_BOARD_MAIN
IF TARGET < 0
	PRINTFORMW パートナーが選択されていません。
	RETURN 0
ENDIF

;月変更チェック → ミッションLv・イベントポイント・エリア番号リセット
IF FLAG:67 != DAY:8
	REPEAT 6
		FLAG:(71 + COUNT) = 0	;イベントポイント
		FLAG:(98 + COUNT) = 1	;エリア番号
	REND
	REPEAT 18
		FLAG:(78 + COUNT) = 1	;イベント別ミッションLv（各3スロット×6イベント）
	REND
	FLAG:37 = 0	;すごろく周回数リセット
	FLAG:67 = DAY:8
ENDIF

;今月のイベント一覧を取得
A = DAY:8
CALL LOAD_MONTH_EVENTS, A
LOCAL:9 = RESULT	;今月のイベント数

IF LOCAL:9 == 0
	PRINTFORMW 今月のイベントはありません。
	RETURN 0
ENDIF

;イベント選択
$EVENT_SELECT
DRAWLINE
PRINTFORML 【イベントボード】　%NAME:TARGET%　{DAY:8}月
PRINTL
FOR LOCAL:8, 0, LOCAL:9
	A = 100 + LOCAL:8
	IF TFLAG:A == 0
		PRINTFORML [{LOCAL:8 + 1}] [収拾]　%TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 1
		PRINTFORML [{LOCAL:8 + 1}] [バトル] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 2
		PRINTFORML [{LOCAL:8 + 1}] [宝探し] %TSTR:(100+LOCAL:8)%
	ELSE
		PRINTFORML [{LOCAL:8 + 1}] [すごろく] %TSTR:(100+LOCAL:8)%
	ENDIF
NEXT
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > LOCAL:9
	GOTO EVENT_SELECT
ENDIF

;選択されたイベントのタイプと名前をセット
LOCAL:8 = RESULT - 1
A = 100 + LOCAL:8
TFLAG:91 = TFLAG:A
TSTR:99 = %TSTR:A%
FLAG:68 = LOCAL:8	;イベントインデックス保存(0-5)

;ミッション状態クリア（新規開始）
FLAG:34 = 0
FLAG:35 = 0
FLAG:36 = 0
$BOARD_LOOP
DRAWLINE
CALL EVENT_BOARD_STATUS

IF FLAG:36 > 0
	;ミッションアクティブ中
	CALL EVENT_BOARD_MISSION_STATUS
	PRINTL
	LOCAL:0 = MAXBASE:MASTER:1 / 10
	SIF LOCAL:0 < 5
		LOCAL:0 = 5
	LOCAL:1 = MAXBASE:MASTER:0 / 20
	SIF LOCAL:1 < 5
		LOCAL:1 = 5
	PRINTFORML [1] 気力を使う（-{LOCAL:0}）
	IF TFLAG:91 == 3
		PRINTFORML [2] サイコロを振る（体力-{LOCAL:1}）
	ELSE
		PRINTFORML [2] エリアを進む（体力-{LOCAL:1}）
	ENDIF
	PRINTFORML [3] デッキ編成
	SIF ITEM:92 > 0
		PRINTFORML [4] ドーナツを使う（気力+1500）　所持:{ITEM:92}個
	SIF ITEM:93 > 0
		PRINTFORML [5] パフェを使う（気力+3000）　所持:{ITEM:93}個
	PRINTFORML [0] ミッション破棄（このミッションLv-1）
	$BOARD_MISSION_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 1
		CALL EVENT_BOARD_ATTACK
	CASE 2
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 3
		CALL EDIT_DECK
	CASE 4
		CALL EVENT_BOARD_USE_ENERGY_1
	CASE 5
		CALL EVENT_BOARD_USE_ENERGY_2
	CASE 0
		CALL EVENT_BOARD_ABANDON_MISSION
	CASEELSE
		GOTO BOARD_MISSION_INPUT
	ENDSELECT
ELSE
	;ミッションなし・進行フェーズ
	LOCAL:0 = MAXBASE:MASTER:0 / 20
	SIF LOCAL:0 < 5
		LOCAL:0 = 5
	IF TFLAG:91 == 3
		PRINTFORML [1] サイコロを振る（体力-{LOCAL:0}）
	ELSE
		PRINTFORML [1] エリアを進む（体力-{LOCAL:0}）
	ENDIF
	PRINTFORML [2] デッキ編成
	SIF ITEM:90 > 0
		PRINTFORML [3] おにぎりを使う（体力+1000）　所持:{ITEM:90}個
	SIF ITEM:91 > 0
		PRINTFORML [4] カレーを使う（体力+5000）　所持:{ITEM:91}個
	PRINTFORML [0] イベント終了
	$BOARD_ADVANCE_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 2
		CALL EDIT_DECK
	CASE 3
		CALL EVENT_BOARD_USE_STAMINA_1
	CASE 4
		CALL EVENT_BOARD_USE_STAMINA_2
	CASEELSE
		GOTO BOARD_ADVANCE_INPUT
	ENDSELECT
ENDIF
GOTO BOARD_LOOP

;---------------------------------------------------------
; ステータス表示
;---------------------------------------------------------
@EVENT_BOARD_STATUS
PRINTFORML 【%TSTR:99%】
IF TFLAG:91 == 0
	PRINTFORML 収拾イベント　発揮値：表現力
ELSEIF TFLAG:91 == 1
	PRINTFORML バトルイベント　発揮値：運動力
ELSEIF TFLAG:91 == 2
	PRINTFORML 宝探しイベント　発揮値：学力
ELSE
	PRINTFORML すごろくイベント　発揮値：好感度
ENDIF
CALL EVENT_BOARD_CALC_HAKKIICHI
PRINTFORML 体力:{BASE:MASTER:0}/{MAXBASE:MASTER:0}　気力:{BASE:MASTER:1}/{MAXBASE:MASTER:1}　発揮値:{RESULT}
A = FLAG:68 + 98	;エリア番号index
B = 71 + FLAG:68	;イベントPT index
IF TFLAG:91 == 3
	PRINTFORML 今月PT:{FLAG:32}　エリア{FLAG:A}　周回数:{FLAG:37}周
ELSE
	PRINTFORML 今月PT:{FLAG:32}　エリア{FLAG:A}　進捗:{FLAG:38}/100
ENDIF
PRINTFORML %TSTR:99%PT:{FLAG:B}
A = FLAG:68 * 3 + 78	;通常Lv index
B = A + 1	;特大Lv index
C = A + 2	;緊急Lv index
PRINTFORML ミッションLv　通常:{FLAG:A}　特大:{FLAG:B}　緊急:{FLAG:C}
IF TFLAG:91 == 3
	CALL SUGOROKU_DRAW_BOARD
ENDIF
PRINTFORML おにぎり:{ITEM:90}個　カレー:{ITEM:91}個　ドーナツ:{ITEM:92}個　パフェ:{ITEM:93}個
RETURN 1

;---------------------------------------------------------
; ミッション状況表示
;---------------------------------------------------------
@EVENT_BOARD_MISSION_STATUS
A = FLAG:68 * 3 + 77 + FLAG:36	;現在のミッションLv index
IF FLAG:36 == 1
	PRINTFORML ▼ 通常ミッション Lv{FLAG:A}
ELSEIF FLAG:36 == 2
	PRINTFORML ▼▼ 特大ミッション Lv{FLAG:A}
ELSE
	PRINTFORML ▼▼▼ 緊急ミッション Lv{FLAG:A}！
ENDIF
PRINTFORML 進捗: {FLAG:34} / {FLAG:35}
LOCAL:0 = FLAG:34 * 10 / FLAG:35
SIF LOCAL:0 > 10
	LOCAL:0 = 10
PRINTFORM 達成率: [
FOR LOCAL:8, 0, 10
	IF LOCAL:8 < LOCAL:0
		PRINTFORM #
	ELSE
		PRINTFORM .
	ENDIF
NEXT
PRINTFORML ] {FLAG:34 * 100 / FLAG:35}/100
RETURN 1

;---------------------------------------------------------
; エリア進行（体力消費 → エリア進捗 → ミッション発生）
;---------------------------------------------------------
@EVENT_BOARD_ADVANCE
LOCAL:0 = MAXBASE:MASTER:0 / 20
SIF LOCAL:0 < 5
	LOCAL:0 = 5

IF BASE:MASTER:0 < LOCAL:0
	PRINTFORMW 体力が足りない！これ以上進めない。
	RETURN 0
ENDIF

BASE:MASTER:0 -= LOCAL:0

;エリア進捗 +10
FLAG:38 += 10
PRINTFORML 体力 -{LOCAL:0}　エリアを進んだ。（進捗: {FLAG:38}/100）

;ランダムドロップ（PT + 稀にアイテム）
CALL EVENT_BOARD_RANDOM_DROP

;エリア踏破チェック
SIF FLAG:38 >= 100
	CALL EVENT_BOARD_AREA_COMPLETE

;ミッション発生判定（ミッション中は発生しない）
IF FLAG:36 == 0
	LOCAL:2 = RAND:100
	IF LOCAL:2 < 50
		FLAG:36 = 1
		A = FLAG:68 * 3 + 78	;通常Lv index
		FLAG:35 = 100 * FLAG:A + RAND:200
		FLAG:34 = 0
		PRINTL
		PRINTFORML ▼ 通常ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:35}
	ELSEIF LOCAL:2 < 80
		FLAG:36 = 2
		A = FLAG:68 * 3 + 79	;特大Lv index
		FLAG:35 = 400 * FLAG:A + RAND:400
		FLAG:34 = 0
		PRINTL
		PRINTFORML ▼▼ 特大ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:35}
	ELSEIF LOCAL:2 < 95
		FLAG:36 = 3
		A = FLAG:68 * 3 + 80	;緊急Lv index
		FLAG:35 = 800 * FLAG:A + RAND:1000
		FLAG:34 = 0
		PRINTL
		PRINTFORML ▼▼▼ 緊急ミッション Lv{FLAG:A} 発生！！　目標値: {FLAG:35}
	ELSE
		LOCAL:3 = MAXBASE:MASTER:1 / 5
		BASE:MASTER:1 += LOCAL:3
		SIF BASE:MASTER:1 > MAXBASE:MASTER:1
			BASE:MASTER:1 = MAXBASE:MASTER:1
		PRINTFORML ひと息ついた。　気力 +{LOCAL:3}
	ENDIF
ENDIF
WAIT
RETURN 1

;---------------------------------------------------------
; 攻撃（気力消費 → 発揮値を進捗に加算）
;---------------------------------------------------------
@EVENT_BOARD_ATTACK
LOCAL:0 = MAXBASE:MASTER:1 / 10
SIF LOCAL:0 < 5
	LOCAL:0 = 5

IF BASE:MASTER:1 < LOCAL:0
	PRINTFORMW 気力が足りない！攻撃できない。
	RETURN 0
ENDIF

CALL EVENT_BOARD_CALC_HAKKIICHI
LOCAL:1 = RESULT

BASE:MASTER:1 -= LOCAL:0
FLAG:34 += LOCAL:1
PRINTFORML 気力 -{LOCAL:0}　発揮値 +{LOCAL:1}　（進捗: {FLAG:34}/{FLAG:35}）

IF FLAG:34 >= FLAG:35
	CALL EVENT_BOARD_MISSION_CLEAR
ELSE
	WAIT
ENDIF
RETURN 1

;---------------------------------------------------------
; ミッションクリア処理
;---------------------------------------------------------
@EVENT_BOARD_MISSION_CLEAR
DRAWLINE
A = FLAG:68 * 3 + 77 + FLAG:36	;現在のミッションLv index
IF FLAG:36 == 1
	LOCAL:0 = 2 + 2 * FLAG:A	;Lv1=4 Lv2=6...
	PRINTFORML ★ 通常ミッション Lv{FLAG:A} クリア！
ELSEIF FLAG:36 == 2
	LOCAL:0 = 4 + 4 * FLAG:A	;Lv1=8 Lv2=12...
	PRINTFORML ★★ 特大ミッション Lv{FLAG:A} クリア！！
ELSE
	LOCAL:0 = 7 + 8 * FLAG:A	;Lv1=15 Lv2=23...
	PRINTFORML ★★★ 緊急ミッション Lv{FLAG:A} クリア！！！
ENDIF
FLAG:A += 1
PRINTFORML → Lv{FLAG:A}へ！
FLAG:32 += LOCAL:0
B = 71 + FLAG:68
FLAG:B += LOCAL:0
PRINTFORML イベントPT +{LOCAL:0}
PRINTFORML 今月累計:{FLAG:32}　%TSTR:99%PT:{FLAG:B}
PRINTL
;ミッションクリア報酬：ガチャ2回
;通常=ブロンズ(1) 特大=シルバー(2) 緊急=ゴールド(3)
LOCAL:9 = FLAG:36
FLAG:36 = 0
FLAG:34 = 0
FLAG:35 = 0
IF LOCAL:9 == 1
	PRINTFORML 【報酬】ブロンズガチャ ×2
	CALL GACHA_PULL, 1
	CALL GACHA_PULL, 1
ELSEIF LOCAL:9 == 2
	PRINTFORML 【報酬】シルバーガチャ ×2
	CALL GACHA_PULL, 2
	CALL GACHA_PULL, 2
ELSE
	PRINTFORML 【報酬】ゴールドガチャ ×2
	CALL GACHA_PULL, 3
	CALL GACHA_PULL, 3
ENDIF
WAIT
RETURN 1

;---------------------------------------------------------
; エリア踏破報酬（FLAG:38 リセット）
;---------------------------------------------------------
@EVENT_BOARD_AREA_COMPLETE
DRAWLINE
A = FLAG:68 + 98	;エリア番号index
PRINTFORML ★★★ エリア{FLAG:A} 踏破！ ★★★
LOCAL:0 = 5 + RAND:6
FLAG:32 += LOCAL:0
B = 71 + FLAG:68
FLAG:B += LOCAL:0
PRINTFORML イベントPT +{LOCAL:0}　（今月累計: {FLAG:32}）
FLAG:38 = 0
FLAG:A += 1
PRINTFORML エリア{FLAG:A}に進行！
WAIT
RETURN 1

;---------------------------------------------------------
; 発揮値計算（RETURN で返す）
; イベントタイプにより算出方法が異なる
;---------------------------------------------------------
;---------------------------------------------------------
; ミッション破棄（Lv-1 → ミッションなし状態へ）
;---------------------------------------------------------
@EVENT_BOARD_ABANDON_MISSION
DRAWLINE
A = FLAG:68 * 3 + 77 + FLAG:36	;現在のミッションLv index
IF FLAG:36 == 1
	PRINTFORML ミッション破棄。通常ミッション（Lv{FLAG:A}）
ELSEIF FLAG:36 == 2
	PRINTFORML ミッション破棄。特大ミッション（Lv{FLAG:A}）
ELSE
	PRINTFORML ミッション破棄。緊急ミッション（Lv{FLAG:A}）
ENDIF
SIF FLAG:A > 1
	FLAG:A -= 1
PRINTFORML → Lv{FLAG:A}に下がった。
FLAG:34 = 0
FLAG:35 = 0
FLAG:36 = 0
WAIT
RETURN 1

;---------------------------------------------------------
; イベントデッキスコア計算（定期戦と同じデッキを使用）
; TFLAG:91 のイベントタイプごとにステータス重みが変わる
; 有利属性が高い場合は x1.2 ボーナス
;---------------------------------------------------------
@EVENT_BOARD_CALC_HAKKIICHI
A = 0	;合計スコア
B = 0	;有効人数
C = 0	;有利属性合計（ボーナス判定用）

REPEAT 5
	Z = FLAG:(200 + COUNT)
	SIF Z < 0 || Z >= CHARANUM || Z == MASTER
		CONTINUE

	;デッキキャラ個別スコア（親密度ベース共通）
	LOCAL:1 = CFLAG:Z:2 / 10

	IF TFLAG:91 == 0
		;収拾: 表現力重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 15	;表現★
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:94	;有利属性:表現
	ELSEIF TFLAG:91 == 1
		;バトル: 運動重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 15	;運動★
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:93	;有利属性:運動
	ELSEIF TFLAG:91 == 2
		;宝探し: 学力+知識重視
		LOCAL:1 += ABL:Z:88 * 12	;学力★
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 3	;表現
		LOCAL:1 += ABL:Z:95 * 10	;知識★
		C += ABL:Z:88 + ABL:Z:95	;有利属性:学力+知識
	ELSE
		;すごろく: 親密度重視
		LOCAL:1 += CFLAG:Z:2 / 10	;親密度追加
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ENDIF

	;カードボーナス（定期戦と同じ）
	LOCAL:1 += CFLAG:Z:303
	LOCAL:1 += CFLAG:Z:304
	LOCAL:1 += CFLAG:Z:305
	LOCAL:1 += CFLAG:Z:306

	A += LOCAL:1
	B += 1
REND

;デッキ未編成時は最低値
SIF B == 0
	RETURN 10

;有利属性ボーナス（平均がしきい値を超えたら x1.2）
LOCAL:3 = C / B
IF TFLAG:91 == 0 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（表現ボーナス x1.2）
ELSEIF TFLAG:91 == 1 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（運動ボーナス x1.2）
ELSEIF TFLAG:91 == 2 && LOCAL:3 >= 80
	TIMES A, 1.20
	PRINTFORML 	（学力+知識ボーナス x1.2）
ELSEIF TFLAG:91 == 3 && LOCAL:3 >= 500
	TIMES A, 1.20
	PRINTFORML 	（親密ボーナス x1.2）
ENDIF

;5人フルパーティボーナス
SIF B == 5
	TIMES A, 1.10

SIF A < 10
	A = 10

RETURN A

@EVENT_BOARD_SUGOROKU_ADVANCE
LOCAL:0 = MAXBASE:MASTER:0 / 20
SIF LOCAL:0 < 5
	LOCAL:0 = 5

IF BASE:MASTER:0 < LOCAL:0
	PRINTFORMW 体力が足りない！これ以上進めない。
	RETURN 0
ENDIF

BASE:MASTER:0 -= LOCAL:0
LOCAL:2 = RAND:6 + 1
LOCAL:3 = FLAG:33	;移動前の位置
FLAG:33 = (FLAG:33 + LOCAL:2) % 20

;エリア進捗 +10
FLAG:38 += 10

;ランダムドロップ（PT + 稀にアイテム）
CALL EVENT_BOARD_RANDOM_DROP

;エリア踏破チェック
SIF FLAG:38 >= 100
	CALL EVENT_BOARD_AREA_COMPLETE

PRINTFORML 体力 -{LOCAL:0}　サイコロ: {LOCAL:2}　マス{LOCAL:3}→マス{FLAG:33}（進捗: {FLAG:38}/100）

;ボード描画
CALL SUGOROKU_DRAW_BOARD
PRINTL

;マスの効果
;通常ミッション確定マス: 1,2,4,7
IF FLAG:33 == 1 || FLAG:33 == 2 || FLAG:33 == 4 || FLAG:33 == 7
	IF FLAG:36 == 0
		FLAG:36 = 1
		A = FLAG:68 * 3 + 78
		FLAG:35 = 100 * FLAG:A + RAND:200
		FLAG:34 = 0
		PRINTFORML 通 通常ミッションマス　▼ 通常ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:35}
	ELSE
		PRINTFORML 通 通常ミッションマス（ミッション進行中のため通過）
	ENDIF
	WAIT
;特大ミッション確定マス: 8,10,11
ELSEIF FLAG:33 == 8 || FLAG:33 == 10 || FLAG:33 == 11
	IF FLAG:36 == 0
		FLAG:36 = 2
		A = FLAG:68 * 3 + 79
		FLAG:35 = 400 * FLAG:A + RAND:400
		FLAG:34 = 0
		PRINTFORML 特 特大ミッションマス　▼▼ 特大ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:35}
	ELSE
		PRINTFORML 特 特大ミッションマス（ミッション進行中のため通過）
	ENDIF
	WAIT
;緊急ミッション確定マス: 14,17
ELSEIF FLAG:33 == 14 || FLAG:33 == 17
	IF FLAG:36 == 0
		FLAG:36 = 3
		A = FLAG:68 * 3 + 80
		FLAG:35 = 800 * FLAG:A + RAND:1000
		FLAG:34 = 0
		PRINTFORML 緊 緊急ミッションマス　▼▼▼ 緊急ミッション Lv{FLAG:A} 発生！！　目標値: {FLAG:35}
	ELSE
		PRINTFORML 緊 緊急ミッションマス（ミッション進行中のため通過）
	ENDIF
	WAIT
;スタートマス
ELSEIF FLAG:33 == 0
	LOCAL:4 = 5
	FLAG:32 += LOCAL:4
	A = 71 + FLAG:68
	FLAG:A += LOCAL:4
	PRINTFORMW ★ スタートマス！周回ボーナス　PT +{LOCAL:4}
;ボーナスマス（小）: 3
ELSEIF FLAG:33 == 3
	LOCAL:4 = 8 + RAND:5
	FLAG:32 += LOCAL:4
	A = 71 + FLAG:68
	FLAG:A += LOCAL:4
	LOCAL:5 = MAXBASE:MASTER:1 / 10
	BASE:MASTER:1 += LOCAL:5
	SIF BASE:MASTER:1 > MAXBASE:MASTER:1
		BASE:MASTER:1 = MAXBASE:MASTER:1
	PRINTFORMW ★ ボーナスマス！　PT +{LOCAL:4}　気力 +{LOCAL:5}
;アイテムマス（おにぎり or ドーナツ）: 5,15
ELSEIF FLAG:33 == 5 || FLAG:33 == 15
	IF RAND:2 == 0
		ITEM:90 += 1
		PRINTFORMW 品 アイテムマス！　おにぎりを入手！（所持{ITEM:90}個）
	ELSE
		ITEM:92 += 1
		PRINTFORMW 品 アイテムマス！　ドーナツを入手！（所持{ITEM:92}個）
	ENDIF
;ブロンズチケットマス: 6
ELSEIF FLAG:33 == 6
	FLAG:113 += 1
	PRINTFORMW 銅 ブロンズガチャチケットを入手！（計{FLAG:113}枚）
;休憩マス: 9
