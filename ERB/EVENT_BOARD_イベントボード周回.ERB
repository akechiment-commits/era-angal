;---------------------------------------------------------
; イベントデッキスコア計算（定期戦と同じデッキを使用）
; TFLAG:91 のイベントタイプごとにステータス重みが変わる
; 有利属性が高い場合は x1.2 ボーナス
;---------------------------------------------------------
@EVENT_BOARD_CALC_HAKKIICHI
CALL CARD_RECALC_BONUSES
A = 0	;合計スコア
B = 0	;有効人数
C = 0	;有利属性合計（ボーナス判定用）

REPEAT 5
	Z = FLAG:(200 + COUNT)
	SIF Z < 0 || Z >= CHARANUM || Z == MASTER
		CONTINUE

	;デッキキャラ個別スコア（親密度ベース共通）
	LOCAL:1 = CFLAG:Z:2 / 10

	IF TFLAG:91 == 0
		;収拾: 表現力重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 15	;表現★
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:94	;有利属性:表現
	ELSEIF TFLAG:91 == 1
		;バトル: 運動重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 15	;運動★
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:93	;有利属性:運動
	ELSEIF TFLAG:91 == 2
		;宝探し: 学力+知識重視
		LOCAL:1 += ABL:Z:88 * 12	;学力★
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 3	;表現
		LOCAL:1 += ABL:Z:95 * 10	;知識★
		C += ABL:Z:88 + ABL:Z:95	;有利属性:学力+知識
	ELSEIF TFLAG:91 == 3
		;すごろく: 親密度重視
		LOCAL:1 += CFLAG:Z:2 / 10	;親密度追加
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ELSE
		;親愛度: 親密度★+表現重視
		LOCAL:1 += CFLAG:Z:2 / 5	;親密度★★
		LOCAL:1 += ABL:Z:88 * 3	;学力
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 10	;表現★
		LOCAL:1 += ABL:Z:95 * 3	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ENDIF

	;カード収集ボーナス。イベント発揮値では所持カードの成長を強く反映する。
	LOCAL:1 += CFLAG:Z:303 * 5
	LOCAL:1 += CFLAG:Z:304 * 5
	LOCAL:1 += CFLAG:Z:305 * 5
	LOCAL:1 += CFLAG:Z:306 * 5

	A += LOCAL:1
	B += 1
REND

;デッキ未編成時は最低値
SIF B == 0
	RETURN 10

;有利属性ボーナス（平均がしきい値を超えたら x1.2）
LOCAL:3 = C / B
IF TFLAG:91 == 0 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（表現ボーナス x1.2）
ELSEIF TFLAG:91 == 1 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（運動ボーナス x1.2）
ELSEIF TFLAG:91 == 2 && LOCAL:3 >= 80
	TIMES A, 1.20
	PRINTFORML 	（学力+知識ボーナス x1.2）
ELSEIF TFLAG:91 == 3 && LOCAL:3 >= 500
	TIMES A, 1.20
	PRINTFORML 	（親密ボーナス x1.2）
ELSEIF TFLAG:91 == 4 && LOCAL:3 >= 500
	TIMES A, 1.20
	PRINTFORML 	（親愛ボーナス x1.2）
ENDIF

;5人フルパーティボーナス
SIF B == 5
	TIMES A, 1.10

;恋慕ボーナス（恋慕の人数に応じて発揮値増加）
IF TALENT:MASTER:恋慕ボーナス || TALENT:MASTER:恋慕ボーナス強化
	LOCAL:50 = 0
	FOR LOCAL:51, 1, CHARANUM
		SIF TALENT:(LOCAL:51):85
			LOCAL:50 += 1
	NEXT
	IF LOCAL:50 > 0
		IF TALENT:MASTER:恋慕ボーナス強化
			A += A * LOCAL:50 * 2 / 100
		ELSE
			A += A * LOCAL:50 / 100
		ENDIF
	ENDIF
ENDIF

SIF A < 10
	A = 10

;人形ボーナス（手作り人形のLVに応じて加算）
SIF ITEM:852 > 0
	A += ITEM:852 * 100

RETURN A

; EVENT_SUGOROKU_MISSION_SUPPORT_BEGIN
;予約した支援率を、新しく発生したミッションの初期進捗へ一度だけ適用する。
@EVENT_BOARD_APPLY_PENDING_MISSION_SUPPORT
SIF FLAG:15057 <= 0 || FLAG:15053 <= 0
	RETURN 0
LOCAL:0 = FLAG:15052 * FLAG:15057 / 100
SIF LOCAL:0 < 1
	LOCAL:0 = 1
FLAG:15051 += LOCAL:0
PRINTFORML 　【予約支援発動】初期進捗 +{LOCAL:0}（{FLAG:15057}\%／{FLAG:15051}/{FLAG:15052}）
FLAG:15057 = 0
RETURN 1
; EVENT_SUGOROKU_MISSION_SUPPORT_END
@EVENT_BOARD_SUGOROKU_ADVANCE
A = FLAG:68 + 15010	;エリア番号index
; EVENT_SUGOROKU_FREE_ROLL_BEGIN
LOCAL:0 = 250	;通常時の体力消費
IF FLAG:15056 > 0
	FLAG:15056 -= 1
	LOCAL:0 = 0
	PRINTFORML 【ボーナス継続】サイコロの体力消費が無料！（残り{FLAG:15056}回）
ENDIF

IF BASE:MASTER:0 < LOCAL:0
	PRINTFORMW 体力が足りない！これ以上進めない。
	RETURN 0
ENDIF

BASE:MASTER:0 -= LOCAL:0
SIF LOCAL:0 > 0
	CALL EVENT_BOARD_PLAYER_ADD_EXP, LOCAL:0
; EVENT_SUGOROKU_FREE_ROLL_END
LOCAL:2 = RAND:6 + 1
LOCAL:3 = FLAG:15050	;移動前の位置
LOCAL:4 = FLAG:15050 + LOCAL:2
FLAG:15050 = LOCAL:4 % 20
LOCAL:5 = LOCAL:4 / 20

; 20を越えた時点で周回成立。19番マスへ止まる必要はない。
IF LOCAL:5 > 0
	A = 71 + FLAG:68
	LOCAL:6 = 20 + RAND:11
	FLAG:A += LOCAL:6
	FLAG:15001 += LOCAL:5
	FLAG:15054 += LOCAL:5
	PRINTFORMW ◆ 周回ボーナス！　PT +{LOCAL:6}　ブロンズガチャチケット入手！（計{FLAG:15001}枚）
CALL EVENT_BOARD_SHOW_REACHED_PROGRESS

	; すごろくのエリア移行は3周ごと。FLAG:38の進捗は使わない。
	A = FLAG:68 + 15010
	SIF FLAG:A < 20 && FLAG:15054 % 3 == 0
		CALL EVENT_BOARD_AREA_COMPLETE
ENDIF

; ランダムドロップは既存どおり、周回エリア到達前のサイコロごとに判定する。
A = FLAG:68 + 15010
SIF FLAG:A < 20
	CALL EVENT_BOARD_RANDOM_DROP

PRINTFORML 体力 -{LOCAL:0}　サイコロ: {LOCAL:2}　マス{LOCAL:3}→マス{FLAG:15050}

;ボード描画
CALL SUGOROKU_DRAW_BOARD
PRINTL

;マスの効果
;通常ミッション確定マス: 1,2,4,7
IF FLAG:15050 == 1 || FLAG:15050 == 2 || FLAG:15050 == 4 || FLAG:15050 == 7 || FLAG:15050 == 19
	IF FLAG:15053 == 0
		FLAG:15053 = 1
		A = FLAG:68 * 3 + 78
		FLAG:15052 = 170 * (FLAG:A + 2) * (FLAG:A + 3) + RAND:340
		FLAG:15051 = 0
		PRINTFORML 通 通常ミッションマス　▼ 通常ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:15052}
		CALL EVENT_BOARD_APPLY_PENDING_MISSION_SUPPORT
	ELSE
		PRINTFORML 通 通常ミッションマス（ミッション進行中のため通過）
	ENDIF
	WAIT
;特大ミッション確定マス: 8,10,11
ELSEIF FLAG:15050 == 8 || FLAG:15050 == 10 || FLAG:15050 == 11
	IF FLAG:15053 == 0
		FLAG:15053 = 2
		A = FLAG:68 * 3 + 79
		FLAG:15052 = 680 * (FLAG:A + 2) * (FLAG:A + 3) + RAND:680
		FLAG:15051 = 0
		PRINTFORML 特 特大ミッションマス　▼▼ 特大ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:15052}
		CALL EVENT_BOARD_APPLY_PENDING_MISSION_SUPPORT
	ELSE
