;==================================================
; EVENT_BOARD_イベントボード周回.ERB v3
; 新仕様:
;   体力消費 → エリア進行 → ミッション発生
;   → 気力消費 → 発揮値を積む → ミッション達成 → PTゲット
;   エリア進捗が100%になると踏破報酬 → リセット
;
; 使用変数:
;   TFLAG:91 = イベントタイプ(0:収拾/1:バトル/2:宝探し/3:すごろく)
;   TSTR:99  = 選択中イベント名
;   FLAG:32  = 月間イベントPT累計（月初リセット）
;   FLAG:33  = すごろく盤面位置(タイプ3のみ, 0-19)
;   FLAG:34  = ミッション進捗（累積発揮値）
;   FLAG:35  = ミッション目標値
;   FLAG:36  = ミッション種別(0=なし/1=通常/2=特大/3=緊急)
;   FLAG:38  = エリア進捗（0～99、100で踏破報酬・リセット）
;==================================================

@EVENT_BOARD_MAIN
IF TARGET < 0
	PRINTFORMW パートナーが選択されていません。
	RETURN 0
ENDIF

;今月のイベント一覧を取得
A = DAY:8
CALL LOAD_MONTH_EVENTS, A
LOCAL:9 = RESULT	;今月のイベント数

IF LOCAL:9 == 0
	PRINTFORMW 今月のイベントはありません。
	RETURN 0
ENDIF

;イベント選択
$EVENT_SELECT
DRAWLINE
PRINTFORML 【イベントボード】　%NAME:TARGET%　{DAY:8}月
PRINTL
FOR LOCAL:8, 0, LOCAL:9
	A = 100 + LOCAL:8
	IF TFLAG:A == 0
		PRINTFORML [{LOCAL:8 + 1}] [収拾]　%TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 1
		PRINTFORML [{LOCAL:8 + 1}] [バトル] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 2
		PRINTFORML [{LOCAL:8 + 1}] [宝探し] %TSTR:(100+LOCAL:8)%
	ELSE
		PRINTFORML [{LOCAL:8 + 1}] [すごろく] %TSTR:(100+LOCAL:8)%
	ENDIF
NEXT
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > LOCAL:9
	GOTO EVENT_SELECT
ENDIF

;選択されたイベントのタイプと名前をセット
LOCAL:8 = RESULT - 1
A = 100 + LOCAL:8
TFLAG:91 = TFLAG:A
TSTR:99 = %TSTR:A%

;ミッション状態クリア（新規開始）
FLAG:34 = 0
FLAG:35 = 0
FLAG:36 = 0
$BOARD_LOOP
DRAWLINE
CALL EVENT_BOARD_STATUS

IF FLAG:36 > 0
	;ミッションアクティブ中
	CALL EVENT_BOARD_MISSION_STATUS
	PRINTL
	LOCAL:0 = MAXBASE:MASTER:1 / 10
	SIF LOCAL:0 < 5
		LOCAL:0 = 5
	PRINTFORML [1] 気力を使う（-{LOCAL:0}）
	PRINTFORML [0] 撤退（ミッション放棄・イベント終了）
	INPUT
	IF RESULT == 1
		CALL EVENT_BOARD_ATTACK
	ELSE
		FLAG:34 = 0
		FLAG:35 = 0
		FLAG:36 = 0
		RETURN 0
	ENDIF
ELSE
	;ミッションなし・進行フェーズ
	LOCAL:0 = MAXBASE:MASTER:0 / 20
	SIF LOCAL:0 < 5
		LOCAL:0 = 5
	IF TFLAG:91 == 3
		PRINTFORML [1] サイコロを振る（体力-{LOCAL:0}）
	ELSE
		PRINTFORML [1] エリアを進む（体力-{LOCAL:0}）
	ENDIF
	PRINTFORML [0] イベント終了
	INPUT
	IF RESULT == 0
		RETURN 0
	ENDIF
	IF TFLAG:91 == 3
		CALL EVENT_BOARD_SUGOROKU_ADVANCE
	ELSE
		CALL EVENT_BOARD_ADVANCE
	ENDIF
ENDIF
GOTO BOARD_LOOP

;---------------------------------------------------------
; ステータス表示
;---------------------------------------------------------
@EVENT_BOARD_STATUS
PRINTFORML 【%TSTR:99%】
IF TFLAG:91 == 0
	PRINTFORML 収拾イベント　発揮値：表現力
ELSEIF TFLAG:91 == 1
	PRINTFORML バトルイベント　発揮値：運動力
ELSEIF TFLAG:91 == 2
	PRINTFORML 宝探しイベント　発揮値：学力
ELSE
	PRINTFORML すごろくイベント　発揮値：好感度
ENDIF
CALL EVENT_BOARD_CALC_HAKKIICHI
PRINTFORML 体力:{BASE:MASTER:0}/{MAXBASE:MASTER:0}　気力:{BASE:MASTER:1}/{MAXBASE:MASTER:1}　発揮値:{RESULT}
PRINTFORML 今月PT:{FLAG:32}　エリア進捗:{FLAG:38}/100
IF TFLAG:91 == 3
	PRINTFORML 盤面位置:{FLAG:33}/19マス
ENDIF
RETURN 1

;---------------------------------------------------------
; ミッション状況表示
;---------------------------------------------------------
@EVENT_BOARD_MISSION_STATUS
IF FLAG:36 == 1
	PRINTFORML ▼ 通常ミッション
ELSEIF FLAG:36 == 2
	PRINTFORML ▼▼ 特大ミッション
ELSE
	PRINTFORML ▼▼▼ 緊急ミッション！
ENDIF
PRINTFORML 進捗: {FLAG:34} / {FLAG:35}
LOCAL:0 = FLAG:34 * 10 / FLAG:35
SIF LOCAL:0 > 10
	LOCAL:0 = 10
PRINTFORM 達成率: [
FOR LOCAL:8, 0, 10
	IF LOCAL:8 < LOCAL:0
		PRINTFORM #
	ELSE
		PRINTFORM .
	ENDIF
NEXT
PRINTFORML ] {FLAG:34 * 100 / FLAG:35}/100
RETURN 1

;---------------------------------------------------------
; エリア進行（体力消費 → エリア進捗 → ミッション発生）
;---------------------------------------------------------
@EVENT_BOARD_ADVANCE
LOCAL:0 = MAXBASE:MASTER:0 / 20
SIF LOCAL:0 < 5
	LOCAL:0 = 5

IF BASE:MASTER:0 < LOCAL:0
	PRINTFORMW 体力が足りない！これ以上進めない。
	RETURN 0
ENDIF

BASE:MASTER:0 -= LOCAL:0

;エリア進捗 +10
FLAG:38 += 10
PRINTFORML 体力 -{LOCAL:0}　エリアを進んだ。（進捗: {FLAG:38}/100）

;エリア踏破チェック
SIF FLAG:38 >= 100
	CALL EVENT_BOARD_AREA_COMPLETE

;ミッション発生判定（通常50%/特大30%/緊急15%/回復5%）
LOCAL:2 = RAND:100
IF LOCAL:2 < 50
	FLAG:36 = 1
	FLAG:35 = 100 + RAND:201
	FLAG:34 = 0
	PRINTL
	PRINTFORML ▼ 通常ミッション発生！　目標値: {FLAG:35}
ELSEIF LOCAL:2 < 80
	FLAG:36 = 2
	FLAG:35 = 400 + RAND:401
	FLAG:34 = 0
	PRINTL
	PRINTFORML ▼▼ 特大ミッション発生！　目標値: {FLAG:35}
ELSEIF LOCAL:2 < 95
	FLAG:36 = 3
	FLAG:35 = 800 + RAND:1201
	FLAG:34 = 0
	PRINTL
	PRINTFORML ▼▼▼ 緊急ミッション発生！！　目標値: {FLAG:35}
ELSE
	LOCAL:3 = MAXBASE:MASTER:1 / 5
	BASE:MASTER:1 += LOCAL:3
	SIF BASE:MASTER:1 > MAXBASE:MASTER:1
		BASE:MASTER:1 = MAXBASE:MASTER:1
	PRINTFORML ひと息ついた。　気力 +{LOCAL:3}
ENDIF
WAIT
RETURN 1

;---------------------------------------------------------
; 攻撃（気力消費 → 発揮値を進捗に加算）
;---------------------------------------------------------
@EVENT_BOARD_ATTACK
LOCAL:0 = MAXBASE:MASTER:1 / 10
SIF LOCAL:0 < 5
	LOCAL:0 = 5

IF BASE:MASTER:1 < LOCAL:0
	PRINTFORMW 気力が足りない！攻撃できない。
	RETURN 0
ENDIF

CALL EVENT_BOARD_CALC_HAKKIICHI
LOCAL:1 = RESULT

BASE:MASTER:1 -= LOCAL:0
FLAG:34 += LOCAL:1
PRINTFORML 気力 -{LOCAL:0}　発揮値 +{LOCAL:1}　（進捗: {FLAG:34}/{FLAG:35}）

IF FLAG:34 >= FLAG:35
	CALL EVENT_BOARD_MISSION_CLEAR
ELSE
	WAIT
ENDIF
RETURN 1

;---------------------------------------------------------
; ミッションクリア処理
;---------------------------------------------------------
@EVENT_BOARD_MISSION_CLEAR
DRAWLINE
IF FLAG:36 == 1
	LOCAL:0 = 4
	PRINTL ★ 通常ミッション クリア！
ELSEIF FLAG:36 == 2
	LOCAL:0 = 8
	PRINTL ★★ 特大ミッション クリア！！
ELSE
	LOCAL:0 = 15
	PRINTL ★★★ 緊急ミッション クリア！！！
ENDIF
FLAG:32 += LOCAL:0
PRINTFORML イベントPT +{LOCAL:0}　（今月累計: {FLAG:32}）
FLAG:36 = 0
FLAG:34 = 0
FLAG:35 = 0
WAIT
RETURN 1

;---------------------------------------------------------
; エリア踏破報酬（FLAG:38 リセット）
;---------------------------------------------------------
@EVENT_BOARD_AREA_COMPLETE
DRAWLINE
PRINTL ★★★ エリア踏破！ ★★★
LOCAL:0 = 5 + RAND:6
FLAG:32 += LOCAL:0
PRINTFORML イベントPT +{LOCAL:0}　（今月累計: {FLAG:32}）
FLAG:38 = 0
PRINTFORML エリア進捗リセット！次のエリアへ！
WAIT
RETURN 1

;---------------------------------------------------------
; 発揮値計算（RETURN で返す）
; イベントタイプにより算出方法が異なる
;---------------------------------------------------------
@EVENT_BOARD_CALC_HAKKIICHI
LOCAL:0 = 10
IF TFLAG:91 == 0
	;収拾: 表現力 = 表現経験 * 表現素質^2 / 50000
	LOCAL:0 = EXP:MASTER:99 * ABL:MASTER:55 * ABL:MASTER:55 / 50000
ELSEIF TFLAG:91 == 1
	;バトル: 運動力 = 運動経験 * 運動素質^2 / 50000
	LOCAL:0 = EXP:MASTER:93 * ABL:MASTER:54 * ABL:MASTER:54 / 50000
ELSEIF TFLAG:91 == 2
	;宝探し: 学力 * 5
	CALL CALC_ACADEMIC_LEVEL, MASTER
	LOCAL:0 = ABL:MASTER:88 * 5
ELSE
	;すごろく: 好感度 / 10
	LOCAL:0 = CFLAG:TARGET:2 / 10
ENDIF
SIF LOCAL:0 < 10
	LOCAL:0 = 10
RETURN LOCAL:0

;---------------------------------------------------------
; すごろく専用：サイコロを振って盤面を進む
;---------------------------------------------------------
@EVENT_BOARD_SUGOROKU_ADVANCE
LOCAL:0 = MAXBASE:MASTER:0 / 20
SIF LOCAL:0 < 5
	LOCAL:0 = 5

IF BASE:MASTER:0 < LOCAL:0
	PRINTFORMW 体力が足りない！これ以上進めない。
	RETURN 0
ENDIF

BASE:MASTER:0 -= LOCAL:0
LOCAL:2 = RAND:6 + 1
FLAG:33 = (FLAG:33 + LOCAL:2) % 20

;エリア進捗 +10
FLAG:38 += 10
PRINTFORML 体力 -{LOCAL:0}　サイコロ: {LOCAL:2}　=> {FLAG:33}マス目（進捗: {FLAG:38}/100）

;エリア踏破チェック
SIF FLAG:38 >= 100
	CALL EVENT_BOARD_AREA_COMPLETE

;盤面マップ表示
FOR LOCAL:8, 0, 20
	IF LOCAL:8 == FLAG:33
		PRINTFORM [現]
	ELSEIF LOCAL:8 == 3 || LOCAL:8 == 13 || LOCAL:8 == 19
		PRINTFORM [ボ]
	ELSEIF LOCAL:8 == 9
		PRINTFORM [休]
	ELSE
		PRINTFORM [ .]
	ENDIF
	SIF LOCAL:8 == 9
		PRINTL
NEXT
PRINTL

;マスの効果
IF FLAG:33 == 3 || FLAG:33 == 13 || FLAG:33 == 19
	;ボーナスマス
	LOCAL:3 = 4 + RAND:5
	FLAG:32 += LOCAL:3
	PRINTFORMW ★ボーナスマス！　PT +{LOCAL:3}　（累計: {FLAG:32}）
ELSEIF FLAG:33 == 9
	;休憩マス
	LOCAL:3 = MAXBASE:MASTER:1 / 5
	BASE:MASTER:1 += LOCAL:3
	SIF BASE:MASTER:1 > MAXBASE:MASTER:1
		BASE:MASTER:1 = MAXBASE:MASTER:1
	PRINTFORMW ★休憩マス。ひと息ついた。　気力 +{LOCAL:3}
ELSE
	;ミッション発生
	LOCAL:2 = RAND:100
	IF LOCAL:2 < 50
		FLAG:36 = 1
		FLAG:35 = 100 + RAND:201
		FLAG:34 = 0
		PRINTFORML ▼ 通常ミッション発生！　目標値: {FLAG:35}
	ELSEIF LOCAL:2 < 85
		FLAG:36 = 2
		FLAG:35 = 400 + RAND:401
		FLAG:34 = 0
		PRINTFORML ▼▼ 特大ミッション発生！　目標値: {FLAG:35}
	ELSE
		FLAG:36 = 3
		FLAG:35 = 800 + RAND:1201
		FLAG:34 = 0
		PRINTFORML ▼▼▼ 緊急ミッション発生！！　目標値: {FLAG:35}
	ENDIF
	WAIT
ENDIF
RETURN 1
