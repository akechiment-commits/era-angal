;---------------------------------------------------------
; すごろくセル1マス表示（ARG:0=マス番号）
;---------------------------------------------------------
@SUGOROKU_PRINT_CELL(ARG)
;現在地：明るい黄色
IF ARG:0 == FLAG:33
	SETCOLOR 0xFFFF00
	PRINTFORM [◆]
	RESETCOLOR
;スタート：明るい緑
ELSEIF ARG:0 == 0
	SETCOLOR 0x00FF80
	PRINTFORM [発]
	RESETCOLOR
;通常ミッション：水色
ELSEIF ARG:0 == 1 || ARG:0 == 2 || ARG:0 == 4 || ARG:0 == 7
	SETCOLOR 0x88CCFF
	PRINTFORM [通]
	RESETCOLOR
;ボーナスマス：ゴールド
ELSEIF ARG:0 == 3 || ARG:0 == 13
	SETCOLOR 0xFFCC00
	PRINTFORM [★]
	RESETCOLOR
;アイテムマス：黄緑
ELSEIF ARG:0 == 5 || ARG:0 == 15
	SETCOLOR 0x88FF44
	PRINTFORM [品]
	RESETCOLOR
;ブロンズチケット：銅色
ELSEIF ARG:0 == 6
	SETCOLOR 0xCC7722
	PRINTFORM [銅]
	RESETCOLOR
;特大ミッション：オレンジ
ELSEIF ARG:0 == 8 || ARG:0 == 10 || ARG:0 == 11
	SETCOLOR 0xFF8800
	PRINTFORM [特]
	RESETCOLOR
;休憩マス：空色
ELSEIF ARG:0 == 9
	SETCOLOR 0x44AAFF
	PRINTFORM [休]
	RESETCOLOR
;シルバーチケット：シルバー
ELSEIF ARG:0 == 12
	SETCOLOR 0xCCCCCC
	PRINTFORM [銀]
	RESETCOLOR
;ゴールドチケット：金色
ELSEIF ARG:0 == 16
	SETCOLOR 0xFFD700
	PRINTFORM [金]
	RESETCOLOR
;緊急ミッション：赤
ELSEIF ARG:0 == 14 || ARG:0 == 17
	SETCOLOR 0xFF2200
	PRINTFORM [緊]
	RESETCOLOR
;プラチナチケット：明るい白紫
ELSEIF ARG:0 == 18
	SETCOLOR 0xEEAAFF
	PRINTFORM [白]
	RESETCOLOR
;ゴールマス：虹色（明るいマゼンタ寄り金）
ELSEIF ARG:0 == 19
	SETCOLOR 0xFF80FF
	PRINTFORM [Ｇ]
	RESETCOLOR
ENDIF
RETURN
