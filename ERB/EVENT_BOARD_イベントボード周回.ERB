	ENDIF
	WAIT
;緊急ミッション確定マス: 14,17
ELSEIF FLAG:15050 == 14 || FLAG:15050 == 17
	IF FLAG:15053 == 0
		FLAG:15053 = 3
		A = FLAG:68 * 3 + 80
		FLAG:15052 = 1360 * (FLAG:A + 2) * (FLAG:A + 3) + RAND:1360
		FLAG:15051 = 0
		PRINTFORML 緊 緊急ミッションマス　▼▼▼ 緊急ミッション Lv{FLAG:A} 発生！！　目標値: {FLAG:15052}
