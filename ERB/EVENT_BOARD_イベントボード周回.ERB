;---------------------------------------------------------
; アイテム使用：お弁当（体力・気力を最大値分回復）
;---------------------------------------------------------
@EVENT_BOARD_USE_BENTO
IF ITEM:94 <= 0
	PRINTFORMW お弁当を持っていない！
	RETURN 0
ENDIF
ITEM:94 -= 1
;現在の最大値と同じ量を加算し、超過回復分もそのまま保持する。
BASE:MASTER:0 += MAXBASE:MASTER:0
BASE:MASTER:1 += MAXBASE:MASTER:1
PRINTFORMW お弁当を食べた！　体力 +{MAXBASE:MASTER:0}　気力 +{MAXBASE:MASTER:1}　（残り{ITEM:94}個）
RETURN 1

;---------------------------------------------------------
; 報酬自動受取（PT到達で即時付与）
;---------------------------------------------------------
@EVENT_BOARD_CLAIM_REWARDS
CALL LOAD_EVENT_REWARDS, DAY:8, FLAG:68
SIF GLOBAL:2999 == 0
	RETURN 0
LOCAL:0 = 71 + FLAG:68	;イベント別月間PTインデックス
LOCAL:1 = 15020 + FLAG:68	;クレーム数インデックス
$CLAIM_LOOP
A = LOCAL:1
LOCAL:2 = FLAG:A		;今月の報酬受取数
LOCAL:3 = GLOBAL:2999	;1ループの報酬数
LOCAL:4 = LOCAL:2 % LOCAL:3	;ループ内の現在ティア
LOCAL:5 = LOCAL:2 / LOCAL:3	;完了ループ数
B = 2999 + LOCAL:3	;最終閾値のGLOBALインデックス
LOCAL:6 = GLOBAL:B	;1ループのPT総量
B = 3000 + LOCAL:4
LOCAL:7 = GLOBAL:B	;このティアの基本PT閾値
CALL EVENT_BOARD_REWARD_REQUIRED_PT, LOCAL:7, LOCAL:6, LOCAL:5
LOCAL:8 = RESULT	;実際に必要なPT
A = LOCAL:0
SIF FLAG:A < LOCAL:8
	RETURN 0
; EVENT_STORY_COMPLETION_HOOK_BEGIN
;5000/10000/15000PTの中間台詞と、20000PT完走台詞を開催年内に各1回だけ予約する。
LOCAL:10 = 0
IF GROUPMATCH(LOCAL:7, 5000, 10000, 15000, 20000)
	CALL EVENT_BOARD_GET_EVENT_INDEX
	LOCAL:9 = RESULT
	IF LOCAL:9 >= 0
		SELECTCASE LOCAL:7
		CASE 5000
			IF !GETBIT(FLAG:5016, LOCAL:9)
				LOCAL:10 = 1
			ENDIF
		CASE 10000
			IF !GETBIT(FLAG:5017, LOCAL:9)
				LOCAL:10 = 2
			ENDIF
		CASE 15000
			IF !GETBIT(FLAG:5018, LOCAL:9)
				LOCAL:10 = 3
			ENDIF
		CASE 20000
			SETBIT FLAG:5004, LOCAL:9
			IF !GETBIT(FLAG:5014, LOCAL:9)
				LOCAL:10 = 4
			ENDIF
		ENDSELECT
	ENDIF
ENDIF
; EVENT_STORY_COMPLETION_HOOK_END
B = 3100 + LOCAL:4
LOCAL:7 = GLOBAL:B	;報酬種別
B = 3200 + LOCAL:4
LOCAL:8 = GLOBAL:B	;報酬値
A = LOCAL:1
FLAG:A += 1
PRINTFORM 　★報酬獲得：
CALL EVENT_BOARD_REWARD_TEXT, LOCAL:7, LOCAL:8
CALL EVENT_BOARD_GIVE_REWARD, LOCAL:7, LOCAL:8
IF LOCAL:10 >= 1 && LOCAL:10 <= 3
	CALL EVENT_BOARD_SHOW_PROGRESS_DIALOGUE, LOCAL:9, LOCAL:10
	SELECTCASE LOCAL:10
	CASE 1
		SETBIT FLAG:5016, LOCAL:9
	CASE 2
		SETBIT FLAG:5017, LOCAL:9
	CASE 3
		SETBIT FLAG:5018, LOCAL:9
	ENDSELECT
ELSEIF LOCAL:10 == 4
	CALL EVENT_BOARD_SHOW_COMPLETION_DIALOGUE, LOCAL:9
	SETBIT FLAG:5014, LOCAL:9
ENDIF
GOTO CLAIM_LOOP

;---------------------------------------------------------
; 報酬付与処理
;---------------------------------------------------------
@EVENT_BOARD_GIVE_REWARD(ARG, ARG:1)
SELECTCASE ARG:0
CASE 1
	ITEM:90 += ARG:1
CASE 2
	ITEM:91 += ARG:1
CASE 3
	ITEM:92 += ARG:1
CASE 4
	ITEM:93 += ARG:1
CASE 5
	FLAG:15001 += ARG:1
CASE 6
	FLAG:15002 += ARG:1
CASE 7
	FLAG:15003 += ARG:1
CASE 8
	FLAG:15000 += ARG:1
CASE 9
	CALL GACHA_ACQUIRE_CARD, ARG:1
CASE 10
	ITEM:94 += ARG:1
CASE 11
	CALL EVENT_BOARD_GIVE_BOX_CARD
CASE 12
	ITEM:510 += ARG:1
CASE 13
	ITEM:511 += ARG:1
CASE 14
	ITEM:512 += ARG:1
CASE 15
	ITEM:95 += ARG:1
ENDSELECT
RETURN 0

;---------------------------------------------------------
; デッキ発揮値の内訳表示
;---------------------------------------------------------
@EVENT_BOARD_SHOW_SCORE
CALL CARD_RECALC_BONUSES
DRAWLINE
PRINTFORML ── デッキ発揮値の内訳 ──
IF TFLAG:91 == 0
	PRINTFORML タイプ：収拾（表現★★★ 学力/運動/知識×5）
ELSEIF TFLAG:91 == 1
	PRINTFORML タイプ：バトル（運動★★★ 学力/表現/知識×5）
ELSEIF TFLAG:91 == 2
	PRINTFORML タイプ：宝探し（学力×12 知識×10 運動/表現×3）
ELSEIF TFLAG:91 == 3
	PRINTFORML タイプ：すごろく（好感度×2 各能力×5）
ELSE
	PRINTFORML タイプ：親愛度（好感度★★★ 表現×10 他×3）
ENDIF
PRINTL
REPEAT 5
	Z = FLAG:(200 + COUNT)
	SIF Z < 0 || Z >= CHARANUM || Z == MASTER
		CONTINUE
	;好感度ベース
	LOCAL:1 = CFLAG:Z:2 / 10
	;タイプ別追加好感度
	IF TFLAG:91 == 3
		LOCAL:1 += CFLAG:Z:2 / 10
	ELSEIF TFLAG:91 == 4
		LOCAL:1 += CFLAG:Z:2 / 5
	ENDIF
	;ABLスコア
	LOCAL:2 = 0
	IF TFLAG:91 == 0
		LOCAL:2 = ABL:Z:88 * 5 + ABL:Z:93 * 5 + ABL:Z:94 * 15 + ABL:Z:95 * 5
	ELSEIF TFLAG:91 == 1
		LOCAL:2 = ABL:Z:88 * 5 + ABL:Z:93 * 15 + ABL:Z:94 * 5 + ABL:Z:95 * 5
	ELSEIF TFLAG:91 == 2
		LOCAL:2 = ABL:Z:88 * 12 + ABL:Z:93 * 3 + ABL:Z:94 * 3 + ABL:Z:95 * 10
	ELSEIF TFLAG:91 == 3
		LOCAL:2 = ABL:Z:88 * 5 + ABL:Z:93 * 5 + ABL:Z:94 * 5 + ABL:Z:95 * 5
	ELSE
		LOCAL:2 = ABL:Z:88 * 3 + ABL:Z:93 * 3 + ABL:Z:94 * 10 + ABL:Z:95 * 3
	ENDIF
	;カードボーナス
	LOCAL:3 = (CFLAG:Z:303 + CFLAG:Z:304 + CFLAG:Z:305 + CFLAG:Z:306) * 5
	PRINTFORML %NAME:Z%: 好感{LOCAL:1}＋能力{LOCAL:2}＋カード{LOCAL:3} = {LOCAL:1+LOCAL:2+LOCAL:3}pt
REND
PRINTL
CALL EVENT_BOARD_CALC_HAKKIICHI
PRINTFORMW 合計発揮値: {RESULT}
RETURN 1
