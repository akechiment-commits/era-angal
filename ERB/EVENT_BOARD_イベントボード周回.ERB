;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;==================================================
; EVENT_BOARD_イベントボード周回.ERB v3
; 新仕様:
;   体力消費 → エリア進行 → ミッション発生
;   → 気力消費 → 発揮値を積む → ミッション達成 → PTゲット
;   エリア進捗が100%になると踏破報酬 → リセット
;
; 使用変数:
;   TFLAG:91 = イベントタイプ(0:収拾/1:バトル/2:宝探し/3:すごろく/4:親愛度)
;   TSTR:99  = 選択中イベント名
;   FLAG:15050  = すごろく盤面位置(タイプ3のみ, 0-19)
;   FLAG:15051  = ミッション進捗（累積発揮値）
;   FLAG:15052  = ミッション目標値
;   FLAG:15053  = ミッション種別(0=なし/1=通常/2=特大/3=緊急)
;   FLAG:15055  = エリア進捗（0～99、100で踏破報酬・リセット）
;   FLAG:15056  = ボーナスで得た無料サイコロ回数
;   FLAG:15057  = 次回発生ミッションの予約支援率（上限80%）
;   ミッション目標値 = 係数*(Lv+2)*(Lv+3)+RAND（通常170/RAND340, 特大680/RAND680, 緊急1360/RAND1360）
;   攻撃1回の気力消費は500（旧300）
;   エリア番号は月内上限20（到達後は「周回エリア」へ移行：探索のおまけ報酬は出ないがミッション判定は継続。月替わりで1にリセット）
;   FLAG:64  = 通常ミッションLv（月初リセット）
;   FLAG:65  = 特大ミッションLv（月初リセット）
;   FLAG:66  = 緊急ミッションLv（月初リセット）
;   FLAG:67  = 年月変更検知用（DAY:3*100+DAY:8）
;   FLAG:68  = 選択中イベントの月内インデックス(0-5)
;   FLAG:71～76 = 今月各イベントポイント（月初リセット）
;   FLAG:15010～15015 = イベント別エリア番号
;   FLAG:15020～15025 = 今月イベント別報酬受取数
;   FLAG:15070 = プレイヤーレベル（0は未初期化、通常は1以上）
;   FLAG:15071 = 現在レベル内のプレイヤー経験値
;   FLAG:15070 = プレイヤーレベル（0は未初期化、通常は1以上）
;   FLAG:5013 = イベント初参加概要の表示済みビット（0～51、月替わりで維持）
;   FLAG:5014 = 現在の開催年に表示したイベント完走台詞のビット（0～51）
;   FLAG:5015 = イベント物語表示の周回・開催年キー
;   FLAG:5016 = 現在の開催年に表示した5000PT序盤台詞のビット（0～51）
;   FLAG:5017 = 現在の開催年に表示した10000PT中盤台詞のビット（0～51）
;   FLAG:5018 = 現在の開催年に表示した15000PT後半台詞のビット（0～51）
;   FLAG:5019 = 中間台詞表示処理のセーブ移行バージョン
;   FLAG:15071 = 現在レベル内のプレイヤー経験値
;==================================================

;---------------------------------------------------------
; イベントボード月次リセット
; 年月キーで判定し、別月の同じイベント枠からポイント・報酬状態が混入するのを防ぐ。
;---------------------------------------------------------
@EVENT_BOARD_MONTHLY_RESET
#DIM DYNAMIC MONTH_KEY, 1

MONTH_KEY = DAY:3 * 100 + DAY:8
SIF FLAG:67 == MONTH_KEY
	RETURN 0

REPEAT 6
	FLAG:(71 + COUNT) = 0	;イベント別月間PT
	FLAG:(15010 + COUNT) = 1	;イベント別エリア番号
	FLAG:(15020 + COUNT) = 0	;イベント別報酬受取数
REND
REPEAT 18
	FLAG:(78 + COUNT) = 1	;イベント別ミッションLv
REND

;選択中イベントだけが使う共有進行状態も月替わりで破棄する。
FLAG:15050 = 0
FLAG:15051 = 0
FLAG:15052 = 0
FLAG:15053 = 0
FLAG:15054 = 0
FLAG:15055 = 0
FLAG:15056 = 0
FLAG:15057 = 0
FLAG:64 = 1
FLAG:65 = 1
FLAG:66 = 1
FLAG:68 = 0
FLAG:67 = MONTH_KEY
RETURN 1

@EVENT_BOARD_MAIN
IF TARGET < 0
	PRINTFORMW パートナーが選択されていません。
	RETURN 0
ENDIF

;既存セーブを含め、初回にプレイヤーレベルをLv1で初期化する。
CALL EVENT_BOARD_PLAYER_LEVEL_INIT

;開催年の変更または強くてニューゲームの周回開始時に、一度限り表示を再解禁する。
CALL EVENT_BOARD_STORY_CYCLE_RESET
;年月変更チェック。6イベントすべての月内状態を一括リセットする。
CALL EVENT_BOARD_MONTHLY_RESET

;今月のイベント一覧を取得
A = DAY:8
CALL LOAD_MONTH_EVENTS, A
LOCAL:9 = RESULT	;今月のイベント数

IF LOCAL:9 == 0
	PRINTFORMW 今月のイベントはありません。
	RETURN 0
ENDIF

;イベント選択
$EVENT_SELECT
DRAWLINE
PRINTFORML 【イベント】　%NAME:TARGET%　{DAY:8}月
PRINTL
FOR LOCAL:8, 0, LOCAL:9
	A = 100 + LOCAL:8
	IF TFLAG:A == 0
		PRINTFORML [{LOCAL:8 + 1}] [収拾]　%TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 1
		PRINTFORML [{LOCAL:8 + 1}] [バトル] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 2
		PRINTFORML [{LOCAL:8 + 1}] [宝探し] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 3
		PRINTFORML [{LOCAL:8 + 1}] [すごろく] %TSTR:(100+LOCAL:8)%
	ELSE
		PRINTFORML [{LOCAL:8 + 1}] [親愛度] %TSTR:(100+LOCAL:8)%
	ENDIF
NEXT
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > LOCAL:9
	GOTO EVENT_SELECT
ENDIF

;選択されたイベントのタイプと名前をセット
LOCAL:8 = RESULT - 1
A = 100 + LOCAL:8
TFLAG:91 = TFLAG:A
TSTR:99 = %TSTR:A%
FLAG:68 = LOCAL:8	;イベントインデックス保存(0-5)
; EVENT_STORY_OVERVIEW_HOOK_BEGIN
;選択したイベントの概要は、セーブデータ内でイベントごとに初回だけ表示する。
CALL EVENT_BOARD_GET_EVENT_INDEX
LOCAL:7 = RESULT
IF LOCAL:7 >= 0 && !GETBIT(FLAG:5013, LOCAL:7)
	SETBIT FLAG:5013, LOCAL:7
	CALL EVENT_BOARD_SHOW_OVERVIEW, LOCAL:7
ENDIF
;導入前に到達・受取済みだった中間台詞も、イベント選択時に未表示分だけ追いつく。
CALL EVENT_BOARD_SHOW_REACHED_PROGRESS
; EVENT_STORY_OVERVIEW_HOOK_END

;ミッション状態・エリア進捗・すごろく盤面位置クリア（新規開始）
;FLAG:15055/FLAG:33はイベント別ではない共有変数のため、切り替え時にリセットしないと
;前のイベントの進捗%・盤面位置が新しいイベントに持ち越されてしまう
FLAG:15051 = 0
FLAG:15052 = 0
FLAG:15053 = 0
FLAG:15055 = 0
FLAG:15050 = 0
$BOARD_LOOP
DRAWLINE
CALL EVENT_BOARD_STATUS

IF FLAG:15053 > 0
	;ミッションアクティブ中
	CALL EVENT_BOARD_MISSION_STATUS
	PRINTL
	LOCAL:0 = 500	;気力消費固定値
	LOCAL:1 = 250	;体力消費固定値
	PRINTFORML [1] 気力を使う（-{LOCAL:0}）
	IF TFLAG:91 == 3
		PRINTFORML [2] サイコロを振る（体力-{LOCAL:1}）
	ELSE
		PRINTFORML [2] エリアを進む（体力-{LOCAL:1}）
	ENDIF
	PRINTFORML [3] デッキ編成
	SIF ITEM:92 > 0
		PRINTFORML [4] ドーナッツを使う（気力+1500）　所持:{ITEM:92}個
	SIF ITEM:93 > 0
		PRINTFORML [5] パフェを使う（気力+3000）　所持:{ITEM:93}個
	SIF ITEM:94 > 0
		PRINTFORML [7] お弁当を食べる（体力・気力を最大値分回復）　所持:{ITEM:94}個
	PRINTFORML [8] 発揮値の内訳を見る
	PRINTFORML [6] 報酬確認
	PRINTFORML [0] ミッション破棄（このミッションLv-1）
	$BOARD_MISSION_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 1
		CALL EVENT_BOARD_ATTACK
	CASE 2
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 3
		CALL EDIT_DECK
	CASE 4
		CALL EVENT_BOARD_USE_ENERGY_1
	CASE 5
		CALL EVENT_BOARD_USE_ENERGY_2
	CASE 6
		CALL EVENT_BOARD_SHOW_REWARDS
	CASE 7
		CALL EVENT_BOARD_USE_BENTO
	CASE 8
		CALL EVENT_BOARD_SHOW_SCORE
	CASE 0
		CALL EVENT_BOARD_ABANDON_MISSION
	CASEELSE
		GOTO BOARD_MISSION_INPUT
	ENDSELECT
ELSE
	;ミッションなし・進行フェーズ
	LOCAL:0 = 250	;体力消費固定値
	IF TFLAG:91 == 3
		PRINTFORML [1] サイコロを振る（体力-{LOCAL:0}）
	ELSE
		PRINTFORML [1] エリアを進む（体力-{LOCAL:0}）
	ENDIF
	PRINTFORML [2] デッキ編成
	SIF ITEM:90 > 0
		PRINTFORML [3] おにぎりを使う（体力+1000）　所持:{ITEM:90}個
	SIF ITEM:91 > 0
		PRINTFORML [4] カレーを使う（体力+5000）　所持:{ITEM:91}個
	SIF ITEM:94 > 0
		PRINTFORML [6] お弁当を食べる（体力・気力を最大値分回復）　所持:{ITEM:94}個
	PRINTFORML [8] 発揮値の内訳を見る
	PRINTFORML [5] 報酬確認
	PRINTFORML [0] イベント終了
	$BOARD_ADVANCE_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 0
		RETURN 1
	CASE 1
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 2
		CALL EDIT_DECK
	CASE 3
		CALL EVENT_BOARD_USE_STAMINA_1
	CASE 4
		CALL EVENT_BOARD_USE_STAMINA_2
	CASE 5
		CALL EVENT_BOARD_SHOW_REWARDS
	CASE 6
		CALL EVENT_BOARD_USE_BENTO
	CASE 8
		CALL EVENT_BOARD_SHOW_SCORE
	CASEELSE
		GOTO BOARD_ADVANCE_INPUT
	ENDSELECT
ENDIF
GOTO BOARD_LOOP

;---------------------------------------------------------
; プレイヤーレベル初期化
; FLAG:15070=Lv、FLAG:15071=現在Lv内EXP
;---------------------------------------------------------
@EVENT_BOARD_PLAYER_LEVEL_INIT
IF FLAG:15070 <= 0
	FLAG:15070 = 1
	FLAG:15071 = 0
ENDIF
RETURN 1

;---------------------------------------------------------
; 次レベルに必要な経験値
; Lv1→2は800。以後、現在Lvが1上がるごとに50増える。
;---------------------------------------------------------
@EVENT_BOARD_PLAYER_NEXT_EXP(ARG)
LOCAL:0 = 750 + ARG * 50
SIF LOCAL:0 < 800
	LOCAL:0 = 800
RETURN LOCAL:0

;---------------------------------------------------------
; 体力・気力消費によるプレイヤー経験値獲得
; ARG:0=実際の消費量。消費量10につき1EXP（最低1EXP）。
;---------------------------------------------------------
@EVENT_BOARD_PLAYER_ADD_EXP(ARG)
CALL EVENT_BOARD_PLAYER_LEVEL_INIT
LOCAL:0 = ARG / 10
SIF LOCAL:0 < 1
	LOCAL:0 = 1
FLAG:15071 += LOCAL:0
PRINTFORML プレイヤーEXP +{LOCAL:0}

$EVENT_PLAYER_LEVEL_CHECK
CALL EVENT_BOARD_PLAYER_NEXT_EXP, FLAG:15070
LOCAL:1 = RESULT
IF FLAG:15071 < LOCAL:1
	PRINTFORML プレイヤーLv{FLAG:15070}　EXP {FLAG:15071}/{LOCAL:1}
	RETURN 0
ENDIF

FLAG:15071 -= LOCAL:1
FLAG:15070 += 1
MAXBASE:MASTER:0 += 10
MAXBASE:MASTER:1 += 10
;「全回復」ではなく新しい最大値ぶんを加算し、超過回復をそのまま保持する。
BASE:MASTER:0 += MAXBASE:MASTER:0
BASE:MASTER:1 += MAXBASE:MASTER:1
DRAWLINE
SETCOLOR 0xFFD700
PRINTL ★★★★★★★★★★★★★★★★★★★★★★★★★
PRINTFORML ★ プレイヤーレベルアップ！　Lv{FLAG:15070} ★
PRINTFORML 体力・気力最大値 +10　現在の最大値ぶん回復！
PRINTFORML 体力:{BASE:MASTER:0}/{MAXBASE:MASTER:0}　気力:{BASE:MASTER:1}/{MAXBASE:MASTER:1}
PRINTL ★★★★★★★★★★★★★★★★★★★★★★★★★
RESETCOLOR
DRAWLINE
GOTO EVENT_PLAYER_LEVEL_CHECK

; EVENT_STORY_FUNCTIONS_BEGIN
;---------------------------------------------------------
; イベント物語表示の開催年リセット
; FLAG:26=強くてニューゲーム周回数、DAY:3=開催年
;---------------------------------------------------------
@EVENT_BOARD_STORY_CYCLE_RESET
#DIM DYNAMIC STORY_CYCLE_KEY, 1

;中間台詞初版で表示前に立てた可能性がある表示済みビットを、一度だけ修復する。
IF FLAG:5019 < 1
	FLAG:5016 = 0
	FLAG:5017 = 0
	FLAG:5018 = 0
	FLAG:5019 = 1
ENDIF

STORY_CYCLE_KEY = FLAG:26 * 10000 + DAY:3
;導入前セーブでは、既存の完走済みイベントを現在年の表示済みとして引き継ぐ。
IF FLAG:5015 == 0
	FLAG:5014 = FLAG:5004
	FLAG:5015 = STORY_CYCLE_KEY
	RETURN 0
ENDIF
SIF FLAG:5015 == STORY_CYCLE_KEY
	RETURN 0

;翌年の再開催と強くてニューゲームでは、概要・中間・完走台詞を再表示できる。
FLAG:5013 = 0
FLAG:5014 = 0
FLAG:5016 = 0
FLAG:5017 = 0
FLAG:5018 = 0
FLAG:5015 = STORY_CYCLE_KEY
RETURN 1

;---------------------------------------------------------
; イベント初参加時の概要（FLAG:5013のイベント別・開催年内ビット）
;---------------------------------------------------------
@EVENT_BOARD_SHOW_OVERVIEW(ARG)
DRAWLINE
SETCOLOR 0x88CCFF
PRINTL 【イベント概要】
RESETCOLOR
SELECTCASE ARG:0
CASE 0	;銀世界＊創意あふれる雪まつり！
	PRINTL 一夜で銀世界へ変わった君咲学院を舞台に、生徒たちは手作りの雪まつりへ挑む。自由すぎる仲間と責任を抱え込むともこ――雪像が完成するまでに、凍りついた心まで解かせるのか？
CASE 1	;極楽＊ゆらぐ心と温泉街
	PRINTL 卒業を前にした一行が、束の間の休息を求めて湯けむりの温泉街へ。賑やかな名所巡りの合間にこぼれる迷いと本音は、まだ見えないそれぞれの未来をどこへ導くのか。
CASE 2	;感謝の気持ち＊どたばた冬のショッピング
	PRINTL 大切な人への贈り物を探しに、仲間たちは冬の街へ繰り出す。ところが迷子に喧嘩、思わぬ再会まで重なって買い物は大混乱――言えずにいた「ありがとう」は、無事に届くのか？
CASE 3	;奉納＊夜明かす神楽舞
	PRINTL 初詣で訪れた古い分社には、夜明けまでに慰めなければならない神がいた。神楽の舞台へ集められた生徒たちは、笑顔も後悔も青春もすべて奉じ、失われかけたものをつなぎ留めようとする。
CASE 4	;純情＊愛いっぱいのバレンタイン
	PRINTL 甘い香りに包まれた家庭科室で、それぞれの想いを託すチョコ作りが始まる。けれど「愛」がわからないそらは、誰に何を渡せばいいのかさえ決められない――彼女が最後に見つける答えとは？
CASE 5	;熱血！青春！バレー対決
	PRINTL 新人戦を目前に、勝利のため厳しさを求めるかなと、仲間の心を守りたいさあやが激突する。亀裂の入ったチームはもう一度ひとつになり、全員で大一番のボールをつなげるのか？
CASE 6	;動乱！君咲城の時かける姫
	PRINTL 時を越えて現れた城で、一行は滅びの運命を背負う「君咲城の姫」と出会う。歴史か物語かもわからない戦乱のなか、姫の正体と学院へ続く未来を守るための戦いが幕を開ける。
CASE 7	;一夜の夢＊君咲カジノで大一番！
	PRINTL 森の奥に一夜だけ現れた、れいかの秘密のカジノ。チップを賭けた遊びはやがて、正義と過去を懸けた本気の勝負へ変わっていく――最後に笑うのは幸運の持ち主か、それとも？
CASE 8	;春の星＊今宵、あなたと雛祭り
	PRINTL 大切な仲間の帰還を祝うため、女の子だけの雛祭りが計画される。再会と準備が呼び覚ますのは、奇跡の記憶と別れの痛み――春の夜、胸にしまってきた想いを言葉にできるのか。
CASE 9	;満開！笑顔のフラワーフェスタ
	PRINTL 花咲く祭典へ遊びに来ただけのちあきが、なぜか高額賞金つきコンテストの出場者に？　華やかなライバルと無茶な審査に囲まれた「普通」の彼女は、自分だけの輝きを見つけられるのか。
CASE 10	;ピクニックで宝探し！
	PRINTL お弁当を持って春の野山へ出かけたはずが、古い園芸部の残した手がかりから宝探しが始まった。地下道と自然の奥に隠された宝とは何なのか――賑やかなピクニックは大冒険へ変わる。
CASE 11	;最終イベント『あんさんぶるガールズ』
	PRINTL 学院中の部活を巻き込む「帰宅部争奪戦」の裏には、君咲学院そのものを揺るがす思惑が隠されていた。卒業、恋、家族、そして次の世代――生徒たちは誰かに決められた結末を越え、自分たちの未来を選び取る。
CASE 12	;入学！君咲学院
	PRINTL 憧れの君咲学院へ合格したあずさを待っていたのは、夢見た先輩たちのいない「変わってしまった学院」だった。過去の楽園を追う彼女は、今ここにいる仲間と新しい青春を始められるのか。
CASE 13	;新生徒会発足!?君咲学院のいちばん長い日
	PRINTL ひまりの退任を前に、次期生徒会長を決める異例の「選別の儀」が始まる。学院中の期待と思惑がひとりの候補へ集まるなか、託す者と受け継ぐ者は、新時代の扉を開けるのか。
CASE 14	;ようこそ！体験入部
	PRINTL 新入生へ各部の魅力を伝えるため、放送部と新聞部が学院中を突撃取材！　演劇、運動、料理に予想外の対決まで――体験入部のはずが、記事に収まりきらない大騒動へ発展する。
CASE 15	;ふたりの転校生あらわる!?新制服で大騒ぎ！
	PRINTL 新制服のお披露目と同時に、学院へやって来た二人の転校生。華やかな撮影騒ぎの裏で、性別、孤独、祈り――それぞれが装いの下へ隠してきた秘密と本心が少しずつ露わになる。
CASE 16	;青春＊さわやか淑女修行
	PRINTL 立派な淑女を目指し、礼儀作法から身だしなみまで徹底特訓！　しかし世話焼きな指導は次第に暴走し、参加者の劣等感まで引き出してしまう――本当の「淑女らしさ」はどこにある？
CASE 17	;CHEER!!立夏の校内合宿
	PRINTL 校内合宿に集まった仲間たちは、練習も食事もお風呂も全力で楽しむ。けれど夜が深まるほど、近づく卒業と別れは隠せなくなる――今だからこそ届けたい声援を、互いに伝えられるのか。
CASE 18	;尚武！端午の大一番
	PRINTL 剣道部と弓道部、学院屈指の武道家たちが菖蒲祭へ集結する。応援と策略が飛び交う四つ巴の勝負の奥には、先輩たちが長く抱えてきた因縁が――誇りを懸けた決着の行方は？
CASE 19	;君咲WestSide＊荒野のカウガール
	PRINTL 扉の先に広がっていたのは、西部劇そのものの町「君咲West Side」だった。保安官、賞金首、無法者へ分かれた生徒たちが、列車強盗と大砲まで飛び出す筋書き無用の大抗争を始める！
CASE 20	;ちいさなかいちょおのメロディ
	PRINTL 学院を離れた仲間たちへ、ひまりは「戻ってきてほしい」と呼びかける。だがその願いを届けるには、かつて自分が奪った居場所と、生徒会長として犯した過ちを語らなければならなかった。
