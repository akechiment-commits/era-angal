	PRINTFORMW このイベントには報酬が設定されていません。
	RETURN 0
ENDIF
DRAWLINE
PRINTFORML 【%TSTR:99% 報酬一覧】
LOCAL:0 = 71 + FLAG:68	;イベント別月間PTインデックス
A = LOCAL:0
LOCAL:3 = FLAG:A		;現在のイベント別月間PT
LOCAL:0 = 15020 + FLAG:68	;クレーム数インデックス
A = LOCAL:0
LOCAL:2 = FLAG:A		;今月の報酬受取数
LOCAL:4 = GLOBAL:2999		;1ループの報酬数
B = 2999 + LOCAL:4
LOCAL:5 = GLOBAL:B		;1ループのPT総量
LOCAL:6 = LOCAL:2 / LOCAL:4	;完了ループ数
PRINTFORML イベントPT: {LOCAL:3}
SIF LOCAL:6 > 0
	PRINTFORML ループ{LOCAL:6+1}周目（全報酬×{LOCAL:6}周取得済み）
PRINTL
FOR LOCAL:1, 0, LOCAL:4
	B = 3000 + LOCAL:1
	LOCAL:7 = GLOBAL:B		;基本PT閾値
	CALL EVENT_BOARD_REWARD_REQUIRED_PT, LOCAL:7, LOCAL:5, LOCAL:6
	LOCAL:8 = RESULT	;現ループでの必要PT
	B = 3100 + LOCAL:1
	LOCAL:9 = GLOBAL:B		;報酬種別
	B = 3200 + LOCAL:1
	A = GLOBAL:B			;報酬値
	LOCAL:0 = A
	IF LOCAL:2 >= LOCAL:6 * LOCAL:4 + LOCAL:1 + 1
		PRINTFORM [受取済]
	ELSEIF LOCAL:3 >= LOCAL:8
		PRINTFORM [受取可！]
	ELSE
		PRINTFORM [      ]
	ENDIF
	PRINTFORM  {LOCAL:8}PT →
	CALL EVENT_BOARD_REWARD_TEXT, LOCAL:9, LOCAL:0
NEXT
PRINTL
PRINTFORML [Enter] 戻る
WAIT
RETURN 0

;---------------------------------------------------------
; 報酬テキスト出力（PRINTFORML付き）
;---------------------------------------------------------
@EVENT_BOARD_REWARD_TEXT(ARG, ARG:1)
SELECTCASE ARG:0
CASE 1
	PRINTFORML おにぎり×{ARG:1}
CASE 2
	PRINTFORML カレー×{ARG:1}
CASE 3
	PRINTFORML ドーナッツ×{ARG:1}
CASE 4
	PRINTFORML パフェ×{ARG:1}
CASE 5
	PRINTFORML ブロンズチケット×{ARG:1}
CASE 6
	PRINTFORML シルバーチケット×{ARG:1}
CASE 7
	PRINTFORML ゴールドチケット×{ARG:1}
CASE 8
	PRINTFORML ダイヤ×{ARG:1}
CASE 11
	PRINTFORM ボックスSR/UR
CASE 10
	PRINTFORML お弁当×{ARG:1}
CASE 9
	CALL CARD_GET_DATA, ARG:1
	LOCAL:0 = RESULT:2
	SIF LOCAL:0 == 1
		PRINTFORM [N]
	SIF LOCAL:0 == 2
		PRINTFORM [R]
	SIF LOCAL:0 == 3
		PRINTFORM [HR]
	SIF LOCAL:0 == 4
		PRINTFORM [SR]
	SIF LOCAL:0 == 5
		PRINTFORM [UR]
	SIF LOCAL:0 == 6
		PRINTFORM [MR]
	PRINTFORML  %STR:0%
CASE 12
	PRINTFORML ミルク×{ARG:1}
CASE 13
	PRINTFORML キャンディ×{ARG:1}
CASE 14
	PRINTFORML ケーキ×{ARG:1}
CASE 15
	PRINTFORML キミサキブースター×{ARG:1}
ENDSELECT
RETURN 0

;---------------------------------------------------------
; 最終イベント ボックスSR/URを1枚取得
; GLOBAL:3500-3569: シャッフル済みカードID (70枚)
; GLOBAL:3570: 現在の取得位置 (0-69)
;---------------------------------------------------------
@EVENT_BOARD_GIVE_BOX_CARD
IF GLOBAL:3500 == 0
	CALL EVENT_BOARD_INIT_BOX
ELSEIF GLOBAL:3570 >= 69
	CALL EVENT_BOARD_INIT_BOX
ENDIF
A = 3500 + GLOBAL:3570
LOCAL:0 = GLOBAL:A	;カードID
GLOBAL:3570 += 1
PRINTFORML 	({GLOBAL:3570}/69)
CALL GACHA_ACQUIRE_CARD, LOCAL:0
RETURN 0

