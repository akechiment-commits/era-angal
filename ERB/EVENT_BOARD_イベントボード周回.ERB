IF TALENT:MASTER:恋慕ボーナス || TALENT:MASTER:恋慕ボーナス強化
	LOCAL:50 = 0
	FOR LOCAL:51, 1, CHARANUM
		SIF TALENT:(LOCAL:51):85
			LOCAL:50 += 1
	NEXT
	IF LOCAL:50 > 0
		IF TALENT:MASTER:恋慕ボーナス強化
			A += A * LOCAL:50 * 2 / 100
		ELSE
			A += A * LOCAL:50 / 100
		ENDIF
	ENDIF
ENDIF

SIF A < 10
	A = 10

RETURN A

