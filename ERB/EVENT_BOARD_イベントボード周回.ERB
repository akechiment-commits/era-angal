;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;==================================================
; EVENT_BOARD_イベントボード周回.ERB v3
; 新仕様:
;   体力消費 → エリア進行 → ミッション発生
;   → 気力消費 → 発揮値を積む → ミッション達成 → PTゲット
;   エリア進捗が100%になると踏破報酬 → リセット
;
; 使用変数:
;   TFLAG:91 = イベントタイプ(0:収拾/1:バトル/2:宝探し/3:すごろく/4:親愛度)
;   TSTR:99  = 選択中イベント名
;   FLAG:15050  = すごろく盤面位置(タイプ3のみ, 0-19)
;   FLAG:15051  = ミッション進捗（累積発揮値）
;   FLAG:15052  = ミッション目標値
;   FLAG:15053  = ミッション種別(0=なし/1=通常/2=特大/3=緊急)
;   FLAG:15055  = エリア進捗（0～99、100で踏破報酬・リセット）
;   FLAG:15056  = ボーナスで得た無料サイコロ回数
;   FLAG:15057  = 次回発生ミッションの予約支援率（上限80%）
;   ミッション目標値 = 係数*(Lv+2)*(Lv+3)+RAND（通常170/RAND340, 特大680/RAND680, 緊急1360/RAND1360）
;   攻撃1回の気力消費は500（旧300）
;   エリア番号は月内上限20（到達後は「周回エリア」へ移行：探索のおまけ報酬は出ないがミッション判定は継続。月替わりで1にリセット）
;   FLAG:64  = 通常ミッションLv（月初リセット）
;   FLAG:65  = 特大ミッションLv（月初リセット）
;   FLAG:66  = 緊急ミッションLv（月初リセット）
;   FLAG:67  = 年月変更検知用（DAY:3*100+DAY:8）
;   FLAG:68  = 選択中イベントの月内インデックス(0-5)
;   FLAG:71～76 = 今月各イベントポイント（月初リセット）
;   FLAG:15010～15015 = イベント別エリア番号
;   FLAG:15020～15025 = 今月イベント別報酬受取数
;   FLAG:15070 = プレイヤーレベル（0は未初期化、通常は1以上）
;   FLAG:15300～15347 = イベント別進行状態（6枠×8項目、15050～15057の保存先）
;   FLAG:15348 = イベント別進行状態の初期化済みフラグ
;   FLAG:15071 = 現在レベル内のプレイヤー経験値
;   FLAG:15070 = プレイヤーレベル（0は未初期化、通常は1以上）
;   FLAG:5013 = イベント初参加概要の表示済みビット（0～55、月替わりで維持）
;   FLAG:5014 = 現在の開催年に表示したイベント完走台詞のビット（0～55）
;   FLAG:5015 = イベント物語表示の周回・開催年キー
;   FLAG:5016 = 現在の開催年に表示した5000PT序盤台詞のビット（0～55）
;   FLAG:5017 = 現在の開催年に表示した10000PT中盤台詞のビット（0～55）
;   FLAG:5018 = 現在の開催年に表示した15000PT後半台詞のビット（0～55）
;   FLAG:5019 = 中間台詞表示処理のセーブ移行バージョン
;   FLAG:15071 = 現在レベル内のプレイヤー経験値
;==================================================

;---------------------------------------------------------
; イベントボード月次リセット
; 年月キーで判定し、別月の同じイベント枠からポイント・報酬状態が混入するのを防ぐ。
;---------------------------------------------------------
@EVENT_BOARD_MONTHLY_RESET
#DIM DYNAMIC MONTH_KEY, 1

MONTH_KEY = DAY:3 * 100 + DAY:8
SIF FLAG:67 == MONTH_KEY
	RETURN 0

REPEAT 6
	FLAG:(71 + COUNT) = 0	;イベント別月間PT
	FLAG:(15010 + COUNT) = 1	;イベント別エリア番号
	FLAG:(15020 + COUNT) = 0	;イベント別報酬受取数
REND
REPEAT 18
	FLAG:(78 + COUNT) = 1	;イベント別ミッションLv
REND

;保存した全イベントの進行状態も月替わりで破棄する。
REPEAT 48
	FLAG:(15300 + COUNT) = 0
REND
FLAG:15348 = 1

;選択中イベントだけが使う共有進行状態も月替わりで破棄する。
FLAG:15050 = 0
FLAG:15051 = 0
FLAG:15052 = 0
FLAG:15053 = 0
FLAG:15054 = 0
FLAG:15055 = 0
FLAG:15056 = 0
FLAG:15057 = 0
FLAG:64 = 1
FLAG:65 = 1
FLAG:66 = 1
FLAG:68 = 0
FLAG:67 = MONTH_KEY
RETURN 1

;イベント表示番号から保存スロットへ変換する（いずれも0始まり）。
;7月の帰宅部争奪戦は表示5番、保存は従来どおり6枠目。
@EVENT_BOARD_MENU_SLOT(ARG, ARG:1)
IF ARG == 7 && ARG:1 == 4
	RETURN 5
ENDIF
RETURN ARG:1

;旧セーブに残る選択中イベントの進捗を一度だけ取り込む。
@EVENT_BOARD_STATE_INIT
SIF FLAG:15348 > 0
	RETURN 0
CALL EVENT_BOARD_STATE_SAVE
FLAG:15348 = 1
RETURN 1

@EVENT_BOARD_STATE_SAVE
#DIM DYNAMIC STATE_OFFSET, 1
#DIM DYNAMIC STATE_BASE, 1
SIF FLAG:68 < 0 || FLAG:68 >= 6
	RETURN 0
STATE_BASE = 15300 + FLAG:68 * 8
FOR STATE_OFFSET, 0, 8
	FLAG:(STATE_BASE + STATE_OFFSET) = FLAG:(15050 + STATE_OFFSET)
NEXT
RETURN 1

@EVENT_BOARD_STATE_LOAD
#DIM DYNAMIC STATE_OFFSET, 1
#DIM DYNAMIC STATE_BASE, 1
SIF FLAG:68 < 0 || FLAG:68 >= 6
	RETURN 0
STATE_BASE = 15300 + FLAG:68 * 8
FOR STATE_OFFSET, 0, 8
	FLAG:(15050 + STATE_OFFSET) = FLAG:(STATE_BASE + STATE_OFFSET)
NEXT
RETURN 1

@EVENT_BOARD_MAIN
IF TARGET < 0
	PRINTFORMW パートナーが選択されていません。
	RETURN 0
ENDIF

;既存セーブを含め、初回にプレイヤーレベルをLv1で初期化する。
CALL EVENT_BOARD_PLAYER_LEVEL_INIT

;開催年の変更または強くてニューゲームの周回開始時に、一度限り表示を再解禁する。
CALL EVENT_BOARD_STORY_CYCLE_RESET
;年月変更チェック。6イベントすべての月内状態を一括リセットする。
CALL EVENT_BOARD_MONTHLY_RESET
CALL EVENT_BOARD_STATE_INIT

;今月のイベント一覧を取得
A = DAY:8
CALL LOAD_MONTH_EVENTS, A
LOCAL:9 = RESULT	;今月のイベント数

IF LOCAL:9 == 0
	PRINTFORMW 今月のイベントはありません。
	RETURN 0
ENDIF

;イベント選択
$EVENT_SELECT
DRAWLINE
PRINTFORML 【イベント】　%NAME:TARGET%　{DAY:8}月
PRINTL
FOR LOCAL:8, 0, LOCAL:9
	A = 100 + LOCAL:8
	IF TFLAG:A == 0
		PRINTFORML [{LOCAL:8 + 1}] [収拾]　%TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 1
		PRINTFORML [{LOCAL:8 + 1}] [バトル] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 2
		PRINTFORML [{LOCAL:8 + 1}] [宝探し] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 3
		PRINTFORML [{LOCAL:8 + 1}] [すごろく] %TSTR:(100+LOCAL:8)%
	ELSE
		PRINTFORML [{LOCAL:8 + 1}] [親愛度] %TSTR:(100+LOCAL:8)%
	ENDIF
NEXT
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > LOCAL:9
	GOTO EVENT_SELECT
ENDIF

;選択されたイベントのタイプと名前をセット
LOCAL:8 = RESULT - 1
A = 100 + LOCAL:8
TFLAG:91 = TFLAG:A
TSTR:99 = %TSTR:A%
CALL EVENT_BOARD_MENU_SLOT, DAY:8, LOCAL:8
FLAG:68 = RESULT	;保存スロット(0-5)。表示番号とは分けて既存セーブを維持する。
; EVENT_STORY_OVERVIEW_HOOK_BEGIN
;選択したイベントの概要は、セーブデータ内でイベントごとに初回だけ表示する。
CALL EVENT_BOARD_GET_EVENT_INDEX
LOCAL:7 = RESULT
IF LOCAL:7 >= 0 && !GETBIT(FLAG:5013, LOCAL:7)
	SETBIT FLAG:5013, LOCAL:7
	CALL EVENT_BOARD_SHOW_OVERVIEW, LOCAL:7
ENDIF
;導入前に到達・受取済みだった中間台詞も、イベント選択時に未表示分だけ追いつく。
CALL EVENT_BOARD_SHOW_REACHED_PROGRESS
; EVENT_STORY_OVERVIEW_HOOK_END

;選んだイベント固有の進行状態を復元する。
CALL EVENT_BOARD_STATE_LOAD
$BOARD_LOOP
;各操作の結果を保存する。退出・別イベントへの切替後もここから再開する。
CALL EVENT_BOARD_STATE_SAVE
DRAWLINE
CALL EVENT_BOARD_STATUS

IF FLAG:15053 > 0
	;ミッションアクティブ中
	CALL EVENT_BOARD_MISSION_STATUS
	PRINTL
	LOCAL:0 = 500	;気力消費固定値
	LOCAL:1 = 250	;体力消費固定値
	PRINTFORML [1] 気力を使う（-{LOCAL:0}）
	IF TFLAG:91 == 3
		PRINTFORML [2] サイコロを振る（体力-{LOCAL:1}）
	ELSE
		PRINTFORML [2] エリアを進む（体力-{LOCAL:1}）
	ENDIF
	PRINTFORML [3] デッキ編成
	SIF ITEM:92 > 0
		PRINTFORML [4] ドーナッツを使う（気力+1500）　所持:{ITEM:92}個
	SIF ITEM:93 > 0
		PRINTFORML [5] パフェを使う（気力+3000）　所持:{ITEM:93}個
	SIF ITEM:94 > 0
		PRINTFORML [7] お弁当を食べる（体力・気力を最大値分回復）　所持:{ITEM:94}個
	PRINTFORML [8] 発揮値の内訳を見る
	PRINTFORML [6] 報酬確認
	PRINTFORML [0] ミッション破棄（このミッションLv-1）
	$BOARD_MISSION_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 1
		CALL EVENT_BOARD_ATTACK
	CASE 2
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 3
		CALL EDIT_DECK
	CASE 4
		CALL EVENT_BOARD_USE_ENERGY_1
	CASE 5
		CALL EVENT_BOARD_USE_ENERGY_2
	CASE 6
		CALL EVENT_BOARD_SHOW_REWARDS
	CASE 7
		CALL EVENT_BOARD_USE_BENTO
	CASE 8
		CALL EVENT_BOARD_SHOW_SCORE
	CASE 0
		CALL EVENT_BOARD_ABANDON_MISSION
	CASEELSE
		GOTO BOARD_MISSION_INPUT
	ENDSELECT
ELSE
	;ミッションなし・進行フェーズ
	LOCAL:0 = 250	;体力消費固定値
	IF TFLAG:91 == 3
		PRINTFORML [1] サイコロを振る（体力-{LOCAL:0}）
	ELSE
		PRINTFORML [1] エリアを進む（体力-{LOCAL:0}）
	ENDIF
	PRINTFORML [2] デッキ編成
	SIF ITEM:90 > 0
		PRINTFORML [3] おにぎりを使う（体力+1000）　所持:{ITEM:90}個
	SIF ITEM:91 > 0
		PRINTFORML [4] カレーを使う（体力+5000）　所持:{ITEM:91}個
	SIF ITEM:94 > 0
		PRINTFORML [6] お弁当を食べる（体力・気力を最大値分回復）　所持:{ITEM:94}個
	PRINTFORML [8] 発揮値の内訳を見る
	PRINTFORML [5] 報酬確認
	PRINTFORML [0] イベント終了
	$BOARD_ADVANCE_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 0
		RETURN 1
	CASE 1
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 2
		CALL EDIT_DECK
	CASE 3
		CALL EVENT_BOARD_USE_STAMINA_1
	CASE 4
		CALL EVENT_BOARD_USE_STAMINA_2
	CASE 5
		CALL EVENT_BOARD_SHOW_REWARDS
	CASE 6
		CALL EVENT_BOARD_USE_BENTO
	CASE 8
		CALL EVENT_BOARD_SHOW_SCORE
	CASEELSE
		GOTO BOARD_ADVANCE_INPUT
	ENDSELECT
ENDIF
GOTO BOARD_LOOP

;---------------------------------------------------------
; プレイヤーレベル初期化
; FLAG:15070=Lv、FLAG:15071=現在Lv内EXP
;---------------------------------------------------------
@EVENT_BOARD_PLAYER_LEVEL_INIT
IF FLAG:15070 <= 0
	FLAG:15070 = 1
	FLAG:15071 = 0
ENDIF
RETURN 1

;---------------------------------------------------------
; 次レベルに必要な経験値
; Lv1→2は800。以後、現在Lvが1上がるごとに50増える。
;---------------------------------------------------------
@EVENT_BOARD_PLAYER_NEXT_EXP(ARG)
LOCAL:0 = 750 + ARG * 50
SIF LOCAL:0 < 800
	LOCAL:0 = 800
RETURN LOCAL:0

;---------------------------------------------------------
; 体力・気力消費によるプレイヤー経験値獲得
; ARG:0=実際の消費量。消費量10につき1EXP（最低1EXP）。
;---------------------------------------------------------
@EVENT_BOARD_PLAYER_ADD_EXP(ARG)
CALL EVENT_BOARD_PLAYER_LEVEL_INIT
LOCAL:0 = ARG / 10
SIF LOCAL:0 < 1
	LOCAL:0 = 1
FLAG:15071 += LOCAL:0
PRINTFORML プレイヤーEXP +{LOCAL:0}

$EVENT_PLAYER_LEVEL_CHECK
CALL EVENT_BOARD_PLAYER_NEXT_EXP, FLAG:15070
LOCAL:1 = RESULT
IF FLAG:15071 < LOCAL:1
	PRINTFORML プレイヤーLv{FLAG:15070}　EXP {FLAG:15071}/{LOCAL:1}
	RETURN 0
ENDIF

FLAG:15071 -= LOCAL:1
FLAG:15070 += 1
MAXBASE:MASTER:0 += 10
MAXBASE:MASTER:1 += 10
;「全回復」ではなく新しい最大値ぶんを加算し、超過回復をそのまま保持する。
BASE:MASTER:0 += MAXBASE:MASTER:0
BASE:MASTER:1 += MAXBASE:MASTER:1
DRAWLINE
SETCOLOR 0xFFD700
PRINTL ★★★★★★★★★★★★★★★★★★★★★★★★★
PRINTFORML ★ プレイヤーレベルアップ！　Lv{FLAG:15070} ★
PRINTFORML 体力・気力最大値 +10　現在の最大値ぶん回復！
PRINTFORML 体力:{BASE:MASTER:0}/{MAXBASE:MASTER:0}　気力:{BASE:MASTER:1}/{MAXBASE:MASTER:1}
PRINTL ★★★★★★★★★★★★★★★★★★★★★★★★★
RESETCOLOR
DRAWLINE
GOTO EVENT_PLAYER_LEVEL_CHECK

; EVENT_STORY_FUNCTIONS_BEGIN
;---------------------------------------------------------
; イベント物語表示の開催年リセット
; FLAG:26=強くてニューゲーム周回数、DAY:3=開催年
;---------------------------------------------------------
@EVENT_BOARD_STORY_CYCLE_RESET
#DIM DYNAMIC STORY_CYCLE_KEY, 1

;中間台詞初版で表示前に立てた可能性がある表示済みビットを、一度だけ修復する。
IF FLAG:5019 < 1
	FLAG:5016 = 0
	FLAG:5017 = 0
	FLAG:5018 = 0
	FLAG:5019 = 1
ENDIF

STORY_CYCLE_KEY = FLAG:26 * 10000 + DAY:3
;導入前セーブでは、既存の完走済みイベントを現在年の表示済みとして引き継ぐ。
IF FLAG:5015 == 0
	FLAG:5014 = FLAG:5004
	FLAG:5015 = STORY_CYCLE_KEY
	RETURN 0
ENDIF
SIF FLAG:5015 == STORY_CYCLE_KEY
	RETURN 0

;翌年の再開催と強くてニューゲームでは、概要・中間・完走台詞を再表示できる。
FLAG:5013 = 0
FLAG:5014 = 0
FLAG:5016 = 0
FLAG:5017 = 0
FLAG:5018 = 0
FLAG:5015 = STORY_CYCLE_KEY
RETURN 1

;---------------------------------------------------------
; イベント初参加時の概要（FLAG:5013のイベント別・開催年内ビット）
;---------------------------------------------------------
@EVENT_BOARD_SHOW_OVERVIEW(ARG)
DRAWLINE
SETCOLOR 0x88CCFF
PRINTL 【イベント概要】
RESETCOLOR
SELECTCASE ARG:0
CASE 0	;銀世界＊創意あふれる雪まつり！
	PRINTL 一夜で銀世界へ変わった君咲学院を舞台に、生徒たちは手作りの雪まつりへ挑む。自由すぎる仲間と責任を抱え込むともこ――雪像が完成するまでに、凍りついた心まで解かせるのか？
	FORCEWAIT
	DRAWLINE
	SETCOLOR 0x88CCFF
	PRINTL 【導入】
	RESETCOLOR
	PRINTL はじめ「一晩で、神社へ続く石段も学院のグラウンドも雪に埋まっちゃったね」
	PRINTL ともこ「今日は休校ですが、学校をこのままにしておくわけにはいきません。手の空いた人で雪かきをします」
	PRINTL いちか「家でも雪かきしたのに、学校でも～？　でも先輩が一緒なら、ちょっと頑張れそうかも」
	PRINTL もも「真っ白なグラウンド、巨大な画用紙みたい。雪像も作って、雪祭りにしちゃおうよ～♪」
	PRINTL ともこ「雪かきだけでは、ただの重労働です。雪像とご褒美があれば、皆さんも楽しめるでしょう」
	PRINTL はじめ「みんなが笑顔になれるなら、雪の日も悪くないよね」
CASE 1	;極楽＊ゆらぐ心と温泉街
	PRINTL 卒業を前にした一行が、束の間の休息を求めて湯けむりの温泉街へ。賑やかな名所巡りの合間にこぼれる迷いと本音は、まだ見えないそれぞれの未来をどこへ導くのか。
	FORCEWAIT
	DRAWLINE
	SETCOLOR 0x88CCFF
	PRINTL 【導入】
	RESETCOLOR
	PRINTL なつみ「ついに温泉街に到着だね。君と一緒に小旅行へ来られるなんて、ずっと楽しみにしてたんだ♪」
	PRINTL もも「ただし、これは美術部の遠征だからね～？　不純な異性交遊で部活を潰すような真似は、ほどほどに！」
	PRINTL すみれ「まず旅館へ荷物を置き、そのあと絵画コンクールの授賞式へ出席する予定です」
	PRINTL なつみ「授賞式も大切だけど、せっかくの温泉街だもん。いつもみたいに大人しくしているだけじゃなく、ちゃんと楽しみたいな」
	PRINTL もも「そうそう。なっつんは最近、悩んでばかりで絵も描けてないし。ここで何か新しいモチーフを見つけたら？」
	PRINTL なつみ「うん。今度こそ、描きたいものを自分で見つけてみるね」
CASE 2	;感謝の気持ち＊どたばた冬のショッピング
	PRINTL 大切な人への贈り物を探しに、仲間たちは冬の街へ繰り出す。ところが迷子に喧嘩、思わぬ再会まで重なって買い物は大混乱――言えずにいた「ありがとう」は、無事に届くのか？
	FORCEWAIT
	DRAWLINE
	SETCOLOR 0x88CCFF
	PRINTL 【導入】
	RESETCOLOR
	PRINTL ましろ「今日も寒いが問題ない！　冬こそ元気に、誰かのために走り回る季節だぞっ☆」
	PRINTL つばさ「ことりんが転校生と腕を組んでる!?　あたし以外のひとと、どこへ行くつもりなの！」
	PRINTL ことり「おら、つばさしゃんの芸能界デビュー十周年を、自分だけの力でお祝いしたいんだぁ」
	PRINTL つばさ「お金ならあたしがいくらでも出すのに！　アイドルが勝手にアルバイトなんて、絶対に認めないからねっ！」
	PRINTL ことり「アイドルとして稼いだお金じゃなくて、おら自身が働いて掴んだものを、つばさしゃんに贈りたいだ」
	PRINTL ましろ「まずはみんなで話を聞こう。感謝の気持ちは、値札だけでは決まらないからな☆」
CASE 3	;奉納＊夜明かす神楽舞
	PRINTL 初詣で訪れた古い分社には、夜明けまでに慰めなければならない神がいた。神楽の舞台へ集められた生徒たちは、笑顔も後悔も青春もすべて奉じ、失われかけたものをつなぎ留めようとする。
	FORCEWAIT
	DRAWLINE
	SETCOLOR 0x88CCFF
	PRINTL 【導入】
	RESETCOLOR
	PRINTL しずく「新年早々、急に呼び出されてしまいました。家族との初詣を抜けてきたので、あまり長居はできませんよ」
	PRINTL すず「弟くんのお世話と、分社での神楽だ！　ボクたちで夜明けまで、ロックン・ロールな祭りをやるぞ☆」
	PRINTL ちづる「遠くまで来てくれてありがとう♪　ここはわたしの地元の分社で、みんなで初詣を楽しめる場所なんだよぉ」
	PRINTL やこ「神樹さんが宿泊費まで出してくれてるんだから、そのぶん働いてもらうわよ。舞台の準備くらいは手伝いなさい」
	PRINTL はじめ「この分社には、夜明けまでに慰めてほしい神さまがいるみたい。みんなの気持ちを、神楽にして届けたいんだ」
	PRINTL しずく「また大がかりなことになりそうですけど……みんなでやるなら、少しは楽しめるかもしれませんね」
CASE 4	;純情＊愛いっぱいのバレンタイン
	PRINTL 甘い香りに包まれた家庭科室で、それぞれの想いを託すチョコ作りが始まる。けれど「愛」がわからないそらは、誰に何を渡せばいいのかさえ決められない――彼女が最後に見つける答えとは？
