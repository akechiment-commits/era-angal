;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;==================================================
; EVENT_BOARD_イベントボード周回.ERB v3
; 新仕様:
;   体力消費 → エリア進行 → ミッション発生
;   → 気力消費 → 発揮値を積む → ミッション達成 → PTゲット
;   エリア進捗が100%になると踏破報酬 → リセット
;
; 使用変数:
;   TFLAG:91 = イベントタイプ(0:収拾/1:バトル/2:宝探し/3:すごろく/4:親愛度)
;   TSTR:99  = 選択中イベント名
;   FLAG:32  = 未使用（廃止）
;   FLAG:33  = すごろく盤面位置(タイプ3のみ, 0-19)
;   FLAG:34  = ミッション進捗（累積発揮値）
;   FLAG:35  = ミッション目標値
;   FLAG:36  = ミッション種別(0=なし/1=通常/2=特大/3=緊急)
;   FLAG:38  = エリア進捗（0～99、100で踏破報酬・リセット）
;   FLAG:64  = 通常ミッションLv（月初リセット）
;   FLAG:65  = 特大ミッションLv（月初リセット）
;   FLAG:66  = 緊急ミッションLv（月初リセット）
;   FLAG:67  = 月変更検知用（前回月）
;   FLAG:68  = 選択中イベントの月内インデックス(0-5)
;   FLAG:71～76 = 今月各イベントポイント（月初リセット）
;==================================================

@EVENT_BOARD_MAIN
IF TARGET < 0
	PRINTFORMW パートナーが選択されていません。
	RETURN 0
ENDIF

;月変更チェック → ミッションLv・イベントポイント・エリア番号リセット
IF FLAG:67 != DAY:8
	REPEAT 6
		FLAG:(71 + COUNT) = 0	;イベントポイント
		FLAG:(98 + COUNT) = 1	;エリア番号
	REND
	REPEAT 18
		FLAG:(78 + COUNT) = 1	;イベント別ミッションLv（各3スロット×6イベント）
	REND
	FLAG:37 = 0	;すごろく周回数リセット
	REPEAT 6
		FLAG:(104 + COUNT) = 0	;マイルストーン達成数リセット
	REND
	FLAG:67 = DAY:8
ENDIF

;今月のイベント一覧を取得
A = DAY:8
CALL LOAD_MONTH_EVENTS, A
LOCAL:9 = RESULT	;今月のイベント数

IF LOCAL:9 == 0
	PRINTFORMW 今月のイベントはありません。
	RETURN 0
ENDIF

;イベント選択
$EVENT_SELECT
DRAWLINE
PRINTFORML 【イベント】　%NAME:TARGET%　{DAY:8}月
PRINTL
FOR LOCAL:8, 0, LOCAL:9
	A = 100 + LOCAL:8
	IF TFLAG:A == 0
		PRINTFORML [{LOCAL:8 + 1}] [収拾]　%TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 1
		PRINTFORML [{LOCAL:8 + 1}] [バトル] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 2
		PRINTFORML [{LOCAL:8 + 1}] [宝探し] %TSTR:(100+LOCAL:8)%
	ELSEIF TFLAG:A == 3
		PRINTFORML [{LOCAL:8 + 1}] [すごろく] %TSTR:(100+LOCAL:8)%
	ELSE
		PRINTFORML [{LOCAL:8 + 1}] [親愛度] %TSTR:(100+LOCAL:8)%
	ENDIF
NEXT
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > LOCAL:9
	GOTO EVENT_SELECT
ENDIF

;選択されたイベントのタイプと名前をセット
LOCAL:8 = RESULT - 1
A = 100 + LOCAL:8
TFLAG:91 = TFLAG:A
TSTR:99 = %TSTR:A%
FLAG:68 = LOCAL:8	;イベントインデックス保存(0-5)

;ミッション状態クリア（新規開始）
FLAG:34 = 0
FLAG:35 = 0
FLAG:36 = 0
$BOARD_LOOP
DRAWLINE
CALL EVENT_BOARD_STATUS

IF FLAG:36 > 0
	;ミッションアクティブ中
	CALL EVENT_BOARD_MISSION_STATUS
	PRINTL
	LOCAL:0 = 300	;気力消費固定値
	LOCAL:1 = 250	;体力消費固定値
	PRINTFORML [1] 気力を使う（-{LOCAL:0}）
	IF TFLAG:91 == 3
		PRINTFORML [2] サイコロを振る（体力-{LOCAL:1}）
	ELSE
		PRINTFORML [2] エリアを進む（体力-{LOCAL:1}）
	ENDIF
	PRINTFORML [3] デッキ編成
	SIF ITEM:92 > 0
		PRINTFORML [4] ドーナッツを使う（気力+1500）　所持:{ITEM:92}個
	SIF ITEM:93 > 0
		PRINTFORML [5] パフェを使う（気力+3000）　所持:{ITEM:93}個
	SIF ITEM:94 > 0
		PRINTFORML [7] お弁当を食べる（体力・気力全回復）　所持:{ITEM:94}個
	PRINTFORML [8] 発揮値の内訳を見る
	PRINTFORML [6] 報酬確認
	PRINTFORML [0] ミッション破棄（このミッションLv-1）
	$BOARD_MISSION_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 1
		CALL EVENT_BOARD_ATTACK
	CASE 2
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 3
		CALL EDIT_DECK
	CASE 4
		CALL EVENT_BOARD_USE_ENERGY_1
	CASE 5
		CALL EVENT_BOARD_USE_ENERGY_2
	CASE 6
		CALL EVENT_BOARD_SHOW_REWARDS
	CASE 7
		CALL EVENT_BOARD_USE_BENTO
	CASE 8
		CALL EVENT_BOARD_SHOW_SCORE
	CASE 0
		CALL EVENT_BOARD_ABANDON_MISSION
	CASEELSE
		GOTO BOARD_MISSION_INPUT
	ENDSELECT
ELSE
	;ミッションなし・進行フェーズ
	LOCAL:0 = 250	;体力消費固定値
	IF TFLAG:91 == 3
		PRINTFORML [1] サイコロを振る（体力-{LOCAL:0}）
	ELSE
		PRINTFORML [1] エリアを進む（体力-{LOCAL:0}）
	ENDIF
	PRINTFORML [2] デッキ編成
	SIF ITEM:90 > 0
		PRINTFORML [3] おにぎりを使う（体力+1000）　所持:{ITEM:90}個
	SIF ITEM:91 > 0
		PRINTFORML [4] カレーを使う（体力+5000）　所持:{ITEM:91}個
	SIF ITEM:94 > 0
		PRINTFORML [6] お弁当を食べる（体力・気力全回復）　所持:{ITEM:94}個
	PRINTFORML [8] 発揮値の内訳を見る
	PRINTFORML [5] 報酬確認
	PRINTFORML [0] イベント終了
	$BOARD_ADVANCE_INPUT
	INPUT
	SELECTCASE RESULT
	CASE 0
		RETURN 1
	CASE 1
		IF TFLAG:91 == 3
			CALL EVENT_BOARD_SUGOROKU_ADVANCE
		ELSE
			CALL EVENT_BOARD_ADVANCE
		ENDIF
	CASE 2
		CALL EDIT_DECK
	CASE 3
		CALL EVENT_BOARD_USE_STAMINA_1
	CASE 4
		CALL EVENT_BOARD_USE_STAMINA_2
	CASE 5
		CALL EVENT_BOARD_SHOW_REWARDS
	CASE 6
		CALL EVENT_BOARD_USE_BENTO
	CASE 8
		CALL EVENT_BOARD_SHOW_SCORE
	CASEELSE
		GOTO BOARD_ADVANCE_INPUT
	ENDSELECT
ENDIF
GOTO BOARD_LOOP

;---------------------------------------------------------
; ステータス表示
;---------------------------------------------------------
@EVENT_BOARD_STATUS
PRINTFORML 【%TSTR:99%】
IF TFLAG:91 == 0
	PRINTFORML 収拾イベント　発揮値：表現力
ELSEIF TFLAG:91 == 1
	PRINTFORML バトルイベント　発揮値：運動力
ELSEIF TFLAG:91 == 2
	PRINTFORML 宝探しイベント　発揮値：学力
ELSEIF TFLAG:91 == 3
	PRINTFORML すごろくイベント　発揮値：好感度
ELSE
	PRINTFORML 親愛度イベント　発揮値：親密度+表現
ENDIF
CALL EVENT_BOARD_CALC_HAKKIICHI
PRINTFORML 体力:{BASE:MASTER:0}/{MAXBASE:MASTER:0}　気力:{BASE:MASTER:1}/{MAXBASE:MASTER:1}　発揮値:{RESULT}
A = FLAG:68 + 98	;エリア番号index
B = 71 + FLAG:68	;イベントPT index
IF TFLAG:91 == 3
	PRINTFORML エリア{FLAG:A}　周回数:{FLAG:37}周
ELSE
	PRINTFORML エリア{FLAG:A}　進捗:{FLAG:38}/100
ENDIF
PRINTFORML %TSTR:99%PT:{FLAG:B}
B = 127 + FLAG:68
PRINTFORML 累計PT:{FLAG:B}
A = FLAG:68 * 3 + 78	;通常Lv index
B = A + 1	;特大Lv index
C = A + 2	;緊急Lv index
PRINTFORML ミッションLv　通常:{FLAG:A}　特大:{FLAG:B}　緊急:{FLAG:C}
IF TFLAG:91 == 3
	CALL SUGOROKU_DRAW_BOARD
ENDIF
; 次の報酬を動的に表示
CALL LOAD_EVENT_REWARDS, DAY:8, FLAG:68
IF GLOBAL:2999 > 0
	LOCAL:2 = GLOBAL:2999	;tiercount
	A = 120 + FLAG:68
	LOCAL:1 = FLAG:A	;claim count
	LOCAL:3 = LOCAL:1 % LOCAL:2	;loop内tier
	LOCAL:4 = LOCAL:1 / LOCAL:2	;完了ループ数
	B = 2999 + LOCAL:2
	LOCAL:5 = GLOBAL:B	;loop PT総量
	B = 3000 + LOCAL:3
	LOCAL:6 = GLOBAL:B	;次tier基本PT
	LOCAL:7 = LOCAL:4 * LOCAL:5 + LOCAL:6	;次tierに必要な累計PT
	A = 127 + FLAG:68
	LOCAL:8 = FLAG:A	;現在の累計PT
	LOCAL:9 = LOCAL:7 - LOCAL:8	;不足PT
	B = 3100 + LOCAL:3
	LOCAL:10 = GLOBAL:B	;次tier報酬type
	B = 3200 + LOCAL:3
	LOCAL:11 = GLOBAL:B	;次tier報酬value
	IF LOCAL:9 <= 0
		PRINTFORML 次の報酬: 受取可能！
	ELSE
		PRINTFORM 次の報酬: あと{LOCAL:9}PT　→　
		CALL EVENT_BOARD_REWARD_TEXT, LOCAL:10, LOCAL:11
	ENDIF
	PRINTFORML 報酬進捗: {LOCAL:3}/{LOCAL:2}（ループ{LOCAL:4}周目）
ENDIF
PRINTFORML おにぎり:{ITEM:90}個　カレー:{ITEM:91}個　ドーナッツ:{ITEM:92}個　パフェ:{ITEM:93}個
RETURN 1

;---------------------------------------------------------
; ミッション状況表示
;---------------------------------------------------------
@EVENT_BOARD_MISSION_STATUS
A = FLAG:68 * 3 + 77 + FLAG:36	;現在のミッションLv index
IF FLAG:36 == 1
	PRINTFORML ▼ 通常ミッション Lv{FLAG:A}
ELSEIF FLAG:36 == 2
	PRINTFORML ▼▼ 特大ミッション Lv{FLAG:A}
ELSE
	PRINTFORML ▼▼▼ 緊急ミッション Lv{FLAG:A}！
ENDIF
PRINTFORML 進捗: {FLAG:34} / {FLAG:35}
LOCAL:0 = FLAG:34 * 10 / FLAG:35
SIF LOCAL:0 > 10
	LOCAL:0 = 10
PRINTFORM 達成率: [
FOR LOCAL:8, 0, 10
	IF LOCAL:8 < LOCAL:0
		PRINTFORM #
	ELSE
		PRINTFORM .
	ENDIF
NEXT
PRINTFORML ] {FLAG:34 * 100 / FLAG:35}/100
RETURN 1

;---------------------------------------------------------
; エリア進行（体力消費 → エリア進捗 → ミッション発生）
;---------------------------------------------------------
@EVENT_BOARD_ADVANCE
LOCAL:0 = 250	;体力消費固定値

IF BASE:MASTER:0 < LOCAL:0
	PRINTFORMW 体力が足りない！これ以上進めない。
	RETURN 0
ENDIF

BASE:MASTER:0 -= LOCAL:0

;エリア進捗 +10
FLAG:38 += 10
PRINTFORML 体力 -{LOCAL:0}　エリアを進んだ。（進捗: {FLAG:38}/100）

;ランダムドロップ（PT + 稀にアイテム）
CALL EVENT_BOARD_RANDOM_DROP

;エリア踏破チェック
SIF FLAG:38 >= 100
	CALL EVENT_BOARD_AREA_COMPLETE

;ミッション発生判定（ミッション中は発生しない）
IF FLAG:36 == 0
	LOCAL:2 = RAND:100
	IF LOCAL:2 < 50
		FLAG:36 = 1
		A = FLAG:68 * 3 + 78	;通常Lv index
		FLAG:35 = 100 * FLAG:A * (FLAG:A + 1) + RAND:200
		FLAG:34 = 0
		PRINTL
		PRINTFORML ▼ 通常ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:35}
	ELSEIF LOCAL:2 < 80
		FLAG:36 = 2
		A = FLAG:68 * 3 + 79	;特大Lv index
		FLAG:35 = 400 * FLAG:A * (FLAG:A + 1) + RAND:400
		FLAG:34 = 0
		PRINTL
		PRINTFORML ▼▼ 特大ミッション Lv{FLAG:A} 発生！　目標値: {FLAG:35}
	ELSEIF LOCAL:2 < 95
		FLAG:36 = 3
		A = FLAG:68 * 3 + 80	;緊急Lv index
		FLAG:35 = 800 * FLAG:A * (FLAG:A + 1) + RAND:800
		FLAG:34 = 0
		PRINTL
		PRINTFORML ▼▼▼ 緊急ミッション Lv{FLAG:A} 発生！！　目標値: {FLAG:35}
	ELSE
		LOCAL:3 = MAXBASE:MASTER:1 / 5
		BASE:MASTER:1 += LOCAL:3
		SIF BASE:MASTER:1 > MAXBASE:MASTER:1
			BASE:MASTER:1 = MAXBASE:MASTER:1
		PRINTFORML ひと息ついた。　気力 +{LOCAL:3}
	ENDIF
ENDIF
WAIT
RETURN 1

;---------------------------------------------------------
; 攻撃（気力消費 → 発揮値を進捗に加算）
;---------------------------------------------------------
@EVENT_BOARD_ATTACK
LOCAL:0 = 300	;気力消費固定値

IF BASE:MASTER:1 < LOCAL:0
	PRINTFORMW 気力が足りない！攻撃できない。
	RETURN 0
ENDIF

CALL EVENT_BOARD_CALC_HAKKIICHI
LOCAL:1 = RESULT

BASE:MASTER:1 -= LOCAL:0
FLAG:34 += LOCAL:1
PRINTFORML 気力 -{LOCAL:0}　発揮値 +{LOCAL:1}　（進捗: {FLAG:34}/{FLAG:35}）

IF FLAG:34 >= FLAG:35
	CALL EVENT_BOARD_MISSION_CLEAR
ELSE
	WAIT
ENDIF
RETURN 1

;---------------------------------------------------------
; ミッションクリア処理
;---------------------------------------------------------
@EVENT_BOARD_MISSION_CLEAR
DRAWLINE
A = FLAG:68 * 3 + 77 + FLAG:36	;現在のミッションLv index
IF FLAG:36 == 1
	PRINTFORML ★ 通常ミッション Lv{FLAG:A} クリア！
ELSEIF FLAG:36 == 2
	PRINTFORML ★★ 特大ミッション Lv{FLAG:A} クリア！！
ELSE
	PRINTFORML ★★★ 緊急ミッション Lv{FLAG:A} クリア！！！
ENDIF
LOCAL:0 = FLAG:35 / 50 + 1	;発揮値に比例したPT（目標値/50+1）
FLAG:A += 1
PRINTFORML → Lv{FLAG:A}へ！
;親愛ボーナス（親愛の人数に応じてイベントポイント増加）
IF TALENT:MASTER:親愛ボーナス || TALENT:MASTER:親愛ボーナス強化
	LOCAL:50 = 0
	FOR LOCAL:51, 1, CHARANUM
		SIF TALENT:(LOCAL:51):88
			LOCAL:50 += 1
	NEXT
	IF LOCAL:50 > 0
		IF TALENT:MASTER:親愛ボーナス強化
			LOCAL:0 += LOCAL:0 * LOCAL:50 * 2 / 100
		ELSE
			LOCAL:0 += LOCAL:0 * LOCAL:50 / 100
		ENDIF
	ENDIF
ENDIF
B = 71 + FLAG:68
FLAG:B += LOCAL:0
B = 127 + FLAG:68
FLAG:B += LOCAL:0
PRINTFORML イベントPT +{LOCAL:0}
CALL EVENT_BOARD_CLAIM_REWARDS
B = 127 + FLAG:68
PRINTFORML 累計PT:{FLAG:B}
PRINTL
;ミッションクリア報酬：ピックアップガチャ2回
;通常=ブロンズ(1) 特大=シルバー(2) 緊急=ゴールド(3)
LOCAL:9 = FLAG:36
FLAG:36 = 0
FLAG:34 = 0
FLAG:35 = 0
CALL LOAD_EVENT_PICKUP_CARDS, DAY:8, FLAG:68
LOCAL:7 = DAY:8
LOCAL:8 = GLOBAL:2199
LOCAL:10 = GLOBAL:2200
LOCAL:11 = GLOBAL:2201
LOCAL:12 = GLOBAL:2202
IF LOCAL:9 == 1
	PRINTFORML 【報酬】ピックアップブロンズガチャ ×2
	CALL GACHA_PULL_PICKUP, 1
	CALL GACHA_PULL_PICKUP, 1
ELSEIF LOCAL:9 == 2
	PRINTFORML 【報酬】ピックアップシルバーガチャ ×2
	CALL GACHA_PULL_PICKUP, 2
	CALL GACHA_PULL_PICKUP, 2
ELSE
	PRINTFORML 【報酬】ピックアップゴールドガチャ ×2
	CALL GACHA_PULL_PICKUP, 3
	CALL GACHA_PULL_PICKUP, 3
ENDIF
WAIT
RETURN 1

;---------------------------------------------------------
; エリア踏破報酬（FLAG:38 リセット）
;---------------------------------------------------------
@EVENT_BOARD_AREA_COMPLETE
DRAWLINE
A = FLAG:68 + 98	;エリア番号index
PRINTFORML ★★★ エリア{FLAG:A} 踏破！ ★★★
LOCAL:0 = 5 + RAND:6
B = 71 + FLAG:68
FLAG:B += LOCAL:0
B = 127 + FLAG:68
FLAG:B += LOCAL:0
PRINTFORML イベントPT +{LOCAL:0}
CALL EVENT_BOARD_CLAIM_REWARDS
A = FLAG:68 + 98	;エリア番号index（CALL後に再設定）
FLAG:38 = 0
FLAG:A += 1
PRINTFORML エリア{FLAG:A}に進行！
WAIT
RETURN 1

;---------------------------------------------------------
; 発揮値計算（RETURN で返す）
; イベントタイプにより算出方法が異なる
;---------------------------------------------------------
;---------------------------------------------------------
; ミッション破棄（Lv-1 → ミッションなし状態へ）
;---------------------------------------------------------
@EVENT_BOARD_ABANDON_MISSION
DRAWLINE
A = FLAG:68 * 3 + 77 + FLAG:36	;現在のミッションLv index
IF FLAG:36 == 1
	PRINTFORML ミッション破棄。通常ミッション（Lv{FLAG:A}）
ELSEIF FLAG:36 == 2
	PRINTFORML ミッション破棄。特大ミッション（Lv{FLAG:A}）
ELSE
	PRINTFORML ミッション破棄。緊急ミッション（Lv{FLAG:A}）
ENDIF
SIF FLAG:A > 1
	FLAG:A -= 1
PRINTFORML → Lv{FLAG:A}に下がった。
FLAG:34 = 0
FLAG:35 = 0
FLAG:36 = 0
WAIT
RETURN 1

;---------------------------------------------------------
; イベントデッキスコア計算（定期戦と同じデッキを使用）
; TFLAG:91 のイベントタイプごとにステータス重みが変わる
; 有利属性が高い場合は x1.2 ボーナス
;---------------------------------------------------------
@EVENT_BOARD_CALC_HAKKIICHI
CALL CARD_RECALC_BONUSES
A = 0	;合計スコア
B = 0	;有効人数
C = 0	;有利属性合計（ボーナス判定用）

REPEAT 5
	Z = FLAG:(200 + COUNT)
	SIF Z < 0 || Z >= CHARANUM || Z == MASTER
		CONTINUE

	;デッキキャラ個別スコア（親密度ベース共通）
	LOCAL:1 = CFLAG:Z:2 / 10

	IF TFLAG:91 == 0
		;収拾: 表現力重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 15	;表現★
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:94	;有利属性:表現
	ELSEIF TFLAG:91 == 1
		;バトル: 運動重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 15	;運動★
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:93	;有利属性:運動
	ELSEIF TFLAG:91 == 2
		;宝探し: 学力+知識重視
		LOCAL:1 += ABL:Z:88 * 12	;学力★
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 3	;表現
		LOCAL:1 += ABL:Z:95 * 10	;知識★
		C += ABL:Z:88 + ABL:Z:95	;有利属性:学力+知識
	ELSEIF TFLAG:91 == 3
		;すごろく: 親密度重視
		LOCAL:1 += CFLAG:Z:2 / 10	;親密度追加
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ELSE
		;親愛度: 親密度★+表現重視
		LOCAL:1 += CFLAG:Z:2 / 5	;親密度★★
		LOCAL:1 += ABL:Z:88 * 3	;学力
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 10	;表現★
		LOCAL:1 += ABL:Z:95 * 3	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ENDIF

	;カードボーナス（定期戦と同じ）
	LOCAL:1 += CFLAG:Z:303
	LOCAL:1 += CFLAG:Z:304
	LOCAL:1 += CFLAG:Z:305
	LOCAL:1 += CFLAG:Z:306

	A += LOCAL:1
	B += 1
REND

;デッキ未編成時は最低値
SIF B == 0
	RETURN 10

;有利属性ボーナス（平均がしきい値を超えたら x1.2）
LOCAL:3 = C / B
IF TFLAG:91 == 0 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（表現ボーナス x1.2）
ELSEIF TFLAG:91 == 1 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（運動ボーナス x1.2）
ELSEIF TFLAG:91 == 2 && LOCAL:3 >= 80
	TIMES A, 1.20
	PRINTFORML 	（学力+知識ボーナス x1.2）
ELSEIF TFLAG:91 == 3 && LOCAL:3 >= 500
	TIMES A, 1.20
	PRINTFORML 	（親密ボーナス x1.2）
ELSEIF TFLAG:91 == 4 && LOCAL:3 >= 500
	TIMES A, 1.20
