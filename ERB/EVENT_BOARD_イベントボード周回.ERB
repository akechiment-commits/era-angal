;---------------------------------------------------------
; イベントデッキスコア計算（定期戦と同じデッキを使用）
; TFLAG:91 のイベントタイプごとにステータス重みが変わる
; 有利属性が高い場合は x1.2 ボーナス
;---------------------------------------------------------
@EVENT_BOARD_CALC_HAKKIICHI
CALL CARD_RECALC_BONUSES
A = 0	;合計スコア
B = 0	;有効人数
C = 0	;有利属性合計（ボーナス判定用）

REPEAT 5
	Z = FLAG:(200 + COUNT)
	SIF Z < 0 || Z >= CHARANUM || Z == MASTER
		CONTINUE

	;デッキキャラ個別スコア（親密度ベース共通）
	LOCAL:1 = CFLAG:Z:2 / 10

	IF TFLAG:91 == 0
		;収拾: 表現力重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 15	;表現★
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:94	;有利属性:表現
	ELSEIF TFLAG:91 == 1
		;バトル: 運動重視
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 15	;運動★
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += ABL:Z:93	;有利属性:運動
	ELSEIF TFLAG:91 == 2
		;宝探し: 学力+知識重視
		LOCAL:1 += ABL:Z:88 * 12	;学力★
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 3	;表現
		LOCAL:1 += ABL:Z:95 * 10	;知識★
		C += ABL:Z:88 + ABL:Z:95	;有利属性:学力+知識
	ELSEIF TFLAG:91 == 3
		;すごろく: 親密度重視
		LOCAL:1 += CFLAG:Z:2 / 10	;親密度追加
		LOCAL:1 += ABL:Z:88 * 5	;学力
		LOCAL:1 += ABL:Z:93 * 5	;運動
		LOCAL:1 += ABL:Z:94 * 5	;表現
		LOCAL:1 += ABL:Z:95 * 5	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ELSE
		;親愛度: 親密度★+表現重視
		LOCAL:1 += CFLAG:Z:2 / 5	;親密度★★
		LOCAL:1 += ABL:Z:88 * 3	;学力
		LOCAL:1 += ABL:Z:93 * 3	;運動
		LOCAL:1 += ABL:Z:94 * 10	;表現★
		LOCAL:1 += ABL:Z:95 * 3	;知識
		C += CFLAG:Z:2	;有利属性:親密度
	ENDIF

	;カード収集ボーナス。イベント発揮値では所持カードの成長を強く反映する。
	LOCAL:1 += CFLAG:Z:303 * 5
	LOCAL:1 += CFLAG:Z:304 * 5
	LOCAL:1 += CFLAG:Z:305 * 5
	LOCAL:1 += (CFLAG:Z:306 / 2) * 5

	A += LOCAL:1
	B += 1
REND

;デッキ未編成時は最低値
SIF B == 0
	RETURN 10

;有利属性ボーナス（平均がしきい値を超えたら x1.2）
LOCAL:3 = C / B
IF TFLAG:91 == 0 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（表現ボーナス x1.2）
ELSEIF TFLAG:91 == 1 && LOCAL:3 >= 50
	TIMES A, 1.20
	PRINTFORML 	（運動ボーナス x1.2）
ELSEIF TFLAG:91 == 2 && LOCAL:3 >= 80
	TIMES A, 1.20
	PRINTFORML 	（学力+知識ボーナス x1.2）
ELSEIF TFLAG:91 == 3 && LOCAL:3 >= 500
	TIMES A, 1.20
	PRINTFORML 	（親密ボーナス x1.2）
ELSEIF TFLAG:91 == 4 && LOCAL:3 >= 500
	TIMES A, 1.20
	PRINTFORML 	（親愛ボーナス x1.2）
ENDIF

;5人フルパーティボーナス
SIF B == 5
	TIMES A, 1.10

;恋慕ボーナス（恋慕の人数に応じて発揮値増加）
IF TALENT:MASTER:恋慕ボーナス || TALENT:MASTER:恋慕ボーナス強化
	LOCAL:50 = 0
	FOR LOCAL:51, 1, CHARANUM
		SIF TALENT:(LOCAL:51):85
			LOCAL:50 += 1
	NEXT
	IF LOCAL:50 > 0
		IF TALENT:MASTER:恋慕ボーナス強化
			A += A * LOCAL:50 * 2 / 100
		ELSE
			A += A * LOCAL:50 / 100
		ENDIF
	ENDIF
ENDIF

SIF A < 10
	A = 10

;人形ボーナス（手作り人形のLVに応じて加算）
SIF ITEM:852 > 0
	A += ITEM:852 * 100

RETURN A

