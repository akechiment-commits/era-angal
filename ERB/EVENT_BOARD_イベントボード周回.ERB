;---------------------------------------------------------
; イベント中間シナリオ（ARG:1=1:序盤 / 2:中盤 / 3:後半）
;---------------------------------------------------------
@EVENT_BOARD_SHOW_PROGRESS_DIALOGUE(ARG, ARG:1)
DRAWLINE
SETCOLOR 0xFFCC66
IF ARG:1 == 1
	PRINTL 【イベントシナリオ・序盤】
ELSEIF ARG:1 == 2
	PRINTL 【イベントシナリオ・中盤】
ELSEIF ARG:1 == 3
	PRINTL 【イベントシナリオ・後半】
ENDIF
RESETCOLOR
IF ARG:1 == 1
	CALL EVENT_BOARD_SHOW_PROGRESS_5000, ARG:0
ELSEIF ARG:1 == 2
	CALL EVENT_BOARD_SHOW_PROGRESS_10000, ARG:0
ELSEIF ARG:1 == 3
	CALL EVENT_BOARD_SHOW_PROGRESS_15000, ARG:0
ENDIF
DRAWLINE
FORCEWAIT
RETURN 0

;---------------------------------------------------------
; 受取済み報酬を含め、現在PTに到達済みの未表示シナリオを追いつき表示する
;---------------------------------------------------------
@EVENT_BOARD_SHOW_REACHED_PROGRESS
#DIM DYNAMIC STORY_EVENT_INDEX, 1
#DIM DYNAMIC STORY_PT_INDEX, 1
#DIM DYNAMIC STORY_CURRENT_PT, 1
CALL EVENT_BOARD_GET_EVENT_INDEX
STORY_EVENT_INDEX = RESULT
SIF STORY_EVENT_INDEX < 0
	RETURN 0
STORY_PT_INDEX = 71 + FLAG:68
A = STORY_PT_INDEX
STORY_CURRENT_PT = FLAG:A
IF STORY_CURRENT_PT >= 5000 && !GETBIT(FLAG:5016, STORY_EVENT_INDEX)
	CALL EVENT_BOARD_SHOW_PROGRESS_DIALOGUE, STORY_EVENT_INDEX, 1
	SETBIT FLAG:5016, STORY_EVENT_INDEX
ENDIF
IF STORY_CURRENT_PT >= 10000 && !GETBIT(FLAG:5017, STORY_EVENT_INDEX)
	CALL EVENT_BOARD_SHOW_PROGRESS_DIALOGUE, STORY_EVENT_INDEX, 2
	SETBIT FLAG:5017, STORY_EVENT_INDEX
ENDIF
IF STORY_CURRENT_PT >= 15000 && !GETBIT(FLAG:5018, STORY_EVENT_INDEX)
	CALL EVENT_BOARD_SHOW_PROGRESS_DIALOGUE, STORY_EVENT_INDEX, 3
	SETBIT FLAG:5018, STORY_EVENT_INDEX
ENDIF
RETURN 0

