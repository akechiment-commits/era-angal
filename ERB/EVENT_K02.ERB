;--------------------------------------------------
;口上ファイルの存在判定（02をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:102 = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
FLAG:102 = 0

