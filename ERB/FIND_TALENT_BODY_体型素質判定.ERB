			A += 20
		ELSEIF PALAM:10 >= 3000	; 【[恐怖]>=3000】
			A += 15
		ELSEIF PALAM:10 >= 2000	; 【[恐怖]>=2000】
			A += 10
		ELSEIF PALAM:10 >= 1000	; 【[恐怖]>=1000】
			A += 5
		ELSEIF PALAM:10 >= 500	; 【[恐怖]>=500】
		ENDIF
		;最高値150
		;最低値10
		;不利要素全部持ち最高値80
		
		;確立調整のため120以上は120に
		SIF A > 120
			A = 120
		A += RAND:100
		SIF A >= 175
			CALL FIND_BUSTSIZE2
		S = 0
	ENDIF
