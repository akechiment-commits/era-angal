;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@CALLTRAINEND
TFLAG:CALLTRAIN = 0

@SHOW_USERCOM
;気絶状態および主導権の判定（気絶中は主導権を絶対に相手に移さない）
IF TARGET >= 0 && BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
	TFLAG:899 = 1
	TFLAG:45 = 0
	TFLAG:34 = 0
ELSE
	TFLAG:899 = 0
ENDIF
TFLAG:28 = 0
VARSET Q, -1
VARSET C, 0
;CALLTRAIN時は表示しない
SIF TFLAG:CALLTRAIN
	RETURN 0

;完全にパートナーに主導権を握らせている場合：ステータス表示が完了した直後に相手の行動を描画
IF TFLAG:34	; 【[主導権全委任]】
	DRAWLINE
	IF TFLAG:44	; 【[ウフフ中]】
		PRINTFORM 【主導権完全委譲中】相手の熱中度:
		IF TFLAG:108 >= 3	; 【[リバース過熱度]>=3】
			SETCOLOR 255, 50, 150
			PRINTFORM ★★★ 陶酔・絶頂狂乱
		ELSEIF TFLAG:108 == 2	; 【[リバース過熱度]==2】
			SETCOLOR 255, 100, 200
			PRINTFORM ★★ 昂揚・本気攻め
		ELSEIF TFLAG:108 == 1	; 【[リバース過熱度]==1】
			SETCOLOR 255, 150, 200
			PRINTFORM ★ 熱気・積極的
		ELSE
			PRINTFORM ☆ 探り合い
		ENDIF
		RESETCOLOR
		PRINTFORML  (連続:{TFLAG:109}ターン)
		;相手の行動を決定し、情熱的な地の文を出力
		CALL REVMODE_PASSIVEPHASE(TARGET)
	ELSE
		PRINTFORML 【主導権完全委譲中】（%CALLNAME:TARGET%が自由に主導権を握っています）
		CALL PASSIVEMODE_PASSIVEPHASE(TARGET)
	ENDIF
	DRAWLINE
ENDIF
;パートナーが[親愛]を持っている場合、異常経験が付くコマンドを表示するコンフィグがONの場合
;パートナーが[親愛]を持っていたら異常経験フィルタを一時的にOFFにする
LOCAL:2 = 0
IF TALENT:88 && (FLAG:61 & 2)	; 【[親愛]】
	;異常経験フィルタが元々OFFかLOCAL:2に記憶。コマンド表示後戻す
	SIF (FLAG:61 & 1) == 0
		LOCAL:2 = 1
	FLAG:61 |= 1
ENDIF

IF TARGET >= 0 && BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
	SETCOLOR 0xFF5555
	PRINTFORML 【状態：気絶中】（%CALLNAME:TARGET%は意識を失っています。一部の一方的なコマンドのみ実行可能です）
	RESETCOLOR
ENDIF

LOCAL:1 = -1
;コマンドを全てチェック
FOR LOCAL, 0, 1000
	;名前の長さが0の場合、ないものとみなす
	SIF STRLENS(TRAINNAME:LOCAL) == 0
		CONTINUE
	;模擬戦(非ウフフモード時の1番目のコマンド)の初期位置を変える処理
	;デフォは100、コンフィグで設定している場合、0になる
	IF LOCAL == 300 && TFLAG:44 == 0	; 【無[ウフフ中]】
		IF FLAG:23 & 8388608
			LOCAL:1 = -1
		ELSE
			LOCAL:1 = 99
		ENDIF
	ENDIF
	LOCAL:1 += 1
	;異常経験フィルタがONの時、異常経験をとるかどうか判定し、通ったら潰す
	IF (FLAG:61 & 1) == 0
		SIF ABNOMALCOMABLE(LOCAL)
			CONTINUE
	ENDIF
	;コマンドフィルタ
	;共通設定フラグONの時
	IF GET_COM_FILTERING(1001, TARGET)
		SIF GET_COM_FILTERING(LOCAL, MASTER)
			CONTINUE
	ELSE
		SIF GET_COM_FILTERING(LOCAL, TARGET)
			CONTINUE
	ENDIF
	;警告用
	TFLAG:DOTRAIN = 0
	TRYCALLFORM COM_ABLE{LOCAL}
	IF RESULT == 1
		PRINTFORML %TRAINNAME:LOCAL%は@COM_ABLEで、COM_ABLE強制終了フラグが設定されていません
		PRINTFORML 他のCOM_ABLEを参考にして、以下の記述を追加してください
		PRINTFORML SIF TFLAG:DOTRAIN == 0 && TFLAG:CALLTRAIN == 0
		PRINTFORMW 		RETURN 0
	ENDIF
	;DOTRAINを使うので1に
	TFLAG:DOTRAIN = 1
	;COM_ABLE共通判定のためSELECTCOMにLOCALを代入
	SELECTCOM = LOCAL
	TRYCALLFORM COM_ABLE{LOCAL}
	SIF RESULT == 0
		CONTINUE
	;Q配列に実行可能コマンドを記録していく
	Q:(LOCAL:1) = LOCAL
	;ウフフ独自コマンド
	IF LOCAL >= 280 && LOCAL <= 284
		PRINTFORMC %CSTR:(LOCAL-200)%[{LOCAL:1,3}]
	;純愛独自コマンド
	ELSEIF LOCAL >= 410 && LOCAL <= 414
		PRINTFORMC %CSTR:(LOCAL-325)%[{LOCAL:1,3}]
	ELSE
		;予め実行判定を調べ実行不可能ならばグレー表示にする
		;例外＝口上独自コマンドおよび[316]髪を梳いて貰う
		LOCAL:3 = 0
		SKIPDISP 1
		CALL PRE_COMORDER, LOCAL
		LOCAL:3 = RESULT
		SKIPDISP 0
		SIF LOCAL:3
			SETCOLOR 105, 105, 105
		;コマンド名呼び出し
		CALL CUSTOM_COMMAND_NAME, LOCAL, LOCAL:1
		SIF LOCAL:3
			RESETCOLOR
	ENDIF
	;改行処理
	CALL NEWLINE
NEXT
;USERCOM表示の前に一度、改行する
IF (C % PRINTCPERLINE())
	C = 0
	PRINTL 
ENDIF

;異常経験フィルタをコマンド表示後元の設定に戻す
SIF LOCAL:2
	FLAG:61 -= 1

PRINTC 履歴表示[800]
CALL NEWLINE
PRINTC 汚れ表示[801]
CALL NEWLINE
PRINTC 能力表示[802]
CALL NEWLINE
A = 0
REPEAT 100
	SIF ITEM:(500 + COUNT)
		A = 1
REND
IF A
	PRINTC アイテム使用[810]
	CALL NEWLINE
ENDIF
;服を脱がせる＝通称ウフフモード突入
IF TFLAG:44 == 0 && TFLAG:34 == 0	; 【無[ウフフ中] / 無[主導権全委任]】
	PRINTC 服を脱がせる[850]
	CALL NEWLINE
ENDIF
IF TFLAG:34 == 0 && (FLAG:23 & 8) && (TARGET < 0 || BASE:TARGET:0 > 0)	; 【無[主導権全委任] / TARGET:[体力]>0】
	PRINTC 主導権を決める[851]
	CALL NEWLINE
ENDIF
;通常時・ウフフ中のどちらでも、パートナーAIに連続行動を任せられる
IF TFLAG:34 == 0 && (TARGET < 0 || BASE:TARGET:0 > 0)	; 【無[主導権全委任] / TARGET:[体力]>0】
	PRINTC パートナーに任せる[852]
	CALL NEWLINE
ENDIF

PRINTC コンフィグ[860]
CALL NEWLINE

;口上独自USERCOM表示　CFLAGは利用設定フラグ
IF CFLAG:TARGET:独自コマンド使用判定
	FOR LOCAL, 10, 19
		IF GETBIT(CFLAG:TARGET:独自コマンド使用判定, LOCAL)
			PRINTFORMC %CSTR:TARGET:(80+LOCAL)%[{860 + LOCAL}]
			CALL NEWLINE
		ENDIF
	NEXT
ENDIF
IF ASSI > 0
	IF ASSIPLAY && TEQUIP:90 == 0 && TEQUIP:2 == 0 && (TFLAG:44 == 0 || TALENT:152)	; 【[合意] / 無[触手プレイ] / 無[デート中] / 無[ウフフ中] / 調教者:[助手]】
		PRINTC マスターと交代[900]
	ELSEIF TEQUIP:90 == 0 && TEQUIP:2 == 0 && (TFLAG:44 == 0 || TALENT:152)	; 【[合意] / 無[触手プレイ] / 無[デート中] / 無[ウフフ中]】
		PRINTC 助手と交代[900]
	ENDIF
	CALL NEWLINE
ENDIF

IF ASSIPLAY	; 【調教者:[助手]】
	PRINTC 能力表示(助手)[902]
ELSE
	PRINTC 能力表示(マスター)[902]
ENDIF
CALL NEWLINE
PRINTC 生徒手帳[910]
CALL NEWLINE
PRINTC リセット[950]
CALL NEWLINE
IF TALENT:MASTER:998	; 【MASTER:[Debug]】
	PRINTC デバッグメニュー[998]
	CALL NEWLINE
ENDIF
PRINTC 行動終了[999]
IF PREVCOM >= 0
	PRINTL 
	PRINTFORM < 前回実行コマンド : %STR:0% 
	SIF TFLAG:50	; 【[調教者切替]】
		PRINT (助手) 
	PRINT >
ENDIF

;---------------------------------------------------------
;改行処理
;---------------------------------------------------------
@NEWLINE
C += 1
SIF (C % PRINTCPERLINE()) == 0
	PRINTL 

;---------------------------------------------------------
;実行判定を呼び出してコマンドごとにチェックする処理
;TRYCCALLFORMを使うので式中関数にはできない
;---------------------------------------------------------
@PRE_COMORDER, ARG
;[316]髪を梳いて貰うコマンドだけは途中でINPUTあるので処理しない。
SIF ARG == 316
	RETURN 0
TRYCCALLFORM COM_ORDER_{ARG}
	;実行できない場合
	IF A < V
		RETURN 1
	;実行できる場合
	ELSE
		RETURN 0
	ENDIF
CATCH
	;元々実行判定のないコマンドの場合
	RETURN 0
ENDCATCH

;---------------------------------------------------------------------------------------------
;コマンド名変更処理
;元はPRINTFORMC %TRAINNAME:LOCAL%[{LOCAL:1,3}]でTrain.csvのコマンド名通りに表示されていた処理
;ARG 元処理のLOCAL(選択されているコマンド番号)
;ARG:1 元処理のLOCAL:1(表示番号)
;---------------------------------------------------------------------------------------------
@CUSTOM_COMMAND_NAME, ARG, ARG:1
;気絶中は主導権を相手に移さず名前変更も行わない
IF TARGET >= 0 && (TFLAG:899 || BASE:TARGET:0 <= 0)	; 【[気絶継続中] / TARGET:[体力]<=0】
	TFLAG:45 = 0
	TFLAG:34 = 0
ENDIF
;LOCALSに元のコマンド名を設定
LOCALS = %TRAINNAME:ARG%

;パートナーに主導権がある時、パートナー側がプレイヤーへ行動するコマンドの名前変更
;スパンキング
SIF SELECTCOM == 40 && TFLAG:45	; 【コマンド:[スパンキング] / [主導権]】
	LOCALS = スパンキングされる
;鞭
SIF SELECTCOM == 41 && TFLAG:45	; 【コマンド:[鞭] / [主導権]】
	LOCALS = 鞭で打たれる
;針
SIF SELECTCOM == 42 && TFLAG:45	; 【コマンド:[針] / [主導権]】
	LOCALS = 針で刺される
;言葉責め
SIF SELECTCOM == 75 && TFLAG:45	; 【コマンド:[言葉責め] / [主導権]】
	LOCALS = 言葉責めされる

;剃毛プレイ
IF SELECTCOM == 257	; 【コマンド:[剃毛プレイ]】
	;PLAYER主導権時の実行判定
	CALL COM_ABLE257_PLAYER_MAIN
	LOCAL:0 = RESULT

	;TARGET主導権時の実行判定
	CALL COM_ABLE257_TARGET_MAIN
	LOCAL:1 = RESULT
	
	;TARGET主導権時の「剃毛される」を実行可能で、TARGETが主導権をもっている場合名前変更
	;またPLAYER主導権時の「剃毛プレイ」を実行できない場合も「剃毛される」になるため名前変更
	SIF LOCAL:1 && (TFLAG:45 || LOCAL:0 == 0)	; 【[主導権]】
		LOCALS = 剃毛される
ENDIF

;デート中のCOM320名称変更
IF SELECTCOM == 320 && (TEQUIP:2 == 38 || TEQUIP:2 == 39)	; 【コマンド:[学食に行く] / [デート中]==38 / [デート中]==39】
	LOCALS = 食事をする
ELSEIF SELECTCOM == 320 && TEQUIP:2	; 【コマンド:[学食に行く] / [デート中]使用中】
	LOCALS = 外食をする
ENDIF

;浣腸使用前
SIF SELECTCOM == 46 && TEQUIP:46 == 0	; 【コマンド:[浣腸器＋プラグ] / 無[普通の浣腸]】
	LOCALS = 浣腸
;浣腸・触手浣腸使用後
SIF (SELECTCOM == 46 || SELECTCOM == 107) && TEQUIP:46	; 【コマンド:[浣腸器＋プラグ] / [普通の浣腸]使用中】
	LOCALS = 排泄

;コマンド名表示
PRINTFORMC %LOCALS%[{ARG:1,3}]



@USERCOM
;コマンド入力ミスフラグ初期化
TFLAG:54 = 0

A = 0
REPEAT 100
	SIF ITEM:(500 + COUNT)
		A = 1
REND

IF RESULT == 800
	CALL SHOW_EQUIP
	RETURN 1
ELSEIF RESULT == 801
	CALL STAIN_INFO
	RETURN 1
ELSEIF RESULT == 802
	LOCAL:50 = 1
	$TRAIN_STATUS_LOOP
	IF LOCAL:50 == 1
		W = TARGET
		DRAWLINE
		PRINTFORM ■ %NAME:TARGET%(パートナー)のステータス (PAGE 1/2) 
		SIF ((FLAG:23 & 1p26) == 0) && FLAG:2 != 1
			PRINTFORM (好感度:{CFLAG:2})
		PRINTL 
		CALL SHOW_BODY_SIZE
		DRAWLINE
		PRINTL □ 珠
		CALL NEW_PRINT_JUEL
		CALL SHOW_INFO_PAGE1
		PRINTL
		PRINTFORML [10] 次のページ（詳細記録・個人ログへ）
		PRINTFORML [0] 戻る
	ELSE
		CALL SHOW_CHARA_PAGE2, TARGET
		PRINTL
		PRINTFORML [10] 前のページ（基本ステータスへ）
		PRINTFORML [0] 戻る
	ENDIF
	$TRAIN_STATUS_INPUT
	INPUT
	IF RESULT == 10
		LOCAL:50 = (LOCAL:50 == 1) ? 2 # 1
		GOTO TRAIN_STATUS_LOOP
	ELSEIF RESULT == 0
		RETURN 1
	ELSE
		GOTO TRAIN_STATUS_INPUT
	ENDIF
ELSEIF RESULT == 810 && A
	;アイテム使用
	CALL USE_TREASURE_ITEM
ELSEIF RESULT == 850 && TFLAG:44 == 0 && TFLAG:34 == 0	; 【無[ウフフ中] / 無[主導権全委任]】
	IF FLAG:23 & 2
		PRINTFORML 服を脱がせて(Ｈな事をしようとして)もよろしいですか？
		PRINTFORML [0] ダメ。手が滑った
		PRINTFORML [1] ＯＫ。早く楽しませろ！

		INPUT
		IF (RESULT < 0 || RESULT > 1)
			RESTART
		ELSEIF RESULT == 0
			RETURN 1
		ENDIF
	ENDIF

	;[合意]持ちなら判定全スルー
	IF TALENT:152	; 【[合意]】
		TFLAG:44 = 1
		TFLAG:600 = 7
		CALL KOJO_JUN
		IF TFLAG:44 == 1	; 【[ウフフ中]==1】
			;映画館から追い出される
			CALL GET_OUT_MOVIE
			TRYCALLFORM CHAR_UNDRESS_{NO:TARGET}
			CALL AUTO_WEAR_FAVORITE_CLOTH
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	;実行判定
	ELSE
		A = 0
		S = 0
		V = 70
		W = 100
		;既にエンディングを迎えている場合は実行値スルー（周回プレイは2周目以降＝FLAG:26>1）
		SIF (FLAG:28 & 1) || FLAG:26 > 1 || FLAG:24 > 3 || TALENT:MASTER:202
			V = -9999

		;すべての命令に共通の要素を考慮
		;(従順が高いと命令に従いやすいなど)
		CALL COM_ORDER

		;ABL:欲望
		IF ABL:1	; 【[欲望]】
			A += ABL:1 * 4
		ENDIF
		;ABL:奉仕精神
		IF ABL:6	; 【[奉仕精神]】
			A += ABL:6 * 3
		ENDIF
		;男嫌い
		IF TALENT:82 && TALENT:PLAYER:122	; 【[男嫌い] / PLAYER:[オトコ]】
			A -= 7
		ENDIF


		;恋慕
		IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
			A += 10
		ENDIF

		;ムードボーナス
		B = 0
		IF TFLAG:37 < 10	; 【[ムード]<10】
			B -= 20
		ELSEIF TFLAG:37 < 30	; 【[ムード]<30】
			B -= 5
		ELSEIF TFLAG:37 < 50	; 【[ムード]<50】
			B -= 1
		ELSEIF TFLAG:37 < 100	; 【[ムード]<100】
			B += TFLAG:37 / 10
		ELSEIF TFLAG:37 < 300	; 【[ムード]<300】
			B += TFLAG:37 / 7
		ELSE
			B += TFLAG:37 / 5
		ENDIF
		A += B
		IF B < 0
			B = B * -1
		ELSE
		ENDIF


		;好感度
		IF CFLAG:2 < 700	; 【[好感度]<700】
			B = 0
			IF CFLAG:2 < 50	; 【[好感度]<50】
				B = 50
			ELSEIF CFLAG:2 < 300	; 【[好感度]<300】
				B = 20
			ELSEIF CFLAG:2 < 500	; 【[好感度]<500】
				B = 10
			ELSE
				B = 5
			ENDIF
			A -= B
		ENDIF

		;好感度
		IF CFLAG:2 >= 700	; 【[好感度]>=700】
			B = 0
			IF CFLAG:2 < 1000	; 【[好感度]<1000】
				B = 5
			ELSE
				B = CFLAG:2 / 100
			ENDIF
			A += B
		ENDIF
		;キス未経験
		IF TALENT:151	; 【[キス未経験]】
			A -= 20
		ENDIF

		;一線越えない
		IF TALENT:27 == 1	; 【[一線越えない]】
			A -= 15
		ENDIF

		;酔った勢い
		IF TFLAG:47 >= 3	; 【[酩酊度]>=3】
			A += TFLAG:47 / 3
		ENDIF

		IF ((FLAG:23 & 1p27) == 0) && FLAG:2 != 1
			;ABL:欲望
			IF ABL:1	; 【[欲望]】
				SIF S
					PRINT  + 
				PRINTS ABLNAME:1
				PRINTV 'LV,ABL:1,'(,ABL:1 * 4,')
				S = 1
			ENDIF
			;ABL:奉仕精神
			IF ABL:6	; 【[奉仕精神]】
				SIF S
					PRINT  + 
				PRINTS ABLNAME:6
				PRINTV 'LV,ABL:6,'(,ABL:6 * 3,')
				S = 1
			ENDIF
			;男嫌い
			IF TALENT:82 && TALENT:PLAYER:122	; 【[男嫌い] / PLAYER:[オトコ]】
				PRINT  - 
				PRINTS TALENTNAME:82
				PRINTV '(,7,')
				S = 1
			ENDIF


			;恋慕
			IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
				SIF S
					PRINT  + 
				PRINTS TALENTNAME:85
				PRINTV '(,10,')
				S = 1
			ENDIF

			;ムードボーナス
			B = 0
			IF TFLAG:37 < 10	; 【[ムード]<10】
				B -= 20
			ELSEIF TFLAG:37 < 30	; 【[ムード]<30】
				B -= 5
			ELSEIF TFLAG:37 < 50	; 【[ムード]<50】
				B -= 1
			ELSEIF TFLAG:37 < 100	; 【[ムード]<100】
				B += TFLAG:37 / 10
			ELSEIF TFLAG:37 < 300	; 【[ムード]<300】
				B += TFLAG:37 / 7
			ELSE
				B += TFLAG:37 / 5
			ENDIF
			IF B < 0
				B = B * -1
				PRINT  - 
				PRINT ムード悪い
				PRINTV '(,B,')
				S = 1
			ELSE
				PRINT  + 
				PRINT ムード良い
				PRINTV '(,B,')
				S = 1
			ENDIF


			;好感度
			IF CFLAG:2 < 700	; 【[好感度]<700】
				B = 0
				PRINT  - 
				IF CFLAG:2 < 50	; 【[好感度]<50】
					B = 50
				ELSEIF CFLAG:2 < 300	; 【[好感度]<300】
					B = 20
				ELSEIF CFLAG:2 < 500	; 【[好感度]<500】
					B = 10
				ELSE
					B = 5
				ENDIF
				PRINT 好感度不足
				PRINTV '(,B,')
				S = 1
			ENDIF

			;好感度
			IF CFLAG:2 >= 700	; 【[好感度]>=700】
				B = 0
				SIF S
					PRINT  + 
				IF CFLAG:2 < 1000	; 【[好感度]<1000】
					B = 5
				ELSE
					B = CFLAG:2 / 100
				ENDIF
				PRINT 好感度
				PRINTV '(,B,')
				S = 1
			ENDIF
			;キス未経験
			IF TALENT:151	; 【[キス未経験]】
				PRINT  - 
				PRINTS TALENTNAME:151
				PRINTV '(,20,')
				S = 1
			ENDIF

			;一線越えない
			IF TALENT:27	; 【[一線越えない]】
				PRINT  - 
				PRINTS TALENTNAME:27
				PRINTV '(,15,')
				S = 1
			ENDIF

			;酔った勢い
			IF TFLAG:47 >= 3	; 【[酩酊度]>=3】
				PRINT  + 
				PRINT 酔った勢い
				PRINTV '(,TFLAG:47 / 3,')
				S = 1
			ENDIF

			;合計を表示(70以上で実行、100以上で合意)
			PRINT  = 
			PRINTV A

			IF A < V
				PRINT  < 
				PRINT 実行値
				PRINTV V
			ELSEIF A == V
				PRINT  = 
				PRINT 実行値
				PRINTV V
			ELSEIF A > V && A < W
				PRINT  < 
				PRINT 合意値
				PRINTV W
