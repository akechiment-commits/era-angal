;-------------------------------------------------
;純愛口上用雛形
;このテンプレートはeratohoJ1.04+パッチまとめ4.06用の口上テンプレートです
;eratohoJ系列以外のバリアントはもちろんの事、口上用にパッチまとめのバージョンアップを行ったので、
;古いパッチまとめだと正しく口上が表示されない可能性があります
;パッチまとめを入れていないeratohoJ1.04なら多分問題ないです
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;9、09をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合は9は一桁で置換（例:1）し、
;09は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------

;--------------------------------------------------
;地の文カット解除
;--------------------------------------------------
@EVENT_NEXTDAY_K9
CFLAG:99 = 0

;--------------------------------------------------
;口上ファイルの存在判定（09をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:109 = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
FLAG:109 = 0
;--------------------------------------------------
;純愛イベント口上
;--------------------------------------------------
@KOJO_JUN_K9
CALL SET_CALLNAME_K9

;--------------------------------------------------
;特定主人時に特殊口上を呼び出す(Y1を特定主人、9をパートナーのキャラ番号に置換）
;--------------------------------------------------
IF NO:MASTER == 10
	CALL LES_JUN_K09_M10
	RETURN 0
ENDIF

;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;-------------------------------------------------;
IF TFLAG:600 == 0 && NO:MASTER != 10
	PRINTFORML  ＜%NAME:TARGET%の口上設定＞
	CALL CALL_NAME_FANCTION_K9
	PRINTL 処女モードに移行しますか？ 
	PRINTL [0] 咲夜さんの処女は俺が奪う
	PRINTL [1] 咲夜さんの初めてじゃなくても一向に構わん
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―処女モードに素質、能力を変更します―
		TALENT:TARGET:0 = 1
		ABL:TARGET:4 = 0
		EXP:TARGET:0 = 0
	ELSEIF RESULT == 1
		PRINTFORMW ―通常モードで調教を開始します―
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:220 = 1
ENDIF

