;=== ふたなりペニスサイズの地の文ヘルパー（CFLAG:1100=0.1cm／4段階・標準は空）===
;ペニスの形容
@PENIS_DESC(C)
#FUNCTIONS
;短小(～8cm)
IF CFLAG:C:1100 > 0 && CFLAG:C:1100 < 80
	SELECTCASE RAND:4
	CASE 0
		RETURNF "ささやかな"
	CASE 1
		RETURNF "可愛らしい"
	CASE 2
		RETURNF "控えめな"
	CASEELSE
		RETURNF "こぢんまりとした"
	ENDSELECT
;巨根(16～25cm)
ELSEIF CFLAG:C:1100 >= 160 && CFLAG:C:1100 < 250
	SELECTCASE RAND:4
	CASE 0
		RETURNF "逞しい"
	CASE 1
		RETURNF "雄々しい"
	CASE 2
		RETURNF "大ぶりな"
	CASEELSE
		RETURNF "見事な"
	ENDSELECT
;極大(25cm～)
ELSEIF CFLAG:C:1100 >= 250
	SELECTCASE RAND:4
	CASE 0
		RETURNF "凶悪なほど巨大な"
	CASE 1
		RETURNF "馬鹿げて巨大な"
	CASE 2
		RETURNF "圧倒的な質量の"
	CASEELSE
		RETURNF "化け物じみた"
	ENDSELECT
ENDIF
;標準(8～16cm)・未設定は形容なし
RETURNF ""
;射精量の形容（ペニスサイズ連動）
@SEMEN_DESC(C)
#FUNCTIONS
IF CFLAG:C:1100 > 0 && CFLAG:C:1100 < 80
	SELECTCASE RAND:3
	CASE 0
		RETURNF "少量の"
	CASE 1
		RETURNF "わずかな"
	CASEELSE
		RETURNF "ささやかな量の"
	ENDSELECT
ELSEIF CFLAG:C:1100 >= 160 && CFLAG:C:1100 < 250
	SELECTCASE RAND:3
	CASE 0
		RETURNF "大量の"
	CASE 1
		RETURNF "たっぷりの"
	CASEELSE
		RETURNF "多量の"
	ENDSELECT
ELSEIF CFLAG:C:1100 >= 250
	SELECTCASE RAND:3
	CASE 0
		RETURNF "おびただしい量の"
	CASE 1
		RETURNF "信じられないほど大量の"
	CASEELSE
		RETURNF "浴びせるほど大量の"
	ENDSELECT
ENDIF
RETURNF ""

