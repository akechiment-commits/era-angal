	PRINTL おや？心なしか彼女には不思議な根のようなものが…
	PRINTL [0] ない！
	PRINTL [1] あるある！
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―不思議な根を「なし」に変更します―
		TALENT:TARGET:120 = 0
	ELSEIF RESULT == 1
		PRINTFORMW ―通常モードで調教を開始します―
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:220 = 1
ENDIF
