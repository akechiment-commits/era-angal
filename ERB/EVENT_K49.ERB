;----------------------------------------------------------------
;中出しした/された人チェッカー　CFLAG:820
;ただしON/OFFしかない
;----------------------------------------------------------------
;○使い方
;2,4,8で誰が射精したかを見て、16,32,64で誰が精液を受けているかを見る
;どちらかをセットしただけだと精液が異次元から出てきたり異次元へ消えたりするので注意
;基本セットは(2||4||8)&&(16||32||64)とか
;応用セットは&42とか
;42は2+8+32なので「あなたが中出し」かつ「助手が中出し」かつ「パートナーが中出しされた」
;つまり「あなたと助手がパートナーに中出しした」状態を見ることができる……はず
;明日の自分は割りと馬鹿。だからここまで細かく書く
;できればコンドームも見たいんだけどね
;
;0:チェッカーがOFF
;1:チェッカーがON
;2:あなたが中出し
;4:パートナーが中出し
;8:助手が中出し
;16:あなたが中出しされた
;32:パートナーが中出しされた
;64:助手が中出しされた
;
;CFLAG:101　マスター→パートナーor助手への中出し。CFLAG:ASSI:101　CFLAG:TARGET:101
;CFLAG:102　助手→パートナーorマスターへの中出し。CFLAG:TARGET:102 CFLAG:PLAYER:102
;CFLAG:103　パートナー→マスターor助手への中出し。CFLAG:PLAYER:103 CFLAG:ASSI:103
;CFLAG:107　誰がコンドームに射精したか(ビット)　1:主人　2:助手　4:パートナー
;19:56:56 (Sagi) targetに膣射されてるか、妊娠関係で拾ってるだろうからそれ見るの
;19:57:28 (Sagi) コンドーム精飲の実行判定見ればいいんじゃないのｋ
;
@K49_NAKADASHI_SHITA_SARETA_CHECKER
;まず助手の有無を見て
;いたら全部
;	CFLAG:TARGET:101 || CFLAG:ASSI:101 || CFLAG:TARGET:102 || CFLAG:MASTER:102 || CFLAG:MASTER:103 || CFLAG:ASSI:103
IF ASSI > 0
	;あなたがパートナーに出した場合2+32=34
	SIF CFLAG:TARGET:101
		CFLAG:820 |= (2+32)
	;あなたが助手に出した場合2+64=66
	SIF CFLAG:ASSI:101
		CFLAG:820 |= (2+64)
	;パートナーがあなたに出した場合4+16=20
	SIF CFLAG:PLAYER:103
		CFLAG:820 |= (4+16)
	;パートナーが助手に出した場合4+64=68
	SIF CFLAG:ASSI:103
		CFLAG:820 |= (4+64)
	;助手があなたに出した場合8+16=24
	SIF CFLAG:PLAYER:102
		CFLAG:820 |= (8+16)
	;助手がパートナーに出した場合8+32=40
	SIF CFLAG:TARGET:102
		CFLAG:820 |= (8+32)
	;拾えなければ0を返す
	RETURN 0

;いなかったら助手絡みを弾く
;何このすっきりっぷり
ELSE
	;あなたがパートナーに出した場合2+32=34
	SIF CFLAG:TARGET:101
		CFLAG:820 |= (2+32)
	;パートナーがあなたに出した場合4+16=20
	SIF CFLAG:PLAYER:103
		CFLAG:820 |= (4+16)
	;拾えなければ0を返す
	RETURN 0
ENDIF


