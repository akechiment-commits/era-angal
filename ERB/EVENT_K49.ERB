;このテンプレートはeratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;但し、中身の記載が無い項目も多いので、使用する前にPLANE_TEXT.ERBを見て確認する事を強く推奨します
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------

;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:149 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:149 = 0

;--------------------------------------------------
;エキストラモード構文関数　CFLAG:220を使用
;初調教時に口上設定用の素質に変更したり、オプションの有無を選択させたり出来ます。
;下記に処女化する場合の構文をサンプルとして載せておきます
;また、キャラ固有デート先を追加するかを選択させる構文も追加(使わない場合は削除or放置してください)
;複数選択させる際は$XXXが被らない様に注意してください。GOTO XX → $XXへと処理が飛びます
;IF文内でGOTOを実行するとエラーになるので注意(eramakerのみのバグ)
;又、0以下の数値と比較させた際に正常に動かない可能性があるので要注意
;--------------------------------------------------
@EXTRA_MODE_K49
$INPUT_LOOP
PRINTL 蓮子ちゃんは処女ですか？
PRINTL [0] 無論です(口上側推奨)
PRINTL [1] もうメリーに
SIF CFLAG:800 == 0
	PRINTL [2] 実はふたなりだよ
SIF CFLAG:800 == 1
	PRINTL [2] いやだから実はふたなりなんだよ
INPUT
IF RESULT == 0
	PRINTFORMW ―処女モードに素質、能力を変更します―
	TALENT:0 = 1
	ABL:4 = 0
	EXP:0 = 0
	CFLAG:900 = 1
ELSEIF RESULT == 1
	PRINTFORMW ―通常モードでストーリーを開始します―
ELSEIF RESULT == 2
	IF CFLAG:800 == 0
		PRINTFORMW ―えっ？―
		CFLAG:800 = 1
	ELSEIF CFLAG:800 == 1
		PRINTFORMW ―そうだったんですか―
		CFLAG:800 = 2
		TALENT:121 = 1
		TALENT:27 = 1
	ELSE
		PRINTFORMW ―落ち着いてください―
	ENDIF
	PRINTFORMW ―とりあえず選択肢に戻ります―
	GOTO INPUT_LOOP
ELSE
	GOTO INPUT_LOOP
ENDIF

PRINTL 
PRINTL キャラ固有デート先を追加しますか？
PRINTL [0] いいえ
PRINTL [1] はい(幻想郷のみ)
PRINTL [2] はい(外界のみ)
PRINTL [3] はい(両方)
$INPUT_LOOP2
INPUT
SIF RESULT > 3 || (RESULT+1) < 1
	GOTO INPUT_LOOP2
IF RESULT >= 1 && RESULT <= 3
	CFLAG:782 = RESULT
	SIF RESULT == 1
		PRINTFORMW ―固有デート場所(幻想郷)を追加しました―
	SIF RESULT == 2
		PRINTFORMW ―固有デート場所(外界)を追加しました―
	SIF RESULT == 3
		PRINTFORMW ―固有デート場所(幻想郷、外界)を追加しました―
ENDIF
CFLAG:220 |= 1

