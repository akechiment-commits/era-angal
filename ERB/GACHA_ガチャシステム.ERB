;==================================================
; GACHA_ガチャシステム.ERB
;
; 通貨(FLAG):
;   FLAG:112 = キミサキダイヤ
;   FLAG:113 = ブロンズガチャチケット
;   FLAG:114 = シルバーガチャチケット
;   FLAG:115 = ゴールドガチャチケット
;   FLAG:116 = プラチナガチャチケット
;
; カード所持(GLOBAL):
;   GLOBAL:(3000+card_id) = 所持数（0=未所持）
;
; キャラ補正(CFLAG):
;   CFLAG:N:303 = 表現力ボーナス累計
;   CFLAG:N:304 = 運動力ボーナス累計
;   CFLAG:N:305 = 学力ボーナス累計
;   CFLAG:N:306 = 好感度ボーナス累計
;   CFLAG:N:307 = 所持カード枚数
;==================================================

;--------------------------------------------------
; ガチャメインメニュー
;--------------------------------------------------
@GACHA_MAIN
$LOOP
DRAWLINE
PRINTL 【ガチャ】
PRINTL
PRINTFORML キミサキダイヤ：{FLAG:112}個
PRINTFORML ブロンズチケット：{FLAG:113}枚
PRINTFORML シルバーチケット：{FLAG:114}枚
PRINTFORML ゴールドチケット：{FLAG:115}枚
PRINTFORML プラチナチケット：{FLAG:116}枚
PRINTL
PRINTFORML [1] ブロンズガチャ（チケット1枚）N/R/SR
PRINTFORML [2] シルバーガチャ（チケット1枚）R/SR/SSR
PRINTFORML [3] ゴールドガチャ（チケット1枚）SR/SSR/UR
PRINTFORML [4] プラチナガチャ（チケット1枚）SSR/UR
PRINTFORML [5] ダイヤガチャ（ダイヤ5個）SR/SSR/UR
PRINTL
PRINTFORML [0] 戻る
INPUT
SELECTCASE RESULT
CASE 1
	IF FLAG:113 < 1
		PRINTFORMW ブロンズチケットがありません。
	ELSE
		FLAG:113 -= 1
		CALL GACHA_PULL, 1
	ENDIF
CASE 2
	IF FLAG:114 < 1
		PRINTFORMW シルバーチケットがありません。
	ELSE
		FLAG:114 -= 1
		CALL GACHA_PULL, 2
	ENDIF
CASE 3
	IF FLAG:115 < 1
		PRINTFORMW ゴールドチケットがありません。
	ELSE
		FLAG:115 -= 1
		CALL GACHA_PULL, 3
	ENDIF
CASE 4
	IF FLAG:116 < 1
		PRINTFORMW プラチナチケットがありません。
	ELSE
		FLAG:116 -= 1
		CALL GACHA_PULL, 4
	ENDIF
CASE 5
	IF FLAG:112 < 5
		PRINTFORMW キミサキダイヤが5個必要です（現在{FLAG:112}個）。
	ELSE
		FLAG:112 -= 5
		CALL GACHA_PULL, 5
	ENDIF
CASEELSE
	RETURN 0
ENDSELECT
GOTO LOOP

;--------------------------------------------------
; ガチャ1回実行 ARG:0=ガチャ種別(1-5)
; RESULT = 引いたカードID
;--------------------------------------------------
@GACHA_PULL
;レア度決定
LOCAL:9 = RAND:100
LOCAL:8 = 0  ;レア度(1=N 2=R 3=SR 4=SSR 5=UR)

SELECTCASE ARG:0
CASE 1  ;ブロンズ: N60% R35% SR5%
	IF LOCAL:9 < 60
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 95
		LOCAL:8 = 2
	ELSE
		LOCAL:8 = 3
	ENDIF
CASE 2  ;シルバー: R50% SR40% SSR10%
	IF LOCAL:9 < 50
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 90
		LOCAL:8 = 3
	ELSE
		LOCAL:8 = 4
	ENDIF
CASE 3  ;ゴールド: SR40% SSR45% UR15%
	IF LOCAL:9 < 40
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 85
		LOCAL:8 = 4
	ELSE
		LOCAL:8 = 5
	ENDIF
CASE 4  ;プラチナ: SSR55% UR45%
	IF LOCAL:9 < 55
		LOCAL:8 = 4
	ELSE
		LOCAL:8 = 5
	ENDIF
CASEELSE  ;ダイヤ: R30% SR45% SSR22% UR3%
	IF LOCAL:9 < 30
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 75
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 97
		LOCAL:8 = 4
	ELSE
		LOCAL:8 = 5
	ENDIF
ENDSELECT

;パートナーのカードプールから選択（TARGET設定済みを優先）
LOCAL:7 = 0
IF TARGET >= 0
	CALL CARD_GET_CHARPOOL, TARGET, LOCAL:8
	IF LOCAL:9 > 0
		LOCAL:6 = RAND:LOCAL:9
		LOCAL:7 = LOCAL:LOCAL:6
	ENDIF
ENDIF

;パートナーにカードがない場合は全キャラから選択
IF LOCAL:7 <= 0
	CALL CARD_GET_CHARPOOL, 0, LOCAL:8
	IF LOCAL:9 > 0
		LOCAL:6 = RAND:LOCAL:9
		LOCAL:7 = LOCAL:LOCAL:6
	ENDIF
ENDIF

;それでもなければレア度を下げて再試行
IF LOCAL:7 <= 0
	SIF LOCAL:8 > 1
		LOCAL:8 -= 1
	CALL CARD_GET_CHARPOOL, 0, LOCAL:8
	IF LOCAL:9 > 0
		LOCAL:6 = RAND:LOCAL:9
		LOCAL:7 = LOCAL:LOCAL:6
	ENDIF
ENDIF

IF LOCAL:7 <= 0
	PRINTFORMW カードデータがまだ登録されていません。
	RETURN 0
ENDIF

;カード取得処理
CALL GACHA_ACQUIRE_CARD, LOCAL:7
RETURN LOCAL:7

;--------------------------------------------------
; カード取得 ARG:0=カードID
;--------------------------------------------------
@GACHA_ACQUIRE_CARD
LOCAL:10 = ARG:0  ;カードIDを保存
CALL CARD_GET_DATA, LOCAL:10
LOCAL:0 = RESULT:0  ;キャラNo
LOCAL:1 = RESULT:1  ;レア度
LOCAL:2 = RESULT:2  ;ボーナスタイプ
LOCAL:3 = RESULT:3  ;ボーナス値

;レア度演出
DRAWLINE
IF LOCAL:1 == 5
	PRINTL ★★★★★ UR ！！！！！
ELSEIF LOCAL:1 == 4
	PRINTL ★★★★ SSR ！！！
ELSEIF LOCAL:1 == 3
	PRINTL ★★★ SR ！
ELSEIF LOCAL:1 == 2
	PRINTL ★★ R
ELSE
	PRINTL ★ N
ENDIF

;カード名表示
PRINTFORML 【%CSVNAME:LOCAL:10%】
IF LOCAL:0 > 0
	TARGET = LOCAL:0
	PRINTFORML キャラ: %CALLNAME:TARGET%
ENDIF

;初回取得/重複チェック
LOCAL:5 = 3000 + LOCAL:10
LOCAL:6 = GLOBAL:LOCAL:5
IF LOCAL:6 == 0
	PRINTL ★ NEW！
ELSE
	PRINTL （重複）
ENDIF
GLOBAL:LOCAL:5 += 1

;キャラボーナス適用（初回取得時のみ）
IF LOCAL:6 == 0 && LOCAL:0 > 0
	TARGET = LOCAL:0
	SELECTCASE LOCAL:2
	CASE 0
		CFLAG:TARGET:303 += LOCAL:3
		PRINTFORML %CALLNAME:TARGET%の表現力 +{LOCAL:3}！
	CASE 1
		CFLAG:TARGET:304 += LOCAL:3
		PRINTFORML %CALLNAME:TARGET%の運動力 +{LOCAL:3}！
	CASE 2
		CFLAG:TARGET:305 += LOCAL:3
		PRINTFORML %CALLNAME:TARGET%の学力 +{LOCAL:3}！
	CASEELSE
		CFLAG:TARGET:306 += LOCAL:3
		PRINTFORML %CALLNAME:TARGET%の好感度 +{LOCAL:3}！
	ENDSELECT
	CFLAG:TARGET:307 += 1
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; カード補正値取得 ARG:0=キャラNo ARG:1=補正タイプ
; RESULT = 補正値
;--------------------------------------------------
@CARD_GET_BONUS
TARGET = ARG:0
SELECTCASE ARG:1
CASE 0
	RETURN CFLAG:TARGET:303
CASE 1
	RETURN CFLAG:TARGET:304
CASE 2
	RETURN CFLAG:TARGET:305
CASEELSE
	RETURN CFLAG:TARGET:306
ENDSELECT
