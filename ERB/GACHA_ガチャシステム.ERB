;==================================================
; GACHA_ガチャシステム.ERB
;
; 通貨(FLAG):
;   FLAG:112 = キミサキダイヤ
;   FLAG:113 = ブロンズガチャチケット
;   FLAG:114 = シルバーガチャチケット
;   FLAG:115 = ゴールドガチャチケット
;   FLAG:116 = プラチナガチャチケット
;
; カード所持(GLOBAL):
;   GLOBAL:(3000+card_id) = 所持枚数
;
; キャラ補正(CFLAG):
;   CFLAG:N:303 = 表現力ボーナス累計
;   CFLAG:N:304 = 運動力ボーナス累計
;   CFLAG:N:305 = 学力ボーナス累計
;   CFLAG:N:306 = 好感度ボーナス累計
;   CFLAG:N:307 = 所持カード枚数
;
; 排出率 (RAND:10000):
;   ブロンズ: N85% R10% HR3.89% SR1% UR0.1% MR0.01%
;   シルバー: N30% R41.45% HR22% SR6% UR0.5% MR0.05%
;   ゴールド: R50% HR20% SR27.5% UR2% MR0.5%
;   プラチナ: SR87% UR10% MR3%
;   ダイヤ:   R20% HR20% SR34% UR20% MR6%
;==================================================

@GACHA_MAIN
$LOOP
DRAWLINE
PRINTL 【ガチャ】
PRINTL
PRINTFORML キミサキダイヤ：{FLAG:112}個
PRINTFORML ブロンズチケット：{FLAG:113}枚  （MR 0.01\%　N85\%）
PRINTFORML シルバーチケット：{FLAG:114}枚  （MR 0.05\%　N30\% R41\% UR0.5\%）
PRINTFORML ゴールドチケット：{FLAG:115}枚  （MR 0.5\%　R50\% UR2\%）
PRINTFORML プラチナチケット：{FLAG:116}枚  （MR 3\%　SR87\% UR10\% SR確定）
PRINTL
PRINTFORML [1] ブロンズガチャ（1枚）　[11] 10連（10枚）
PRINTFORML [2] シルバーガチャ（1枚）　[12] 10連（10枚）
PRINTFORML [3] ゴールドガチャ（1枚）　[13] 10連（10枚）
PRINTFORML [4] プラチナガチャ（1枚）　[14] 10連（10枚）
PRINTFORML [5] ダイヤガチャ（ダイヤ5個）   （MR 6\%　R20\% HR20\% UR20\%）　[15] 10連（50個）
PRINTL
PRINTFORML [6] チケット・ダイヤ購入
PRINTL
PRINTFORML [0] 戻る
INPUT
SELECTCASE RESULT
CASE 1
	IF FLAG:113 < 1
		PRINTFORMW ブロンズチケットがありません。
	ELSE
		FLAG:113 -= 1
		CALL GACHA_PULL, 1
	ENDIF
CASE 2
	IF FLAG:114 < 1
		PRINTFORMW シルバーチケットがありません。
	ELSE
		FLAG:114 -= 1
		CALL GACHA_PULL, 2
	ENDIF
CASE 3
	IF FLAG:115 < 1
		PRINTFORMW ゴールドチケットがありません。
	ELSE
		FLAG:115 -= 1
		CALL GACHA_PULL, 3
	ENDIF
CASE 4
	IF FLAG:116 < 1
		PRINTFORMW プラチナチケットがありません。
	ELSE
		FLAG:116 -= 1
		CALL GACHA_PULL, 4
	ENDIF
CASE 5
	IF FLAG:112 < 5
		PRINTFORMW キミサキダイヤが5個必要です（現在{FLAG:112}個）。
	ELSE
		FLAG:112 -= 5
		CALL GACHA_PULL, 5
	ENDIF
CASE 6
	CALL GACHA_TICKET_SHOP
CASE 11
	IF FLAG:113 < 10
		PRINTFORMW ブロンズチケットが10枚必要です（現在{FLAG:113}枚）。
	ELSE
		FLAG:113 -= 10
		CALL GACHA_PULL_10, 1
	ENDIF
CASE 12
	IF FLAG:114 < 10
		PRINTFORMW シルバーチケットが10枚必要です（現在{FLAG:114}枚）。
	ELSE
		FLAG:114 -= 10
		CALL GACHA_PULL_10, 2
	ENDIF
CASE 13
	IF FLAG:115 < 10
		PRINTFORMW ゴールドチケットが10枚必要です（現在{FLAG:115}枚）。
	ELSE
		FLAG:115 -= 10
		CALL GACHA_PULL_10, 3
	ENDIF
CASE 14
	IF FLAG:116 < 10
		PRINTFORMW プラチナチケットが10枚必要です（現在{FLAG:116}枚）。
	ELSE
		FLAG:116 -= 10
		CALL GACHA_PULL_10, 4
	ENDIF
CASE 15
	IF FLAG:112 < 50
		PRINTFORMW キミサキダイヤが50個必要です（現在{FLAG:112}個）。
	ELSE
		FLAG:112 -= 50
		CALL GACHA_PULL_10, 5
	ENDIF
CASEELSE
	RETURN 0
ENDSELECT
GOTO LOOP

;--------------------------------------------------
; ガチャ1回実行 ARG:0=ガチャ種別(1-5)
; 手順: レア度決定 → キャラ等確率選択 → カード選択
;--------------------------------------------------
@GACHA_PULL(ARG)
LOCAL:9 = RAND:10000  ;0～9999
LOCAL:8 = 0           ;レア度(1=N 2=R 3=HR 4=SR 5=UR 6=MR)

SELECTCASE ARG:0
CASE 1
	;ブロンズ: N85% R10% HR3.89% SR1% UR0.1% MR0.01%
	IF LOCAL:9 < 8500
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 9500
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 9889
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 9989
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9999
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 2
	;シルバー: N30% R41.45% HR22% SR6% UR0.5% MR0.05%
	IF LOCAL:9 < 3000
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 7145
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 9345
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 9945
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9995
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 3
	;ゴールド: R50% HR20% SR27.5% UR2% MR0.5%
	IF LOCAL:9 < 5000
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 7000
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 9750
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9950
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 4
	;プラチナ: SR87% UR10% MR3%
	IF LOCAL:9 < 8700
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9700
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASEELSE
	;ダイヤ: R20% HR20% SR34% UR20% MR6%
	IF LOCAL:9 < 2000
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 4000
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 7400
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9400
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
ENDSELECT

;そのレア度を持つキャラ一覧を取得 (GLOBAL:2000=件数 GLOBAL:2001..=キャラNo)
$RETRY_RARITY
CALL CARD_GET_CHARS_FOR_RARITY, LOCAL:8
IF GLOBAL:2000 == 0
	LOCAL:8 -= 1
	IF LOCAL:8 >= 1
		GOTO RETRY_RARITY
	ELSE
		PRINTFORMW カードデータが見つかりません。
		RETURN 0
	ENDIF
ENDIF

;キャラを等確率で選択
A = GLOBAL:2000
LOCAL:6 = RAND:A
LOCAL:3 = 2001 + LOCAL:6
A = LOCAL:3
LOCAL:5 = GLOBAL:A

;そのキャラのそのレア度のカードを取得 (GLOBAL:2100=件数 GLOBAL:2101..=カードID)
CALL CARD_GET_CHARPOOL, LOCAL:5, LOCAL:8
IF GLOBAL:2100 == 0
	;このキャラにそのレア度がない（MRなど）→レア度下げて再選
	LOCAL:8 -= 1
	IF LOCAL:8 >= 1
		GOTO RETRY_RARITY
	ELSE
		PRINTFORMW カードが見つかりません。
		RETURN 0
	ENDIF
ENDIF

A = GLOBAL:2100
LOCAL:4 = RAND:A
LOCAL:3 = 2101 + LOCAL:4
A = LOCAL:3
LOCAL:7 = GLOBAL:A

CALL GACHA_ACQUIRE_CARD, LOCAL:7
RETURN LOCAL:7

;--------------------------------------------------
; カード取得処理 ARG:0=カードID
; 重複: 1枚目100%/2枚目50%/3枚目以降20%のボーナス
;--------------------------------------------------

;--------------------------------------------------
; @GACHA_PICKUP_FIND_CARD ARG:0=レア度 → RESULT=カードID（0=なし）
; ピックアッププール(GLOBAL:2200+)から指定レア度のカードをランダム選択
;--------------------------------------------------
@GACHA_PICKUP_FIND_CARD(ARG)
LOCAL:5 = 0
A = GLOBAL:2199
FOR LOCAL:4, 0, A
	B = 2200 + LOCAL:4
	LOCAL:7 = GLOBAL:B
	CALL CARD_GET_DATA, LOCAL:7
	IF RESULT:2 == ARG:0
		LOCAL:5 += 1
	ENDIF
NEXT
IF LOCAL:5 == 0
	RETURN 0
ENDIF
B = LOCAL:5
LOCAL:6 = RAND:B
LOCAL:5 = 0
A = GLOBAL:2199
FOR LOCAL:4, 0, A
	B = 2200 + LOCAL:4
	LOCAL:7 = GLOBAL:B
	CALL CARD_GET_DATA, LOCAL:7
	IF RESULT:2 == ARG:0
		IF LOCAL:5 == LOCAL:6
			RETURN LOCAL:7
		ENDIF
		LOCAL:5 += 1
	ENDIF
NEXT
RETURN 0

;--------------------------------------------------
; ピックアップガチャ1回 ARG:0=ガチャ種別(1-5)
; 通常と同じレア度テーブルで決定→同レア度ピックアップカードを25%優先
;--------------------------------------------------
@GACHA_PULL_PICKUP(ARG)
LOCAL:9 = RAND:10000
SELECTCASE ARG:0
CASE 1	;ブロンズ: N85% R10% HR3.89% SR1% UR0.1% MR0.01%
	IF LOCAL:9 < 8500
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 9500
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 9889
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 9989
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9999
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 2	;シルバー: N30% R41.45% HR22% SR6% UR0.5% MR0.05%
	IF LOCAL:9 < 3000
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 7145
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 9345
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 9945
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9995
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 3	;ゴールド: R50% HR20% SR27.5% UR2% MR0.5%
	IF LOCAL:9 < 5000
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 7000
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 9750
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9950
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 4	;プラチナ: SR87% UR10% MR3%
	IF LOCAL:9 < 8700
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9700
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASEELSE	;ダイヤ: R20% HR20% SR34% UR20% MR6%
	IF LOCAL:9 < 2000
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 4000
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 7400
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 9400
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
ENDSELECT

;25%でピックアップ試行（同レア度のカードを優先選択）
IF GLOBAL:2199 > 0
	SIF RAND:4 != 0
		GOTO PU_NORMAL
	CALL GACHA_PICKUP_FIND_CARD, LOCAL:8
	SIF RESULT == 0
		GOTO PU_NORMAL
	LOCAL:7 = RESULT
	GLOBAL:2198 = 1
	CALL GACHA_ACQUIRE_CARD, LOCAL:7
	RETURN LOCAL:7
ENDIF

;通常プール（LOCAL:8のレア度で）
$PU_NORMAL
$RETRY_PU_RARITY
CALL CARD_GET_CHARS_FOR_RARITY, LOCAL:8
IF GLOBAL:2000 == 0
	LOCAL:8 -= 1
	SIF LOCAL:8 >= 1
		GOTO RETRY_PU_RARITY
	RETURN 0
ENDIF
A = GLOBAL:2000
LOCAL:6 = RAND:A
LOCAL:3 = 2001 + LOCAL:6
A = LOCAL:3
LOCAL:5 = GLOBAL:A
CALL CARD_GET_CHARPOOL, LOCAL:5, LOCAL:8
SIF GLOBAL:2100 == 0
	GOTO RETRY_PU_RARITY
A = GLOBAL:2100
LOCAL:4 = RAND:A
LOCAL:3 = 2101 + LOCAL:4
A = LOCAL:3
LOCAL:7 = GLOBAL:A
CALL GACHA_ACQUIRE_CARD, LOCAL:7
RETURN LOCAL:7
@GACHA_ACQUIRE_CARD(ARG)
LOCAL:8 = TARGET    ;元のTARGETを保存
LOCAL:10 = ARG:0
CALL CARD_GET_DATA, LOCAL:10
LOCAL:0 = RESULT:1  ;キャラNo
LOCAL:1 = RESULT:2  ;レア度
LOCAL:2 = RESULT:3  ;ボーナスタイプ
LOCAL:3 = RESULT:4  ;基本ボーナス値

;未登録キャラなら追加（通知はボーナス後に表示）
LOCAL:12 = 0  ;新キャラフラグ
IF LOCAL:0 > 0
	LOCAL:11 = GETCHARA(LOCAL:0)
	IF LOCAL:11 < 0
		ADDCHARA LOCAL:0
		LOCAL:11 = CHARANUM - 1
		LOCAL:12 = 1
		;新キャラの初期技能値を素質ベースで設定
		A = LOCAL:11
		ABL:A:93 = ABL:A:54 / 10
		ABL:A:94 = ABL:A:55 / 10
		ABL:A:95 = ABL:A:56 / 10
		CALL CALC_ACADEMIC_LEVEL, A
	ENDIF
	TARGET = LOCAL:11
ENDIF

DRAWLINE
IF GLOBAL:2198 == 1
	PRINTL 　[ピックアップ！]
	GLOBAL:2198 = 0
ENDIF
IF LOCAL:1 == 6
	PRINTL ★★★★★★ MR ！！！！！！
ELSEIF LOCAL:1 == 5
	PRINTL ★★★★★ UR ！！！！！
ELSEIF LOCAL:1 == 4
	PRINTL ★★★★ SR ！！！
ELSEIF LOCAL:1 == 3
	PRINTL ★★★ HR ！
ELSEIF LOCAL:1 == 2
	PRINTL ★★ R
ELSE
	PRINTL ★ N
ENDIF

IF STR:0 != ""
	PRINTFORML 【%STR:0%】
ELSEIF LOCAL:0 > 0
	PRINTFORML 【%CALLNAME:TARGET%のカード（ID:{LOCAL:10}）】
ELSE
	PRINTFORML 【カードID:{LOCAL:10}】
ENDIF

LOCAL:5 = 3000 + LOCAL:10
A = LOCAL:5
LOCAL:6 = FLAG:A

LOCAL:4 = LOCAL:3
IF LOCAL:6 == 0
	PRINTL ★ NEW！（初回ボーナス全額）
ELSE
	;base×rate×枚数の差分（N=1/20, R/HR=1/10, SR=1/5, UR=1/4, MR=1/2）
	SELECTCASE LOCAL:1
	CASE 6
		LOCAL:4 = (LOCAL:6 + 1) * LOCAL:3 / 2 - LOCAL:6 * LOCAL:3 / 2
	CASE 5
		LOCAL:4 = (LOCAL:6 + 1) * LOCAL:3 / 4 - LOCAL:6 * LOCAL:3 / 4
	CASE 4
		LOCAL:4 = (LOCAL:6 + 1) * LOCAL:3 / 5 - LOCAL:6 * LOCAL:3 / 5
	CASE 1
		LOCAL:4 = (LOCAL:6 + 1) * LOCAL:3 / 20 - LOCAL:6 * LOCAL:3 / 20
	CASEELSE
		LOCAL:4 = (LOCAL:6 + 1) * LOCAL:3 / 10 - LOCAL:6 * LOCAL:3 / 10
	ENDSELECT
	PRINTFORML （重複 {LOCAL:6+1}枚目 → ボーナス+{LOCAL:4}）
ENDIF

;キラカードチェック（12枚目）
LOCAL:13 = 0
IF LOCAL:6 == 11
	LOCAL:4 += LOCAL:3 * 3
	LOCAL:13 = 1
ENDIF

A = LOCAL:5
FLAG:A += 1

IF LOCAL:0 > 0
	SELECTCASE LOCAL:2
	CASE 0
		CFLAG:TARGET:303 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の表現力 +{LOCAL:4}！（累計+{CFLAG:TARGET:303}）
	CASE 1
		CFLAG:TARGET:304 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の運動力 +{LOCAL:4}！（累計+{CFLAG:TARGET:304}）
	CASE 2
		CFLAG:TARGET:305 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の学力 +{LOCAL:4}！（累計+{CFLAG:TARGET:305}）
	CASEELSE
		CFLAG:TARGET:306 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の好感度 +{LOCAL:4}！（累計+{CFLAG:TARGET:306}）
	ENDSELECT
	CFLAG:TARGET:307 += 1
ENDIF
SIF LOCAL:12 == 1
	PRINTL ★ 新キャラクター登場！パートナーに選べるようになりました。
IF LOCAL:13 == 1
	PRINTL 
	PRINTL ★★★ キラカード化！！！ ★★★
	PRINTFORML このカードが【キラ】になりました！ボーナス大幅アップ！
ENDIF
TARGET = LOCAL:8    ;TARGETを元のパートナーに戻す
SIF FLAG:120 == 0
	WAIT
RETURN 1

;--------------------------------------------------
; カード補正値取得 ARG:0=キャラNo ARG:1=補正タイプ
;--------------------------------------------------
@CARD_GET_BONUS(ARG, ARG:1)
TARGET = ARG:0
SELECTCASE ARG:1
CASE 0
	RETURN CFLAG:TARGET:303
CASE 1
	RETURN CFLAG:TARGET:304
CASE 2
	RETURN CFLAG:TARGET:305
CASEELSE
	RETURN CFLAG:TARGET:306
ENDSELECT

;--------------------------------------------------
; 10連ガチャ ARG:0=ガチャ種別(1-5)
; FLAG:120=1 で各結果のWAITを省略
;--------------------------------------------------
@GACHA_PULL_10(ARG)
FLAG:120 = 1
DRAWLINE
PRINTL 【10連ガチャ 開始！】
REPEAT 10
	CALL GACHA_PULL, ARG:0
REND
FLAG:120 = 0
DRAWLINE
PRINTL 10連完了！
WAIT
RETURN 1

;--------------------------------------------------
; チケット・ダイヤ購入 ARG:なし
; MONEY を消費してチケットとダイヤを購入する
;--------------------------------------------------
@GACHA_TICKET_SHOP
$LOOP
DRAWLINE
PRINTL 【チケット・ダイヤ購入】
PRINTFORML 所持金：${MONEY}
PRINTL
PRINTFORML [1] ダイヤ10個              1,000円
PRINTFORML [2] ブロンズチケット1枚       500円  （MR 0.01\%）
PRINTFORML [3] シルバーチケット1枚     1,500円  （MR 0.05\%）
PRINTFORML [4] ゴールドチケット1枚     5,000円  （MR 0.5\%）
PRINTFORML [5] プラチナチケット1枚    10,000円  （MR 3\%）
PRINTL
PRINTFORML [0] 戻る
INPUT
SELECTCASE RESULT
CASE 1
	IF MONEY < 1000
		PRINTFORMW お金が足りません（1,000円必要、現在${MONEY}）。
	ELSE
		MONEY -= 1000
		FLAG:112 += 10
		PRINTFORMW ダイヤを10個入手した。（現在{FLAG:112}個）
	ENDIF
CASE 2
	IF MONEY < 500
		PRINTFORMW お金が足りません（500円必要、現在${MONEY}）。
	ELSE
		MONEY -= 500
		FLAG:113 += 1
		PRINTFORMW ブロンズチケットを1枚入手した。（現在{FLAG:113}枚）
	ENDIF
CASE 3
	IF MONEY < 1500
		PRINTFORMW お金が足りません（1,500円必要、現在${MONEY}）。
	ELSE
		MONEY -= 1500
		FLAG:114 += 1
		PRINTFORMW シルバーチケットを1枚入手した。（現在{FLAG:114}枚）
	ENDIF
CASE 4
	IF MONEY < 5000
		PRINTFORMW お金が足りません（5,000円必要、現在${MONEY}）。
	ELSE
		MONEY -= 5000
		FLAG:115 += 1
		PRINTFORMW ゴールドチケットを1枚入手した。（現在{FLAG:115}枚）
	ENDIF
CASE 5
	IF MONEY < 10000
		PRINTFORMW お金が足りません（10,000円必要、現在${MONEY}）。
	ELSE
		MONEY -= 10000
		FLAG:116 += 1
		PRINTFORMW プラチナチケットを1枚入手した。（現在{FLAG:116}枚）
	ENDIF
CASEELSE
	RETURN 0
ENDSELECT
GOTO LOOP
