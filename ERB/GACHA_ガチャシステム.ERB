;==================================================
; GACHA_ガチャシステム.ERB
;
; 通貨(FLAG):
;   FLAG:112 = キミサキダイヤ
;   FLAG:113 = ブロンズガチャチケット
;   FLAG:114 = シルバーガチャチケット
;   FLAG:115 = ゴールドガチャチケット
;   FLAG:116 = プラチナガチャチケット
;
; カード所持(GLOBAL):
;   GLOBAL:(3000+card_id) = 所持枚数（0=未所持）
;
; キャラ補正(CFLAG):
;   CFLAG:N:303 = 表現力ボーナス累計
;   CFLAG:N:304 = 運動力ボーナス累計
;   CFLAG:N:305 = 学力ボーナス累計
;   CFLAG:N:306 = 好感度ボーナス累計
;   CFLAG:N:307 = 所持カード枚数
;
; ガチャ排出率 (RAND:1000):
;   ブロンズ: N45% R30% HR14% SR8% UR2.5% MR0.5%
;   シルバー: N5%  R20% HR20% SR35% UR18% MR2%
;   ゴールド: N0%  R3%  HR7%  SR35% UR45% MR10%
;   プラチナ: N0%  R0%  HR0%  SR15% UR60% MR25%
;   ダイヤ:   N0%  R2%  HR5%  SR28% UR40% MR25%
;==================================================

;--------------------------------------------------
; ガチャメインメニュー
;--------------------------------------------------
@GACHA_MAIN
$LOOP
DRAWLINE
PRINTL 【ガチャ】
PRINTL
PRINTFORML キミサキダイヤ：{FLAG:112}個
PRINTFORML ブロンズチケット：{FLAG:113}枚
PRINTFORML シルバーチケット：{FLAG:114}枚
PRINTFORML ゴールドチケット：{FLAG:115}枚
PRINTFORML プラチナチケット：{FLAG:116}枚
PRINTL
PRINTFORML [1] ブロンズガチャ（チケット1枚） N/R/HR/SR/UR/MR
PRINTFORML [2] シルバーガチャ（チケット1枚） R/HR/SR/UR/MR
PRINTFORML [3] ゴールドガチャ（チケット1枚） SR/UR/MR
PRINTFORML [4] プラチナガチャ（チケット1枚） SR/UR/MR
PRINTFORML [5] ダイヤガチャ（ダイヤ5個）     R～MR
PRINTL
PRINTFORML [0] 戻る
INPUT
SELECTCASE RESULT
CASE 1
	IF FLAG:113 < 1
		PRINTFORMW ブロンズチケットがありません。
	ELSE
		FLAG:113 -= 1
		CALL GACHA_PULL, 1
	ENDIF
CASE 2
	IF FLAG:114 < 1
		PRINTFORMW シルバーチケットがありません。
	ELSE
		FLAG:114 -= 1
		CALL GACHA_PULL, 2
	ENDIF
CASE 3
	IF FLAG:115 < 1
		PRINTFORMW ゴールドチケットがありません。
	ELSE
		FLAG:115 -= 1
		CALL GACHA_PULL, 3
	ENDIF
CASE 4
	IF FLAG:116 < 1
		PRINTFORMW プラチナチケットがありません。
	ELSE
		FLAG:116 -= 1
		CALL GACHA_PULL, 4
	ENDIF
CASE 5
	IF FLAG:112 < 5
		PRINTFORMW キミサキダイヤが5個必要です（現在{FLAG:112}個）。
	ELSE
		FLAG:112 -= 5
		CALL GACHA_PULL, 5
	ENDIF
CASEELSE
	RETURN 0
ENDSELECT
GOTO LOOP

;--------------------------------------------------
; ガチャ1回実行 ARG:0=ガチャ種別(1-5)
; アルゴリズム:
;   1. レア度決定
;   2. そのレア度を持つキャラを等確率で選択
;   3. そのキャラのそのレア度のカードを選択
;--------------------------------------------------
@GACHA_PULL
LOCAL:9 = RAND:1000  ;0-999
LOCAL:8 = 0          ;決定レア度(1=N 2=R 3=HR 4=SR 5=UR 6=MR)

SELECTCASE ARG:0
CASE 1  ;ブロンズ: N45% R30% HR14% SR8% UR2.5% MR0.5%
	IF LOCAL:9 < 450
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 750
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 890
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 970
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 995
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 2  ;シルバー: N5% R20% HR20% SR35% UR18% MR2%
	IF LOCAL:9 < 50
		LOCAL:8 = 1
	ELSEIF LOCAL:9 < 250
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 450
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 800
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 980
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 3  ;ゴールド: R3% HR7% SR35% UR45% MR10%
	IF LOCAL:9 < 30
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 100
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 450
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 900
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASE 4  ;プラチナ: SR15% UR60% MR25%
	IF LOCAL:9 < 150
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 750
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
CASEELSE  ;ダイヤ: R2% HR5% SR28% UR40% MR25%
	IF LOCAL:9 < 20
		LOCAL:8 = 2
	ELSEIF LOCAL:9 < 70
		LOCAL:8 = 3
	ELSEIF LOCAL:9 < 350
		LOCAL:8 = 4
	ELSEIF LOCAL:9 < 750
		LOCAL:8 = 5
	ELSE
		LOCAL:8 = 6
	ENDIF
ENDSELECT

;そのレア度を持つキャラ一覧を取得
$RETRY_RARITY
CALL CARD_GET_CHARS_FOR_RARITY, LOCAL:8
IF LOCAL:9 == 0
	;そのレア度のカードがない → 1段下げて再試行
	LOCAL:8 -= 1
	IF LOCAL:8 >= 1
		GOTO RETRY_RARITY
	ELSE
		PRINTFORMW カードデータが見つかりません。
		RETURN 0
	ENDIF
ENDIF

;キャラを等確率で選択
LOCAL:6 = RAND:LOCAL:9
LOCAL:5 = LOCAL:LOCAL:6  ;選ばれたキャラNo

;そのキャラのそのレア度のカードを取得
CALL CARD_GET_CHARPOOL, LOCAL:5, LOCAL:8
IF LOCAL:9 == 0
	PRINTFORMW カードが見つかりません。
	RETURN 0
ENDIF

;カードを等確率で選択
LOCAL:4 = RAND:LOCAL:9
LOCAL:7 = LOCAL:LOCAL:4  ;カードID

CALL GACHA_ACQUIRE_CARD, LOCAL:7
RETURN LOCAL:7

;--------------------------------------------------
; カード取得処理 ARG:0=カードID
; 重複時もボーナス加算（減衰あり）
;--------------------------------------------------
@GACHA_ACQUIRE_CARD
LOCAL:10 = ARG:0  ;カードIDを保存
CALL CARD_GET_DATA, LOCAL:10
LOCAL:0 = RESULT:0  ;キャラNo
LOCAL:1 = RESULT:1  ;レア度
LOCAL:2 = RESULT:2  ;ボーナスタイプ
LOCAL:3 = RESULT:3  ;基本ボーナス値

;レア度演出
DRAWLINE
IF LOCAL:1 == 6
	PRINTL ★★★★★★ MR ！！！！！！
ELSEIF LOCAL:1 == 5
	PRINTL ★★★★★ UR ！！！！！
ELSEIF LOCAL:1 == 4
	PRINTL ★★★★ SR ！！！
ELSEIF LOCAL:1 == 3
	PRINTL ★★★ HR ！
ELSEIF LOCAL:1 == 2
	PRINTL ★★ R
ELSE
	PRINTL ★ N
ENDIF

;カード名表示
PRINTFORML 【%CSVNAME:LOCAL:10%】
IF LOCAL:0 > 0
	TARGET = LOCAL:0
	PRINTFORML キャラ: %CALLNAME:TARGET%
ENDIF

;所持枚数確認
LOCAL:5 = 3000 + LOCAL:10
LOCAL:6 = GLOBAL:LOCAL:5

;重複ボーナス計算（1枚目=全額, 2枚目=50%, 3枚目以降=20%, 最低1）
LOCAL:4 = LOCAL:3
IF LOCAL:6 == 0
	PRINTL ★ NEW！（初回ボーナス）
ELSEIF LOCAL:6 == 1
	LOCAL:4 = LOCAL:3 / 2
	SIF LOCAL:4 < 1
		LOCAL:4 = 1
	PRINTFORML （重複 {LOCAL:6+1}枚目 → ボーナス半減）
ELSE
	LOCAL:4 = LOCAL:3 / 5
	SIF LOCAL:4 < 1
		LOCAL:4 = 1
	PRINTFORML （重複 {LOCAL:6+1}枚目 → ボーナス20%）
ENDIF

GLOBAL:LOCAL:5 += 1

;キャラボーナス適用
IF LOCAL:0 > 0
	TARGET = LOCAL:0
	SELECTCASE LOCAL:2
	CASE 0
		CFLAG:TARGET:303 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の表現力 +{LOCAL:4}！（累計+{CFLAG:TARGET:303}）
	CASE 1
		CFLAG:TARGET:304 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の運動力 +{LOCAL:4}！（累計+{CFLAG:TARGET:304}）
	CASE 2
		CFLAG:TARGET:305 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の学力 +{LOCAL:4}！（累計+{CFLAG:TARGET:305}）
	CASEELSE
		CFLAG:TARGET:306 += LOCAL:4
		PRINTFORML %CALLNAME:TARGET%の好感度 +{LOCAL:4}！（累計+{CFLAG:TARGET:306}）
	ENDSELECT
	CFLAG:TARGET:307 += 1
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; カード補正値取得 ARG:0=キャラNo ARG:1=補正タイプ
; RESULT = 補正値
;--------------------------------------------------
@CARD_GET_BONUS
TARGET = ARG:0
SELECTCASE ARG:1
CASE 0
	RETURN CFLAG:TARGET:303
CASE 1
	RETURN CFLAG:TARGET:304
CASE 2
	RETURN CFLAG:TARGET:305
CASEELSE
	RETURN CFLAG:TARGET:306
ENDSELECT
