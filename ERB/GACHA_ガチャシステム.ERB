
;============================================================
; 校内巡り遭遇ガチャ
; ARG:0 = 遭遇したキャラNo(1-71)
; ダイヤと同じ確率でそのキャラ限定のカードを1枚付与
;============================================================
@OUTING_ENCOUNTER_GACHA(ARG)
LOCAL:9 = RAND:10000
;ダイヤと同じ確率: HR30% SR40% UR24% MR6%
IF LOCAL:9 < 3000
	LOCAL:8 = 3
ELSEIF LOCAL:9 < 7000
	LOCAL:8 = 4
ELSEIF LOCAL:9 < 9400
	LOCAL:8 = 5
ELSE
	LOCAL:8 = 6
ENDIF
;そのキャラのそのレア度カードを取得（なければ下のレア度へ）
$OEG_RETRY
CALL CARD_GET_CHARPOOL, ARG:0, LOCAL:8
IF GLOBAL:2100 == 0
	LOCAL:8 -= 1
	IF LOCAL:8 >= 1
		GOTO OEG_RETRY
	ENDIF
	RETURN 0
ENDIF
;カードをランダム選択して取得
A = GLOBAL:2100
LOCAL:6 = RAND:A
A = 2101 + LOCAL:6
LOCAL:5 = GLOBAL:A
PRINTL
SETCOLOR 200, 180, 100
PRINTFORML 　★ 校内巡りガチャ ★
RESETCOLOR
CALL GACHA_ACQUIRE_CARD, LOCAL:5
RETURN 1
