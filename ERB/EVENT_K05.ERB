;	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL K5_KOJO2
ENDIF


;-------------------------------------------------
;パートナーと過ごす（2回目以降、X1をキャラ番号に変更する） CFLAGなし 
;-------------------------------------------------
@K5_KOJO2
;反発感情Lv1以上
IF MARK:3 >= 1 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW チルノはあからさまに嫌そうな顔をする
	RETURN 1

;進展無し（デート経験0）
ELSEIF EXP:94 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「今日は何して遊ぶの？」
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「ねぇねぇ、また遊びに行こうよ！」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「今日も一緒だね」
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「%CALLNAME:MASTER%と一緒だとわくわくしちゃう」
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1 && FLAG:7 == 2
	DRAWLINE
	;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
	A = RAND:3
	IF A == 0
		PRINTFORMW 「もうずっと一緒だよ」
	ELSEIF A == 1
		PRINTFORMW 「%CALLNAME:MASTER%と一緒だと何しても楽しいよ！」
	ELSE
		PRINTFORMW 「あたいね、%CALLNAME:MASTER%と一緒だとドキドキして、なんだか幸せなの」
	ENDIF
	RETURN 1
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（X1をキャラ番号に置換）
;パートナーと一旦別れる
;-------------------------------------------------
@EVENTEND
SIF FLAG:7 == 0
	RETURN 0
SIF NO:TARGET != 5
	RETURN 0
;--------------------------------------------------
;パートナーと一旦別れる
;--------------------------------------------------
;反発感情Lv1以上
IF MARK:3 >= 1
	DRAWLINE
	PRINTFORMW 「ふんっ、だ」
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「またねっ！」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「またねっ！」
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「もっと一緒にいたいな…」
	RETURN 1

;恋慕＋体力500未満
ELSEIF TALENT:TARGET:85 == 1 && BASE:0 < 500
	DRAWLINE
	PRINTFORMW 「いっぱい……しちゃったね」
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1
	DRAWLINE
	PRINTFORMW 「もうお別れなの……寂しいな」
	RETURN 1
ENDIF
RETURN 0
