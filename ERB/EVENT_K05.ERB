;-------------------------------------------------
;チルノ口上
;筆者の脳内チルノとなっていますのでご了承をお願いします。
;一緒にい始めたときには子どもっぽく元気で、恋すると甘えん坊っぽくなるようイメージしましたが、
;書き上げるまで時間がかかって結構ばらばらかもしれません。
;使い回しが多いので精進しないと、なによりウフフ分が足りない。
;ＲＲチルノやＪ大妖精の口上などいろいろ影響受けていますが楽しんでいただけたら幸いです。
;-------------------------------------------------
;--------------------------------------------------
;口上ファイルの存在判定（05をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:105 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:105 = 0

;--------------------------------------------------
;EVENTTRAIN関係（X1をキャラ番号に置換）
;パートナーと過ごす開始時のセリフ CFLAG 201～219を使用
;-------------------------------------------------
@EVENTTRAIN
SIF FLAG:7 == 0
	RETURN 0
SIF NO:TARGET != 5
	RETURN 0
;--------------------------------------------------
;簡易助手口上の発動時に初調教時口上をスキップ（Y1を助手のキャラ番号にする）
;複数人いる際には、SIF NO:ASSI == Y1 || NO:ASSI == Z1と追加していく
;--------------------------------------------------
;IF CFLAG:201 == 0 && ASSI > 0
;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;初パートナーと過ごす CFLAG201
;-------------------------------------------------

IF CFLAG:201 == 0
	DRAWLINE
	;素質:パートナーの場合
	IF TALENT:150 == 1
		PRINTFORMW 「あたいがいてあげるから大丈夫よ！」
	;それ以外
	ELSE
		PRINTFORMW 「あたいがいてあげるから大丈夫よ！」
	ENDIF
		CFLAG:201 = 1
	RETURN 1

;-------------------------------------------------
;パートナーと過ごす（一回のみ） CFLAG201
;-------------------------------------------------

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0 && CFLAG:201 < 2
	DRAWLINE
	PRINTFORMW 「この前すっごく楽しかったよ！」
	CFLAG:201 = 2
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0 && CFLAG:201 < 3
	DRAWLINE
	PRINTFORMW 「えへへ」
	CFLAG:201 = 3
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0 && CFLAG:201 < 4
	DRAWLINE
	PRINTFORMW 「今日も一緒だね」
	CFLAG:201 = 4
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1 && CFLAG:201 < 5
	DRAWLINE
	PRINTFORMW 「%CALLNAME:MASTER%だーい好き」
	CFLAG:201 = 5
	RETURN 1

;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
ELSEIF ASSI < 0 
	CALL K5_KOJO2

