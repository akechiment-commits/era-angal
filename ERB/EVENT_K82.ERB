;変数Tに妊娠したキャラ、CFLAG:T:104に妊娠させたキャラ(1:主人、2:助手、3:パートナー)
;恋慕無しで反発感情LV2以上で妊娠させられると壊れる
;----------------------------------------------------------------
IF TFLAG:13 == 20
	;主人→パートナー、助手(助手の時、パートナーはZで参照可能。TARGETでは参照できません)
	IF CFLAG:T:104 == 1
		;恋慕or相愛
		IF TALENT:85 == 1 || TALENT:89 == 1
			PRINTFORMW 
		;恋人
		ELSEIF TALENT:153
			PRINTFORMW 
		;反発感情Lv2以上
		ELSEIF MARK:T:3 >= 2
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	;助手→パートナー
	ELSEIF CFLAG:T:104 == 2 && ASSI >= 0 && T == TARGET
		;恋慕無しで反発感情Lv2以上
		IF TALENT:85 == 0 && MARK:T:3 >= 2
			PRINTFORMW 
		;恋慕もしくは恋人
		ELSEIF TALENT:85
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	;パートナー→主人
	ELSEIF CFLAG:T:104 == 3 && T == MASTER
		;恋慕
		IF TALENT:85
			PRINTFORMW 
		;反発感情LV2以上
		ELSEIF MARK:3 >= 2
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	;パートナー→助手(助手を妊娠させた)
	ELSEIF CFLAG:T:104 == 3 && T == ASSI
		;恋慕無しで反発感情Lv2以上
		IF TALENT:85 == 0 && MARK:T:3 >= 2
			PRINTFORMW 
		;恋慕
		ELSEIF TALENT:85
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
ENDIF
IF TFLAG:13 == 94
	;助手の時にパートナーに妊娠させられた(パートナーはZで参照可能。TARGETでは参照できません)
	IF CFLAG:T:104 == 3
		;恋慕無しで反発感情Lv2以上
		IF TALENT:85 == 0 && MARK:T:3 >= 2
			PRINTFORMW 
		;恋慕
		ELSEIF TALENT:85
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	;助手の時にパートナーを妊娠させた(パートナーはZで参照可能。TARGETでは参照できません)
	ELSEIF CFLAG:T:104 == 2
		;恋慕無しで反発感情Lv2以上
		IF TALENT:85 == 0 && MARK:T:3 >= 2
			PRINTFORMW 
		;恋慕
		ELSEIF TALENT:85
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
ENDIF

;----------------------------------------------------------------
;【吸血鬼】取得 (吸血鬼化機能をオンにして吸血/吸血させるを実行すると一定確率で吸血鬼化)
;変数Tに吸血鬼化したキャラ、変数Vに吸血鬼化させたキャラの番号。主人も吸血鬼化するので注意
;反発感情LV2で壊れて、恋慕ありかつ主人に吸血鬼化されないと反発感情LV3
;----------------------------------------------------------------
IF TFLAG:13 == 81
	;主人が吸血鬼化
	IF T == MASTER
		;恋慕
		IF TALENT:V:85
			PRINTFORMW 
		;反発感情LV2以上
		ELSEIF MARK:V:3 >= 2
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	;助手かパートナーが吸血鬼化
	ELSE
		;恋慕かつ主人に吸血鬼化された
		IF TALENT:T:85 && (V == MASTER)
			;相愛
			IF TALENT:T:89
				PRINTFORMW 
			;それ以外
			ELSE
				PRINTFORMW 
			ENDIF
		;反発感情LV2以上
		ELSEIF MARK:T:3 >= 2
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
	ENDIF
ENDIF

