#PRI
FLAG:177 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:177 = 0

;--------------------------------------------------
;EVENTTRAIN関係（77をキャラ番号に置換）
