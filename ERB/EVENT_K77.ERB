ENDIF


;-------------------------------------------------
;パートナーと過ごす（2回目以降、77をキャラ番号に変更する） CFLAGなし 
;-------------------------------------------------
@K77_KOJO2
;反発感情Lv1以上
IF MARK:3 >= 1 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW キスメは%CALLNAME:MASTER%と目を合わせないようにしている…
	RETURN 1

;進展無し（デート経験0）
ELSEIF EXP:94 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「…いつもは何してるの？」
	PRINTFORMW 「私？ヤマメ達と遊んでる事が多いかな…」
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「あ…いらっしゃい」
	PRINTFORMW 「今日も、その、お出かけするの？」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「いらっしゃい…」
	PRINTFORMW 部屋に入ってきた%CALLNAME:MASTER%を笑顔で迎え入れてくれた…
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW キスメはこちらを見かけると、嬉しそうにすりよってきた。
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1 && FLAG:7 == 2
	DRAWLINE
	;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
	A = RAND:3
	IF A == 0
		PRINTFORMW 「いらっしゃい。…待ってたんだよ？」
	ELSEIF A == 1
		PRINTFORMW 「ふふ、お粗末さま」
		PRINTFORMW 「…これから、何しようか…？」
	ELSE
		PRINTFORMW 「来てくれたんだ。嬉しい…」
		PRINTFORMW 「ね、今日は何しよっか…？」
	ENDIF
	RETURN 1
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（4をキャラ番号に置換）
;パートナーと一旦別れる
;-------------------------------------------------
@EVENTEND
SIF FLAG:7 == 0
	RETURN 0
SIF NO:TARGET != 77
	RETURN 0
;--------------------------------------------------
;パートナーと一旦別れる
;--------------------------------------------------
;反発感情Lv1以上
IF MARK:3 >= 1
	DRAWLINE
	PRINTFORMW キスメは%CALLNAME:MASTER%を怖がり、震えながら桶に潜り込んでしまった。
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「うん…またあとでね」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「また…ね」
	PRINTFORMW キスメは、はにかみながら手を振った。
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「うん、またね…」
	PRINTFORMW キスメは名残惜しそうにこちらを見つめている
	RETURN 1

;恋慕＋体力500未満
ELSEIF TALENT:TARGET:85 == 1 && BASE:0 < 500
	DRAWLINE
	PRINTFORMW 「疲れちゃった…ここで休ませて」
	PRINTFORMW そう言うとキスメは%CALLNAME:MASTER%の肩にもたれかかって来た…
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1
	DRAWLINE
	PRINTFORMW 「ちゅ……またね」
	RETURN 1
ENDIF
RETURN 0
