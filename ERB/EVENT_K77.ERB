	DRAWLINE
	;素質:パートナーの場合
	IF TALENT:150 == 1
		PRINTFORMW 「そ、その…よろしくね…？」
	;それ以外
	ELSE
		PRINTFORMW 「そ、その…よろしくね…？」
	ENDIF
		CFLAG:201 = 1
	RETURN 1

;-------------------------------------------------
;パートナーと過ごす（一回のみ） CFLAG201
;-------------------------------------------------

