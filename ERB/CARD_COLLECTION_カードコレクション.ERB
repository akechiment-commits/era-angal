;==================================================
; CARD_COLLECTION_カードコレクション.ERB
; カード所持一覧・キャラ別補正確認
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
DRAWLINE
PRINTL 【カードコレクション】
PRINTL
PRINTFORML [1] キャラ別カード補正を見る
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; キャラ別カード補正表示
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
PRINTFORML キャラ名              カード  表現力  運動力  学力  好感度
DRAWLINE
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORML %CSVNAME:COUNT%　{CFLAG:COUNT:307}枚  +{CFLAG:COUNT:303}  +{CFLAG:COUNT:304}  +{CFLAG:COUNT:305}  +{CFLAG:COUNT:306}
	ENDIF
REND
PRINTL
LOCAL:9 = 0
REPEAT CHARANUM
	LOCAL:9 += CFLAG:COUNT:307
REND
PRINTFORML 合計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; イベントボード発揮値にカード補正を加算
; ARG:0=キャラNo ARG:1=補正タイプ(0-3) -> RESULT
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
