;==================================================
; CARD_COLLECTION_カードコレクション.ERB
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
DRAWLINE
PRINTL 【カードコレクション】
PRINTL
PRINTFORML [1] キャラ別カード補正を見る
PRINTFORML [2] レア度別カード一覧
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 2
	CALL CARD_COLLECTION_RARITY_MENU
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; キャラ別カード補正表示 (PRINTFORMC で列整形)
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
PRINTFORMC キャラ名
PRINTFORMC 枚数
PRINTFORMC 表現
PRINTFORMC 体操
PRINTFORMC 学習
PRINTFORMLC 好感
DRAWLINE
LOCAL:9 = 0
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORMC %NAME:COUNT%
		PRINTFORMC {CFLAG:COUNT:307}枚
		PRINTFORMC +{CFLAG:COUNT:303}
		PRINTFORMC +{CFLAG:COUNT:304}
		PRINTFORMC +{CFLAG:COUNT:305}
		PRINTFORMLC +{CFLAG:COUNT:306}
		LOCAL:9 += CFLAG:COUNT:307
	ENDIF
REND
PRINTL
PRINTFORML 総計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; レア度選択メニュー
;--------------------------------------------------
@CARD_COLLECTION_RARITY_MENU
$LOOP
DRAWLINE
PRINTL 【レア度別カード一覧】
PRINTL
PRINTFORML [1] N（ノーマル）
PRINTFORML [2] R（レア）
PRINTFORML [3] HR（ハイレア）
PRINTFORML [4] SR（スーパーレア）
PRINTFORML [5] UR（ウルトラレア）
PRINTFORML [6] MR（マスターレア）
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT >= 1 && RESULT <= 6
	CALL CARD_COLLECTION_RARITY_LIST, RESULT
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; レア度別カード一覧 ARG:0=レア度(1-6)
; LOCAL:5 = カードIDカウンタ(1..1748)
; LOCAL:8 = 対象レア度
; LOCAL:9 = GLOBALインデックス (3000+LOCAL:5)
; ※ A = expr が動かないため LOCAL:9 経由で代入
;--------------------------------------------------
@CARD_COLLECTION_RARITY_LIST(ARG)
LOCAL:8 = ARG:0
LOCAL:5 = 1
LOCAL:1 = 0
PRINTFORML [DBG-R] G3001={GLOBAL:3001} G3002={GLOBAL:3002}
$PAGE_LOOP
DRAWLINE
SELECTCASE LOCAL:8
CASE 1
	PRINTL 【N カード一覧】
CASE 2
	PRINTL 【R カード一覧】
CASE 3
	PRINTL 【HR カード一覧】
CASE 4
	PRINTL 【SR カード一覧】
CASE 5
	PRINTL 【UR カード一覧】
CASEELSE
	PRINTL 【MR カード一覧】
ENDSELECT
DRAWLINE
LOCAL:2 = 0
$SCAN_LOOP
IF LOCAL:5 > 1748
	GOTO LIST_END
ENDIF
LOCAL:9 = 3000 + LOCAL:5
A = LOCAL:9
LOCAL:3 = GLOBAL:A
IF LOCAL:3 > 0
	CALL CARD_GET_DATA, LOCAL:5
	LOCAL:6 = RESULT:2
	LOCAL:7 = RESULT:4
	IF LOCAL:6 == LOCAL:8
		IF STR:0 != ""
			PRINTFORML %STR:0%（{LOCAL:3}枚 / +{LOCAL:7}/枚）
		ELSE
			PRINTFORML カードID:{LOCAL:5}（{LOCAL:3}枚 / +{LOCAL:7}/枚）
		ENDIF
		LOCAL:1 += 1
		LOCAL:2 += 1
	ENDIF
ENDIF
LOCAL:5 += 1
IF LOCAL:2 < 15
	GOTO SCAN_LOOP
ENDIF
PRINTL
PRINTFORML （{LOCAL:2}件表示 / 累計{LOCAL:1}件）
PRINTFORML [1] 次の15件  [0] 戻る
INPUT
IF RESULT == 1
	GOTO PAGE_LOOP
ELSE
	RETURN 1
ENDIF
$LIST_END
IF LOCAL:1 == 0
	PRINTL このレア度の所持カードはありません。
ELSE
	PRINTFORML 累計 {LOCAL:1}種のカード所持
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; イベントボーナス計算にカード補正を加算
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI(ARG, ARG:1)
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
