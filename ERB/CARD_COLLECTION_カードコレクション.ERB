;==================================================
; CARD_COLLECTION_カードコレクション.ERB
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
DRAWLINE
PRINTL 【カードコレクション】
PRINTL
PRINTFORML [1] キャラ別カード補正を見る
PRINTFORML [2] レア度別カード一覧
PRINTFORML [3] キミサキブースター使用（残り{ITEM:95}個）
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 2
	CALL CARD_COLLECTION_RARITY_MENU
ELSEIF RESULT == 3
	CALL CARD_COLLECTION_USE_BOOSTER
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; キャラ別カード補正表示 (PRINTFORMC で列整形)
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
CALL CARD_RECALC_BONUSES
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
DRAWLINE
LOCAL:9 = 0
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORML %NAME:COUNT%　{CFLAG:COUNT:307}枚  表現力+{CFLAG:COUNT:303}  運動力+{CFLAG:COUNT:304}  学力+{CFLAG:COUNT:305}  好感度+{CFLAG:COUNT:306}
		LOCAL:9 += CFLAG:COUNT:307
	ENDIF
REND
PRINTL
PRINTFORML 総計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; レア度選択メニュー
;--------------------------------------------------
@CARD_COLLECTION_RARITY_MENU
$LOOP
DRAWLINE
PRINTL 【レア度別カード一覧】
PRINTL
PRINTFORML [1] N（ノーマル）
PRINTFORML [2] R（レア）
PRINTFORML [3] HR（ハイレア）
PRINTFORML [4] SR（スーパーレア）
PRINTFORML [5] UR（ウルトラレア）
PRINTFORML [6] MR（マスターレア）
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT >= 1 && RESULT <= 6
	CALL CARD_COLLECTION_RARITY_LIST, RESULT
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; レア度別カード一覧 ARG:0=レア度(1-6)
; LOCAL:5 = カードIDカウンタ(1..1884)
; LOCAL:8 = 対象レア度
; LOCAL:9 = GLOBALインデックス (3000+LOCAL:5)
; ※ A = expr が動かないため LOCAL:9 経由で代入
;--------------------------------------------------
@CARD_COLLECTION_RARITY_LIST(ARG)
LOCAL:8 = ARG:0
LOCAL:5 = 1
LOCAL:1 = 0
$PAGE_LOOP
DRAWLINE
SELECTCASE LOCAL:8
CASE 1
	PRINTL 【N カード一覧】
CASE 2
	PRINTL 【R カード一覧】
CASE 3
	PRINTL 【HR カード一覧】
CASE 4
	PRINTL 【SR カード一覧】
CASE 5
	PRINTL 【UR カード一覧】
CASEELSE
	PRINTL 【MR カード一覧】
ENDSELECT
DRAWLINE
LOCAL:2 = 0
$SCAN_LOOP
IF LOCAL:5 > 1884
	GOTO LIST_END
ENDIF
LOCAL:9 = 3000 + LOCAL:5
A = LOCAL:9
LOCAL:3 = FLAG:A
IF LOCAL:3 > 0
	CALL CARD_GET_DATA, LOCAL:5
	LOCAL:6 = RESULT:2
	LOCAL:7 = RESULT:4
	LOCAL:11 = RESULT:1
	IF LOCAL:6 == LOCAL:8
		;ボーナス計算（base×rate×枚数、×10固定小数点）
;LOCAL:14 = 1枚分の増分（×10単位）
SELECTCASE LOCAL:6
CASE 6
	LOCAL:14 = LOCAL:7 * 5
CASE 5
	LOCAL:14 = LOCAL:7 * 5 / 2
CASE 4
	LOCAL:14 = LOCAL:7 * 2
CASE 2
	LOCAL:14 = LOCAL:7
CASE 1
	LOCAL:14 = LOCAL:7 / 2
CASEELSE
	LOCAL:14 = LOCAL:7
ENDSELECT
LOCAL:10 = LOCAL:7 * 10 + LOCAL:14 * (LOCAL:3 - 1)
IF LOCAL:3 >= 12
	LOCAL:10 += LOCAL:7 * 30
ENDIF
LOCAL:16 = LOCAL:10 / 10
LOCAL:17 = LOCAL:10 - LOCAL:16 * 10
		LOCAL:12 = GETCHARA(LOCAL:11)
		IF STR:0 != "" && LOCAL:12 >= 0
			A = LOCAL:12
			IF LOCAL:3 >= 12
				PRINTFORML %STR:0%（%CALLNAME:A%）（キラ）（{LOCAL:3}枚 / 合計+{LOCAL:16}.{LOCAL:17}）
			ELSE
				PRINTFORML %STR:0%（%CALLNAME:A%）（{LOCAL:3}枚 / 合計+{LOCAL:16}.{LOCAL:17}）
			ENDIF
		ELSEIF STR:0 != ""
			IF LOCAL:3 >= 12
				PRINTFORML %STR:0%（キラ）（{LOCAL:3}枚 / 合計+{LOCAL:16}.{LOCAL:17}）
			ELSE
				PRINTFORML %STR:0%（{LOCAL:3}枚 / 合計+{LOCAL:16}.{LOCAL:17}）
			ENDIF
		ELSE
			IF LOCAL:3 >= 12
				PRINTFORML カードID:{LOCAL:5}（キラ）（{LOCAL:3}枚 / 合計+{LOCAL:16}.{LOCAL:17}）
			ELSE
				PRINTFORML カードID:{LOCAL:5}（{LOCAL:3}枚 / 合計+{LOCAL:16}.{LOCAL:17}）
			ENDIF
		ENDIF
		LOCAL:1 += 1
		LOCAL:2 += 1
	ENDIF
ENDIF
LOCAL:5 += 1
IF LOCAL:2 < 15
	GOTO SCAN_LOOP
ENDIF
PRINTL
PRINTFORML （{LOCAL:2}件表示 / 累計{LOCAL:1}件）
PRINTFORML [1] 次の15件  [0] 戻る
INPUT
IF RESULT == 1
	GOTO PAGE_LOOP
ELSE
	RETURN 1
ENDIF
$LIST_END
IF LOCAL:1 == 0
	PRINTL このレア度の所持カードはありません。
ELSE
	PRINTFORML 累計 {LOCAL:1}種のカード所持
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; イベントボーナス計算にカード補正を加算
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI(ARG, ARG:1)
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
;--------------------------------------------------
; キミサキブースター使用 (ITEM:95)
; 所持カードを1枚選んでもう1枚入手する
;--------------------------------------------------
@CARD_COLLECTION_USE_BOOSTER
IF ITEM:95 <= 0
	PRINTFORMW キミサキブースターを持っていません。
	RETURN 0
ENDIF
DRAWLINE
PRINTL 【キミサキブースター使用】
PRINTL 所持カードをもう1枚入手できます。
PRINTFORML 残り: {ITEM:95}個
PRINTL
$BOOSTER_RARITY
PRINTFORML [1]N　[2]R　[3]HR　[4]SR　[5]UR　[6]MR
PRINTFORML [0] キャンセル
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > 6
	GOTO BOOSTER_RARITY
ENDIF
LOCAL:8 = RESULT
CALL CARD_BOOSTER_SELECT, LOCAL:8
IF RESULT > 0
	LOCAL:7 = RESULT
	ITEM:95 -= 1
	DRAWLINE
	PRINTFORML キミサキブースター使用！（残り{ITEM:95}個）
	CALL GACHA_ACQUIRE_CARD, LOCAL:7
ENDIF
RETURN 0

;--------------------------------------------------
; ブースター用カード選択 ARG:0=レア度 RESULT=カードID(0=キャンセル)
; GLOBAL:3700-3714 をページ内一時保存に使用
;--------------------------------------------------
@CARD_BOOSTER_SELECT(ARG)
LOCAL:8 = ARG:0
LOCAL:5 = 1	;スキャン中カードID
LOCAL:0 = 0	;全ページ累計件数
$BS_PAGE
DRAWLINE
IF LOCAL:8 == 1
	PRINTL 【N カード選択】
ELSEIF LOCAL:8 == 2
	PRINTL 【R カード選択】
ELSEIF LOCAL:8 == 3
	PRINTL 【HR カード選択】
ELSEIF LOCAL:8 == 4
	PRINTL 【SR カード選択】
ELSEIF LOCAL:8 == 5
	PRINTL 【UR カード選択】
ELSE
	PRINTL 【MR カード選択】
ENDIF
PRINTL
LOCAL:2 = 0	;ページ内件数
$BS_SCAN
IF LOCAL:5 > 1884
	GOTO BS_END
ENDIF
A = 3000 + LOCAL:5
LOCAL:3 = FLAG:A	;所持枚数
IF LOCAL:3 > 0
	CALL CARD_GET_DATA, LOCAL:5
	IF RESULT:2 == LOCAL:8
		LOCAL:2 += 1
		LOCAL:0 += 1
		A = 3700 + LOCAL:2
		GLOBAL:A = LOCAL:5
		LOCAL:11 = RESULT:1
		LOCAL:12 = GETCHARA(LOCAL:11)
		IF STR:0 != "" && LOCAL:12 >= 0
			A = LOCAL:12
			PRINTFORML [{LOCAL:2}] %STR:0%（%CALLNAME:A%）（{LOCAL:3}枚）
		ELSEIF STR:0 != ""
			PRINTFORML [{LOCAL:2}] %STR:0%（{LOCAL:3}枚）
		ELSE
			PRINTFORML [{LOCAL:2}] カードID:{LOCAL:5}（{LOCAL:3}枚）
		ENDIF
	ENDIF
ENDIF
LOCAL:5 += 1
SIF LOCAL:2 < 15
	GOTO BS_SCAN
PRINTL
PRINTFORML [1-{LOCAL:2}] 選択　[16] 次の15枚　[0] キャンセル
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT >= 1 && RESULT <= LOCAL:2
	A = 3700 + RESULT
	RETURN GLOBAL:A
ELSEIF RESULT == 16
	GOTO BS_PAGE
ENDIF
GOTO BS_PAGE

$BS_END
IF LOCAL:0 == 0
	PRINTFORMW このレア度の所持カードはありません。
	RETURN 0
ENDIF
SIF LOCAL:2 == 0
	RETURN 0
PRINTL
PRINTFORML [1-{LOCAL:2}] 選択　[0] キャンセル
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT >= 1 && RESULT <= LOCAL:2
	A = 3700 + RESULT
	RETURN GLOBAL:A
ENDIF
RETURN 0
