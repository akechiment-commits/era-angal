;==================================================
; CARD_COLLECTION_カードコレクション.ERB
; カード所持一覧・キャラ別補正確認
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
DRAWLINE
PRINTL 【カードコレクション】
PRINTL
PRINTFORML [1] キャラ別カード補正を見る
PRINTFORML [2] 所持カード一覧（全部）
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 2
	CALL CARD_COLLECTION_LIST
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; キャラ別カード補正表示
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
PRINTFORML キャラ名              カード  表現力  運動力  学力  好感度
DRAWLINE
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORML %CSVNAME:COUNT%　{CFLAG:COUNT:307}枚  +{CFLAG:COUNT:303}  +{CFLAG:COUNT:304}  +{CFLAG:COUNT:305}  +{CFLAG:COUNT:306}
	ENDIF
REND
PRINTL
LOCAL:9 = 0
REPEAT CHARANUM
	LOCAL:9 += CFLAG:COUNT:307
REND
PRINTFORML 合計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; 所持カード一覧（全カード）
; 20件ずつ表示、続きを選択可能
;--------------------------------------------------
@CARD_COLLECTION_LIST
LOCAL:0 = 1       ;現在のカードID
LOCAL:1 = 0       ;表示件数カウンタ
$LIST_LOOP
DRAWLINE
PRINTL 【所持カード一覧】
PRINTL
LOCAL:2 = 0       ;このページの表示件数
$PAGE_LOOP
IF LOCAL:0 > 1748
	GOTO LIST_END
ENDIF
LOCAL:9 = 3000 + LOCAL:0
A = LOCAL:9
IF GLOBAL:A > 0
	CALL CARD_GET_DATA, LOCAL:0
	IF STR:0 != ""
		PRINTFORML  [{RESULT:2}] %STR:0%（{GLOBAL:A}枚）
	ELSE
		PRINTFORML  [{RESULT:2}] カードID:{LOCAL:0}（{GLOBAL:A}枚）
	ENDIF
	LOCAL:1 += 1
	LOCAL:2 += 1
ENDIF
LOCAL:0 += 1
IF LOCAL:2 < 20
	GOTO PAGE_LOOP
ENDIF
PRINTL
PRINTFORML 　（累計{LOCAL:1}枚表示 / カードID:{LOCAL:0}まで確認済み）
PRINTFORML [1] 次の20件  [0] 戻る
INPUT
IF RESULT == 1
	GOTO LIST_LOOP
ELSE
	RETURN 1
ENDIF
$LIST_END
PRINTL
IF LOCAL:1 == 0
	PRINTL 所持カードはありません。
ELSE
	PRINTFORML 所持カード：{LOCAL:1}種類
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; イベントボード発揮値にカード補正を加算
; ARG:0=キャラNo ARG:1=補正タイプ(0-3) -> RESULT
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI(ARG, ARG:1)
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
