;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;==================================================
; CARD_COLLECTION_カードコレクション.ERB
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
CALL CARD_COLLECTION_GET_PROGRESS
LOCAL:0 = RESULT
LOCAL:1 = RESULT:1
LOCAL:2 = 0
SIF LOCAL:0 > 0
	LOCAL:2 = LOCAL:1 * 100 / LOCAL:0
DRAWLINE
PRINTL 【カード図鑑】
PRINTL
PRINTFORML 収集進捗：{LOCAL:1}/{LOCAL:0}種（{LOCAL:2}\%）
IF FLAG:5100
	PRINTL 未入手カード：一覧から飛ばす
ELSE
	PRINTL 未入手カード：？？？？？で表示
ENDIF
PRINTL
PRINTFORML [1] レア度別カード図鑑
PRINTFORML [2] キャラ別カード補正を見る
PRINTFORML [3] 未入手カードの表示方式を切替
PRINTFORML [4] キミサキブースター使用（残り{ITEM:95}個）
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_RARITY_MENU
ELSEIF RESULT == 2
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 3
	IF FLAG:5100
		FLAG:5100 = 0
	ELSE
		FLAG:5100 = 1
	ENDIF
ELSEIF RESULT == 4
	CALL CARD_COLLECTION_USE_BOOSTER
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; 図鑑進捗 ARGなし
; RESULT=登録カード総数 RESULT:1=所持カード種数
;--------------------------------------------------
@CARD_COLLECTION_GET_PROGRESS
RESULT:1 = 0
LOCAL:0 = 0
LOCAL:1 = 1
LOCAL:2 = 0
$SCAN
SIF LOCAL:1 > 1884
	GOTO DONE
CALL CARD_GET_DATA, LOCAL:1
IF RESULT:2 > 0
	LOCAL:0 += 1
	A = 3000 + LOCAL:1
	SIF FLAG:A > 0
		LOCAL:2 += 1
ENDIF
LOCAL:1 += 1
GOTO SCAN
$DONE
RESULT:1 = LOCAL:2
RETURN LOCAL:0

;--------------------------------------------------
; レア度別図鑑進捗 ARG:0=レア度
; RESULT=登録枚数 RESULT:1=所持種数
;--------------------------------------------------
@CARD_COLLECTION_GET_RARITY_PROGRESS(ARG)
RESULT:1 = 0
LOCAL:0 = 0
LOCAL:1 = 1
LOCAL:2 = 0
$SCAN
SIF LOCAL:1 > 1884
	GOTO DONE
CALL CARD_GET_DATA, LOCAL:1
IF RESULT:2 == ARG:0
	LOCAL:0 += 1
	A = 3000 + LOCAL:1
	SIF FLAG:A > 0
		LOCAL:2 += 1
ENDIF
LOCAL:1 += 1
GOTO SCAN
$DONE
RESULT:1 = LOCAL:2
RETURN LOCAL:0

;--------------------------------------------------
; キャラ別カード補正表示
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
CALL CARD_RECALC_BONUSES
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
DRAWLINE
LOCAL:9 = 0
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORML %NAME:COUNT%　{CFLAG:COUNT:307}枚  表現力+{CFLAG:COUNT:303}  運動力+{CFLAG:COUNT:304}  学力+{CFLAG:COUNT:305}  デッキ戦力+{CFLAG:COUNT:306}
		LOCAL:9 += CFLAG:COUNT:307
	ENDIF
REND
PRINTL
PRINTFORML 総計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; レア度選択メニュー
;--------------------------------------------------
@CARD_COLLECTION_RARITY_MENU
$LOOP
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, 1
LOCAL:0 = RESULT
LOCAL:6 = RESULT:1
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, 2
LOCAL:1 = RESULT
LOCAL:7 = RESULT:1
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, 3
LOCAL:2 = RESULT
LOCAL:8 = RESULT:1
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, 4
LOCAL:3 = RESULT
LOCAL:9 = RESULT:1
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, 5
LOCAL:4 = RESULT
LOCAL:10 = RESULT:1
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, 6
LOCAL:5 = RESULT
LOCAL:11 = RESULT:1
DRAWLINE
PRINTL 【レア度別カード図鑑】
IF FLAG:5100
	PRINTL 未入手カード：飛ばす
ELSE
	PRINTL 未入手カード：？？？？？で表示（主な入手先は確認可能）
ENDIF
PRINTL
PRINTFORML [1] N　 {LOCAL:6}/{LOCAL:0}
PRINTFORML [2] R　 {LOCAL:7}/{LOCAL:1}
PRINTFORML [3] HR　{LOCAL:8}/{LOCAL:2}
PRINTFORML [4] SR　{LOCAL:9}/{LOCAL:3}
PRINTFORML [5] UR　{LOCAL:10}/{LOCAL:4}
PRINTFORML [6] MR　{LOCAL:11}/{LOCAL:5}
PRINTL
PRINTFORML [7] 未入手カードの表示方式を切替
PRINTFORML [0] 戻る
INPUT
IF RESULT >= 1 && RESULT <= 6
	CALL CARD_COLLECTION_RARITY_LIST, RESULT
ELSEIF RESULT == 7
	IF FLAG:5100
		FLAG:5100 = 0
	ELSE
		FLAG:5100 = 1
	ENDIF
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; レア度別カード図鑑 ARG:0=レア度(1-6)
; FLAG:5100 0=未入手を？表示 1=未入手を飛ばす
;--------------------------------------------------
@CARD_COLLECTION_RARITY_LIST(ARG)
LOCAL:8 = ARG:0
CALL CARD_COLLECTION_GET_RARITY_PROGRESS, LOCAL:8
LOCAL:13 = RESULT
LOCAL:14 = RESULT:1
; 表示対象数を数え、ページ数を決める（1ページ12件）
$RECOUNT_PAGES
LOCAL:5 = 1
LOCAL:6 = 0
$COUNT_LOOP
SIF LOCAL:5 > 1884
	GOTO COUNT_END
CALL CARD_GET_DATA, LOCAL:5
IF RESULT:2 == LOCAL:8
	A = 3000 + LOCAL:5
	IF FLAG:A > 0 || FLAG:5100 == 0
		LOCAL:6 += 1
	ENDIF
ENDIF
LOCAL:5 += 1
GOTO COUNT_LOOP
$COUNT_END
LOCAL:9 = (LOCAL:6 + 11) / 12
SIF LOCAL:9 > 0 && LOCAL:4 < 1
	LOCAL:4 = 1
SIF LOCAL:9 > 0 && LOCAL:4 > LOCAL:9
	LOCAL:4 = LOCAL:9
$PAGE_LOOP
DRAWLINE
SELECTCASE LOCAL:8
CASE 1
	PRINTFORML 【N カード図鑑　{LOCAL:14}/{LOCAL:13}　{LOCAL:4}/{LOCAL:9}】
CASE 2
	PRINTFORML 【R カード図鑑　{LOCAL:14}/{LOCAL:13}　{LOCAL:4}/{LOCAL:9}】
CASE 3
	PRINTFORML 【HR カード図鑑　{LOCAL:14}/{LOCAL:13}　{LOCAL:4}/{LOCAL:9}】
CASE 4
	PRINTFORML 【SR カード図鑑　{LOCAL:14}/{LOCAL:13}　{LOCAL:4}/{LOCAL:9}】
CASE 5
	PRINTFORML 【UR カード図鑑　{LOCAL:14}/{LOCAL:13}　{LOCAL:4}/{LOCAL:9}】
CASEELSE
	PRINTFORML 【MR カード図鑑　{LOCAL:14}/{LOCAL:13}　{LOCAL:4}/{LOCAL:9}】
ENDSELECT
IF FLAG:5100
	PRINTL 未入手カード：飛ばす
ELSE
	PRINTL 未入手カード：？？？？？で表示
ENDIF
DRAWLINE
LOCAL:18 = (LOCAL:4 - 1) * 12
LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:5 = 1
$SCAN_LOOP
SIF LOCAL:5 > 1884
	GOTO LIST_COMPLETE
CALL CARD_GET_DATA, LOCAL:5
SIF RESULT:2 != LOCAL:8
	GOTO NEXT_CARD
A = 3000 + LOCAL:5
LOCAL:3 = FLAG:A
IF LOCAL:3 <= 0 && FLAG:5100
	GOTO NEXT_CARD
ENDIF
LOCAL:1 += 1
SIF LOCAL:1 <= LOCAL:18
	GOTO NEXT_CARD
IF LOCAL:3 > 0
	LOCAL:7 = RESULT:4
	LOCAL:11 = RESULT:1
	; ボーナス計算（base×rate×枚数、×10固定小数点）
	SELECTCASE LOCAL:8
	CASE 6
		LOCAL:12 = LOCAL:7 * 5
	CASE 5
		LOCAL:12 = LOCAL:7 * 5 / 2
	CASE 4
		LOCAL:12 = LOCAL:7 * 2
	CASE 2
		LOCAL:12 = LOCAL:7
	CASE 1
		LOCAL:12 = LOCAL:7 / 2
	CASEELSE
		LOCAL:12 = LOCAL:7
	ENDSELECT
	LOCAL:10 = LOCAL:7 * 10 + LOCAL:12 * (LOCAL:3 - 1)
	SIF LOCAL:3 >= 12
		LOCAL:10 += LOCAL:7 * 30
	LOCAL:15 = LOCAL:10 / 10
	LOCAL:16 = LOCAL:10 - LOCAL:15 * 10
	CALL EVENT_BOARD_GET_CARD_SOURCE, LOCAL:5
	IF RESULT
		LOCALS '= @"通常ガチャ（低確率）／%RESULTS%"
	ELSE
		LOCALS '= @"通常ガチャ"
	ENDIF
	LOCAL:17 = GETCHARA(LOCAL:11)
	IF STR:0 != "" && LOCAL:17 >= 0
		A = LOCAL:17
		SIF LOCAL:3 >= 12
			PRINTFORML %STR:0%（%CALLNAME:A%・キラ・{LOCAL:3}枚 / 合計+{LOCAL:15}.{LOCAL:16}）〔%LOCALS%〕
		SIF LOCAL:3 < 12
			PRINTFORML %STR:0%（%CALLNAME:A%・{LOCAL:3}枚 / 合計+{LOCAL:15}.{LOCAL:16}）〔%LOCALS%〕
	ELSEIF STR:0 != ""
		SIF LOCAL:3 >= 12
			PRINTFORML %STR:0%（キラ・{LOCAL:3}枚 / 合計+{LOCAL:15}.{LOCAL:16}）〔%LOCALS%〕
		SIF LOCAL:3 < 12
			PRINTFORML %STR:0%（{LOCAL:3}枚 / 合計+{LOCAL:15}.{LOCAL:16}）〔%LOCALS%〕
	ELSE
		PRINTFORML カードID:{LOCAL:5}（{LOCAL:3}枚 / 合計+{LOCAL:15}.{LOCAL:16}）〔%LOCALS%〕
	ENDIF
ELSEIF FLAG:5100 == 0
	CALL EVENT_BOARD_GET_CARD_SOURCE, LOCAL:5
	IF RESULT
		PRINTFORML ？？？？？〔主な入手先：通常ガチャ（低確率）／%RESULTS%〕
	ELSE
		PRINTFORML ？？？？？〔主な入手先：通常ガチャ〕
	ENDIF
ENDIF
LOCAL:2 += 1
$NEXT_CARD
LOCAL:5 += 1
SIF LOCAL:2 < 12
	GOTO SCAN_LOOP
GOTO LIST_COMPLETE
$LIST_COMPLETE
PRINTL
IF LOCAL:6 == 0
	PRINTL このレア度の表示対象カードはありません。
ENDIF
PRINTFORML （{LOCAL:2}件表示 / 全{LOCAL:6}件）
PRINTFORML [1] 先頭  [2] 前  [3] 次  [4] 最後尾
; 現在ページの前後5ページを、直接選べる番号ボタンとして表示する
LOCAL:19 = LOCAL:4 - 5
SIF LOCAL:19 < 1
	LOCAL:19 = 1
LOCAL:20 = LOCAL:4 + 5
SIF LOCAL:20 > LOCAL:9
	LOCAL:20 = LOCAL:9
$PAGE_BUTTON_LOOP
SIF LOCAL:19 > LOCAL:20
	GOTO PAGE_BUTTON_END
LOCAL:21 = LOCAL:19 + 9
IF LOCAL:19 == LOCAL:4
	PRINTFORM [{LOCAL:21}] ●{LOCAL:19}  
ELSE
	PRINTFORM [{LOCAL:21}] {LOCAL:19}  
ENDIF
LOCAL:19 += 1
GOTO PAGE_BUTTON_LOOP
$PAGE_BUTTON_END
PRINTL
PRINTFORML [5] 未入手表示を切替  [0] 戻る
INPUT
IF RESULT == 1
	LOCAL:4 = 1
	GOTO PAGE_LOOP
ELSEIF RESULT == 2
	SIF LOCAL:4 > 1
		LOCAL:4 -= 1
	GOTO PAGE_LOOP
ELSEIF RESULT == 3
	SIF LOCAL:4 < LOCAL:9
		LOCAL:4 += 1
	GOTO PAGE_LOOP
ELSEIF RESULT == 4
	LOCAL:4 = LOCAL:9
	GOTO PAGE_LOOP
ELSEIF RESULT >= 10 && RESULT <= 20
	LOCAL:19 = LOCAL:4 - 5
	SIF LOCAL:19 < 1
		LOCAL:19 = 1
	LOCAL:21 = RESULT - 10 + LOCAL:19
	SIF LOCAL:21 <= LOCAL:9
		LOCAL:4 = LOCAL:21
	GOTO PAGE_LOOP
ELSEIF RESULT == 5
	GOTO TOGGLE_MODE
ELSE
	RETURN 1
ENDIF
$TOGGLE_MODE
IF FLAG:5100
	FLAG:5100 = 0
ELSE
	FLAG:5100 = 1
ENDIF
GOTO RECOUNT_PAGES

;--------------------------------------------------
; イベントボーナス計算にカード補正を加算
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI(ARG, ARG:1)
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
;--------------------------------------------------
; キミサキブースター使用 (ITEM:95)
; 所持カードを1枚選んでもう1枚入手する
;--------------------------------------------------
@CARD_COLLECTION_USE_BOOSTER
IF ITEM:95 <= 0
	PRINTFORMW キミサキブースターを持っていません。
	RETURN 0
ENDIF
DRAWLINE
PRINTL 【キミサキブースター使用】
PRINTL 所持カードをもう1枚入手できます。
PRINTFORML 残り: {ITEM:95}個
PRINTL
$BOOSTER_RARITY
PRINTFORML [1]N　[2]R　[3]HR　[4]SR　[5]UR　[6]MR
PRINTFORML [0] キャンセル
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT < 1 || RESULT > 6
	GOTO BOOSTER_RARITY
ENDIF
LOCAL:8 = RESULT
CALL CARD_BOOSTER_SELECT, LOCAL:8
IF RESULT > 0
	LOCAL:7 = RESULT
	ITEM:95 -= 1
	DRAWLINE
	PRINTFORML キミサキブースター使用！（残り{ITEM:95}個）
	CALL GACHA_ACQUIRE_CARD, LOCAL:7
ENDIF
RETURN 0

;--------------------------------------------------
; ブースター用カード選択 ARG:0=レア度 RESULT=カードID(0=キャンセル)
; GLOBAL:3700-3714 をページ内一時保存に使用
;--------------------------------------------------
@CARD_BOOSTER_SELECT(ARG)
LOCAL:8 = ARG:0
LOCAL:4 = 1
; 所持済みカードだけを対象に、総件数とページ数を数える（1ページ15枚）
$BS_RECOUNT
LOCAL:0 = 0
LOCAL:5 = 1
$BS_COUNT
SIF LOCAL:5 > 1884
	GOTO BS_COUNT_END
A = 3000 + LOCAL:5
SIF FLAG:A <= 0
	GOTO BS_COUNT_NEXT
CALL CARD_GET_DATA, LOCAL:5
SIF RESULT:2 == LOCAL:8
	LOCAL:0 += 1
$BS_COUNT_NEXT
LOCAL:5 += 1
GOTO BS_COUNT
$BS_COUNT_END
LOCAL:9 = (LOCAL:0 + 14) / 15
SIF LOCAL:9 > 0 && LOCAL:4 < 1
	LOCAL:4 = 1
SIF LOCAL:9 > 0 && LOCAL:4 > LOCAL:9
	LOCAL:4 = LOCAL:9
$BS_PAGE
DRAWLINE
SELECTCASE LOCAL:8
CASE 1
	PRINTFORML 【N カード選択　{LOCAL:4}/{LOCAL:9}】
CASE 2
	PRINTFORML 【R カード選択　{LOCAL:4}/{LOCAL:9}】
CASE 3
	PRINTFORML 【HR カード選択　{LOCAL:4}/{LOCAL:9}】
CASE 4
	PRINTFORML 【SR カード選択　{LOCAL:4}/{LOCAL:9}】
CASE 5
	PRINTFORML 【UR カード選択　{LOCAL:4}/{LOCAL:9}】
CASEELSE
	PRINTFORML 【MR カード選択　{LOCAL:4}/{LOCAL:9}】
ENDSELECT
PRINTL
LOCAL:18 = (LOCAL:4 - 1) * 15
LOCAL:1 = 0
LOCAL:2 = 0
LOCAL:5 = 1
$BS_SCAN
SIF LOCAL:5 > 1884
	GOTO BS_MENU
A = 3000 + LOCAL:5
LOCAL:3 = FLAG:A
SIF LOCAL:3 <= 0
	GOTO BS_SCAN_NEXT
CALL CARD_GET_DATA, LOCAL:5
SIF RESULT:2 != LOCAL:8
	GOTO BS_SCAN_NEXT
LOCAL:1 += 1
SIF LOCAL:1 <= LOCAL:18
	GOTO BS_SCAN_NEXT
LOCAL:2 += 1
A = 3700 + LOCAL:2
GLOBAL:A = LOCAL:5
LOCAL:11 = RESULT:1
LOCAL:12 = GETCHARA(LOCAL:11)
IF STR:0 != "" && LOCAL:12 >= 0
	A = LOCAL:12
	PRINTFORML [{LOCAL:2}] %STR:0%（%CALLNAME:A%）（{LOCAL:3}枚）
ELSEIF STR:0 != ""
	PRINTFORML [{LOCAL:2}] %STR:0%（{LOCAL:3}枚）
ELSE
	PRINTFORML [{LOCAL:2}] カードID:{LOCAL:5}（{LOCAL:3}枚）
ENDIF
$BS_SCAN_NEXT
LOCAL:5 += 1
SIF LOCAL:2 < 15
	GOTO BS_SCAN
$BS_MENU
IF LOCAL:0 == 0
	PRINTFORMW このレア度の所持カードはありません。
	RETURN 0
ENDIF
PRINTL
PRINTFORML [1-{LOCAL:2}] 選択  [16] 先頭  [17] 前  [18] 次  [19] 最後尾
; 現在ページの前後5ページを横並びの番号ボタンで表示する
LOCAL:19 = LOCAL:4 - 5
SIF LOCAL:19 < 1
	LOCAL:19 = 1
LOCAL:20 = LOCAL:4 + 5
SIF LOCAL:20 > LOCAL:9
	LOCAL:20 = LOCAL:9
$BS_PAGE_BUTTON_LOOP
SIF LOCAL:19 > LOCAL:20
	GOTO BS_PAGE_BUTTON_END
LOCAL:21 = LOCAL:19 + 19
IF LOCAL:19 == LOCAL:4
	PRINTFORM [{LOCAL:21}] ●{LOCAL:19}  
ELSE
	PRINTFORM [{LOCAL:21}] {LOCAL:19}  
ENDIF
LOCAL:19 += 1
GOTO BS_PAGE_BUTTON_LOOP
$BS_PAGE_BUTTON_END
PRINTL
PRINTFORML [0] キャンセル
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT >= 1 && RESULT <= LOCAL:2
	A = 3700 + RESULT
	RETURN GLOBAL:A
ELSEIF RESULT == 16
	LOCAL:4 = 1
	GOTO BS_PAGE
ELSEIF RESULT == 17
	SIF LOCAL:4 > 1
		LOCAL:4 -= 1
	GOTO BS_PAGE
ELSEIF RESULT == 18
	SIF LOCAL:4 < LOCAL:9
		LOCAL:4 += 1
	GOTO BS_PAGE
ELSEIF RESULT == 19
	LOCAL:4 = LOCAL:9
	GOTO BS_PAGE
ELSEIF RESULT >= 20 && RESULT <= 30
	LOCAL:19 = LOCAL:4 - 5
	SIF LOCAL:19 < 1
		LOCAL:19 = 1
	LOCAL:21 = RESULT - 20 + LOCAL:19
	SIF LOCAL:21 <= LOCAL:9
		LOCAL:4 = LOCAL:21
	GOTO BS_PAGE
ENDIF
GOTO BS_PAGE
