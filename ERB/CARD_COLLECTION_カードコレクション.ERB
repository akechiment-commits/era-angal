;==================================================
; CARD_COLLECTION_カードコレクション.ERB
; カード所持一覧・キャラ別補正確認
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
DRAWLINE
PRINTL 【カードコレクション】
PRINTL
PRINTFORML [1] キャラ別カード補正を見る
PRINTFORML [2] レア度別カード一覧
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 2
	CALL CARD_COLLECTION_RARITY_MENU
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; キャラ別カード補正表示
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
PRINTFORML キャラ名              カード  表現力  運動力  学力  好感度
DRAWLINE
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORML %CSVNAME:COUNT%	{CFLAG:COUNT:307}枚  +{CFLAG:COUNT:303}  +{CFLAG:COUNT:304}  +{CFLAG:COUNT:305}  +{CFLAG:COUNT:306}
	ENDIF
REND
PRINTL
LOCAL:9 = 0
REPEAT CHARANUM
	LOCAL:9 += CFLAG:COUNT:307
REND
PRINTFORML 合計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; レア度選択メニュー
;--------------------------------------------------
@CARD_COLLECTION_RARITY_MENU
$LOOP
DRAWLINE
PRINTL 【レア度別カード一覧】
PRINTL
PRINTFORML [1] N（ノーマル）
PRINTFORML [2] R（レア）
PRINTFORML [3] HR（ハイレア）
PRINTFORML [4] SR（スーパーレア）
PRINTFORML [5] UR（ウルトラレア）
PRINTFORML [6] MR（マスターレア）
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT >= 1 && RESULT <= 6
	CALL CARD_COLLECTION_RARITY_LIST, RESULT
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; レア度別カード一覧 ARG:0=レア度(1-6)
; 所持カードのカード名・枚数・ボーナス値を表示
;--------------------------------------------------
@CARD_COLLECTION_RARITY_LIST(ARG)
LOCAL:8 = ARG:0
LOCAL:0 = 1      ;カードID
LOCAL:1 = 0      ;表示件数
$PAGE_LOOP
DRAWLINE
SELECTCASE LOCAL:8
CASE 1
	PRINTL 【N カード一覧】
CASE 2
	PRINTL 【R カード一覧】
CASE 3
	PRINTL 【HR カード一覧】
CASE 4
	PRINTL 【SR カード一覧】
CASE 5
	PRINTL 【UR カード一覧】
CASEELSE
	PRINTL 【MR カード一覧】
ENDSELECT
PRINTFORML カード名				枚数  ボーナス/枚
DRAWLINE
LOCAL:2 = 0      ;このページの件数
$SCAN_LOOP
IF LOCAL:0 > 1748
	GOTO LIST_END
ENDIF
LOCAL:9 = 3000 + LOCAL:0
A = LOCAL:9
IF GLOBAL:A > 0
	CALL CARD_GET_DATA, LOCAL:0
	IF RESULT:2 == LOCAL:8
		IF STR:0 != ""
			PRINTFORML %STR:0%		{GLOBAL:A}枚  +{RESULT:4}/枚
		ELSE
			PRINTFORML ID:{LOCAL:0}		{GLOBAL:A}枚  +{RESULT:4}/枚
		ENDIF
		LOCAL:1 += 1
		LOCAL:2 += 1
	ENDIF
ENDIF
LOCAL:0 += 1
IF LOCAL:2 < 15
	GOTO SCAN_LOOP
ENDIF
PRINTL
PRINTFORML （このページ{LOCAL:2}件 / 累計{LOCAL:1}件）
PRINTFORML [1] 次の15件  [0] 戻る
INPUT
IF RESULT == 1
	GOTO PAGE_LOOP
ELSE
	RETURN 1
ENDIF
$LIST_END
IF LOCAL:1 == 0
	PRINTL このレア度の所持カードはありません。
ELSE
	PRINTFORML 合計 {LOCAL:1}種類のカードを所持
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; イベントボード発揮値にカード補正を加算
; ARG:0=キャラNo ARG:1=補正タイプ(0-3) -> RESULT
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI(ARG, ARG:1)
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
