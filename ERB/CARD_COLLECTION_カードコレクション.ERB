;==================================================
; CARD_COLLECTION_カードコレクション.ERB
;==================================================

@CARD_COLLECTION_MAIN
$LOOP
DRAWLINE
PRINTL 【カードコレクション】
PRINTL
PRINTFORML [1] キャラ別カード補正を見る
PRINTFORML [2] レア度別カード一覧
PRINTFORML [0] 戻る
INPUT
IF RESULT == 1
	CALL CARD_COLLECTION_CHAR_BONUS
ELSEIF RESULT == 2
	CALL CARD_COLLECTION_RARITY_MENU
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; キャラ別カード補正表示（行単位で完結する形式）
;--------------------------------------------------
@CARD_COLLECTION_CHAR_BONUS
DRAWLINE
PRINTL 【キャラ別カード補正】
PRINTL
LOCAL:9 = 0
REPEAT CHARANUM
	IF CFLAG:COUNT:307 > 0
		PRINTFORML %NAME:COUNT%（{CFLAG:COUNT:307}枚）: 表現力+{CFLAG:COUNT:303} 運動力+{CFLAG:COUNT:304} 学力+{CFLAG:COUNT:305} 好感度+{CFLAG:COUNT:306}
		LOCAL:9 += CFLAG:COUNT:307
	ENDIF
REND
PRINTL
PRINTFORML 合計カード数：{LOCAL:9}枚
WAIT
RETURN 1

;--------------------------------------------------
; レア度選択メニュー
;--------------------------------------------------
@CARD_COLLECTION_RARITY_MENU
$LOOP
DRAWLINE
PRINTL 【レア度別カード一覧】
PRINTL
PRINTFORML [1] N（ノーマル）
PRINTFORML [2] R（レア）
PRINTFORML [3] HR（ハイレア）
PRINTFORML [4] SR（スーパーレア）
PRINTFORML [5] UR（ウルトラレア）
PRINTFORML [6] MR（マスターレア）
PRINTL
PRINTFORML [0] 戻る
INPUT
IF RESULT >= 1 && RESULT <= 6
	CALL CARD_COLLECTION_RARITY_LIST, RESULT
ELSEIF RESULT == 0
	RETURN 0
ENDIF
GOTO LOOP

;--------------------------------------------------
; レア度別カード一覧 ARG:0=レア度(1-6)
; A（LOCAL:0）をインデックス用に使うため
; カードIDカウンタはLOCAL:5、レア度はLOCAL:8で保持
;--------------------------------------------------
@CARD_COLLECTION_RARITY_LIST(ARG)
LOCAL:8 = ARG:0
LOCAL:5 = 1
LOCAL:1 = 0
$PAGE_LOOP
DRAWLINE
SELECTCASE LOCAL:8
CASE 1
	PRINTL 【N カード一覧】
CASE 2
	PRINTL 【R カード一覧】
CASE 3
	PRINTL 【HR カード一覧】
CASE 4
	PRINTL 【SR カード一覧】
CASE 5
	PRINTL 【UR カード一覧】
CASEELSE
	PRINTL 【MR カード一覧】
ENDSELECT
DRAWLINE
LOCAL:2 = 0
$SCAN_LOOP
IF LOCAL:5 > 1748
	GOTO LIST_END
ENDIF
;所持枚数確認
A = 3000 + LOCAL:5
LOCAL:3 = GLOBAL:A
IF LOCAL:3 > 0
	CALL CARD_GET_DATA, LOCAL:5
	;RESULT:2=レア度をLOCAL:6に退避（RETURNで上書きされる前に）
	LOCAL:6 = RESULT:2
	LOCAL:7 = RESULT:4
	IF LOCAL:6 == LOCAL:8
		IF STR:0 != ""
			PRINTFORML 【{LOCAL:6}】%STR:0%（{LOCAL:3}枚 / +{LOCAL:7}/枚）
		ELSE
			PRINTFORML 【{LOCAL:6}】カードID:{LOCAL:5}（{LOCAL:3}枚 / +{LOCAL:7}/枚）
		ENDIF
		LOCAL:1 += 1
		LOCAL:2 += 1
	ENDIF
ENDIF
LOCAL:5 += 1
IF LOCAL:2 < 15
	GOTO SCAN_LOOP
ENDIF
PRINTL
PRINTFORML （{LOCAL:2}件表示 / 累計{LOCAL:1}件）
PRINTFORML [1] 次の15件  [0] 戻る
INPUT
IF RESULT == 1
	GOTO PAGE_LOOP
ELSE
	RETURN 1
ENDIF
$LIST_END
IF LOCAL:1 == 0
	PRINTL このレア度の所持カードはありません。
	;---デバッグ: 最初の10枚のGLOBAL値と最終チェックカード数---
	PRINTFORML [DBG] checked cards 1..{LOCAL:5} target_rarity={LOCAL:8}
	LOCAL:9 = 1
	$DBG_LOOP
		IF LOCAL:9 > 10
			GOTO DBG_END
		ENDIF
		A = 3000 + LOCAL:9
		LOCAL:3 = GLOBAL:A
		IF LOCAL:3 > 0
			CALL CARD_GET_DATA, LOCAL:9
			PRINTFORML [DBG] cardID={LOCAL:9} count={LOCAL:3} rarity={RESULT:2}
		ENDIF
		LOCAL:9 += 1
		GOTO DBG_LOOP
	$DBG_END
ELSE
	PRINTFORML 合計 {LOCAL:1}種類のカードを所持
ENDIF
WAIT
RETURN 1

;--------------------------------------------------
; イベントボード発揮値にカード補正を加算
;--------------------------------------------------
@CARD_BONUS_FOR_HAKKIICHI(ARG, ARG:1)
LOCAL:0 = ARG:0
LOCAL:1 = ARG:1
CALL CARD_GET_BONUS, LOCAL:0, LOCAL:1
RETURN RESULT
