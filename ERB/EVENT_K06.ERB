;--------------------------------------------------
;今仲間に居るキャラをランダムで選ぶ
;ARG:0;選択する人数（最大10人）
;ARG:1;除外キャラの登録番号
;--------------------------------------------------
@RAND_CHARANUMBER(ARG:0 = 1, ARG:1 = -1)
#DIM LCOUNT, 1
VARSET LOCAL
FOR LCOUNT, 0, ARG:0
	WHILE 1
		LOCAL:LCOUNT = RAND:CHARANUM
		;除外キャラか選択済みか別れている場合はやり直し
		SIF LOCAL:LCOUNT != ARG:1 && MATCH(LOCAL, LOCAL:LCOUNT, 0, LCOUNT) == 0 && CFLAG:(LOCAL:LCOUNT):21 != 1
			 BREAK
	WEND
NEXT
RETURN LOCAL:0, LOCAL:1, LOCAL:2, LOCAL:3, LOCAL:4, LOCAL:5, LOCAL:6, LOCAL:7, LOCAL:8, LOCAL:9

;--------------------------------------------------
;絵皿関数（通常はDAY:5の7種×DAY:1で30種×DAY:2で4種×TIMEで2種の絵皿が出来る）
;EZARA(TIME:1, DAY:5, DAY:1, DAY:2, TIME:0)
;--------------------------------------------------
@EZARA(ARG:0, ARG:1, ARG:2, ARG:3, ARG:4)
#FUNCTIONS
#DIM LCOUNT, 1
#DIMS EZARA, 1
;元旦
IF ARG:0 == 11
	EZARA = 日の出絵皿
;雛祭り
ELSEIF ARG:0 == 12
	EZARA = 雛人形絵皿
;梅雨
ELSEIF ARG:0 == 21
	EZARA = 紫陽花絵皿
;七夕
ELSEIF ARG:0 == 22
	EZARA = 七夕絵皿
;お盆
ELSEIF ARG:0 == 24
	EZARA = 茄子馬絵皿
;ハーヴェスト
ELSEIF ARG:0 == 30
	EZARA = 豊穣祭の絵皿
;十五夜
ELSEIF ARG:0 == 36
	EZARA = 中秋の名月絵皿
;彼岸入り
ELSEIF ARG:0 == 38
	EZARA = 彼岸花絵皿
;ハロウィン
ELSEIF ARG:0 == 40
	EZARA = 南瓜絵皿
;節分
ELSEIF ARG:0 == 42
	EZARA = 節分絵皿
;通常
ELSE
	;曜日
	SELECTCASE ARG:1
	;月
	CASE 0
		SPLIT "03,11,14,29/12/18,19,26", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "月/月の輪/夜/黒", "/", LOCALS
	;火
	CASE 1
		SPLIT "04,12,16,18,20,21,25,29,30/11,14,19,28/23", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "火/炎/不死/赤", "/", LOCALS
	;水
	CASE 2
		SPLIT "04,12,13,14,15,22,23,25,27/5,10,18,19,26/21,24,28,29/1,2,7,11,16,17,30", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "水/雨/海/蒼/青", "/", LOCALS
	;木
	CASE 3
		SPLIT "06,11,14,15,16,25,27,30/4,5,7,8,9,21,26,28,31/1,10,18,20,24,29/17,19,23/13", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "木/草/緑/若/金木/茶", "/", LOCALS
	;金
	CASE 4
		SPLIT "01,06,13,25/07,11,20,21,24,26", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "鉄/銀/金", "/", LOCALS
	;土
	CASE 5
		SPLIT "09,10,12,14,16,17,20,25/05,15,28/01,06,08,11,13,22,26,29,31", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "岩/土/石/地", "/", LOCALS
	;日
	CASE 6
		SPLIT "03,17/05,08,09,10,12,13,14,15,16,22,23,24,25,27,28,31", "/", LOCALS
		FOR LCOUNT, 0, RESULT
			SIF STRFIND(LOCALS:LCOUNT, TOSTR(ARG:2, "00")) > -1
				BREAK
		NEXT
		SPLIT "昼寝/白/天", "/", LOCALS
	ENDSELECT
	EZARA = %LOCALS:(LCOUNT - 1)%
	
	;日付けを50音順
	SPLIT "犬/猪/兎/牛/鰻/馬/狼/蛙/蟹/亀/狐/熊/犀/魚/蠍/猿/獅子/雀/鷹/狸/燕/虎/鳥/猫/鼠/隼/羊/蛇/蛍/龍/鰐", "/", LOCALS
	EZARA = %EZARA + LOCALS:(ARG:2 - 1)%
	
	;季節（{DAY:2}{TIME:0}）
	SPLIT "00/01/10/11/20/21/30/31", "/", LOCALS
	FOR LCOUNT, 0, RESULT
		SIF LOCALS:LCOUNT == TOSTR(ARG:3) + TOSTR(ARG:4)
			BREAK
	NEXT
	SPLIT "の霞絵皿/の夜桜絵皿/の唐草絵皿/の山水絵皿/の落葉絵皿/の秋月絵皿/の雪絵皿/の氷雪絵皿", "/", LOCALS
	EZARA = %EZARA + LOCALS:(LCOUNT - 1)%
ENDIF
RETURNF EZARA

