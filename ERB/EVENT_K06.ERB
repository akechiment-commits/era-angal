;eratohoJ用口上テンプレート 2013_01_28版
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1をキャラ番号に置換してください（例:霊夢→1、レミリア→10）
;-------------------------------------------------
;--------------------------------------------------
;口上ファイルの存在判定（X1をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
A = 100+6
FLAG:A = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
A = 100+6
FLAG:A = 0

;キャラ選択時の強調用
@KOJO_EXIST_K6
RETURN 1

;--------------------------------------------------
;同定構文
;--------------------------------------------------
;口上の存在を返す
@KOJO_K6(ARG)
;RESULTS = ""
RETURN 1

;口上IDを返す(IDは8桁[A-Z+0-9])
@KOJO_K6_IDENTIFY
RESULTS = 3WXQMO9W
RETURN 1

;口上名称を返す
@KOJO_K6_NAME
RESULTS = eratohoJ+用美鈴口上
RETURN 1

;--------------------------------------------------
;純愛イベント口上
