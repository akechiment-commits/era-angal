	CALL MEIRIN_CONFIG
	CFLAG:220 = 1
ENDIF
;-------------------------------------------------
;オープニング　CALL COMMON_PLANE_TEXTと入力すると共通文使用
;-------------------------------------------------
IF TFLAG:600 == 28
	CALL COMMON_PLANE_TEXT
