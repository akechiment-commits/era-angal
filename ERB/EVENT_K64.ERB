;--------------------------------------------------
;口上ファイルの存在判定（63をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:(100+63) = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
FLAG:(100+63) = 0

;キャラ選択時の強調用
@KOJO_EXIST_K64
RETURN 1

