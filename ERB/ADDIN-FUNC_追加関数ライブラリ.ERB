	GOTO IL_RETRY_OR_LOAD
IF RESULT == 1
	FLAG:60 = 1
	PRINTFORMW 先ほどのやり取りを取り消しました
	PRINTFORMW %CALLNAME:MASTER%の体力が1まで回復した
