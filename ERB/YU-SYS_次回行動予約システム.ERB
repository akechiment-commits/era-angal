;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;Ver2.03
@EVENTTRAIN
#PRI
CALL PREV_RECORD_EVENTTRAIN

;CALL KOJO_CUT_RETURNはCFLAGを利用しているのでコメントアウト
@EVENTCOM
#LATER
;SELECTCOM属性取得
CALL SELECTCOM_TYPE
;主導権判定を潰していた場合、復帰させる
IF CFLAG:15 <= -10000	; 【[主導権設定]】
	CFLAG:15 += 10000
	;毎回指定するに戻す
	FLAG:23 -= (FLAG:23 & 8)
ENDIF
SIF CFLAG:15 <= -1000	; 【[主導権設定]】
	CFLAG:15 += 1000
;CALL KOJO_CUT_RETURN
@EVENTCOMEND
	#PRI
	SIF TARGET < 0
		RETURN 0
CALL PREV_RECORD_EVENTCOMEND

@EVENTEND
CALL PREV_RECORD_EVENTEND

@PREV_RECORD_EVENTTRAIN
;初期状態の調整
IF PREVCOM:996 == 0
	REPEAT 998
		PREVCOM:COUNT = -1
	REND
PREVCOM:680 = 0
PREVCOM:700 = 0
PREVCOM:720 = 0
PREVCOM:740 = 0
PREVCOM:760 = 0
PREVCOM:780 = 0
ENDIF
;調教開始からのコマンド実行回数
PREVCOM:998 = 0
;サーチ条件の初期化
I = 981
REPEAT 13
	PREVCOM:I = -2
	I += 1
REND
PREVCOM:617 = -2
PREVCOM:618 = -2
PREVCOM:619 = -2
PREVCOM:637 = -2
PREVCOM:638 = -2
PREVCOM:639 = -2
PREVCOM:679 = -2
;SELECTCOM属性を初期化
SELECTCOM:997 = -1
;PREVCOM属性を初期か
PREVCOM:997 = -1
;存在判定
SIF CFLAG:70 == 0	; 【[ゆーしす存在判定]==0】
	CFLAG:70 = 1
@PREV_RECORD_EVENTEND
SIF TARGET < 0
	RETURN 0
;PREVCOMを上から50づつひいていく。
;ただし、150~101の間は100づつひいていく
I = 600
REPEAT 500
	IF I <= 150
		PREVCOM:I = PREVCOM:(I-100)
	ELSE
		PREVCOM:I = PREVCOM:(I-50)
	ENDIF
	I -= 1
REND
;今回の調教履歴に-1を突っ込む
REPEAT 101
	PREVCOM:COUNT = -1
REND

I = 906
I:1 = 16
REPEAT 306
	IF I == 901
		PREVCOM:901 = EX:5
	ELSEIF I == 881
		PREVCOM:881 = EX:4
	ELSEIF I == 861
		PREVCOM:861 = EX:3
	ELSEIF I == 841
		PREVCOM:841 = EX:2
	ELSEIF I == 821
		PREVCOM:821 = EX:1
	ELSEIF I == 801
		PREVCOM:801 = EX:0
	ELSEIF I == 781
		PREVCOM:781 = PREVCOM:780
	ELSEIF I == 761
		PREVCOM:761 = PREVCOM:760
	ELSEIF I == 741
		PREVCOM:741 = PREVCOM:740
	ELSEIF I == 721
		PREVCOM:721 = PREVCOM:720
	ELSEIF I == 701
		PREVCOM:701 = PREVCOM:700
	ELSEIF I == 681
		PREVCOM:681 = PREVCOM:680
	ELSEIF I == 661
		PREVCOM:661 = TFLAG:44
	ELSEIF I == 641
		;夜は日付がマイナスになる
		IF TIME
			PREVCOM:641 = -(DAY + 1)
		ELSE
			PREVCOM:641 = (DAY + 1)
		ENDIF
	ELSEIF I == 621
		IF ASSI > 0
			PREVCOM:621 = NO:ASSI
		ELSE
			PREVCOM:621 = -2
		ENDIF
	ELSEIF I == 601
		PREVCOM:601 = NO:TARGET
	ELSEIF I:1 == 0
		PREVCOM:I = 0
	ELSEIF I:1 == 17 || I:1 == 18 || I:1 == 19
		PREVCOM:I = -2
	ELSE
		PREVCOM:I = PREVCOM:(I - 1)
	ENDIF
	I -= 1
	I:1 = (I % 20)
REND
;BEGIN TURNENDするとここにこないけどまぁ誤差ってことで
;パートナーと過ごした回数をカウント
CFLAG:71 += 1

;パートナーとウフフした回数をカウント
SIF TFLAG:44	; 【[ウフフ中]】
	CFLAG:73 += 1
IF ASSI >= 0
	;助手とすごした回数をカウント
	CFLAG:ASSI:72 += 1
	;助手とウフフした回数をカウント
	CFLAG:ASSI:74 += 1
ENDIF
;とりあえず使った関数を0に
I = 0
I:1 = 0

@PREV_RECORD_EVENTCOMEND
	SIF TARGET < 0
		RETURN 0
;射精回数カウント
;アナルセックス
IF SELECTCOM == 22 || SELECTCOM == 26 || SELECTCOM == 27 || SELECTCOM == 28 || SELECTCOM == 29 || SELECTCOM == 36	; 【コマンド:[アナルセックス] / コマンド:[正常位アナル] / コマンド:[後背位アナル] / コマンド:[対面座位アナル] / コマンド:[背面座位アナル] / コマンド:[騎乗位アナル]】
	IF ASSIPLAY	; 【調教者:[助手]】
		PREVCOM:760 += TFLAG:2
	ELSE
		PREVCOM:700 += TFLAG:2
	ENDIF
;セックス
ELSEIF SELECTCOM == 20 || SELECTCOM == 21 || SELECTCOM == 24 || SELECTCOM == 25 || SELECTCOM == 34 || SELECTCOM == 88	; 【コマンド:[正常位] / コマンド:[後背位] / コマンド:[対面座位] / コマンド:[背面座位] / コマンド:[騎乗位]】
	IF ASSIPLAY	; 【調教者:[助手]】
		PREVCOM:740 += TFLAG:2
	ELSE
		PREVCOM:680 += TFLAG:2
	ENDIF
;3P
ELSEIF SELECTCOM == 64
	IF TFLAG:40 == 1	; 【[３Ｐ時主人行動]==1】
		PREVCOM:680 += TFLAG:2
	ELSEIF TFLAG:40 == 2	; 【[３Ｐ時主人行動]==2】
		PREVCOM:700 += TFLAG:2
	ELSEIF TFLAG:40 == 3	; 【[３Ｐ時主人行動]==3】
		PREVCOM:720 += TFLAG:2
	ENDIF
	IF TFLAG:41 == 1	; 【[３Ｐ時助手行動]==1】
		PREVCOM:740 += TFLAG:6
	ELSEIF TFLAG:41 == 2	; 【[３Ｐ時助手行動]==2】
		PREVCOM:760 += TFLAG:6
	ELSEIF TFLAG:41 == 3	; 【[３Ｐ時助手行動]==3】
		PREVCOM:780 += TFLAG:6
	ENDIF
;ダブルフェラ・ダブル素股
ELSEIF SELECTCOM == 68 || SELECTCOM == 62	; 【コマンド:[ダブルフェラ] / コマンド:[ダブル素股]】
	PREVCOM:720 += (TFLAG:0 + TFLAG:9)
;Wフェラ
ELSEIF SELECTCOM == 66	; 【コマンド:[Ｗフェラ]】
	PREVCOM:720 += TFLAG:0
	PREVCOM:780 += TFLAG:6
;そのほか射精(奉仕射精)
ELSE
	IF ASSIPLAY	; 【調教者:[助手]】
		PREVCOM:780 += (TFLAG:0 + TFLAG:1 + TFLAG:4 + TFLAG:6 + TFLAG:9)
	ELSE
		PREVCOM:720 += (TFLAG:0 + TFLAG:1 + TFLAG:4 + TFLAG:9)
	ENDIF
ENDIF
;初回の履歴は100でカンスト
IF PREVCOM:998 <= 100
	PREVCOM:998 += 1
ENDIF
;100回を越えた場合は履歴更新作業中止
SIF PREVCOM:998 == 101
	RETURN 0


I = PREVCOM:998
;PREVCOM:n にn回前の調教内容を保存
;上から一つ前の内容で再設定していく。
REPEAT I
	PREVCOM:I = PREVCOM:(I-1)
	I -= 1
REND

;PREVCOM:1はSELECTCOMをいれる。ただしデートの場合は終了時にもとってしまうと問題がでるので例外処理(デート終了時の場合は323が格納)
IF SELECTCOM == 323 && TEQUIP:2	; 【コマンド:[デート] / [デート中]使用中】
	PREVCOM:1 = 1000
ELSE
	PREVCOM:1 = SELECTCOM
ENDIF
;デートの場合は1000台特殊
IF PREVCOM:1 == 1000
	PREVCOM:1 += TEQUIP:2
;プレゼントの場合は2000台特殊
ELSEIF PREVCOM:1 == 302
	PREVCOM:1 = 2000
	PREVCOM:1 += TFLAG:17
;SM系で主導権が向こうにある場合は+3000
ELSEIF (PREVCOM:1 == 40 || PREVCOM:1 == 41 || PREVCOM:1 == 42 || PREVCOM:1 == 75) && TFLAG:45 == 1	; 【[主導権]==1】
	PREVCOM:1 += 3000
ENDIF
;助手調教の場合は+10000
IF ASSIPLAY	; 【調教者:[助手]】
	PREVCOM:1 += 10000
ENDIF
;PREVCOM属性の取得
PREVCOM:997 = SELECTCOM:997

;SELECTCOM属性を消去
SELECTCOM:997 = -1
@SELECTCOM_TYPE
;SELECTCOMの属性決定　派生系は派生前の属性をとるんで注意。たとえばシックスナインはクンニ指定でだすと愛撫属性、フェラ指定でだすと奉仕属性になる
;愛撫系 愛撫・クンニ・胸愛撫・指挿入　アナル愛撫はちょっと特殊なんで除く方向で（ローター削除注意）
IF SELECTCOM == 0 || SELECTCOM == 1 || SELECTCOM == 5 || SELECTCOM == 8	; 【コマンド:[愛撫] / コマンド:[クンニ] / コマンド:[胸愛撫] / コマンド:[指挿入れ]】
	SELECTCOM:997 = 1
;セックス系 騎乗位がちょっと微妙だけどとりあえずこっちに区分
ELSEIF SELECTCOM == 20 || SELECTCOM == 21 || SELECTCOM == 24 || SELECTCOM == 25 || SELECTCOM == 34	; 【コマンド:[正常位] / コマンド:[後背位] / コマンド:[対面座位] / コマンド:[背面座位] / コマンド:[騎乗位]】
	SELECTCOM:997 = 2
;Aセックス系 アナルセックスを除き、デフォで封印設定。封印されててもSELECTCOM指定だと普通にでてくるから注意
ELSEIF SELECTCOM == 22 || SELECTCOM == 26 || SELECTCOM == 27 || SELECTCOM == 28 || SELECTCOM == 29  || SELECTCOM == 36	; 【コマンド:[アナルセックス] / コマンド:[正常位アナル] / コマンド:[後背位アナル] / コマンド:[対面座位アナル] / コマンド:[背面座位アナル] / コマンド:[騎乗位アナル]】
	SELECTCOM:997 = 3
;奉仕系 足扱きはのぞくことに
ELSEIF SELECTCOM == 30 || SELECTCOM == 31 || SELECTCOM == 32 || SELECTCOM == 33 || SELECTCOM == 35	; 【コマンド:[手淫] / コマンド:[フェラチオ] / コマンド:[パイズリ] / コマンド:[素股] / コマンド:[泡踊り]】
	SELECTCOM:997 = 4
;S系 奴隷がS、つまり主人が鞭打たれる側,性質的に足扱きはこっちに
ELSEIF (SELECTCOM == 40 || SELECTCOM == 41 || SELECTCOM == 42 || SELECTCOM == 37 || SELECTCOM == 75) && TFLAG:45 == 1	; 【コマンド:[スパンキング] / コマンド:[鞭] / コマンド:[針] / コマンド:[足扱き] / コマンド:[言葉責め] / [主導権]==1】
	SELECTCOM:997 = 5
;M系 奴隷がM、つまり奴隷を鞭打つ場合、一応装備もいれたけど微妙な気分
ELSEIF SELECTCOM == 40 || SELECTCOM == 41 || SELECTCOM == 42 || SELECTCOM == 75 || SELECTCOM == 43 && TEQUIP:43 == 0 || (SELECTCOM == 44 && TEQUIP:44 == 0) || (SELECTCOM == 45 && TEQUIP:45 == 0)	; 【コマンド:[スパンキング] / コマンド:[鞭] / コマンド:[針] / コマンド:[言葉責め] / コマンド:[アイマスク] / コマンド:[縄] / コマンド:[ボールギャグ] / 無[アイマスク] / 無[縄で緊縛] / 無[ボールギャグ]】
	SELECTCOM:997 = 6
;キス系 一応ウフフ版のキスも
ELSEIF SELECTCOM == 6 || SELECTCOM == 340 || SELECTCOM == 341 || SELECTCOM == 342	; 【コマンド:[キスする] / コマンド:[バードキス] / コマンド:[ソフトキス] / コマンド:[ディープキス]】
	SELECTCOM:997 = 7
;着衣愛撫系 着衣セックスで悩むけど、まぁとりあえずおいておこう
ELSEIF SELECTCOM == 360 || SELECTCOM == 361 || SELECTCOM == 362	; 【コマンド:[胸愛撫] / コマンド:[愛撫] / コマンド:[指挿入れ]】
	SELECTCOM:997 = 8
ENDIF
;--------------------------------------------------
;@KOJO_NEXT_PLAY関係
;コマンド実行時に出力されます
;--------------------------------------------------
@ABNOMALCOMABLE(ARG)
#FUNCTION
;自慰
IF ARG == 3
	SIF TEQUIP:撮影中
		RETURNF 1
ENDIF
;バイブ(処女)
IF ARG == 11
	SIF (EXP:0 < EXPLV:1)	; 【[Ｖ経験]<EXPLV:1】
		RETURNF 1
ENDIF
;アナルバイブ
SIF ARG == 13
	RETURNF 1
;正常位・後背位・対面座位・背面座位
IF ARG == 20 || ARG == 21 || ARG == 24 || ARG == 25
	SIF (EXP:0 < EXPLV:1) && (ASSIPLAY && (TALENT:PLAYER:オトコ == 0))	; 【[Ｖ経験]<EXPLV:1 / 調教者:[助手]】
		RETURNF 1
ENDIF
;逆レイプ
IF ARG == 23
	SIF (TALENT:PLAYER:0 == 1)	; 【PLAYER:[処女]】
		RETURNF 1
ENDIF
;正常位アナル/後背位アナル/対面座位アナル/背面座位アナル
;正式実装する際に、アナルセックスを継承するなら異常経験が付く
;SIF ARG >= 26 &&  ARG <= 29
;	RETURNF 1
;騎乗位アナル
SIF ARG == 36
	RETURNF 1
;鞭/針/縄/ボールギャグ
SIF ARG == 41 || ARG == 42 || ARG == 44 || ARG == 45
	RETURNF 1
;空気浣腸
;異常経験フィルタ(まとめのみの条件。Jオリジナルでは封印コマンド＆異常経験つかないのでこの条件なし)
SIF ARG == 47
	RETURNF 1

;拡張バルーン
;異常経験フィルタ(もっと条件細かくなるけど、封印コマンドだし良いよね？)
SIF ARG == 48
	RETURNF 1

;媚薬
SIF ARG == 51
	RETURNF 1

;ビデオ撮影
SIF ARG == 53
	RETURNF 1

;野外プレイ
SIF ARG == 54
	RETURNF 1

;助手を犯す
IF ARG == 56
	SIF ASSI >= 0 && (TALENT:ASSI:処女 == 1)
		RETURNF 1
ENDIF

;3P
SIF ARG == 64
	RETURNF 1

;助手を犯させる
SIF ARG == 65
	RETURNF 1

;公開ライブ
SIF ARG == 74
	RETURNF 1
;虫召喚
SIF ARG == 79
	RETURNF 1
;両穴フィスト
SIF ARG == 83
	RETURNF 1
;触手召喚
SIF ARG == 100
	RETURNF 1
;膣酒呑み
SIF ARG == 128
	RETURNF 1
;吸血
SIF ARG == 150
	RETURNF 1
;吸血させる
SIF ARG == 151 && (EXP:56 == 0)	; 【[吸血経験]==0】
	RETURNF 1
;焼芋責め
SIF ARG == 154 && (EXP:0 < EXPLV:1)	; 【[Ｖ経験]<EXPLV:1】
	RETURNF 1
;蜘蛛の脚　封印コマンドすぎるから中身のチェックはしない
SIF ARG == 159 && (EXP:0 < EXPLV:1) && (PREVCOM == 159 && TEQUIP:11 == 0 && TEQUIP:13 == 0 && TEQUIP:14 == 0 && TEQUIP:15 == 0 && TEQUIP:16 == 0 && TEQUIP:19 == 0 && TEQUIP:46 == 0 && TEQUIP:47 == 0 && TEQUIP:48 == 0 && TEQUIP:49 == 0 && TEQUIP:61 == 0 && TEQUIP:70 == 0 && TEQUIP:71 == 0 && TEQUIP:79 == 0)	; 【[Ｖ経験]<EXPLV:1 / 無[バイブ] / 無[アナルバイブ] / 無[クリキャップ] / 無[クリップローター] / 無[搾乳機] / 無[アナルビーズ] / 無[普通の浣腸] / 無[空気浣腸] / 無[バルーン] / 無[アナル電極] / 無[クスコ] / 無[巨峰] / 無[焼芋] / 無[氷柱]】
	RETURNF 1
;角挿入
SIF ARG == 167 && (EXP:0 < EXPLV:1) && (TALENT:PLAYER:122 == 0)	; 【PLAYER:[オトコ]なし / [Ｖ経験]<EXPLV:1】
	RETURNF 1
;正常位させる・後背位させる・騎上位する・セックスさせる
IF ARG == 193 || ARG == 194 || ARG == 195 || ARG == 381
	SIF (TALENT:PLAYER:処女 == 1)
		RETURNF 1
ENDIF
;挿入Ｇスポ責め/挿入子宮口責め実行判定;これ、先に処女奪うから無理なんじゃ
IF ARG == 255 || ARG == 256
	SIF (EXP:0 < EXPLV:1) && (ASSIPLAY && (TALENT:PLAYER:オトコ == 0))	; 【[Ｖ経験]<EXPLV:1 / 調教者:[助手]】
		RETURNF 1
ENDIF
;オムツ
SIF ARG == 371
	RETURNF 1
;着衣フェラチオ
SIF ARG == 373 && TEQUIP:デート中 > 0
	RETURNF 1
;着衣フェラする
SIF ARG == 380  && (TEQUIP:デート中 > 0)
	RETURNF 1
;衣装破り
SIF ARG == 392
	RETURNF 1
RETURNF 0


