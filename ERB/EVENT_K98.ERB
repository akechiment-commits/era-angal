;エキストラモード構文　CFLAG:220を使用
;仲間にした時に口上設定用の素質に変更できます
;下記に処女・Ｖ経験無しに変更する場合の構文をサンプルとして載せておきます
;-------------------------------------------------
IF TFLAG:600 == 0 && CFLAG:220 == 0
	PRINTFORML  ＜%NAME:TARGET%の口上設定＞
	PRINTFORML 口上に合わせて%NAME:TARGET%の素質変化及び初期好感度にボーナスを加えて宜しいでしょうか？
	PRINTL [0] はい
	PRINTL [1] いいえ
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―%NAME:TARGET%の素質諸々を口上に合わせて変更します―
		ABL:TARGET:0 = 3
		TALENT:TARGET:13 = 1
		TALENT:TARGET:18 = 0
		EXP:TARGET:0 = 10
		EXP:TARGET:2 = 15
		CFLAG:2 += 870
	ELSEIF RESULT == 1
		PRINTFORMW ―通常の状態で開始します―
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:220 = 1
ENDIF
