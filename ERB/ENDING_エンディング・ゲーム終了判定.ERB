		PRINTFORML  
		PRINTFORMW 主人公の状態を引き継いで、最初からやり直せます。どうしますか？
		PRINTFORML [0] こんな事はなかった事に！
		PRINTFORML [1] 周回プレイ反対！俺は１周でクリアしてみせるぜ！！
		$INPUT_LOOP_PH
		INPUT
		IF RESULT != 0 && RESULT != 1
			PRINTFORML 正しい値を入力してください
			GOTO INPUT_LOOP_PH
		ELSEIF RESULT == 0
			PRINTFORMW それでは1日目、1年生の4月に戻ります。次は頑張って下さい
			REPEAT CHARANUM
				SIF TALENT:COUNT:134 || MARK:COUNT:90
					CFLAG:COUNT:110 -= DAY
			REND
			DAY = 0
			TIME = 0
			FLAG:24 = 1
			FLAG:25 = 0
			FLAG:26 += 1
			FLAG:27 = 0
			FLAG:31 = 0
			FLAG:32 = 0
			TARGET = -1
			ASSI = -1
			A = CHARANUM
			REPEAT A
				SIF CHARANUM > 1
					DELCHARA 1
			REND
			CALL START_PARTNER_SELECT

			;耐力＝体力を基準値として、絶頂経験で増加
			MAXBASE:TARGET:4 = MAXBASE:TARGET:0 * (100 + EXP:TARGET:2) / 100
			;魔力＝気力の10%を基準値として、精液経験で増加
			MAXBASE:TARGET:5 = MAXBASE:TARGET:1 / 10 * (50 + EXP:TARGET:20) / 50
			BASE:TARGET:4 = MAXBASE:TARGET:4
			BASE:TARGET:5 = MAXBASE:TARGET:5

		ELSEIF RESULT == 1
			PRINTFORMW その心意気、ご立派です。次は頑張って下さい
			PRINTFORMW お疲れ様でした。ゲームを終了します
			QUIT
		ENDIF
		RETURN 1
	ENDIF
ELSEIF FLAG:5 != 9 && FLAG:5 != 10 && FLAG:24 <= 3
	LOCAL:9 = DAY / 10 % 12
	LOCAL:6 = DAY % 10 + 1
	SIF TARGET < 0
		TARGET = 1
	;月変わり検出 → イベントポイント月次リセット＆報酬
	IF FLAG:31 != LOCAL:9
		FLAG:31 = LOCAL:9
		IF FLAG:32 >= 50
			PRINTFORML 【月次報酬】イベントPT:{FLAG:32}達成！
			PRINTFORML 　好感度+10 プラチナチケット+1 ゴールドチケット+1
			SIF TARGET >= 0
				CFLAG:TARGET:2 += 10
			FLAG:116 += 1
			FLAG:115 += 1
			WAIT
		ELSEIF FLAG:32 >= 30
			PRINTFORML 【月次報酬】イベントPT:{FLAG:32}達成！
			PRINTFORML 　好感度+5 ゴールドチケット+1 シルバーチケット+1
			SIF TARGET >= 0
				CFLAG:TARGET:2 += 5
			FLAG:115 += 1
			FLAG:114 += 1
			WAIT
		ELSEIF FLAG:32 >= 15
			PRINTFORML 【月次報酬】イベントPT:{FLAG:32}達成！
			PRINTFORML 　好感度+2 シルバーチケット+1 ブロンズチケット+2
			SIF TARGET >= 0
				CFLAG:TARGET:2 += 2
			FLAG:114 += 1
			FLAG:113 += 2
			WAIT
		ELSEIF FLAG:32 >= 5
			PRINTFORML 【月次報酬】イベントPT:{FLAG:32}達成！
			PRINTFORML 　ブロンズチケット+1
			FLAG:113 += 1
			WAIT
		ENDIF
		FLAG:32 = 0
	ENDIF
	;月indexと日数で試験自動発動（FLAG:27=ビットマスク）
	; 6月末(idx==2,day>=9) → 中間試験1
	IF LOCAL:9 == 2 && LOCAL:6 >= 9 && (FLAG:27 & 1) == 0
		TFLAG:83 = 0
		TFLAG:84 = 1
		CALL SEMESTER_EXAM_AUTO
		RETURN 1
	; 7月末(idx==3,day>=9) → 期末試験1
	ELSEIF LOCAL:9 == 3 && LOCAL:6 >= 9 && (FLAG:27 & 2) == 0
		TFLAG:83 = 1
		TFLAG:84 = 2
		CALL SEMESTER_EXAM_AUTO
		RETURN 1
	; 11月末(idx==7,day>=9) → 中間試験2
	ELSEIF LOCAL:9 == 7 && LOCAL:6 >= 9 && (FLAG:27 & 4) == 0
		TFLAG:83 = 0
		TFLAG:84 = 4
		CALL SEMESTER_EXAM_AUTO
		RETURN 1
	; 12月中旬(idx==8,day>=5) → 期末試験2
	ELSEIF LOCAL:9 == 8 && LOCAL:6 >= 5 && (FLAG:27 & 8) == 0
		TFLAG:83 = 1
		TFLAG:84 = 8
		CALL SEMESTER_EXAM_AUTO
		RETURN 1
	; 2月末(idx==10,day>=9) → 3学期試験
	ELSEIF LOCAL:9 == 10 && LOCAL:6 >= 9 && (FLAG:27 & 16) == 0
		TFLAG:83 = 1
		TFLAG:84 = 16
		CALL SEMESTER_EXAM_AUTO
		RETURN 1
	; 3月末(idx==11,day>=9) → 進級・卒業
	ELSEIF LOCAL:9 == 11 && LOCAL:6 >= 9 && (FLAG:27 & 32) == 0
		FLAG:27 |= 32
		FLAG:24 += 1
		IF FLAG:24 > 3
			PRINTFORMW おめでとう！ 3年間の学院生活を終え、卒業しました！
			TRYCALL GAME_CONTINUE
		ELSE
			FLAG:27 = 0
			CALL GET_SEMESTER_NAME
			PRINTFORMW {FLAG:24}年生になりました！新しい年度の4月が始まります！
		ENDIF
		RETURN 1
	ENDIF
ENDIF

