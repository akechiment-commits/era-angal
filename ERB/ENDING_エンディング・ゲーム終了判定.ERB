;エンディングチェック
@ENDING_CHECK
IF FLAG:5 == 10
	A = 0
	REPEAT CHARANUM
		IF COUNT == 0
			CONTINUE
		ELSEIF CFLAG:COUNT:17 == 0
			A += 1
		ENDIF
	REND
	;正気のキャラが誰も居なければゲームオーバー
	IF A == 0
		;!!!
