;カードセレクトチケットは人数の節目ごとに一度だけ支給する。
;FLAG:15089のbit0～7 = 5・10・20・30・40・50・60・70名の受取済み。
;旧金銭・好感度報酬の履歴は保持するが、新しいチケットの受取判定には使用しない。
@HAREM_ENDING_REWARD
#DIM DYNAMIC CID, 1
#DIM DYNAMIC HAREM_COUNT, 1
#DIM DYNAMIC STEP, 1
#DIM DYNAMIC MILESTONE, 1
#DIM DYNAMIC REWARD_BIT, 1
#DIM DYNAMIC REWARD_COUNT, 1
HAREM_COUNT = 0
REWARD_COUNT = 0
REWARD_BIT = 1
FOR CID, 1, CHARANUM
	SIF TALENT:CID:85 || TALENT:CID:88 || TALENT:CID:89 || TALENT:CID:153
		HAREM_COUNT += 1
NEXT
SETCOLOR 255, 200, 100
PRINTFORML 【ハーレムエンド達成特典】：
FOR STEP, 0, 8
	MILESTONE = 5
	SIF STEP > 0
		MILESTONE = STEP * 10
	IF HAREM_COUNT >= MILESTONE && (FLAG:15089 & REWARD_BIT) == 0
		FLAG:15089 |= REWARD_BIT
		REWARD_COUNT += 1
		PRINTFORML  ・{MILESTONE}名達成：カードセレクトチケット1枚！
	ENDIF
	REWARD_BIT *= 2
NEXT
ITEM:96 += REWARD_COUNT
IF REWARD_COUNT > 0
	PRINTFORML カードセレクトチケットを計{REWARD_COUNT}枚入手しました。（所持{ITEM:96}枚）
	PRINTFORML ガチャ画面から、好きな未所持カードを選んで入手できます。
ELSE
	PRINTFORML 今回の追加報酬はありません。（5名・10名・以降10名ごとに各1枚、各節目で一度限り）
ENDIF
RESETCOLOR
RETURN REWARD_COUNT
