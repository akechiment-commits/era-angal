;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;俺のジャスティスがないぞって人は手動で追加してください
;ないとは思いますが既存同人誌のタイトルとかぶっていたら代替案を添えて教えてください
;正直ネタが滑ってる気もしなくもない
;------------------------------------------------------------------
@VIDEO_BONUS
;ボーナスは一律$1000　今後変化の可能性アリ
;タイトルは組み合わせ優先
IF A:3 == 0
	IF TFLAG:32 & 1	; 【[ビデオ処女喪失]】
		STR:0 = はじめての記念
	ELSEIF A:4 >= 8
		IF TALENT:134	; 【[妊娠]】
			STR:0 = 新しい日々
			P += 1000
		ELSE
			STR:0 = 二人のひととき
			P += 1000
		ENDIF
	ELSEIF A:5 >= 8
		STR:0 = 秘密のひととき
		P += 1000
	ELSEIF A:6 >= 8
		STR:0 = 甘いひととき
		P += 1000
	ELSEIF A:7 >= 8
		STR:0 = 大胆なひととき
		P += 1000
	ELSEIF A:8 >= 8
		STR:0 = 夜のひととき
		P += 1000
	ELSEIF A:9 >= 8
		STR:0 = 夢のひととき
		P += 1000
	ELSE
		STR:0 = 特別な記録
	ENDIF
	
	IF ASSI > 0
		SIF ( TALENT:ASSI:85 || TALENT:ASSI:76 ) && ( TALENT:TARGET:85 || TALENT:TARGET:76 )	; 【ASSI:[恋慕] / ASSI:[淫乱] / TARGET:[恋慕] / TARGET:[淫乱]】
			CALL VIDEO_BONUS_XXYY
	ENDIF
	
	A:3 = 1
ENDIF

@VIDEO_BONUS_XXYY
;特別版の効果は全キャラ共通
STR:0 = 二人の特別な時間
P += 1000
RETURN 0

