;-------------------------------------------------
;朝夜イベント兼、調教後行動、待機中行動等回避用素質変更関数
;朝夜イベントが発生しない程度の素質変更を行っておく
;うにゅほの人のを使わせていただきました
;-------------------------------------------------
@EVENT_ESCAPE_K40
;待機行動を強制的に無しにする+退避した事を記録
CFLAG:507 = CFLAG:13+1
CFLAG:13 = 0

;調教後自慰回避の為、欲情のパラメータがLv4以上になっていたら0まで落とす
;のだがにとりの自慰のしやすさの前では無意味だった…
SIF PALAM:5 >= PALAMLV:4
	PALAM:5 = 0

;朝フェラ回避の為、オトコを消しておく
IF TALENT:MASTER:122 == 1
	TALENT:MASTER:122 = 0
	CFLAG:506 |= 16
ENDIF
;拡張朝イベントの条件回避に淫乱と恋慕と相愛を一時的に0に
;淫乱…条件満たすと何回も取得してしまうんよ。だって、淫乱の取得条件に好感度がないす…
IF TALENT:76 == 1
	TALENT:76 = 0
	CFLAG:506 |= 32
ENDIF
IF TALENT:85 == 1
	TALENT:85 = 0
	CFLAG:506 |= 64
ENDIF
IF TALENT:89 == 1
	TALENT:89 = 0
	CFLAG:506 |= 128
ENDIF
;恋慕の再獲得を防止のために好感度を正負反転
CFLAG:2 *= -1


CFLAG:510 = 1

RETURN 0

;-------------------------------------------------
;朝夜イベント兼、調教後行動、待機中行動等復活用素質変更関数
;朝夜イベントが発生するように素質を戻しておく
;うにゅほの人のを使わせていただきました
;-------------------------------------------------
@EVENT_BACK_K40
;1以上なら少なくとも好感度の正負反転は行ったとする
IF CFLAG:507 > 0
	;待機行動を戻す。実行判定用に１余計に足してあるので15で論理輪を取り、さらに1引いた数を代入
	;待機行動は0～12までを使用している為、３つ増えなければ問題ない
	CFLAG:13 = (CFLAG:507 & 15)-1

	;朝フェラ戻し
	SIF (CFLAG:506 & 16) != 0
		TALENT:MASTER:122 = 1

	;拡張朝イベントの条件回避に淫乱と恋慕と相愛を戻す
	SIF (CFLAG:506 & 32) != 0
		TALENT:76 = 1
	SIF (CFLAG:506 & 64) != 0
		TALENT:85 = 1
	SIF (CFLAG:506 & 128) != 0
		TALENT:89 = 1
	
	;恋慕の再獲得を防止のために好感度を正負反転
	CFLAG:2 *= -1
ENDIF

CFLAG:510 = 0

RETURN 0

TFLAG:13 = 0

