;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------

;--------------------------------------------------
;寂しがりやにとりんを何とかする構文
;Ｊ用椛の”クリア後から式までの間をどうにかしてみよう構文”を改造して使用
;さらにＪ用ヤマメの”クリア後から式までの間をどうにかしてみよう構文”も改造して使用（主に結婚式）
;-------------------------------------------------;
@EVENTSHOP
;にとりの場所を探す
A = -1
REPEAT CHARANUM
	SIF NO:COUNT == 40
		A = COUNT
REND
IF A > -1
	IF A != TARGET
		;日数カウント　これが１４以上（一週間分以上）になると寂しがられるって訳だ
		CFLAG:A:205 += 1
		;精液量リセット
		CFLAG:A:626 = 0
	ELSE
		;日数カウントリセット
		CFLAG:A:205 = 0
		;精液量をリセット
		CFLAG:A:626 = 0
;		;C敏感
;		TALENT:A:102 = 0
;		;V敏感
;		TALENT:A:104 = 0
;		;B敏感
;		TALENT:A:108 = 0
	ENDIF
	;結婚式
	IF CFLAG:A:137 == 1 && (TIME:4 & 2) && TIME == 0
		CFLAG:A:137 = 2
		TIME:5 = 0
	;結婚式後
	ELSEIF CFLAG:A:137 == 2 && (TIME:4 & 2) && TIME
		CFLAG:A:137 = 3
	;リングを贈っている、クリア後で次の日曜日　上の条件を満たしていない場合
	;にとりにリングを贈っておきつつラスボスをにとり以外で倒した場合
	ELSEIF CFLAG:A:137 == 1 && FLAG:28 == 1 && DAY:5 == 6 && TIME == 0
		CFLAG:A:137 = 0
	ENDIF
	;風邪
	IF CFLAG:A:278 == 2
		;回復早い遅いを変化させる
		IF TALENT:A:111 == 1
			TALENT:A:111 = 0
			TALENT:A:112 = 1
			CFLAG:A:505 |= 32
		ENDIF
		IF TALENT:A:111 == 0 && TALENT:A:112 == 0
			TALENT:A:112 = 1
			CFLAG:A:505 |= 64
		ENDIF
	ELSEIF CFLAG:A:278 == 3 || CFLAG:A:278 == 4
		;回復早い遅いを変化させる
		IF (CFLAG:A:505 & 32) != 0
			TALENT:A:111 = 1
			TALENT:A:112 = 0
		ENDIF
		SIF (CFLAG:A:505 & 64) != 0
			TALENT:A:112 = 0
	ENDIF
ENDIF

