		CFLAG:221 = 1
	;キス後一回目
	ELSEIF EXP:96 > 0 && CFLAG:221 < 2
		PRINTFORMW 「あ、起きたかい。それじゃあ今日もよろしく頼むよ？」
		PRINTFORMW そう言う萃香の頬は、仄かに赤みがかかっている。
		PRINTFORMW 「……何ジロジロ見てるのさ。へ？ 顔が紅い？ あ、朝酒だよ、朝酒！」
		PRINTFORMW 萃香はそう言って瓢箪に入った酒をグビりと煽った。
		PRINTFORMW
		PRINTFORMW (人間、か……)
		CFLAG:221 = 2
	;恋慕後一回目
	ELSEIF TALENT:85 == 1 && CFLAG:221 < 3
		PRINTFORMW 「あ……起きたね。その……よく寝れたかい？」
		PRINTFORMW 「あーいや、別にどうって事もないのだけどさ……」
		PRINTFORMW 萃香は%CALLNAME:MASTER%と視線を合わさず、落ち着き無く身体を揺らした。
		PRINTFORMW 「う……何か言いたいことがあるのかって？」
		PRINTFORMW 「……%CALLNAME:MASTER%のことが気に入っただけさ、嘘じゃないよ！」
		PRINTFORMW 
		PRINTFORMW (鬼の私が人間に惚れるなんて、判らないもんだねぇ……)
