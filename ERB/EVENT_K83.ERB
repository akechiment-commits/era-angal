;-------------------------------------------------
;J用おくう（霊烏路 空）口上 -うにゅほ版-Ver. 0.98460
;J用おくう口上(2009/05/29版)を元に自分好みに派生、J用霊夢口上、J用早苗口上、Jさとり口上等を参考に色々追加してみた
;地霊殿居住者組のキャラクタは、Jさとり口上、Jお燐口上、Jこいし口上を基としたつもりです
;
;鳥頭だけど⑨では無い、うにゅほさん。
;精神年齢や性知識はチルノやルーミア並で純粋無垢で一途な生き物。
;公式で鳥頭と言っているが⑨とは言ってないので作成した
;CALLNAME:MASTERを用いて処理しているのでスタート時にChara0.csvの名前を変えても遊べます。
;但し、♂あなた限定で、♀あなた、他キャラクターはサポートしておりません。
;うにゅほさんは生意気成分が碌に入ってないので素質変更をオススメします。
;
;基本はプレイヤーがうにゅほの世話を焼く構図です。
;ネタと核を盛り込んであります。
;調子に乗って、うにゅほをいぢめると滅ぼすよっ♪
;
;それと、readmeにも書いてますがeratohoJのシステムしか想定していないので、J以外のバリアントでは一切動作保証しません
;
;最後に、鳥頭と⑨を一緒にするなぁぁぁ！
;
;省略表記は基本的にはしない方向で実装(素質等指定時のTARGETとGET_EXISTANCEの戻り値確認は例外とする)
;
;当口上固有フラグ
;CFLAG256 野外ライブ
;CFLAG257 ストリートライブ テンプレのCFLAG493だと「クンニ強制」と重複するので変更
;
;CFLAG326 ステージ攻略開始 
;
;CFLAG353 初めての中出し
;
;CFLAG538 頭を撫でる
;CFLAG539 願掛け
;CFLAG540 炬燵にあたる開始
;CFLAG541 炬燵にあたる終了
;CFLAG542 炬燵使用中に船を漕ぐ
;CFLAG543 炬燵使用中に熟睡
;CFLAG544 お散歩する
;CFLAG545 抱き合う
;
;CFLAG550 うにゅほ反省するフラグ
;CFLAG551 外界用デートフラグ(既存の407を幻想郷内用として使用)
;CFLAG552 地霊殿居住者組＋α在籍有無フラグ(ビット管理で誰が仲間になっているかを記録)
;CFLAG553 心を閉ざしたフラグ
;           0:心を閉ざしていないor心を開いた
;           1:恋慕、合意、恋人どれも付けずに妊娠させた
;           2:再加入時恋慕ありで別れの言葉を撤回しなかった
;CFLAG554 特殊ボス撃破フラグ(ほんわかな雰囲気で仲間になったキャラはあなたへの好感度がーにならなくする)
;CFLAG555 うにゅほさんの呼び名を何にしたか(整数値で管理)
;CFLAG556 うにゅほさんが酔いつぶれたフラグ
;CFLAG557 うにゅほさんのコスプレ時選択肢の結果保持
;CFLAG558 あなたの名称変更フラグ
;CFLAG559 夜イベント回避時復帰素質フラグ
;CFLAG560 待機口上中のカウント等に使用
;CFLAG561 人の名前を覚えたかどうか(ビット管理で1:霊夢 2:未実装 3:紫)
;CFLAG562 最後に会った日を記憶
;CFLAG563 うにゅほさんの略奪愛フラグ(0:オフ/1:オン/2:失敗/3:成功/4:略奪婚/5:家族化(娘,妹辺りを想定))
;CFLAG564 蓬莱の薬に関する情報を管理
;CFLAG565 最後に育児室に寄った日を記憶
;CFLAG566 デート着プレゼントフラグ(1bit:プレゼント有無/2bit:デート着着用有無/3bit:ペアルック着用有無/5bit:デート着着用中か/6bit:ペアルック着用中か)
;CFLAG567 処女喪失した際の手段を記録(0:処女 1:Not無理矢理 2:指で破瓜 3:玩具で破瓜 4:れいぽぅ 5:結婚後に破瓜)
;CFLAG568 処女を捧げた相手(キャラ番号で記録 主人公=0 霊夢=1……)
;CFLAG569 うにゅほさん現在の髪型(0:いつもの(ボサロング) 1:ストレート 2:一本結び 3:お嬢様結び 4:ポニーテール……)
;
;CFLAG613 コンドーム装着状態 1bit目:主人装着中 2bit目:助手装着中 3bit目:相棒装着中 0だと無し
;
;CFLAG631 子供の数カウント用
;
;当口上固有で確保しておきたい文字列変数
;STR33     Emuera起動時のあなたの呼び名を一時的に退避
;STR100    あなた用
;STR183    うにゅほさん呼称用に確保
;-------------------------------------------------

;--------------------------------------------------
;口上ファイルの存在判定
;--------------------------------------------------
@EVENTTRAIN
#PRI
SIF FLAG:183 == 0
	FLAG:183 = 1
SIF FLAG:7 == 0
	FLAG:7 = 2
;地の文カットを解除
CFLAG:99 = 0

@EVENTEND
#LATER
FLAG:183 = 0

;--------------------------------------------------
;J用さとり口上を参考にeramaker依存バグ対応
;  (エキストラモード構文のみ対応、入力要請箇所を増やしすぎたので他は断念)
;本口上内からしか呼びませんが、本体側から呼べそうな関数名にしておく
;eramaker依存のバグ : 複数のGOTOを一度に使うとIFの構造を忘れて数が合わなくなりエラー発生
;ついでに胸サイズを別に聞いてくるように変更(関数を増やすのは避けました)
;現在おっぱいチョイスフラグ以外使っていないが、変更したかをビット管理しておく
;bit1：エクストラモード実行済みフラグ(他の口上と一緒)一部例外あり
;bit2：素質のうにゅほ化有効フラグ
;bit3：名称変更有効フラグ
;bit4：巨乳化変更フラグ
;bit5：美乳化変更フラグ
;bit6：デート場所追加有効フラグ
;bit7：一部キャラクター撃破時、好感度ボーナス発生フラグ
;bit8：本名変更フラグ(適用されるのはEmueraのみ)
;--------------------------------------------------
@KOJO_EXTRAMODE_K83
;再度呼ばれても問題ない様に弾く
SIF (CFLAG:220 & 1) != 0
	RETURN 0
DRAWLINE
PRINTL 霊烏路 空は、「れいうじ ＸＸ」何て読みますか？
$IL_EXTRAMODE_NAMECHG
PRINTL [0] 「うつほ」と読みます(デフォルト)
PRINTL [1] いいえ、「うにゅほ」です！ ｷﾘｯ
INPUT
SIF RESULT < 0 || RESULT > 1
	GOTO IL_EXTRAMODE_NAMECHG
IF RESULT == 0
	PRINTW ―本名は「うつほ」で始めます―
ELSEIF RESULT == 1
	;正式な読みもうにゅほ化
	;!;NAME:TARGET = うにゅほ
	PRINTW ―本名は「うにゅほ」で始めます―
	;!;[SKIPSTART]
	PRINTW ※Emuera起動時のみ有効な機能です
	;!;[SKIPEND]
	;本名管理フラグ
	CFLAG:220 |= 128
ENDIF
PRINTL  
PRINTL 口上内で想定しているパラメータに変更しても良いですか？
$IL_EXTRAMODE_ABLCHG
PRINTL [0] やらせはせんよ！(デフォルト)
PRINTL [1] やっておしまい！
PRINTL [2] 神様、八咫烏取得前にしてください
INPUT
SIF (RESULT+1000) < 0 || RESULT > 2
	GOTO IL_EXTRAMODE_ABLCHG
IF RESULT == 0
	PRINTFORMW %CALLNAME:TARGET%はラスボス！
	PRINTFORMW ―推奨素質への変更はしません―
ELSEIF RESULT == 1
	PRINTL 鳥頭で素直なのがうにゅほさん(⑨ではありません！)
	;うにゅほ口上では、即死口上・体力減少がウフフ内に多くあるので難易度を若干下げとく
	;戦闘力に合わせて下落
	ABL:97 = 50
	;経験のリセット
	EXP:2 = 0
	EXP:10 = 0
	EXP:40 = 0
	;気力の上昇(6ボスなのに妖精並みなのが納得出来なかった)
	MAXBASE:1 = 1100
	;素質の変更
	TALENT:11 = 0
	TALENT:13 = 1
	TALENT:16 = 0
	TALENT:33 = 1
	TALENT:62 = 1
	TALENT:127 = 0
	TALENT:132 = 1
	;反抗的、生意気、ツンデレ、具現の忘却
	;素直、解放、幼稚の取得
	PRINTFORM 【%TALENTNAME:11%】【%TALENTNAME:16%】
	IF TALENT:18 == 1
		TALENT:18 = 0
		PRINTFORM 【%TALENTNAME:18%】
	ENDIF
	PRINTFORML 【%TALENTNAME:28%】【%TALENTNAME:127%】を失い
	PRINTFORMW 【%TALENTNAME:13%】【%TALENTNAME:33%】【%TALENTNAME:62%】【%TALENTNAME:132%】を得ました
	;相性の変更
	;巫女・魔女はキャラ設定.txtを見たら結構懐いていたので若干追加
	RELATION:1  = 110
	RELATION:2  = 110
	;チルノから若干嫌われてるのに相性がいいってどういうことか不明だったので、下げる
	RELATION:5  = 80
	;神奈子様が居て、諏訪子様が居ないっておかしいでしょう
	RELATION:44 = 110
	;神様の力繋がりで神綺様も多少良くしておく…秋姉妹、厄神様、死神、閻魔様はまぁいいや
	RELATION:52 = 110
	;さとり様があまり慕われてなかったので上方修正
	RELATION:81 = 200
	;お燐との関係が薄かったので上方修正
	RELATION:82 = 180
	;こいしちゃんが相性増減なしだったので上方修正
	RELATION:84 = 130
	;主導権基準値の変更(うにゅほは八咫烏の力を得て虚勢を張っています)
	CFLAG:12 = 15
	PRINTFORMW ―推奨設定に素質変化しました―
	;素質変化しているかビットで管理
	CFLAG:220 |= 2
ELSEIF RESULT == 2
	PRINTFORML 鳥頭で素直、そして甘えん坊なのがうにゅほさん(Not ⑨)
	;戦闘力に合わせて下落
	ABL:97 = 20
	;戦闘力：人化してるのでそこまで弱くはない
	ABL:98 = 35
	;経験のリセット
	EXP:2 = 0
	EXP:10 = 0
	EXP:40 = 0
	;体力の低下
	MAXBASE:0 = 1800
	;気力は若干上昇
	MAXBASE:1 = 1050
	;素質の変更
	TALENT:10 = 1
	TALENT:11 = 0
	TALENT:13 = 1
	TALENT:16 = 0
	TALENT:28 = 0
	TALENT:33 = 1
	TALENT:62 = 1
	TALENT:115 = 0
	TALENT:127 = 0
	TALENT:132 = 1
	;反抗的、生意気、ツンデレ、目立ちたがり、日光浴、具現の忘却
	;臆病(鴉は元々警戒心の強い生き物です)、素直、解放、幼稚の取得
	PRINTFORM 【%TALENTNAME:11%】【%TALENTNAME:16%】
	IF TALENT:18 == 1
		TALENT:18 = 0
		PRINTFORM 【%TALENTNAME:18%】
	ENDIF
	PRINTFORML 【%TALENTNAME:28%】【%TALENTNAME:127%】を失い
	PRINTFORMW 【%TALENTNAME:10%】【%TALENTNAME:13%】【%TALENTNAME:33%】【%TALENTNAME:132%】を得ました
	;相性の変更(依存度合いを大きく設定),LUNA以下の難易度だった場合、主人への相性をあげる(地霊殿居住者組が主人時を除く)
	IF FLAG:5 < 3 && (NO:MASTER == 81 || NO:MASTER == 82 || NO:MASTER == 84) == 0
		A = NO:MASTER
		RELATION:A  = 110
	ENDIF
	;チルノから若干嫌われてるのに相性がいいってどういうことか不明だったので、下げる
	RELATION:5  = 80
	;さとり様があまり慕われてなかったので上方修正
	RELATION:81 = 220
	;お燐との関係が薄かったので上方修正
	RELATION:82 = 200
	;こいしちゃんが相性増減なしだったので上方修正
	RELATION:84 = 150
	;SPキャラとして扱う(戦闘力ががた落ちし、別キャラに近いので)
	CFLAG:0 = 1
	;主導権基準値の変更(うにゅほは力を得る前は弱気な子)
	CFLAG:12 = -20
ENDIF
PRINTL  
;うにゅほって呼びたい？
;不快に思ったら掲示板までお願いします。調子に乗り過ぎた感が強い…
PRINTFORML %CALLNAME:TARGET%を「うにゅほ」って呼びたい？
$INPUT_LOOP_CALLNAME
PRINTL [0] いいや「おくう」と呼ぶ！(デフォルト)
PRINTL [1] もちろんさ☆
PRINTL [2] ここは「お空」だろjk
PRINTL [3] あえて「マイハニー」と呼ばせてもらおうか！
PRINTL [4] 「うにゅほ様」以外の選択肢はないね！
PRINTL [5] 「うにゅほさん」をお忘れではなかろうか？
INPUT
SIF RESULT < 0 || RESULT > 5
	GOTO INPUT_LOOP_CALLNAME
IF RESULT == 0
	STR:183 = %CALLNAME:TARGET%
	CFLAG:555 = 1
ELSEIF RESULT == 1
	PRINTW お燐がサムズアップしています
	STR:183 = うにゅほ
	CFLAG:555 = 0
ELSEIF RESULT == 2
	PRINTW ダブルスポイラー表記にしました
	STR:183 = お空
	CFLAG:555 = 2
;需要があったら作者もビビる(ネタのつもり)
ELSEIF RESULT == 3
	PRINTW まさか選ぶ人が居るとは思わなかった…
	STR:183 = マイハニー
	CFLAG:555 = 3
;ぬこ様と同じノリでGo(ネタのつもり)
ELSEIF RESULT == 4
	PRINTW 忠実なる僕として頑張ってください
	STR:183 = うにゅほ様
	CFLAG:555 = 4
ELSEIF RESULT == 5
	PRINTW 呼び捨ては気が咎めますよね
	STR:183 = うにゅほさん
	CFLAG:555 = 5
ENDIF
IF RESULT != 0
	PRINTFORMW ―呼び方を%STR:183%に変更しました―
	;呼び方変えたかをビットで管理
	CFLAG:220 |= 4
ELSE
	PRINTW ―呼び方は変更しないで進めます―
ENDIF
;名前の再設定(Emueraの場合CALLNAMEも変更)
CALL NAME_SET_K83
PRINTL  
;体型について
PRINTFORML %CALLNAME:TARGET%は小柄？
$IL_BODYTYPE
PRINTFORML [0] %CALLNAME:TARGET%は綺麗派！(デフォルト)
PRINTFORML [1] Yes, ロリータ！
INPUT
SIF RESULT < 0 || RESULT > 1
	GOTO IL_BODYTYPE
IF RESULT == 0
	PRINTW ―体型は変更しないで進めます―
	TALENT:100 = 0
ELSEIF RESULT == 1
	PRINTW ―このロリコンどもめ！ 小柄体型になりました―
	TALENT:100 = 1
ENDIF
PRINTL  
;おっぱいチョイスのお時間です
PRINTFORML %STR:100%の「%STR:183%」のおっぱいチョイス
$INPUT_LOOP_1
PRINTL [0] 貧乳一択！(デフォルト)
PRINTL [1] 巨乳です！
PRINTL [2] 美乳に決まってる！
INPUT
SIF RESULT < 0 || RESULT > 2
	GOTO INPUT_LOOP_1
IF RESULT == 0
	PRINTW ビバ、ぺったんこ！
	PRINTW 自分に自信がない証拠です♪ おっぱいは決して怖くな～い♪
	TALENT:109 = 1
	TALENT:110 = 0
ELSEIF RESULT == 1
	PRINTW おっぱい優先！
	PRINTW 理想と現実、大分違うから夢から覚めなさい～♪
	TALENT:109 = 0
	TALENT:110 = 1
	;巨乳化したかをビットで管理
	CFLAG:220 |= 8
ELSEIF RESULT == 2
	PRINTW ふつくしい！
	PRINTW 普通に満たない女の子も結構いるから、油断は禁物で～す♪
	TALENT:109 = 0
	TALENT:110 = 0
	;普通サイズにしたかをビットで管理
	CFLAG:220 |= 16
ENDIF
PRINTW 不快に思った方がいたら、失礼しました 参考：おっぱい占いのうた♪
PRINTW ―理想のおっぱいに変更しました―
PRINTL  
;デート箇所の追加有無
PRINTFORML %STR:183%専用デート場所(幻想郷内)を追加しますか？
$IL_DATEPLACE
PRINTL [0] もちろんさ☆
PRINTL [1] 追加など要らぬ！
INPUT
SIF RESULT < 0 || RESULT > 1
	GOTO IL_DATEPLACE
IF RESULT == 0
	PRINTW ―デート場所『旧灼熱地獄跡』を追加しました―
	;幻想郷内の固有デート場所追加
	CFLAG:782 |= 1
	;デート場所追加したかをビットで管理
	CFLAG:220 |= 32
ELSEIF RESULT == 1
	PRINTW ―デート場所の追加は無し―
ENDIF
PRINTL  
;キャラ追加の際好感度を＋化するか
PRINTL 特定キャラをうにゅほと一緒に倒すと好感度ボーナスが入るようにしますか？
$INPUT_EXTRA_3
PRINTL [0] 是非おねがいします
PRINTL [1] 必要ない！ 嫁は自力で落とすぜ！
INPUT
SIF RESULT < 0 || RESULT > 1
	GOTO INPUT_EXTRA_3
IF RESULT == 0
	PRINTW ―一部のキャラで好感度ボーナスが得られます―
	CFLAG:220 |= 64
ELSEIF RESULT == 1
	PRINTW ―通常モードで起動―
ENDIF
PRINTL  
DRAWLINE
CFLAG:220 |= 1
RETURN 0


