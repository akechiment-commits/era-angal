;-------------------------------------------------
;地霊殿居住者組＋α在籍チェック CFLAG552
;結構頻繁にチェックしているので一括で行う様に変更
;別れた際は、フラグを落とす
;ついでに登録番号をEの配列に格納
;1ビット目:さとり
;2ビット目:お燐
;3ビット目:こいし
;4ビット目:神奈子
;5ビット目:諏訪子
;6ビット目:神綺
;7ビット目:霊夢
;8ビット目:魔理沙
;9ビット目:白蓮
;-------------------------------------------------
@GET_EXIST_CHECK_K83
;先ずは初期化
CFLAG:552 = 0
REPEAT 10
	SIF COUNT > 0
		E:COUNT = 0
REND
L:0 = 81
L:1 = 82
L:2 = 84
L:3 = 43
L:4 = 44
L:5 = 52
L:6 = 1
L:7 = 2
L:8 = 96
;べき乗計算の基数
M:1 = 2

REPEAT 9
	L = L:COUNT
	;COUNTの退避
	L:91 = COUNT
	CALL GET_REGIST_NO
	;取得に失敗した場合は次を見に行く
	IF RESULT == -1
		COUNT = L:91
		CONTINUE
	ELSE
		M:2 = L:91
		CALL ADDIN_POW
		CFLAG:552 |= M:3
		E:(L:91) = COUNT
		COUNT = L:91
	ENDIF
REND

RETURN 0

;-------------------------------------------------
;撃破チェッカー CFLAG554(道中攻略で特定キャラを撃破した際の管理フラグ)
;道中攻略で特定キャラを撃破した際、好感度を＋する(少しは打ち解けられる程度のボーナス)
;ボス戦直後の戦闘(雑魚)に一回も勝たずに逃走成功すると引っ掛からない…
;  (仕様的に無理)同梱の戦闘中、戦闘確認中の逃走時に撤退口上表示を当てれば可能
;複数のキャラが引っかかる場合を想定して全ビットをチェックする
;エキストラモード構文で機能ONにしないと実行しません
;-------------------------------------------------
@BUSTER_CHECK_K83
IF (CFLAG:554 & 31) != 0 && (CFLAG:220 & 64) != 0
	;COUNTの退避
	L:90 = COUNT
	;楽園の素敵な巫女
	;あなたに興味を持ったということで高めに設定
	L:0 = 1
	;これで安心魔界神
	;魔界の母性的存在と考えれば、－なんて無いだろうという妄想
	L:1 = 52
	;好き好きさとり様(ステージ3以降のみ)
	;素敵エピソードの話し合いで結構打ち解けてきたってことで
	L:2 = 81
	;おりんりんらんど(ステージ3以降のみ)
	;うにゅうにゅエピソードの話し合いで結構打ち解けてきたってことで
	L:3 = 82
	;ｷｬｰﾅﾑｻｰﾝ
	;うにゅほ(妖怪)と仲良くしてるので自然にこうなった
	L:4 = 96
	
	;補正値
	L:10 = 50
	L:11 = 20
	L:12 = 40
	L:13 = 40
	L:14 = 20

	;べき乗計算の基数
	M:1 = 2

	REPEAT 5
		M:2 = COUNT
		CALL ADDIN_POW
		IF (CFLAG:554 & M:3) != 0
			CFLAG:554 -= M:3
			L = L:COUNT
			;COUNTの退避
			L:91 = COUNT
			CALL GET_REGIST_NO
			;取得に失敗した場合は次を見に行く
			IF RESULT == -1
				COUNT = L:91
				CONTINUE
			ELSE
				L = L:(L:91 + 10)
				CFLAG:COUNT:2 = RAND:40 + L
				COUNT = L:91
			ENDIF
		ENDIF
	REND
	;戻し
	COUNT = L:90
ELSE
	;実行しない時は初期化しておく
	CFLAG:554 = 0
ENDIF
RETURN 0

