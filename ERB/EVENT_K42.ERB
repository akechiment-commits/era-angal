;--------------------------------------------------
;地の文カット解除
;--------------------------------------------------
@EVENT_NEXTDAY_K42
CFLAG:99 = 0

;--------------------------------------------------
;口上ファイルの存在判定（42をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:142 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

CFLAG:850 = 1
;汚いBASE:6の初期化
;本当はシステム系を弄るべきだが、あんまり入れ込むと
;パッチ対応であっぷあっぷになるので汚い手に出ることに
;中身はMASTERのカウンターでの精神(？)絶頂
;相手からウフフなことしてもらって精神的にクるみたいなそんなイメージなんです
IF CFLAG:850 == 1
	SIF MAXBASE:MASTER:6 != 10000
		MAXBASE:MASTER:6 = 10000
	BASE:MASTER:6 = 0
ENDIF

@EVENTEND
#LATER
FLAG:142 = 0

