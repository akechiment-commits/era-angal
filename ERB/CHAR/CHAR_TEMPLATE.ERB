;============================================================
; [キャラ名]　NO:NN　N年X組　部活
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 【初回遭遇】
; ▼ 発生条件
;   SHOPメニュー「場所に行く」→ 教室/部室/委員会室を選択したとき
;   → 1ターン消費。その後パートナー選択画面に進む
; ▼ 呼ばれる回数
;   このキャラとの「初めての遭遇」1回のみ
;   2回目以降の訪問では CHAR_REPEAT_DIALOG_NN が自動で呼ばれる
; ▼ 使える情報
;   TFLAG:86: 0=教室  1=部室  2=委員会室（どこで出会ったか）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_NN
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_NN
ENDIF
RETURN

;------------------------------------------------------------
; 【再遭遇】
; ▼ 発生条件
;   CHAR_FIRST_DIALOG と同じ（場所に行く→教室/部室/委員会室を選択）
;   → 1ターン消費。その後パートナー選択/交代画面に進む
; ▼ 呼ばれる回数
;   2回目以降の訪問で毎回。訪問するたびに毎回発動
; ▼ 使える情報
;   TALENT:TARGET:153: 恋人フラグ（1=恋人、0=通常）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_NN
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「」
	ELSEIF A == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「」
	ELSEIF A == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 【朝の挨拶】
; ▼ 発生条件
;   1日の最初のターン開始時（SHOPを開いたとき TIME==0 かつ DAY進行時）
;   パートナーが選択されていれば毎日必ず1回発動
; ▼ 呼ばれる回数
;   1日1回（朝のみ）。パートナー未選択なら発動しない
; ▼ 使える情報
;   TALENT:TARGET:153: 恋人フラグ（1=恋人、0=通常）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_NN
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「」
	CASE 1
		PRINTFORML 「」
	CASE 2
		PRINTFORML 「」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「」
	CASE 1
		PRINTFORML 「」
	CASE 2
		PRINTFORML 「」
	ENDSELECT
ENDIF
RETURN

