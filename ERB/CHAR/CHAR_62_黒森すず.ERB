;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_62
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。もう、指一本動かせん……。ククク、だが、最高だったぞ、弟くん……♪」
			CASE 1
				PRINTFORML 「腰が、抜けてしまった……。貴様にあんなにされて……うっ、立てん……♪」
			CASE 2
				PRINTFORML 「（あたま、ぼーっと……堕天使の威厳も保てんな……）……弟くん、好きだ……。もう、なにも考えられん……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう限界だ……っ。こんなにバテたの、ボクともあろうものが……っ」
			CASE 1
				PRINTFORML 「うっ……体に力が入らん……。すこし、休ませろ……っ」
			CASE 2
				PRINTFORML 「はぁ……ボクの翼も、もげそうだ……。弟くん、激しすぎだぞ……っ」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ククク……弟くんと、こんなことをしてしまったな♪　また、誘え？☆」
			CASE 1
				PRINTFORML 「ん、どきどきした。だが、貴様となら何度でも……ふん、欲ばりで悪いか♪」
			CASE 2
				PRINTFORML 「弟くんのこと、もっと好きになってしまった……。責任を取れ、否、取ってください♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……は、恥ずかしいだろうが。ボク、こんな声を……。忘れろ、いいな？」
			CASE 1
				PRINTFORML 「うっ……貴様の前で、あんな……。み、見るな……っ」
			CASE 2
				PRINTFORML 「ん～、体があたたかいな。ククク、また、いいぞ？　弟くんが望むならな♪」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日はここまでだ、弟くん。……楽しかった。否、有意義だった、と言い直しておこう。あはは♪」
		CASE 1
			PRINTFORML 「ふぅ、いい時間だったな。貴様といると、ボクの折れた翼も少し疼く気がする……☆」
		CASE 2
			PRINTFORML 「またな、弟くん。次もボクを頼っていいぞ。……ちゃんと、待っているからな」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「うむ、ご苦労だった転校生。礼を言われたいなら、言わせてやってもいいぞ？　ククク」
		CASE 1
			PRINTFORML 「今日はここまでにするか。ふん、悪くない働きだった。褒めてやろう」
		CASE 2
			PRINTFORML 「では、ボクは行く。次の魔宴（サバト）でまた会おうではないか」
		ENDSELECT
	ENDIF
ENDIF
RETURN


;==============================================================
; 【甲斐性なしプロポーズ口上】  @SELF_KOJO_K62
; ▼ 発生条件: TFLAG:13 == 95/96（指輪をはめた直後）
; ▼ 状況: パートナー側から転校生にプロポーズする場面
; ★山場: 十分なボリュームの口上にすること
;==============================================================
@SELF_KOJO_K62
IF TFLAG:13 == 95 || TFLAG:13 == 96
	PRINTFORMW 「なあ、%CALLNAME:PLAYER%。……柄にもないことを言うぞ。よく聞け。ボクは翼の折れた堕天使（ルシフェル）――孤独こそが定めだと、そう嘯いて生きてきた。だが……貴様と過ごすうちに、その嘘が剥がれてしまったのだ。ボクは、寂しかった。ずっと、誰かに隣にいてほしかった。……だから言う。%CALLNAME:PLAYER%、ボクと――生涯をともにしてくれないか。甲斐性なんて何もない。あるのはこの想いと、下手くそなベースの音だけだ。それでもボクは、貴様だけのクロシェットでありたい。……返事を、聞かせてくれ」
	RETURN 0
ENDIF

;==============================================================
; 【コマンド実行失敗口上】
; ▼ 発生条件: TFLAG:13 == 99（コマンドが条件不足等で実行できなかったとき）
;==============================================================
SIF TFLAG:13 != 99
	RETURN 0
A = RAND:3
IF A == 0
	PRINTFORMW 「むっ、今はダメだ。タイミングというものがあるだろう、焦るな弟くん」
ELSEIF A == 1
	PRINTFORMW 「否、それは今やることではない。……ボクにも心の準備というものがあるのだ」
ELSE
	PRINTFORMW 「ククク、そう急くな。良きものは、待つ者にこそ訪れるのだ」
ENDIF
RETURN 0

