IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「ん……おはようッス、転校生くん。もうちょっとだけ、あんたを抱き枕にして二度寝してもいいッスか～？」
	CASE 1
		PRINTFORML 「ふあぁ、おはよ……。朝から顔を見られるのは、恋人の特権ッスね。役得、役得♪」
	CASE 2
		PRINTFORML 「おはようッス。あんたが隣にいると、朝起きる理由ができていいッスね～。ま、起きるのは面倒ッスけど♪」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「ふあぁ……おはようッス、転校生くん。朝って、どうしてこう眠いんスかね～？」
	CASE 1
		PRINTFORML 「ん～、おはよ……。あぁ、もう朝ッスか。一日が始まるの、面倒くさいッスね～」
	CASE 2
		PRINTFORML 「おはようッス。今日もごろごろできる場所を探さなきゃッスね……って、冗談ッスよ？　半分くらいは」
	ENDSELECT
ENDIF
