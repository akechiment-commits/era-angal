;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 神無月ほとり　NO:70　?年3-C　天文部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_70
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「ふあぁ……ん？　あんたが噂の『転校生くん』ッスか。あたしは天文部副部長の神無月ほとり、
		PRINTFORML 三年Ｃ組ッスよ。見ての通りのぐうたらだから、まぁテキト～によろしくッス～♪」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「ん～、行き倒れかと思って起こしてくれたんスか。お節介なんスね、転校生くんは。
		PRINTFORML あたしは神無月ほとり、天文部の副部長ッス。暇なら、
		PRINTFORML あたしのお世話でもしてくれると楽ちんで助かるんスけど～？」
	ELSE
		PRINTFORML 「おおう……ずいぶん物騒な目つきの転校生くんッスね。あたし、
		PRINTFORML 抵抗とか面倒だから手荒なのは勘弁してほしいッス……。まぁ、好きにするといいッスよ。
		PRINTFORML 寝てる間に終わらせてくれると、省エネで助かるッス～」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_70
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_70
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「お、転校生くん。ちょうどよかったッス、膝枕してくれないッスかね～？　あんたの膝、けっこう寝心地いいんスよ♪」
	ELSEIF A == 1
		PRINTFORML 「ふあぁ……来てくれたんスね。あんたの顔を見ると安心して、よけい眠くなっちゃうッス。これも愛ってやつッスかね～？」
	ELSE
		PRINTFORML 「ん～、転校生くん。今日はどこでごろごろするッス？　あんたと一緒なら、図書室でも屋上でも極楽ッスよ♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「ふあぁ～あ。昼休みの図書室って反則ッスよね……。お、転校生くんッスか。ちょうどいい枕がきたッス～♪」
	ELSEIF A == 1
		PRINTFORML 「ん～？　また会ったッスね、転校生くん。あんたは無口だから、一緒にいても疲れなくていいッス」
	ELSE
		PRINTFORML 「おやぁ、転校生くん。あたしを起こしに来たんスか。お節介なんスね～……まぁ、嫌いじゃないッスけど♪」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_70
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「ん……おはようッス、転校生くん。もうちょっとだけ、あんたを抱き枕にして二度寝してもいいッスか～？」
	CASE 1
		PRINTFORML 「ふあぁ、おはよ……。朝から顔を見られるのは、恋人の特権ッスね。役得、役得♪」
	CASE 2
		PRINTFORML 「おはようッス。あんたが隣にいると、朝起きる理由ができていいッスね～。ま、起きるのは面倒ッスけど♪」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「ふあぁ……おはようッス、転校生くん。朝って、どうしてこう眠いんスかね～？」
	CASE 1
		PRINTFORML 「ん～、おはよ……。あぁ、もう朝ッスか。一日が始まるの、面倒くさいッスね～」
	CASE 2
		PRINTFORML 「おはようッス。今日もごろごろできる場所を探さなきゃッスね……って、冗談ッスよ？　半分くらいは」
	ENDSELECT
ENDIF
