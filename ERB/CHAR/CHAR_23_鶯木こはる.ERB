; 【妊娠・出産・育児 口上】
;
; 呼び出し元: EVENT_K @SELF_KOJO → @KOJO_NINSIN_K23
; セリフは PRINTFORMLW 「セリフ」 に書く（W=入力待ち）
; ▼ 誰が妊娠させたか (CFLAG:TARGET:104):
;   1=マスター  2=助手  3=パートナー
;------------------------------------------------------------
@KOJO_NINSIN_K23

;--- 妊娠発覚 (TFLAG:13 == 20) ---
; ▼ 状況: このキャラが妊娠していることが発覚した直後。
;   中田氏後に確率で妊娠判定が成立したとき呼ばれる。
;   CFLAG:TARGET:104 で誰の子かを分岐可能。
IF TFLAG:13 == 20
	; 主人公の子の場合
	IF CFLAG:TARGET:104 == 1
		PRINTFORMLW 「」
	; 助手・パートナーの子の場合
	ELSE
		PRINTFORMLW 「」
	ENDIF
	RETURN 0
ENDIF

;--- 妊娠発覚２ (TFLAG:13 == 94) ---
; ▼ 状況: 別のキャラ（助手・パートナー）が妊娠した際の
;   このキャラ（TARGET）のリアクション。
;   例: 主人公が助手を妊娠 → パートナーのリアクション
;       助手が奴隷を妊娠 → 助手のリアクション
IF TFLAG:13 == 94
	PRINTFORMLW 「」
	RETURN 0
ENDIF

;--- 臨月 (TFLAG:13 == 25) ---
; ▼ 状況: 出産予定日の3日前。臨月を迎えて育児室へ移動する
;   直前に呼ばれる。以降は出産まで調教不可。
IF TFLAG:13 == 25
	PRINTFORMLW 「」
	RETURN 0
ENDIF

;--- 出産 (TFLAG:13 == 21) ---
; ▼ 状況: 出産予定日に赤ちゃんが産まれた直後。
;   TFLAG:17 で感情・関係性による3分岐:
;     1 = グッド  : 恋慕あり かつ 主人公が父親
;     2 = ノーマル: それ以外の通常ケース
;     3 = バッド  : 素質「感情乏しい」「無関心」持ち かつ 恋慕なし
IF TFLAG:13 == 21
	; グッド（恋慕あり・主人公が父親）
	IF TFLAG:17 == 1
		PRINTFORMLW 「」
	; バッド（感情乏しい・恋慕なし）
	ELSEIF TFLAG:17 == 3
		PRINTFORMLW 「」
	; ノーマル
	ELSE
		PRINTFORMLW 「」
	ENDIF
	RETURN 0
ENDIF

