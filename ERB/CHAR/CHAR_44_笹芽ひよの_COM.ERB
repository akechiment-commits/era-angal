;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORML 「い、一緒に勉強ですかぁ？　えへへ、わたし生徒会の書記なので、
		PRINTFORMW ノートまとめは得意なんですぅ。お、お役に立てるよう頑張りますねっ！」
	ELSE
		A = RAND:3
		;--- 失敗 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORML 「ご、ごめんなさいっ。わたし、転校生さんが近くにいると、緊張しちゃって、
				PRINTFORMW ぜんぜん集中できなくて。（うう、情けないですぅ）えへへ」
			ELSE
				;失敗
				PRINTFORMW 「す、すみませんっ、今日はなんだか、頭に入ってこなくて。べ、勉強より、つい記事のことを考えちゃって。だめですねぇ、わたし」
			ENDIF
		;--- 成功 ---
		ELSE
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「えへへ、ふたりでお勉強ですぅ♪　わからないところ、わたしが教えますからねっ。……な、なんだか先生になった気分ですぅ♪」
