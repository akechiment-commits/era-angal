;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「一緒に勉強してくれるの？　うれしいな♪　わたし欠席がちで授業についていけてないから、助かるよ」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「ふふ、転校生くんと並んで勉強……こうしてると、学校に通えてるんだなぁって実感するよ♪」
			ELSEIF A == 1
				PRINTFORMW 「あ、ここわかんないかも……ごめんね、教えてもらっていい？　コホ、コホ」
			ELSE
				PRINTFORMW 「集中するとつい時間を忘れちゃうね。転校生くん、無理させてないかな？」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「入院中はね、本ばっかり読んでたから……教科書の内容だけなら、そこそこ覚えてるんだ」
			ELSEIF A == 1
				PRINTFORMW 「えへへ、転校生くんの書くノート、字がきれいだね。わたし、真似させてもらおうかな♪」
			ELSE
				PRINTFORMW 「ちょっと頭ぼーっとしてきちゃった。コホ……休憩はさもっか、ね？」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「ありがとう、転校生くん。一人だと眠くなっちゃうから、誰かと一緒だと助かるよ」
			ELSEIF A == 1
				PRINTFORMW 「ベッドの上でも勉強はできるんだけどね。みんなと一緒のほうが、楽しいよ」
			ELSE
				PRINTFORMW 「コホ、コホ……ごめんね、気が散っちゃうよね。すぐ止まると思うから」
			ENDIF
		ENDIF
	ENDIF
ENDIF

