;------------------------------------------------------------
; 【妊娠・出産・育児 口上】
;
; 呼び出し元: EVENT_K @SELF_KOJO → @KOJO_NINSIN_K22
; セリフは PRINTFORMW  「セリフ」 に書く（W=入力待ち）
; ▼ 誰が妊娠させたか (CFLAG:TARGET:104):
;   1=マスター  2=助手  3=パートナー
;------------------------------------------------------------
@KOJO_NINSIN_K22

;--- 妊娠発覚 (TFLAG:13 == 20) ---
; ▼ 状況: このキャラが妊娠していることが発覚した直後。
;   中田氏後に確率で妊娠判定が成立したとき呼ばれる。
;   CFLAG:TARGET:104 : 1=転校生の子  2=助手の子  3=パートナーの子
;   CFLAG:TARGET:112 : 妊娠カウンター（1=初回  2以上=2回目以降）
;   TALENT:TARGET:85 : 恋慕フラグ（グッドルート判定）
IF TFLAG:13 == 20
	; 転校生の子 かつ 恋慕あり（グッドルート）
	IF CFLAG:TARGET:104 == 1 && TALENT:TARGET:85
		; ★山場: 初回のグッド妊娠は長めの口上にすること
		IF CFLAG:TARGET:112 >= 2
			; ▼ 2回目以降（何回目かは特定しない）
			; 初めての妊娠ではないことは伝わるが、2回目と決め打ちしないセリフに。
			; 初回ほどの感情の高ぶりはなく、簡素でよい。
			PRINTFORMW  「」
		ELSE
			; ▼ 初回（CFLAG:TARGET:112 == 1）
			PRINTFORMW  「」
		ENDIF
	; 転校生の子（恋慕なし）
	ELSEIF CFLAG:TARGET:104 == 1
		PRINTFORMW  「」
	; 助手・パートナーの子
	ELSE
		PRINTFORMW  「」
	ENDIF
	RETURN 0
ENDIF

;--- 妊娠発覚２ (TFLAG:13 == 94) ---
; ▼ 状況: 別のキャラ（助手・パートナー）が妊娠した際の
;   このキャラ（TARGET）のリアクション。
;   例: 主人公が助手を妊娠 → パートナーのリアクション
;       助手が奴隷を妊娠 → 助手のリアクション
IF TFLAG:13 == 94
	PRINTFORMW  「」
	RETURN 0
ENDIF

;--- 臨月 (TFLAG:13 == 25) ---
; ▼ 状況: 出産予定日の3日前。臨月を迎えて育児室へ移動する
;   直前に呼ばれる。以降は出産まで調教不可。
IF TFLAG:13 == 25
	PRINTFORMW  「」
	RETURN 0
ENDIF

;--- 出産 (TFLAG:13 == 21) ---
; ▼ 状況: 出産予定日に赤ちゃんが産まれた直後。
;   TFLAG:17 で感情・関係性による3分岐:
;     1 = グッド  : 恋慕あり かつ 主人公が父親
;     2 = ノーマル: それ以外の通常ケース
;     3 = バッド  : 素質「感情乏しい」「無関心」持ち かつ 恋慕なし
;   EXP:TARGET:61 : 出産回数（0=初回  1以上=2回目以降）
IF TFLAG:13 == 21
	; グッド（恋慕あり・主人公が父親）
	IF TFLAG:17 == 1
		; ★山場: グッド出産は長めの口上にすること
		IF EXP:TARGET:61 >= 1
			; ▼ 2回目以降の出産（何回目かは特定しない）
			; 出産が初めてではないことは伝わるが、2回目と決め打ちしないセリフに。
			; 初回ほどの山場ではないので簡素でよい。
			PRINTFORMW  「」
		ELSE
			; ▼ 初回出産（EXP:TARGET:61 == 0）
			PRINTFORMW  「」
		ENDIF
	; バッド（感情乏しい・恋慕なし）
	ELSEIF TFLAG:17 == 3
		PRINTFORMW  「」
	; ノーマル
	ELSE
		PRINTFORMW  「」
	ENDIF
	RETURN 0
ENDIF

;--- 育児室 (TFLAG:13 == 23) ---
; ▼ 状況: 育児中（出産後～20日）のキャラに育児室コマンドで
;   話しかけたとき。この期間は通常の調教コマンドが使えない。
IF TFLAG:13 == 23
	PRINTFORMW  「」
	RETURN 0
ENDIF

;--- 親離れ (TFLAG:13 == 22) ---
; ▼ 状況: 出産から20日後、子供が親離れして育児終了。
;   このキャラが通常調教に戻れるようになった直後。
IF TFLAG:13 == 22
	PRINTFORMW  「」
	RETURN 0
ENDIF

RETURN 0

