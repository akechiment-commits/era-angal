;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_4
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぅ……もう、力が入らないですよぉ……。でも、先輩とできて、嬉しかった……♪」
			CASE 1
				PRINTFORML 「おろろ……腰が、抜けちゃいました……。先輩、ぎゅってしててくださいぃ……♪」
			CASE 2
				PRINTFORML 「はぁ、はぁ……つかれた、けど……えへへ、しあわせ、です……先輩……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぇ……もう、立てないですぅ……。せ、先輩、ちょっとだけ休ませてください……」
			CASE 1
				PRINTFORML 「おろろぉ……あたし、こんなにくたくたになっちゃって……は、恥ずかしいですぅ……」
			CASE 2
				PRINTFORML 「はぁ……はぁ……あ、頭が、ぼーっとします……。だ、大丈夫ですよ……たぶん……」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「えへへ……先輩と、いっぱいしちゃいましたね……♪　あたし、もっと一緒にいたいなぁ♪」
			CASE 1
				PRINTFORML 「ふぅ♪　まだまだ平気ですよっ。先輩となら、何回だって……なんてっ、えへへ☆」
			CASE 2
				PRINTFORML 「おろろ、汗かいちゃった♪　ねえ先輩、また……一緒にしてくれますか～？」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「は、恥ずかしかったけど……えっと、だ、大丈夫でした……先輩……♪」
			CASE 1
				PRINTFORML 「おろろ……なんだか、変な感じです……。でも、いやじゃ、なかったですよ？」
			CASE 2
				PRINTFORML 「ふぅ……どきどきしました……。せ、先輩、やさしくしてくれて、ありがとうございます……」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日もいっぱい一緒にいられて、嬉しかったですっ♪　また明日も会いましょうね、先輩～♪」
		CASE 1
			PRINTFORML 「えへへ、先輩とのお時間、あっという間でした♪　おやすみなさいっ☆」
		CASE 2
			PRINTFORML 「おろろ、もうこんな時間！　名残惜しいけど……また明日ね、先輩♪」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日はありがとうございました、先輩！　また遊んでくださいね～♪」
		CASE 1
			PRINTFORML 「あっ、もうおしまいですか？　おろろ、楽しくて時間を忘れてました♪」
		CASE 2
			PRINTFORML 「えへへ、先輩とお話しできて楽しかったですっ。それじゃ、また～♪」
		ENDSELECT
	ENDIF
ENDIF
RETURN


;==============================================================
; 【甲斐性なしプロポーズ口上】  @SELF_KOJO_K4
; ▼ 発生条件: TFLAG:13 == 95/96（指輪をはめた直後）
; ▼ 状況: パートナー側から転校生にプロポーズする場面
; ★山場: 十分なボリュームの口上にすること
;==============================================================
@SELF_KOJO_K4
IF TFLAG:13 == 95 || TFLAG:13 == 96
	PRINTFORMW 「せ、先輩……。あ、あのね、あたし、ずっと考えてたことがあって……。あたし、見てのとおりドジでお馬鹿で、何もないところで転ぶし、忘れ物ばっかりだし、ピッコロの弁償もできない庶民だし……先輩には、もっとしっかりした人のほうが、お似合いなのかもしれません。でも……でもっ、あたし、先輩じゃなきゃ嫌なんですっ。先輩が宿題を助けてくれた日から、屋上であたしのピッコロの音色を聞いてくれた日から、ずっと……ずっと、先輩のことばっかり考えてて。おろろ、なんだか涙が出てきちゃった……。%CALLNAME:PLAYER%さん。あたしを……あたしを、お嫁さんにしてくれませんか……？　こんなあたしで、よければ……一生、おそばにいさせてくださいっ……！」
	RETURN 0
ENDIF

