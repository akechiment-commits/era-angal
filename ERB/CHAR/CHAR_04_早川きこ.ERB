;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 早川きこ　NO:4　?年1-A　吹奏楽部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_4
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「あっ、あなたが噂の『転校生の先輩』ですか？　あたし、早川きこっていいます。一年Ａ組で、ピッコロ担当なんですよ～♪」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「あれれ？　もしかして、噂の転校生の先輩ですよねっ？　あたしは早川きこ、吹奏楽部です～♪　よろしくお願いしますっ☆」
	ELSE
		PRINTFORML 「わわっ、あなたが転校生の先輩なんですねっ！　あたし早川きこっていいます、仲良くしてくださいね～♪」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_4
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_4
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、転校生の先輩～♪　えへへ、今日も会えて嬉しいですっ☆」
	ELSEIF A == 1
		PRINTFORML 「先輩、先輩っ！　あたしのこと、探してくれてたんですか～？　うわぁい♪」
	ELSE
		PRINTFORML 「おろろ、また転んじゃった……。でも、先輩がいてくれると安心しますね♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、転校生の先輩だ～！　こんにちは、ですっ♪」
	ELSEIF A == 1
		PRINTFORML 「おろろ？　先輩、どうしたんですか？　あたしに何かご用ですか～？」
	ELSE
		PRINTFORML 「えへへ、転校生の先輩とこうしてお話しできるの、なんだか嬉しいなぁ♪」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_4
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございますっ、転校生の先輩～♪　今朝も会えて、えへへ……♪」
	CASE 1
		PRINTFORML 「先輩、おはようです！　ふへへ、朝から先輩のお顔が見られるなんて、しあわせだなぁ☆」
	CASE 2
		PRINTFORML 「おろろ、寝坊しちゃった……！　あっ、でも先輩がおはようって言ってくれるなら頑張れますっ♪」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございます、転校生の先輩！　今日もいいお天気ですね～♪」
	CASE 1
		PRINTFORML 「あっ、おはようです先輩～♪　えっと、ピッコロは……あった、よかったぁ！」
	CASE 2
		PRINTFORML 「おはようございますっ。おろろ、朝から転んじゃって、もう散々ですよぉ～」
	ENDSELECT
ENDIF
RETURN

