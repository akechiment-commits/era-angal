	IF CFLAG:TARGET:216 == 0
		CFLAG:TARGET:216 = 1
		;初回
		PRINTFORMW 「あ、甘い言葉……ですか？ そ、そういうの慣れてないんですけど……」
	ELSE
		A = RAND:3
		;--- 失敗時 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORMW 「……っ。（なんですか今の、全然響かないんですけど……）……もう少し、本気で言ってもらえますか？」
			ELSE
				;失敗
				PRINTFORMW 「え……えっと……。（困りました、反応に困ります……）は、はあ、どうも」
			ENDIF
		;--- 成功時 ---
		ELSE
			;--- 恋人 ---
			IF TALENT:TARGET:153
				IF A == 0
					PRINTFORMW 「っ……！ そ、そういうこと急に言わないでください……っ！（心臓が、もう……）」
				ELSEIF A == 1
					PRINTFORMW 「ば、ばかっ……私をからかって……。……嬉しいですけど♪」
				ELSE
					PRINTFORMW 「……っ、もう。ずるいです、転校生さん。（顔、見られたくない……）」
				ENDIF
			;--- 親密 ---
			ELSEIF ABL:TARGET:0 >= 6
				IF A == 0
					PRINTFORMW 「ちょ……っ、急にそういうこと言わないでください。……動揺してませんよ？」
				ELSEIF A == 1
					PRINTFORMW 「ふ、ふうん……。お上手ですね、転校生さんは。（心臓、うるさい……）」
				ELSE
					PRINTFORMW 「は？ ……は、はあ。べ、別に照れてませんけど。ええ、全然」
				ENDIF
			;--- 通常 ---
			ELSE
				IF A == 0
					PRINTFORMW 「え……？ あ、ありがとうございます……？（何なんですか急に……）」
				ELSEIF A == 1
					PRINTFORMW 「そ、そういうのは……もう少し親しくなってから言ってください……」
				ELSE
					PRINTFORMW 「（この人、こういうことを平気で言うんですね……）……ふ、ふうん」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

