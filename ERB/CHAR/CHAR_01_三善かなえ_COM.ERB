		;初回
		PRINTFORMW 「おや？ 転校生さんも勉強ですか。……ふむ、いいでしょう。隣の席、空いていますから」
	ELSE
		A = RAND:3
		;--- 失敗 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORMW 「……ふふ、今日は全然集中できませんでした。転校生さんが隣にいると、どうしても気になってしまって」
			ELSE
				;失敗
				PRINTFORMW 「……今日はあまり捗りませんでしたね。集中できる環境というのも大事だとわかりました」
			ENDIF
		;--- 成功 ---
		ELSE
			;--- 恋人 ---
			IF TALENT:TARGET:153
				IF A == 0
					PRINTFORMW 「ふふ、また一緒に勉強ですね。……べ、別に嬉しいとかじゃないですよ。集中できる環境は大事だというだけです♪」
				ELSEIF A == 1
					PRINTFORMW 「（……転校生さんの横顔、真剣で……）……っ、な、何でもありません。ノート、見せてあげますから」
				ELSE
					PRINTFORMW 「転校生さん、ここの解き方わかりますか？ ……私が教えてあげます。（隣にいられるなら、何時間でも）」
				ENDIF
			;--- 親密（ABL6以上） ---
			ELSEIF ABL:TARGET:0 >= 6
				IF A == 0
					PRINTFORMW 「転校生さんとの勉強も慣れてきましたね。ふむ、ここの問題、一緒に考えてみましょうか」
				ELSEIF A == 1
					PRINTFORMW 「今日は集中できそうです。転校生さんがいると、不思議とペースが掴みやすいんですよね」
				ELSE
					PRINTFORMW 「あ、ぴこちゃんにも声をかけようと思ったんですが……今日は二人のほうが捗りそうですね」
				ENDIF
			;--- 通常 ---
			ELSE
				IF A == 0
					PRINTFORMW 「勉強はひとりでもできますけど……まあ、教え合うのも悪くはありません」
				ELSEIF A == 1
					PRINTFORMW 「ふむ、転校生さんも勉強熱心ですね。感心します」
				ELSE
					PRINTFORMW 「静かにしてくれるなら、隣で勉強しても構いませんよ」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

