ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「もう行くの? ……ん。さみしいけど、いいよ。また夜にね、あんた」
