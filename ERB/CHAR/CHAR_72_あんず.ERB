;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; あんず　NO:72　（転校済み）　元茶道部部長
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_72
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「あれ、あんた。教室にいたんだ。……私はちょっと、昔の先生に挨拶しにきただけ。ついでに、あんたの顔も見とこうかなって」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「ん、ここ……懐かしいな。私が部長やってた頃と、あんま変わってない。……あんたもここ来るんだ。ふぅん」
	ELSE
		PRINTFORML 「委員会? ……あんた、そんな真面目なことしてるんだ。意外。私が学校いた頃は、こういうの全部てきとうだったけどな」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_72
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_72
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「また会ったね。……ん、べつに。あんたの顔見ると、なんか落ち着くだけ」
	ELSEIF A == 1
		PRINTFORML 「あんた、ちょっとこっち来な。……なんでもない。ただ、近くにいてほしかっただけ」
	ELSE
		PRINTFORML 「ふぁ……。あんたといると眠くなる。安心するのかな。……しらないけど」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、あんた。元気そうでなにより。私? まあ、てきとうにやってるよ」
	ELSEIF A == 1
		PRINTFORML 「ぼーっとしてた。べつに用はないんだけど、あんたがいたから声かけただけ」
	ELSE
		PRINTFORML 「お腹すいた。……あんた、なんか持ってない? ……ないか。じゃ、いいや」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_72
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよ。……よく寝てた? 私はあんたの寝顔、ちょっと見てた。……わるい?」
	CASE 1
		PRINTFORML 「朝だよ。起きな。ほら、抱っこして起こすやつ、やってあげよっか。昔みたいに」
	CASE 2
		PRINTFORML 「ふぁ……おはよ。今日もあんたの隣で目が覚めた。……なんか、ふしぎだなあ」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよ、あんた。朝ごはんてきとうに作っといた。冷めてもいいなら、あとで食べな」
	CASE 1
		PRINTFORML 「ん、おはよ。早いね。私はもうちょっと寝てたかったけど、あんたに起こされた」
	CASE 2
		PRINTFORML 「おはよう。今日も天気いいなあ。空、きれい。……絵、描きたくなる」
	ENDSELECT
ENDIF
