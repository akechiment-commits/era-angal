			CASE 0
				PRINTFORML 「はぁ……はぁ……。やば、つかれた。あんた、加減ってもの知らないの? ……ま、いいけど」
			CASE 1
				PRINTFORML 「ふらふら……。立てない。肩、貸して。……ん、ありがと」
			CASE 2
				PRINTFORML 「もう、おしまい? よかった。さすがにこれ以上は、む、り……」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ん……まだいける。でも今日はこのくらいにしとこ。あんたの顔、ずっと見てたいし」
			CASE 1
				PRINTFORML 「ふぅ……よかった。あんたとこういうことするの。……もっと慣れていきたいな」
			CASE 2
				PRINTFORML 「終わり? なんか、名残おしいな。……あとでまた、ぎゅってして。約束」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ん、こんなもんか。わるくなかったよ、あんた。……つぎは、もうちょっと優しくしてね」
			CASE 1
				PRINTFORML 「ふぅん……。意外とドキドキした。……顔に出てた? でないよ、たぶん」
			CASE 2
				PRINTFORML 「おしまい。はい、おつかれ。……髪、乱れてる。なおしてあげよっか」
			ENDSELECT
