;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 藍乃あいか　NO:6　?年1-A　文芸部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_6
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「ふぇ……? どちらさまですか? あ、ええっと、あなたが噂の『転校生の先輩』ですか。ぶちょ……生徒会長から、そんなようなお話は聞いてます」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「わひっ!? び、びっくりした……。急に部室に入ってこないでください、転校生の先輩。文芸部に何か御用ですか?」
	ELSE
		PRINTFORML 「え、なんでこんなところに……? あ、転校生の先輩。委員会のお手伝いですか、ご苦労さまです。わたしは生徒会長さんに頼まれて、ちょっと、です」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_6
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_6
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、%CALLNAME:PLAYER%先輩♪ えへへ、また会えましたね……お疲れさまです」
	ELSEIF A == 1
		PRINTFORML 「（あ、%CALLNAME:PLAYER%先輩だ……えへへ♪）……ご、ごめんなさい。ぼうっとしてました」
	ELSE
		PRINTFORML 「%CALLNAME:PLAYER%先輩、本に夢中で気づきませんでした。今日も忙しそうですけど、ちゃんと休んでくださいね?」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生の先輩。お疲れさまです……。今日もどなたかのお手伝いですか?」
	ELSEIF A == 1
		PRINTFORML 「ふぇ、転校生の先輩。また会いましたね……何かわたしに用ですか?」
	ELSE
		PRINTFORML 「（また転校生の先輩だ。ふらふら歩きすぎだもん……）あ、こんにちは」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_6
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございます、%CALLNAME:PLAYER%先輩♪ えへへ、今日も一緒なんですよね……うれしい」
	CASE 1
		PRINTFORML 「ふぁ……お、おはようございます、%CALLNAME:PLAYER%先輩。昨日、本を読んでて夜更かししちゃって……ねむい、です」
	CASE 2
		PRINTFORML 「%CALLNAME:PLAYER%先輩、おはよ♪ 今日もいい天気ですね。お弁当、ちゃんと持ってきましたよ……えへへ」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「あ、おはようございます、転校生の先輩。今日も元気そうで何よりです」
	CASE 1
		PRINTFORML 「ふぁ……お、おはようございます。すみません、寝不足で。本がおもしろくて、つい……」
	CASE 2
		PRINTFORML 「（また転校生の先輩。朝から忙しそう……）あ、おはようございます。お変わりないですか?」
	ENDSELECT
ENDIF
RETURN

