;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_6
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。%CALLNAME:PLAYER%先輩、もう……わたし、指も動かないです……。えへへ、でも……しあわせ……♪」
			CASE 1
				PRINTFORML 「腰、ぬけちゃいました……。先輩に、いっぱいされて……うう、立てない……♪」
			CASE 2
				PRINTFORML 「（あたま、ぼんやり……）……物語より、ずっとすごかった……。先輩、すき……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう……むりです……。こんなの、本にも書いてなかった……っ」
			CASE 1
				PRINTFORML 「ふぇ……体に、力が入らなくて……。す、すこし、休ませてください……っ」
			CASE 2
				PRINTFORML 「うう……腰が、笑ってます……。は、はじめて、こんな……っ」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「えへへ……%CALLNAME:PLAYER%先輩と、こんなことしちゃった……。物語みたい……♪」
			CASE 1
				PRINTFORML 「ふぅ……どきどきした……。先輩となら、何度でも……えへへ、欲ばりですね、わたし♪」
			CASE 2
				PRINTFORML 「先輩のこと、もっと好きになっちゃいました……。うう、こまっちゃう……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぇ……は、恥ずかしい……。わたし、こんな声……。み、見ないでください……♪」
			CASE 1
				PRINTFORML 「うう……。先輩の前で、あんな……。き、記録に残したいくらい……あっ、なんでもないです！」
			CASE 2
				PRINTFORML 「はぁ……体がぽかぽか……。えへへ、また……お願い、します……ね？」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「えへへ、%CALLNAME:PLAYER%先輩……今日もお疲れさまでした♪ 一緒にいられて、幸せ、でした」
		CASE 1
			PRINTFORML 「ふぅ……つかれちゃった。でも、%CALLNAME:PLAYER%先輩と一緒なら平気です。ありがとうございました」
		CASE 2
			PRINTFORML 「（あ、もう終わっちゃった……）%CALLNAME:PLAYER%先輩、また明日、一緒にいてくれますか? えへへ」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「お、お疲れさまでした、転校生の先輩。今日も……ありがとうございました」
		CASE 1
			PRINTFORML 「ふぅ……つ、疲れちゃった。転校生の先輩は元気ですね。わたし、お先に休ませてもらいますね」
		CASE 2
			PRINTFORML 「（また転校生の先輩のお世話になっちゃった……）あ、その。ほんとにありがとうございます」
		ENDSELECT
	ENDIF
ENDIF
RETURN


;==============================================================
; 【甲斐性なしプロポーズ口上】  @SELF_KOJO_K6
; ▼ 発生条件: TFLAG:13 == 95/96（指輪をはめた直後）
; ▼ 状況: パートナー側から転校生にプロポーズする場面
; ★山場: 十分なボリュームの口上にすること
;==============================================================
@SELF_KOJO_K6
IF TFLAG:13 == 95 || TFLAG:13 == 96
	PRINTFORMW 「%CALLNAME:PLAYER%先輩……。あの、ずっと考えてたんです、わたし。臆病だから、なかなか言えなかったんですけど。……『泣いた赤鬼』みたいに、手遅れになっちゃう前に、ちゃんと言葉にしておきたくて。先輩、わたしと結婚してくれませんか? わたし、ちっちゃくて体も弱くて、ご迷惑ばっかりかけるかもしれないけど。でも、先輩の側にいさせてください。一生、わたしを読んでてください……お願いします」
	RETURN 0
ENDIF

;==============================================================
; 【コマンド実行失敗口上】
; ▼ 発生条件: TFLAG:13 == 99（コマンドが条件不足等で実行できなかったとき）
;==============================================================
SIF TFLAG:13 != 99
	RETURN 0
A = RAND:3
IF A == 0
	PRINTFORMW 「あう、ごめんなさい……。これ、わたしにはまだ無理かも、です」
ELSEIF A == 1
	PRINTFORMW 「ひゃっ! あの、こころの準備がっ……まだ、なんですけど……?」
ELSE
	PRINTFORMW 「（うう、いつもこうなんだ。やな子だな、わたし……）ごめんなさい、転校生の先輩」
ENDIF
RETURN 0

