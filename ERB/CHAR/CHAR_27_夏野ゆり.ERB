;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_27
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「……噂の、転校生。あんまり近づかないで、男の人は苦手だから」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「……ここ吹奏楽部の部室。用がないなら出てって、練習の邪魔」
	ELSE
		PRINTFORML 「……美化委員会に、何の用。わたしは夏野、美化委員。関わるつもりはないけど、まあよろしく」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_27
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_27
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「……あんた。べつに待ってたわけじゃない、たまたま通っただけ」
	ELSEIF A == 1
		PRINTFORML 「……あ、また会った。今日は機嫌がいいから、隣にいてもいい」
	ELSE
		PRINTFORML 「……あんたの顔を見ると、なんだか落ちつく。誰にも言わないで」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「……またあんたか。べつに、嫌じゃないけど」
	ELSEIF A == 1
		PRINTFORML 「……何の用。用がないなら、行く」
	ELSE
		PRINTFORML 「……あんまり、近づかないで。それだけ」
	ENDIF
ENDIF
RETURN

