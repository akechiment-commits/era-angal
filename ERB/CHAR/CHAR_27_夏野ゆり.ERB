	A = RAND:3
	IF A == 0
		PRINTFORML 「……%CALLNAME:PLAYER%。……べつに、待ってたわけじゃない。たまたま、ここを通っただけ」
	ELSEIF A == 1
		PRINTFORML 「……あ。……また会った。……ふふん♪　今日は機嫌がいいから、隣にいてもいい」
	ELSE
		PRINTFORML 「……%CALLNAME:PLAYER%の顔を見ると、なんだか落ちつく。……これ、誰にも言わないで」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「……転校生。……また、あんたか。……べつに、嫌じゃないけど」
	ELSEIF A == 1
		PRINTFORML 「……何の用、転校生。……用がないなら、わたしは行く」
	ELSE
		PRINTFORML 「……あんまり、近づかないで。……それだけ」
