	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。パパ、もう……わたし、指も動かせない……。ふふ、でも……わるくなかった、です……♪」
			CASE 1
				PRINTFORML 「腰、抜けちゃいました……。パパにいっぱいされて……ん、立てない……かも……♪」
			CASE 2
				PRINTFORML 「（あたま、ぼんやり……分析どころじゃない……）……パパ、すき……。もう、なにも考えらんない……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう限界です……。こんなにバテたの、ライブ本番でもなかった……っ」
			CASE 1
				PRINTFORML 「ん……体に、力が入らない……。先輩、ちょっとだけ……休ませてください……」
			CASE 2
				PRINTFORML 「ふぅ……わたし、ヘトヘトです……。動けないんで、運んでくれます……？　あはは……」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……パパと、こんなことしちゃいました……。ふふ、わるくない、です……♪」
			CASE 1
				PRINTFORML 「ん……どきどきした。でも、パパとなら、何度でも……あれ、わたし欲ばりですね、ふふ♪」
			CASE 2
				PRINTFORML 「パパのこと、もっと好きになっちゃった……。困りますね、これ……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……は、恥ずかしい。わたし、こんな声出すんですね……。記録、しないでください……」
			CASE 1
				PRINTFORML 「ん……先輩の前で、あんな……。わ、忘れてくれると、助かります……」
			CASE 2
				PRINTFORML 「ん～、体があったかい。ふふ……また、いいですよ。先輩がしたいなら、ね？」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「お疲れさまでした、パパ。今日もふたりっきりで楽しかったです、ね♪　また明日も」
		CASE 1
			PRINTFORML 「ん～……パパ、もう行っちゃうんですか。まぁ、また明日。おやすみなさいですよ、パパ」
		CASE 2
			PRINTFORML 「今日もお疲れさま、パパ♪　わたし、一緒にいられて嬉しかったですよ。ちゃんと寝てくださいね」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「お疲れさまでした、先輩。また何か手伝わされそうな予感がしますけど、まぁ呼んでください」
		CASE 1
			PRINTFORML 「ん～……お疲れさまです、転校生の先輩。まぁまぁ、悪くない時間でしたよ、ね」
		CASE 2
			PRINTFORML 「じゃあ、また今度。先輩のこと、嫌いじゃないですよ、ぶっちゃけ」
		ENDSELECT
	ENDIF
ENDIF
