;============================================================
; 藤猪しずく　NO:20　?年1-C　軽音部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_20
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「ん～……何か用ですか、転校生の先輩？　わたし、藤猪しずくですけど。1-Cの。……また誰かのお手伝いに駆りだされる流れなんですよね、これ？」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「あっ、そこ機材だらけなんで気をつけて。うちの軽音部、わりとカオスなんで。何か用です？　わりと散らかってますけど」
	ELSE
		PRINTFORML 「ん～……選管の用です、転校生の先輩？　わたし兼任なんで手が離せないんですけど。急ぎじゃないなら、後にしてもらっていいですか」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_20
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_20
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、パパ。今、お時間あります？　ちょっと話したいことがあるんですけど。ほんとに」
	ELSEIF A == 1
		PRINTFORML 「（あ、パパだ……）……えへ。なんでもないです、お疲れさまですって伝えたかっただけ。ほめほめ♪」
	ELSE
		PRINTFORML 「ん～……パパ♪　またわたしを探しにきたんですか？　もう、暇なひとだなぁ……」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、転校生の先輩。お疲れさまです。今日もどっかに引きずり込む算段ですか？」
	ELSEIF A == 1
		PRINTFORML 「ん～……先輩、また忙しそうですけど。倒れたら誰が拾うんでしょうね、わたしですか？」
	ELSE
		PRINTFORML 「うわっ、出た。……あっ、すみません、つい。こんにちは、先輩」
	ENDIF
ENDIF
RETURN

