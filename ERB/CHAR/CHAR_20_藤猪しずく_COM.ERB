;--- COM340 バードキス ---
IF SELECTCOM == 340
	IF CFLAG:TARGET:229 == 0
		CFLAG:TARGET:229 = 1
		;初回
		PRINTFORML 「（あ……今、軽く触れただけで終わったやつだ）……ん～、これがバードキス、ですか。
		PRINTFORMW 鳥みたいって意味なのかな、ちょっとくすぐったいですけど」
	ELSE
		A = RAND:3
		;--- 失敗時 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORMW 「ん～……今のはタイミング、ずれてましたよ？　パパの急襲、びっくりしちゃったじゃないですか」
			ELSE
				;失敗
				PRINTFORMW 「ちょっ、急にやめてくださいパパ。びっくりするんで、せめてひとこと言ってからにしてくださいよ」
			ENDIF
		;--- 成功時 ---
		ELSE
			IF TALENT:TARGET:153
				IF A == 0
					PRINTFORMW 「ふふ、軽くですね。パパのキスってこんな感じなんだ……ちょっとだけって、もうちょっとだけ、ねだってもいいですか？」
				ELSEIF A == 1
					PRINTFORMW 「（鼻先がちょこんって……）……ん、いまの好き、です。すぐ離れちゃうのが、ちょっと寂しいけど」
				ELSE
					PRINTFORMW 「あはは、軽すぎ♪　もう、パパってじらすのうまいなぁ。でも、嫌いじゃないですけどね」
				ENDIF
			ELSE
				IF A == 0
					PRINTFORMW 「あ、軽い、やつなんだ。ん～……これくらいなら、まぁいいですけど。ちゃんと予告してくださいね」
				ELSEIF A == 1
					PRINTFORMW 「（うわ、ほんとに鳥みたいな……）……ふぅ、心臓に悪いんで、続けてやられると困るんですけど」
				ELSE
					PRINTFORMW 「ん～、パパって、こういうのするひとなんだ。意外、ですけど。嫌じゃないです」
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF

