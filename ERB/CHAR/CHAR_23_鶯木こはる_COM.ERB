	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「お勉強？　おいら、日本語まだむずかしいんだ。お兄ちゃん先輩、教えてくれるのか？　えへへ、たすかるぞっ♪」
	ELSE
		A = RAND:3
		;--- 失敗 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORMW 「がう……むずかしくて、頭こんがらがっちゃった……。お兄ちゃん先輩、おいら、もう狩りに行きたいぞ……だめか？」
