;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_24
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……もう、力が入んないよぉ。でも、しあわせ……ダーリンの腕のなかで、このまま寝ちゃいたいな♪」
			CASE 1
				PRINTFORML 「ふにゃ……腰が抜けちゃった。あはは、君ってば激しいんだもん……でも、もうちょっとくっついててもいい？」
			CASE 2
				PRINTFORML 「もう一歩も歩けないよぉ……ねぇ、おんぶして？　えへへ、こういうのも幼なじみの特権♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……つ、疲れた……。んもう、こんなにくたくたにさせて……。ちょっと、休ませて……？」
			CASE 1
				PRINTFORML 「あぅ……腰が、立たない……。み、見ないでよぉ、こんなだらしないとこ……」
			CASE 2
				PRINTFORML 「ぜぇ、ぜぇ……。やだ、汗だくだよ……。お風呂入りたい……い、一緒には入んないけどっ」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「えへへ、今日もいっぱい愛してもらっちゃった♪　ねぇダーリン、まだ離れたくないなぁ……」
			CASE 1
				PRINTFORML 「ふふ、満足……♪　君とこうしてると、世界でいちばん幸せな気分になれるんだ」
			CASE 2
				PRINTFORML 「もう、君ったら甘えん坊さんだなぁ♪　いいよ、もうちょっとだけ……ぎゅってしてあげる」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……は、恥ずかしかったぁ。んもう、君のえっち……。で、でも、嫌じゃ、なかったけど」
			CASE 1
				PRINTFORML 「あはは……何だか、変な感じ。幼なじみと、こんなこと……。ま、まぁ、たまにはいっか♪」
			CASE 2
				PRINTFORML 「もう、おしまい？　……べ、べつに、もっとしたいわけじゃないからね？　勘違いしないでよ？」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「じゃあね、ダーリン♪　また明日。あっ、晩ご飯うちで食べてく？　えへへ、待ってるね」
		CASE 1
			PRINTFORML 「今日も楽しかったね♪　気をつけて帰ってね、ダーリン。……窓、開けとくから。おやすみのお喋りしようね」
		CASE 2
			PRINTFORML 「もう行っちゃうの？　ん～、寂しいなぁ……。ほら、いってらっしゃいのちゅー♪　なんてね、えへへ」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「それじゃ、またね。ちゃんとまっすぐ帰るんだよ？　寄り道して厄介事に巻きこまれないように、ね？」
		CASE 1
			PRINTFORML 「お疲れさま、転校生くん。あんまり無理しちゃ駄目だよ。何かあったら、すぐ呼んでね」
		CASE 2
			PRINTFORML 「じゃ、また明日ね♪　あっ、お弁当の感想ちゃんと聞かせてよ？　次の参考にするからさ」
		ENDSELECT
	ENDIF
ENDIF
RETURN


;==============================================================
; 【甲斐性なしプロポーズ口上】  @SELF_KOJO_K24
