;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 三波なつみ　NO:24　?年2-A　美術部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_24
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「やっほ♪　よかった、同じクラスだね。わたしのこと、覚えてる？　三波なつみだよ。むかし、よく遊んだよね……君がうちの学校に転校してくるなんて、ほんとびっくりしちゃった。最初は慣れないかもだけど、困ったことがあったら何でも相談してね？」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「あれっ、君！　美術部に何か用かな？　……って、転校生くんじゃない！　あはは、奇遇だね。わたし、ここの美術部なんだ。むかしの幼なじみとこんなとこで再会だなんて、なんだか運命を感じちゃうなぁ♪」
	ELSE
		PRINTFORML 「やっほ、こんなところで会うなんてね♪　わたし、三波なつみ。覚えてるかな、君のお隣に住んでた幼なじみだよ。また君と同じ学校だなんて……えへへ、これからよろしくね？」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_24
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_24
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、ダーリン♪　ちょうど会いたかったんだ、えへへ。君の顔を見ると安心しちゃうなぁ」
	ELSEIF A == 1
		PRINTFORML 「やっほ。ふふ、君の顔を見ると一日がんばれるんだよね♪　今日も会えてうれしいな」
	ELSE
		PRINTFORML 「もう、こんなところにいたんだ？　ずっと探してたんだよ、もぉ～♪　離れちゃ嫌だよ？」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生くん。今日もあちこち大忙しだね。あんまり無理しちゃ駄目だよ？」
	ELSEIF A == 1
		PRINTFORML 「やっほ。ちゃんとご飯食べてる？　心配だなぁ、君は放っておくとすぐサボるから」
	ELSE
		PRINTFORML 「あれ、奇遇だね♪　……って、わたしたちお隣さんだもんね。会わないほうが難しいか、あはは」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_24
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよう、ダーリン♪　今日もお弁当、ちゃんと作ってきたからね？　えへへ、楽しみにしてて」
	CASE 1
		PRINTFORML 「ん～、おはよう♪　ふふ、毎朝こうして君に挨拶できるの、すっごく幸せ。今日も一緒にがんばろうね」
	CASE 2
		PRINTFORML 「おはよ。もう、君ったらまた寝癖ついてるよ？　ほら、じっとして……はい、直してあげた♪」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよう、転校生くん。今朝もちゃんと起きられた？　寝坊助さんだもんね、君は」
	CASE 1
		PRINTFORML 「やっほ、おはよう♪　今日も一日がんばろうね。困ったことがあったら、いつでも言ってね？」
	CASE 2
		PRINTFORML 「おはよ～。あっ、目の下にクマできてるよ？　また夜更かししたでしょ、まったくもう……」
	ENDSELECT
ENDIF
RETURN

