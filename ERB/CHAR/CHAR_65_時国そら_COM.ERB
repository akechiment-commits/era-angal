;--- COM340 バードキス ---
IF SELECTCOM == 340
	IF CFLAG:TARGET:229 == 0
		CFLAG:TARGET:229 = 1
		;初回
		PRINTFORMW 「ちゅ……。ん、ふ……。鳥さんみたいな、軽いキス。……ふふ、くすぐったい。ゆん、ゆん♪」
	ELSE
		A = RAND:3
