;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「一緒に、勉強……？　ふふ、いいよ。屋上だと、宇宙線が集中力を高めてくれるの。ほんとうだよ？　ゆん、ゆん……♪」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「あなたと並んで勉強してると、ページをめくる音まで愛おしい……ふふ。集中、できないかも」
			ELSEIF A == 1
				PRINTFORMW 「ん……わからないところ？　ここはね、こう。……えへ、たまには、わたしも頼られてみたい」
			ELSE
				PRINTFORMW 「（あなたの横顔、ずっと見ていたい）……あ、ごめん。問題、解いてたんだよね。続けよ？」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「あなたとなら、勉強も静かでいいね。ゆん、ゆん……はかどるみたい」
			ELSEIF A == 1
				PRINTFORMW 「ここ、教えてあげる。わたし、宇宙のこと以外も、すこしは知ってるんだから。ふふ」
			ELSE
				PRINTFORMW 「ん、いっしょにやろう。あなたがいると、雑音が気にならないの。ふしぎ」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「勉強……。わからないところは、聞いて。聞こえてるから、ぜんぶ」
			ELSEIF A == 1
				PRINTFORMW 「ゆん、ゆん……。集中、集中。屋上は、静かでいいね」
			ELSE
				PRINTFORMW 「ふぅ……。ちょっと、休憩。あなたも、無理しないでね」
			ENDIF
		ENDIF
	ENDIF
ENDIF

