;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「あっ、転校生の先輩も勉強ですか？　ちょうどよかった！　あたし今、ちよちゃんに教えてもらってる途中なんですけど、ついでに先輩も一緒にどうですか？　えへへ、にぎやかなほうが捗りますよ♪」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「お兄ちゃん先輩～、この問題が全然わかんないんですけど！　いっしょに考えてくれますか？　彼氏特権でよろしくお願いします♪」
			ELSEIF A == 1
				PRINTFORMW 「えへへ……お兄ちゃん先輩の隣で勉強するの、なんか落ち着くんですよね♪　集中できるようで、できないというか……♪」
			ELSE
				PRINTFORMW 「あ、そこそこ！　そこの問題、あたし全部間違えたやつですよ！　解き方教えてください、お兄ちゃん先輩！」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「転校生の先輩、数学得意ですか？　あたしちよちゃんに頼りっぱなしで……先輩にも少し教えてもらっていいですか？」
			ELSEIF A == 1
				PRINTFORMW 「うわあ、先輩ってなんでもわかるんですね……！　ちよちゃんと肩を並べる天才では……？」
			ELSE
				PRINTFORMW 「赤点だけは回避しないと、ラクロスの試合に出られなくなるんですよ！　一緒にがんばりましょう、ファイトです！」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「転校生の先輩も自習中ですか？　うう、あたし馬鹿だから毎回ギリギリで……静かに横で勉強させてもらっていいですか？」
			ELSEIF A == 1
