;============================================================
; 高原ちあき　NO:7　コマンド反応
; CFLAG:TARGET:210～ = コマンド初回フラグ
;   210=勉強 211=会話 212=プレゼント 213=スキンシップ
;   214=昼食 215=部活見学 216=一緒に帰宅 217=デート
;============================================================

@KOJO_MESSAGE_COM_7
SIF TEQUIP:45 && SELECTCOM != 45
	RETURN 0

;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		PRINTFORMW 「」
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「」
		ELSEIF A == 1
			PRINTFORMW 「」
		ELSE
			PRINTFORMW 「」
		ENDIF
	ENDIF
ENDIF

