;---------------------------------------------------------
; @KOJO_JUN_K50 : ターンイベント別口上
; TFLAG:600の値で場面を判別
;---------------------------------------------------------
@KOJO_JUN_K50

;--- 28: 初対面 ---
IF TFLAG:600 == 28
	IF CFLAG:450 == 0
		PRINTFORMW 「……ねぇ、転校生くん。あたし、あんたのこと気にいっちゃったわさ。最初は道案内係だと思ってたんだけどね～？　いつの間にか、あんたの顔が見たくてうずうずするようになっちゃった♪　これって……『好き』ってやつかにゃあ？」
		CFLAG:450 = 1
	ENDIF
ENDIF

;--- 1: 初キス ---
IF TFLAG:600 == 1
	PRINTFORMW 「ん……♪　唇って柔らかいんだね～？　あたし、こういうの初めてだから……ちょっと、どきどきしちゃったわさ。にゃはは、もういっかい、しよ？」
ENDIF

;--- 2: 告白成功 ---
IF TFLAG:600 == 2
	PRINTFORMW 「ほんと？　あたしでいいの？　あんたみたいな見込みのある男の子に想われるなんて、僥倖僥倖だわさ♪　……あたしね、ずっと自分は誰かと結ばれる人生じゃないって思ってた。でも、あんたとならその決まりきった運命に抗ってみたくなる。よぉし、決まりだわさ☆　今日からあんたは、あたしの大事な大事な恋人くん！　たぁっぷり甘やかして、たっぷり愛してあげるからね～、にゃはは♪」
ENDIF

;--- 3: 告白（もう少し待って） ---
IF TFLAG:600 == 3
	; TFLAG:601: 1=保留（もう少し待って） / 0=無下に断る
	IF TFLAG:601 == 1
		PRINTFORMW 「……ごめんね、転校生くん。あんたの気持ちは嬉しいわさ。でもさ、あたしにはちょっとややこしい事情があってね～？　もうすこしだけ、待ってくれる？　あたしの覚悟が決まるまで……ね？」
	ELSE
		;無下に断る（判定値が大きく届かない）
		PRINTFORMW 「ごめんね？　あんたのことは嫌いじゃないけど、そういうのはまだピンとこないわさ。あたし、神出鬼没だからね～、捕まえるならもっと腕を磨いてからおいで？」
	ENDIF
ENDIF

;--- 22: パートナー交代（旧パートナーの別れ際）---
IF TFLAG:600 == 22
	IF TALENT:TARGET:153
		PRINTFORMW 「あたしを選んでくれて嬉しいわさ♪　よぉし、あんたのこと、あたしがたぁっぷり面倒みてあげる～、にゃはは☆」
	ELSE
		PRINTFORMW 「お～☆　あたしがパートナーでいいの？　ふぅん、変わった子だね～。まぁいいわさ、よろしくっ☆」
	ENDIF
ENDIF

;--- 60: パートナー交代（新パートナーの挨拶）---
IF TFLAG:600 == 60
	IF TALENT:TARGET:153
		PRINTFORMW 「今日からあたしが、あんたの一番そばにいる相棒だわさ♪　離さないでね～、にゃはは☆」
	ELSE
		PRINTFORMW 「お～、これからよろしくだわさ☆　神出鬼没のぎんちゃんを相棒にできるなんて、運がいいよ～う♪」
	ENDIF
ENDIF

;--- 25: デートからのファーストキス（相手から）---
; ▼ 状況: デートを終了した際、このキャラが主人公にファーストキスをしてきた直後。
;   COMF323.ERB @CHECK_DATE から TFLAG:600 = 25 で呼ばれる。
;   相手側から突発的にキスしてくる場面。感情高揚・恋じらいなどを表現。
;   (頂 TFLAG:600 == 1 は主人公からの初キス。これは相手側から)
; ★山場: 相手からのファーストキスは長めの口上にすること
IF TFLAG:600 == 25
	PRINTFORMW  「……ねぇ、転校生くん。今日のデート、すっごく楽しかったわさ♪　こんなに穏やかな時間、あたし久しぶりで……。ねぇ、ちょっとだけ目を閉じて？　こういうのはあたしから、ってのも乙なもんでしょ？　……ん♪　……どう、どきどきした？　あたしね、キスなんて初めてだったから、すっごく勇気がいったんだよ～う？　でも、あんたが相手なら……怖くなかった。あたしの初めて、あんたにあげちゃった♪　責任、とってよね～、にゃはは☆」
ENDIF

;--- 26: デートからの告白（相手から）---
; ▼ 状況: デートを終了した際、このキャラが主人公に告白してきた直後。
;   COMF323.ERB @CHECK_DATE から TFLAG:600 = 26 で呼ばれる。
;   (頂 TFLAG:600 == 2 は主人公からの告白成功。これは相手側から)
; ★山場: 相手からの告白は長めの口上にすること
IF TFLAG:600 == 26
	PRINTFORMW  「……%CALLNAME:PLAYER%。あのね、今日はあたしから、ちゃんと言葉にしたくて。あたし、ずっと飄々と生きてきた。誰にも本気で執着しないように、抜き身の刃物みたいに、ひとりでね。……でも、あんたは違った。あたしの飄々の奥にある寂しさまで、見つけてくれたから。だからさ、言わせて。あたし、あんたのことが好きだわさ、本気で。こんなあたしでよかったら……あたしを、もらってくれる？　縁談も宿命も蹴っ飛ばして、あんたのそばにいたいんだわさ♪」
ENDIF

RETURN 0

;------------------------------------------------------------
; 【妊娠・出産・育児 口上】
;
; 呼び出し元: EVENT_K @SELF_KOJO → @KOJO_NINSIN_K50
; セリフは PRINTFORMW  「セリフ」 に書く（W=入力待ち）
; ▼ 誰が妊娠させたか (CFLAG:TARGET:104):
;   1=マスター  2=助手  3=パートナー
;------------------------------------------------------------
@KOJO_NINSIN_K50

;--- 妊娠発覚 (TFLAG:13 == 20) ---
; ▼ 状況: このキャラが妊娠していることが発覚した直後。
;   中田氏後に確率で妊娠判定が成立したとき呼ばれる。
;   CFLAG:TARGET:104 : 1=転校生の子  2=助手の子  3=パートナーの子
;   CFLAG:TARGET:112 : 妊娠カウンター（1=初回  2以上=2回目以降）
;   TALENT:TARGET:85 : 恋慕フラグ（グッドルート判定）
IF TFLAG:13 == 20
	; 転校生の子 かつ 恋慕あり（グッドルート）
	IF CFLAG:TARGET:104 == 1 && TALENT:TARGET:85
		; ★山場: 初回のグッド妊娠は長めの口上にすること
		IF CFLAG:TARGET:112 >= 2
			; ▼ 2回目以降（何回目かは特定しない）
			; 初めての妊娠ではないことは伝わるが、2回目と決め打ちしないセリフに。
			; 初回ほどの感情の高ぶりはなく、簡素でよい。
			PRINTFORMW  「また、あたしのお腹に新しい命が宿ったわさ♪　ね？　あんたとの家族が、また増えるんだね～。今度も、元気に産んであげるからね、にゃはは☆」
		ELSE
			; ▼ 初回（CFLAG:TARGET:112 == 1）
			PRINTFORMW  「……ねぇ、%CALLNAME:PLAYER%。あたしね、赤ちゃんができたみたい……。信じられる？　あの自由気ままなぎんちゃんが、お母さんになるんだよ～う♪　あんたとの、大事な大事な命だわさ。ぜったいに、ぜ～ったいに守ってみせる☆」
		ENDIF
	; 転校生の子（恋慕なし）
	ELSEIF CFLAG:TARGET:104 == 1
		PRINTFORMW  「ふぅん、どうやら身籠ったみたいだわさ。あんたの子だね～？　まぁ、できちゃったもんは仕方ないわさ。ちゃんと、責任は果たすよ～う♪」
	; 助手・パートナーの子
	ELSE
		PRINTFORMW  「あらら、お腹に命が宿っちゃったわさ？　誰の子かは……ご想像にお任せするわさ♪　ま、元気に育てればそれでいいよね～、にゃはは☆」
	ENDIF
	RETURN 0
ENDIF

;--- 妊娠発覚２ (TFLAG:13 == 94) ---
; ▼ 状況: 別のキャラ（助手・パートナー）が妊娠した際の
;   このキャラ（TARGET）のリアクション。
;   例: 主人公が助手を妊娠 → パートナーのリアクション
;       助手が奴隷を妊娠 → 助手のリアクション
IF TFLAG:13 == 94
	PRINTFORMW  「ほぉ、あの子が身籠ったって？　めでたいことだわさ♪　命が増えるのは、いいことだよ～う☆」
	RETURN 0
ENDIF

;--- 臨月 (TFLAG:13 == 25) ---
; ▼ 状況: 出産予定日の3日前。臨月を迎えて育児室へ移動する
;   直前に呼ばれる。以降は出産まで調教不可。
IF TFLAG:13 == 25
	PRINTFORMW  「……っ。お腹の子が、危ない……？　なんて言ってる場合じゃないわさ。あたしは平気だから、はやくお医者さんに……っ。お願い、この子だけは……。」
	RETURN 0
ENDIF

;--- 出産 (TFLAG:13 == 21) ---
; ▼ 状況: 出産予定日に赤ちゃんが産まれた直後。
;   TFLAG:17 で感情・関係性による3分岐:
;     1 = グッド  : 恋慕あり かつ 主人公が父親
;     2 = ノーマル: それ以外の通常ケース
;     3 = バッド  : 素質「感情乏しい」「無関心」持ち かつ 恋慕なし
;   EXP:TARGET:61 : 出産回数（0=初回  1以上=2回目以降）
IF TFLAG:13 == 21
	; グッド（恋慕あり・主人公が父親）
	IF TFLAG:17 == 1
		; ★山場: グッド出産は長めの口上にすること
		IF EXP:TARGET:61 >= 1
			; ▼ 2回目以降の出産（何回目かは特定しない）
			; 出産が初めてではないことは伝わるが、2回目と決め打ちしないセリフに。
			; 初回ほどの山場ではないので簡素でよい。
			PRINTFORMW  「……ふぅ、産まれたわさ♪　何度味わってもこの瞬間は格別だね～。元気な産声だわさ、にゃはは☆」
		ELSE
			; ▼ 初回出産（EXP:TARGET:61 == 0）
			PRINTFORMW  「……はぁ、はぁ……っ。産まれた……！　聞こえる？　元気な産声だわさ♪　あたしとあんたの子だよ、%CALLNAME:PLAYER%。……ちっちゃくて、あったかくて……剣より重い宝物を、抱いちゃったね。ありがとう、あたしをお母さんにしてくれて……にゃはは……☆」
		ENDIF
	; バッド（感情乏しい・恋慕なし）
	ELSEIF TFLAG:17 == 3
		PRINTFORMW  「……産まれたわさ。ちっちゃいね～。ま、産んだからにはちゃんと育てるわさ。それがあたしの責任だからね～？」
	; ノーマル
	ELSE
		PRINTFORMW  「……ふぅ、産まれたわさ♪　元気な子だね～、よかったよかった☆　あたしが、この子を守ってあげなくっちゃね♪」
	ENDIF
	RETURN 0
ENDIF

;--- 育児室 (TFLAG:13 == 23) ---
; ▼ 状況: 育児中（出産後～20日）のキャラに育児室コマンドで
;   話しかけたとき。この期間は通常の調教コマンドが使えない。
IF TFLAG:13 == 23
	PRINTFORMW  「お乳が張っちゃってさ～、ちょっと恥ずかしいけど……。あんたが飲んでくれるなら、世話ないわさ♪　ほら、たくさんお飲み～、にゃはは♪」
	RETURN 0
ENDIF

;--- 親離れ (TFLAG:13 == 22) ---
; ▼ 状況: 出産から20日後、子供が親離れして育児終了。
;   このキャラが通常調教に戻れるようになった直後。
IF TFLAG:13 == 22
	PRINTFORMW  「ふふ……♪　すっかりお母さんだわさ、あたし。こうして甘えられるのも悪くないね～。さ、いっぱい甘えていいんだよ～う♪」
	RETURN 0
ENDIF

RETURN 0

;==============================================================
; パートナー噴乳時  @CHAR_MILK_50
; TFLAG:11=量(1=通常 2=大量)
; 【セリフ方針】
;   恋慕時（TALENT:TARGET:153）: プレイヤーとの繋がり・捧げる気持ちを意識したセリフ
;   通常時: 自分の体への困惑・恥ずかしさを主にしたセリフ
;   大量時（TFLAG:716>=10）: 止まらない感覚・強烈な快感に支配されたセリフ
;==============================================================
@CHAR_MILK_50
;--- 大量噴乳 ---
IF TFLAG:716 >= 10
	A = RAND:3
	IF TALENT:TARGET:153
		IF A == 0
			;恋人・大量・1
			PRINTFORMW 「にゃはは……♪　お～、すっごい出るわさ……！　あんたに搾られると、なんだかぞくぞくしちゃうね～♪」
		ELSEIF A == 1
			;恋人・大量・2
			PRINTFORMW 「ふぁ……♪　止まんないよ～う、こんなに溢れちゃって……。あんた、搾るの上手だね～☆」
		ELSE
			;恋人・大量・3
			PRINTFORMW 「ん……っ♪　あたしの胸、こんなにいっぱい……。あんたのために出てるんだと思うと、嬉しいわさ♪」
		ENDIF
	ELSE
		IF A == 0
			;通常・大量・1
			PRINTFORMW 「お～、こんなに出るもんなんだね～？　自分の身体ながらびっくりだわさ、にゃはは☆」
		ELSEIF A == 1
			;通常・大量・2
			PRINTFORMW 「ん……っ、すごい量だわさ。胸が軽くなって、すっきりするね～♪」
		ELSE
			;通常・大量・3
			PRINTFORMW 「ふぅ……♪　搾っても搾っても出てくるわさ。あたしの身体、丈夫すぎかにゃあ☆」
		ENDIF
	ENDIF
;--- 通常噴乳 ---
ELSE
	A = RAND:3
	IF TALENT:TARGET:153
		IF A == 0
			;恋人・通常・1
			PRINTFORMW 「ふふ♪　あんたに搾ってもらうと、なんだか安心するわさ～♪」
		ELSEIF A == 1
			;恋人・通常・2
			PRINTFORMW 「ん……♪　くすぐったいような、気持ちいいような……。あんたの手つき、優しいね☆」
		ELSE
			;恋人・通常・3
			PRINTFORMW 「にゃはは♪　あたしの胸でよければ、いくらでも甘えていいんだよ～う♪」
		ENDIF
	ELSE
		IF A == 0
			;通常・通常・1
			PRINTFORMW 「張ってたから助かるわさ☆　ふぅ、すっきりした♪」
		ELSEIF A == 1
			;通常・通常・2
			PRINTFORMW 「ん、こんなもんかにゃあ？　搾ってくれてありがとね～☆」
		ELSE
			;通常・通常・3
			PRINTFORMW 「ふふん☆　こうやって搾ると、なんだか牛さんになった気分だわさ～♪」
		ENDIF
	ENDIF
ENDIF
RETURN 0

