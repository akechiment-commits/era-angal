;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 三善かなえ　NO:1　?年1-A　吹奏楽部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_1
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「おや？　あなたが噂の転校生さん……ですか。私は三善かなえと申します、1-Aの。ふふ、よろしくお願いしますね♪　わからないことがあれば、丁寧にご案内しますから」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「あら、ここは吹奏楽部の部室ですよ？　……あぁ、もしかして転校生さんですね。私は三善かなえ、クラリネット担当です。ふむ、せっかくですし、少し演奏を聴いていきますか？」
	ELSE
		PRINTFORML 「おや、こんなところまでいらしたんですか。迷子……ではないですよね？　ふふ、私は三善かなえと申します。ご案内が必要でしたら、お任せくださいね」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_1
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_1
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生さん。ふふ、また会えましたね♪　……べ、別に追いかけたわけではありませんよ？」
	ELSEIF A == 1
		PRINTFORML 「（転校生さん、お疲れさまです……。あぁもう、お顔を見ただけで胸が温かくなるなんて、私は重症ですね）」
	ELSE
		PRINTFORML 「おや、転校生さん。ぴこちゃんに、私たちのことをまたからかわれてしまいました。まったくもう……♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「転校生さん、こんにちは。ふむ、学校生活には慣れましたか？」
	ELSEIF A == 1
		PRINTFORML 「おや、転校生さん。最近よくお会いしますね……何かのご縁でしょうか」
	ELSE
		PRINTFORML 「あ、転校生さん。ぴこちゃんを見ていませんか？　あぁもうっ、また忘れ物をしてドジったみたいで……」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_1
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございます、転校生さん♪　ふふ、隣の席、ちゃんと空けておきましたから……今日もよろしくお願いしますね」
	CASE 1
		PRINTFORML 「（朝から転校生さんのお顔が見られるなんて、私は果報者です……）……お、おはようございます」
	CASE 2
		PRINTFORML 「おはようございます。今朝はちゃんと早起きできましたよ♪　……ぴこちゃんは、またぎりぎりですけど」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございます、転校生さん。ふむ、今日もいい朝ですね」
	CASE 1
		PRINTFORML 「おや、転校生さん、おはようございます。今日も一日、頑張りましょうね」
	CASE 2
		PRINTFORML 「おはようございます。ふふ、転校生さんは寝癖がないですね。朝、お強いほうですか？」
	ENDSELECT
ENDIF
RETURN

;------------------------------------------------------------
; 休憩（SHOPで休憩を選んだとき）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REST_1
IF TALENT:TARGET:153
	PRINTFORML 「ふふ、休憩ですか。でしたらお茶を淹れますね……転校生さんと過ごす時間、わたし、好きですよ♪」
ELSE
	PRINTFORML 「休憩ですか、ふむ。たまには体を休めるのも大切ですよね。お茶でも、いかがですか？」
ENDIF
RETURN

;------------------------------------------------------------
; 昼食（LUNCH_EAT_昼食・食事 経由・昼に呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_LUNCH_1
IF TALENT:TARGET:153
	PRINTFORML 「あ、転校生さん。ふふ、お昼を一緒に……今日はお弁当を作ってきたんです。ええ、ふたり分♪　一口、あげましょうか？」
ELSE
	PRINTFORML 「おや、転校生さん。お昼ですか。学食の『豚角煮サンド』、半分こでいかがですか？　ふふ、ずっと挑戦してみたかったんですよ」
ENDIF
RETURN

;------------------------------------------------------------
; パートナー選択時（SHOPメニューで選択した直後）
; TFLAG:88: 0=イチャイチャ  2=休憩  3=スキル習得
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_PARTNER_DIALOG_1
IF TALENT:TARGET:153
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「私を選んでくださったんですね。ふふ、嬉しいです♪　……何でも付き合いますよ、転校生さん」
	CASE 1
		PRINTFORML 「ふふ、今日は私とですね。……ええ、喜んで。あなたとなら、退屈はしませんから」
	CASE 2
		PRINTFORML 「（また、選んでくれた……）……な、なんでもありません。さあ、参りましょうか、転校生さん」
	ENDSELECT
ELSE
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「私を、ですか？　ふむ……いいでしょう。お手伝いできることがあるなら、精一杯お務めしますから」
	CASE 1
		PRINTFORML 「ふむ、私でよろしいので？　……では、お供します。手際よくまいりましょう」
	CASE 2
		PRINTFORML 「あら、私ですか。……ふふ、光栄ですね。精一杯、務めさせていただきます」
	ENDSELECT
ENDIF
RETURN

;------------------------------------------------------------
; 初パートナー選択時（初めてこのキャラをパートナーに選んだ瞬間・1回のみ）
; CFLAG:TARGET:201=0→初回のみ発動。LOCATION_EVENT経由で呼ばれる
;------------------------------------------------------------
@CHAR_FIRST_PARTNER_1
IF CFLAG:TARGET:201 == 0
	CFLAG:TARGET:201 = 1
	IF TALENT:TARGET:153
		PRINTFORML 「え……私を、パートナーに？　……ふふ、光栄です。転校生さんのために、わたしが、できる限りのことを精一杯♪」
	ELSE
		PRINTFORML 「私をパートナーに？　ふむ……いいでしょう。準備は万全に整えますから、安心してお任せくださいね」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_1
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。もう、指一本……動きません……。あなたに、ぜんぶ持っていかれました……ふふ」
			CASE 1
				PRINTFORML 「（こんなに……乱されたのは、初めて……）……転校生さん、すこし、休ませて……？」
			CASE 2
				PRINTFORML 「腰が……立ちません……。ふふ、責任、とってくださいね……？」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……。も、もう……許してください……。私、おかしくなって、しまいます……」
			CASE 1
				PRINTFORML 「うう……体に、力が入りません……。こ、こんなの、知りませんでした……」
			CASE 2
				PRINTFORML 「……っ、はぁ……。し、心臓が、もちません……。すこし、だけ……休憩を……」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……。私、こんなに乱れてしまうなんて。……転校生さんの前だけ、ですからね？」
			CASE 1
				PRINTFORML 「（まだ、胸の奥がぽかぽかしてる……）……ふふ、今日も、満たされました」
			CASE 2
				PRINTFORML 「もう少し、このままで……。いえ、何でもありません。……ありがとう、ございました」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「……み、見ないでください。こんな、はしたない私……。（うう、顔が火照る……）」
			CASE 1
				PRINTFORML 「ふぅ……。い、いまのは忘れてください。私らしくも、ありませんでした」
			CASE 2
				PRINTFORML 「……っ。べ、別に、感じていたわけでは……。ふふ、嘘です。すこし、だけ」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「お疲れさまでした、転校生さん。……ふふ、また、明日もご一緒できますか？」
		CASE 1
			PRINTFORML 「（あぁ、もうこんな時間ですか……。離れがたいですけど、そろそろ切り上げないと駄目ですよね）」
		CASE 2
			PRINTFORML 「今日もありがとうございました♪　ふふ、転校生さんと過ごす時間は、本当にあっという間ですね……」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「お疲れさまでした。ふふ、転校生さんもお気をつけて」
		CASE 1
			PRINTFORML 「ふむ、今日はこのへんで終わりにしましょうか。また何かあれば声をかけてくださいね」
		CASE 2
			PRINTFORML 「これで終わりですね。お役に立てたなら、案内役の冥利に尽きますよ♪」
		ENDSELECT
	ENDIF
ENDIF
RETURN


;==============================================================
; 【甲斐性なしプロポーズ口上】  @SELF_KOJO_K01
; ▼ 発生条件: TFLAG:13 == 95/96（指輪をはめた直後）
; ▼ 状況: パートナー側から転校生にプロポーズする場面
; ★山場: 十分なボリュームの口上にすること
;==============================================================
@SELF_KOJO_K01
IF TFLAG:13 == 95 || TFLAG:13 == 96
	PRINTFORMW 「……転校生さん。少し、聞いてもらえますか。……私、ずっと考えていたんです。あなたといる時間が、どうしてこんなにも心地いいのか。答えは、とうに出ていました。ふふ、認めるのは少し悔しいですけれど。%CALLNAME:PLAYER%さん、私を……あなたの妻に、してくれませんか。甲斐性なんて、なくていい。私が支えます。だから、この先もずっと、隣にいさせてください。……返事は急ぎません。（どうか、頷いて……）」
	RETURN 0
ENDIF

;==============================================================
; 【コマンド実行失敗口上】
; ▼ 発生条件: TFLAG:13 == 99（コマンドが条件不足等で実行できなかったとき）
;==============================================================
SIF TFLAG:13 != 99
	RETURN 0
A = RAND:3
IF A == 0
	PRINTFORMW 「……今は、難しいようですね。ふむ、出直してまいります」
ELSEIF A == 1
	PRINTFORMW 「あら、条件が足りませんでしたか。……失礼、私としたことが」
ELSE
	PRINTFORMW 「……今日は、ここまでですね。また改めて、ということで」
ENDIF
RETURN 0

;------------------------------------------------------------
; 体育祭（SCHOOL_EVENT経由・秋開催）
; ARG:0: 0=参加  1=3位  2=準優勝  3=優勝
;------------------------------------------------------------
@CHAR_SPORTS_FESTIVAL_1, ARG
IF ARG:0 == 3
	PRINTFORML 「ま、まさか優勝だなんて……っ！　ふふっ。誰にも頼らずひとりでも大丈夫だと見栄を張っていた私が、こんなに大勢で勝ち取れるなんて――転校生さん、ありがとうございますっ♪」
ELSEIF ARG:0 == 2
	PRINTFORML 「準優勝……ふふ、悔しいですけど、嬉しいです。最後の競技で、もう少し体力配分をきちんと考えるべきでしたね。次回への反省材料です」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位ですか。ふむ、健闘したと思います。……でも、夏野部長と比べると、私はまだまだですね。く、悔しい……っ」
ELSE
	PRINTFORML 「ふぅ、終わりましたね。順位は振るいませんでしたが、参加することに意味があった……と、自分を慰めておきましょう」
ENDIF
RETURN

;------------------------------------------------------------
; 文化祭（SCHOOL_EVENT経由・秋開催）
; ARG:0: 0=普通  1=まあまあ  2=成功  3=大成功
;------------------------------------------------------------
@CHAR_CULTURE_FESTIVAL_1, ARG
IF ARG:0 == 3
	PRINTFORML 「大成功――っ！　ふふっ、私たちのアンサンブル、ちゃんと届いたみたいですね♪　ぴこちゃんも、夏野部長も、皆さんで掴み取った結果です。本当に……嬉しい」
ELSEIF ARG:0 == 2
	PRINTFORML 「成功してくれて、ほっとしました……ふぅ。本番直前に怖くなって逃げ出さなかったのは、たぶん転校生さんのおかげですね」
ELSEIF ARG:0 == 1
	PRINTFORML 「ふむ、まあまあ……ですか。ええ、本番に弱い私としては及第点でしょう。次回はもっと、心して練習を重ねますね」
ELSE
	PRINTFORML 「普通の結果……ですか。ふぅ、もっと練習しておけばよかった、と反省しております。次への糧にしますから」
ENDIF
RETURN

;------------------------------------------------------------
; クイズ選手権（ARG:0: 0=参加 1=3位 2=準優勝 3=優勝）
;------------------------------------------------------------
@CHAR_KNOWLEDGE_CONTEST_1, ARG
IF ARG:0 == 3
	PRINTFORML 「転校生さんのおかげで最高の結果が出てしまいました。……ふふ、少し自慢できますね」
ELSEIF ARG:0 == 2
	PRINTFORML 「2位でも十分です。転校生さんと一緒に頑張れましたから」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位に入れてよかったです。知識は使えば使うほど磨かれると実感しました」
ELSE
	PRINTFORML 「今回はうまくいきませんでしたね……。次こそ、もっとしっかり準備します」
ENDIF
RETURN

;------------------------------------------------------------
; 学力コンテスト（ARG:0: 0=参加 1=3位 2=準優勝 3=優勝）
;------------------------------------------------------------
@CHAR_ACADEMIC_CONTEST_1, ARG
IF ARG:0 == 3
	PRINTFORML 「……正直、驚いています。クラリネットに夢中になりすぎて、学力まで伸ばす余裕があったとは」
ELSEIF ARG:0 == 2
	PRINTFORML 「悔しいです。あと少し、あと少しだったのに……転校生さん、次は一緒に優勝しましょう」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位……努力は裏切らないものですね。毎日コツコツ勉強してよかったです」
ELSE
	PRINTFORML 「今回は力が及びませんでした。……やはり地道な勉強は大事ですね。もっと頑張ります」
ENDIF
RETURN

;------------------------------------------------------------
; 試験前（STAGE_学期進行経由・試験実施ターンに呼ばれる）
; TFLAG:83: 0=中間試験  1=期末試験
;------------------------------------------------------------
@CHAR_EXAM_BEFORE_1
IF TFLAG:83 == 0
	PRINTFORML 「中間試験――ふむ、ノートはきちんと整理してありますから、転校生さんもよかったらお見せしますよ。一緒に頑張りましょうね」
ELSE
	PRINTFORML 「期末試験ですね。範囲は中間より広いですが、私はもう準備万端です。ふふ、転校生さんも、慌てないでくださいね」
ENDIF
RETURN

;------------------------------------------------------------
; 試験結果（STAGE_学期進行経由・合否判定後に呼ばれる）
; ARG:0: 0=不合格  1=合格  2=好成績（合格ライン+30点以上）
;------------------------------------------------------------
@CHAR_EXAM_RESULT_1, ARG
IF ARG:0 == 2
	PRINTFORML 「ふふ……合格ライン＋30点以上、です。毎日コツコツ準備した甲斐がありました♪　転校生さんも、ご一緒に喜んでくれますか？」
ELSEIF ARG:0 == 1
	PRINTFORML 「合格しました。ふふ、ほっとしましたね。次はもう少し上を目指せそうです」
ELSE
	PRINTFORML 「……不合格、ですか。ふぅ、本番に弱い私らしい結果ですね。く、悔しい……次こそは、しっかり――っ！」
ENDIF
RETURN

;------------------------------------------------------------
; 【エンゲージリングプロポーズ口上】
; ★山場: 転校生がプロポーズする場面、長めの口上にすること
;------------------------------------------------------------
@CHAR_ENGAGE_RING_1
PRINTFORML 「お、おや……？
PRINTL
PRINTFORML そ、その箱の中身は――ふっ、ふふ……。\n\n（ま、待ってください、心の準備が……いえ、本番に弱い私のままでは、駄目ですよね。逃げずに、ちゃんと、お返事しなければ）\n\n転校生さん、本気で、こんな私を……？
PRINTL
PRINTFORML 本番に弱くて、怖いことや嫌なことから逃げ出してばかりだった、こんな私を……ふっ、ぐすっ……ご、ごめんなさい、泣いたりして――っ。\n\nあのとき、マーチングバンドの本番が怖くなって逃げ出した、行き場のなくなっていた私を、転校生さんが見つけてくださった。あの日からずっと、わたしの居場所は、あなたの隣でした。\n\nわたしが差し上げられるものは、これからの一生ぶんの『私』しかありません。それでも、よければ……どうか、わたしと――その指輪を、いただけますか♪\n\n（ぴこちゃんに自慢します。ううん、今度は、私のほうが世話を焼いてもらう番かもしれませんね……ふふっ）」
RETURN

;------------------------------------------------------------
; 【結婚エンディング口上】
; ★エンディング: 十分なボリュームの口上にすること
;------------------------------------------------------------
@ENDING_MARRIAGE_1
PRINTFORML 「（――本番に弱くて、いつだって直前で逃げ出してきた私が……今日この場には、ちゃんと逃げずに、立っていられました）
PRINTL
PRINTFORML ……はい、転校生さん。誓います。
PRINTL
PRINTFORML これからの人生、何が起こっても、もう一度逃げそうになっても――あなたの隣には、必ず帰ってきます。それだけは、ちゃんと、約束しますね♪
PRINTL
PRINTFORML （ぴこちゃん、見てますか？
PRINTL
PRINTFORML あなたの『みよちゃん』は、ちゃんと、いちばん大切な人を見つけられました。妹にも、いつか紹介します――あの子は私が好きな人を嫌う厄介な性質ですけど、あなたのことだけは、きっと例外にしてくれるはずですから）\n\n夏野部長、八朔先輩、神樹先輩、皆さんに見守られて……ふふっ、こんなに幸せでいいんでしょうか。\n\n転校生さん――いいえ、もう『さん』は、外しましょうね。\n\nあなたと、これからずっと、一緒に♪」
RETURN

;------------------------------------------------------------
; 【卒業エンディング口上】
; ★エンディング: 十分なボリュームの口上にすること
