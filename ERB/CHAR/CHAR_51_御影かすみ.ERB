	A = RAND:3
	IF TALENT:TARGET:153
		IF A == 0
			;恋人・大量・1
			PRINTFORMW 「あら、あら……♪　こんなに溢れちゃって……。くふふ、わたしの体が、あなたのために『ごちそう』を作ってるみたい～……♪」
		ELSEIF A == 1
