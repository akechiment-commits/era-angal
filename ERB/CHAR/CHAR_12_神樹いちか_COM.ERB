;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「先輩と一緒に勉強……？　うぅ、あたし勉強はにがてなんですけど……。で、でも、先輩が見ててくれるなら、ちょっとだけがんばってみよっかな。教えてくださいね？」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「えへへ、先輩とお勉強♪　……って、ぜんぜん集中できないよぉ。だって、隣に先輩がいると、そっちばっかり見ちゃうんだもん」
