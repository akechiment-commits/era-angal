;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_48
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……っ、もう指一本動かせないよ……。でも、君の腕の中だと幸せだなぁ。このまま、ちょっとだけこうしてて……♪」
			CASE 1
				PRINTFORML 「あは……今日のわたし、すっかり崩されちゃったね。……ふふ、君の前でだけは、強がらなくていいんだ。あぁ、安心する……♪」
			CASE 2
				PRINTFORML 「くたくただよ～……。でも、嫌な疲れじゃない。君に愛されて、へとへとになるなんて……。ぜいたくな疲れだね、えへへ♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「……ふぅ、さすがにくたびれたよ。あんまり無茶させないでおくれよ？　まったく、人使いが荒いんだから……ふふ♪」
			CASE 1
				PRINTFORML 「はぁ、はぁ……。やれやれ、これは明日に響きそうだね。でも……まぁ、悪くなかったよ。内緒だけどね？」
			CASE 2
				PRINTFORML 「もう、こんなにヘトヘトにして……。お仕置きだよ？　なんてね。ふふ、ちょっとだけ休ませてね、転校生くん。」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……気持ちよかったね。君とこうしてると、時間を忘れちゃうよ。……ねぇ、もうちょっとだけ、くっついててもいい？♪」
			CASE 1
				PRINTFORML 「えへへ、満ち足りた気分だよ。君に抱かれてると、「わたし」でいられる。それがいちばんの幸せなんだ♪」
			CASE 2
				PRINTFORML 「あぁ、幸せだなぁ……。こんな顔、ファンの子たちには見せられないね。君だけの秘密だよ、転校生くん♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ、いい汗かいたよ。ふふ、運動のあとみたいに爽快だね？　……って、こういうの不謹慎かな？　あはは♪」
			CASE 1
				PRINTFORML 「やれやれ、すっかり乱されちゃったね。髪も衣装もぐちゃぐちゃだ。……ま、たまにはこういうのもいいか♪」
			CASE 2
				PRINTFORML 「……ふふ、満足してくれたかい？　君が喜んでくれるなら、僕も嬉しいよ。また、付きあってあげる♪」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日はこのへんでお開きかな。……名残惜しいけど、君と過ごせて楽しかったよ。また明日、ね♪」
		CASE 1
			PRINTFORML 「ふふ、いい一日だった。君と一緒だと、なんでもない時間がきらきら輝くんだよね……♪」
		CASE 2
			PRINTFORML 「そろそろお別れの時間だね。……えへへ、もうちょっと一緒にいたいなんて、わがままかな？」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「それじゃ、今日はこのへんで。付きあってくれてありがとう、転校生くん。また会おうね♪」
		CASE 1
			PRINTFORML 「やれやれ、今日も一日があっという間だったね。青春は短いんだから、一分一秒大事にしないと♪」
		CASE 2
			PRINTFORML 「ばいば～い、転校生くん。気をつけて帰るんだよ？　夜道は物騒だからね、ふふ☆」
		ENDSELECT
	ENDIF
ENDIF
