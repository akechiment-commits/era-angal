IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「やぁ、転校生くん。会いにきてくれたんだ？　えへへ、ちょっと嬉しいかも……♪」
	ELSEIF A == 1
		PRINTFORML 「お帰り。ふふ、君の顔を見るとほっとするよ。今日も一日、おつかれさま♪」
	ELSE
		PRINTFORML 「あっ、転校生くん。ちょうど君のこと考えてたんだ～。なんてね、ちょっと甘えすぎかな？　ふふ♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「やぁ、転校生くん。やっほ～♪　今日も元気そうで何よりだよ。」
	ELSEIF A == 1
		PRINTFORML 「おや、転校生くん。生徒会に何か用かい？　まぁ、君ならいつでも歓迎するよ♪」
	ELSE
		PRINTFORML 「ふふ、また会ったね。君は神出鬼没だなぁ、まるで風みたいだよ？」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_48
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよう、転校生くん。んん……君と迎える朝は、なんだか特別だね♪」
	CASE 1
		PRINTFORML 「おはよ～♪　ふふ、寝癖ついてるよ？　ほら、直してあげる……えへへ、世話が焼けるなぁ。」
	CASE 2
		PRINTFORML 「おはよう。今日も君と一緒だと思うと、それだけで頑張れちゃうよ。現金だよね、僕って♪」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよう、転校生くん。朝はやっぱりダッシュかい？　ふふ、一緒に走ろうか♪」
	CASE 1
		PRINTFORML 「やぁ、おはよう。早起きは三文の得っていうけど～、君は得した気分かい？」
	CASE 2
		PRINTFORML 「おはよう♪　清々しい朝だね。さぁ、今日も一日張りきっていこうか、転校生くん☆」
	ENDSELECT
ENDIF
RETURN

