;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「お勉強だしか……。あたし、机に向かうのは苦手なんですし～。先輩、わからないとこ教えてほしいし、にししっ♪」
	ELSE
		A = RAND:3
		;--- 失敗 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORMW 「うぐ、ごめんししょ～……今日はあたま、ぜんぜん回らないし～……。また今度、教えてほしいしっ……」
			ELSE
				;失敗
				PRINTFORMW 「うー、ごめんなさいですし……今日は勉強って気分じゃないし……。また今度でもいいし……？」
			ENDIF
		;--- 成功 ---
		ELSE
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「ししょ～と一緒なら、勉強もちょっとは楽しいし♪　でも、すぐ眠くなっちゃうし……膝枕してくれたら頑張れるし？」
			ELSEIF A == 1
				PRINTFORMW 「うぐぐ、この問題むずかしいし……。ししょ～、ヒントちょうだいし～。にし、ご褒美はあとでいっぱい甘えさせてほしいし♪」
			ELSE
				PRINTFORMW 「ん～、集中力が水の中まで泳いでっちゃったし……。ね、ししょ～、ちょっと休憩して、ぎゅってしてほしいし♪」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「先輩、ここの公式わかんないし～。教え方が上手だから、先輩となら覚えられそうだしっ♪」
			ELSEIF A == 1
				PRINTFORMW 「ふぁ……ねむ。あたし、前日に泳ぎすぎると小テストで爆睡しちゃうんですし～。今日は先輩がいるから起きてられるし！」
			ELSE
				PRINTFORMW 「にしし、先輩は物知りだし～。あたしの脳みそは筋肉でできてるから、うらやましいしっ！」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「先輩、お勉強なんかどうでもいいから泳ぎません？」
			ELSEIF A == 1
				PRINTFORMW 「うへぇ、また補習コース確定だし……。授業中に寝ちゃうのが悪いってわかってるんですけど～っ！」
			ELSE
				PRINTFORMW 「ん～、字を見てると目がしょぼしょぼするし。あたし、体動かすほうが百倍得意だしっ！」
			ENDIF
		ENDIF
		ENDIF
	ENDIF
ENDIF

