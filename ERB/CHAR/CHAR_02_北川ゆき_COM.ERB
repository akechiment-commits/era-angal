;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「えっ、先輩も勉強ですか。……うん、隣、空いてるから。（ふたりで勉強するの、緊張するなぁ）」
	ELSE
		A = RAND:3
		;--- 失敗 ---
		IF TFLAG:18 == -1
			IF TALENT:TARGET:153
				;恋人・失敗
				PRINTFORMW 「ご、ごめんなさい先輩。今日は全然集中できなくて……。せっかく一緒なのに、わたし、だめだなぁ」
			ELSE
				;失敗
				PRINTFORMW 「あ……ごめんなさい。今日はやめておきます。なんだか、頭に入ってこなくて、また今度」
			ENDIF
		;--- 成功 ---
		ELSE
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「先輩の隣で勉強すると、はかどる気がする。（集中できないけど、嬉しいからいいもん）」
			ELSEIF A == 1
				PRINTFORMW 「あ、先輩。ここの解きかた、教えてくれますか。（近いな……どきどきする）♪」
			ELSE
				PRINTFORMW 「（先輩の横顔、真剣な顔してる。かっこいいなぁ）……何でもないです」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「先輩と勉強するの、慣れてきたかも。（前はまともに喋れなかったのに）」
			ELSEIF A == 1
				PRINTFORMW 「ここの問題、一緒に考えませんか。ひとりだと、つい脱線して……」
			ELSE
				PRINTFORMW 「（勉強よりゲームしたいけど、先輩といる時間のほうが大事かも）」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「勉強はひとりでもできるけど、一緒のほうが、その……さぼらないから」
			ELSEIF A == 1
				PRINTFORMW 「……先輩、勉強熱心だなぁ。わたしも見習わないと」
			ELSE
				PRINTFORMW 「静かにしてくれるなら、隣で勉強してもいいですよ」
