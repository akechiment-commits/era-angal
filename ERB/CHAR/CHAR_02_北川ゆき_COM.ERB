;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「えっ――先輩も、勉強ですか。……うん、隣――空いてるから。（ふたりで勉強とか、緊張するなぁ……）」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「先輩の隣で勉強すると、はかどる――気がする。（集中できないけど、嬉しいからいいもん）」
			ELSEIF A == 1
				PRINTFORMW 「あ、先輩――ここの解きかた、教えてくれますか。（近い……ドキドキする……♪）」
			ELSE
				PRINTFORMW 「（先輩の横顔――真剣な顔してる。かっこいいなぁ）……何でもないです」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「先輩と勉強――慣れてきたかも。（前はまともに喋れなかったのに）」
			ELSEIF A == 1
				PRINTFORMW 「ここの問題――一緒に考えませんか。ひとりだと、つい脱線して……」
			ELSE
				PRINTFORMW 「（勉強よりゲームしたいけど――先輩といる時間のほうが大事、かも）」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「勉強――ひとりでもできるけど。一緒のほうが、その――さぼらないから」
			ELSEIF A == 1
				PRINTFORMW 「……。（先輩、勉強熱心だなぁ。わたしも見習わないと）」
			ELSE
				PRINTFORMW 「静かにしてくれるなら――隣で勉強しても、いいですよ」
			ENDIF
		ENDIF
	ENDIF
ENDIF

