;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「勉強を見てやろうというのか？　ふっ、いいだろう。この堕天使の叡智、貴様に分けてやる。……正直に言うと、ボクも一緒だと捗るんだ。あはは」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「ほら弟くん、ここはこう解くのだ。……ククク、ボクを頼るとは賢明だな♪」
			ELSEIF A == 1
				PRINTFORMW 「ん、隣にいると集中できない……否！　な、なんでもない。続きをやるぞ」
			ELSE
				PRINTFORMW 「勉強会という名の逢瀬だな、これは。……ふふ、たまにはこういうのも悪くない♪」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「わからん所があれば聞くがいい。お姉ちゃんが教えてやろう……☆」
			ELSEIF A == 1
				PRINTFORMW 「ふむ、貴様も存外やるな。感心したぞ、弟くん」
			ELSE
				PRINTFORMW 「ボクの集中が切れたら、肩を貸せ。……五分だけだ、五分」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「勉強か。まあ、付き合ってやる。堕天使とて学業は疎かにせんからな」
			ELSEIF A == 1
				PRINTFORMW 「ここのテスト範囲は……むっ、案外手強いな。だが負けんぞ」
			ELSE
				PRINTFORMW 「ふん、静かにやれよ。ボクの叡智の妨げになる」
			ENDIF
		ENDIF
	ENDIF
ENDIF

