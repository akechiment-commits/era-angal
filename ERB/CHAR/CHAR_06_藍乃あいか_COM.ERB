IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「えっ、わたしと勉強……? あ、あの、いいですよ。わたしも、ちょうどわからないところがあったので……えへへ」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「ふふ、%CALLNAME:PLAYER%先輩と一緒だと、はかどりますね♪ ちゃんと褒めてくれるから、頑張れちゃう」
			ELSEIF A == 1
				PRINTFORMW 「（%CALLNAME:PLAYER%先輩の横顔、真剣……）……あ、ご、ごめんなさい。見惚れてました」
			ELSE
				PRINTFORMW 「えへへ、ここのところ。先輩、わかります? わたしも、さっきまでわかってなかったんですよ」
			ENDIF
		;--- 親密（ABL6以上） ---
		ELSEIF ABL:TARGET:0 >= 6
			IF A == 0
				PRINTFORMW 「転校生さん、ここの問題ってどう解くんですか? あう、わたしだけわかってないみたい……」
			ELSEIF A == 1
				PRINTFORMW 「えへへ、転校生さんと勉強してると不思議とはかどります。お礼に、お茶でもいかがですか?」
			ELSE
				PRINTFORMW 「うう、わたし要領が悪くて、すみません。何度も同じところでつまずいちゃって……」
			ENDIF
		;--- 通常 ---
		ELSE
			IF A == 0
				PRINTFORMW 「転校生の先輩、ここを教えてもらえますか? あの、ご迷惑じゃないなら、ですけど……」
			ELSEIF A == 1
				PRINTFORMW 「ふぁ……ねむい。ご、ごめんなさい、転校生の先輩。ちゃんとやります」
			ELSE
				PRINTFORMW 「（また転校生の先輩のお世話に……）あ、ありがとうございます、教えてくれて」
			ENDIF
		ENDIF
	ENDIF
ENDIF

