;==============================================================
; キャラ別コマンド反応テンプレート  @KOJO_MESSAGE_COM_29
;
; 【分岐構造】
;   3tier+SF: 初回 / 失敗(恋人/通常) / 成功(恋人×3, 親密×3, 通常×3)
;   3tier:    初回 / 恋人×3 / 親密×3 / 通常×3
;   2tier+SF: 初回 / 失敗(恋人/通常) / 成功(恋人×3, 通常×3)
;   2tier:    初回 / 恋人×3 / 通常×3
;   ecchi2t:  恋人×3 / 通常×3
;   other:    恋人1行 / 通常1行
;
; 【成功/失敗: TFLAG:18】  -1=失敗  0=通常  1=大成功
; 【関係: TALENT:TARGET:153=恋人  ABL:TARGET:0>=6=親密】
;
; 【CFLAG:TARGET初回フラグ】
;   210=勉強 211=会話 212=プレゼント 213=スキンシップ 214=まったり
;   215=掃除 216=髪梳き 217=デート系 218=初詣 219=炬燵 220=散歩
;   221=学食 222=遊び・ライブ 223=素材 224=調合 225=縁側 229=キス
;   230-248: ウフフ系各コマンド
;==============================================================
@KOJO_MESSAGE_COM_29
;============================================================
; ↓↓↓ デバッグ: この関数が呼ばれるたびに表示 ↓↓↓
;============================================================
PRINTFORML [DBG:KOJO_COM_29 呼び出し SELECTCOM={SELECTCOM} TFLAG18={TFLAG:18} TALENT153={TALENT:TARGET:153}]
SIF TEQUIP:45 && SELECTCOM != 45
	RETURN 0

