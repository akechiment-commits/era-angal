;============================================================
; 日滝ましろ　NO:67　?年3-C　チアリーディング部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_67
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_67
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_67
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「」
	ELSEIF A == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「」
	ELSEIF A == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ENDIF
RETURN

