;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 小野ちよ　NO:3　?年1-A　料理研究部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_3
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「あっ、はじめまして！　わたしは一年A組の小野ちよです。料理研究部なんですよ～。えっと……あなた、噂の転校生さんですか？」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「いらっしゃ～い♪　ここ料理研究部の部室なんです。あっ、お菓子の匂いにつられてきました？　ふふ、わたし小野ちよっていいます」
	ELSE
		PRINTFORML 「あれ、委員会のひとですか……？　って、見ない顔ですね。わたし料理研究部の小野ちよです。何かご用でしたか？」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_3
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_3
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、お兄ちゃん先輩♪　こんなところで会えるなんて、えへへ、うれしいなぁ」
	ELSEIF A == 1
		PRINTFORML 「ふんふふんふふ～ん♪……あ、お兄ちゃん先輩！　ちょうどよかった、新作のクッキー味見してほしくて」
	ELSE
		PRINTFORML 「お兄ちゃん先輩、お疲れさまです♪　あとでお菓子つくるので待っててくださいね？」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、お兄ちゃん先輩！　お菓子、食べていきます？　ちょうど焼けたところなんですよ～」
	ELSEIF A == 1
		PRINTFORML 「えっと、何かご用ですか？　……あっ、もしかしてお腹すいてます？　ふふ、わかりやすいなぁ」
	ELSE
		PRINTFORML 「お兄ちゃん先輩、こんにちは～。今日もどこかへお手伝いの途中ですか？」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_3
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございます、お兄ちゃん先輩♪　今日もいちにち、がんばりましょうね？」
	CASE 1
		PRINTFORML 「えへへ、おはようございます。朝ごはん、ちゃんと食べてきました？　わたしはちょっと食べすぎちゃったかも」
	CASE 2
		PRINTFORML 「お兄ちゃん先輩、おはよう……♪　ふふ、朝からお顔が見られるってしあわせだなぁ」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようございます、お兄ちゃん先輩！　今日も元気いっぱいですよ～」
	CASE 1
		PRINTFORML 「あっ、おはようございます。えっと、朝ごはんのおすそわけ、いりますか？」
	CASE 2
		PRINTFORML 「ふぁ……おはようございます。ふふ、ちょっと寝坊しちゃって、あわてて来たんです」
	ENDSELECT
ENDIF
RETURN

