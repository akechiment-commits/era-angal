;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_3
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。お兄ちゃん先輩、もう……わたし、くたくたです……。えへへ……でも、しあわせ……♪」
			CASE 1
				PRINTFORML 「腰、ぬけちゃいました……。お兄ちゃん先輩に、いっぱいされて……うう、うごけない……♪」
			CASE 2
				PRINTFORML 「（あたま、とろとろ……）……ずっと、こうしてたい……。お兄ちゃん先輩、だいすき……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう、むりです……。立てないかも……うう、すごかった……っ」
			CASE 1
				PRINTFORML 「ふぇっ……体に、力が入らない……。こんなにくたくた、はじめてです……っ」
			CASE 2
				PRINTFORML 「お兄ちゃん先輩……ちょっとだけ、休ませてください……。はぁ……♪」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「えへへ……お兄ちゃん先輩と、いっぱいくっついちゃいました♪　また、しようね？」
			CASE 1
				PRINTFORML 「ふぅ……どきどきした……。でも、先輩となら、なんでも嬉しいんです♪」
			CASE 2
				PRINTFORML 「先輩のこと、もっとすきになっちゃった……。えへへ、こまっちゃうなぁ♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぇっ、は、恥ずかしいことしちゃいました……。でも、いやじゃ、なかったです♪」
			CASE 1
				PRINTFORML 「うう、わたし、へんな声出しちゃった……。お兄ちゃん先輩、忘れてくださいね？」
			CASE 2
				PRINTFORML 「ん～、体がぽかぽかします♪　えへへ、また……お願いします、ね？」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日はありがとうございました、お兄ちゃん先輩♪　また明日も会えますよね？」
		CASE 1
			PRINTFORML 「えへへ、楽しかったです。次はもっとおいしいお菓子つくっておきますね？」
		CASE 2
			PRINTFORML 「もう終わりですか……ちょっとさみしいなぁ。また誘ってくださいね、お兄ちゃん先輩」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「はい、今日はおしまいですね。お疲れさまでした、お兄ちゃん先輩！」
		CASE 1
			PRINTFORML 「あっ、もう行っちゃうんですか？　ふふ、お菓子の残り、持っていってください～」
		CASE 2
			PRINTFORML 「またのご利用、お待ちしてます♪　……なんて、ふふ、お店みたいですね」
		ENDSELECT
	ENDIF
