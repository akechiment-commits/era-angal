;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 北川ゆき　NO:2　?年1-A　パソコン部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_2
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「…………。あ、のう。そのう――。き、北川、ゆき、です。一年Ａ組の……。（この人が、転校生の先輩……？）よ、よろしく、お願いします――」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「ひっ……！？（だ、誰……？ 部室に来る人なんて、いないのに）あ、あの、ここ、パソコン部の部室、で……。わたし、北川――ゆき、です……」
	ELSE
		PRINTFORML 「…………。（知らない人……。どうしよう）あ、あの――転校生の、先輩、ですか……？ わたし、北川ゆき……です。えっと、その――用事がなければ……」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_2
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_2
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、先輩。えへへ、また会えた……♪（何回会っても、ドキドキするなぁ）」
	ELSEIF A == 1
		PRINTFORML 「先輩……！（わ、わわ、心の準備が……）あ、あの、今ちょうど先輩のこと――って、何でもないです！」
	ELSE
		PRINTFORML 「あ、先輩。（嬉しいな……）えっと、今日のＭＭＯのイベント――一緒に、やりませんか♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ……先輩。こ、こんにちは……。（うまく喋れるかな……うう）」
	ELSEIF A == 1
		PRINTFORML 「…………。（転校生の先輩だ）えっと――何か、用、ですか……？」
	ELSE
		PRINTFORML 「あ。先輩……。（また会えた。でも何話せばいいか、わかんない……）あの――元気、ですか？」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_2
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはよう、ございます――先輩。えへへ……♪（昨日、イベント走って寝落ちしたけど――先輩の顔見たら、元気でた）」
	CASE 1
		PRINTFORML 「先輩、おはよ……♪（今日も会えた。えへへ）なんか、先輩の顔見ると目が覚めるんですよね……」
	CASE 2
		PRINTFORML 「おはようございます、先輩……♪（今日はちゃんと起きられた。先輩に会えるって思ったら目が覚めたのかも）」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「お、おはようございます……。（眠い……昨日ＭＭＯのイベントが……。でも挨拶はちゃんとしないと……）」
	CASE 1
		PRINTFORML 「あ、おはようございます……。（眠い……夜中までゲームしてたの、失敗した）」
	CASE 2
		PRINTFORML 「お、おはようございます……。（先輩に会うの、ちょっとだけ緊張する）」
	ENDSELECT
ENDIF
RETURN

