;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_2
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。もう、動けない……。先輩――抱きしめたまま、はなさないで……♪」
			CASE 1
				PRINTFORML 「腰、ぬけちゃった……。えへへ……先輩のせい、ですよ――？」
			CASE 2
				PRINTFORML 「（あたまが、とろとろ……）……先輩、すき……。もう、なんにも考えられない……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう無理――……。立てない……です……」
			CASE 1
				PRINTFORML 「う、うう……。体が、ふにゃふにゃ……。先輩、すこし……休ませて……？」
			CASE 2
				PRINTFORML 「……っ、はぁ……。こんなに、くたくた――。は、初めて、です……」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……えへへ。先輩と、こんなことしちゃった……。（しあわせ……♪）」
			CASE 1
				PRINTFORML 「……まだ、どきどきしてる。先輩――もう一回、ぎゅってして？」
			CASE 2
				PRINTFORML 「わたし、先輩のものに……なっちゃいましたね。えへへ……嬉しい――♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぇ……は、恥ずかしい……。先輩、いまの……忘れて、ください……（無理だけど）」
			CASE 1
				PRINTFORML 「う、うう……。わたし、こんな声――出しちゃうんだ……。知らなかった……」
			CASE 2
				PRINTFORML 「はぁ……。先輩の手、すごい……。わたし、変になっちゃう――……」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「もう終わり、ですか……。（もうちょっと一緒にいたかったのに）……先輩。また明日も、一緒にいてくれますか……？」
		CASE 1
			PRINTFORML 「終わっちゃった……。（先輩と一緒だと、時間が経つのが速い）えへへ、また来てくださいね……♪」
		CASE 2
			PRINTFORML 「ん……終わり、ですか。（寂しいな）……先輩、行かないでくれると嬉しいんですけど。だめですか……？」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「あ、終わりなんですね。……えっと、ありがとうございました。（先輩との時間――あっという間だなぁ）」
		CASE 1
			PRINTFORML 「終わり、ですか。……はい。（ちょっと、もったいなかったかも）」
		CASE 2
			PRINTFORML 「……お疲れさまでした、先輩。（また、来てくれるかな）」
		ENDSELECT
	ENDIF
ENDIF
RETURN


