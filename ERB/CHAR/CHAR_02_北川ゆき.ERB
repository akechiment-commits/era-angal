;============================================================
; 北川ゆき　NO:2　?年1-A　パソコン部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_2
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「…………。あ、のう。そのう――。き、北川、ゆき、です。一年Ａ組の……。（この人が、転校生の先輩……？）よ、よろしく、お願いします――」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「ひっ……！？（だ、誰……？ 部室に来る人なんて、いないのに）あ、あの、ここ、パソコン部の部室、で……。わたし、北川――ゆき、です……」
	ELSE
		PRINTFORML 「…………。（知らない人……。どうしよう）あ、あの――転校生の、先輩、ですか……？ わたし、北川ゆき……です。えっと、その――用事がなければ……」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_2
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_2
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あっ、先輩。えへへ、また会えた……♪（何回会っても、ドキドキするなぁ）」
	ELSEIF A == 1
		PRINTFORML 「先輩……！（わ、わわ、心の準備が……）あ、あの、今ちょうど先輩のこと――って、何でもないです！」
	ELSE
		PRINTFORML 「あ、先輩。（嬉しいな……）えっと、今日のＭＭＯのイベント――一緒に、やりませんか♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ……先輩。こ、こんにちは……。（うまく喋れるかな……うう）」
	ELSEIF A == 1
		PRINTFORML 「…………。（転校生の先輩だ）えっと――何か、用、ですか……？」
	ELSE
		PRINTFORML 「あ。先輩……。（また会えた。でも何話せばいいか、わかんない……）あの――元気、ですか？」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_2
IF TALENT:TARGET:153
	PRINTFORML 「おはよう、ございます――先輩。えへへ……♪（昨日、イベント走って寝落ちしたけど――先輩の顔見たら、元気でた）」
ELSE
	PRINTFORML 「お、おはようございます……。（眠い……昨日ＭＭＯのイベントが……。でも挨拶はちゃんとしないと……）」
ENDIF
RETURN

;------------------------------------------------------------
; 休憩（SHOPで休憩を選んだとき）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REST_2
IF TALENT:TARGET:153
	PRINTFORML 「休憩……。先輩の隣で、ぼーっとしてていい？（先輩がいるだけで、なんか回復する……♪）」
ELSE
	PRINTFORML 「休憩、ですか。……うん。（ここなら静かだし、落ちつく……）」
ENDIF
RETURN

;------------------------------------------------------------
; 昼食（LUNCH_EAT_昼食・食事 経由・昼に呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_LUNCH_2
IF TALENT:TARGET:153
	PRINTFORML 「先輩――一緒にお昼、食べませんか。あの、お弁当――ねえさんに教えてもらってつくったの。先輩にもすこし、あげます……♪」
ELSE
	PRINTFORML 「あ……お昼。えっと、わたしいつも部室でひとりで食べてるんですけど――一緒に、いいんですか？ ……うん、行きます」
ENDIF
RETURN

;------------------------------------------------------------
; パートナー選択時（SHOPメニューで選択した直後）
; TFLAG:88: 0=イチャイチャ  2=休憩  3=スキル習得
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_PARTNER_DIALOG_2
IF TALENT:TARGET:153
	PRINTFORML 「わたしを選んでくれたんだ……。えへへ、嬉しい♪ 先輩と一緒なら、どんなステージも攻略できそう……」
ELSE
	PRINTFORML 「え、わたし……？ いいん、ですか？ ……う、うん。がんばります……」
ENDIF
RETURN

;------------------------------------------------------------
; 初パートナー選択時（初めてこのキャラをパートナーに選んだ瞬間・1回のみ）
; CFLAG:TARGET:201=0→初回のみ発動。LOCATION_EVENT経由で呼ばれる
;------------------------------------------------------------
@CHAR_FIRST_PARTNER_2
IF CFLAG:TARGET:201 == 0
	CFLAG:TARGET:201 = 1
	IF TALENT:TARGET:153
		PRINTFORML 「え――わたしが、先輩のパートナー……？（夢じゃ、ないよね……？）は、はいっ。がんばりますっ……！」
	ELSE
		PRINTFORML 「わたしを、パートナーに……？ あの、わたしコミュ障だし――役に立てるかわかんないですけど……がんばります」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; セッション終了時（休憩・スキル習得のターン終了直前）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ※イチャイチャ（BEGIN TRAIN）終了後は調教システム内で別途対応
;------------------------------------------------------------
@CHAR_SESSION_END_2
IF TALENT:TARGET:153
	PRINTFORML 「もう終わり、ですか……。（もうちょっと一緒にいたかったのに）……先輩。また明日も、一緒にいてくれますか……？」
ELSE
	PRINTFORML 「あ、終わりなんですね。……えっと、ありがとうございました。（先輩との時間――あっという間だなぁ）」
ENDIF
RETURN
;------------------------------------------------------------
; 体育祭（SCHOOL_EVENT経由・秋開催）
; ARG:0: 0=参加  1=3位  2=準優勝  3=優勝
;------------------------------------------------------------
@CHAR_SPORTS_FESTIVAL_2, ARG
IF ARG:0 == 3
	PRINTFORML 「ゆ、優勝……!? うそ、わたしが……？（リアルでレベルアップした感じがする……!?）先輩のおかげ、です……！」
ELSEIF ARG:0 == 2
	PRINTFORML 「準優勝……すごい、わたしにしては上出来……。前のわたしだったら、参加すらしてなかったのに」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位……。（運動苦手なわたしが3位って……けっこう経験値入ったかも）」
ELSE
	PRINTFORML 「うう……やっぱり体育は苦手……。（インドア勢にはきつすぎる……）先輩、お疲れさまでした……」
ENDIF
RETURN

;------------------------------------------------------------
; 文化祭（SCHOOL_EVENT経由・秋開催）
; ARG:0: 0=普通  1=まあまあ  2=成功  3=大成功
;------------------------------------------------------------
@CHAR_CULTURE_FESTIVAL_2, ARG
IF ARG:0 == 3
	PRINTFORML 「大成功……！ わたしがつくったゲームの展示、みんなに遊んでもらえた……。えへへ、先輩が宣伝してくれたおかげだよ♪」
ELSEIF ARG:0 == 2
	PRINTFORML 「成功ですね……。パソコン部の展示、ちゃんと見てもらえてよかった。（先輩も遊んでくれたし……♪）」
ELSEIF ARG:0 == 1
	PRINTFORML 「まあまあ、かぁ……。もうちょっとバグ取りしておけばよかったかな……（次はクオリティ上げないと）」
ELSE
	PRINTFORML 「うーん……あんまりお客さん来なかった……。（やっぱりパソコン部は地味かなぁ）でも先輩が見てくれたから、いいもん」
ENDIF
RETURN

;------------------------------------------------------------
; クイズ選手権（ARG:0: 0=参加 1=3位 2=準優勝 3=優勝）
;------------------------------------------------------------
@CHAR_KNOWLEDGE_CONTEST_2, ARG
IF ARG:0 == 3
	PRINTFORML 「優勝……！（ネットで仕入れた雑学が役に立つ日がくるなんて……。ネットサーフィンも無駄じゃなかった）」
ELSEIF ARG:0 == 2
	PRINTFORML 「2位……惜しかった。あの問題、ゲームの知識だったら答えられたのに……」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位……。まぁ悪くない、かな。（知識の偏りがバレた気がするけど……）」
ELSE
	PRINTFORML 「ダメだった……。（ゲームとパソコン以外の知識が足りなかった……レベリング不足）」
ENDIF
RETURN

;------------------------------------------------------------
; 学力コンテスト（ARG:0: 0=参加 1=3位 2=準優勝 3=優勝）
;------------------------------------------------------------
@CHAR_ACADEMIC_CONTEST_2, ARG
IF ARG:0 == 3
	PRINTFORML 「ゆ、優勝？ うそでしょ……。（プログラミングの論理思考が効いた……のかな？）先輩が勉強見てくれたおかげです……」
ELSEIF ARG:0 == 2
	PRINTFORML 「2位……。もうすこしだった。悔しいけど――次があるなら、もっとがんばります」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位かぁ……。（徹夜でゲームしなければもうちょっと上がれたかも……反省）」
ELSE
	PRINTFORML 「ダメでした……。うう、勉強は苦手じゃないはずなのに――（ゲームの時間を削れば……いけた、かも）」
ENDIF
RETURN

;------------------------------------------------------------
; 試験前（STAGE_学期進行経由・試験実施ターンに呼ばれる）
; TFLAG:83: 0=中間試験  1=期末試験
;------------------------------------------------------------
@CHAR_EXAM_BEFORE_2
IF TFLAG:83 == 0
	PRINTFORML 「中間試験……。（ＭＭＯのイベントと被ってるのが辛い――でも赤点は、ねえさんに怒られる）……がんばる」
ELSE
	PRINTFORML 「期末……範囲広いですよね。先輩――一緒に勉強してくれますか？ ひとりだとつい、ゲーム開いちゃうから……」
ENDIF
RETURN

;------------------------------------------------------------
; 試験結果（STAGE_学期進行経由・合否判定後に呼ばれる）
; ARG:0: 0=不合格  1=合格  2=好成績（合格ライン+30点以上）
;------------------------------------------------------------
@CHAR_EXAM_RESULT_2, ARG
IF ARG:0 == 2
	PRINTFORML 「好成績……！ やった……♪（論理的に考えたのがよかったのかも――プログラミングみたいに）先輩、ありがとうございます。一緒に勉強してくれたおかげ……」
ELSEIF ARG:0 == 1
	PRINTFORML 「合格しました……。ほっとした。（これでイベント周回に――じゃなくて）先輩の、おかげです」
ELSE
	PRINTFORML 「不合格……。うう……（ゲームのしすぎです、自分でもわかってるんだけど……）先輩――補習、付きあってくれますか……」
ENDIF
RETURN

;------------------------------------------------------------
; 結婚エンディング
;------------------------------------------------------------
@ENDING_MARRIAGE_2
PRINTFORML 「…………。\n\n（ウェディングドレス、着てるんだ、わたし。画面の中じゃなくて――リアルで）\n\n先輩。\n覚えてますか。わたしたちが初めて会ったとき。\nわたし、まともに喋れなくて――目も合わせられなくて。ずっと、下を向いてた。\n\n旧校舎の壁に――『寂しいから誰か相手してよ』って落書きしてたの。先輩は知ってるよね。\nあのときのわたしは、本当にひとりで。画面の中にしか居場所がなかった。\n\nでも――ねえさんと先輩が、そんなわたしを見つけてくれた。\n目を留めて、心配して、関わってくれた。\n\n先輩が『大丈夫だよ』って言ってくれたら、見ててくれたら――がんばれる気がしたの。\n\n……前のわたしだったら、こんな場所に立つなんて絶対に無理だった。\n人前に出るのも、誰かの隣に立つのも――怖くて、逃げてた。\n\nでも今は――逃げたくない。先輩のそばにいたい。ずっと。\n\nわたしのコミュ障は治ってないし、相変わらずゲーム廃人だし、人見知りも全然直ってない。\nでも――先輩がパーティーにいてくれるなら、どんなクエストもクリアできるもん。\n\nだから――わたしの人生の、攻略パートナーになってください。\n\n好きです、先輩。わたしの――いちばん大切なひと。\n\nこれからは先輩じゃなくて――えっと、あの、その――\n……名前で呼ぶのは、もうちょっと練習させてください。\n\nでも、気持ちは本物だもん。ずっと、ずっと。\n\n……えへへ。なんか――レベル、すごく上がった気がする♪」
RETURN

;------------------------------------------------------------
; 卒業エンディング
;------------------------------------------------------------
@ENDING_GRADUATE_2
PRINTFORML 「卒業――するんですね、先輩。\n\n…………。\n（何を言えばいいんだろう。こういうとき――うまい言葉が出てこないのは、相変わらずで）\n\nわたし、ずっと画面の中で生きてた。\nリアルの世界は怖くて――人と話すのが苦手で。教室にいるだけで、体力が削れていくみたいな毎日だった。\n\n旧校舎の壁に落書きしてた頃のわたしは――本当に、ひとりぼっちだった。\n\nでも、先輩が来てくれた。ねえさんが引っ張ってくれた。\nすこしずつ――外の世界が、怖くなくなった。\n\n先輩がいなくなったら――わたし、また引きこもっちゃうんじゃないかって。正直、怖い。\n\nでも――ううん、大丈夫。任せて。がんばるから。\n\n先輩が教えてくれたこと、全部覚えてる。\nひとりじゃないってこと。画面の外にも――大切なひとがいるってこと。\n\n自主製作ゲーム――完成したら先輩に真っ先にプレイしてもらうから。\nだから卒業しても――連絡先、消さないでくださいね。\n\n先輩。ありがとうございました。\n\n……泣いてない。泣いて、ないです――。\n（……うそ。めちゃくちゃ泣いてる。画面がぼやけて見えないくらい）\n\n……大好き、でした。ずっと――ずっと、ずっと」
RETURN

;---------------------------------------------------------
; @KOJO_JUN_K2 : ターンイベント別口上
; TFLAG:600の値で場面を判別
;---------------------------------------------------------
@KOJO_JUN_K2

;--- 28: 初対面 ---
IF TFLAG:600 == 28
	IF CFLAG:450 == 0
		PRINTFORMW 「…………。（知らないひと……どうしよう）あ、あのう――は、はじめまして。北川、ゆき、です……」
		CFLAG:450 = 1
	ENDIF
ENDIF

;--- 1: 初キス ---
IF TFLAG:600 == 1
	PRINTFORMW 「んっ……!?（ファーストキス――リアルの。ゲームじゃなくて――）……えへへ……嬉しい、です♪」
ENDIF

;--- 2: 告白成功 ---
IF TFLAG:600 == 2
	PRINTFORMW 「え――先輩が、わたしのこと……？ うそ、じゃないですよね……？（心臓がバグってる――）わたしも――先輩のこと、ずっと――好き、でした……！」
ENDIF

;--- 3: 告白（もう少し待って） ---
IF TFLAG:600 == 3
	PRINTFORMW 「あ、あの――気持ちはすごく嬉しいんです。でも、わたし――まだちゃんと自分の気持ちに向き合えてなくて。もうすこしだけ――時間を、ください。ごめんなさい……」
ENDIF

;--- 22: パートナー交代（旧パートナーの別れ際）---
IF TFLAG:600 == 22
	IF TALENT:TARGET:153
		PRINTFORMW 「え――わたし、交代……？ ……うん。わかりました。（寂しい――でも、先輩が決めたことだから）また――呼んでくれますか……？」
	ELSE
		PRINTFORMW 「あ、交代ですか。……うん、わかりました。（ちょっと寂しいかも――いや、大丈夫）」
	ENDIF
ENDIF

;--- 60: パートナー交代（新パートナーの挨拶）---
IF TFLAG:600 == 60
	IF TALENT:TARGET:153
		PRINTFORMW 「先輩……！ わたしをまた選んでくれたんだ――えへへ、嬉しい♪（パーティー復帰、みたいな）がんばりますっ」
	ELSE
		PRINTFORMW 「え――わたし？ パートナーに。……う、うん。がんばります――先輩の力になれるように」
	ENDIF
ENDIF

RETURN 0
