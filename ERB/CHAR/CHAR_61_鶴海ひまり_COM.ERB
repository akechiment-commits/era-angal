;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:TARGET:210 == 0
		CFLAG:TARGET:210 = 1
		;初回
		PRINTFORMW 「勉強、だとお……！？　せえとかいちょおは勉強が苦手なのだあ、知っているだろお下僕くん！　だが、内申点のためには避けて通れぬ道……ユッキーの代わりに付き合ってくれ、今日から我が専属家庭教師なのだあ！」
	ELSE
		A = RAND:3
		;--- 恋人 ---
		IF TALENT:TARGET:153
			IF A == 0
				PRINTFORMW 「ふむ、勉強中におまえにくっついていたら、なぜか集中できるのだあ、不思議だなあ♪」
			ELSEIF A == 1
				PRINTFORMW 「なあ、ちょっと休憩しよう――こう、肩寄せて、ほんの5分だけ、な？　ふふっ、特別サービスだぞお♪」
