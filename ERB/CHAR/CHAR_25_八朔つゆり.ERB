;============================================================
; 八朔つゆり　NO:25　?年2-A　帰宅部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_25
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「」
	ELSE
		PRINTFORML 「」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_25
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_25
A = RAND:3
IF A == 0
	PRINTFORML 「」
ELSEIF A == 1
	PRINTFORML 「」
ELSE
	PRINTFORML 「」
ENDIF
RETURN

