;------------------------------------------------------------
; 初回遭遇(TFLAG:86  0=教室  1=部室  2=委員会室)
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_25
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「コホ、コホ……あれ、見ない顔だね。もしかして転校生くん?　わたしは八朔つゆり、2-Aの保健委員だよ。……ごめんね、わたし学校休みがちだから、今まで会う機会がなくて」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「あれ……ここで横になってるの、みっともないよね。コホ……ちょっと休んでただけだから、気にしないで。わたし八朔つゆり、よろしくね」
	ELSE
		PRINTFORML 「あ、転校生くん。保健委員会に用事かな?　わたしは八朔つゆり、よろしくお願いね。ときどき保健委員の代理、お願いすることになると思うから……ごめんね、身体が弱くて」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_25
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇(場所での時間経過・遭遇のたびにランダム)
; TALENT:TARGET:153: 恋人フラグ(1=恋人)
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_25
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生くん♪　見知った顔に会えるとほっとするよ。コホ……今日も一緒にいてくれるのかな?」
	ELSEIF A == 1
		PRINTFORML 「ふふ、転校生くんだぁ。……わたしね、転校生くんが近くにいると、なんだか呼吸が楽なんだよ」
	ELSE
		PRINTFORML 「転校生くん、ちょうどよかった。……あのね、べつに用事はないんだけど、顔が見たくなっちゃって♪」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「あ、転校生くん。コホ、コホ……ごめんね、なんかいつも咳してる気がするね」
	ELSEIF A == 1
		PRINTFORML 「やっほ、転校生くん。いつも保健委員のお手伝い、ありがとうね」
	ELSE
		PRINTFORML 「転校生くん、また会ったね♪　わたし、歩くのがゆっくりだから、こうやって追いついてもらえると助かるよ」
	ENDIF
ENDIF
RETURN

