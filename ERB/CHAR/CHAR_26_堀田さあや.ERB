;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;============================================================
; 堀田さあや　NO:26　?年2-A　バレー部
; 遭遇・行事・試験・エンディング
; CFLAG:TARGET:200 = 初回遭遇完了フラグ
;============================================================

;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_26
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「あら何よ、転校生。あんたから話しかけてくるなんて珍しいわね？　まったく、用があるなら早く言いなさい」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「あら何よ、転校生。あんたの部屋に呼びだされるなんて……ふぅん。まぁ、用があるなら聞くわよ」
	ELSE
		PRINTFORML 「あら何よ、転校生。委員会まで来るなんて感心ね。用があるなら、そこ座って待ってなさい」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_26
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_26
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「あら、転校生。今日もあたしに会いに来てくれたのね。べ、べつに待ってたわけじゃないんだから」
	ELSEIF A == 1
		PRINTFORML 「もう、転校生ったら。そんなに頻繁に来なくても、あたしが逃げるわけないでしょ？　ふふ、でも嬉しいけど」
	ELSE
		PRINTFORML 「あんた、また来たの？　まったく、しょうがないやつね。（――でも、来てくれないと寂しいけど）」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「また、あたしのとこに来たの？　まったく、しょうがないやつね。まぁ、用があるなら聞くわよ」
	ELSEIF A == 1
		PRINTFORML 「あら何よ、転校生。あんた、ほんとに頻繁にあたしのとこに来るわね。べつに迷惑ってわけじゃないけど」
	ELSE
		PRINTFORML 「ふぅん、今日は何の用かしら。委員会の仕事？　それとも……まぁいいわ、聞くだけ聞いてあげる」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; 朝の挨拶（SYSTEM_基本システム処理 経由・毎朝呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_MORNING_GREETING_26
IF TALENT:TARGET:153
	; ▼ 恋人: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「あ、おはよう転校生……♪　って、何ぼーっと見てんのよ。べつに嬉しいわけじゃないけど」
	CASE 1
		PRINTFORML 「おはよう。あんた、今朝ちゃんと食べてきたの？　はい、これ。お弁当のついでに作っただけよ」
	CASE 2
		PRINTFORML 「おはよう、転校生。（また顔見られた。朝から心臓に悪いわ）……何よ、なんでもないわよ」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「あら、おはよう。早いわね。ちゃんと朝ごはん食べてきた？　倒れられたら困るんだから、しっかりしなさい」
	CASE 1
		PRINTFORML 「おはよう。あんた、今日は遅刻ギリギリじゃない？　もう、しょうがないやつね。次は気をつけなさい」
	CASE 2
		PRINTFORML 「おはよう、転校生。ふぅん、今日もなんともない顔ね。あら何よ、見てたら悪い？」
	ENDSELECT
ENDIF
RETURN

;------------------------------------------------------------
; 休憩（SHOPで休憩を選んだとき）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REST_26
IF TALENT:TARGET:153
	PRINTFORML 「あ、転校生。ちょうど一息つきたかったとこなのよ。いっしょに休もっか。（――あんたといると、不思議と落ち着くのよね）」
ELSE
	PRINTFORML 「ふぅ、ちょっと休憩しましょ。あんたも疲れてるでしょ、無理しないの。お茶ぐらい用意してあげるけど、勘違いしないでよね」
ENDIF
RETURN

;------------------------------------------------------------
; 昼食（LUNCH_EAT_昼食・食事 経由・昼に呼ばれる）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_LUNCH_26
IF TALENT:TARGET:153
	PRINTFORML 「転校生、お昼はあたしといっしょよね？　ふふ、お弁当ちょっと多めに作っちゃったの。べ、
	PRINTFORML べつにあんたのためってわけじゃないけど」
ELSE
	PRINTFORML 「あんた、昼ご飯まだでしょ？　あたしも梅園とこれから食べるとこ。まぁ、ついでだし、いっしょに食べてもいいわよ」
ENDIF
RETURN

;------------------------------------------------------------
; パートナー選択時（SHOPメニューで選択した直後）
; TFLAG:88: 0=イチャイチャ  2=休憩  3=スキル習得
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_PARTNER_DIALOG_26
IF TALENT:TARGET:153
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「もう、転校生。あたしばっかり選んで、他の娘に怒られない？　ふふ、まぁ嬉しいけど。今日もよろしくね」
	CASE 1
		PRINTFORML 「ふぅん、今日もあたし？　ふふ、まぁ……悪い気はしないわ。よろしくね、転校生」
	CASE 2
		PRINTFORML 「あんたって、ほんとあたしがいいのね。……べ、べつに嬉しくなんかないけど。行きましょ」
	ENDSELECT
ELSE
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「ふぅん、またあたしを選ぶの？　まぁいいわ。あんたが頼りにしてくれるのは悪い気しないし、しっかり付き合ってあげる」
	CASE 1
		PRINTFORML 「あたしを？　ふぅん、いいわ。頼られると、放っておけないのよね、あたし」
	CASE 2
		PRINTFORML 「しょうがないわね、付き合ってあげる。しっかりついてきなさいよ、転校生」
	ENDSELECT
ENDIF
RETURN

;------------------------------------------------------------
; 初パートナー選択時（初めてこのキャラをパートナーに選んだ瞬間・1回のみ）
; CFLAG:TARGET:201=0→初回のみ発動。LOCATION_EVENT経由で呼ばれる
;------------------------------------------------------------
@CHAR_FIRST_PARTNER_26
IF CFLAG:TARGET:201 == 0
	CFLAG:TARGET:201 = 1
	IF TALENT:TARGET:153
		PRINTFORML 「あんたが、はじめてパートナーに選んでくれたの……？　ふ、ふん、いいわよ。
		PRINTFORML あたしが一番頼りになるって、ようやくわかったのね。（――なんで、こんなに嬉しいんだろ）」
	ELSE
		PRINTFORML 「あんた、あたしをパートナーに選んだの？　ふぅん、見る目あるじゃない。しっかり面倒みてあげるから、覚悟しなさい」
	ENDIF
ENDIF
RETURN

;------------------------------------------------------------
; セッション終了時（パートナーとの行動終了時・毎回呼ばれる）
; ※休憩終了時は呼ばれない（休憩は CHAR_REST のみ）
; ※イチャイチャ（BEGIN TRAIN）終了後も同様にここが呼ばれる（別途対応なし）
; ※スキル習得（BEGIN ABLUP）はこの口上の後で動く
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
; ランダム表示用: SELECTCASE RAND(N) で複数パターンを分岐させること
;------------------------------------------------------------
@CHAR_SESSION_END_26
IF TFLAG:44
	; ▼ ウフフに入った（調教あり）
	IF BASE:TARGET:0 <= 750
		; ▼ 低体力（疲労困憊）
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ……はぁ……。もう、指一本動かないわよ……。ふふ、あんたのせいだからね……♪」
			CASE 1
				PRINTFORML 「腰、抜けちゃったじゃない……。あんなにするから……。ん、立てないわ……♪」
			CASE 2
				PRINTFORML 「（あたま、ぼうっとする……）……あんたのこと、好き……。もう、なにも考えられない……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう無理よ……っ。こんなにヘトヘト、初めてなんだけど……」
			CASE 1
				PRINTFORML 「う……体に力が入らないわ……。ちょっと、休ませなさいよ……っ」
			CASE 2
				PRINTFORML 「はぁ……あんた、加減しなさいよね……。あたし、もうくたくたなんだから……っ」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……あんたと、こんなことしちゃったわね。ふふ、悪くないわ……♪」
			CASE 1
				PRINTFORML 「ん……どきどきした。でも、あんたとなら、何度でも……べ、べつに欲ばりじゃないわよ？♪」
			CASE 2
				PRINTFORML 「あんたのこと、もっと好きになっちゃったじゃない……。責任、取りなさいよね♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……は、恥ずかしいわね。あたし、こんな声出すなんて……。忘れなさいよ？」
			CASE 1
				PRINTFORML 「う……あんたの前で、あんな……。み、見てないわよね？　べつに……っ」
			CASE 2
				PRINTFORML 「ん……体があったかいわ。ふふ……また、いいわよ。あんたが望むならね？」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「もう、終わりの時間？　なんか、ちょっと寂しいわね。ふふ、また明日ね、転校生」
		CASE 1
			PRINTFORML 「あんた、もう帰っちゃうの？　うん、また明日。ちゃんとご飯食べて寝なさいよ」
		CASE 2
			PRINTFORML 「じゃあね、転校生。（あんたに『おやすみ』って言うの、なんでこんなにドキドキするのかしら）……何よ、なんでもないわよ」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「もうこんな時間ね。あんた、ちゃんと帰りなさいよ。途中で迷子にならないように、ね？」
		CASE 1
			PRINTFORML 「ふぅ、お疲れさま。今日もよくがんばったわね。べつに褒めてるわけじゃないけど」
		CASE 2
			PRINTFORML 「じゃ、また明日ね、転校生。気をつけて帰りなさい。何かあったらすぐ連絡するのよ？」
		ENDSELECT
	ENDIF
ENDIF
RETURN


;==============================================================
; 自発的口上  @SELF_KOJO_K26
; TFLAG:13 = 95/96: 甲斐性なしプロポーズ（指輪をはめた直後）
; TFLAG:13 = 99   : コマンド実行失敗
;==============================================================
@SELF_KOJO_K26
IF TFLAG:13 == 95 || TFLAG:13 == 96
	;--- 甲斐性なし：パートナーからのプロポーズ ---
	; ★山場: 十分なボリュームの口上にすること
	PRINTFORML 「ねぇ、転校生。聞いて。あたし、ずっと考えてたの。あんた、学院をやめて、
	PRINTFORML これからどうするつもりなの？　仕事も決まってない、頼りないわよね。……ふん。それでも、
	PRINTFORML あたしはあんたを選ぶの。これ、指輪。受けとって。（――あぁもう、何これ、
	PRINTFORML 心臓が止まりそう）べ、べつに勘違いしないでよ。頼りないあんたを放っておけないから、
	PRINTFORML なんてわけじゃないんだから。ただ、あたしはあんたが好きなの。
	PRINTFORML 立派になるまで待ってられない。これからのことを、ふたりで考えたいのよ。
	PRINTFORMW だから――%CALLNAME:PLAYER%。あたしと結婚して。あたしが、あんたを支えるから。……お願い」
	RETURN 0
ELSEIF TFLAG:13 != 99
	RETURN 0
ENDIF

;--- コマンド実行失敗 ---
A = RAND:3
IF A == 0
	PRINTFORMW 「あら、何やってんの。ちゃんとしなさいよ、もうっ」
ELSEIF A == 1
	PRINTFORMW 「ちょっと、しっかりしてよ転校生。これは見過ごせないわ」
ELSE
	PRINTFORMW 「もう、しょうがないやつね。ほら、深呼吸して、もう一回。あたしが見ててあげるから」
ENDIF
RETURN 0

;------------------------------------------------------------
; 体育祭（SCHOOL_EVENT経由・秋開催）
; ARG:0: 0=参加  1=3位  2=準優勝  3=優勝
;------------------------------------------------------------
@CHAR_SPORTS_FESTIVAL_26, ARG
IF ARG:0 == 3
	PRINTFORML 「やったわね、優勝！　ふふ、あたしたちのクラスが一番ってことよ。ありがと、転校生。あんたががんばってくれたおかげね」
ELSEIF ARG:0 == 2
	PRINTFORML 「あと一歩、惜しかったわね。でも、よくがんばったわ。来年は絶対優勝するわよ、覚悟しときなさい」
ELSEIF ARG:0 == 1
	PRINTFORML 「ん～、3位かぁ。まぁ、表彰台に乗れただけマシよね。ふぅ、お疲れさま、転校生」
ELSE
	PRINTFORML 「ふぅ、今年は表彰台ダメだったかぁ。悔しいけど、来年があるわよね。あたしも梅園も、もっと鍛えとくわ」
ENDIF
RETURN

;------------------------------------------------------------
; 文化祭（SCHOOL_EVENT経由・秋開催）
; ARG:0: 0=普通  1=まあまあ  2=成功  3=大成功
;------------------------------------------------------------
@CHAR_CULTURE_FESTIVAL_26, ARG
IF ARG:0 == 3
	PRINTFORML 「ふふ、大成功じゃない！　あたしたちの出し物、最高だったわよね。転校生のおかげでもあるわ。ありがと」
ELSEIF ARG:0 == 2
	PRINTFORML 「うん、成功ね。準備した甲斐があったってもんよ。あんたもお疲れさま、転校生」
ELSEIF ARG:0 == 1
	PRINTFORML 「ん～、まあまあってとこかしらね。来年はもっと工夫したいわ。あんたもちゃんと考えなさいよ」
ELSE
	PRINTFORML 「ふぅ、終わったわね。まぁ、こんなもんかしら。来年こそはもっと盛りあげましょ、ね？」
ENDIF
RETURN

;------------------------------------------------------------
; クイズ選手権（ARG:0: 0=参加 1=3位 2=準優勝 3=優勝）
;------------------------------------------------------------
@CHAR_KNOWLEDGE_CONTEST_26, ARG
IF ARG:0 == 3
	PRINTFORML 「やったわ、優勝よ！　ふふ、知識量で負ける気はしなかったけどね。転校生もがんばったわ、認めてあげる」
ELSEIF ARG:0 == 2
	PRINTFORML 「準優勝かぁ。ちょっと悔しいけど、まぁ次回がんばればいいわよね」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位、なんとか食らいついたわね。次はもう少し上を狙えるはずよ」
ELSE
	PRINTFORML 「うーん、今回はちょっと振るわなかったわね。次は対策ノートをもっと充実させなきゃ」
ENDIF
RETURN

;------------------------------------------------------------
; 学力コンテスト（ARG:0: 0=参加 1=3位 2=準優勝 3=優勝）
;------------------------------------------------------------
@CHAR_ACADEMIC_CONTEST_26, ARG
IF ARG:0 == 3
	PRINTFORML 「ふふ、優勝よ。当然よね？　あたしのノートを貸してた甲斐があったわ、転校生」
ELSEIF ARG:0 == 2
	PRINTFORML 「準優勝かぁ、惜しかったわね。次は絶対優勝するわよ。あんたもちゃんとついてきなさい」
ELSEIF ARG:0 == 1
	PRINTFORML 「3位ね。まぁ、悪くないわ。でも、もう少しがんばれたわよね、お互いに」
ELSE
	PRINTFORML 「ふぅ、表彰台ならず、かぁ。次に向けて、勉強会のメンバーを考え直しましょ」
ENDIF
RETURN

;------------------------------------------------------------
; 試験前（STAGE_学期進行経由・試験実施ターンに呼ばれる）
; TFLAG:83: 0=中間試験  1=期末試験
;------------------------------------------------------------
@CHAR_EXAM_BEFORE_26
IF TFLAG:83 == 0
	PRINTFORML 「もうじき中間試験よ、転校生。ちゃんと勉強してる？　あたしのノート貸してあげるから、
	PRINTFORML しっかり写しなさい。あんたに落第されたら、あたしの面目が立たないんだから」
ELSE
	PRINTFORML 「次は期末試験ね。中間より範囲が広いんだから、油断しちゃダメよ。あたしも、できるだけ協力するから」
ENDIF
RETURN

;------------------------------------------------------------
; 試験結果（STAGE_学期進行経由・合否判定後に呼ばれる）
; ARG:0: 0=不合格  1=合格  2=好成績（合格ライン+30点以上）
;------------------------------------------------------------
@CHAR_EXAM_RESULT_26, ARG
IF ARG:0 == 2
	PRINTFORML 「ふふ、よくがんばったわね、転校生。これだけ点が取れれば文句なしよ。あたしのおかげも、ちょっとはあるかしら？」
ELSEIF ARG:0 == 1
	PRINTFORML 「合格、おめでとう。ふぅ、よかったわ。これで一安心ね」
ELSE
	PRINTFORML 「あんた、まったく、何やってんの。あれだけ勉強を教えたのに。まぁ、追試もあるんだし、
	PRINTFORML もう一回はじめからやり直しよ。あたしが見ててあげる」
ENDIF
RETURN

;------------------------------------------------------------
; 【エンゲージリングプロポーズ口上】
; ★山場: 転校生がプロポーズする場面、長めの口上にすること
;------------------------------------------------------------
@CHAR_ENGAGE_RING_26
