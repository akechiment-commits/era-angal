				PRINTFORML 「（あたま、ぼうっと……海の底みたいっち……）……転校生くん、好きっち……。もう、なにも考えられないっち……♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「はぁ、はぁ……も、もう限界っち……。こんなにくたくた、はじめてっち……っ」
			CASE 1
				PRINTFORML 「うう……体に力が入らないっち……。ちょっと、休ませてっち……？」
			CASE 2
				PRINTFORML 「はぁ……うち、ぐったりっち……。転校生くん、激しすぎっち……っ」
			ENDSELECT
		ENDIF
	ELSE
		; ▼ 体力に余裕あり
		IF TALENT:TARGET:153
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふふ……転校生くんと、こんなことしちゃったっち……。しあわせっち……♪」
			CASE 1
				PRINTFORML 「ん、どきどきしたっち。でも、転校生くんとなら何度でも……ふふ、欲ばりっちか♪」
			CASE 2
				PRINTFORML 「転校生くんのこと、もっと好きになっちゃったっち……。どうしようっち♪」
			ENDSELECT
		ELSE
			SELECTCASE RAND(3)
			CASE 0
				PRINTFORML 「ふぅ……は、恥ずかしいっち……。うち、こんな声……。見ないでっち……？」
			CASE 1
				PRINTFORML 「うう……転校生くんの前で、あんな……。わ、忘れてほしいっち……っ」
			CASE 2
				PRINTFORML 「ん～、体があったかいっち♪　ふふ、また……いいっち？　転校生くんがしたいなら♪」
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	; ▼ ウフフなし（従来の別れ際）
	IF TALENT:TARGET:153
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日はありがとっち、転校生くん♪　また一緒にいようっちね」
		CASE 1
			PRINTFORML 「ふぅ、楽しかったっち♪　うち、転校生くんといると元気が出るっちよ」
		CASE 2
			PRINTFORML 「ばいば～い、転校生くん。また会おうっちね♪」
		ENDSELECT
	ELSE
		SELECTCASE RAND(3)
		CASE 0
			PRINTFORML 「今日はありがとっち、助かったっちよ♪」
		CASE 1
			PRINTFORML 「ふぅ、いい時間だったっち。また付き合ってっちね～♪」
		CASE 2
			PRINTFORML 「ばいば～い、気をつけて帰るっちよ～？」
		ENDSELECT
	ENDIF
ENDIF
