	CASE 2
		PRINTFORML 「おはようっち♪　今日も一日、一緒にがんばるっちよ～？」
	ENDSELECT
ELSE
	; ▼ 通常: 複数パターンからランダム表示
	SELECTCASE RAND(3)
	CASE 0
		PRINTFORML 「おはようっち、転校生くん。早起きっちね～♪」
	CASE 1
		PRINTFORML 「ん、おはよう。今日も泳ぎたい天気だっちね♪」
	CASE 2
