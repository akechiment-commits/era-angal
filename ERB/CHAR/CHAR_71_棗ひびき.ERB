;------------------------------------------------------------
; 初回遭遇（TFLAG:86  0=教室  1=部室  2=委員会室）
;------------------------------------------------------------
@CHAR_FIRST_DIALOG_71
IF CFLAG:TARGET:200 == 0
	CFLAG:TARGET:200 = 1
	IF TFLAG:86 == 0
		PRINTFORML 「お、見ない顔っち。あんたが噂の転校生くんっちか？　うちは三年Ｃ組の棗ひびき、水泳部の副部長だっちよ。よろしくっち♪」
	ELSEIF TFLAG:86 == 1
		PRINTFORML 「おや、こんなところまで来るとは。ここ、水泳部の部室っちよ？　ま、いいっち。うちは棗ひびき、よろしくっちね♪」
	ELSE
		PRINTFORML 「ん？　あんた、転校生くんっちね。こんなところで会うとは奇遇っち。うちは棗ひびき、水泳部だっちよ。仲良くするっち♪」
	ENDIF
ELSE
	CALL CHAR_REPEAT_DIALOG_71
ENDIF
RETURN

;------------------------------------------------------------
; 再遭遇（場所での時間経過・遭遇のたびにランダム）
; TALENT:TARGET:153: 恋人フラグ（1=恋人）
;------------------------------------------------------------
@CHAR_REPEAT_DIALOG_71
IF TALENT:TARGET:153
	A = RAND:3
	IF A == 0
		PRINTFORML 「やっほ、転校生くん。会えて嬉しいっち♪」
	ELSEIF A == 1
		PRINTFORML 「おや、また会ったっちね。うちのこと、探してたっちか？　ふふ♪」
	ELSE
		PRINTFORML 「んっ、転校生くん。ちょっと一泳ぎしたい気分だったっち、付き合ってくれる？」
	ENDIF
ELSE
	A = RAND:3
	IF A == 0
		PRINTFORML 「おや、転校生くん。今日も精が出るっちね～♪」
	ELSEIF A == 1
		PRINTFORML 「やっほう。うちも、ここにいるっちよ～？」
	ELSE
		PRINTFORML 「ん、転校生くんっちか。なんか用っち？」
	ENDIF
ENDIF
RETURN

