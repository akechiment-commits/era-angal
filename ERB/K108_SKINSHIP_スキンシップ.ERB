					;抵抗する
					ELSEIF (CFLAG:699 & 1p3) && RAND:2
						PRINT 嫌がって
					;取り乱す
					ELSEIF CFLAG:699 & 1p4
						PRINT びっくりして
					ELSE
						PRINT 恥ずかしがって
					ENDIF
				ENDIF
			;あなたがされている
			CASE 2, 4, 6, 10
				IF MARK:3
					PRINT 怒って
