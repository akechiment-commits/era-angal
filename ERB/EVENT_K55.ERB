		PRINTFORMW ―貧乳モードで開始します―
		TALENT:109 = 1
	ELSEIF RESULT == 2
		PRINTFORMW ―巨乳モードで開始します―
		TALENT:110 = 1
	ELSEIF RESULT == 0
		PRINTFORMW ―普乳モードで開始します―
	ELSE
		GOTO INPUT_LOOP2
	ENDIF
	PRINTL レイセンってどんな体型だっけ
	PRINTL [0] 普通じゃなかったっけ
	PRINTL [1] てゐより小さくなかった？
	$INPUT_LOOP3
	INPUT
	IF RESULT == 0
		PRINTFORMW ―普通体型で開始します―
	ELSEIF RESULT == 1
		PRINTFORMW ―小柄体型で開始します―
		TALENT:100 = 1
	ELSE
		GOTO INPUT_LOOP3
	ENDIF
	PRINTL レイセンと仲の良いキャラクターを追加しても構いませんか？
	PRINTL [0] 構わん、やれ
	PRINTL [1] 二次創作はあまり好まん
	$INPUT_LOOP4
	INPUT
	IF RESULT == 0
		PRINTFORMW 仲の良いキャラクターを追加します
		;とある二次創作でのレイ雛は本当に良い
		RELATION:TARGET:11  = 100
		RELATION:TARGET:32  = 80
		RELATION:TARGET:39  = 130
		RELATION:TARGET:40  = 80
		RELATION:TARGET:41  = 80
		RELATION:TARGET:42  = 80
		RELATION:TARGET:63  = 80
		CFLAG:601 = 1
	ELSEIF RESULT == 1
		PRINTFORMW 追加要素はオミットいたします
	ELSE
		GOTO INPUT_LOOP4
	ENDIF
;	CFLAG:220 = 1
	CFLAG:220 |= 1
ENDIF

