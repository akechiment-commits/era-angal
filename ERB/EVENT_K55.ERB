		PRINTFORMW いいよね、妹キャラのレイセン
		STR:110 = %CALLNAME:MASTER%お兄さん
		CFLAG:555 = 4
	ELSEIF RESULT == 5
		PRINTFORMW まさかこれを選ぶとはまさかこの(ry
		STR:110 = お兄さん
		CFLAG:555 = 5
	ELSEIF RESULT == 6
		;エッチなお友達はお小遣いもってエッチなお店に(ry
		PRINTFORMW お前はどこへ行こうとしている？
		STR:110 = パパ
		CFLAG:555 = 6
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	PRINTL レイセンの胸は
	PRINTL [0] 大きくもなく小さくもなく
	PRINTL [1] 普通にちっちゃくなかった？
	PRINTL [2] 巨乳こそ正義…いい時代になったものだ
