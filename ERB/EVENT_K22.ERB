				PRINTFORMW 「ご主人様って、呼んで欲しいの？　それとも旦那様？」
				CFLAG:408 = 1
			;割烹着
			ELSEIF RAND:3 == 0 && CFLAG:409 == 0
				PRINTFORMW 「割烹着……？　藍がよく着てるわね」
				PRINTFORMW 「えっ、私に？　……似合うかしら？」
				CFLAG:409 = 1
			;バスローブ
			ELSEIF RAND:3 == 0 && CFLAG:410 == 0
				PRINTFORMW 「バスローブ？　一体どこから仕入れてきたんだか……」
				PRINTFORMW 「まあいいわ、今度……うふふ」
				CFLAG:410 = 1
			;もんぺ
			ELSEIF RAND:3 == 0 && CFLAG:411 == 0
				PRINTFORMW 「……もんぺ？」
				PRINTFORMW 「竹林の蓬莱人みたいね」
				CFLAG:411 = 1
			;ウェディングドレス
			ELSEIF TALENT:85 == 1 && RAND:10 == 0 && CFLAG:412 == 0
				PRINTFORMW 「嘘……ウェディングドレスなんて……」
				PRINTFORMW 「これは夢かしら……」
