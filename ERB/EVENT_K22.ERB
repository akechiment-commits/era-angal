				PRINTFORMW 「ありがとう。でも、まだ時期じゃないわ」
				PRINTFORMW 「これは……一番大切な時に着たいの……」
				CFLAG:412 = 1
			;それ以外
			ELSE
				;大成功
				IF TFLAG:18 == 1
					PRINTFORMW 「あら、服を私に？」
					PRINTFORMW 「ありがとう、今度着させてもらうわ」
				;失敗
				ELSEIF TFLAG:18 == -1
					PRINTFORMW 「はぁ……もう少し似合う服だったら嬉しいんだけど……」
				;それ以外
				ELSE
					;春
					IF DAY:2 == 0
						PRINTFORMW 「あら、制服？　ありがとう」
						PRINTFORMW 「前から着てみたいと思っていたのよ、制服って」
					;夏
					ELSEIF DAY:2 == 1
						PRINTFORMW 「これを私に？」
						PRINTFORMW 「ありがとう、今度着させてもらうわ」
					;秋
					ELSEIF DAY:2 == 2
						PRINTFORMW 「知ってるわよ。コスプレ、でしょ？」
