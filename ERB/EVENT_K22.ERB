;刻印変動をトリガーにした口上
;刻印変動後に口上を発動します
;-------------------------------------------------
@KOJO_MESSAGE_MARKCNG_22
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には口上をスキップする（OFFだと口を塞いでるのに喋りまくる）
SIF TEQUIP:45
	RETURN 0
;-------------------------------------------------
;刻印変動のセリフ CFLAG:391～
;-------------------------------------------------
;-------------------------------------------------
;苦痛依存Lv3取得 CFLAG:391
;-------------------------------------------------
IF TFLAG:22 == 3 && CFLAG:391 == 0
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「ぐっ……この痛みも、愛の形なのかしら……」
	;それ以外
	ELSE
		PRINTFORMW 「ごめんなさいっ！　もう許してっ！　酷い事しないでっ」
	ENDIF
		CFLAG:391 = 1
ENDIF

;-------------------------------------------------
;快楽依存Lv3取得 CFLAG:392
;-------------------------------------------------
IF TFLAG:23 == 3 && CFLAG:392 == 0
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW （頭のてっぺんから爪先まで痺れちゃう）
		PRINTFORMW （こんなに気持ちいい事、忘れる事なんて……っ）
	;それ以外
	ELSE
		PRINTFORMW 「はぁ、はぁ……気持ちいいわ……」
		PRINTFORMW 「そのまま、続けて……」
	ENDIF
		CFLAG:392 = 1
ENDIF

;-------------------------------------------------
;既成事実Lv1～3取得 CFLAG:393
;-------------------------------------------------
;既成事実Lv3
IF TFLAG:24 == 3 && CFLAG:393 < 3
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「一つだけ……約束して……」
		PRINTFORMW 「貴方がいてくれるだけでいいの」
		PRINTFORMW 「だから……ずっと……私の傍にいて……」
	;それ以外
	ELSE
		PRINTFORMW （想っただけで、胸が熱い……）
		PRINTFORMW （私の中で……こんなに大切な存在になってたのね……）
	ENDIF
		CFLAG:393 = 3
;既成事実Lv2
ELSEIF TFLAG:24 == 2 && CFLAG:393 < 2
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「ふふっ、もっと傍に来て……」
		PRINTFORMW 「貴方と私の壁がなくなるくらいに……」
	;それ以外
	ELSE
		PRINTFORMW （このまま……身を委ねるのも、いいかもしれないわね）
	ENDIF
		CFLAG:393 = 2
;既成事実Lv1
ELSEIF TFLAG:24 == 1 && CFLAG:393 < 1
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「……妖怪だって、恋はするのよ」
		PRINTFORMW 「な、何よ、そんなにおかしい事を言ったかしら？」
	;それ以外
	ELSE
		PRINTFORMW 「ふふっ、どこまで頑張るかしらね」
		PRINTFORMW 紫は貴方を見つめながら、妖しく微笑んだ
	ENDIF
		CFLAG:393 = 1
ENDIF

;-------------------------------------------------
;反発感情Lv1～3取得 CFLAG:394
;-------------------------------------------------
;反発感情Lv3
IF TFLAG:21 == 3 && CFLAG:394 < 3
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「ねぇ、今までの愛は偽りだったの？」
	;それ以外
	ELSE
		PRINTFORMW 「ふふっ、調子に乗ってると、後で痛い目を見るわよ」
	ENDIF
		CFLAG:394 = 3
;反発感情Lv2
ELSEIF TFLAG:21 == 2 && CFLAG:394 < 2
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「……私にだって、我慢の限界があるわ」
		PRINTFORMW 紫は顔を顰めながら、%CALLNAME:MASTER%に言った
	;それ以外
	ELSE
		PRINTFORMW 「あらあら、退治されないといけない相手が増えたみたいね」
	ENDIF
		CFLAG:394 = 2
;反発感情Lv1
ELSEIF TFLAG:21 == 1 && CFLAG:394 < 1
	;恋慕
	IF TALENT:85 == 1
		PRINTFORMW 「ふふっ、少しおいたが過ぎるんじゃない？」
		PRINTFORMW 紫は不気味なくらい優しげな笑みを浮かべた
	;それ以外
	ELSE
		PRINTFORMW 「私がちょっと力を使えば、貴方は跡形もなく消し飛ぶ」
		PRINTFORMW 「その事を忘れたのかしら？」
	ENDIF
		CFLAG:394 = 1
ENDIF

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係（X1をキャラ番号に置換）
;--------------------------------------------------
@KOJO_MESSAGE_COM_22
;助手が調教した時に口上をスキップする（好みに応じて使う、行頭の;を消すとスキップするようになる）
;SIF ASSI > 0 && ASSIPLAY
;	RETURN 0 
;ボールギャグ着用時には口上をスキップする（OFFだと口を塞いでるのに喋りまくる）
SIF TEQUIP:45 && SELECTCOM != 45
	RETURN 0
;-------------------------------------------------
;コマンド実行時のセリフ CFLAG:401～
;-------------------------------------------------
;～～～～～～～～～～～～～～～～～～～～～～～～～
;コミュニケーション系コマンド
;～～～～～～～～～～～～～～～～～～～～～～～～～
;-------------------------------------------------
;-------------------------------------------------
;-------------------------------------------------
;弾幕ごっこ CFLAG:401
;-------------------------------------------------
IF SELECTCOM == 300
	;初めて
	IF CFLAG:401 == 0
		PRINTFORMW 「全力で来なさい」
		PRINTFORMW 「貴方の実力、見極めてあげるわ」
		CFLAG:401 = 1
	;二回目以降
	ELSE
		;恋慕
		IF TALENT:85 == 1 && (CFLAG:401 < 6 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「あ、あら、私が負けちゃったわね」
				PRINTFORMW 「ふふっ、勝者は敗者の体を好きにしていいのよ」
				PRINTFORMW 紫は%CALLNAME:MASTER%を誘うように、熱い視線を送った
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「こんな事するよりも、貴方と一緒にのんびり過ごす方がいいわ……」
				ELSE
					PRINTFORMW 「強くなったわね、本当に……」
				ENDIF
			ENDIF
				CFLAG:401 = 6
		;恋人
		ELSEIF TALENT:153 == 1 && (CFLAG:401 < 5 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「私が負けたら？　そうねぇ……」
				PRINTFORMW 「そうだわ、私が負けたらキスしてあげるわ」
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「私が勝ったら、ご褒美にキスして」
					PRINTFORMW 「約束よ、いいわね？」
				ELSE
					PRINTFORMW 「うーん、貴方が相手だと、戦いにくいわ」
				ENDIF
			ENDIF
				CFLAG:401 = 5
		;キス経験有り
		ELSEIF EXP:96 > 0 && (CFLAG:401 < 4 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「上手い上手い、今の動き良かったわ」
				PRINTFORMW 紫は微笑みながら、軽く拍手した
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「上手くなったわね、頼りにしてるわよ」
				ELSE
					PRINTFORMW 「なかなかやるわね」
					PRINTFORMW 「これなら、少し本気を出してもいいみたいね」
				ENDIF
			ENDIF
				CFLAG:401 = 4
		;デート経験有り
		ELSEIF EXP:94 > 0 && (CFLAG:401 < 3 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「あら、上手いじゃない」
				PRINTFORMW 「やっぱり教える側がいいと、上達も早いわね」
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「少しは様になってきてるけど、気を抜いちゃ駄目よ」
					PRINTFORMW 紫の弾幕が、%CALLNAME:MASTER%のすぐ脇を通り過ぎた
				ELSE
					PRINTFORMW 「稗田の娘よりは、戦い方が様になってるわよ」
				ENDIF
			ENDIF
				CFLAG:401 = 3
		;それ以外
		ELSEIF CFLAG:401 < 2 || FLAG:7 == 2
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW %CALLNAME:MASTER%が紙一重で避けると、紫は驚きを見せた
				PRINTFORMW 「あら……まぐれでもやるじゃない」
			;失敗
			ELSEIF TFLAG:18 == -1
				PRINTFORMW 「はぁ……使えないわね」
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「本気で戦わないと、怪我するわよ？」
				ELSE
					PRINTFORMW 「手加減？　そんなものいらないわ」
					PRINTFORMW 「それよりも、本気で来ないと、怪我するわよ」
				ENDIF
			ENDIF
				CFLAG:401 = 2
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;会話 CFLAG:402
;-------------------------------------------------
IF SELECTCOM == 301
	;初めて
	IF CFLAG:402 == 0
		PRINTFORMW 「お話？　そうねぇ、貴方が普段どんな事をしているか教えて下さらない？」
		PRINTFORMW 紫は妖しく微笑みながら、%CALLNAME:MASTER%の話に耳を傾けた
		CFLAG:402 = 1
	;二回目以降
	ELSE
		;恋慕
		IF TALENT:85 == 1 && (CFLAG:402 < 6 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「大好きよ、本当に……」
				PRINTFORMW 紫は愛情の篭った瞳を%CALLNAME:MASTER%に向けながら、指を絡ませた
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「ふふっ、大好きよ……」
					PRINTFORMW 紫の顔には、聖母のような微笑みが浮かんでいた
				ELSE
					PRINTFORMW 「やっぱり、貴方が傍にいてくれると落ち着くわ……」
					PRINTFORMW 「このまま、キスしてくれないかしら？」
				ENDIF
			ENDIF
				CFLAG:402 = 6
		;恋人
		ELSEIF TALENT:153 == 1 && (CFLAG:402 < 5 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「貴方のような人に出会う為、今まで生きてきたのかもしれないわ……」
				PRINTFORMW 「……わ、笑っちゃ嫌よ、ちょっぴり恥ずかしいんだから……」
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「こうやってお話してるだけで、体が火照ってくるの……」
					PRINTFORMW 「恋の病かしら？」
				ELSE
					PRINTFORMW 「ねぇ、好きって言って」
					PRINTFORMW 「恋人同士でも、好きって言ってもらえるのは嬉しいものなのよ」
				ENDIF
			ENDIF
				CFLAG:402 = 5
		;キス経験有り
		ELSEIF EXP:96 > 0 && (CFLAG:402 < 4 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「あっ……大丈夫、風邪を引いてる訳じゃないから……」
				PRINTFORMW 紫は頬を赤らめながら、%CALLNAME:MASTER%の話に耳を傾けた
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「デートの約束？　そうねぇ、付き合ってあげてもいいわよ」
				ELSE
					PRINTFORMW 「……次にキスする時は、もっと激しく……」
					PRINTFORMW 「わっ、私ったら一体何を……」
				ENDIF
			ENDIF
				CFLAG:402 = 4
		;デート経験有り
		ELSEIF EXP:94 > 0 && (CFLAG:402 < 3 || FLAG:7 == 2)
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「ふふっ、貴方の話って、なかなか面白いわね」
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「冬眠するのはどうして、ですって？」
					PRINTFORMW 「結界の維持は大変なの。たまには休む時期があってもいいんじゃないかしら？」
				ELSE
					PRINTFORMW 「ふあぁ……あら、ごめんなさい」
					PRINTFORMW 「結界の維持って、結構大変なのよ」
				ENDIF
			ENDIF
				CFLAG:402 = 3
		;それ以外
		ELSEIF CFLAG:402 < 2 || FLAG:7 == 2
			;大成功
			IF TFLAG:18 == 1
				PRINTFORMW 「ふふっ、面白いお話ね。続きを聞かせて」
			;失敗
			ELSEIF TFLAG:18 == -1
				PRINTFORMW 「……つまんない」
				PRINTFORMW 紫は顔を顰めながら、%CALLNAME:MASTER%に言った
			;それ以外
			ELSE
				IF RAND:2 == 0
					PRINTFORMW 「あら、普段は畑仕事を？　大変ですわねぇ」
					PRINTFORMW 抑揚もなく、本心なのか分からない返事が帰ってきた
				ELSE
					PRINTFORMW 「ずずっ……さ、お話を続けて」
					PRINTFORMW 紫は茶を啜りながら、%CALLNAME:MASTER%の話に耳を傾けた
				ENDIF
			ENDIF
				CFLAG:402 = 2
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;プレゼント（スマイル） CFLAG:403
;プレゼント（服） CFLAG:404
;振袖 CFLAG:405
;浴衣 CFLAG:406
;水着 CFLAG:407
;メイド服 CFLAG:408
;割烹着 CFLAG:409
;バスローブ CFLAG:410
;もんぺ CFLAG:411
;ウェディングドレス CFLAG:412
;プレゼント（それ以外） CFLAG:416
;-------------------------------------------------
IF SELECTCOM == 302
	;スマイルをプレゼント
	IF TFLAG:17 == 0
		;初めて
		IF CFLAG:403 == 0
			PRINTFORMW 「ふふっ、どうかしたの？」
			PRINTFORMW %CALLNAME:MASTER%が微笑みかけると、気味の悪い笑みが帰ってきた
			CFLAG:403 = 1
		;二回目以降
		ELSE
			;恋慕
			IF TALENT:85 == 1 && (CFLAG:403 < 6 || FLAG:7 == 2)
				;大成功
				IF TFLAG:18 == 1
					PRINTFORMW 「貴方の笑顔が見れる事、それが私にとっての幸せよ」
				;それ以外
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「あぁ……貴方が微笑むだけで、胸が熱くなるわ……」
					ELSE
						PRINTFORMW %CALLNAME:MASTER%が微笑むと、紫は恥ずかしそうに顔を背けた
						PRINTFORMW 赤くなった顔を見られたくないようだ
						PRINTFORMW 「だ、だって、こんな顔見せられないわ」
					ENDIF
				ENDIF
					CFLAG:403 = 6
			;恋人
			ELSEIF TALENT:153 == 1 && (CFLAG:403 < 5 || FLAG:7 == 2)
				;大成功
				IF TFLAG:18 == 1
					PRINTFORMW 「貴方の笑顔を見てると、安らかな気持ちになれるの……」
					PRINTFORMW 「ねぇ、もっと近くで見せて……」
				;それ以外
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「貴方の笑顔を見てると、私も嬉しいわ」
						PRINTFORMW （この笑顔がずっと続くように、私も頑張らないと）
					ELSE
						PRINTFORMW 「ふふっ、大好きよ、貴方の事……」
						PRINTFORMW 紫は頬を赤らめながら、%CALLNAME:MASTER%の手に指を絡ませた
					ENDIF
				ENDIF
					CFLAG:403 = 5
			;キス経験有り
			ELSEIF EXP:96 > 0 && (CFLAG:403 < 4 || FLAG:7 == 2)
				;大成功
				IF TFLAG:18 == 1
					PRINTFORMW 「あらあら、私と一緒にいるのが、そんなに嬉しいかしら？」
				;それ以外
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「異変が解決したら、笑顔が増えるかしら？」
						PRINTFORMW 「勿論、貴方の笑顔は増えるわよね？」
					ELSE
						PRINTFORMW 「ふふっ、信頼出来るパートナーがいるって、いいわね」
						PRINTFORMW 「藍？　式は道具よ」
					ENDIF
				ENDIF
					CFLAG:403 = 4
			;デート経験有り
			ELSEIF EXP:94 > 0 && (CFLAG:403 < 3 || FLAG:7 == 2)
				;大成功
				IF TFLAG:18 == 1
					PRINTFORMW 「いい笑顔ね」
					PRINTFORMW 「そうだ、次のデートはいつにする？」
				;それ以外
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「誰であっても、笑顔が見れるっていいわね」
					ELSE
						PRINTFORMW 「ふふっ、何かいい事でもあったの？」
					ENDIF
				ENDIF
					CFLAG:403 = 3
			;それ以外
			ELSEIF CFLAG:403 < 2 || FLAG:7 == 2
				;大成功
				IF TFLAG:18 == 1
					PRINTFORMW 「元気そうね、その顔だと」
					PRINTFORMW 「これなら馬車馬みたいに使っても大丈夫ね」
				;失敗
				ELSEIF TFLAG:18 == -1
					PRINTFORMW 「どうかしたの？　急に笑うなんて……」
				;それ以外
				ELSE
					IF RAND:2 == 0
						PRINTFORMW 「あら、何か面白い事でもあったのかしら？」
						PRINTFORMW 紫は表情を変えずに、さらりと言い放った
					ELSE
						PRINTFORMW 「急に笑うなんて……ふふっ、何か思い出したのかしら？」
					ENDIF
				ENDIF
					CFLAG:403 = 2
			ENDIF
		ENDIF
	;服をプレゼント
	ELSEIF TFLAG:17 == 4
		;初めて
		IF CFLAG:404 == 0
			PRINTFORMW 「あら、服をプレゼントしてくれるの？　ふ～ん……」
			PRINTFORMW 「ぴったりねぇ、スリーサイズを教えた事がないのに……」
			CFLAG:404 = 1
		;二回目以降
		ELSEIF CFLAG:404 < 2 || FLAG:7 == 2
			;振袖（春・冬限定）
			IF (DAY:2 == 0 || DAY:2 == 3) && RAND:3 == 0 && CFLAG:405 == 0
				PRINTFORMW 「あっ、振袖ね」
				PRINTFORMW 「ふふっ、今度着てあげるわ」
				CFLAG:405 = 1
			;浴衣（夏限定）
			ELSEIF DAY:2 == 1 && RAND:3 == 0 && CFLAG:406 == 0
				PRINTFORMW 「あら、浴衣ね」
				PRINTFORMW 「花火大会なんかには、これを着ていきたいわね」
				CFLAG:406 = 1
			;水着（夏限定）
			ELSEIF DAY:2 == 1 && RAND:3 == 0 && CFLAG:407 == 0
				PRINTFORMW 「水着ね、う～ん……」
				PRINTFORMW 「もう少し露出が多くても良かったわね」
				CFLAG:407 = 1
			;メイド服
			ELSEIF RAND:3 == 0 && CFLAG:408 == 0
				PRINTFORMW 「メイド服よね、これって……」
