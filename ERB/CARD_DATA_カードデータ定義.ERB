;--------------------------------------------------
; @CARD_GET_CHARPOOL ARG:0=キャラNo ARG:1=最小レア度
; そのキャラの指定レア度以上のカードIDリストを
; LOCAL:0-N に格納して LOCAL:9 に件数を返す
;--------------------------------------------------
@CARD_GET_CHARPOOL
LOCAL:9 = 0
FOR LOCAL:8, 0, 1637
	CALL CARD_GET_DATA, LOCAL:8 + 1
	IF RESULT:0 == ARG:0 && RESULT:1 >= ARG:1
		LOCAL:LOCAL:9 = LOCAL:8 + 1
		LOCAL:9 += 1
	ENDIF
NEXT
RETURN LOCAL:9

