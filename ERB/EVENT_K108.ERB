	F += 2
;服脱がせ失敗あり
SIF CFLAG:225 > 0
	F += 2
;合意のみ(恋慕または恋人)なしまたは反発感情ありで服を2回以上脱がせた
SIF CFLAG:226 % 8 > 1
	F += 1
;恋慕かつ主人のセックスによる処女喪失だが反発感情がついた
IF (CFLAG:351 & 1p1)
	F += 1
;恋慕でない状態で指挿入れではない処女喪失
ELSEIF (CFLAG:351 & 1p2)
	F += 3
ENDIF
;反発感情履歴あり
SIF MARK:4
	F += MARK:4
;苦痛依存
SIF MARK:0
	F += MARK:0
	
IF F > 7
	RETURN 1
ELSE
	RETURN 0
ENDIF

