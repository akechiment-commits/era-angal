;キャラの中から特定の素質（今回は貞操観念or保守的）を持ったキャラ1人をピックアップする関数
;Bにピックアップしたキャラの登録番号を入れる
;別に変数を用意してTALENT指定に使えば、使いまわしも可能
;不在であればB == 0を返す
@DAILY_LIFE_C
B = 0
C = 0
D = 0

;C群の変数をクリアする
REPEAT 100
	C:COUNT = 0
REND

;キャラ登録数が2以下であれば0を返す
IF CHARANUM <= 2
	RETURN 1
ELSE
	REPEAT CHARANUM
		;COUNT == 0 はMASTERの分
		IF COUNT == 0
			CONTINUE
		ELSE
			;別れてるキャラはピックアップしない
			SIF CFLAG:COUNT:21
				CONTINUE
			;登録番号がCOUNTのキャラが保守的もしくは貞操観念を持っていた時 
			IF TALENT:COUNT:24 || TALENT:COUNT:30
				;C:Dにキャラ登録番号を保存する
				C:D = COUNT
				;Dを1増やす
				D += 1
			ENDIF
		ENDIF
	REND
ENDIF

;この時点で変数C群に素質持ちキャラの登録番号が保存されている
;Dには登録番号を保存した回数が保存されている
;D == 0であればB == 0を返す・別れフラグが立っている時はやり直し
$REPLAY4
IF D == 0
	RETURN 1
;その他の時BにC群からランダムで選んだキャラ登録番号を入れる
ELSE
	R = RAND:D
	B = C:R
ENDIF

;A == B で　D == 1の時、B == 0 を返す
IF A == B && D == 1
	B = 0
	RETURN 1
;D >= 2でA == B の時、やり直す
ELSEIF A == B
	GOTO REPLAY4
ENDIF
RETURN 1

