	IF GETCHARA(12) > -1
		IF TALENT:GETCHARA(12):111 == 0
			TALENT:GETCHARA(12):111 = 1
			TALENT:GETCHARA(12):112 = 0
		ENDIF
	ENDIF
ELSE
