;-------------------------------------------------
;eratohoJ用大型テンプレート初心者向け派生版 2010.03.11 v0.92
;-------------------------------------------------
;○○口上（キャラクターの名前を入れる、下にコンセプトなど一言あれば入れる）
;J用テンプレート・ロングVer.ゆーくしょん未使用型α
;
;このテンプレート製作にあたり、J用霊夢口上、J用魔理沙口上、J用リグル口上、J用にとり口上、J用お燐口上
;eraSQ用ホワイトラビット口上等、様々な口上を参考にさせて頂きました。
;素晴らしき先行者達に感謝します！
;
;以下のCFLAGは他の口上より頂きました。
;CFLAG256 野外ライブ(さとり口上よりコメント文と使用フラグを拝借)
;
;CFLAG363 泡踊りで射精(火焔猫 燐口上より)
;CFLAG366 素股射精(霊夢口上より)
;
;このテンプレートの独自の使用CFLAGです。
;CFLAG247 デート中に向こうからプレゼント
;CFLAG257 ストリートライブ(クンニ強制と被った為、退避)
;
;CFLAG326 ステージ攻略開始 
;CFLAG327 道中攻略中断（撤退) 
;CFLAG328 ボス戦などから撤退するときに失敗してパートナーを庇う
;
;CFLAG364 シックスナイン射精
;
;CFLAG367 足コキ射精
;CFLAG368 挿入Gスポット
;CFLAG369 挿入子宮口
;CFLAG370 膣酒呑み
;CFLAG371 キスで射精
;CFLAG372 髪梳き
;CFLAG373 櫛で梳かす
;CFLAG374 初めて恥情がLv2を超えた
;CFLAG375 助手を犯すで射精
;CFLAG376 3P,Wフェラ等で助手が射精
;
;CFLAG493 クンニ強制(まとめパッチのCFLAG.txtとの摺り合わせ)
;
;CFLAG523 着衣指挿入れ
;CFLAG524 着衣Gスポ
;CFLAG525 セックス 
;CFLAG526 着衣後背位 
;CFLAG527 着衣騎乗位 
;CFLAG528 素材探し
;CFLAG529 調合
;
;CFLAG532 羽繕い
;CFLAG533 甘い言葉
;CFLAG534 賭博
;CFLAG535 指フェラ
;CFLAG536 足扱き
;CFLAG537 言葉責め
;CFLAG538 頭を撫でる
;CFLAG539 願掛け
;CFLAG540 炬燵にあたる開始
;CFLAG541 炬燵にあたる終了
;CFLAG542 炬燵使用中に船を漕ぐ
;CFLAG543 炬燵使用中に熟睡
;CFLAG544 お散歩する
;
;CFLAG613 コンドーム装着状態 1bit目(=1):主人装着中 2bit目(=2):助手装着中 3bit目(=4):相棒装着中 0だと無し
;-------------------------------------------------
;-------------------------------------------------
;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------
;-------------------------------------------------
;J用ぬえ口上 ver0.2

;eratohoJ用口上テンプレートを使用。
;J用口上テンプレートを元に数々のJ口上を参考に作成
;誰てめぇ分が含まれていますので注意をお願いします
;
;フラグ使用状況
;CFLAG:555 プレイヤーの呼び名を何にしたか(整数値で管理)（うにゅほさんから流用）
;CFLAG:611　子供の人数で使用
;CFLAG:613　をコンドーム判定で使用
;CFLAG:614～617　をおっぱい成長判定で使用
;CFLAG:618～619　挿入回数カウント(予定)　619はイベント発生
;CFLAG:620～622　をメイド服判定で使用
;CFLAG:635　は処女を主人に奪われたか判定で使用
;CFLAG:636　は処女喪失判定で使用
;今後はCFLAG:600～610はエクストラ構文・日常パートで使用する予定
;
;当口上固有で確保しておきたい文字列変数(うにゅほさんから流用)
;STR110    あなた用(レイセン)
;STR120    あなた用(ぬえ)（予定）
;-------------------------------------------------


;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:197 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:197 = 0

;--------------------------------------------------
;エキストラモード構文関数　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;--------------------------------------------------
@EXTRA_MODE_K97
DRAWLINE
PRINTL  
;体型について
PRINTFORML %CALLNAME:TARGET%は小柄？
$IL_BODYTYPE
PRINTFORML [0] 幼獣ぬえ。ロリっ娘でございます。
PRINTFORML [1] 封獣ぬえ。普通体型ですね
INPUT
SIF RESULT < 0 || RESULT > 1
	GOTO IL_BODYTYPE
IF RESULT == 0
	PRINTFORMW ―小柄体型で開始します―
	TALENT:100 = 1
ELSEIF RESULT == 1
	PRINTFORMW ―普通体型で開始します―
	TALENT:100 = 0
ENDIF
PRINTL  
;おっぱいチョイスのお時間です
PRINTFORML ぬえの胸は
$INPUT_LOOP_1
PRINTFORML [0] 豊乳ぬえ。ｦｯﾊﾟｲﾌﾟﾙﾝﾌﾟﾙﾝですよ。
PRINTFORML [1] 貧乳ぬえ。これから育てます。
PRINTFORML [2] 美乳ぬえ。程よい大きさです
INPUT
SIF RESULT < 0 || RESULT > 2
	GOTO INPUT_LOOP_1
IF RESULT == 0
	PRINTFORMW ―巨乳モードで開始します―
	TALENT:109 = 0
	TALENT:110 = 1
ELSEIF RESULT == 1
	PRINTFORMW ―貧乳モードで開始します―
	TALENT:109 = 1
	TALENT:110 = 0
ELSEIF RESULT == 2
	PRINTFORMW ―普乳モードで開始します―
	TALENT:109 = 0
	TALENT:110 = 0
ENDIF
PRINTL 
PRINTFORML ぬえと仲の良いキャラクターを追加しても構いませんか？
$IL_EXTRAMODE_ABLCHG
PRINTFORML [0] 二次創作はあまり好まん！(デフォルト)
PRINTFORML [1] 構わん、やれ
INPUT
SIF RESULT < 0 || RESULT > 1
	GOTO IL_EXTRAMODE_ABLCHG
IF RESULT == 0
	PRINTFORMW 追加要素はオミットいたします
ELSEIF RESULT == 1
	PRINTFORMW 仲の良いキャラクターを追加します
	;相性の変更
	;巫女・魔女はキャラ設定.txtを見たら結構懐いていたので若干追加
	RELATION:TARGET:11  = 120
	;ヤマメやパルパルとは仲よさそうなの
	RELATION:TARGET:78  = 100
	RELATION:TARGET:79  = 100
	;地霊殿メンバーとは仲よさそう
	RELATION:TARGET:77  = 70
	RELATION:TARGET:80  = 65
	RELATION:TARGET:81  = 70
	RELATION:TARGET:82  = 70
	RELATION:TARGET:83  = 70
	RELATION:TARGET:84  = 120
	;これも鉄板
	RELATION:TARGET:84  = 120
ENDIF
DRAWLINE
CFLAG:220 |= 1

