;-------------------------------------------------
;J用勇儀口上（キャラクターの名前を入れる、下にコンセプトなど一言あれば入れる）
;竹を割ったような性格の姉御をイメージ、でもウフフなことには耐性がなかったりするので処女パターンがあるのは至極当然
;芸が無いといわれようとも、私のキャラはいつでも純情ACTION
;-------------------------------------------------

;-------------------------------------------------
;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------

;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:180 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:180 = 0

;--------------------------------------------------
;同定構文
;--------------------------------------------------
;口上の存在を返す
@KOJO_K80(ARG)
RETURN 1

;口上IDを返す(IDは8桁[A-Z+0-9])
@KOJO_K80_IDENTIFY
RESULTS = D0312INS
RETURN 1

;口上名称を返す
@KOJO_K80_NAME
RESULTS = J用勇儀口上
RETURN 1

;--------------------------------------------------
;純愛イベント口上　 CFLAG221
;--------------------------------------------------
@KOJO_JUN_K80
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;細かい調整は後に回すとしてとりあえず処女化
;姉御なのに処女、処女なのに姉御
;そのギャップを表現していければなぁと
;-------------------------------------------------
IF TFLAG:600 == 0 && CFLAG:220 == 0
	PRINTL 処女モードに移行しますか？
	PRINTL [0] はい
	PRINTL [1] いいえ
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―処女モードに素質、能力を変更します―
		TALENT:TARGET:0 = 1
		TALENT:TARGET:31 = 0
		TALENT:TARGET:36 = 0
		ABL:TARGET:4 = 0
		EXP:TARGET:0 = 0
	ELSEIF RESULT == 1
		PRINTFORMW ―通常モードで調教を開始します―
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:220 = 1
ENDIF

