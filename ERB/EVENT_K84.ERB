;-------------------------------------------------
;自動喘ぎ生成関数
;輝夜口上から案をいただきました
;正確には大元はぱんくしょんみたいですが
;-------------------------------------------------
@K84_AUTO_AEGI

;喘ぎ回数 = 感度LV + 調教者の技巧LV/2 + (0, 1, 2) + 1
;ただしK = 0(感度が1以下だったり弱点ではなかったり)の場合は無効
IF K >= 2
	K += + (ABL:MASTER:2 / 2) + RAND:3 + 1
ELSE
	K = 0
ENDIF

IF K > 0
	PRINTFORM 「

	;喘ぐ内容
	REPEAT K
		;例えば技巧10+感度5あれば2回位で絶頂しますよね
		;さすがに技巧18で感度1はやる人は少なさそうですし
		IF K >= 10
			L = RAND:14
		ELSE
			L = RAND:12
		ENDIF
		
		IF L == 13
			PRINTFORM い、イッちゃうぅ！　
		ELSEIF L == 12
			PRINTFORM い…イク…
		ELSEIF L == 11
			PRINTFORM や…あ…
		ELSEIF L == 10
			PRINTFORM あ…
		ELSEIF L == 9
			PRINTFORM あんっ！　
		ELSEIF L == 8
			PRINTFORM く…うぅ…
		ELSEIF L == 7
			PRINTFORM はぁ…
		ELSEIF L == 6
			PRINTFORM はあっ！　
		ELSEIF L == 5
			PRINTFORM ひゃあっ！　
		ELSEIF L == 4
			PRINTFORM ひゃっ！
		ELSEIF L == 3
			PRINTFORM ふああっ！　
		ELSEIF L == 2
			PRINTFORM ふあんっ！　
		ELSEIF L == 1
			PRINTFORM ふ…ぁ…
		ELSE
			PRINTFORM …んぁ…
		ENDIF
	REND

	PRINTFORMW 」
ENDIF

