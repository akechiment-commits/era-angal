;--------------------------------------------------
;--------------------------------------------------
;素質検索関数
;--------------------------------------------------
;Oに探したいキャラ番号、Pに探したい素質を入力する
;素質があればQ = 2、素質はないけどキャラはいればQ = 1
;キャラ自体いなければQ = 0の値を返す
;--------------------------------------------------
@K84_TALENTSEARCH
Q = 0
REPEAT CHARANUM
	;登録番号COUNTに探したいキャラがヒット
	IF NO:COUNT == NO:O
		Q = 1
		;探している素質がある
		SIF TALENT:COUNT:P == 1
			Q = 2
	ENDIF
REND

