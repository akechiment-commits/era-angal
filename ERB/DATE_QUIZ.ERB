; 解答関数
@QUIZ_QUESTION_ANSWER

	; ユーザーの解答を取得
	INPUT
	C = RESULT

	;クイズ解答（V：正解番号）
	IF C == V
		PRINTFORMW 正解です！
		;正解数+1
		P += 1
	ELSE
		PRINTFORMW この⑨が！
	ENDIF

	; リターン
	RETURN 0


; クイズコア
@SAKUYA_QUIZ

	A = 0
	Q = 0
	; 正解スコアを初期化
	P = 0

	; 問題数・出題数を取得
	CALL QUIZ_QUESTION_NUMBER
	IF RESULT != 0
		; ジャンルコードの異常を報告（non-zero）
		RETURN -1
	ENDIF

	; 問題数・出題数をセット
	L:0 = S
	V = T

	; 問題番号リスト生成（出題数分だけループ）
	U = COUNT
	REPEAT L:0
		$QUESTION_NUMBER_CHECK_LOOP_OUT
			; 模擬乱数取得
			S = RAND:V

			; 重複チェックループ（Tがループ変数）
			T = 1
			$QUESTION_NUMBER_CHECK_LOOP_IN
				; チェック範囲か？
				IF T <= COUNT
					; 既に存在する番号か？
					SIF L:T == S
						GOTO QUESTION_NUMBER_CHECK_LOOP_OUT

					; 次のチェックへ進む
					T += 1
					GOTO QUESTION_NUMBER_CHECK_LOOP_IN
				ENDIF
			; END OF $QUESTION_NUMBER_CHECK_LOOP_IN
		; END OF $QUESTION_NUMBER_CHECK_LOOP_OUT

		; 決定した重複していない問題番号を代入
		T = COUNT+1
		L:T = S
	REND
	COUNT = U

	; 出題ループ（独立性確保のためにラベルによるループ）
	T = 1
	$QUIZ_QUESTION_LOOP
	IF T <= L:0
		; 汎用変数Uを引数（問題番号）としてQUIZ_QUESTIONを呼び出す
		U = L:T
		CALL QUIZ_QUESTION

		; ループ
		T += 1
		GOTO QUIZ_QUESTION_LOOP
	ENDIF
	; END OF QUIZ_QUESTION_LOOP

	RETURN 0
