;デートイベントにおけるクイズゲームの関数（クイズのジャンルはCFLAG:720で判定）
;--------------------------------------------------------

; 問題数取得関数（そのジャンルについて、Tに問題数、Sに出題数をセット）
@QUIZ_QUESTION_NUMBER

	;ジャンル分岐
	;（あんガル：東方クイズは使用しないため一般クイズにリダイレクト）
	SIF CFLAG:720 == 1
		CFLAG:720 = 2
	IF CFLAG:720 == 1
		; 東方クイズ（あんガル未使用）
		T = 141
		S = 10
	ELSEIF CFLAG:720 == 2
		; 一般クイズ
		T = 50
		S = 10
	ELSEIF CFLAG:720 == 3
		; 雑学クイズ
		T = 50
		S = 10
	ELSE
		; 異常なジャンルコード（non-zero）
		RETURN -1
	ENDIF

	; 異常値を強制補正
	SIF S > T
		S = T

	; リターン（zero）
	RETURN 0

; 出題関数（Uは問題番号、Tは第何問目か、L:0は出題数をあらわす）
@QUIZ_QUESTION
	PRINTFORML 第{T}問目（全{L:0}問中）

	; 問題文を表示
	CALL QUIZ_QUESTION_TEXT

	; 汎用変数Vの破壊禁止域

	; 解答文を表示
	SIF (U < 80 && CFLAG:720 == 1) || (U < 50 && CFLAG:720 != 1)
		CALL QUIZ_QUESTION_ANSWER

	; リターン
	RETURN 0

