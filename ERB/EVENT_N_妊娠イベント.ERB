EXP:C:61 += 1
PRINTW 出産経験＋１

;-------------------------------------------------
; 子宝コレクション記録（母C × 父E のペアを記録）
;   CFLAG:母:(2000 + 父のNO) に出産人数を累積
;   新規ペア発見でキミサキダイヤ(FLAG:15000)を付与
;-------------------------------------------------
IF E >= 0 && E < CHARANUM
	IF CFLAG:C:(2000 + NO:E) == 0
		;初めての組み合わせ
		FLAG:15000 += 3
		PRINTFORMW ＜新しい子宝の組み合わせを記録！　キミサキダイヤ＋３＞
	ENDIF
	CFLAG:C:(2000 + NO:E) += 1
ELSE
	;父親不明（裏カジノの男たち等）
	CFLAG:C:2099 += 1
ENDIF
;初めての出産で子宝図鑑を解放
FLAG:15031 = 1

;母乳出るようになる(妊娠時から移動)
;旧セーブ等で未記録の場合は、付与前の状態から記録
CALL RECORD_PRE_CARE_MILK, C
IF TALENT:C:130 == 0	; 【C:[母乳体質]なし】
	PRINTFORMW %CALLNAME:C%は母乳が出るようになった
	PRINTFORMW 　
	TALENT:C:130 = 1
	CALL BUST_ADJUST, C, (RAND:31 + 30)
ENDIF

;妊娠時に減った体力の最大値が回復
MAXBASE:C:0 += 500

;産まれた時点で育児室フラグを寝かせる
MARK:C:90 = 0
CALL RESET_FLAG_N_FORCE

;COUNTを戻す
COUNT = C

;---------------------------------------------------------
;赤ん坊の養育選択
;---------------------------------------------------------
@SELECT_NURSE, ARG = -1
#DIM NURSE_ID
PRINTFORMW %CALLNAME:MASTER%は赤ん坊の養育を他の者に任せることにした
PRINTW 
PRINTL 誰に任せますか？
REPEAT CHARANUM
	;現在[妊娠]状態でなく、[育児中]か[母性]持ちのキャラを羅列
	IF CAN_NURSE(COUNT, ARG)
		PRINTFORML [{COUNT,2}]%NAME:COUNT,16,LEFT% 
	ENDIF
REND
IF CHARANUM <= 100
	PRINTFORML [100]里子に出す
ELSE
	PRINTFORML [1000][-1]里子に出す
ENDIF

$INPUT_LOOP
INPUT
IF RESULT == -1 || RESULT == 1000 || (CHARANUM <= 100 && RESULT == 100)
	PRINTFORMW %CALLNAME:MASTER%はやむなく、赤ん坊を里子に出しました……
	RETURN 0
ELSEIF RESULT < 0 || RESULT >= CHARANUM
	GOTO INPUT_LOOP
ELSEIF CAN_NURSE(RESULT, ARG) == 0
	GOTO INPUT_LOOP
ENDIF
NURSE_ID = RESULT
PRINTFORMW %CALLNAME:MASTER%は%CALLNAME:NURSE_ID%に乳母をやってもらうことにしました
;新たに養育を始める場合のみ元の母乳体質を記録
SIF TALENT:NURSE_ID:135 == 0
	CALL RECORD_PRE_CARE_MILK, NURSE_ID
;育児期間を設定する
CFLAG:NURSE_ID:110 = DAY:7
MARK:NURSE_ID:90 = 1
;回復遅いをつける(回復早いは一時的に消す)
;CFLAG:NURSE_ID:96に回復遅い消去フラグを記録
IF TALENT:NURSE_ID:135
	;既に養育中なら、最初に記録した回復素質を保持
ELSEIF TALENT:NURSE_ID:111
	CFLAG:NURSE_ID:96 = 1
ELSEIF TALENT:NURSE_ID:112
	CFLAG:NURSE_ID:96 = 2
ELSE
	CFLAG:NURSE_ID:96 = 0
ENDIF
IF TALENT:NURSE_ID:112 == 0
	PRINTFORMW %CALLNAME:NURSE_ID%は[%TALENTNAME:112%]を得た
	TALENT:NURSE_ID:111 = 0
	TALENT:NURSE_ID:112 = 1
ENDIF
IF TALENT:NURSE_ID:135 == 0
	TALENT:NURSE_ID:135 = 1
	CFLAG:NURSE_ID:13 = 0
ENDIF
RETURN 1

;養育先の適性。記憶を消した本人・別れ中のキャラは除外する
@CAN_NURSE(ARG, ARG:1)
#FUNCTION
SIF ARG < 0 || ARG >= CHARANUM
	RETURNF 0
	SIF ARG == MASTER || ARG == ARG:1 || CFLAG:ARG:21 || TALENT:ARG:134
	RETURNF 0
RETURNF TALENT:ARG:135 || TALENT:ARG:136

;記憶消去後は本人の育児を終了し、子供の養育先を選択する
@MEMORY_DRUG_END_CARE, ARG
;臨月の育児室フラグは妊娠の身体状態なので残す
SIF TALENT:ARG:134
	RETURN 0
SIF TALENT:ARG:135 == 0 && MARK:ARG:90 == 0
	RETURN 0
LOCAL:0 = ARG
PRINTFORMW %CALLNAME:ARG%は子供との記憶も失い、育児を続けられなくなった
;回復素質は育児開始前に戻す。身体のサイズと母乳体質は消さない
IF TALENT:ARG:135
	TALENT:ARG:111 = (CFLAG:ARG:96 == 1)
	TALENT:ARG:112 = (CFLAG:ARG:96 == 2)
ENDIF
CFLAG:ARG:96 = 0
CFLAG:ARG:1284 = 0
TALENT:ARG:135 = 0
MARK:ARG:90 = 0
CALL SELECT_NURSE, LOCAL:0
RETURN 0

;---------------------------------------------------------
;育児室
;---------------------------------------------------------
@CHILD_CARE_ROOM
PRINTL どの部屋へ様子を見に行きますか？

REPEAT CHARANUM
	;現在臨月か[育児中]のキャラを羅列
	IF MARK:COUNT:90 || TALENT:COUNT:135	; 【COUNT:[育児中]】
		PRINTFORML [{COUNT,2}]%NAME:COUNT,16,LEFT% 
	ENDIF
REND
PRINTFORML [100]戻る

$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT < 0 || RESULT >= CHARANUM
	GOTO INPUT_LOOP
ELSEIF MARK:RESULT:90 == 0 && TALENT:RESULT:135 == 0	; 【RESULT:[育児中]なし】
	GOTO INPUT_LOOP
ENDIF

;主人公妊娠で主人公の様子を見に行く場合、出産後のみ
IF RESULT == MASTER
	T = CFLAG:MASTER:111
	CALL GET_EXISTANCE
	E = E-1
	
	;父親恋慕
	IF TALENT:E:85	; 【E:[恋慕]】
		IF TIME == 0
			PRINTFORMW %CALLNAME:MASTER%と%CALLNAME:E%は親子水入らずの時間を楽しんだ
		ELSE
			PRINTFORM %CALLNAME:MASTER%は%CALLNAME:E%と二人で子供のかわいい寝顔をのぞき込み、
			PRINTW そして、どちらからというわけでもなく顔を見合わせ、ほころばせていた
		ENDIF
	;それ以外
	ELSE
		PRINTFORMW %CALLNAME:MASTER%は子供のかわいい寝顔をのぞき込み、顔をほころばせていた
	ENDIF
	RETURN 0
ENDIF


PRINTFORML %CALLNAME:MASTER%は%CALLNAME:RESULT%のところへ向かった……
PRINTW 

;育児室での口上をイベント口上でやってみるのはいいとして分岐どうしよう…
;基本的には口上側で分岐してもらう方向で
LOCAL:101 = PLAYER
PLAYER = MASTER
Z = TARGET
TARGET = RESULT
;臨月(まだ出産前)か育児中(出産後)かで口上を分岐する
IF TALENT:TARGET:134	; 【TARGET:[妊娠]】
	TFLAG:13 = 25
ELSE
	TFLAG:13 = 23
ENDIF
CALL SELF_KOJO
TARGET = Z
PLAYER = LOCAL:101

;地の文章カット
IF (CFLAG:99 & 1) == 0	; 【[地の文カットフラグ]】
	;まだ出産前の場合
	IF TALENT:TARGET:134	; 【TARGET:[妊娠]】
		;[恋慕]あり
		IF TALENT:TARGET:85	; 【TARGET:[恋慕]】
			PRINTFORM %CALLNAME:TARGET%は%CALLNAME:MASTER%の顔を見ると、
			PRINTFORMW 元気づけられたように笑顔を向けてきた
			PRINTFORMW %CALLNAME:MASTER%はもうすぐ出産を迎える%CALLNAME:TARGET%を心の底から励ました
		;[恋慕]なし
		ELSE
			PRINTFORMW %CALLNAME:TARGET%は%CALLNAME:MASTER%を見ても特段の反応を示さなかった……
			PRINTFORMW %CALLNAME:MASTER%はこれも罰なのかもしれないと思いながら帰るほかなかった……
		ENDIF
	;[恋慕]ありで父親がMASTER
	ELSEIF TALENT:TARGET:85 && CFLAG:TARGET:111 == NO:MASTER	; 【TARGET:[恋慕] / TARGET:[父親]==NO:MASTER】
		IF TIME == 0
			PRINTFORM %CALLNAME:MASTER%が部屋に入ってきたことに気づくと、
			PRINTFORMW %CALLNAME:TARGET%は満面の笑顔で出迎えた
			PRINTFORMW %CALLNAME:MASTER%はそれからしばらくの間、親子水入らずの時間を楽しんだ
		ELSE
			PRINTFORM %CALLNAME:MASTER%が部屋に入ってくると、子供がちょうど寝付いたところらしく、
			PRINTFORMW %CALLNAME:TARGET%は音を立てないようにと仕草で伝えてきた
			PRINTFORM %CALLNAME:MASTER%は%CALLNAME:TARGET%と二人で子供のかわいい寝顔をのぞき込み、
			PRINTW そして、どちらからというわけでもなく顔を見合わせ、ほころばせていた
		ENDIF
	;父親不明（裏カジノ等）
	ELSEIF CFLAG:TARGET:111 == -1	; 【TARGET:[父親]】
		PRINTFORM %CALLNAME:MASTER%が部屋に入ってくると、
		PRINTFORMW %CALLNAME:TARGET%は我が子を抱きながら、誰のものとも知れぬ子を産んだ境遇に哀しい目を向けた……
	;[恋慕]ありで父親MASTER以外
	ELSEIF TALENT:TARGET:85	; 【TARGET:[恋慕]】
		PRINTFORM %CALLNAME:MASTER%が部屋に入ってくると、
		PRINTFORMW %CALLNAME:TARGET%は少しとまどいながらもそれを迎えた
		PRINTW それから、子供の様子を見ながら久しぶりに二人の会話を楽しんだ
	ENDIF
	
	PRINTW 
ENDIF
TARGET = Z
RETURN 1

;妊娠/養育前の母乳体質。0=旧セーブ等で不明、1=元は無し、2=元からあり
@RECORD_PRE_CARE_MILK, ARG
SIF CFLAG:ARG:1284 != 0
	RETURN 0
CFLAG:ARG:1284 = 1
SIF TALENT:ARG:130
	CFLAG:ARG:1284 = 2
RETURN 0

;育児で得た母乳体質だけを解除。元から/旧セーブで不明なら保持
@END_CARE_MILK, ARG
IF CFLAG:ARG:1284 == 1 && TALENT:ARG:130
	TALENT:ARG:130 = 0
	CALL BUST_ADJUST, ARG, -(RAND:31 + 30)
ENDIF
CFLAG:ARG:1284 = 0
RETURN 0

;---------------------------------------------------------
;親離れ
;---------------------------------------------------------
@DEPEARENT
C = COUNT
PRINTFORMW %CALLNAME:C%の育てていた子供が親離れしました

;子育て終了で母乳体質、回復遅い消失(元々持ってる場合は消失しない)

SIF TALENT:C:112 && CFLAG:C:96 != 2
	PRINTFORMW %CALLNAME:C%は[%TALENTNAME:112%]を失いました
SIF TALENT:C:130 && CFLAG:C:1284 == 1
	PRINTFORMW %CALLNAME:C%は[%TALENTNAME:130%]を失いました
TALENT:C:112 = 0
CALL END_CARE_MILK, C
;回復遅い系の素質復帰
IF CFLAG:C:96 == 1	; 【C:[回復素質記録]==1】
	;元々回復早い持ち
	TALENT:C:111 = 1
ELSEIF CFLAG:C:96 == 2	; 【C:[回復素質記録]==2】
	;元々回復遅い持ち
	TALENT:C:112 = 1
ENDIF
CFLAG:C:96 = 0

;育児中消失
TALENT:C:135 = 0
MARK:C:90 = 0
IF MARK:C:89 == 1
	PRINTFORMW %CALLNAME:C%の胸は母乳を与える役割を終えたことで小さくなりました
	;妊娠時に大きくなった胸のサイズを一段小さくする
	CALL REVERSE_B_SIZE
ENDIF
CALL RESET_FLAG_N_FORCE
COUNT = C

;親離れ時の口上をイベント口上でやってみるのはいいとして分岐どうしよう…
;基本的には口上側で分岐してもらう方向で
T = CFLAG:C:111
CALL GET_EXISTANCE
E = E-1
LOCAL:101 = PLAYER
IF E >= 0 && E < CHARANUM
	PLAYER = E
ELSE
	PLAYER = MASTER
ENDIF

TFLAG:13 = 22
Z = TARGET
TARGET = C
CALL SELF_KOJO
TARGET = Z
PLAYER = LOCAL:101

;---------------------------------------------------------
;妊娠パッチまわりのフラグをリセット
;---------------------------------------------------------
@CLEAR_FLAG
IF TARGET >= 0
	CFLAG:101 = 0
	CFLAG:102 = 0
	CFLAG:104 = 0
	CFLAG:105 = 0
	CFLAG:106 = 0
	CFLAG:107 = 0
	CFLAG:108 = 0
	TEQUIP:85 = 0
	TEQUIP:86 = 0
	TEQUIP:87 = 0
ENDIF
IF ASSI >= 0
	CFLAG:ASSI:101 = 0
	CFLAG:ASSI:103 = 0
	CFLAG:ASSI:104 = 0
	CFLAG:ASSI:105 = 0
	CFLAG:ASSI:106 = 0
	CFLAG:ASSI:107 = 0
	CFLAG:ASSI:108 = 0
	TEQUIP:ASSI:85 = 0
	TEQUIP:ASSI:86 = 0
	TEQUIP:ASSI:87 = 0
ENDIF
CFLAG:MASTER:102 = 0
CFLAG:MASTER:103 = 0
CFLAG:MASTER:104 = 0
CFLAG:MASTER:105 = 0
CFLAG:MASTER:106 = 0
CFLAG:MASTER:107 = 0
CFLAG:MASTER:108 = 0
TEQUIP:MASTER:85 = 0
TEQUIP:MASTER:86 = 0
TEQUIP:MASTER:87 = 0

;---------------------------------------------------------
;親離れ・妊娠消滅等時のフラグリセット
;---------------------------------------------------------
@RESET_FLAG_N_FORCE
FLAG:97 = 0
REPEAT CHARANUM
	;他にも対象キャラがいれば、フラグを再設定
	SIF MARK:COUNT:90 == 1 || TALENT:COUNT:135	; 【COUNT:[育児中]】
		FLAG:97 = 1
REND

;---------------------------------------------------------
;子育て終了or妊娠強制終了時の胸サイズの縮小処理
;---------------------------------------------------------
@REVERSE_B_SIZE
SIF MARK:C:89 == 0
	RETURN 0
;縮小後の素質は実サイズから自動更新する。
CALL BUST_ADJUST, C, -(RAND:51 + 40)

MARK:C:89 = 0


;==================================================
; 主人の不正な臨月・育児状態の修復処理
;==================================================
@FIX_MASTER_INVALID_PREGNANCY_STATE
; 主人が妊娠していないのに臨月/育児中になっている場合の救済
IF TALENT:MASTER:134 == 0
	IF MARK:MASTER:90 != 0 || TALENT:MASTER:135 != 0 || (TALENT:MASTER:112 != 0 && CFLAG:MASTER:96 != 2)
		MARK:MASTER:90 = 0
		TALENT:MASTER:135 = 0
		CFLAG:MASTER:110 = 0
		; 回復素質の復元（CFLAG:96に記録があれば復元、なければ回復遅いを消去）
		IF CFLAG:MASTER:96 == 1
			TALENT:MASTER:111 = 1
			TALENT:MASTER:112 = 0
		ELSEIF CFLAG:MASTER:96 != 2
			TALENT:MASTER:112 = 0
		ENDIF
		CFLAG:MASTER:96 = 0
		CFLAG:MASTER:1284 = 0
	ENDIF
ENDIF
