;---------------------------------------------------------
;中出しされた精子量に応じて確率処理
;チェックするフラグ設定
;CFLAG
;101→マスターによる中田氏カウント用
;102→助手による中田氏カウント用
;103→パートナーによる中田氏カウント用
;---------------------------------------------------------
@NAKADASHI_CHECK
;誰に中出しされたか設定(P=1～3)
F = 100 + P

;そもそも中だしされてないなら戻り
SIF CFLAG:T:F <= 0
	RETURN 0

;既に裏カジノ等で見知らぬ男たちによる妊娠が確定している場合は上書きしない
SIF CFLAG:T:104 == 99	; 【T:[種提供者]==99】
	RETURN 0

;危険日でも排卵誘発剤使用でもない場合: 蓄積量1ごとに0.1%加算
;（蓄積量1=0.1%, 10=1%, 100=10%）
IF TALENT:T:137 == 0 && TEQUIP:T:86 == 0	; 【T:[危険日]なし / 無[排卵誘発剤効果発揮中]】
	SIF RAND:1000 < CFLAG:T:F
		CFLAG:T:104 = P
	RETURN 0
ENDIF

;危険日と排卵誘発剤を別の確率補正として扱う。
;薬は周期に関係なく通常4/小柄6で100%。危険日と重なっても二重加算しない。
IF TEQUIP:T:86
	LOCAL = 4
	SIF TALENT:T:100
		LOCAL = 6
ELSE
	;薬なしの危険日: 通常16/小柄24で100%。
	LOCAL = 16
	SIF TALENT:T:100
		LOCAL = 24
ENDIF
X = MIN(CFLAG:T:F, LOCAL)
SIF RAND:LOCAL < X
	CFLAG:T:104 = P

;---------------------------------------------------------
;待機中動作専用の受精チェック関数
;普段の調教より低確率（危険日で約3%～5%、通常日は約0.3%～0.5%）に設定
;T: 判定対象キャラ, P: 種提供者フラグ(1～3), ARG: 行為回数(SまたはN)
;---------------------------------------------------------
@NAKADASHI_CHECK_TAIKI, ARG = 10
;避妊薬使用中なら受精不可
SIF TEQUIP:T:87
	RETURN 0
;既に妊娠確定済みなら戻り
SIF CFLAG:T:104
	RETURN 0

;排卵誘発剤使用中: 元仕様通り確実に妊娠
IF TEQUIP:T:86
	CFLAG:T:104 = P
	RETURN 0
ENDIF

SIF ARG <= 0
	ARG = 1

LOCAL = 0
;危険日: 100%確定を緩和し、通常日の約2.5～3倍（約10%～15%）に設定
IF TALENT:T:137
	LOCAL = 70 + (ARG * 13 / 10)
;通常日: 元仕様通り蓄積量1回につき0.1%加算（千分率: ARG/1000 = 約1.5%～6%）
ELSE
	LOCAL = ARG
ENDIF

;小柄体型補正（受胎率75%）
SIF TALENT:T:100
	LOCAL = LOCAL * 3 / 4

;千分率判定 (RAND:1000 < LOCAL)
SIF RAND:1000 < LOCAL
	CFLAG:T:104 = P

RETURN 0

