;---------------------------------------------------------
;部活素質の同期処理
;表現素質(55)→撮影素質(51)/歌唱素質(52)の互換コピー
;探索素質(53)＝(運動(54)+表現(55)+知識(56))/3 で動的算出
;---------------------------------------------------------

@SYNC_CLUB_ABL
;全キャラの部活素質を同期
REPEAT CHARANUM
	;表現素質→旧撮影素質・旧歌唱素質にコピー（互換性維持）
	ABL:COUNT:51 = ABL:COUNT:55
	ABL:COUNT:52 = ABL:COUNT:55
	;探索素質＝3素質の平均
	ABL:COUNT:53 = (ABL:COUNT:54 + ABL:COUNT:55 + ABL:COUNT:56) / 3
	;表現技能→旧撮影技能・旧歌唱技能にコピー
	ABL:COUNT:91 = ABL:COUNT:94
	ABL:COUNT:92 = ABL:COUNT:94
REND
;主人公も同期
ABL:MASTER:51 = ABL:MASTER:55
ABL:MASTER:52 = ABL:MASTER:55
ABL:MASTER:53 = (ABL:MASTER:54 + ABL:MASTER:55 + ABL:MASTER:56) / 3
ABL:MASTER:91 = ABL:MASTER:94
ABL:MASTER:92 = ABL:MASTER:94

RETURN 1
