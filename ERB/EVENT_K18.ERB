;TOHO☆DUNGEON ルナサ口上
;eratohoJ用ストーリー改変口上です。
;eratohoJのストーリーを無視しておりますので、出来れば新規データでプレイしてください。
;一年前は調教師(プレイヤー)の助手だったルナサ・プリズムリバー。
;平常時は対等に接しているけれど、慌てている時やウフフのときは昔の隷属関係に戻ってしまいます。
;-------------------------------------------------

;-------------------------------------------------
;この口上はeratohoJ用の口上テンプレートをお借りして作成されています。
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;各コマンド、純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;-------------------------------------------------
;-------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した場合は口上設定用の素質に変更できます
;-------------------------------------------------;
@EVENTSHOP
IF TARGET > 0
	IF NO:TARGET == 18 && CFLAG:220 == 0
		PRINTL ルナサのパラメータを変更しますか？
		PRINTL [0] はい　　(元奴隷モード -ある程度調教済みの状態から始まります)
		PRINTL [1] いいえ　(通常モード)
		$INPUT_LOOP
		INPUT
		IF RESULT == 0
			PRINTFORMW ―元奴隷ルナサに素質、能力を変更します―
			ABL:TARGET:0 = 3
			ABL:TARGET:1 = 3
			ABL:TARGET:2 = 3
			ABL:TARGET:3 = 2
			ABL:TARGET:4 = 2
			ABL:TARGET:6 = 2
			ABL:TARGET:8 = 1
			ABL:TARGET:14 = 2
			ABL:TARGET:89 = 1
			ABL:TARGET:90 = 2
			EXP:TARGET:0 = 40
			EXP:TARGET:10 = 10
			EXP:TARGET:11 = 10
			EXP:TARGET:21 = 16
			EXP:TARGET:22 = 10
			EXP:TARGET:90 = 40
		ELSEIF RESULT == 1
			PRINTFORMW ―通常モードで調教を開始します―
		ELSE
			GOTO INPUT_LOOP
		ENDIF
		CFLAG:220 = 1
	ENDIF
ENDIF
