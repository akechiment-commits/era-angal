@ALL_ACT_ABLE
;全キャラ指定中の待機中行動をできるか判定し、できなくなっている場合は何もさせないに変更
FOR A, 0, CHARANUM
	CALL SHOP_ACT_ABLE
	IF B:(CFLAG:A:13) == 0	; 【A:[待機中行動]】
		IF A != MASTER && BASE:A:0 <= 0	; 【A:[体力]<=0】
			CFLAG:A:13 = 2
		ELSE
			CFLAG:A:13 = 0
		ENDIF
