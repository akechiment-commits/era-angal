			FOR A, 0, CHARANUM
				;MASTERは変更できない
				SIF A == MASTER
					CONTINUE
				;U == 0の時（休憩中のキャラが表示されていない時）は休憩中のキャラの行動を変えない
				SIF U == 0 && CFLAG:A:16	; 【A:[非表示]】
					CONTINUE
				
