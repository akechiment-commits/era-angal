@ACTION_LIST
DRAWLINE
REPEAT CHARANUM
	;主人公は特別表示
	SIF COUNT == MASTER
		PRINTFORM                                     [ 0]デフォルト指示    
	;預かり中のキャラは非表示だと選べない
	SIF CFLAG:COUNT:16 == 1 && U == 0	; 【COUNT:[非表示]==1】
		CONTINUE
	;別れたキャラも選べない
	SIF CFLAG:COUNT:21	; 【COUNT:[別れ]】
		CONTINUE
	;臨月、育児中のキャラも選べない
	SIF FLAG:62 & 1 && (MARK:COUNT:90 == 1)
		CONTINUE
	IF COUNT != MASTER
		PRINT 体力
		A = BASE:COUNT:0
		SIF BASE:COUNT:0 < 0	; 【COUNT:[体力]<0】
			A = 0
		CALL PRINT_BAR_0, A, MAXBASE:COUNT:0, 16
		PRINTFORM ({BASE:COUNT:0,4}/{MAXBASE:COUNT:0,4})
		IF COUNT == TARGET
			PRINT  ☆
		ELSEIF COUNT == ASSI
			PRINT  ★
		ELSE
			PRINT  　
		ENDIF
		PRINTFORM [{COUNT,2}]%NAME:COUNT,16,LEFT%　
		;CALL ARRANGE_CHARANAME
	ENDIF

	CALL SHOP_ACT_NAME
	IF COUNT != MASTER && BASE:COUNT:0 <= 0	; 【COUNT:[体力]<=0】
		SETCOLOR 0xFF6666
		PRINTFORM 【療養中】
		RESETCOLOR
	ENDIF
	PRINTFORML （%TSTR:(CFLAG:COUNT:13)%）
REND
PRINTL 　　　　　　☆：パートナー　★：助手　を表しています

