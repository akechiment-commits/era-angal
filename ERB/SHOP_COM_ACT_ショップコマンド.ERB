SIF A != MASTER && (TALENT:A:201 == 0 && (ABL:A:0 >= 5 || CFLAG:A:2 >= 500 || TALENT:A:153) || ABL:A:0 >= 20)	; 【A:[特別な支配者]なし / A:[恋人] / A:[親密]Lv>=5 / A:[親密]Lv>=20 / A:[好感度]>=500】
