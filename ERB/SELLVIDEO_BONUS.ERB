@VIDEO_BONUS
;ボーナスは一律$1000　今後変化の可能性アリ
;タイトルは組み合わせ優先
IF A:3 == 0
	IF TFLAG:32 & 1
		STR:0 = 散潔性
	ELSEIF A:4 >= 8
		IF TALENT:134
			STR:0 = 臨月抄
			P += 1000
		ELSE
			STR:0 = 風膣録
			P += 1000
		ENDIF
	ELSEIF A:5 >= 8
		STR:0 = 肛魔狂
		P += 1000
	ELSEIF A:6 >= 8
		STR:0 = 乳々夢
		P += 1000
	ELSEIF A:7 >= 8
		STR:0 = 苛映束
		P += 1000
	ELSEIF A:8 >= 8
		STR:0 = 映夜ショー
		P += 1000
	ELSEIF A:9 >= 8
		STR:0 = 豆夢想
		P += 1000
	ELSE
		STR:0 = 恥令伝
	ENDIF
	
	IF ASSI > 0
		SIF ( TALENT:ASSI:85 || TALENT:ASSI:76 ) && ( TALENT:TARGET:85 || TALENT:TARGET:76 )
			CALL VIDEO_BONUS_XXYY
	ENDIF
	
	A:3 = 1
ENDIF

