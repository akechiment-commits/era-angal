;-------------------------------------------------
;告白成功 CFLAG481
;あたしは一途でしつこいぞっ！
;口上とは関係無いが痛みの森深部でハートマークつけて襲ってくる揺光は可愛い。しかし八咫やエン様だった場合は貞操の危機を感じる
;-------------------------------------------------
IF TFLAG:600 == 2
	PRINTL 
	PRINTW ・
	PRINTW ・
	PRINTW ・
	;相手から
	IF TFLAG:45
		PRINTFORMW 「んっと……あたしいっつもアンタに言いたい放題言ってるけど」
		PRINTFORMW 「嫌いってわけじゃ、ないから」
		PRINTFORMW 少しだけ言葉を選ぶようにしてリリーが続ける
		PRINTFORMW 「だから、その……いつまでか分かんないけど」
		PRINTFORMW 「アンタがよければ……付き合ってみても、いいわよ…？」
	;主人公から
	ELSE
		;前回コマンドがアナルほぐしで快Ａ9999以上
		IF PREVCOM == 410 && PALAM:2 >= 9999
			PRINTFORMW 「……いいけど、終わったら気が変わるかもよ？」
			PRINTFORMW 「あたし今、お尻のことしか考えらんないんだから……」
			PRINTFORMW 行為の続きを乞うようにリリーが体重を預けてくる――
		;素直を得てから告白した
		ELSEIF TALENT:13
			PRINTFORMW 告白の言葉を受けたリリーがジッとこちらを見つめている
			PRINTFORMW 怒っているのか呆れているのか悩んでいるのか、表情から読み取ることはできない
			PRINTFORML 心臓が止まりそうなほど痛々しい沈黙に堪えかね
			PRINTFORMW 笑って冗談にしようかと思い始めたその時、不意にリリーが口を開いた
			PRINTFORMW 「いいわよ、別に。アンタとも結構長いし」
			PRINTFORMW 「アンタは変態だけど別に嫌な奴じゃないしね」
			PRINTFORMW 返事は意外にもあっさりしたものであった
			PRINTFORMW 肩の力が抜け喉元で堰き止められた呼気が一気に吐き出される
			PRINTFORMW 「というか、あたしはもうそういう関係になってると思ってたんだけど……」
			PRINTFORMW 「まぁいいわ。良く言えましたってことにしたげるっ」
			PRINTFORMW そんなリリーの言葉は普段よりも少しだけ早口に感じられた――
		;素直を得る前に告白した
		ELSE
			;なにこの変態修正されないね
			PRINTFORMW 「じゃ、足舐めて」
			PRINTFORMW あっさり断られるかと思ったがそんなに素直でもないようだ
			PRINTFORMW 「流石にそれは出来ないわよね―― って、ちょ…っ！？」
			PRINTFORMW リリーの足から靴下を剥ぎ取り、親指を咥え込んでみせる
			PRINTFORMW そして戸惑うリリーに構わずたっぷりと口奉してやる
			PRINTFORMW 「やっ、ちょっとっ、駄目っ！ ストップぅーーっ！！」
			PRINTFORMW 「受けるっ、受けるからぁ…っ！！」
			PRINTFORMW いい悲鳴と共に承諾が貰えたのを確認し指から口を離す
			PRINTFORMW そしてあらためてリリーの足の甲にキスをした
			PRINTFORMW （うぅ、甘く見てた……コイツ筋金入りだわ……）
			CFLAG:481 = 1
		ENDIF
	ENDIF
	PRINTL 
ENDIF

