;-------------------------------------------------
;DAILY_LIFE_MESSAGE
;休憩口上の後に点線を挟んで表示される。どの口上のものを表示するかはランダム？
;とりあえず主体が分かるように冒頭に地の文を書くことと相手側には整合性とかを考えあまり喋らせないことを重視
;問題は休憩コマンドを使う人がJ+プレイヤーにいるのかということ……

;内容はあなぅーばっかりです。しかたないね。
;妹様口上の中の人から「死に分岐ありますよ」的なご指摘を受け修正……できなかったので修正までしてもらってしまいました。すごい！
;-------------------------------------------------
;休憩の共通地の文カット用関数
@DAILY_LIFE_MESSAGE_56(ARG)
;TARGETがリリーブラック(旧休憩口上がベース)
IF NO:TARGET == 56
	;恋慕＋妊娠(にんっしんっ)
	IF TALENT:85 && TALENT:134
		PRINTFORMW %CALLNAME:MASTER%は休息中のリリーブラックに手招きされた
		PRINTFORMW 「あ、お菓子取ってきて。あとお茶も。それから帯っ」
		PRINTFORMW 拒否する余地もなく半日扱き使われた……
		;孕ませた弱みである
	;それ以外
	ELSE
		PRINTFORMW 床に寝転がったリリーブラックが“蠢いて”いる
		PRINTFORMW 「伸びーっ、うにーっ、ふぬぅーーっ」
		PRINTFORMW 休息を取る%CALLNAME:MASTER%の視界の端で少女は珍妙な声を発し続けた……
		;身体動かすとき無意識に声出しちゃうタイプ……というネタだったがとても分かりにくい
	ENDIF
;TARGETがリリーブラックでない
ELSE
	;初期化
	VARSET LOCALS
	;J用Nitori口上を導入しており主人がにとりでなく仲間になっている
	RESULTS = 
	TRYCALL KOJO_K40_IDENTIFY
	SIF RESULTS == "91FANF98" && NO:PLAYER != 40 && GET_EXISTANCE3(40, 0)
		LOCALS += "0/"
	;eratohoJ+用因幡てゐ口上を導入しており主人がてゐでなく仲間になっている
	RESULTS = 
	TRYCALL KOJO_K27_IDENTIFY
	SIF RESULTS == "EUFWEA7Y" && NO:PLAYER != 27 && GET_EXISTANCE3(27, 0)
		LOCALS += "1/"

	;LOCALSが空でない（にとりとてゐのどちらかの条件を満たす）
	IF LOCALS != ""
		;ランダマイズ
		SELECTCASE AUTO_SPLIT_INT(LOCALS, "/", RAND:STRCOUNT(LOCALS, "/"))
		;にとり
		CASE 0
			;にとりが風邪引き中でない
			IF CFLAG:GETCHARA(40):278 == 0 || CFLAG:GETCHARA(40):278 == 4
				;恋慕で三日月アナルバイブ使用済。リリーブラックが尻穴狂い取得済。ランダム。
				IF TALENT:GETCHARA(40):85 && CFLAG:GETCHARA(40):463 >= 5 && TALENT:GETCHARA(56):77 && RAND:2
					PRINTFORMW 余暇中、リリーブラックはにとりと猥談に興じた……
					PRINTFORMW 「すっごい反り……自分で使ったことはあるの？」
					PRINTFORMW にとり手製の三日月型アナルバイブを見せられ、リリーは感嘆する
					PRINTFORMW 「あるんだー……このお尻にこんな凶暴なのがねぇ……」
					PRINTFORMW リリーに親父じみた手付きで尻を揉まれ、にとりは顔を赤らめ抵抗した……
				;それ以外
				ELSE
					PRINTFORMW 余暇中、リリーブラックはにとりと将棋に興じた……
					PRINTFORMW 「うーん、あたしじゃ駒が三倍はないと勝てそうにないわね」
					PRINTFORMW 「あったらあったで三倍取られて敵が三倍に増えるだけな気もするし」
				ENDIF
			;にとりが風邪引き中
			ELSE
				PRINTFORMW リリーブラックはにとりの看病をする%CALLNAME:MASTER%を見つめている
				PRINTFORMW 「代わろうか？ って言ってもいいんだけどさ」
				PRINTFORMW 「やっぱアンタが看病したほうが効果あると思うのよね。空気的に」
			ENDIF
		;てゐ
		CASE 1
			;恋慕状態での服プレゼントを一回以上。ランダム。
			IF CFLAG:GETCHARA(27):625 && RAND:2
				PRINTFORMW 余暇中、リリーブラックはてゐと雑談に興じた……
				PRINTFORMW 「へー、服とかプレゼントしてもらってるんだ」
				PRINTFORMW 「全部お尻んトコに穴が空いてるけど……そういうプレイ用？」
				;尻尾用なので着たままアナルセックスはちょっと難しそう
			;それ以外
			ELSE
				PRINTFORMW 余暇中、リリーブラックはてゐと閑談に興じた……
				PRINTFORMW 「賭博場とかはやっぱ出禁になるの？」
				PRINTFORMW 「それとも逆に優待されて囲われるとかなの…？」
				;幻想郷には博徒系キャラはあまりいませんね
			ENDIF
		ENDSELECT
	ENDIF
ENDIF

