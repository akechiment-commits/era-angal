;口上の存在を返す
@KOJO_K56(ARG)
;RESULTS = ""
RETURN 1

;口上IDを返す(IDは8桁[A-Z+0-9])
@KOJO_K56_IDENTIFY
RESULTS = H95L7UPT
RETURN 1

;口上名称を返す
@KOJO_K56_NAME
RESULTS = eratohoJ+用リリーブラック口上
RETURN 1

