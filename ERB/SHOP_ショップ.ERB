@CHANGE_TARGET
LOCAL = 0
$START
X = 0
REPEAT CHARANUM
	SIF CFLAG:COUNT:16 == 1
		X = 1
REND

IF TARGET >= 0
	PRINT 現在
	PRINTFORML %NAME:TARGET%をパートナーとしています
ENDIF
PRINTL 今回は誰をパートナーにしますか？
;変数Vは出産育児関連で使用
