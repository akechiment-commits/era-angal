	T = RESULT
	EXISTCSV T,0
	IF RESULT == 0
		PRINTFORML 止めてくださいってば。チートのバグ取りとかしなくて良いですって
		GOTO INPUT_LOOP_BOSS
	ENDIF
	CSVCALLNAME T, 0
	PRINTFORMW %RESULTS%をボスに設定しました。既に仲間にいる場合は、幻影との勝負になります
	FLAG:25 = T
ENDIF
RETURN 1

