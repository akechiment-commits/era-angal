PRINTL [500] 個別表示項目切替

$INPUT_LOOP
INPUT
IF RESULT == -1 || (CHARANUM <= 100 && RESULT == 100) || RESULT == 1000
	RETURN 0
ELSEIF RESULT == 200 && X == 1
	IF U == 0
		U = 1
		GOTO START
	ELSE
		U = 0
		GOTO START
	ENDIF
