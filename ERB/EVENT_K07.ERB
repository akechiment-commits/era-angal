			PRINTFORMW 「良いお酒ですね……」
			PRINTFORMW 「今日は良いお料理を作りますから、あとで楽しみましょう？」
		ENDIF
	;それ以外
	ELSE
		;スマイルをプレゼント
		IF TFLAG:17 == 0
			PRINTFORMW 「ふふ、どうなさいました？」
		;酒をプレゼント
		ELSEIF TFLAG:17 == 1
			PRINTFORMW 「お酒ですか……？」
