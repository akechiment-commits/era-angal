		TALENT:TARGET:27 = 1
		;献身的
		TALENT:TARGET:63 = 1
		;魅惑
		TALENT:TARGET:91 = 1
		;羽
		TALENT:TARGET:213 = 1
		;尻尾
		TALENT:TARGET:215 = 1
		ABL:TARGET:1 = 1
		ABL:TARGET:2 = 2
		ABL:TARGET:3 = 1
		ABL:TARGET:4 = 2
		ABL:TARGET:6 = 1
		ABL:TARGET:14 = 1
		EXP:TARGET:0 = 30
		EXP:TARGET:10 = 30
		EXP:TARGET:20 = 5
		EXP:TARGET:22 = 10
	ELSEIF RESULT == 1
		PRINTFORMW ―通常モードで開始します―
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:219 = 1
ENDIF

