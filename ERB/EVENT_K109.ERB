			PRINTFORMW 
			CFLAG:560 = 3
		;それ以外
		ELSEIF CFLAG:560 < 2 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:560 = 2
		ENDIF
	ENDIF
	RETURN 0
ENDIF

