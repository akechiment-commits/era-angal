	;初めて
	IF CFLAG:560 == 0
		;合意
		IF TALENT:152
			PRINTFORMW 
		ELSE
			PRINTFORMW 
		ENDIF
		CFLAG:560 = 1
	;二回目以降
	ELSE
		;恋慕+奉仕精神Lv5以上
		IF TALENT:85 && ABL:6 > 4 && (CFLAG:560 < 5 || FLAG:7 == 2)
			PRINTFORMW 
