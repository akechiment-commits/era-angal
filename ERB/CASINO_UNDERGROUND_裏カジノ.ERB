; VIPブラックジャック（超高レート・青天井ツケ勝負）
;-------------------------------------------------
@VIP_BLACK_JACK, ARG
#DIM BET_MONEY
#DIM P_SCORE
#DIM D_SCORE
#DIM P_CARD, 5
#DIM D_CARD, 5
#DIM P_CNT
#DIM D_CNT
#DIM DOUBLE_DOWN
#DIM LAST_LOSS

RESULT:1 = 0
LAST_LOSS = 0

$V_BJ_LOOP

IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET) && ARG <= 0
	PRINTL 
	SETCOLOR 0xFF5555
	PRINTFORML 支配人「おや、VIPチップをお持ちでないようですね」
	PRINTFORML 支配人「お連れのパートナー様ではツケの融資もできませんので、チップをご購入の上でお越しください」
	RESETCOLOR
	PRINTW カジノロビーに戻ります。
	RESULT:1 = 0
	RETURN ARG
ENDIF

; 破産ライン判定
IF (CFLAG:MASTER:785 >= 3000000 && MONEY + ARG * 10000 < CFLAG:MASTER:785) || (ARG <= 0 && MONEY <= 0 && CFLAG:MASTER:785 > 0)
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		PRINTL 
		SETCOLOR 0xFF2222
		PRINTFORML 支配人「お客様……未返済の借金が ${CFLAG:MASTER:785} ございますね。手持ちのチップも尽きたようです」
		PRINTFORML 支配人「担保価値のないパートナー様ですが、ツケの利息の代わりとして廃棄処分ステージに上がっていただきましょうか！」
		RESETCOLOR
		PRINTFORMW 黒服たちによって%CALLNAME:TARGET%がステージへと連行されていく……
		CALL UNDERGROUND_BANKRUPTCY_EVENT, ARG
		PRINTL 
		SETCOLOR 0xFF2222
		PRINTFORML 支配人「ステージは大盛況でしたが、当然ながら借金の帳消しにはなりませんよ。借金は必ず返していただきます」
		RESETCOLOR
		PRINTFORMW テーブルから締め出され、カジノロビーに戻されました……（未返済借金：${CFLAG:MASTER:785}）
		RESULT:1 = 0
		RETURN ARG
	ENDIF
	CALL UNDERGROUND_BANKRUPTCY_EVENT, ARG
	ARG = RESULT
	IF RESULT:1 == 1
		RETURN ARG
	ENDIF
	IF ARG <= 0 && MONEY <= 0
		RESULT:1 = 0
		RETURN ARG
	ENDIF
ENDIF

PRINTL
DRAWLINE
SETCOLOR 0xFF2222
PRINTL 【VIPハイステークス・ブラックジャック】（青天井ツケ勝負）
RESETCOLOR
PRINTFORML 　所持VIPチップ: {ARG}枚 (${ARG * 10000})　所持金: ${MONEY}　借金: ${CFLAG:MASTER:785}
PRINTL
PRINTL 賭け金を選択してください（チップ・所持金不足分は自動ツケ借金となります）:
PRINTL [1] レギュラーVIP ($100,000 / チップ10枚相当)
PRINTL [2] ハイステークス ($500,000 / チップ50枚相当)
PRINTL [3] エグゼクティブ ($2,000,000 / チップ200枚相当)
PRINTL [4] 青天井・破滅レート ($10,000,000 / チップ1000枚相当)
PRINTL [5] 自由金額入力 ($10,000～)
IF !IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
	PRINTL [6] 全財産オールイン（所持金全額 ＋ $1,000,000のツケ）
ENDIF
IF LAST_LOSS > 0
	SETCOLOR 0xFF4444
	PRINTFORML [7] ★デス・倍プッシュ★（前回の負け額の倍額: ${LAST_LOSS * 2} をツケ賭け！）
	RESETCOLOR
ENDIF
PRINTL [0] カジノロビーに戻る
INPUT
IF RESULT <= 0
	RETURN ARG
ELSEIF RESULT == 1
	BET_MONEY = 100000
ELSEIF RESULT == 2
	BET_MONEY = 500000
ELSEIF RESULT == 3
	BET_MONEY = 2000000
ELSEIF RESULT == 4
	BET_MONEY = 10000000
ELSEIF RESULT == 5
	PRINTL 賭け金（ドル）を入力してください:
	INPUT
	IF RESULT < 10000
		PRINTW 最低賭け金は$10,000です。
		GOTO V_BJ_LOOP
	ENDIF
	BET_MONEY = RESULT
ELSEIF RESULT == 6 && !IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
	BET_MONEY = MONEY + (ARG * 10000) + 1000000
ELSEIF RESULT == 7 && LAST_LOSS > 0
	BET_MONEY = LAST_LOSS * 2
ELSE
	GOTO V_BJ_LOOP
ENDIF

; 壊れきったパートナーの場合はチップ保有分を超える賭け金を拒否
IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET) && BET_MONEY > ARG * 10000
	SETCOLOR 0xFF5555
	PRINTFORML 担保となるパートナーが既に壊れきっているため、手持ち（VIPチップ{ARG}枚）を超えるツケ賭けはできません！
	PRINTFORMW 手持ちチップの範囲内（最大 ${ARG * 10000}）で賭け金を設定してください。
	RESETCOLOR
	GOTO V_BJ_LOOP
ENDIF

; 支払い処理（チップ優先 → 所持金 → 自動ツケ借金）
LOCAL:1 = BET_MONEY
; チップ充当
LOCAL:2 = MIN(ARG, LOCAL:1 / 10000)
ARG -= LOCAL:2
LOCAL:1 -= LOCAL:2 * 10000

; 現金充当
IF LOCAL:1 > 0
	IF MONEY >= LOCAL:1
		MONEY -= LOCAL:1
		LOCAL:1 = 0
	ELSE
		LOCAL:1 -= MONEY
		MONEY = 0
		; 不足分は自動ツケ！
		CFLAG:MASTER:785 += LOCAL:1
		SETCOLOR 0xFF4444
		PRINTFORMW 【ツケ承諾】手持ち不足分 ${LOCAL:1} はパートナー様を担保として借金に計上されました！（総借金：${CFLAG:MASTER:785}）
		RESETCOLOR
		LOCAL:1 = 0
	ENDIF
ENDIF

DOUBLE_DOWN = 0

; カード配布
P_CARD:0 = RAND:13 + 1
P_CARD:1 = RAND:13 + 1
D_CARD:0 = RAND:13 + 1
D_CARD:1 = RAND:13 + 1
P_CNT = 2
D_CNT = 2

PRINTFORMW あなたのカード：[{MIN(P_CARD:0, 10)}] [{MIN(P_CARD:1, 10)}]
PRINTFORMW ディーラーのカード：[{MIN(D_CARD:0, 10)}] [ ? ]

; プレイヤーターン
$P_TURN
P_SCORE = 0
FOR LOCAL, 0, P_CNT
	P_SCORE += MIN(P_CARD:LOCAL, 10)
NEXT
PRINTFORML あなたの現在の合計：{P_SCORE}（賭け金: ${BET_MONEY}）
IF P_SCORE > 21
	SETCOLOR 0xFF5555
	PRINTFORMW バースト！21を超えてしまいました……！
	IF !IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		PRINTFORML 裏カジノ特別ルールにより、バースト罰金として負け額の50％（${BET_MONEY / 2}）が借金に加算されます！
		RESETCOLOR
		CFLAG:MASTER:785 += BET_MONEY / 2
		LAST_LOSS = BET_MONEY + (BET_MONEY / 2)
	ELSE
		PRINTFORMW 掛け金 ${BET_MONEY} を失いました……！
		RESETCOLOR
		LAST_LOSS = BET_MONEY
	ENDIF
	GOTO V_BJ_LOOP
ENDIF

; ディーラーからのレイズ（吊り上げ）煽り（手が19～21の時に確率で発生）
IF P_SCORE >= 19 && P_SCORE <= 21 && RAND:3 == 0 && DOUBLE_DOWN == 0 && !IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
	SETCOLOR 0xFF4444
	PRINTFORML ディーラー「ふふふ……素晴らしい手ですね。どうでしょう、掛け金をさらに倍（+${BET_MONEY}）に吊り上げ（レイズ）ませんか？ もちろんツケで構いませんよ」
	RESETCOLOR
	PRINTL [0] 断る
	PRINTL [1] 誘いに乗って倍プッシュ！（賭け金2倍）
	INPUT
	IF RESULT == 1
		CFLAG:MASTER:785 += BET_MONEY
		BET_MONEY *= 2
		PRINTFORMW 掛け金を倍に吊り上げました！（現在の賭け金: ${BET_MONEY}）
	ENDIF
ENDIF

PRINTL [0] スタンド（勝負）
PRINTL [1] ヒット（もう1枚引く）
IF P_CNT == 2 && DOUBLE_DOWN == 0
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		SIF ARG >= BET_MONEY / 10000
			PRINTFORML [2] ダブルダウン（チップ{BET_MONEY / 10000}枚を追加し、掛け金を倍の ${BET_MONEY * 2} にして1枚だけ引く！）
	ELSE
		PRINTFORML [2] ダブルダウン（掛け金を倍の ${BET_MONEY * 2} にして1枚だけ引く！不足分はツケ）
	ENDIF
ENDIF
INPUT
IF RESULT == 1 && P_CNT < 5
	P_CARD:P_CNT = RAND:13 + 1
	PRINTFORMW カード：[{MIN(P_CARD:P_CNT, 10)}]
	P_CNT += 1
	GOTO P_TURN
ELSEIF RESULT == 2 && P_CNT == 2 && DOUBLE_DOWN == 0
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		IF ARG < BET_MONEY / 10000
			PRINTFORMW チップが不足しており、担保価値のないパートナーではツケでのダブルダウンはできません！
			GOTO P_TURN
		ENDIF
		ARG -= BET_MONEY / 10000
		DOUBLE_DOWN = 1
		BET_MONEY *= 2
		PRINTFORMW ダブルダウン！チップ{BET_MONEY / 20000}枚を追加し、掛け金が ${BET_MONEY} になりました！
	ELSE
		DOUBLE_DOWN = 1
		CFLAG:MASTER:785 += BET_MONEY
		BET_MONEY *= 2
		PRINTFORMW ダブルダウン！掛け金が ${BET_MONEY} に跳ね上がりました！
	ENDIF
	P_CARD:P_CNT = RAND:13 + 1
	PRINTFORMW 最後のカード：[{MIN(P_CARD:P_CNT, 10)}]
	P_CNT += 1
	P_SCORE = 0
	FOR LOCAL, 0, P_CNT
		P_SCORE += MIN(P_CARD:LOCAL, 10)
	NEXT
	PRINTFORML 最終合計：{P_SCORE}
	IF P_SCORE > 21
		SETCOLOR 0xFF5555
		PRINTFORMW バースト！21を超えてしまいました……！
		IF !IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
			PRINTFORML 裏カジノ特別ルールにより、バースト罰金として負け額の50％（${BET_MONEY / 2}）が借金に加算されます！
			RESETCOLOR
			CFLAG:MASTER:785 += BET_MONEY / 2
			LAST_LOSS = BET_MONEY + (BET_MONEY / 2)
		ELSE
			PRINTFORMW 掛け金 ${BET_MONEY} を失いました……！
			RESETCOLOR
			LAST_LOSS = BET_MONEY
		ENDIF
		GOTO V_BJ_LOOP
	ENDIF
ENDIF

; ディーラーターン
$D_TURN
D_SCORE = 0
FOR LOCAL, 0, D_CNT
	D_SCORE += MIN(D_CARD:LOCAL, 10)
NEXT
IF D_SCORE < 17 && D_CNT < 5
	D_CARD:D_CNT = RAND:13 + 1
	D_CNT += 1
	GOTO D_TURN
ENDIF

PRINTFORMW ディーラーの合計：{D_SCORE}
IF D_SCORE > 21 || P_SCORE > D_SCORE
	SETCOLOR 0xFFFF00
	PRINTFORMW あなたの勝ちです！
	RESETCOLOR
	LOCAL:3 = BET_MONEY * 2
	; 借金があればまず借金返済に充当
	IF CFLAG:MASTER:785 > 0
		IF LOCAL:3 >= CFLAG:MASTER:785
			LOCAL:3 -= CFLAG:MASTER:785
			PRINTFORML 配当から借金 ${CFLAG:MASTER:785} を全額完済しました！
			CFLAG:MASTER:785 = 0
		ELSE
			CFLAG:MASTER:785 -= LOCAL:3
			PRINTFORML 配当全額を借金返済に充当しました。（残借金: ${CFLAG:MASTER:785}）
			LOCAL:3 = 0
		ENDIF
	ENDIF
	IF LOCAL:3 > 0
		ARG += LOCAL:3 / 10000
		MONEY += LOCAL:3 % 10000
		PRINTFORMW 残り配当として VIPチップ{LOCAL:3 / 10000}枚 を獲得しました！
	ENDIF
	LAST_LOSS = 0
ELSEIF P_SCORE == D_SCORE
	PRINTFORMW 引き分けです。賭け金が全額返却されます。
	ARG += BET_MONEY / 10000
	MONEY += BET_MONEY % 10000
ELSE
	SETCOLOR 0xFF5555
	PRINTFORMW ディーラーの勝ちです……！ 賭け金 ${BET_MONEY} を失いました……！
	RESETCOLOR
	LAST_LOSS = BET_MONEY
ENDIF

GOTO V_BJ_LOOP

;-------------------------------------------------
; アンダーグラウンド・ダイス（超高レート・倍率勝負）
;-------------------------------------------------
@VIP_DICE_GAME, ARG
#DIM BET_MONEY
#DIM P_DICE, 2
#DIM D_DICE, 2
#DIM P_VAL
#DIM D_VAL
#DIM BET_TYPE
#DIM LAST_LOSS_DICE

RESULT:1 = 0
LAST_LOSS_DICE = 0

$V_DICE_LOOP

IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET) && ARG <= 0
	PRINTL 
	SETCOLOR 0xFF5555
	PRINTFORML 支配人「おや、VIPチップをお持ちでないようですね」
	PRINTFORML 支配人「お連れのパートナー様ではツケの融資もできませんので、チップをご購入の上でお越しください」
	RESETCOLOR
	PRINTW カジノロビーに戻ります。
	RESULT:1 = 0
	RETURN ARG
ENDIF

; 破産ライン判定
IF (CFLAG:MASTER:785 >= 3000000 && MONEY + ARG * 10000 < CFLAG:MASTER:785) || (ARG <= 0 && MONEY <= 0 && CFLAG:MASTER:785 > 0)
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		PRINTL 
		SETCOLOR 0xFF2222
		PRINTFORML 支配人「お客様……未返済の借金が ${CFLAG:MASTER:785} ございますね。手持ちのチップも尽きたようです」
		PRINTFORML 支配人「担保価値のないパートナー様ですが、ツケの利息の代わりとして廃棄処分ステージに上がっていただきましょうか！」
		RESETCOLOR
		PRINTFORMW 黒服たちによって%CALLNAME:TARGET%がステージへと連行されていく……
		CALL UNDERGROUND_BANKRUPTCY_EVENT, ARG
		PRINTL 
		SETCOLOR 0xFF2222
		PRINTFORML 支配人「ステージは大盛況でしたが、当然ながら借金の帳消しにはなりませんよ。借金は必ず返していただきます」
		RESETCOLOR
		PRINTFORMW テーブルから締め出され、カジノロビーに戻されました……（未返済借金：${CFLAG:MASTER:785}）
		RESULT:1 = 0
		RETURN ARG
	ENDIF
	CALL UNDERGROUND_BANKRUPTCY_EVENT, ARG
	ARG = RESULT
	IF RESULT:1 == 1
		RETURN ARG
	ENDIF
	IF ARG <= 0 && MONEY <= 0
		RESULT:1 = 0
		RETURN ARG
	ENDIF
ENDIF

PRINTL
DRAWLINE
SETCOLOR 0xFF2222
PRINTL 【アンダーグラウンド・ダイス】（超高レート・役満倍率勝負）
RESETCOLOR
PRINTFORML 　所持VIPチップ: {ARG}枚 (${ARG * 10000})　所持金: ${MONEY}　借金: ${CFLAG:MASTER:785}
PRINTL
PRINTL 賭け金を選択してください（不足分は自動ツケ借金となります）:
PRINTL [1] レギュラーVIP ($100,000 / チップ10枚相当)
PRINTL [2] ハイステークス ($500,000 / チップ50枚相当)
PRINTL [3] エグゼクティブ ($2,000,000 / チップ200枚相当)
PRINTL [4] 青天井・破滅レート ($10,000,000 / チップ1000枚相当)
PRINTL [5] 自由金額入力 ($10,000～)
IF LAST_LOSS_DICE > 0
	SETCOLOR 0xFF4444
	PRINTFORML [7] ★デス・倍プッシュ★（前回の負け額の倍額: ${LAST_LOSS_DICE * 2} をツケ賭け！）
	RESETCOLOR
ENDIF
PRINTL [0] カジノロビーに戻る
INPUT
IF RESULT <= 0
	RETURN ARG
ELSEIF RESULT == 1
	BET_MONEY = 100000
ELSEIF RESULT == 2
	BET_MONEY = 500000
ELSEIF RESULT == 3
	BET_MONEY = 2000000
ELSEIF RESULT == 4
	BET_MONEY = 10000000
ELSEIF RESULT == 5
	PRINTL 賭け金（ドル）を入力してください:
	INPUT
	IF RESULT < 10000
		PRINTW 最低賭け金は$10,000です。
		GOTO V_DICE_LOOP
	ENDIF
	BET_MONEY = RESULT
ELSEIF RESULT == 7 && LAST_LOSS_DICE > 0
	BET_MONEY = LAST_LOSS_DICE * 2
ELSE
	GOTO V_DICE_LOOP
ENDIF

; 壊れきったパートナーの場合は手持ちチップを超える賭け金を拒否
IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET) && BET_MONEY > ARG * 10000
	SETCOLOR 0xFF5555
	PRINTFORML 担保となるパートナーが既に壊れきっているため、手持ち（VIPチップ{ARG}枚）を超えるツケ賭けはできません！
	PRINTFORMW 手持ちチップの範囲内（最大 ${ARG * 10000}）で賭け金を設定してください。
	RESETCOLOR
	GOTO V_DICE_LOOP
ENDIF

; 支払い処理
LOCAL:1 = BET_MONEY
LOCAL:2 = MIN(ARG, LOCAL:1 / 10000)
ARG -= LOCAL:2
LOCAL:1 -= LOCAL:2 * 10000
IF LOCAL:1 > 0
	IF MONEY >= LOCAL:1
		MONEY -= LOCAL:1
		LOCAL:1 = 0
	ELSE
		LOCAL:1 -= MONEY
		MONEY = 0
		CFLAG:MASTER:785 += LOCAL:1
		SETCOLOR 0xFF4444
		PRINTFORMW 【ツケ承諾】手持ち不足分 ${LOCAL:1} はパートナー様を担保として借金に計上されました！（総借金：${CFLAG:MASTER:785}）
		RESETCOLOR
		LOCAL:1 = 0
	ENDIF
ENDIF

PRINTL 賭け方を選んでください:
PRINTL [0] 丁（偶数） - 2倍
PRINTL [1] 半（奇数） - 2倍
PRINTL [2] ディーラー出目対決（ゾロ目役満付き・高倍率）
INPUT
BET_TYPE = RESULT

IF BET_TYPE == 0 || BET_TYPE == 1
	P_DICE:0 = RAND:6 + 1
	P_DICE:1 = RAND:6 + 1
	P_VAL = P_DICE:0 + P_DICE:1
	PRINTFORMW 壺が振られた……！ 出目は【{P_DICE:0}, {P_DICE:1}】（合計: {P_VAL}）！
	IF (BET_TYPE == 0 && P_VAL % 2 == 0) || (BET_TYPE == 1 && P_VAL % 2 == 1)
		SETCOLOR 0xFFFF00
		PRINTFORMW 的中！ 配当 ${BET_MONEY * 2} を獲得！
		RESETCOLOR
		LOCAL:3 = BET_MONEY * 2
		IF CFLAG:MASTER:785 > 0
			IF LOCAL:3 >= CFLAG:MASTER:785
				LOCAL:3 -= CFLAG:MASTER:785
				CFLAG:MASTER:785 = 0
				PRINTFORML 借金を完済しました！
			ELSE
				CFLAG:MASTER:785 -= LOCAL:3
				PRINTFORML 借金返済に充当しました。（残借金: ${CFLAG:MASTER:785}）
				LOCAL:3 = 0
			ENDIF
		ENDIF
		IF LOCAL:3 > 0
			ARG += LOCAL:3 / 10000
			MONEY += LOCAL:3 % 10000
		ENDIF
		LAST_LOSS_DICE = 0
	ELSE
		SETCOLOR 0xFF5555
		PRINTFORMW ハズレ……！ 掛け金 ${BET_MONEY} を失いました……！
		RESETCOLOR
		LAST_LOSS_DICE = BET_MONEY
	ENDIF
ELSE
	; ディーラー出目対決
	P_DICE:0 = RAND:6 + 1
	P_DICE:1 = RAND:6 + 1
	D_DICE:0 = RAND:6 + 1
	D_DICE:1 = RAND:6 + 1
	PRINTFORMW あなたの出目: 【{P_DICE:0}, {P_DICE:1}】
	PRINTFORMW ディーラーの出目: 【{D_DICE:0}, {D_DICE:1}】

	; ゾロ目判定
	IF P_DICE:0 == P_DICE:1 && D_DICE:0 != D_DICE:1
		SETCOLOR 0xFFFF00
		PRINTFORMW あなたのゾロ目勝利！ 特大配当 4倍（${BET_MONEY * 4}）を獲得！
		RESETCOLOR
		LOCAL:3 = BET_MONEY * 4
		ARG += LOCAL:3 / 10000
		MONEY += LOCAL:3 % 10000
		LAST_LOSS_DICE = 0
	ELSEIF D_DICE:0 == D_DICE:1 && P_DICE:0 != P_DICE:1
		SETCOLOR 0xFF2222
		PRINTFORMW ディーラーのゾロ目（アラシ）！ 役満ペナルティで負け額が2倍（${BET_MONEY * 2}）になります！
		RESETCOLOR
		IF !IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
			CFLAG:MASTER:785 += BET_MONEY
			LAST_LOSS_DICE = BET_MONEY * 2
		ELSE
			LAST_LOSS_DICE = BET_MONEY
		ENDIF
	ELSEIF (P_DICE:0 + P_DICE:1) > (D_DICE:0 + D_DICE:1)
		SETCOLOR 0xFFFF00
		PRINTFORMW あなたの勝ちです！ 配当 2倍（${BET_MONEY * 2}）を獲得！
		RESETCOLOR
		LOCAL:3 = BET_MONEY * 2
		ARG += LOCAL:3 / 10000
		MONEY += LOCAL:3 % 10000
		LAST_LOSS_DICE = 0
	ELSEIF (P_DICE:0 + P_DICE:1) == (D_DICE:0 + D_DICE:1)
		PRINTFORMW 引き分けです。掛け金が返却されます。
		ARG += BET_MONEY / 10000
		MONEY += BET_MONEY % 10000
	ELSE
		SETCOLOR 0xFF5555
		PRINTFORMW ディーラーの勝ちです……！ 掛け金 ${BET_MONEY} を失いました……！
		RESETCOLOR
		LAST_LOSS_DICE = BET_MONEY
	ENDIF
ENDIF

GOTO V_DICE_LOOP

;==================================================
; 裏カジノ入場条件（所持金1000万以上）の日数経過判定・アナウンス
;==================================================
@CHECK_UNDERGROUND_CASINO_UNLOCK
IF FLAG:15080 == 0 && MONEY >= 10000000
	FLAG:15080 = 1
	DRAWLINE
	SETCOLOR 255, 100, 100
	PRINTFORML 【裏カジノ 入場条件達成！】
	RESETCOLOR
	PRINTFORML 所持金が一千万円（$10,000,000）以上に達したことで、裏社会の有力者に目を付けられました……
	PRINTFORML カジノのゲームコーナーから【裏カジノ（地下VIPフロア）】への入場が可能になりました！
	PRINTFORML （※一度解放されたため、今後所持金が減少しても入場可能です）
	DRAWLINE
	WAIT
ENDIF
RETURN 0

;==================================================
; パートナー損壊・下限到達判定（体力・気力ともに300以下）
;==================================================
@IS_UNDERGROUND_PARTNER_BROKEN(ARG = -1)
#FUNCTION
SIF ARG < 0
	ARG = TARGET
SIF ARG <= 0 || ARG >= CHARANUM
	RETURNF 0
; 最大体力・気力の双方が下限値(300以下)に達しているか判定
SIF MAXBASE:ARG:0 <= 300 && MAXBASE:ARG:1 <= 300
	RETURNF 1
RETURNF 0

;チップを借金返済に優先充当し、余りを現金へ換える。
@UNDERGROUND_CASH_OUT, ARG
#DIM CASH_OUT
IF ARG > 0
	CASH_OUT = ARG * 10000
	PRINTFORML 　所持VIPチップ：{ARG}枚（換金価値：${CASH_OUT}）
	; 借金返済
	IF CFLAG:MASTER:785 > 0
		IF CASH_OUT >= CFLAG:MASTER:785
			CASH_OUT -= CFLAG:MASTER:785
			PRINTFORML 　借金を全額返済しました！
			CFLAG:MASTER:785 = 0
		ELSE
			CFLAG:MASTER:785 -= CASH_OUT
			PRINTFORML 　全額返済に充当しました。（残借金：${CFLAG:MASTER:785}）
			CASH_OUT = 0
		ENDIF
	ENDIF
	IF CASH_OUT > 0
		MONEY += CASH_OUT
		SETCOLOR 0xFFFF00
		PRINTFORMW 　現金${CASH_OUT}を受け取りました！（所持金：${MONEY}）
		RESETCOLOR
	ENDIF
ELSE
	PRINTL 　手元にVIPチップはありません。
ENDIF

RETURN 1
