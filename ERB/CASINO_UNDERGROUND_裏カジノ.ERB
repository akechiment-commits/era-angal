;============================================================
; 【超高レート・青天井・破滅泥沼裏カジノシステム】
;============================================================
; CFLAG:MASTER:785 = 地下裏カジノ借金総額
; CFLAG:TARGET:786 = パートナー担保差し出し回数
; TFLAG:110 = 担保ペナルティ進行段階 (Level 1～4)

@UNDERGROUND_CASINO_MAIN
#DIM VIP_CHIP
#DIM BORROW_AMOUNT
#DIM INITIAL_CHIP
IF TARGET <= 0 || TARGET >= CHARANUM
	PRINTW パートナーを選択してから利用してください。
	RETURN 0
ENDIF

; 借金負数・オーバーフローの自己修復
IF CFLAG:MASTER:785 < 0
	CFLAG:MASTER:785 = 9000000000000000000
ENDIF


VIP_CHIP = 0
BORROW_AMOUNT = 0
INITIAL_CHIP = 0
	;裏カジノ同伴回数加算
	SIF TARGET >= 1 && TARGET < CHARANUM
		CFLAG:TARGET:1209 += 1

DRAWLINE
SETCOLOR 0xFF2222
PRINTL ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
PRINTL ┃　　　　　　　◆◆◆　地下特設フロア・ＶＩＰ裏カジノ　◆◆◆　　　　　　　┃
PRINTL ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
RESETCOLOR
PRINTL
PRINTFORML 従業員用通路の頑丈な鉄扉をくぐり、薄暗い螺旋階段を深く降りていく……
PRINTFORML 地上の喧騒とはかけ離れた、紫煙と欲望、そして異様な熱気が肌にまとわりつく。
PRINTFORML 分厚い防音扉が開いた先には、豪華なシャンデリアの下で巨額の札束が飛び交う秘密の賭場が広がっていた。
PRINTL
IF TALENT:TARGET:76	; 【TARGET:[淫乱]】
	PRINTFORML %CALLNAME:TARGET%は怪しげな熱気を感じ取ったのか、頬をうっすら上気させ、背徳的な空間に瞳を潤ませながら周囲を見渡している……
ELSEIF TALENT:TARGET:85	; 【TARGET:[恋慕]】
	PRINTFORML %CALLNAME:TARGET%は本能的な危険を察知したのか、怯えるように%CALLNAME:MASTER%の腕に縋り付き、引き返したいように袖を引いている……
ELSE
	PRINTFORML %CALLNAME:TARGET%は周囲を取り囲む屈強な男たちの視線に晒され、警戒と不安に身を竦ませている……
ENDIF
PRINTL

$UNDERGROUND_MENU

; 破産トリガー判定（借金300万以上かつ返済不能、または資金ゼロで借金あり）
IF (CFLAG:MASTER:785 >= 3000000 && MONEY + VIP_CHIP * 10000 < CFLAG:MASTER:785) || (VIP_CHIP <= 0 && MONEY <= 0 && CFLAG:MASTER:785 > 0)
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		PRINTL 
		SETCOLOR 0xFF2222
		PRINTFORML 支配人「お客様……未返済の借金が ${CFLAG:MASTER:785} ございますね。手持ちの金もチップも尽きたようです」
		PRINTFORML 支配人「お連れのパートナー様は既に担保価値がございませんが……タダで見逃すわけにはまいりません」
		PRINTFORML 支配人「借金の利息の代わりとして、廃棄処分ステージで観客を楽しませていただきましょうか！」
		RESETCOLOR
		PRINTFORMW 逃げようとする%CALLNAME:MASTER%を押さえつけ、黒服たちが%CALLNAME:TARGET%を強引にステージへと引きずり込んでいく……
		CALL UNDERGROUND_BANKRUPTCY_EVENT, VIP_CHIP
		PRINTL 
		SETCOLOR 0xFF2222
		PRINTFORML 支配人「さて……ステージは大いに湧きましたが、お伝えした通り借金の帳消しには応じられませんよ」
		PRINTFORML 支配人「未返済借金（${CFLAG:MASTER:785}）は残ったままです。金を用意して期日までに耳を揃えて返しなさい……追い出しなさい！」
		RESETCOLOR
		PRINTFORMW 黒服たちによって裏カジノから叩き出された……（未返済借金：${CFLAG:MASTER:785}）
		CALL UNDERGROUND_SETTLEMENT, VIP_CHIP, 1
		RETURN 1
	ENDIF
	CALL UNDERGROUND_BANKRUPTCY_EVENT, VIP_CHIP
	VIP_CHIP = RESULT
	IF RESULT:1 == 1
		CALL UNDERGROUND_SETTLEMENT, VIP_CHIP, 1
		RETURN 1
	ENDIF
ENDIF

DRAWLINE
PRINTFORML 【所持VIPチップ】: {VIP_CHIP}枚 (1枚 ＝ $10,000)
PRINTFORML 【現在の所持金】: ${MONEY}
IF CFLAG:MASTER:785 > 0
	SETCOLOR 0xFF4444
	PRINTFORML 【未返済の借金】: ${CFLAG:MASTER:785} (月利50％の利息)
	RESETCOLOR
ENDIF
PRINTFORML 【本日の担保状況】: Level {TFLAG:110} / 5
PRINTL
PRINTL [0] VIPチップを購入する (1枚 $10,000)
IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
	SETCOLOR 0x888888
	PRINTL [1] 特別融資を受ける (借金をしてチップを借りる) ※担保価値なし・利用不可
	RESETCOLOR
ELSE
	PRINTL [1] 特別融資を受ける (借金をしてチップを借りる)
ENDIF
PRINTL [2] 【VIPブラックジャック】（超高レート・青天井ツケ勝負）
PRINTL [3] 【アンダーグラウンド・ダイス】（超高レート・倍率勝負）
IF CFLAG:MASTER:785 > 0 || VIP_CHIP <= 0 || IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		SETCOLOR 0xCC3333
		PRINTL [4] 【廃棄処分・生贄執行】（壊れきったパートナーを差し出し、さらに徹底的に破壊する）※借金清算なし
		RESETCOLOR
	ELSE
		PRINTL [4] 【破産宣告・担保差し入れ】（自らパートナーを担保に差し出し、救済チップを得る）
	ENDIF
ENDIF
PRINTL [9] 精算して裏カジノを退出する
PRINTL

INPUT
IF RESULT == 0
	PRINTL 購入するVIPチップの枚数を入力してください (1枚 = $10,000、0でキャンセル)
	INPUT
	IF RESULT <= 0
		GOTO UNDERGROUND_MENU
	ELSEIF RESULT * 10000 > MONEY
		PRINTW 所持金が足りません。
		GOTO UNDERGROUND_MENU
	ELSE
		VIP_CHIP += RESULT
		MONEY -= RESULT * 10000
		INITIAL_CHIP += RESULT
		PRINTFORMW VIPチップを{RESULT}枚購入しました。（残金: ${MONEY}）
		GOTO UNDERGROUND_MENU
	ENDIF
ELSEIF RESULT == 1
	CALL UNDERGROUND_BORROW, VIP_CHIP
	VIP_CHIP = RESULT
	GOTO UNDERGROUND_MENU
ELSEIF RESULT == 2
	CALL VIP_BLACK_JACK, VIP_CHIP
	VIP_CHIP = RESULT
	IF RESULT:1 == 1
		CALL UNDERGROUND_SETTLEMENT, VIP_CHIP, 1
		RETURN 1
	ENDIF
	GOTO UNDERGROUND_MENU
ELSEIF RESULT == 3
	CALL VIP_DICE_GAME, VIP_CHIP
	VIP_CHIP = RESULT
	IF RESULT:1 == 1
		CALL UNDERGROUND_SETTLEMENT, VIP_CHIP, 1
		RETURN 1
	ENDIF
	GOTO UNDERGROUND_MENU
ELSEIF RESULT == 4 && (CFLAG:MASTER:785 > 0 || VIP_CHIP <= 0 || IS_UNDERGROUND_PARTNER_BROKEN(TARGET))
	IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
		PRINTL 
		SETCOLOR 0x990000
		PRINTFORML 支配人「おや……？ このお嬢様は既に心身ともに限界まで壊れきっており、当カジノでの担保価値はございませんよ」
		PRINTFORML 支配人「それでも更なる破壊の余興として、廃棄処分ステージに差し出すとおっしゃるなら……喜んでお引き受けいたしましょう」
		PRINTFORML 支配人「ただし担保価値がございませんので、借金の帳消しにも救済チップの支給にも応じられません。それでもよろしいので？」
		RESETCOLOR
		PRINTL [0] ステージに差し出し、さらに破壊する
		PRINTL [1] 思いとどまる
		INPUT
		IF RESULT != 0
			GOTO UNDERGROUND_MENU
		ENDIF
		CALL UNDERGROUND_DISPOSAL_STAGE_EVENT, VIP_CHIP
		VIP_CHIP = RESULT
		GOTO UNDERGROUND_MENU
	ENDIF
	CALL UNDERGROUND_BANKRUPTCY_EVENT, VIP_CHIP
	VIP_CHIP = RESULT
	IF RESULT:1 == 1
		CALL UNDERGROUND_SETTLEMENT, VIP_CHIP, 1
		RETURN 1
	ENDIF
	GOTO UNDERGROUND_MENU
ELSEIF RESULT == 9
	CALL UNDERGROUND_SETTLEMENT, VIP_CHIP
	RETURN 1
ELSE
	GOTO UNDERGROUND_MENU
ENDIF

;-------------------------------------------------
; 特別融資（借金）
;-------------------------------------------------
@UNDERGROUND_BORROW, ARG
#DIM BORROW_UNITS
IF IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
	PRINTL 
	SETCOLOR 0xFF5555
	PRINTFORML 支配人「おや……？ 残念ながら、お連れのパートナー様は既に限界まで壊れきっておりますね」
	PRINTFORML 支配人「これ以上担保価値のないお身体では、追加のご融資（ツケ）には応じかねます」
	PRINTFORMW 担保となるパートナーが下限まで衰弱しているため、特別融資は受けられません…
	RESETCOLOR
	RETURN ARG
ENDIF
PRINTL 
PRINTFORML 黒服の支配人が冷酷な笑みを浮かべ、%CALLNAME:MASTER%の前に一枚の契約書を差し出してきた。
PRINTFORML 支配人「ツケの枠に付きましては、パートナー様のお身体と信用を担保に幾らでもご融資いたしますよ……」
PRINTFORML 期日までに返済できない場合は、どのような形であれ【身体で清算】していただくことになると淡々と告げられた。
PRINTL 
PRINTL [0] 融資を受けない（やめておく）
PRINTL [1] 10枚（$100,000）借りる
PRINTL [2] 30枚（$300,000）借りる
PRINTL [3] 50枚（$500,000）借りる
PRINTL [4] 100枚（$1,000,000）借りる
PRINTL [5] 500枚（$5,000,000）借りる（超高額融資）
INPUT
IF RESULT >= 1 && RESULT <= 5
	SELECTCASE RESULT
		CASE 1
			BORROW_UNITS = 10
		CASE 2
			BORROW_UNITS = 30
		CASE 3
			BORROW_UNITS = 50
		CASE 4
			BORROW_UNITS = 100
		CASE 5
			BORROW_UNITS = 500
	ENDSELECT
	CFLAG:MASTER:785 += BORROW_UNITS * 10000
	ARG += BORROW_UNITS
	SETCOLOR 0xFF3333
	PRINTFORML 借用書にサインし、VIPチップ{BORROW_UNITS}枚を受け取った……
	PRINTFORMW （借金加算: ${BORROW_UNITS * 10000} ／ 総借金高: ${CFLAG:MASTER:785}）
	RESETCOLOR
	IF TALENT:TARGET:76 == 0	; 【TARGET:[淫乱]なし】
		PRINTFORMW %CALLNAME:TARGET%は冷徹にサインを交わす%CALLNAME:MASTER%の手を見つめ、絶望に顔を青ざめさせながら震えている……
	ENDIF
ENDIF
RETURN ARG

;-------------------------------------------------
; 支配人の強制取り立て・破産宣告イベント
;-------------------------------------------------
;-------------------------------------------------

; 廃棄処分・生贄執行ステージイベント（壊れきったパートナー専用）

;-------------------------------------------------

@UNDERGROUND_DISPOSAL_STAGE_EVENT, ARG

DRAWLINE

SETCOLOR 0x990000

PRINTL ┌─────────────────────────────────┐

PRINTL │     ◆◆◆ 廃棄処分・生贄執行ステージ ◆◆◆     │

PRINTL └─────────────────────────────────┘

RESETCOLOR

PRINTL 

PRINTFORML %CALLNAME:MASTER%が合図を出すと、支配人は嗜虐的な笑みを深く刻んだ。

PRINTFORML 支配人「素晴らしいご決断です。壊れきったお嬢様がさらに徹底的に蹂躙され、壊れゆく様……観客たちも狂喜することでしょう」

PRINTFORML 支配人「黒服たち！ このお嬢様を廃棄処分ステージの壇上へお連れしなさい！」

PRINTL 

PRINTFORML 屈強な黒服の男たちが現れ、すでに抵抗する力もなくぐったりとした%CALLNAME:TARGET%を両脇から抱え上げる。

PRINTFORMW 虚ろな瞳の%CALLNAME:TARGET%は、歓声と欲望が渦巻く狂乱のステージの中央へと連行されていく……



IF CFLAG:TARGET:786 >= 5

	TFLAG:110 = MAX(TFLAG:110, 5) + 1

ELSE

	TFLAG:110 += 1

ENDIF

CFLAG:TARGET:786 += 1

CALL UNDERGROUND_STAGE_PENALTY, TFLAG:110



PRINTL 

SETCOLOR 0xFF5555

PRINTFORML 支配人「ふふふ……観客は大いに狂喜いたしましたが、前述の通り担保価値のないお身体ですので借金の帳消しも救済チップの支給もございません」

PRINTFORMW 既に限界まで壊れきったパートナーのため、借金（${CFLAG:MASTER:785}）は帳消しにならず、救済チップも支払われませんでした。

RESETCOLOR

PRINTL 

PRINTFORMW %CALLNAME:MASTER%は限界を超えてさらに徹底的に破壊され、動かない人形のようになった%CALLNAME:TARGET%を抱き起こした……

RETURN ARG



@UNDERGROUND_BANKRUPTCY_EVENT, ARG, ARG:1 = 0
#DIM WAS_BROKEN
#DIM RESCUE_CHIP
;RESULT:1 = 1 は地下フロアからの退出要求。ARG:1 = 1 は精算中。
RESULT:1 = 0
WAS_BROKEN = IS_UNDERGROUND_PARTNER_BROKEN(TARGET)
DRAWLINE
SETCOLOR 0xFF1111
PRINTL ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
PRINTL ┃　　　　　　　◆◆◆　破産宣告・支配人の強制取り立て　◆◆◆　　　　　　┃
PRINTL ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
RESETCOLOR
PRINTL
PRINTFORML 背後から屈強な黒服の男たちが音もなく現れ、テーブルと部屋の出口を塞いだ。
PRINTFORML 冷徹な支配人が分厚い帳簿を開き、冷ややかな視線を%CALLNAME:MASTER%と%CALLNAME:TARGET%に投げかける。
PRINTL
SETCOLOR 0xFF5555
PRINTFORML 支配人「お客様……ツケの総額が ${CFLAG:MASTER:785} に達しておりますね」
PRINTFORML 支配人「当カジノの規則により、即時一括返済が不可能な場合、契約書に基づき【お連れのパートナー様】を担保としてお預かりすることになっております」
RESETCOLOR
PRINTL
IF TALENT:TARGET:76	; 【TARGET:[淫乱]】
	PRINTFORML %CALLNAME:TARGET%は自分が見世物として売られる状況に、背筋を淫らに震わせ、恍惚とした吐息を漏らしながらステージを見つめている……
ELSEIF TALENT:TARGET:85	; 【TARGET:[恋慕]】
	PRINTFORML %CALLNAME:TARGET%は信じられないものを見る目で%CALLNAME:MASTER%を見つめ、大粒の涙を零しながら必死に首を横に振っている……
ELSE
	PRINTFORML %CALLNAME:TARGET%は怒りと恐怖に顔を引きつらせ、激しく後ずさりしながら必死に拒絶の意思を示している……
ENDIF
PRINTL
PRINTFORML 【現在の借金高】: ${CFLAG:MASTER:785}
PRINTFORML 【パートナー担保進行度】: Level {TFLAG:110} / 5
PRINTL
IF WAS_BROKEN
	PRINTFORML すでに心身ともに限界まで壊れきった%CALLNAME:TARGET%に、もはや抗う力は残されていない……
	PRINTFORMW 黒服の男たちに無造作に抱え上げられ、%CALLNAME:TARGET%は狂乱のステージへと連行されていく……
ELSE
	PRINTL [0] パートナーを担保としてステージに差し出す
	PRINTL [1] 必死に土下座して許しを乞う
	INPUT
	IF RESULT == 1
		PRINTFORML %CALLNAME:MASTER%は床に頭を擦り付け、どうかそれだけはと必死に哀願した……
		PRINTFORML 支配人は冷酷な笑みを浮かべ、見下すように靴の先で%CALLNAME:MASTER%の顎を持ち上げる。
		PRINTFORML 支配人「それだけは困りますね。ですが……客席にステージで歓声を上げていただければ、救済チップをお渡しする用意もございますがね」
		PRINTFORMW 屈強な黒服たちが%CALLNAME:TARGET%を取り押さえ、ステージへと引きずり込んでいく……
	ELSE
		PRINTFORML %CALLNAME:MASTER%は震える手でサインをし、%CALLNAME:TARGET%の身柄を支配人へと引き渡した……
		PRINTFORMW 屈強な黒服に両腕を掴まれ、%CALLNAME:TARGET%はステージへと連行されていく……
	ENDIF
ENDIF

IF CFLAG:TARGET:786 >= 5
	TFLAG:110 = MAX(TFLAG:110, 5) + 1
ELSE
	TFLAG:110 += 1
ENDIF
CFLAG:TARGET:786 += 1
CALL UNDERGROUND_STAGE_PENALTY, TFLAG:110

; 既に壊れきったパートナーの場合は救済チップなし
IF WAS_BROKEN
	PRINTL 
	SETCOLOR 0xFF5555
	PRINTFORML 支配人「ふふふ……観客は大いに狂乱しましたが、お伝えした通り担保価値のないお身体ですので救済チップはお渡しできません」
	PRINTFORMW 既に下限まで壊れきったパートナーでは救済チップは支給されませんでした。（借金：${CFLAG:MASTER:785}）
	RESETCOLOR
	PRINTL 
	PRINTFORMW %CALLNAME:MASTER%は限界を超えてさらに破壊され、動かない人形のようになった%CALLNAME:TARGET%を抱き起こした……
	RESULT:1 = 0
	RETURN ARG
ENDIF

; ステージ終了後の救済チップ付与
RESCUE_CHIP = 20 + (TFLAG:110 * 15)
ARG += RESCUE_CHIP
PRINTL
SETCOLOR 0xFFFF00
PRINTFORMW 観客たちの熱狂的な歓声と拍手の中、支配人から救済チップとしてVIPチップ{RESCUE_CHIP}枚（${RESCUE_CHIP * 10000}相当）が投げ渡された！
RESETCOLOR
PRINTFORML 支配人「ふふふ、お嬢様のおかげでフロアは大盛況でしたよ。さあ、このチップで一発逆転を狙いましょうか……？」
PRINTL
;既に精算中なら再勝負は選ばせず、残チップを換金して退出する。
IF ARG:1 == 1
	RESULT:1 = 1
	RETURN ARG
ENDIF
PRINTL [0] 救済チップで更なる勝負に挑む！（泥沼へ）
PRINTL [1] これ以上の破滅を恐れ、退散する
INPUT
IF RESULT == 0
	PRINTFORMW %CALLNAME:MASTER%は渡されたチップを握りしめ、再びテーブルへと向かった……
	RESULT:1 = 0
	RETURN ARG
ELSE
	PRINTFORMW %CALLNAME:MASTER%はボロボロになった%CALLNAME:TARGET%を抱き起こし、命からがら裏カジノを後にした……
	RESULT:1 = 1
	RETURN ARG
ENDIF

;-------------------------------------------------
; チップ切れ時の担保ペナルティチェック
;-------------------------------------------------
@UNDERGROUND_PENALTY_CHECK, ARG
IF ARG > 0
	RETURN ARG
ENDIF
CALL UNDERGROUND_BANKRUPTCY_EVENT, ARG
RETURN RESULT

@UNDERGROUND_STAGE_PENALTY, ARG
#DIM PENALTY_SUB
#DIM PENALTY_JUEL
#DIM IS_PERFECT_LOVE
#DIM CAN_LUST
#DIM IS_REPEAT_SACRIFICE
#DIM TEXT_PATTERN
#DIM HP_CORRECTION
#DIM DMG_MAX_HP
#DIM DMG_MAX_MP
#DIM REPEAT_TIER
#DIM ADD_JUEL_V
#DIM ADD_JUEL_A
#DIM ADD_JUEL_LUST
#DIM ADD_JUEL_SUBMIT
#DIM ADD_JUEL_SHAME
#DIM ADD_JUEL_PAIN
#DIM ADD_JUEL_FEAR
#DIM ADD_JUEL_DENY
#DIM WAS_BROKEN

WAS_BROKEN = IS_UNDERGROUND_PARTNER_BROKEN(TARGET)

;裏カジノ身代わり回数加算（TARGETの個人ログCFLAG:1210に正確に加算）
SIF TARGET >= 1 && TARGET < CHARANUM
	CFLAG:TARGET:1210 += 1

; 調教完璧判定（相愛/親愛、好感度8000以上、親密5以上、欲望または奉仕精神5以上）
IS_PERFECT_LOVE = 0
IF (TALENT:TARGET:89 || TALENT:TARGET:88) && CFLAG:TARGET:2 >= 8000 && ABL:TARGET:0 >= 5 && (ABL:TARGET:1 >= 5 || ABL:TARGET:6 >= 5)	; 【TARGET:[相愛] / TARGET:[親愛] / TARGET:[親密]Lv>=5 / TARGET:[欲望]Lv>=5 / TARGET:[奉仕精神]Lv>=5 / TARGET:[好感度]>=8000】
	IS_PERFECT_LOVE = 1
ENDIF

; 欲情可能判定（淫乱、快感に素直、マゾ、倒錯的、欲望LV4以上、マゾっ気LV3以上のいずれか）
CAN_LUST = 0
IF TALENT:TARGET:76 || TALENT:TARGET:70 || TALENT:TARGET:79 || TALENT:TARGET:80 || ABL:TARGET:1 >= 4 || ABL:TARGET:8 >= 3	; 【TARGET:[淫乱] / TARGET:[快感に素直] / TARGET:[マゾ] / TARGET:[倒錯的] / TARGET:[欲望]Lv>=4 / TARGET:[マゾっ気]Lv>=3】
	CAN_LUST = 1
