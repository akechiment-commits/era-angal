		PRINTFORML （意識を失っているため、抵抗されることなくそのまま受け入れた…）
		RETURN 1
	ENDIF
	;実行判定失敗口上呼び出し
	TFLAG:13 = 99
	CALL SELF_KOJO
	;日常・交流コマンドの失敗地の文
	;COM306/307はコマンド側に専用の失敗分岐があるため除外
IF SELECTCOM != 306 && SELECTCOM != 307	; 【コマンド:[髪梳き]以外 / コマンド:[櫛で梳かす]以外】
		CALL COM_ORDER_FAILURE_GROUND
	ENDIF
	;実行判定非表示にしている場合下記の文章が表示されないと実行できない場合が分かり難いため文章表示
	IF ((FLAG:23 & 1p27) == 0) && FLAG:2 != 1
		;実行判定を表示する場合は文章表示の必要なし
	ELSE
		PRINTFORMW %CALLNAME:TARGET%の合意を得られませんでした
	ENDIF
	RETURN 0
ENDIF
;実行できる場合はRETURN 1で終了
RETURN 1

