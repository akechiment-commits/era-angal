	PRINTL [0] はい
	PRINTL [1] いいえ
	$INPUT_LOOP1
	INPUT
	IF RESULT == 0
		PRINTFORMW ―素質・能力を変更します―
		TALENT:TARGET:41 = 1
		TALENT:TARGET:21 = 0
		TALENT:TARGET:127 = 0
