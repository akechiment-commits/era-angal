;----------------------------------------------------------------
;特定キャラの存在判定関数
;面倒なので関数化して各関数の頭でここを呼び出して判定しておく
;CFLAG260で特定キャラの有無をビット管理（1.藍様　2.紫様　3.霊夢 4.幽々子）
;----------------------------------------------------------------
@K13_CHR_EXISTANCE
;エラー防止の為、一文字変数Tの値を保管
	CFLAG:267 = T

;藍様の存在判定
	T = 21
	CALL GET_EXISTANCE

	IF E > 0
		CFLAG:260 |= 1
	ELSE
		CFLAG:260 &= 14
	ENDIF

;紫様の存在判定
	T = 22
	CALL GET_EXISTANCE

	IF E > 0
		CFLAG:260 |= 2
	ELSE
		CFLAG:260 &= 13
	ENDIF

;霊夢の存在判定
	T = 1
	CALL GET_EXISTANCE

	IF E > 0
		CFLAG:260 |= 4
	ELSE
		CFLAG:260 &= 11
	ENDIF

;幽々子の存在判定
	T = 20
	CALL GET_EXISTANCE

	IF E > 0
		CFLAG:260 |= 8
	ELSE
		CFLAG:260 &= 7
	ENDIF

;エラー防止の為、保存した一文字変数Tの値を戻す
	T = CFLAG:267

RETURN 0

