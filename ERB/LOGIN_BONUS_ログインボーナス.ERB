;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;-------------------------------------------------
; ログインボーナスシステム
;   FLAG:119  = 最終受取日 (YYYYMMDD、セーブ別)
;   FLAG:231  = ログイン日数 (セーブ別)
;-------------------------------------------------

@LOGIN_BONUS_CHECK
; ── 日付取得 ──────────────────────────────────
GETTIME
; EmueraEM+EE: RESULT:0 = YYYYMMDDHHMMSSmmm (17桁) → /1000000000 でYYYYMMDD取得
IF RESULT:0 >= 10000000000000000
	LOCAL:0 = RESULT:0 / 1000000000
ELSEIF RESULT:0 >= 2000 && RESULT:0 <= 2099
	LOCAL:0 = RESULT:0 * 10000 + RESULT:1 * 100 + RESULT:2
ELSE
	RETURN 0
ENDIF

; ── 今日すでに受け取り済みなら終了 (FLAG:119 = 最終受取日) ──
SIF FLAG:119 == LOCAL:0
	RETURN 0

; ── ログイン日数計算 ──────────────────

IF FLAG:119 <= 0
	FLAG:231 = 1
ELSE
	FLAG:231 += 1
ENDIF

; 受取日を更新
FLAG:119 = LOCAL:0

; ── 報酬テーブル（7日サイクル） ─────────────────
LOCAL:5 = ((FLAG:231 - 1) % 7) + 1

DRAWLINE
PRINTFORML ★ ログインボーナス ★
DRAWLINE
PRINTFORML ログイン：{FLAG:231} 日目
PRINTL
; 毎日確定: キミサキダイヤ (週数×5)
LOCAL:6 = ((FLAG:231 - 1) / 7 + 1) * 5
FLAG:112 += LOCAL:6
PRINTFORML 　キミサキダイヤ ×{LOCAL:6}
SELECTCASE LOCAL:5
CASE 1
	FLAG:113 += 10
	PRINTFORML 　ブロンズガチャチケット ×10
CASE 2
	ITEM:91 += 1
	ITEM:93 += 1
	PRINTFORML 　カレー ×1
	PRINTFORML 　パフェ ×1
CASE 3
	FLAG:114 += 10
	PRINTFORML 　シルバーガチャチケット ×10
CASE 4
	ITEM:91 += 1
	ITEM:93 += 1
	PRINTFORML 　カレー ×1
	PRINTFORML 　パフェ ×1
CASE 5
	FLAG:115 += 10
	PRINTFORML 　ゴールドガチャチケット ×10
CASE 6
	ITEM:94 += 1
	PRINTFORML 　お弁当 ×1
CASE 7
	FLAG:116 += 10
	PRINTFORML 　プラチナガチャチケット ×10　← 週間ボーナス！
ENDSELECT

PRINTL
SIF LOCAL:5 < 7
	PRINTFORML （週間ボーナスまで あと {7 - LOCAL:5} 日）
DRAWLINE
WAIT
RETURN 0
