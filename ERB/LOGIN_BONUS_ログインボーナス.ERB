;-------------------------------------------------
; ログインボーナスシステム
;   GLOBAL:230 = 最終受取日 (YYYYMMDD)
;   GLOBAL:231 = 連続ログイン日数
;   FLAG:119   = セッション内受取済みフラグ (GETTIMEが使えない場合のフォールバック)
;               → @EVENTFIRST / @EVENTSHOP #PRI(LOADGAME後) で毎回 0 にリセットされる
;-------------------------------------------------

@LOGIN_BONUS_CHECK
; ── 日付取得 ──────────────────────────────────────
; Emuera1820: GETTIME → RESULT:0=年 RESULT:1=月 RESULT:2=日
; eramaker旧式の場合: RESULT:0 が 0 のまま → ELSEIF で A/B/C を試す
GETTIME
IF RESULT:0 >= 2000 && RESULT:0 <= 2099
	LOCAL:0 = RESULT:0 * 10000 + RESULT:1 * 100 + RESULT:2
ELSEIF A >= 2000 && A <= 2099
	LOCAL:0 = A * 10000 + B * 100 + C
ELSE
	; GETTIME が使えない → FLAG:119 でセッション単位管理
	SIF FLAG:119 == 1
		RETURN 0
	FLAG:119 = 1
	GOTO GIVE_BONUS
ENDIF

; ── 今日すでに受け取り済みなら終了 ───────────────
SIF GLOBAL:230 == LOCAL:0
	RETURN 0

; ── 連続ログイン日数計算 ──────────────────────────
$GIVE_BONUS
IF GLOBAL:230 <= 0
	GLOBAL:231 = 1
ELSE
	LOCAL:1 = LOCAL:0 / 100		; 今日のYYYYMM
	LOCAL:2 = LOCAL:0 % 100		; 今日のDD
	LOCAL:3 = GLOBAL:230 / 100	; 前回のYYYYMM
	LOCAL:4 = GLOBAL:230 % 100	; 前回のDD
	; 同月で1日差
	IF LOCAL:1 == LOCAL:3 && LOCAL:2 == LOCAL:4 + 1
		GLOBAL:231 += 1
	ELSEIF LOCAL:2 == 1 && LOCAL:1 > LOCAL:3
		GLOBAL:231 += 1
	ELSE
		GLOBAL:231 = 1
	ENDIF
ENDIF

; 日付を更新（GETTIME が有効な場合のみ。LOCAL:0=0ならスキップ）
SIF LOCAL:0 > 0
	GLOBAL:230 = LOCAL:0

; ── 報酬テーブル（7日サイクル） ───────────────────
LOCAL:5 = ((GLOBAL:231 - 1) % 7) + 1

DRAWLINE
PRINTFORML ★ ログインボーナス ★
DRAWLINE
PRINTFORML 連続ログイン：{GLOBAL:231} 日目
PRINTL
SELECTCASE LOCAL:5
CASE 1
	MONEY += 500
	PRINTFORML 報酬：お金 +500円
CASE 2
	FLAG:112 += 5
	PRINTFORML 報酬：キミサキダイヤ ×5
CASE 3
	MONEY += 1000
	PRINTFORML 報酬：お金 +1,000円
CASE 4
	FLAG:113 += 1
	PRINTFORML 報酬：ブロンズガチャチケット ×1
CASE 5
	MONEY += 1500
	FLAG:112 += 10
	PRINTFORML 報酬：お金 +1,500円 ＋ ダイヤ ×10
CASE 6
	FLAG:114 += 1
	PRINTFORML 報酬：シルバーガチャチケット ×1
CASE 7
	FLAG:115 += 1
	PRINTFORML 報酬：ゴールドガチャチケット ×1　← 週間ボーナス！
ENDSELECT

PRINTL
SIF LOCAL:5 < 7
	PRINTFORML （7日連続ボーナスまで あと {7 - LOCAL:5} 日）
SAVEGLOBAL
DRAWLINE
WAIT
RETURN 0
