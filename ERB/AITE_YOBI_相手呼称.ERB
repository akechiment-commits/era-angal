;============================================================
; 学年判定関数  @GET_CHARA_GRADE, <キャラ番号>
;   1: 1年生 / 2: 2年生 / 3: 3年生 (あんず=72は3年扱い)
;============================================================
@GET_CHARA_GRADE, ARG
#FUNCTION
SELECTCASE ARG
	; 主人公 (ID 0: 転校生・2年生扱い)
	CASE 0
		RETURNF 2
	; 1年生 (ID 1～23: 1-A/1-B/1-C 計23名)
	CASE 1 TO 23
		RETURNF 1
	; 2年生 (ID 24～44: 2-A/2-B/2-C 計21名)
	CASE 24 TO 44
		RETURNF 2
	; 3年生 (ID 45～71: 3-A/3-B/3-C 計27名、あんず 72 [3年扱い])
	CASE 45 TO 72
		RETURNF 3
	CASEELSE
		RETURNF 0
ENDSELECT
