;============================================================
; 相手呼称システム  @AITE_YOBI, <話者番号>, <相手番号>
;   RESULTS に「話者が相手をどう呼ぶか」を返す共通関数。
;   (1)話者別の既定呼称ルール → (2)個別の特別呼称で上書き
;   ※(2)にはデフォルトと異なる呼称(親しい相手の呼び方/あだ名)を保持
;   裏取り: tools/output 分析/関係性分析/全セリフ集+scenarios+ロスター
;   ※文字列は書式代入 '= @"..." 形式（リファレンス準拠）
;============================================================
@AITE_YOBI, ARG, ARG:1
#DIM SP
#DIM AI
#DIM AI_SLOT
#DIMS SUR
	SP = ARG
	AI_SLOT = ARG:1
	SIF AI_SLOT < 0 || AI_SLOT >= CHARANUM
		AI_SLOT = PLAYER
	SIF AI_SLOT < 0 || AI_SLOT >= CHARANUM
		AI_SLOT = 0
	IF AI_SLOT == 0
		AI = NO:0
	ELSEIF NO:AI_SLOT > 0
		AI = NO:AI_SLOT
	ELSE
		AI = AI_SLOT
	ENDIF
	;苗字（フルネームから呼び名を除去）
	SUR '= REPLACE(NAME:AI_SLOT, CALLNAME:AI_SLOT, "")
	SUR '= REPLACE(SUR, "・", "")
	SIF SUR == ""
		SUR '= CALLNAME:AI_SLOT
	;--- (1) 話者別の既定呼称 ---
	SELECTCASE SP
		CASE 1, 2, 3, 4, 6, 8, 9, 12, 13, 16, 18, 20, 21
			;1年生標準: 上級生(2年・3年)は「苗字+先輩」、同級生(1年)は「苗字+さん」
			IF GET_CHARA_GRADE(AI) > 1
				RESULTS '= @"%SUR%先輩"
			ELSE
				RESULTS '= @"%SUR%さん"
			ENDIF
		CASE 5, 7, 11, 15, 17, 22
			;あすか/ちあき/くるみ/やえ: 上級生(2年・3年)は「苗字+先輩」、同級生(1年)は「名前+ちゃん」
			IF GET_CHARA_GRADE(AI) > 1
				RESULTS '= @"%SUR%先輩"
			ELSE
				RESULTS '= @"%CALLNAME:AI_SLOT%ちゃん"
			ENDIF
		CASE 10
			;木之下ゆゆ: 上級生(2年・3年)は「名前+おねーさん」、同級生(1年)は「名前+ちゃん」
			IF GET_CHARA_GRADE(AI) > 1
				RESULTS '= @"%CALLNAME:AI_SLOT%おねーさん"
			ELSE
				RESULTS '= @"%CALLNAME:AI_SLOT%ちゃん"
			ENDIF
		CASE 14
			;花音ことり: 苗字+しゃん付け
			RESULTS '= @"%SUR%しゃん"
		CASE 46, 49, 50, 52, 56, 57, 60, 62
			;双葉みづき/小松ぼたん/山條ぎん/湖南やこ/八壁ひかる/岩戸サン/瀬川かえで/黒森すず: 苗字で呼び捨て
			RESULTS '= @"%SUR%"
		CASE 47, 63, 66, 72
			;双葉みなづき/八雲ちづる/曽根セイラ/あんず: 名前+ちゃん
			RESULTS '= @"%CALLNAME:AI_SLOT%ちゃん"
		CASE 26, 33
			;堀田さあや/柊るな: 上級生(3年)は「苗字+先輩」、同級生・下級生(2年・1年)は「苗字呼び捨て」
			IF GET_CHARA_GRADE(AI) > 2
				RESULTS '= @"%SUR%先輩"
			ELSE
				RESULTS '= @"%SUR%"
			ENDIF
		CASE 27, 35, 36, 40, 41, 42, 43, 44
			;夏野ゆり/梅園かな/遠見ちか/夜霧はやて/悠木ともこ/榊むつみ/砂賀みどり/笹芽ひよの: 上級生(3年)は「苗字+先輩」、同級生・下級生(2年・1年)は「苗字+さん」
			IF GET_CHARA_GRADE(AI) > 2
				RESULTS '= @"%SUR%先輩"
			ELSE
				RESULTS '= @"%SUR%さん"
			ENDIF
		CASE 29, 34
			;春風なな/桐島かいり: 上級生(3年)は「苗字+先輩」、同級生・下級生(2年・1年)は「名前+ちゃん」
			IF GET_CHARA_GRADE(AI) > 2
				RESULTS '= @"%SUR%先輩"
			ELSE
				RESULTS '= @"%CALLNAME:AI_SLOT%ちゃん"
			ENDIF
		CASE 30
			;長居ゆう: 上級生(3年)は「苗字+先輩」、同級生(2年)は「名前+ちゃん」、下級生(1年)は「苗字+さん」
			IF GET_CHARA_GRADE(AI) > 2
				RESULTS '= @"%SUR%先輩"
			ELSEIF GET_CHARA_GRADE(AI) == 2
				RESULTS '= @"%CALLNAME:AI_SLOT%ちゃん"
			ELSE
				RESULTS '= @"%SUR%さん"
			ENDIF
		CASE 19, 23
			;みけ/こはる: 上級生(2年・3年)は「苗字+先輩」、同級生(1年)は呼び名で呼び捨て
			IF GET_CHARA_GRADE(AI) > 1
				RESULTS '= @"%SUR%先輩"
			ELSE
				RESULTS '= @"%CALLNAME:AI_SLOT%"
			ENDIF
		CASE 58
			;天宮るり: 全員ちゃん付け
			RESULTS '= @"%CALLNAME:AI_SLOT%のひと"
		CASE 64
			;峰山しおん: 苗字+くん付け
			RESULTS '= @"%SUR%くん"
		CASE 70, 71
			;神無月ほとり/棗ひびき: 苗字+ちゃん付け
			RESULTS '= @"%SUR%ちゃん"
		CASE 25, 28, 45, 48, 54, 55, 65, 67, 68, 69
			;八朔つゆり/星海こよい/円城寺れいか/四方みつる/久坂あやめ/伊藤さくら/時国そら/日滝ましろ/深鳥ふみ/神樹はじめ: 苗字+さん付け
			RESULTS '= @"%SUR%さん"
		CASE 51
			;御影かすみ: 名前+屋さん（独特の呼称・119回以上登場）
			RESULTS '= @"%CALLNAME:AI_SLOT%屋さん"
		CASE 53
