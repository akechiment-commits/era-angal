			;水嶌うしお/鶴海ひまり: 呼び名で呼び捨て
			RESULTS '= @"%CALLNAME:AI_SLOT%"
		CASE 31
			;夢路まりあ: 呼び名+様付け
			RESULTS '= @"%CALLNAME:AI_SLOT%様"
