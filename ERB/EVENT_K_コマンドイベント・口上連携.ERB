;--------------------------------------------------
;自動喘ぎ関数@TRAINVOICE
;及びその子供関数
;好きな口上ファイルの
;@KOJO_MESSAGE_COM_X1
;の下に
;CALL TRAINVOICE
;RETURN 0
;の二行を加えるだけで簡易喘ぎ声をある程度シチュに応じて自動生成
;現在、調整不測のためネタ機能の域を出ないと思います
;口上未実装のキャラに自動で喘ぎ声を付けるようにしてもいいですが
;その場合素質を見て性格分岐させたいところ。要改良
;--------------------------------------------------
@TRAINVOICE
;Aに喘ぎ回数を入れる処理
;Bに行為レベルをとりあえず0～3で規定

A = 0
B = 0
C = 0

;コマンドごとの喘ぎ数・基本行為レベル（激しさ数値）を設定
;愛撫・性交系は欲情が大きいと喘ぎ数が+3まで増えます
;愛撫・性交系
;最も軽い　愛撫・胸愛撫・アナル愛撫・アナル舐め・素股・200,乳の揉み合い
IF SELECTCOM == 0 || SELECTCOM == 5 || SELECTCOM == 2 || SELECTCOM == 9 || SELECTCOM == 33 || SELECTCOM == 166 || SELECTCOM == 200	; 【コマンド:[愛撫] / コマンド:[胸愛撫] / コマンド:[アナル愛撫] / コマンド:[アナル舐め] / コマンド:[素股] / コマンド:[乳の揉み合い]】
	A = 1
	B = 0
	SIF PALAMLV:2 > 1
		A += 1
	SIF PALAMLV:2 > 2
		A += 1
	SIF PALAMLV:2 > 4
		A += 1
;最も軽い　非ウフフ時のスキンシップ系
ELSEIF SELECTCOM == 303 || (TFLAG:45 == 0 && SELECTCOM == 306) || (TFLAG:45 == 0 && SELECTCOM == 307) || SELECTCOM == 312 || SELECTCOM == 360 || SELECTCOM == 361 || SELECTCOM == 370	; 【コマンド:[スキンシップ] / コマンド:[髪梳き] / コマンド:[櫛で梳かす] / コマンド:[頭を撫でる] / コマンド:[胸愛撫] / コマンド:[愛撫] / コマンド:[抱き合う] / 無[主導権]】
	A = 1
	B = 0
	;現在の好感度か歓楽ソースが0以下かつ大成功でないなら感じていない口上へ
	IF (TFLAG:30<= 0 || SOURCE:18 <= 0) && TFLAG:18 != 1	; 【[現在の好感度]<=0 / [好感触]!=1】
		C = 0
	ELSE
		C = 1
	ENDIF
;軽め　クンニ・ローター・指挿入れ・フェラする・泡踊り・岩清水・自慰・
ELSEIF SELECTCOM < 4 || SELECTCOM == 10 || SELECTCOM == 8 || SELECTCOM == 4 || SELECTCOM == 35 || SELECTCOM == 87 || SELECTCOM == 3 || SELECTCOM == 362	; 【コマンド:[ローター] / コマンド:[指挿入れ] / コマンド:[フェラする] / コマンド:[泡踊り] / コマンド:[自慰]】
	A = 2
	B = 1
	SIF PALAMLV:2 > 1
		A += 1
	SIF PALAMLV:2 > 2
		A += 1
	SIF PALAMLV:2 > 4
		A += 1
;ちょい重め　Ｇスポット刺激・Ｅマッサージャー・191,手淫する-195,騎乗位する・204,アナルに入れさせる
ELSEIF SELECTCOM == 84 || SELECTCOM == 12 || (SELECTCOM >= 191 && SELECTCOM <= 195) || SELECTCOM == 204 || SELECTCOM == 364	; 【コマンド:[Ｇスポット刺激] / コマンド:[アナルに入れさせる] / コマンド:[着衣Ｇスポット刺激]】
	A = 3
	B = 2
	SIF PALAMLV:2 > 1
		A += 1
	SIF PALAMLV:2 > 2
		A += 1
	SIF PALAMLV:2 > 4
		A += 1
;本番　セックス系全部・196,ペニバン挿入・非ウフフ時のセックス系全部
ELSEIF (SELECTCOM > 19 && SELECTCOM < 30) || SELECTCOM == 64 || SELECTCOM == 34 || SELECTCOM == 36 || SELECTCOM == 167 || SELECTCOM == 168 || SELECTCOM == 196 || SELECTCOM == 255 || SELECTCOM == 256 || SELECTCOM == 363 || SELECTCOM == 365 || SELECTCOM == 366	; 【コマンド:[騎乗位] / コマンド:[騎乗位アナル] / コマンド:[ペニバン挿入] / コマンド:[挿入Ｇスポ責め] / コマンド:[挿入子宮口責め] / コマンド:[着衣挿入] / コマンド:[着衣後背位] / コマンド:[着衣騎乗位]】
	A = 3
	B = 3
	SIF PALAMLV:2 > 1
		A += 1
	SIF PALAMLV:2 > 2
		A += 1
	SIF PALAMLV:2 > 4
		A += 1
ENDIF

;玩具装備・解除系
;クリップ系　クリキャップ・ニプルキャップ
IF SELECTCOM == 14 || SELECTCOM == 15 || SELECTCOM == 103 || SELECTCOM == 104	; 【コマンド:[クリキャップ] / コマンド:[二プルキャップ]】
	A = 1
	B = 1
;重め系　搾乳機・アナルビーズ・オナホール・アナル電極
ELSEIF SELECTCOM == 16 || SELECTCOM == 17 || SELECTCOM == 19 || SELECTCOM == 49 || SELECTCOM == 105 || SELECTCOM == 109	; 【コマンド:[搾乳機] / コマンド:[オナホール] / コマンド:[アナルビーズ]】
	A = 2
	B = 3
;挿入系　バイブ・アナルバイブ・クスコ
ELSEIF SELECTCOM == 11 || SELECTCOM == 13 || SELECTCOM == 110 || SELECTCOM == 101 || SELECTCOM == 102	; 【コマンド:[バイブ] / コマンド:[アナルバイブ] / コマンド:[クスコ]】
	A = 1
	B = 2
ENDIF

;どれくらい感じてるかチェック
;ソースに対応した感覚が2以上なら1、4以上なら2。高い方を優先
IF A
	SIF SOURCE:0 && ABL:3 > 1	; 【[Ｃ感覚]Lv>1】
		C = 1
	SIF SOURCE:0 && ABL:3 > 3	; 【[Ｃ感覚]Lv>3】
		C = 2
	SIF SOURCE:1 && ABL:4 > 1 && C == 0	; 【[Ｖ感覚]Lv>1】
		C = 1
	SIF SOURCE:1 && ABL:4 > 3	; 【[Ｖ感覚]Lv>3】
		C = 2
	SIF SOURCE:2 && ABL:5 > 1 && C == 0	; 【[Ａ感覚]Lv>1】
		C = 1
	SIF SOURCE:2 && ABL:5 > 3	; 【[Ａ感覚]Lv>3】
		C = 2
	SIF SOURCE:17 && ABL:14 > 1 && C == 0	; 【[Ｂ感覚]Lv>1】
		C = 1
	SIF SOURCE:17 && ABL:14 > 3	; 【[Ｂ感覚]Lv>3】
		C = 2
	;感じていない口上へ
	IF C == 0
		;キャラ別
		TRYCCALLFORM VOICE_K{NO:TARGET}_B
		CATCH
			;個別ないなら共通
			CALL VOICE_B
		ENDCATCH
	ENDIF
	;感覚4以上だと激しさ+1
	SIF C == 2
		B += 1
	;そして開発済み口上へ
	IF C > 0
		;キャラ別
		TRYCCALLFORM VOICE_K{NO:TARGET}_A
		CATCH
			;個別ないなら共通
			CALL VOICE_A
		ENDCATCH
	ENDIF
ENDIF

