;キャラ別
TRYCALLFORM KOJO_MESSAGE_PLAYERCHANGE_{NO:ASSI}

;--------------------------------------------------
;@KOJO_MESSAGE_COM関係
;コマンド実行時に出力されます
;--------------------------------------------------
@KOJO_MESSAGE_COM
;気絶中は口上を一切出力しない
SIF TARGET >= 0 && (TFLAG:899 || BASE:TARGET:0 <= 0)	; 【[気絶継続中] / TARGET:[体力]<=0】
	RETURN 0
SIF FLAG:7 <= 0
	RETURN 0

;特定のアイテム使用時に口上非表示コンフィグONの場合、
;対応していない口上が多いTEQUIP装着時、口上を呼び出し可能か確認
;TEQUIP装着を想定している口上は@KOJO_TEQUIP_ABLE_X1で各TEQUIP装着時にRETURN 1することで口上表示
;想定していない口上（TEQUIP設定前に更新終了した口上等）は自動でRETURN 0になり口上表示しない
IF FLAG:23 &1p30
	IF TEQUIP:オムツ || TEQUIP:着衣ローター || TEQUIP:MASTER:アイマスク || TEQUIP:MASTER:縄で緊縛 || TEQUIP:MASTER:ボールギャグ
		;キャラ別
		TRYCALLFORM KOJO_TEQUIP_ABLE_K{NO:TARGET}
		SIF RESULT == 0
			RETURN 0
	ENDIF
ENDIF

;嫌悪時（好感度-100以下）は対象コマンドで専用口上を優先
IF TARGET >= 0 && CFLAG:TARGET:2 <= -100 && (SELECTCOM == 0 || SELECTCOM == 1 || SELECTCOM == 4 || SELECTCOM == 5 || SELECTCOM == 8 || SELECTCOM == 191 || SELECTCOM == 301 || SELECTCOM == 303 || SELECTCOM == 311 || (SELECTCOM >= 500 && SELECTCOM <= 509))
	TRYCALLFORM KOJO_HATED_COM_K{NO:TARGET}
	SIF RESULT == 1
		RETURN 0
ENDIF

;助手実行時の口上分岐（新設ファイルPart12：対象の反応、レズっ気で分岐）
IF ASSIPLAY
	TRYCALLFORM KOJO_ASSI_COM_K{NO:TARGET}
	SIF RESULT == 1
		RETURN 0
ENDIF

;キャラ別
TRYCCALLFORM KOJO_MESSAGE_COM_{NO:TARGET}
CATCH
	;個別ないなら共通
	CALL TRAINVOICE
ENDCATCH

