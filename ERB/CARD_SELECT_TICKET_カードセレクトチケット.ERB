;==================================================
; カードセレクトチケット（ITEM:96）
; 全レア度・イベント限定を含む未所持カードを、キャラ→カードの順で選ぶ。
; 集合カードは個別展開済みのキャラ別IDを使い、キャラ番号0の旧元データは対象外。
; 閲覧中はキャラ追加・TARGET変更・チケット消費を行わない。
;==================================================

@CARD_SELECT_TICKET_USE
#DIM DYNAMIC SELECTED_CHAR, 1
#DIM DYNAMIC SELECTED_CARD, 1
IF ITEM:96 <= 0
	PRINTFORMW カードセレクトチケットを持っていません。
	RETURN 0
ENDIF
$CHOOSE_CHARACTER
CALL CARD_SELECT_TICKET_CHARACTER
SIF RESULT == 0
	RETURN 0
SELECTED_CHAR = RESULT
$CHOOSE_CARD
CALL CARD_SELECT_TICKET_CARD, SELECTED_CHAR
SIF RESULT == 0
	GOTO CHOOSE_CHARACTER
SELECTED_CARD = RESULT
CALL CARD_GET_DATA, SELECTED_CARD
DRAWLINE
PRINTFORML 【%STR:0%】を入手しますか？
PRINTFORML カードセレクトチケットを1枚使用します。（所持{ITEM:96}枚）
PRINTL [1] このカードを入手する
PRINTL [0] カード選択へ戻る
$CONFIRM
INPUT
IF RESULT == 0
	GOTO CHOOSE_CARD
ELSEIF RESULT != 1
	GOTO CONFIRM
ENDIF
CALL CARD_SELECT_TICKET_CLAIM, SELECTED_CARD
RETURN RESULT

;選択候補と引換直前の両方で、実データと所持枚数を検査する。
;ARG:1 = 0はキャラ指定なし。RESULT:1～4とSTR:0はカードデータを保持する。
@CARD_SELECT_TICKET_IS_MISSING, ARG, ARG:1 = 0
#DIM DYNAMIC CARD_KEY, 1
SIF ARG < 1 || ARG > 1884
	RETURN 0
CALL CARD_GET_DATA, ARG
SIF RESULT:1 < 1 || RESULT:1 >= 200 || RESULT:2 < 1 || RESULT:2 > 6
	RETURN 0
SIF ARG:1 > 0 && RESULT:1 != ARG:1
	RETURN 0
CARD_KEY = 3000 + ARG
SIF FLAG:CARD_KEY > 0
	RETURN 0
RETURN 1

@CARD_SELECT_TICKET_CHARACTER
#DIM DYNAMIC MISSING, 200
#DIM DYNAMIC CHAR_LIST, 201
#DIM DYNAMIC CARD_ID, 1
#DIM DYNAMIC CNO, 1
#DIM DYNAMIC TOTAL, 1
#DIM DYNAMIC PAGE, 1
#DIM DYNAMIC PAGES, 1
#DIM DYNAMIC OFFSET, 1
#DIM DYNAMIC VISIBLE, 1
#DIM DYNAMIC ROW, 1
#DIM DYNAMIC POSITION, 1
TOTAL = 0
PAGE = 1
FOR CARD_ID, 1, 1885
	CALL CARD_SELECT_TICKET_IS_MISSING, CARD_ID
	IF RESULT == 1
		CNO = RESULT:1
		MISSING:CNO += 1
	ENDIF
NEXT
FOR CNO, 1, 200
	IF MISSING:CNO > 0
		TOTAL += 1
		CHAR_LIST:TOTAL = CNO
	ENDIF
NEXT
IF TOTAL == 0
	PRINTFORMW 未所持カードはありません。チケットは消費しません。
	RETURN 0
ENDIF
PAGES = (TOTAL + 14) / 15
$PAGE
OFFSET = (PAGE - 1) * 15
VISIBLE = TOTAL - OFFSET
SIF VISIBLE > 15
	VISIBLE = 15
DRAWLINE
PRINTFORML 【カードセレクト：キャラ選択 {PAGE}/{PAGES}】
PRINTFORML チケット：{ITEM:96}枚　全レア度・イベントカードから未所持の1枚を選べます。
FOR ROW, 1, VISIBLE + 1
	POSITION = OFFSET + ROW
	CNO = CHAR_LIST:POSITION
	PRINTFORML [{ROW,2}] %CSVNAME(CNO, 0)%（未所持{MISSING:CNO}種）
NEXT
PRINTL [16] 前ページ　[17] 次ページ　[18] 先頭　[19] 最後
PRINTL [0] 戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT >= 1 && RESULT <= VISIBLE
	POSITION = OFFSET + RESULT
	RETURN CHAR_LIST:POSITION
ELSEIF RESULT == 16
	SIF PAGE > 1
		PAGE -= 1
ELSEIF RESULT == 17
	SIF PAGE < PAGES
		PAGE += 1
ELSEIF RESULT == 18
	PAGE = 1
ELSEIF RESULT == 19
	PAGE = PAGES
ENDIF
GOTO PAGE

@CARD_SELECT_TICKET_CARD, ARG
#DIM DYNAMIC CARD_LIST, 1885
#DIM DYNAMIC CARD_ID, 1
#DIM DYNAMIC TOTAL, 1
#DIM DYNAMIC PAGE, 1
#DIM DYNAMIC PAGES, 1
#DIM DYNAMIC OFFSET, 1
#DIM DYNAMIC VISIBLE, 1
#DIM DYNAMIC ROW, 1
#DIM DYNAMIC POSITION, 1
SIF ARG < 1 || ARG >= 200
	RETURN 0
TOTAL = 0
PAGE = 1
FOR CARD_ID, 1, 1885
	CALL CARD_SELECT_TICKET_IS_MISSING, CARD_ID, ARG
	IF RESULT == 1
		TOTAL += 1
		CARD_LIST:TOTAL = CARD_ID
	ENDIF
NEXT
IF TOTAL == 0
	PRINTFORMW このキャラの未所持カードはありません。チケットは消費しません。
	RETURN 0
ENDIF
PAGES = (TOTAL + 14) / 15
$PAGE
OFFSET = (PAGE - 1) * 15
VISIBLE = TOTAL - OFFSET
SIF VISIBLE > 15
	VISIBLE = 15
DRAWLINE
PRINTFORML 【%CSVNAME(ARG, 0)%：未所持カード {PAGE}/{PAGES}】
FOR ROW, 1, VISIBLE + 1
	POSITION = OFFSET + ROW
	CARD_ID = CARD_LIST:POSITION
	CALL CARD_GET_DATA, CARD_ID
	IF RESULT:2 == 1
		LOCALS = N
	ELSEIF RESULT:2 == 2
		LOCALS = R
	ELSEIF RESULT:2 == 3
		LOCALS = HR
	ELSEIF RESULT:2 == 4
		LOCALS = SR
	ELSEIF RESULT:2 == 5
		LOCALS = UR
	ELSE
		LOCALS = MR
	ENDIF
	PRINTFORML [{ROW,2}] 【%LOCALS%】%STR:0%
NEXT
PRINTL [16] 前ページ　[17] 次ページ　[18] 先頭　[19] 最後
PRINTL [0] キャラ選択へ戻る
INPUT
IF RESULT == 0
	RETURN 0
ELSEIF RESULT >= 1 && RESULT <= VISIBLE
	POSITION = OFFSET + RESULT
	RETURN CARD_LIST:POSITION
ELSEIF RESULT == 16
	SIF PAGE > 1
		PAGE -= 1
ELSEIF RESULT == 17
	SIF PAGE < PAGES
		PAGE += 1
ELSEIF RESULT == 18
	PAGE = 1
ELSEIF RESULT == 19
	PAGE = PAGES
ENDIF
GOTO PAGE

@CARD_SELECT_TICKET_CLAIM, ARG
IF ITEM:96 <= 0
	PRINTFORMW カードセレクトチケットを持っていません。
	RETURN 0
ENDIF
CALL CARD_SELECT_TICKET_IS_MISSING, ARG
IF RESULT == 0
	PRINTFORMW このカードは選べません。チケットは消費しません。
	RETURN 0
ENDIF
ITEM:96 -= 1
PRINTFORML カードセレクトチケットを1枚使用しました。（残り{ITEM:96}枚）
CALL GACHA_ACQUIRE_CARD, ARG
CALL CARD_RECALC_BONUSES
RETURN 1
