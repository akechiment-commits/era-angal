	EXISTCSV LOCAL,0
	IF RESULT == 1
		FLAG:(999+LOCAL) = 1
	ELSE
		CONTINUE
	ENDIF
NEXT
; あんず(NO=72)は初回ニューゲームでは選択不可。エンディング到達で解禁される(ENDING側で FLAG:1071=2 を立てる)
FLAG:1071 = 0

PBAND = 4

FLAG:6 = 1
TIME:6 = 2

;難易度廃止（固定値）
FLAG:5 = 1
FLAG:3 = 0
FLAG:2 = 0

;開始日は4月1日固定
