SKIPDISP 0

;待機中行動口上が一つ以上ある場合
IF LOCAL:3
	B = Y:(RAND:(LOCAL:3))
	TARGET = B
	TFLAG:17 = CFLAG:B:13
	PRINTL 
	PRINTFORML ＜%CALLNAME:B%待機中＞
	CALL KOJO_TAIKI
ENDIF
TARGET = LOCAL:2
IF LOCAL:1
	TARGET = -1
