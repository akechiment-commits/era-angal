;v1.05.7でFLAG:63 == 4使用
IF FLAG:63 == 4
	FLAG:63 = 5
ENDIF

;v1.05.9でFLAG:63 == 5使用
IF FLAG:63 == 5
	;コンフィグ整理
	SIF FLAG:23 & 128
		FLAG:23 -= 128
	SIF FLAG:23 & 256
		FLAG:23 -= 256
