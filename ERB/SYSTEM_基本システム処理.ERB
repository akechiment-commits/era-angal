	PRINTL [0]質問形式
	PRINTL [1]一覧から選択形式
	PRINTL [2]デフォルトのまま開始
	$INPUT_LOOP_MTS
	INPUT
	IF RESULT == 0
		CALL MASTER_TALENT_SET_Q
		CALL BIRTHDAY
		CALL STORE_GLOBAL_TALENT_SET
	ELSEIF RESULT == 1
		CALL MASTER_TALENT_SET_DEFAULT
		CALL MASTER_TALENT_SET
	ELSEIF RESULT == 2
		CALL MASTER_TALENT_SET_DEFAULT
	ELSE
		PRINTFORML 正しい値を入力してください
		GOTO INPUT_LOOP_MTS
	ENDIF
ENDIF

