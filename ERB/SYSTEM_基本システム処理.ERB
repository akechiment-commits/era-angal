;-------------------------------------------------
;セーブデータ互換処理
;-------------------------------------------------
@SAVEDATA_CONVERT
;以下のセーブデータ互換処理は既に必要無さそうなので削除しました
;異常経験保存フラグ互換
;主人公の体力と耐力互換
;空中船キャラ番号調整

REPEAT CHARANUM
	;本来休憩所預かりフラグが立たないキャラにフラグが立っていたら消去
	SIF COUNT == MASTER || COUNT == ASSI || COUNT == TARGET
		CFLAG:COUNT:16 = 0
	;本来別れフラグが立たないキャラにフラグが立っていたら消去
	SIF COUNT == MASTER
		CFLAG:COUNT:21 = 0
REND

;FLAG:63をセーブデータ互換処理に使用（元は調合の互換処理に使用していたフラグ）
;ニューゲーム時用
IF FLAG:63 == 0
	FLAG:63 = 20
ENDIF

;v1.01.1でFLAG:63 === 1使用
;v1.01.4でFLAG:63 === 2使用
IF FLAG:63 <= 2
	FLAG:63 = 3
ENDIF

;v1.04.9でFLAG:63 == 3使用
IF FLAG:63 == 3
	;一部の口上と干渉する可能性のあるCFLAG(キャラID)を移動
	REPEAT CHARANUM
		CFLAG:COUNT:81 = CFLAG:COUNT:182
		CFLAG:COUNT:182 = 0
	REND
	FLAG:63 = 4
