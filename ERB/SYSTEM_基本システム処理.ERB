;v1.06.0でFLAG:63 == 6使用
IF FLAG:63 == 6
	;コンフィグ整理
	SIF FLAG:62 & 16
		FLAG:62 -= 16
	SIF FLAG:62 & 128
		FLAG:62 -= 128
	SIF FLAG:62 & 1024
		FLAG:62 -= 1024
	SIF FLAG:62 & 2097152
		FLAG:62 -= 2097152
	FLAG:63 = 7
ENDIF

;v1.06.3でFLAG:63 == 7使用
IF FLAG:63 == 7
	;J用アイテムをいくつか所持させる
	ITEM:500 = 1
	ITEM:503 = 1
	ITEM:506 = 1
	ITEM:510 = 1
	
	;妊娠期間判定用のDAY:7設定
	DAY:7 = DAY
	FLAG:63 = 8
