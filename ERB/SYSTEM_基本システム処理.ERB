	SIF COUNT == MASTER
		CONTINUE
	ABL:COUNT:93 = ABL:COUNT:54 / 10	;運動技能 初期値
	ABL:COUNT:94 = ABL:COUNT:55 / 10	;表現技能 初期値
	ABL:COUNT:95 = ABL:COUNT:56 / 10	;知識技能 初期値
	CALL CALC_ACADEMIC_LEVEL, COUNT
REND

;種族設定
TRYCALL GET_STRAINVALUE

PRINTL オープニングを見ますか？
PRINTL [0] はい
PRINTL [1] いいえ

$INPUT_LOOP_5
INPUT

IF RESULT < 0 || RESULT > 1
	PRINTFORML 正しい値を入力してください
	GOTO INPUT_LOOP_5
ELSEIF RESULT == 0
	;汎用オープニングの後に、選択したキャラの初対面口上を流す
	LOCAL:0 = TARGET
	TARGET = -1
	TFLAG:600 = 28
	CALL KOJO_JUN
	TARGET = LOCAL:0
	TFLAG:600 = 28
	CALL KOJO_JUN
ENDIF

;エクストラ構文の呼び出し
TFLAG:600 = 0
CALL KOJO_JUN

;ニューゲームでもログイン報酬の前に新フラグ領域を初期化
CALL CUSTOM_FLAG_MIGRATION
FLAG:15007 = 0
LOADGLOBAL
CALL LOGIN_BONUS_CHECK
BEGIN SHOP

@EVENTCOM
#PRI
	;パートナーと一緒に過ごした時間加算
	IF TARGET >= 1 && TARGET < CHARANUM
		CFLAG:TARGET:1200 += 1
		IF TFLAG:44 != 0	; 【[ウフフ中]】
			CFLAG:TARGET:1212 += 1
		ELSE
			CFLAG:TARGET:1211 += 1
		ENDIF
		;着用衣装のターン数加算
		IF TEQUIP:TARGET:65 > 0	; 【[コスプレ]>0】
			LOCAL:65 = TEQUIP:TARGET:65
			CFLAG:TARGET:(1300 + LOCAL:65) += 1
			IF CFLAG:TARGET:(1300 + LOCAL:65) > CFLAG:TARGET:1217	; 【TARGET:[最多衣装着用ターン数]】
				CFLAG:TARGET:1217 = CFLAG:TARGET:(1300 + LOCAL:65)
				CFLAG:TARGET:1216 = LOCAL:65
			ENDIF
		ENDIF
	ENDIF
;TFLAG:0-29,100,540毎ターンリセット
REPEAT 30
	TFLAG:COUNT = 0
REND
TFLAG:100 = 0
TFLAG:540 = 0
;コマンド開始時の耐力を記録（今回出し切ったか判定用）
TFLAG:993 = BASE:MASTER:4
;自慰・レズ経験のセッション開始値を保存（デルタ判定用）
SIF TARGET >= 0
	TFLAG:55 = EXP:10
SIF TARGET >= 0
	TFLAG:56 = EXP:40

;主導権設定
IF TARGET >= 0 && (TFLAG:899 || BASE:TARGET:0 <= 0)	; 【[気絶継続中] / TARGET:[体力]<=0】
	TFLAG:45 = 0
ELSEIF (FLAG:23 & 8) == 0
	;主導権を毎回設定
	PRINTL 今回はどちらが主導権を握りますか？
	PRINTL [0] - 成り行きに任せる
	SIF ABL:0 >= 3 || CFLAG:2 >= 300 || TALENT:13 || TALENT:14 || TALENT:17 || TALENT:153	; 【[素直] / [大人しい] / [プライド低い] / [恋人] / [親密]Lv>=3 / [好感度]>=300】
		PRINTL [1] - 自分で握る
	SIF ABL:0 >= 3 || CFLAG:2 >= 300 || TALENT:83 || TALENT:153	; 【[サド] / [恋人] / [親密]Lv>=3 / [好感度]>=300】
		PRINTFORML [2] - %CALLNAME:TARGET%に握らせる

	INPUT
	IF (RESULT < 0 || RESULT > 2)
		RESTART
	ELSEIF RESULT == 0
		CFLAG:15 = 0
	ELSEIF RESULT == 1 && (ABL:0 >= 3 || CFLAG:2 >= 300 || TALENT:13 || TALENT:14 || TALENT:17 || TALENT:153)	; 【[素直] / [大人しい] / [プライド低い] / [恋人] / [親密]Lv>=3 / [好感度]>=300】
		CFLAG:15 = 1
		TFLAG:45 = 0
	ELSEIF RESULT == 1
		RESTART
	ELSEIF RESULT == 2 && (ABL:0 >= 3 || CFLAG:2 >= 300 || TALENT:83 || TALENT:153)	; 【[サド] / [恋人] / [親密]Lv>=3 / [好感度]>=300】
		CFLAG:15 = 2
		TFLAG:45 = 1
	ELSEIF RESULT == 2
		RESTART
	ENDIF
ENDIF
;成り行きに任せる場合の判定
IF TARGET >= 0 && (TFLAG:899 || BASE:TARGET:0 <= 0)	; 【[気絶継続中] / TARGET:[体力]<=0】
	TFLAG:45 = 0
ELSEIF CFLAG:15 == 0	; 【[主導権設定]==0】
	T = TARGET
	CALL GET_INITIATIVE_RATE
	A = RAND:101 - 50
	IF A < R
		;主人公側の主導権ポイントが低い場合、相手が握る
		TFLAG:45 = 1
	ELSE
		;それ以外なら主人公が握る
		TFLAG:45 = 0
	ENDIF
;自分で握る場合の判定
ELSEIF CFLAG:15 == 1	; 【[主導権設定]==1】
	TFLAG:45 = 0

	T = TARGET
	CALL GET_INITIATIVE_RATE
	;相手の主導権ポイントが極端に高いと、たまに持っていかれる
	IF R >= 50
		A = R / 10
		SIF A > 15
			A = 15
		IF A > RAND:100
			;相手が握る
			PRINTFORMW %CALLNAME:PLAYER%が主導権を握っていたはずが、気がつくと%CALLNAME:TARGET%に主導権を奪われていた……
			TFLAG:45 = 1
		ENDIF
	ENDIF

;相手に握らせる場合の判定
ELSEIF CFLAG:15 == 2	; 【[主導権設定]==2】
	TFLAG:45 = 1

	T = TARGET
	CALL GET_INITIATIVE_RATE
	;相手の主導権ポイントが極端に低いと、たまに持ってきてしまう
	IF R <= -50
		R = R * -1
		A = R / 10
		SIF A > 15
			A = 15
		IF A > RAND:100
			;主人公が握る
			PRINTFORMW %CALLNAME:TARGET%に主導権を握らせていたはずが、気がつくと%CALLNAME:PLAYER%が主導権を握ってしまっていた……
			TFLAG:45 = 0
		ENDIF
	ENDIF
ENDIF


@EVENTCOMEND
#PRI
;体力0以下判定（気絶による調教継続はウフフ中 TFLAG:44 に限定）
IF TFLAG:44 && BASE:0 <= 0	; 【[ウフフ中] / [体力]<=0】
	;この調教で初めて気絶した時の通知
	IF TFLAG:898 == 0	; 【無[初回気絶]】
		TFLAG:898 = 1
		;主導権解除
		TFLAG:34 = 0
		TFLAG:45 = 0
		;事後行為と追加パートナーターンを止める
		TFLAG:301 = 1
		TFLAG:999 = 1
		SETCOLOR 0xFF4444
		PRINTFORMW （%CALLNAME:TARGET%は激しい消耗により限界を迎え、意識を失って気絶してしまった……！）
		RESETCOLOR
		PRINTFORMW （これ以降は、意識のない相手に対する一部の一方的なコマンドのみ実行可能です）
		IF TALENT:128	; 【[不死者]】
			PRINTW ＜リザレクション＞
			EXP:50 += 1
			PRINTL 異常経験＋１
		ENDIF
		IF ABL:0 > 0 && TALENT:153 == 0	; 【[恋人]なし / [親密]Lv>0】
			ABL:0 -= 1
			PRINTFORML %CALLNAME:TARGET%の親密が１下がった
		ENDIF
	ELSE
		;既に気絶中の場合の状況描写
		PRINTFORML （%CALLNAME:TARGET%はぐったりと気を失ったまま横たわっている……）
	ENDIF
	;体力の大幅なマイナス（極度の過負荷・心身損壊）ペナルティ
	;体力が-1000以下に達している場合、無理な調教の代償として最大体力・最大気力が少しずつ減少
	IF TARGET >= 0 && BASE:TARGET:0 <= -1000	; 【TARGET:[体力]】
		LOCAL:80 = 5 + LIMIT(ABS(BASE:TARGET:0) / 200, 1, 20)
		LOCAL:81 = 5 + LIMIT(ABS(BASE:TARGET:0) / 300, 1, 15)
		LOCAL:82 = 0
		IF MAXBASE:TARGET:0 > 500	; 【TARGET:[体力]>500】
			LOCAL:80 = MIN(LOCAL:80, MAXBASE:TARGET:0 - 500)
			MAXBASE:TARGET:0 -= LOCAL:80
			LOCAL:82 = 1
		ELSE
			LOCAL:80 = 0
		ENDIF
		IF MAXBASE:TARGET:1 > 500	; 【TARGET:[気力]>500】
			LOCAL:81 = MIN(LOCAL:81, MAXBASE:TARGET:1 - 500)
			MAXBASE:TARGET:1 -= LOCAL:81
			LOCAL:82 = 1
		ELSE
			LOCAL:81 = 0
		ENDIF
		IF LOCAL:82
			SETCOLOR 0xFF6666
			PRINTFORML （限界を遥かに超えた調教により、%CALLNAME:TARGET%の心身に過大な負荷がかかっている……）
			SIF LOCAL:80 > 0
				PRINTFORML 最大体力－{LOCAL:80}（現在：{MAXBASE:TARGET:0}）
			SIF LOCAL:81 > 0
				PRINTFORML 最大気力－{LOCAL:81}（現在：{MAXBASE:TARGET:1}）
			RESETCOLOR
		ENDIF
	ENDIF
	;※調教は強制終了せず続行可能（行動終了[999]等で終わるまでマイナス方向へ減り続けます）
ELSEIF TFLAG:44 == 0 && BASE:0 <= 0	; 【無[ウフフ中] / [体力]<=0】
	;非ウフフ（通常行動中）の体力切れは気絶継続せず終了
	TFLAG:999 = 1
	TFLAG:301 = 1
	TFLAG:51 = 2
	PRINTFORMW （%CALLNAME:TARGET%は疲労の限界を迎えて倒れ込んでしまった……）
	PRINTFORMW （%CALLNAME:MASTER%は%CALLNAME:TARGET%を休ませるため、一旦別れました）
	PRINTFORMW （%CALLNAME:TARGET%は衰弱療養中（お休み）となりました）
	BEGIN AFTERTRAIN
ELSEIF TFLAG:44 == 0 && BASE:1 <= 300 && CFLAG:27	; 【無[ウフフ中] / [金稼ぎ実行フラグ] / [気力]<=300】
	PRINTFORMW （%CALLNAME:TARGET%は何か用事があるようです。%CALLNAME:MASTER%は%CALLNAME:TARGET%と一旦別れました）
	IF BASE:0 <= 0	; 【[体力]<=0】
		TFLAG:301 = 1
		TFLAG:51 = 2
		PRINTFORMW （%CALLNAME:TARGET%は衰弱療養中（お休み）となりました）
	ENDIF
	BEGIN AFTERTRAIN
ELSEIF TFLAG:44 == 0 && BASE:1 <= 0	; 【無[ウフフ中] / [気力]<=0】
	;このコマンドで時間終了が確定したため、#LATERのパートナーターンを抑止する。
	TFLAG:999 = 1

	IF TIME == 0
		IF DAY:5 <= 4
			PRINTFORMW （授業が終わりました。%CALLNAME:MASTER%は%CALLNAME:TARGET%と一旦別れました）
		ELSE
			PRINTFORMW （そろそろ夕方です。%CALLNAME:MASTER%は%CALLNAME:TARGET%と一旦別れました）
		ENDIF
	ELSE
		PRINTFORMW （そろそろ眠る時間です。%CALLNAME:MASTER%は%CALLNAME:TARGET%と一旦別れました）
	ENDIF
	IF BASE:0 <= 0	; 【[体力]<=0】
		TFLAG:301 = 1
		TFLAG:51 = 2
		PRINTFORMW （%CALLNAME:TARGET%は衰弱療養中（お休み）となりました）
	ENDIF
	BEGIN AFTERTRAIN
ENDIF


@EVENTTURNEND
#PRI
VARSET LOCAL, 0
E = 0
F = 0
G = 0
H = 0
I = 0
;待機行動のペア処理フラグ初期化
FOR LOCAL:10, 0, CHARANUM
	CFLAG:(LOCAL:10):1290 = 0
NEXT

REPEAT CHARANUM
	Y:COUNT = -1
REND

;Phモード限定の霧飲まれチェック
IF FLAG:5 == 10 && TARGET >= 0
	SIF CFLAG:17	; 【[臨月・育児中]】
		CALL SET_TMP_PARTNER
ENDIF

;Phモード限定の淫乱ボーナス
IF FLAG:5 == 10 || TALENT:MASTER:淫乱ボーナス || TALENT:MASTER:淫乱ボーナス強化
	I = 0
	REPEAT CHARANUM
		SIF TALENT:COUNT:76	; 【COUNT:[淫乱]】
			I += 1
	REND
	SIF TALENT:MASTER:206	; 【MASTER:[淫乱ボーナス強化]】
		TIMES I , 3.00
ENDIF

;主人公の体力が残ってるかチェック
SIF BASE:MASTER:4 > 0	; 【MASTER:[耐力]>0】
	H = 1

;待機行動中に入手した経験や宝珠や好感度を表示する場合PRINTL 
;それが無くても宝探し詳細報告アリならPRINTL 
IF FLAG:23 & 1p25
	PRINTL 
ELSE
	IF FLAG:23 & 1024
		REPEAT CHARANUM
			IF CFLAG:COUNT:13 == 12	; 【COUNT:[待機中行動]==12】
				PRINTL 
				BREAK
			ENDIF
		REND
	ENDIF
ENDIF

REPEAT CHARANUM
	;別れているキャラは無視
	IF CFLAG:COUNT:21	; 【COUNT:[別れ]】
		;……しつつリング資金稼ぎ
		CALL TURNEND_EARN_MONEY_TM
		CONTINUE
	ENDIF
	
	;耐力と魔力の成長を計算
	IF COUNT == MASTER
		;主人公限定で、相手と主人公自身の絶頂経験で最大耐力増加
		IF MASTER_ENDURANCE_GROWTH() <= 100
			MAXBASE:COUNT:4 = MAXBASE:COUNT:0 * (100 + MASTER_ENDURANCE_GROWTH()) / 100
		ELSEIF MASTER_ENDURANCE_GROWTH() <= 700
			MAXBASE:COUNT:4 = MAXBASE:COUNT:0 * (300 + MASTER_ENDURANCE_GROWTH()) / 200
		ELSEIF MASTER_ENDURANCE_GROWTH() <= 100000
			MAXBASE:COUNT:4 = MAXBASE:COUNT:0 * (1300 + MASTER_ENDURANCE_GROWTH()) / 400
		ELSE
			;オーバーフロー対策
			IF 999999999999999999 / MAXBASE:COUNT:0 <= (1300 + MASTER_ENDURANCE_GROWTH()) / 400	; 【COUNT:[体力]】
				MAXBASE:COUNT:4 = 999999999999999999
			ELSE
				;オーバーフロー対策に先に100で割っておく
				MAXBASE:COUNT:4 = MAXBASE:COUNT:0 / 100 * (1300 + MASTER_ENDURANCE_GROWTH()) / 4
			ENDIF
		ENDIF
	ELSE
		;耐力＝体力を基準値として、絶頂経験と耐力枯渇経験で増加
		IF FEMALE_ENDURANCE_GROWTH(COUNT) <= 100
			MAXBASE:COUNT:4 = MAXBASE:COUNT:0 * (100 + FEMALE_ENDURANCE_GROWTH(COUNT)) / 100
		ELSEIF FEMALE_ENDURANCE_GROWTH(COUNT) <= 700
			MAXBASE:COUNT:4 = MAXBASE:COUNT:0 * (300 + FEMALE_ENDURANCE_GROWTH(COUNT)) / 200
		ELSEIF FEMALE_ENDURANCE_GROWTH(COUNT) <= 100000
			MAXBASE:COUNT:4 = MAXBASE:COUNT:0 * (1300 + FEMALE_ENDURANCE_GROWTH(COUNT)) / 400
		ELSE
			;オーバーフロー対策
			IF 999999999999999999 / MAXBASE:COUNT:0 <= (1300 + FEMALE_ENDURANCE_GROWTH(COUNT)) / 400	; 【COUNT:[体力]】
				MAXBASE:COUNT:4 = 999999999999999999
			ELSE
				;オーバーフロー対策に先に100で割っておく
				MAXBASE:COUNT:4 = MAXBASE:COUNT:0 / 100 * (1300 + FEMALE_ENDURANCE_GROWTH(COUNT)) / 4
			ENDIF
		ENDIF
	ENDIF

	IF COUNT == MASTER
		;主人公限定で魔力＝気力の約3%を基準値として、射精経験で増加
		IF EXP:COUNT:3 <= 100	; 【COUNT:[射精経験]<=100】
			MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 30 * (50 + EXP:COUNT:3) / 50
		ELSEIF EXP:COUNT:3 <= 400	; 【COUNT:[射精経験]<=400】
			MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 30 * (EXP:COUNT:3 - 25) / 25
		ELSEIF EXP:COUNT:3 <= 1000000	; 【COUNT:[射精経験]<=1000000】
			MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 30 * (EXP:COUNT:3 - 250) / 10
		ELSE
			;オーバーフロー対策
			IF 999999999999999999 / MAXBASE:COUNT:1 <= (EXP:COUNT:3 - 250) / 300	; 【COUNT:[射精経験]あり / COUNT:[気力]】
				MAXBASE:COUNT:5 = 999999999999999999
			ELSE
				;オーバーフロー対策に先に100で割っておく
				MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 300 * (EXP:COUNT:3 - 250)
			ENDIF
		ENDIF
	ELSE
		;魔力＝気力の10%を基準値として、精液経験で増加
		IF EXP:COUNT:20 <= 100	; 【COUNT:[精液経験]<=100】
			MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 10 * (50 + EXP:COUNT:20) / 50
		ELSEIF EXP:COUNT:20 <= 400	; 【COUNT:[精液経験]<=400】
			MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 10 * (EXP:COUNT:20 - 25) / 25
		ELSEIF EXP:COUNT:20 <= 1000000	; 【COUNT:[精液経験]<=1000000】
			MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 10 * (EXP:COUNT:20 - 250) / 10
		ELSE
			;オーバーフロー対策
			IF 999999999999999999 / MAXBASE:COUNT:1 <= (EXP:COUNT:20 - 250) / 100	; 【COUNT:[精液経験]あり / COUNT:[気力]】
				MAXBASE:COUNT:5 = 999999999999999999
			ELSE
				;オーバーフロー対策に先に100で割っておく
				MAXBASE:COUNT:5 = MAXBASE:COUNT:1 / 100 * (EXP:COUNT:20 - 250)
			ENDIF
		ENDIF
	ENDIF

	;Phモード限定の淫乱ボーナス
	IF FLAG:5 == 10 || TALENT:MASTER:淫乱ボーナス || TALENT:MASTER:淫乱ボーナス強化
		IF 999999999999999999 / (5 + I) * 5 <= MAXBASE:COUNT:4	; 【COUNT:[耐力]】
			MAXBASE:COUNT:4 = 999999999999999999
		ELSE
			MAXBASE:COUNT:4 = MAXBASE:COUNT:4 * (5 + I) / 5
		ENDIF
		IF 999999999999999999 / (5 + I) * 5 <= MAXBASE:COUNT:5
			MAXBASE:COUNT:5 = 999999999999999999
		ELSE
			MAXBASE:COUNT:5 = MAXBASE:COUNT:5 * (5 + I) / 5
		ENDIF
	ENDIF

	C = 0
	D = 0
;体力の回復
	IF COUNT == MASTER
		;主人公: 体力は昼10%、夜20%。耐力は昼夜切替(TIME==0)20%、日付切替(TIME==1)50%。
		IF TIME == 0
			A = MAXBASE:COUNT:0 / 10
			B = MAXBASE:COUNT:4 / 5
		ELSE
			A = MAXBASE:COUNT:0 / 5
			B = MAXBASE:COUNT:4 / 2
		ENDIF
	ELSE
		;女の子: 昼25%、夜50%
		IF TIME == 0
			A = MAXBASE:COUNT:0 / 4
			B = 0
		ELSE
			A = MAXBASE:COUNT:0 / 2
			B = 0
		ENDIF
	ENDIF

	;回復早い、回復遅い、吸血鬼、不死者
	IF TALENT:COUNT:128	; 【COUNT:[不死者]】
		A *= 3
		B *= 3
	ELSEIF TALENT:COUNT:111 || (TALENT:COUNT:114 && TALENT:COUNT:218 == 0)	; 【COUNT:[回復早い] / COUNT:[吸血鬼] / COUNT:[眷属]なし】
		A *= 2
		B *= 2
	ELSEIF TALENT:COUNT:114 && TALENT:COUNT:218	; 【COUNT:[吸血鬼] / COUNT:[眷属]】
		TIMES A , 1.5
		TIMES B , 1.5
	ELSEIF TALENT:COUNT:112	; 【COUNT:[回復遅い]】
		A /= 2
		B /= 2
	ENDIF
	
	;日光浴、月光浴、吸血鬼
	IF TIME == 0
		IF TALENT:COUNT:115 && TIME:5 == 1	; 【COUNT:[日光浴]】
			A += 400
			B += 400
		ELSEIF TALENT:COUNT:115 && (TIME:5 == 0 || TIME:5 == 7)	; 【COUNT:[日光浴]】
			A += 200
			B += 200
		ENDIF
	ELSE
		IF (TALENT:COUNT:114 || TALENT:COUNT:116) && TIME:5 == 1	; 【COUNT:[吸血鬼] / COUNT:[月光浴]】
			A += 400
			B += 400
			IF TALENT:COUNT:114 && TALENT:COUNT:218	; 【COUNT:[吸血鬼] / COUNT:[眷属]】
				A -= 200
				B -= 200
			ENDIF
		ELSEIF (TALENT:COUNT:114 || TALENT:COUNT:116) && TIME:5 == 0	; 【COUNT:[吸血鬼] / COUNT:[月光浴]】
			A += 200
			B += 200
			IF TALENT:COUNT:114 && TALENT:COUNT:218	; 【COUNT:[吸血鬼] / COUNT:[眷属]】
				A -= 100
				B -= 100
			ENDIF
		ENDIF
	ENDIF

	;治療
	IF ASSI >= 0
		IF (TALENT:ASSI:117 || TALENT:MASTER:117)	; 【ASSI:[治療] / MASTER:[治療]】
			A += 100
			B += 100
		ENDIF
	ELSE
		IF TALENT:MASTER:117	; 【MASTER:[治療]】
			A += 100
			B += 100
		ENDIF
	ENDIF

	;休憩フラグ（「何もしない」を選択、もしくは調教対象でない）
	IF FLAG:0 || TARGET != COUNT
		A += 100
		B += 100
	ENDIF

	;純愛版休憩フラグ
	IF FLAG:0 && COUNT == MASTER
		A += 300
		TIMES B , 1.30
	ENDIF
	IF FLAG:0 && COUNT == TARGET
		A += 100
		TIMES B , 1.20
		SIF TALENT:153 && BASE:COUNT:0 > 0	; 【[恋人] / COUNT:[体力]>0】
			CFLAG:2 += 1
	ENDIF
	IF FLAG:0 && COUNT == ASSI
		A += 100
		TIMES B , 1.20
		SIF TALENT:ASSI:153 && BASE:ASSI:0 > 0	; 【ASSI:[恋人] / ASSI:[体力]>0】
			CFLAG:ASSI:2 += 1
	ENDIF

	;維持費算出
	IF ABL:COUNT:97 == 0	; 【COUNT:[浪費癖]Lv==0】
		;浪費癖未設定＝Lv50相当
		C = 2000
		;戦闘技能レベルによって増加
		C += ABL:COUNT:88 * 100
	ELSE
		IF ABL:COUNT:97 < 30	; 【COUNT:[浪費癖]Lv<30】
			;安い
			C = ABL:COUNT:97 * 5
			;戦闘技能レベルによって増加
			C += ABL:COUNT:88 * 40
		ELSEIF ABL:COUNT:97 < 50	; 【COUNT:[浪費癖]Lv<50】
			;普通
			C = ABL:COUNT:97 * 20
			;戦闘技能レベルによって増加
			C += ABL:COUNT:88 * 75
		ELSEIF ABL:COUNT:97 < 75	; 【COUNT:[浪費癖]Lv<75】
			;高い
			C = ABL:COUNT:97 * 40
			;戦闘技能レベルによって増加
			C += ABL:COUNT:88 * 100
		ELSEIF ABL:COUNT:97 < 90	; 【COUNT:[浪費癖]Lv<90】
			;非常に高い
			C = ABL:COUNT:97 * 60
			;戦闘技能レベルによって増加
			C += ABL:COUNT:88 * 150
		ELSEIF ABL:COUNT:97 < 100	; 【COUNT:[浪費癖]Lv<100】
			;詐欺のように高い
			C = ABL:COUNT:97 * 100
			;戦闘技能レベルによって増加
			C += ABL:COUNT:88 * 200
		ELSE
			;破滅
			C = ABL:COUNT:97 * 400
			;戦闘技能レベルによって増加
			C += ABL:COUNT:88 * 10000
		ENDIF
	ENDIF


	;現在ステージによって少し増減
	IF FLAG:24 == 1
		;Stage1は半額
		TIMES C , 0.50
	ELSEIF FLAG:24 == 2
		;Stage2は20%OFF
		TIMES C , 0.80
	ELSEIF FLAG:24 == 3
		;Stage3は10%OFF
		TIMES C , 0.90
	ELSEIF FLAG:24 <= 6
		;Stage6までは通常通り
	ELSE
		;クリア後は1.2倍
		TIMES C , 1.20
	ENDIF

	;主人公の維持費は100
	SIF COUNT == MASTER
		C = 100
	;夜は寝てる時間も多いので維持費が半分
	SIF TIME == 1
		C /= 2

	;雨の日は経費ダウン
	SIF TIME:5 == 3 || TIME:5 == 7
		TIMES C , 0.90
	SIF TIME:5 == 4
		TIMES C , 0.60

	;霧に飲まれかけているキャラは維持費無し
	SIF CFLAG:COUNT:17	; 【COUNT:[臨月・育児中]】
		C = 0

	;待機中指示コマンド実行はSHOP_COM_ACT.ERBに移動
	D = 0
	CALL TURNEND_COM

	;回復処理
	;料理技能で回復量増加
	IF A < 1000000
		A = A * (100 + ABL:COUNT:90 * 3) / 100
	ELSE
		A = A / 100 * (100 + ABL:COUNT:90 * 3)
	ENDIF
	IF B < 1000000
		B = B * (100 + ABL:COUNT:90 * 3) / 100
	ELSE
		B = B / 100 * (100 + ABL:COUNT:90 * 3)
	ENDIF
	LOCAL:97 = BASE:COUNT:0
	BASE:COUNT:0 += A
	SIF BASE:COUNT:0 > MAXBASE:COUNT:0	; 【COUNT:[体力]>MAXBASE:COUNT:0】
		BASE:COUNT:0 = MAXBASE:COUNT:0
	;おあずけ事後暴走(@SELF_OAZUKE_RAMPAGE_CHECK)・定期戦祝勝会(@DECK_BATTLE_HAREM_AFTER)・行事後イチャイチャ(@SCHOOL_EVENT_AFTER_ICHA)発生時は、
	;直後のBEGIN TURNEND(@EVENTTURNEND)で耐力が即座に回復してしまわないよう、そのターンの耐力自動回復を0に抑止する
	IF COUNT == MASTER && CFLAG:MASTER:1286 > 0	; 【MASTER:[事後暴走消耗フラグ]>0】
		B = 0
		CFLAG:MASTER:1286 = 0	; 【MASTER:[事後暴走消耗フラグ]リセット】
	ENDIF
	BASE:COUNT:4 += B
	SIF BASE:COUNT:4 > MAXBASE:COUNT:4	; 【COUNT:[耐力]>MAXBASE:COUNT:4】
		BASE:COUNT:4 = MAXBASE:COUNT:4

	;衰弱療養（お休み）からの回復通知
	IF COUNT > 0 && LOCAL:97 <= 0 && BASE:COUNT:0 > 0	; 【COUNT:[体力]>0】
		SETCOLOR 0x66FF66
		PRINTFORML %CALLNAME:COUNT%の体力が回復し、療養（お休み）から復帰しました！（体力：{BASE:COUNT:0}）
		RESETCOLOR
	ENDIF

	;気力の回復
	IF COUNT == MASTER
		;主人公: 昼10%、夜20%
		IF TIME == 0
			BASE:COUNT:1 += MAXBASE:COUNT:1 / 10
		ELSE
			BASE:COUNT:1 += MAXBASE:COUNT:1 / 5
		ENDIF
		SIF BASE:COUNT:1 > MAXBASE:COUNT:1	; 【COUNT:[気力]>MAXBASE:COUNT:1】
			BASE:COUNT:1 = MAXBASE:COUNT:1
	ELSE
		;女の子: 全回復
		BASE:COUNT:1 = MAXBASE:COUNT:1
	ENDIF
	BASE:COUNT:5 = MAXBASE:COUNT:5

	;金銭感覚による維持費軽減
	IF ABL:COUNT:89 == 0	; 【COUNT:[金銭感覚]Lv==0】
		;何もしない
	ELSEIF ABL:COUNT:89 <= 5	; 【COUNT:[金銭感覚]Lv<=5】
		C = C * (100 - ABL:COUNT:89 * 7) / 100
	ELSEIF ABL:COUNT:89 <= 10	; 【COUNT:[金銭感覚]Lv<=10】
		C = C * (65 - (ABL:COUNT:89 - 5) * 3) / 100
	ELSEIF ABL:COUNT:89 <= 100	; 【COUNT:[金銭感覚]Lv<=100】
		C = C * (50 - (ABL:COUNT:89 - 10) / 2) / 100
	ELSEIF ABL:COUNT:89 > 100	; 【COUNT:[金銭感覚]Lv>100】
		C = C / 100
	ENDIF
	

	;リフレッシュ(2)とイチャイチャ(7)のみ生活費発生
	IF CFLAG:COUNT:13 == 2 || CFLAG:COUNT:13 == 7 || CFLAG:COUNT:13 == 8 || CFLAG:COUNT:13 == 10 || CFLAG:COUNT:13 == 11 || CFLAG:COUNT:13 == 12 || CFLAG:COUNT:13 == 13
		LOCAL:0 += C
	ENDIF
	LOCAL:1 += D

	;霧に飲まれているとランダムで色々増える
	IF CFLAG:COUNT:17	; 【COUNT:[臨月・育児中]】
		A = RAND:100
		;1%で処女喪失
		IF TALENT:COUNT:0 && RAND:100 == 0	; 【COUNT:[処女]】
			TALENT:COUNT:0 = 0
			EXP:COUNT:0 += 1
			CFLAG:COUNT:2 -= 100
			CFLAG:COUNT:1245 = 1
		ENDIF

		IF CFLAG:COUNT:2 > 0	; 【COUNT:[好感度]>0】
			IF CFLAG:COUNT:2 > 30000	; 【COUNT:[好感度]>30000】
				CFLAG:COUNT:2 -= 750
			ELSE
				CFLAG:COUNT:2 -= CFLAG:COUNT:2 / 40
			ENDIF
		ENDIF
		CFLAG:COUNT:2 -= RAND:21 + 20

		;50％で自慰
		IF A < 50
			EXP:COUNT:10 += RAND:5 + 3
			EXP:COUNT:2 += RAND:3 + 1
			JUEL:COUNT:0 += RAND:998 + 1000
			JUEL:COUNT:4 += RAND:200 + 200
			JUEL:COUNT:5 += RAND:500 + 500
		;30％でレズ
		ELSEIF A < 80
			EXP:COUNT:40 += RAND:50 + 30
			EXP:COUNT:2 += RAND:10 + 3
		
			JUEL:COUNT:6 += RAND:500 + 500
			JUEL:COUNT:7 += RAND:500 + 500
			IF TALENT:COUNT:121	; 【COUNT:[ふたなり]】
				EXP:COUNT:3 += RAND:10 + 3
				JUEL:COUNT:8 += RAND:200 + 200
			ENDIF

		;20％で精液
		ELSEIF TALENT:COUNT:0	; 【COUNT:[処女]】
			EXP:COUNT:2 += RAND:3 + 1
			EXP:COUNT:20 += RAND:20 + 10
			JUEL:COUNT:5 += RAND:500 + 500
			JUEL:COUNT:6 += RAND:500 + 500
			JUEL:COUNT:10 += RAND:998 + 1000
		ELSE
			EXP:COUNT:0 += RAND:5 + 3
			EXP:COUNT:2 += RAND:3 + 1
			EXP:COUNT:20 += RAND:10 + 5
			JUEL:COUNT:1 += RAND:500 + 500
			JUEL:COUNT:5 += RAND:500 + 500
			JUEL:COUNT:6 += RAND:500 + 500
		ENDIF
	ENDIF
REND

;待機行動のペア処理フラグをクリア
FOR LOCAL:10, 0, CHARANUM
	CFLAG:(LOCAL:10):1290 = 0
NEXT

;待機行動中に入手した経験や宝珠や好感度を表示する場合確認用に最後に1回だけWAIT
;それが無くても宝探し詳細報告アリなら、確認用に最後に1回だけWAIT
IF FLAG:23 & 1p25
	WAIT
ELSE
	IF FLAG:23 & 1024
		REPEAT CHARANUM
			IF CFLAG:COUNT:13 == 12	; 【COUNT:[待機中行動]==12】
				WAIT
				BREAK
			ENDIF
		REND
	ENDIF
ENDIF

;待機中行動口上呼び出し
CALL KOJO_TAIKI_CHECK

;パートナーの金銭感覚による全体維持費の軽減
IF TARGET >= 0
	IF ABL:TARGET:89 == 0	; 【TARGET:[金銭感覚]Lv==0】
		;何もしない
	ELSEIF ABL:TARGET:89 <= 5	; 【TARGET:[金銭感覚]Lv<=5】
		LOCAL:0 = LOCAL:0 * (100 - ABL:TARGET:89 * 5) / 100
	ELSEIF ABL:TARGET:89 <= 10	; 【TARGET:[金銭感覚]Lv<=10】
		LOCAL:0 = LOCAL:0 * (75 - (ABL:TARGET:89 - 5) * 2) / 100
	ELSEIF ABL:TARGET:89 <= 100	; 【TARGET:[金銭感覚]Lv<=100】
		LOCAL:0 = LOCAL:0 * (65 - (ABL:TARGET:89 - 10) / 2) / 100
	ELSEIF ABL:TARGET:89 > 100	; 【TARGET:[金銭感覚]Lv>100】
		LOCAL:0 = LOCAL:0 / 100
	ENDIF
ENDIF

;生活費軽減
SIF ABL:MASTER:82 >= 1	; 【MASTER:[生活費軽減]Lv>=1】
	LOCAL:0 = LOCAL:0 * (100 - ABL:MASTER:82) / 100

;獲得資金増加ボーナス
IF ABL:MASTER:86 == 1	; 【MASTER:[獲得資金増加]Lv==1】
	TIMES LOCAL:1 , 1.50
ELSEIF ABL:MASTER:86 > 1	; 【MASTER:[獲得資金増加]Lv>1】
	LOCAL:1 *= ABL:MASTER:86
ENDIF

;アクセサリ関係
IF (FLAG:62 & 4) && TARGET > -1
	;パートナーが装備中のアクセサリで補正
	;アクセサリから浪費癖を算出
	IF CFLAG:TARGET:23 > 0	; 【TARGET:[アクセサリ1]>0】
		CSVABL CFLAG:TARGET:23, 97, 0
		;例えば浪費癖が30のキャラのアクセサリを付けていた場合0.80倍になる
		LOCAL:0 = LOCAL:0 * (50 + RESULT) / 100
	ENDIF
	IF CFLAG:TARGET:24 > 0	; 【TARGET:[アクセサリ2]>0】
		CSVABL CFLAG:TARGET:24, 97, 0
		;例えば浪費癖が30のキャラのアクセサリを付けていた場合0.80倍になる
		LOCAL:0 = LOCAL:0 * (50 + RESULT) / 100
	ENDIF
ENDIF

PRINTL  

;生活費（維持費）の徴収
IF LOCAL:0 > 0
	MONEY -= LOCAL:0
	SIF MONEY < 0
		MONEY = 0
	PRINTFORML 生活費として${LOCAL:0}支出しました
ENDIF


MONEY += LOCAL:1
SIF LOCAL:1 > 0
	PRINTFORML 待機中の仲間のバイトで${LOCAL:1}入手しました

;キャラ独自イベント
;恋慕等取得
CALL EVENTCHECK_M
;吸血鬼化チェック
CALL EVENTCHECK_V
;体力回復計算に使う休憩フラグを初期化
FLAG:0 = 0

;放課後/自由時間(後半)なら次の日、授業時間/自由時間(前半)なら次の時間帯にする
IF TIME == 1
	;日付変更時のイベント呼び出し
	;キャラ独自イベント
	TRYCALL EVENT_NEXTDAY_T
	;日付変更時のイベント
	CALL EVENT_NEXTDAY
	;月経進行
	CALL EVENT_DANGERDAY
	DAY = DAY+1
	DAY:7 = DAY:7+1
;月替わりの裏カジノ借金利息（月利50％）
IF CFLAG:MASTER:785 > 0 && DAY % 10 == 0
	LOCAL:5 = MAX(1, CFLAG:MASTER:785 / 2)
	; 64bit整数オーバーフロー防止（上限100兆）
	IF CFLAG:MASTER:785 > 100000000000000
		CFLAG:MASTER:785 = 100000000000000
	ELSE
		CFLAG:MASTER:785 += LOCAL:5
	ENDIF
	SETCOLOR 0xFF5555
	PRINTFORML カジノ借金に利息50％が加算されました。（借金総額：${CFLAG:MASTER:785}）
	RESETCOLOR
ELSEIF CFLAG:MASTER:785 < 0
	CFLAG:MASTER:785 = 9000000000000000000
ENDIF

	PRINTW 一日が終わった・・・

	TFLAG:79 = 0
	TIME = 0
ELSE
	TIME = 1
ENDIF


BEGIN SHOP

;-------------------------------------------------
;待機中行動口上呼び出し
;-------------------------------------------------
@KOJO_TAIKI_CHECK
;LOCAL FOR-NEXTで使用
;LOCAL:1 ZにMASTERを記録したフラグ
;LOCAL:2 TARGET保存（ローカル変数でも念のため保存）
;LOCAL:3 待機中行動口上カウント用

VARSET LOCAL, 0
Z = TARGET
LOCAL:2 = TARGET
;パートナーがいない時は口上のエラー防止にZにMASTERを記録
IF TARGET <= 0
	Z = MASTER
	LOCAL:2 = MASTER
	LOCAL:1 = 1
ENDIF

VARSET B, 0
VARSET Y, 0
;非表示
SKIPDISP 1
FOR LOCAL, 0, CHARANUM
	TFLAG:120 = 0
	TARGET = LOCAL
	TRYCCALLFORM KOJO_TAIKI_K{NO:LOCAL}
		;口上がある＆別れていない場合
		IF TFLAG:120 && CFLAG:LOCAL:21 == 0 && BASE:LOCAL:0 > 0	; 【[特殊ボス戦用フラグ] / LOCAL:[別れ]==0 / LOCAL:[体力]>0】
			Y:(LOCAL:3) = LOCAL
			LOCAL:3 += 1
		ENDIF
	CATCH
		;口上がない場合
	ENDCATCH
NEXT
