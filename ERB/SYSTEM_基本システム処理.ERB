;v1.06.8(スペルいじるパッチ)でFLAG:63 == 8使用
IF FLAG:63 == 8
	;スペカを設定する
	REPEAT CHARANUM
		IF CFLAG:COUNT:0 == 0 && CSTR:COUNT:22 == ""	; 【COUNT:[EXフラグ]==0】
			CSVCSTR NO:COUNT, 21, 0
			CSTR:COUNT:21 = %RESULTS%
			CSVCSTR NO:COUNT, 22, 0
			CSTR:COUNT:22 = %RESULTS%
			CSVCSTR NO:COUNT, 23, 0
			CSTR:COUNT:23 = %RESULTS%
			CSVCSTR NO:COUNT, 24, 0
			CSTR:COUNT:24 = %RESULTS%
		ELSEIF CFLAG:COUNT:0 && CSTR:COUNT:22 == ""	; 【COUNT:[EXフラグ]】
			CSVCSTR NO:COUNT, 21, 1
			CSTR:COUNT:21 = %RESULTS%
			CSVCSTR NO:COUNT, 22, 1
			CSTR:COUNT:22 = %RESULTS%
			CSVCSTR NO:COUNT, 23, 1
			CSTR:COUNT:23 = %RESULTS%
			CSVCSTR NO:COUNT, 24, 1
			CSTR:COUNT:24 = %RESULTS%
		ENDIF
	REND
	FLAG:63 = 9
ENDIF

;v1.06.9でFLAG:63 == 9使用
IF FLAG:63 == 9
	;攻略ルートと難易度を同じに設定
	FLAG:3 = FLAG:5
	FLAG:63 = 10
ENDIF

;v1.07.2でFLAG:63 == 10使用
IF FLAG:63 == 10
	;コンフィグ整理
	;グローバル変数読み込み
	CALL LOAD_GLOBAL_CONFIGURE
	;異常経験が付くコマンドを表示する
	IF FLAG:23 & 1p11
		FLAG:23 -= 1p11
		SIF (FLAG:61 & 1) == 0
			FLAG:61 |= 1
	ENDIF

	;パートナーが[親愛]を持っている場合、異常経験が付くコマンドを表示する
	;FLAG:61 & 2は新規コンフィグなので互換なし

	;挿入コマンドの派生追加
	IF FLAG:62 & 1p5
		FLAG:62 -= 1p5
		SIF (FLAG:61 & 1p2) == 0
			FLAG:61 |= 1p2
	ENDIF

	;以下の2つは今までのまとめだとONがデフォルトだったのでONにしておく
	;ウフフモード時のコマンド拡張
	SIF (FLAG:61 & 1p3) == 0
		FLAG:61 |= 1p3
	;通常モード（ウフフモード突入前）のコマンド拡張
	SIF (FLAG:61 & 1p4) == 0
		FLAG:61 |= 1p4

	;Ａ系コマンド拡張
	IF FLAG:62 & 1p6
		FLAG:62 -= 1p6
		SIF (FLAG:61 & 1p5) == 0
			FLAG:61 |= 1p5
	ENDIF
	;着衣挿入コマンド拡張
	IF FLAG:62 & 1p14
		FLAG:62 -= 1p14
		SIF (FLAG:61 & 1p6) == 0
			FLAG:61 |= 1p6
	ENDIF
	;仲間にしたキャラのコマンドフィルタを共通設定にする
	IF FLAG:62 & 1p20
		FLAG:62 -= 1p20
		SIF (FLAG:61 & 1p10) == 0
			FLAG:61 |= 1p10
	ENDIF
	;共通コンフィグ自動保存
	CALL STORE_GLOBAL_CONFIGURE
	FLAG:63 = 11
ENDIF

