;-------------------------------------------------
;J用霊夢口上 ver2（2009/02/25）

;eratohoJ用口上テンプレートを使用。
;J用霊夢口上2008/10/21版（以下一部コメントでオリジナルと表記）を基に、
;eratohoJ同包のサンプル口上も交えて加筆＆改変を行ったものです。
;詳細はreadmeをご覧ください。

;フラグ使用状況
;	CFLAG:120
;		「パートナーと一旦別れる」の口上分岐に使用。ビット管理
;		8ビット目（& 128）だけは、旧仕様のフラグをリセットした事を示すフラグ
;	CFLAG:121
;		「我慢できず押し倒される」が起こったことを示すフラグ
;	CFLAG:122
;		ちょっとしたイベントの管理に使用。詳細は「パートナーと一旦別れる」の辺りを参照のこと
;	CFLAG:123
;		下着だけ脱がせてウフフに入っていることを示すフラグ（一応着衣Ｈってことで）
;	CFLAG:365
;		四重絶頂時の口上分岐に使用
;	CFLAG:366
;		追加した「素股で射精させた」の口上分岐に使用
;-------------------------------------------------

;-------------------------------------------------
;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------

;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:101 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:101 = 0

;--------------------------------------------------
;純愛イベント口上　 CFLAG221
;--------------------------------------------------
@KOJO_JUN_K1
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;-------------------------------------------------;
;IF TFLAG:600 == 0 && CFLAG:220 == 0
;	PRINTL 処女モードに移行しますか？
;	PRINTL [0] はい
;	PRINTL [1] いいえ
;	$INPUT_LOOP
;	INPUT
;	IF RESULT == 0
;		PRINTFORMW ―処女モードに素質、能力を変更します―
;		TALENT:0 = 1
;		ABL:4 = 0
;		EXP:TARGET:0 = 0
;	ELSEIF RESULT == 1
;		PRINTFORMW ―通常モードで調教を開始します―
;	ELSE
;		GOTO INPUT_LOOP
;	ENDIF
;	CFLAG:220 = 1
;ENDIF
;-------------------------------------------------
;オープニング
;-------------------------------------------------
IF TFLAG:600 == 28
	CALL COMMON_PLANE_TEXT
	PRINTFORML 「異変解決は巫女の役目」
	PRINTFORML 「……とはいえ、今回の異変はあなたの能力無しには解決できそうも無いわ」
	PRINTFORMW 「そういうわけだから、よろしく頼むわね」
	PRINTL  
ENDIF

;-------------------------------------------------
;朝になったとき CFLAG221
;-------------------------------------------------
IF TFLAG:600 == 38
	;キス後一回目
	IF EXP:96 > 0 && CFLAG:221 < 2
		PRINTFORML 「あら…おはよう」
		PRINTFORMW 霊夢といつも通りの挨拶を交わしてすれ違った
		PRINTL  
		C = CHARANUM -1
		IF C > 1
			E = 0
			REPEAT C
				D = COUNT +1
				IF NO:D == 2
					E = 2
					BREAK
				ELSEIF NO:D == 22
					E = 22
					BREAK
				ELSEIF NO:D == 23
					E = 23
					BREAK
				ELSEIF NO:D == 32
					E = 32
					BREAK
				ENDIF
			REND
			;まだ微妙な変化は、付き合いが長かったり勘のいい者にしかわからないという感じで
			;とりあえず恋人の場合は除外。各キャラの台詞は今のところ適当
			IF E == 2 && TALENT:D:153 == 0
				PRINTFORMW その後、魔理沙に会った
				PRINTFORMW 『よ、お前か』
				PRINTFORMW 『そういやお前、霊夢と何かあったか？』
				PRINTFORMW 『何か様子がおかしい気がするんだよなぁ……ま、知らないならいいや』
			ELSEIF E == 22 && TALENT:D:153 == 0
				PRINTFORMW 『……あなたね、原因は』
				PRINTFORMW 突然の声に驚いて振り向くと、そこにはいつの間にか紫が立っていた
				PRINTFORMW 『どことなく霊夢の様子がおかしいから、ちょっと気になってたんだけど』
				PRINTFORMW 『どうやら悪いことではないようね、まあがんばりなさい』
			ELSEIF E == 23 && TALENT:D:153 == 0
				PRINTFORMW その後、萃香に会った
				PRINTFORMW 『おう、丁度良かった。あんた、霊夢に何かあったか知らないか？』
				PRINTFORMW 『ん？ いや、どうも様子がおかしい気がしてね』
				PRINTFORMW 『知らないならいいんだ、それじゃ』
			ELSEIF E == 32 && TALENT:D:153 == 0
				PRINTFORMW その後、文に会った
				PRINTFORMW 『あなた、霊夢さんに何かあったか知りませんか？』
				PRINTFORMW 『ええ、どうも様子がおかしいんですよねぇ……』
				PRINTFORMW 『うーん、スクープの匂いがします』
			ELSE
				PRINTFORMW 霊夢の様子が僅かに変わっていたことに、%CALLNAME:MASTER%はまだ気付けずにいた……
			ENDIF
		ELSE
			PRINTFORMW 霊夢の様子が僅かに変わっていたことに、%CALLNAME:MASTER%はまだ気付けずにいた……
		ENDIF
		CFLAG:221 = 2
	;恋慕後一回目
	ELSEIF TALENT:85 == 1 && CFLAG:221 < 3
		PRINTFORMW 「あら……おはよう」
		PRINTFORMW %CALLNAME:MASTER%と挨拶を交わす霊夢
		PRINTFORMW いつもはそのまま通り過ぎるはずの霊夢が、%CALLNAME:MASTER%を見つめたまま動かない
		PRINTFORMW 何かあったのかと聞く%CALLNAME:MASTER%だったが、霊夢は
		PRINTFORMW 「別に何でもないわ。……それで、今日はどうするの？」
		PRINTFORMW 何故か顔を赤くしつつ答えると、%CALLNAME:MASTER%の後に付いて歩きながら話し始めた
		CFLAG:221 = 3
	;エンディング後一回目
	ELSEIF FLAG:28 > 0 && CFLAG:221 < 4
		PRINTFORMW 「おはよう、ちょっとお邪魔するわよ」
		PRINTFORMW 朝、突然霊夢が訪ねてきた
		PRINTFORMW 「あの霧なんだけど、妙にしつこく残っていてね」
		PRINTFORMW 「まだあちこちに霧の影響が出ているのよ」
		PRINTFORMW 霊夢は%CALLNAME:MASTER%の家に上がり込みながら、簡単に事情を説明した
		PRINTFORMW 「そんなわけだから、もうしばらくこっちに居ることにしたわ」
		IF TALENT:89 == 0
			IF TALENT:88
				PRINTL  
				PRINTFORMW 「これからのこととか、色々話したかったんだけど……」
				PRINTFORMW 「まあ、それはもう少し落ち着いてからにしましょ」
				PRINTFORMW 「その代わり、ここでたっぷり愛してもらうわよ」
			ELSEIF TALENT:153
				PRINTL  
				PRINTFORMW 「またバタバタしそうだけど、私はちょっと嬉しい……かな」
				PRINTFORMW 「気兼ねなく%CALLNAME:MASTER%と一緒に暮らせるんだし……ごめん、不謹慎ね」
				PRINTFORMW 「ともかく、一緒に頑張りましょ」
			ELSEIF TALENT:85
				PRINTL  
				PRINTFORMW 「……ふふっ、やっぱりまた会うことになったわね」
				PRINTFORMW 「まあ、また私から押しかける形になっちゃったけど」
				PRINTFORMW 「あの時の答え、近いうちに聞かせてもらうわよ？」
			ENDIF
		ENDIF
		PRINTFORMW 「よろしくね」
		CFLAG:221 = 4
	ENDIF
ENDIF

;-------------------------------------------------
;ファーストキス
;-------------------------------------------------
