;-------------------------------------------------
;告白成功
;-------------------------------------------------
IF TFLAG:600 == 2
	;主人公から告白
	IF TFLAG:45 == 0
		PRINTFORMW %CALLNAME:MASTER%は霊夢に自分の思いを告げた……
		;既に恋慕持ち
		IF TALENT:85
			PRINTFORMW 「ずっと、その言葉を待っていたわ……」
			PRINTFORMW 「私も、あなたのことが好きよ」
			PRINTFORMW 「……何か照れくさいわね。でも、本当にずっと待ってたんだから」
			PRINTFORMW 「その分、これからは私のこと……一杯愛してもらうわよ？」
			PRINTFORMW そう言って、霊夢は少し乱暴に%CALLNAME:MASTER%に抱きついてきた
		ELSE
			PRINTFORMW 「そうね……いいわよ。あなたのこと、嫌いじゃないし」
			PRINTFORMW 「最初は、こんな関係になるなんて思ってもみなかったけど……これからもよろしくね」
			PRINTFORMW そう言って、霊夢はそっと%CALLNAME:MASTER%に身体を寄せてきた
		ENDIF
	;霊夢から告白
	ELSE
		PRINTFORMW %CALLNAME:MASTER%が霊夢に思いを告げようとすると、霊夢はそれをそっと制した
		PRINTFORMW 「私も、%CALLNAME:MASTER%に伝えたいことがあるの……」
		PRINTFORMW %CALLNAME:MASTER%が頷いて先を促すと、霊夢はまっすぐ%CALLNAME:MASTER%を見つめてきた
		;既に恋慕持ち
		IF TALENT:85
			PRINTFORMW 「私……あなたのことが好き」
			PRINTFORMW 「%CALLNAME:MASTER%の気持ちが知りたいの……あなたは私のこと、好き？」
			PRINTFORMW %CALLNAME:MASTER%は自分も霊夢のことが好きだと伝えると、霊夢はほっとしたようだ
			PRINTFORMW 「良かった……断られたらどうしようかって心配しちゃったわ」
			PRINTFORMW 「これで私たちは恋人同士ね。もう離さないんだから！」
			PRINTFORMW そう言って、霊夢は少し乱暴に%CALLNAME:MASTER%に抱きついてきた
			PRINTFORMW 「私のこと、一杯愛してね。でないと承知しないわよ？」
		ELSE
			PRINTFORMW 「私……あなたのことが好きになったのかもしれないわ」
			PRINTFORMW 「何か、あなたと一緒にいると落ち着くのよね。だから……」
			PRINTFORMW 「異変の事とか関係なく、これからも一緒にいて欲しいの……駄目？」
			PRINTFORMW 不安そうに見つめてくる霊夢を、%CALLNAME:MASTER%はそっと抱きしめた
			PRINTFORMW 霊夢も%CALLNAME:MASTER%の背に手を回し、静かに身を預けてきたのだった……
		ENDIF
	ENDIF
	;キス未経験の場合
	IF TALENT:151 == 1
		PRINTL  
		PRINTFORMW しばらくそうした後、霊夢は少し体を離してあなたを見つめてきた
		PRINTFORMW 「恋人同士になったのよ。キスぐらいしてくれないの？」
		PRINTFORMW 言われて気づいた%CALLNAME:MASTER%は、霊夢を優しく引き寄せた
		PRINTFORMW 「鈍いわね、もう。ムードも何もあったもんじゃないわ」
		PRINTFORMW 口ではそう言いつつも、霊夢は%CALLNAME:MASTER%にされるままに任せて背伸びする
		;デート中は屋外を想定
		IF TEQUIP:2
			IF TIME
				PRINTFORM 夜の帳が下り始めた空の下、
				IF TIME:5 == 3 || TIME:5 == 7
					PRINTFORMW 未だに降り続ける雨の中で……
				ELSEIF TIME:5 == 5
					PRINTFORMW その闇に融けるように舞い散る雪の中で……
				ENDIF
			ELSEIF TIME:5 <= 1 || TIME:5 == 7
				PRINTFORM 晴れ渡った青空
				IF TIME:5 == 7
					PRINTFORMW の下、不思議と降り続ける雨の中で……
				ELSEIF TIME:8
					PRINTFORMW 、そこを彩る七色の架け橋をバックに……
				ELSE
					PRINTFORM の下、
				ENDIF
			ELSEIF TIME:5 == 2
				PRINTFORM 曇って薄暗い空の下、
			ELSEIF TIME:5 == 3
				PRINTFORM しとしとと降り続ける雨の中、
			ELSEIF TIME:5 == 5
				PRINTFORM ちらちらと舞い散る雪の中、
			ENDIF
		;それ以外なら室内
		ELSE
			IF TIME
				PRINTFORM 夜が近づき暗くなり始めた部屋の中、
				IF TIME:5 == 3 || TIME:5 == 4 || TIME:5 == 7
					PRINTFORMW 未だに降り続ける雨の音に包まれて……
				ELSEIF TIME:5 == 5 || TIME:5 == 6
					PRINTFORMW 二人は温もりを分け合うようにしっかりと寄り添い……
				ENDIF
			ELSEIF TIME:5 <= 1 || TIME:5 == 7
				PRINTFORM 明るい日差しが差し込む部屋の中、
				SIF TIME:5 == 7
					PRINTFORMW 不思議と降り続ける雨の音に包まれて……
			ELSE
				PRINTFORM 少し薄暗くなった部屋の中、
				IF TIME:5 == 3 || TIME:5 == 4
					PRINTFORMW 未だに降り続ける雨の音に包まれて……
				ELSEIF TIME:5 == 5 || TIME:5 == 6
					PRINTFORMW 二人は温もりを分け合うようにしっかりと寄り添い……
				ENDIF
			ENDIF
		ENDIF
		PRINTFORMW %CALLNAME:MASTER%と霊夢の唇が静かに重なった……
	ENDIF
ENDIF

