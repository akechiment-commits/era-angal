;---------------------------------------------------------
;部活動システム（改訂版）
;
;放課後に4種類のアクティビティから自由に選択可能。
;パートナーの所属部活と一致するアクティビティはボーナス成長。
;
;@CLUB_ACTIVITY           - 放課後アクティビティメニュー
;@DO_ACTIVITY             - アクティビティ実行（TFLAG:82=種別）
;@ACTIVITY_RANDOM_EVENT   - ランダムイベント（TFLAG:82=種別）
;@SHOW_CLUB_STATUS        - 現在の技能値表示
;@INIT_CLUB_FLAGS         - 既存セーブ対応：部活タイプ初期化
;---------------------------------------------------------
;TFLAG:82 -> アクティビティ種別（0=運動, 1=表現, 2=知識, 3=自習, 4=生活）
;CFLAG:char:25 -> 部活タイプ（0=帰宅, 1=運動部, 2=表現部, 3=知識部）
;CSTR:char:25  -> 部活名
;ABL:93 -> 運動技能   ABL:94 -> 表現技能   ABL:95 -> 知識技能
;ABL:54 -> 運動素質   ABL:55 -> 表現素質   ABL:56 -> 知識素質
;ABL:98 -> 学力素質   EXP:95 -> 学習経験
;---------------------------------------------------------

;---------------------------------------------------------
;放課後アクティビティメインメニュー
;---------------------------------------------------------
@CLUB_ACTIVITY
DRAWLINE

IF TARGET < 0
	PRINTFORMW パートナーを選んでいません。先にパートナーを決めてください。
	RETURN 0
ENDIF

;パートナーの部活タイプ（ボーナス判定用）
A = CFLAG:TARGET:25

PRINTFORML 【放課後のアクティビティ】
PRINTFORML パートナー：%CALLNAME:TARGET%
IF A > 0
	PRINTFORML 所属：%CSTR:TARGET:25%（得意分野にはボーナスがつきます）
ELSE
	PRINTFORML 所属：帰宅部
ENDIF
PRINTL 

CALL SHOW_CLUB_STATUS
PRINTL 

;各選択肢表示（パートナーの専門にはボーナスマーク）
IF A == 1
	PRINTFORML [0] 運動系活動★  （運動技能UP / 体力消費）  ← %CALLNAME:TARGET%の専門！
ELSE
	PRINTFORML [0] 運動系活動    （運動技能UP / 体力消費）
ENDIF

IF A == 2
	PRINTFORML [1] 表現系活動★  （表現技能UP / 気力消費）  ← %CALLNAME:TARGET%の専門！
ELSE
	PRINTFORML [1] 表現系活動    （表現技能UP / 気力消費）
ENDIF

IF A == 3
	PRINTFORML [2] 知識系活動★  （知識技能UP / 体力消費）  ← %CALLNAME:TARGET%の専門！
ELSE
	PRINTFORML [2] 知識系活動    （知識技能UP / 体力消費）
ENDIF

PRINTFORML [3] 一緒に自習    （学習経験UP / 消費少）
PRINTFORML [4] 生活系活動    （家事経験UP  / 体力消費）
PRINTFORML [9] やめる

$INPUT_LOOP
INPUT
IF RESULT == 0
	TFLAG:82 = 0
	CALL DO_ACTIVITY
	RETURN RESULT
ELSEIF RESULT == 1
	TFLAG:82 = 1
	CALL DO_ACTIVITY
	RETURN RESULT
ELSEIF RESULT == 2
	TFLAG:82 = 2
	CALL DO_ACTIVITY
	RETURN RESULT
ELSEIF RESULT == 3
	TFLAG:82 = 3
	CALL DO_ACTIVITY
	RETURN RESULT
ELSEIF RESULT == 4
	TFLAG:82 = 4
	CALL DO_ACTIVITY
	RETURN RESULT
ELSEIF RESULT == 9
	RETURN 0
ELSE
	PRINTFORML 0～4または9を入力してください
	GOTO INPUT_LOOP
ENDIF

;---------------------------------------------------------
;アクティビティ実行
;TFLAG:82 = 0:運動 1:表現 2:知識 3:自習
;パートナーの部活と一致すればボーナス(x1.5)
;---------------------------------------------------------
@DO_ACTIVITY
A = TFLAG:82
;パートナーの部活タイプ（0=帰宅, 1=運動, 2=表現, 3=知識）
B = CFLAG:TARGET:25
;ボーナス判定: パートナーの専門と一致するか
;(A==0かつB==1) or (A==1かつB==2) or (A==2かつB==3)
LOCAL:9 = 0
IF A == 0
	IF B == 1
		LOCAL:9 = 1
	ENDIF
ELSEIF A == 1
	IF B == 2
		LOCAL:9 = 1
	ENDIF
ELSEIF A == 2
	IF B == 3
		LOCAL:9 = 1
	ENDIF
ENDIF

;耐力チェック（廃止: 体力不足でも活動継続可能）

DRAWLINE

IF A == 0
	;--- 運動系活動 ---
	IF LOCAL:9
		PRINTFORML 【%CALLNAME:TARGET%の専門！%CSTR:TARGET:25%で運動系活動】
	ELSE
		PRINTFORML 【運動系活動】
	ENDIF
	PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%は一緒に汗を流した。
	TRYCALLFORM KOJO_CLUB_K{NO:TARGET}

	;成長量（素質ベース + ランダム）
	P = RAND:5 + ABL:MASTER:54 / 15 + 1
	SIF LOCAL:9
		P = P * 3 / 2  ;ボーナス×1.5
	SIF P > 12
		P = 12
	IF TALENT:MASTER:220
		P += 3
		PRINTFORML 	（怪力ボーナス +3）
	ENDIF
	IF TALENT:MASTER:221
		P -= 3
		SIF P < 1
			P = 1
		PRINTFORML 	（運動音痴 -3）
	ENDIF
	ABL:MASTER:93 += P
	EXP:MASTER:100 += P
	PRINTFORML 　%CALLNAME:MASTER%の運動技能 +{P}（Lv{ABL:MASTER:93} 経験{EXP:MASTER:100}）

	P = RAND:5 + ABL:TARGET:54 / 15 + 1
	SIF LOCAL:9
		P = P * 3 / 2
	SIF P > 12
		P = 12
	IF TALENT:TARGET:220
		P += 3
		PRINTFORML 	（%CALLNAME:TARGET%の怪力ボーナス +3）
	ENDIF
	IF TALENT:TARGET:221
		P -= 3
		SIF P < 1
			P = 1
		PRINTFORML 	（%CALLNAME:TARGET%の運動音痴 -3）
	ENDIF
	ABL:TARGET:93 += P
	SIF ABL:TARGET:93 > 100
		ABL:TARGET:93 = 100
	PRINTFORML 　%CALLNAME:TARGET%の運動技能 +{P}（{ABL:TARGET:93}/100）

	;耐力消費
	LOCAL:2 = MAXBASE:MASTER:0 / 5
	BASE:MASTER:4 -= LOCAL:2
	SIF BASE:MASTER:4 < 0
		BASE:MASTER:4 = 0
	PRINTFORML 　体力 -{LOCAL:2}（残り {BASE:MASTER:0}/{MAXBASE:MASTER:0}）

ELSEIF A == 1
	;--- 表現系活動 ---
	IF LOCAL:9
		PRINTFORML 【%CALLNAME:TARGET%の専門！%CSTR:TARGET:25%で表現系活動】
	ELSE
		PRINTFORML 【表現系活動】
	ENDIF
	PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%は一緒に表現を磨いた。
	TRYCALLFORM KOJO_CLUB_K{NO:TARGET}

	P = RAND:5 + ABL:MASTER:55 / 15 + 1
	SIF LOCAL:9
		P = P * 3 / 2
	SIF P > 12
		P = 12
	IF TALENT:MASTER:223
		P += 3
		PRINTFORML 	（アイドルボーナス +3）
	ENDIF
	ABL:MASTER:94 += P
	EXP:MASTER:99 += P
	PRINTFORML 　%CALLNAME:MASTER%の表現技能 +{P}（Lv{ABL:MASTER:94} 経験{EXP:MASTER:99}）

	P = RAND:5 + ABL:TARGET:55 / 15 + 1
	SIF LOCAL:9
		P = P * 3 / 2
	SIF P > 12
		P = 12
	IF TALENT:TARGET:223
		P += 3
		PRINTFORML 	（%CALLNAME:TARGET%のアイドルボーナス +3）
	ENDIF
	ABL:TARGET:94 += P
	SIF ABL:TARGET:94 > 100
		ABL:TARGET:94 = 100
	PRINTFORML 　%CALLNAME:TARGET%の表現技能 +{P}（{ABL:TARGET:94}/100）

	;気力消費
	LOCAL:2 = MAXBASE:MASTER:1 / 5
	BASE:MASTER:1 -= LOCAL:2
	SIF BASE:MASTER:1 < 0
		BASE:MASTER:1 = 0
	PRINTFORML 　気力 -{LOCAL:2}（残り {BASE:MASTER:1}/{MAXBASE:MASTER:1}）

ELSEIF A == 2
	;--- 知識系活動 ---
	IF LOCAL:9
		PRINTFORML 【%CALLNAME:TARGET%の専門！%CSTR:TARGET:25%で知識系活動】
	TRYCALLFORM KOJO_CLUB_K{NO:TARGET}
	ELSE
		PRINTFORML 【知識系活動】
	TRYCALLFORM KOJO_CLUB_K{NO:TARGET}
	ENDIF
	PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%は一緒に探求した。

	P = RAND:5 + ABL:MASTER:56 / 15 + 1
	SIF LOCAL:9
		P = P * 3 / 2
	SIF P > 12
		P = 12
	IF TALENT:MASTER:222
		P += 3
		PRINTFORML 	（霊感ボーナス +3）
	ENDIF
	ABL:MASTER:95 += P
	PRINTFORML 　%CALLNAME:MASTER%の知識技能 +{P}（{ABL:MASTER:95}）

	P = RAND:5 + ABL:TARGET:56 / 15 + 1
	SIF LOCAL:9
		P = P * 3 / 2
	SIF P > 12
		P = 12
	IF TALENT:TARGET:222
		P += 3
		PRINTFORML 	（%CALLNAME:TARGET%の霊感ボーナス +3）
	ENDIF
	ABL:TARGET:95 += P
	SIF ABL:TARGET:95 > 100
		ABL:TARGET:95 = 100
	PRINTFORML 　%CALLNAME:TARGET%の知識技能 +{P}（{ABL:TARGET:95}/100）

	;体力消費（軽微）
	LOCAL:2 = MAXBASE:MASTER:0 / 10
	SIF LOCAL:2 < 10
		LOCAL:2 = 10
	BASE:MASTER:0 -= LOCAL:2
	SIF BASE:MASTER:0 < 0
		BASE:MASTER:0 = 0
	PRINTFORML 　体力 -{LOCAL:2}（残り {BASE:MASTER:0}/{MAXBASE:MASTER:0}）

ELSEIF A == 3
	;--- 一緒に自習 ---
	PRINTFORML 【一緒に自習】
	PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%は放課後に自習した。
	TRYCALLFORM KOJO_CLUB_K{NO:TARGET}

	;学習経験+、学力素質が高いほど多め
	P = RAND:3 + ABL:MASTER:98 / 30 + 1
	SIF P > 5
		P = 5
	EXP:MASTER:95 += P
	PRINTFORML 　%CALLNAME:MASTER%の学習経験 +{P}（{EXP:MASTER:95}）

	P = RAND:3 + ABL:TARGET:98 / 30 + 1
	SIF P > 5
		P = 5
	EXP:TARGET:95 += P
	PRINTFORML 　%CALLNAME:TARGET%の学習経験 +{P}（{EXP:TARGET:95}）

	;体力・気力消費は少ない
	BASE:MASTER:4 -= 20
	SIF BASE:MASTER:4 < 0
		BASE:MASTER:4 = 0
	BASE:MASTER:1 -= 30
	SIF BASE:MASTER:1 < 0
		BASE:MASTER:1 = 0
	PRINTFORML 　体力 -20　気力 -30

ELSEIF A == 4
	;--- 生活系活動 ---
	PRINTFORML 【生活系活動】
	PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%は一緒に家事を手伝った。
	TRYCALLFORM KOJO_CLUB_K{NO:TARGET}

	;料理技能UP（料理素質が高いほど多め）
	P = RAND:5 + ABL:MASTER:50 / 15 + 1
	SIF P > 12
		P = 12
	ABL:MASTER:90 += P
	SIF ABL:MASTER:90 > 100
		ABL:MASTER:90 = 100
	EXP:MASTER:90 += P
	PRINTFORML 　%CALLNAME:MASTER%の料理技能 +{P}（Lv{ABL:MASTER:90} 家事経験{EXP:MASTER:90}）

	P = RAND:5 + ABL:TARGET:50 / 15 + 1
	SIF P > 12
		P = 12
	ABL:TARGET:90 += P
	SIF ABL:TARGET:90 > 100
		ABL:TARGET:90 = 100
	PRINTFORML 　%CALLNAME:TARGET%の料理技能 +{P}（{ABL:TARGET:90}/100）

	;体力消費（中程度）
	LOCAL:2 = MAXBASE:MASTER:0 / 8
	SIF LOCAL:2 < 10
		LOCAL:2 = 10
	BASE:MASTER:0 -= LOCAL:2
	SIF BASE:MASTER:0 < 0
		BASE:MASTER:0 = 0
	PRINTFORML 　体力 -{LOCAL:2}（残り {BASE:MASTER:0}/{MAXBASE:MASTER:0}）
ENDIF

;好感度UP（一緒に活動）
CFLAG:TARGET:2 += 2
PRINTFORML 　%CALLNAME:TARGET%の好感度 +2（現在：{CFLAG:TARGET:2}）

;専門ボーナス表示（技能×1.5の結果はすでにP計算に反映済み）
SIF LOCAL:9
	PRINTFORML 　（専門ボーナス）%CSTR:TARGET:25%の得意分野！技能上昇×1.5

;互換素質の同期
CALL SYNC_CLUB_ABL

;ランダムイベント（25%）
LOCAL:1 = RAND:4
SIF LOCAL:1 == 0
	CALL ACTIVITY_RANDOM_EVENT

PRINTL 
WAIT
RETURN 1

;---------------------------------------------------------
;ランダムイベント（TFLAG:82=アクティビティ種別）
;---------------------------------------------------------
@ACTIVITY_RANDOM_EVENT
A = TFLAG:82
B = RAND:4

DRAWLINE
PRINTFORML 【放課後イベント！】

IF A == 0
	;運動系イベント
	IF B == 0
		PRINTFORML 練習試合が急に組まれた！本気で動いたおかげで大きく成長した。
		ABL:MASTER:93 += 3
		ABL:TARGET:93 += 3
		SIF ABL:TARGET:93 > 100
			ABL:TARGET:93 = 100
		PRINTFORML 　運動技能 さらに+3（主人公:{ABL:MASTER:93} %CALLNAME:TARGET%:{ABL:TARGET:93}）
	ELSEIF B == 1
		PRINTFORMW %CALLNAME:TARGET%のプレーに思わず見とれてしまった……！
		CFLAG:TARGET:2 += 3
		ABL:MASTER:93 += 2
		PRINTFORML 　好感度+3　運動技能+2（{ABL:MASTER:93}）
	ELSEIF B == 2
		PRINTFORML コーチから個別指導を受けた。フォームが改善された。
		ABL:MASTER:54 += 1
		SIF ABL:MASTER:54 > 100
			ABL:MASTER:54 = 100
		PRINTFORML 　運動素質+1（{ABL:MASTER:54}）
	ELSE
		PRINTFORML 全力を出し切ってヘトヘトになった。でも充実した！
		BASE:MASTER:4 -= MAXBASE:MASTER:0 / 5
		SIF BASE:MASTER:4 < 0
			BASE:MASTER:4 = 0
		ABL:MASTER:93 += 2
		PRINTFORML 　疲労増加　運動技能+2（{ABL:MASTER:93}）
	ENDIF

ELSEIF A == 1
	;表現系イベント
	IF B == 0
		PRINTFORML 合同発表会の練習！人前での度胸がついた。
		ABL:MASTER:94 += 3
		ABL:TARGET:94 += 3
		SIF ABL:TARGET:94 > 100
			ABL:TARGET:94 = 100
		PRINTFORML 　表現技能 さらに+3（主人公:{ABL:MASTER:94} %CALLNAME:TARGET%:{ABL:TARGET:94}）
	ELSEIF B == 1
		PRINTFORMW %CALLNAME:TARGET%のパフォーマンスに心が震えた……！
		CFLAG:TARGET:2 += 4
		ABL:MASTER:55 += 1
		SIF ABL:MASTER:55 > 100
			ABL:MASTER:55 = 100
		PRINTFORML 　好感度+4　表現素質+1（{ABL:MASTER:55}）
	ELSEIF B == 2
		PRINTFORML 新しい表現のアイデアがひらめいた！
		ABL:MASTER:94 += 2
		PRINTFORML 　表現技能+2（{ABL:MASTER:94}）
	ELSE
		PRINTFORML 長時間練習してクタクタになった。でも充実している。
		BASE:MASTER:1 -= MAXBASE:MASTER:1 / 5
		SIF BASE:MASTER:1 < 0
			BASE:MASTER:1 = 0
		ABL:MASTER:94 += 2
		PRINTFORML 　疲労増加　表現技能+2（{ABL:MASTER:94}）
	ENDIF

ELSEIF A == 2
	;知識系イベント
	IF B == 0
		PRINTFORML 調べていたら面白い発見が！みんなで議論が盛り上がった。
		ABL:MASTER:95 += 3
		ABL:TARGET:95 += 3
		SIF ABL:TARGET:95 > 100
			ABL:TARGET:95 = 100
		PRINTFORML 　知識技能 さらに+3（主人公:{ABL:MASTER:95} %CALLNAME:TARGET%:{ABL:TARGET:95}）
	ELSEIF B == 1
		PRINTFORMW %CALLNAME:TARGET%の話が面白くて時間を忘れた。
		CFLAG:TARGET:2 += 3
		ABL:MASTER:95 += 2
		PRINTFORML 　好感度+3　知識技能+2（{ABL:MASTER:95}）
	ELSEIF B == 2
		PRINTFORML 部活の内容が試験にも直結することに気づいた！
		EXP:MASTER:95 += 2
		PRINTFORML 　学習経験+2（{EXP:MASTER:95}）
	ELSE
		PRINTFORML 気づいたら外が真っ暗になっていた。でも充実した時間だった。
		BASE:MASTER:0 -= MAXBASE:MASTER:0 / 10
		SIF BASE:MASTER:0 < 0
			BASE:MASTER:0 = 0
		ABL:MASTER:95 += 2
		PRINTFORML 　疲労増加　知識技能+2（{ABL:MASTER:95}）
	ENDIF

ELSEIF A == 3
	;自習イベント
	IF B == 0
		PRINTFORML 問題が解けた！達成感で気力が湧いてきた。
		EXP:MASTER:95 += 2
		EXP:TARGET:95 += 2
		PRINTFORML 　学習経験+2（主人公:{EXP:MASTER:95} %CALLNAME:TARGET%:{EXP:TARGET:95}）
	ELSEIF B == 1
		PRINTFORMW %CALLNAME:TARGET%に勉強を教えてもらった！分かりやすかった。
		CFLAG:TARGET:2 += 3
		EXP:MASTER:95 += 3
		PRINTFORML 　好感度+3　学習経験+3（{EXP:MASTER:95}）
	ELSEIF B == 2
		PRINTFORML 集中して取り組んだことで知識が定着した気がする。
		EXP:MASTER:95 += 2
		ABL:MASTER:98 += 1
		SIF ABL:MASTER:98 > 100
			ABL:MASTER:98 = 100
		PRINTFORML 　学習経験+2　学力素質+1（{ABL:MASTER:98}）
	ELSE
		PRINTFORML 夢中になって勉強したら閉館時間になってしまった……。
		EXP:MASTER:95 += 3
		EXP:TARGET:95 += 1
		PRINTFORML 　学習経験+3（主人公）　学習経験+1（%CALLNAME:TARGET%）
	ENDIF

ELSEIF A == 4
	;生活系イベント
	IF B == 0
		PRINTFORML %CALLNAME:TARGET%の手際の良さに感心した！真似してみたら上手くできた。
		ABL:MASTER:90 += 3
		SIF ABL:MASTER:90 > 100
			ABL:MASTER:90 = 100
		ABL:TARGET:90 += 3
		SIF ABL:TARGET:90 > 100
			ABL:TARGET:90 = 100
		PRINTFORML 　料理技能 さらに+3（主人公:{ABL:MASTER:90} %CALLNAME:TARGET%:{ABL:TARGET:90}）
	ELSEIF B == 1
		PRINTFORMW %CALLNAME:TARGET%が作った料理がとても美味しかった……！
		CFLAG:TARGET:2 += 3
		ABL:MASTER:90 += 2
		SIF ABL:MASTER:90 > 100
			ABL:MASTER:90 = 100
		PRINTFORML 　好感度+3　料理技能+2（{ABL:MASTER:90}）
	ELSEIF B == 2
		PRINTFORML %CALLNAME:TARGET%から料理のコツを教わった！素質が上がった気がする。
		ABL:MASTER:50 += 1
		SIF ABL:MASTER:50 > 100
			ABL:MASTER:50 = 100
		PRINTFORML 　料理素質+1（{ABL:MASTER:50}）
	ELSE
		PRINTFORML 夢中で家事をしていたら体が慣れてきた。充実した時間だった。
		BASE:MASTER:0 -= MAXBASE:MASTER:0 / 8
		SIF BASE:MASTER:0 < 0
			BASE:MASTER:0 = 0
		ABL:MASTER:90 += 2
		SIF ABL:MASTER:90 > 100
			ABL:MASTER:90 = 100
		PRINTFORML 　疲労増加　料理技能+2（{ABL:MASTER:90}）
	ENDIF
ENDIF
RETURN 1

;---------------------------------------------------------
;現在の技能値表示
;---------------------------------------------------------
@SHOW_CLUB_STATUS
;gakuryoku = shitsushitsu + keiken * shitsushitsu / 500
LOCAL:10 = ABL:MASTER:98 + EXP:MASTER:95 * ABL:MASTER:98 / 500
LOCAL:11 = ABL:TARGET:98 + EXP:TARGET:95 * ABL:TARGET:98 / 500
PRINTFORML 【現在の技能】
PRINTFORML 　学力    ：{LOCAL:10}　（%CALLNAME:TARGET%：{LOCAL:11}）
PRINTFORML 　運動技能：{ABL:MASTER:93}/100　（%CALLNAME:TARGET%：{ABL:TARGET:93}/100）
PRINTFORML 　表現技能：{ABL:MASTER:94}/100　（%CALLNAME:TARGET%：{ABL:TARGET:94}/100）
PRINTFORML 　知識技能：{ABL:MASTER:95}/100　（%CALLNAME:TARGET%：{ABL:TARGET:95}/100）
PRINTFORML 　料理技能：{ABL:MASTER:90}/100　（%CALLNAME:TARGET%：{ABL:TARGET:90}/100）
RETURN 1

;---------------------------------------------------------
;既存セーブ対応：CFLAG:25未設定キャラに部活タイプを設定
;---------------------------------------------------------
@INIT_CLUB_FLAGS
A = 0
REPEAT CHARANUM
	SIF CFLAG:COUNT:25 > 0
		A = 1
		BREAK
REND
SIF A
	RETURN 0

REPEAT CHARANUM
	B = NO:COUNT
	IF B == 1 || B == 4 || B == 9 || B == 13 || B == 20 || B == 27 || B == 30 || B == 34 || B == 36 || B == 52 || B == 62 || B == 63 || B == 66
		CFLAG:COUNT:25 = 2
		SIF CSTR:COUNT:25 == ""
			CSTR:COUNT:25 = 表現部
	ELSEIF B == 2 || B == 3 || B == 6 || B == 8 || B == 10 || B == 11 || B == 21 || B == 23 || B == 24 || B == 28 || B == 39 || B == 43 || B == 44 || B == 45 || B == 46 || B == 47 || B == 51 || B == 54 || B == 55 || B == 58 || B == 61 || B == 65 || B == 68 || B == 70
		CFLAG:COUNT:25 = 3
		SIF CSTR:COUNT:25 == ""
			CSTR:COUNT:25 = 知識部
	ELSEIF B == 5 || B == 7 || B == 12 || B == 14 || B == 15 || B == 16 || B == 17 || B == 18 || B == 19 || B == 22 || B == 26 || B == 29 || B == 33 || B == 35 || B == 37 || B == 38 || B == 40 || B == 41 || B == 42 || B == 48 || B == 49 || B == 50 || B == 53 || B == 56 || B == 57 || B == 59 || B == 67 || B == 69 || B == 71
		CFLAG:COUNT:25 = 1
		SIF CSTR:COUNT:25 == ""
			CSTR:COUNT:25 = 運動部
	ELSE
		CFLAG:COUNT:25 = 0
		SIF CSTR:COUNT:25 == ""
			CSTR:COUNT:25 = 帰宅部
	ENDIF
REND

RETURN 1
