;料理の種類決定
;K = 料理の種類
;N = 料理の値段の基礎
;固有料理のパターンが口上で把握出来ないので先に呼ぶ
IF K == 0 && RAND:2 == 0
	TFLAG:14 = 1
ENDIF
CALL LUNCH_MENU

;料理素質で補正をかける
IF ABL:50 == 2
	TIMES L , 1.20
ELSEIF ABL:50 == 1
	TIMES L , 1.10
ELSEIF ABL:50 == -1
	TIMES L , 0.90
ENDIF

;謎の魅力
SIF TALENT:92
	TIMES N , 1.10

;魅力
SIF TALENT:113
	TIMES N , 1.10

;人気
SIF TALENT:126
	TIMES N , 1.30

;R = 料理の出来栄え
R = (RAND:100 + ABL:TARGET:90) / 10
SIF R <= 0
	R = 1
SIF R >= 10
	R = 10

;金額計算
M = L * N * R * 3
SIF TALENT:153
	TIMES M , 1.30

;獲得資金増加ボーナス
IF ABL:MASTER:86 == 1
	TIMES M , 1.50
ELSEIF ABL:MASTER:86 > 1
	M *= ABL:MASTER:86
ENDIF

;値段が高くなり過ぎないように補正をかける
;75000を超えた分は25%OFF
SIF M >= 75000
	M = 75000 + (M - 75000) / 4 * 3
;補正後、150000を超えていたらその分を更に50%OFF
SIF M >= 150000
	M = 150000 + (M - 150000) / 2
;補正後、300000を超えていたらその分を更に75%OFF
SIF M >= 300000
	M = 300000 + (M - 300000) / 4
;補正後、500000を超えていたらその分を更に90%OFF
SIF M >= 500000
	M = 500000 + (M - 500000) / 10
;補正後、1000000を超えていたらその分を更に90%OFF
SIF M >= 1000000
	M = 1000000 + (M - 1000000) / 10

;P:1 = 乱数処理
IF ABL:90 <= 10
	P:1 = ABL:90
ELSEIF ABL:90 <= 20
	P:1 = 10 + (ABL:90 / 4)
ELSEIF ABL:90 <= 30
	P:1 = 15 + (ABL:90 / 6)
ELSEIF ABL:90 <= 40
	P:1 = 20 + (ABL:90 / 8)
ELSEIF ABL:90 <= 50
	P:1 = 25 + (ABL:90 / 10)
ELSEIF ABL:90 <= 60
	P:1 = 30 + (ABL:90 / 12)
ELSEIF ABL:90 <= 70
	P:1 = 35 + (ABL:90 / 14)
ELSEIF ABL:90 <= 80
	P:1 = 40 + (ABL:90 / 16)
ELSEIF ABL:90 <= 90
	P:1 = 45 + (ABL:90 / 18)
ELSE
	P:1 = 50 + (ABL:90 / 20)
ENDIF
P:1 += RAND:4

;Q = 習得の珠取得数
IF R >= 10
	Q = L * (P:1+1) * 5
ELSEIF R >= 5
	Q = L * (P:1+1) * 4
ELSEIF R >= 3
	Q = L * (P:1+1) * 3
ELSE
	Q = L * (P:1+1) * 2
ENDIF
SIF ABL:90 >= 50 && TALENT:153
	Q *= 3

;S = 奉仕快楽経験上昇値
S = M / 20000
SIF S < 2
	S = 2
SIF S > 16
	S = 16

;親密でL(恭順・好意の珠取得数)を補正
L = L * ABL:0 / 15
;EXキャラ補正(恋慕有りだと効果UP、恋慕無しだと珠なし)
