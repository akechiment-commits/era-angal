;-------------------------------------------------
; ウフフ時指定衣装の自動着用処理
;-------------------------------------------------
@AUTO_WEAR_FAVORITE_CLOTH
IF TARGET >= 1 && TARGET < CHARANUM && CFLAG:TARGET:1215 > 0 && TEQUIP:TARGET:65 == 0	; 【無[コスプレ] / TARGET:[ウフフ時指定衣装]>0】
	CALL CLOTH_NAME
	TEQUIP:TARGET:65 = CFLAG:TARGET:1215
	PRINTFORMW （二人きりの雰囲気を察した%CALLNAME:TARGET%は、事前に指定されていた【%TSTR:(CFLAG:TARGET:1215)%】に着替えました）
ENDIF
