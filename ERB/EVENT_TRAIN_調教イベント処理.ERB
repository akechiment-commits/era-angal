;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@EVENTTRAIN
#PRI
;衰弱療養中のパートナーとは調教を開始できない（安全防護）
IF TARGET >= 0 && TARGET < CHARANUM && BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
	PRINTL 
	SETCOLOR 0xFF6666
	PRINTFORMW （%CALLNAME:TARGET%は体力を消耗して衰弱療養中（お休み）のため、調教を開始できません）
	RESETCOLOR
	BEGIN AFTERTRAIN
	RETURN 0
ENDIF
;一緒に過ごす（調教開始）回数加算
IF TARGET >= 1 && TARGET < CHARANUM
	CFLAG:TARGET:1213 += 1
ENDIF
;-------------------------------------------------
; カード収集状況とキャラ固有コマンド(COM280-284/410-414)解放フラグ(CFLAG:69)を同期
;-------------------------------------------------
CALL DOKUJI_COM_MIGRATE
;-------------------------------------------------
; おあずけ事後暴走判定用：調教開始時点の性交経験合計（Ｖ経験[EXP:0]＋Ａ経験[EXP:1]）を記録
; ・CFLAG:1285 [調教開始時性交経験合計] に保存し、調教終了時(@SELF_OAZUKE_RAMPAGE_CHECK)に比較する
;-------------------------------------------------
FOR LOCAL, 0, CHARANUM
	CFLAG:LOCAL:1285 = EXP:LOCAL:0 + EXP:LOCAL:1	; 【[調教開始時性交経験合計] = [Ｖ経験] + [Ａ経験]】
NEXT
;前回の調教終了時に立てた、強制終了・追加パートナーターン抑止フラグを戻す。
TFLAG:999 = 0
TFLAG:301 = 0
TFLAG:898 = 0
TFLAG:899 = 0
;調教中アイテム使用済みフラグ初期化（1回の調教で同一アイテムは1回のみ使用可能）
FOR LOCAL, 500, 531
	TFLAG:LOCAL = 0
NEXT
TFLAG:895 = 0
TFLAG:896 = 0
TFLAG:897 = 0
TFLAG:51 = 0
TFLAG:995 = 0
;主人公の射精を0に
BASE:MASTER:2 = 0
;主人公の精神絶頂を0に
BASE:MASTER:6 = 0
;いちおう調教対象と助手も
BASE:TARGET:2 = 0
SIF ASSI >= 0
	BASE:ASSI:2 = 0
BASE:TARGET:3 = 0

;射精フラグ、処女喪失フラグなどをリセット
REPEAT 200
	TFLAG:COUNT = 0
REND
;-------------------------------------------------
; 行事・定期試験・定期戦後の余韻ボーナス反映処理（TFLAGリセット後に適用）
; 【発動条件】TARGETが有効 かつ CFLAG:TARGET:1286 [行事後余韻フラグ] > 0（段階1～3）
; 【獲得パラメータ補正】
;   ・TFLAG:37 [ムード]     += 25 * 余韻段階（+25 ～ +75）
;   ・PALAM:5  [欲情]       += 3000 * 余韻段階（+3000 ～ +9000）
;   ・PALAM:3  [潤滑]       += 1500 * 余韻段階（+1500 ～ +4500）
;   ・反映後に CFLAG:TARGET:1286 を 0 にリセット
;-------------------------------------------------
IF TARGET >= 1 && TARGET < CHARANUM && CFLAG:TARGET:1286 > 0	; 【TARGET:[行事後余韻フラグ]>0】
	TFLAG:37 += 25 * CFLAG:TARGET:1286	; 【[ムード]加算】
	PALAM:TARGET:5 += 3000 * CFLAG:TARGET:1286	; 【TARGET:[欲情]加算】
	PALAM:TARGET:3 += 1500 * CFLAG:TARGET:1286	; 【TARGET:[潤滑]加算】
	SETCOLOR 255, 170, 220
	PRINTFORML %CALLNAME:TARGET%の瞳には、先ほど二人きりで重ねた逢瀬の甘い余韻と火照りがまだ色濃く残っている…
	RESETCOLOR
	; TARGETの余韻フラグは後続ループで一括クリア
ENDIF
; 調教開始により、全キャラの行事後余韻フラグを一括リセット（他キャラへの持ち越し防止）
FOR LOCAL, 0, CHARANUM
	CFLAG:LOCAL:1286 = 0
NEXT
FLAG:1286 = 0
SIF TARGET >= 0 && TARGET < CHARANUM
	TEQUIP:TARGET:53 = 0
FLAG:22 = 0

;調教者は誰か
IF ASSIPLAY == 0	; 【調教者:[主人]】
	PLAYER = MASTER
ELSE
	PLAYER = ASSI
ENDIF


;コンフィグによる各種フラグ操作
IF (FLAG:23 & 1) && TALENT:152	; 【[合意]】
	;初期ウフフONで合意持ちなら最初からウフフ
	TFLAG:44 = 1
ENDIF
IF (FLAG:23 & 8)
	;主導権を初期設定
	SIF CFLAG:15 == 1	; 【[主導権設定]==1】
		TFLAG:45 = 0
	SIF CFLAG:15 == 2	; 【[主導権設定]==2】
		TFLAG:45 = 1
ENDIF

;初期ウフフONの場合、ウフフ時指定衣装の自動着用チェック
IF TFLAG:44 == 1	; 【[ウフフ中]==1】
	CALL AUTO_WEAR_FAVORITE_CLOTH
ENDIF

;旧FINISH.ERBから移動
@EVENTTURNEND
#PRI
;売却や助手化が可能になったか
SIF TARGET < 0 || BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
	RETURN 0
IF (ABL:0 >= 10 && ABL:1 >= 8) || (ABL:0 >= 5 && ABL:1 >= 5 && ABL:9 >= 3) || CFLAG:2 >= 1000 || TALENT:152 || TALENT:153	; 【[合意] / [恋人] / [親密]Lv>=10 / [欲望]Lv>=8 / [親密]Lv>=5 / [欲望]Lv>=5 / [レズっ気]Lv>=3 / [好感度]>=1000】
	IF CFLAG:1 <= 1	; 【[助手可能]<=1】
		TFLAG:13 = 31
		CALL SELF_KOJO
		PRINTFORMW %NAME:TARGET%が助手可能になりました
		CFLAG:1 = 2
	ENDIF
ENDIF

RETURN 0

