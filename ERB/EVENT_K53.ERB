			;それ以外
			ELSE
				PRINTFORMW 「うわ、綺麗に当たったわね…大丈夫？」
			ENDIF
		;成功以上
		ELSE
			;恋慕
			IF TALENT:85 == 1 && (CFLAG:401 < 6 || FLAG:7 == 2)
