;-------------------------------------------------
;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------

;--------------------------------------------------
;口上ファイルの存在判定（X2をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:153 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:153 = 0

;--------------------------------------------------
;純愛イベント口上　 CFLAG221
;--------------------------------------------------
@KOJO_JUN_K53
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;-------------------------------------------------
IF TFLAG:600 == 0 && CFLAG:220 == 0
	PRINTL 豊姫様の処女は俺がいただく！
	PRINTL [0] イェアーッ！(素質処女を獲得、V経験及びV感覚を0にします)
	PRINTL [1] 二度も破瓜の痛みを味わわせるなんて！(デフォルトのままで開始します)
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―処女モードに素質、能力を変更します―
		TALENT:TARGET:0 = 1
		ABL:TARGET:4 = 0
		EXP:TARGET:0 = 0
	ELSEIF RESULT == 1
		PRINTFORMW ―通常モードで調教を開始します―
	ELSE
		GOTO INPUT_LOOP
	ENDIF

	PRINTL 豊姫様はああ見えて純情なお方なんですよ
	PRINTL [0] 当然だ(素質が変化して少しガードが堅くなります)
	PRINTL [1] んなこたぁない(素質の変化はありませんが口上と若干の矛盾が発生する場合があります)
	$INPUT_LOOP2
	INPUT
	IF RESULT == 0
		PRINTFORMW ―純で奥手なとよねえもいいよね！―
		TALENT:TARGET:27 = 1
		TALENT:TARGET:30 = 1
		;ここで一旦快感に素直を消去し恥じらいを取得
		TALENT:TARGET:35 = 1
		TALENT:TARGET:70 = 0
	ELSEIF RESULT == 1
		PRINTFORMW ―手取り足取り腰取りリードしてくれるとよねえもいいよね！―
	ELSE
		GOTO INPUT_LOOP2
	ENDIF
	CFLAG:220 = 1
ENDIF

