					IF A == 1
						PRINTFORMW 「んー…こっちに弾を出すとこっちが空くから、それでここら辺まで詰めれば…」
					ELSE
						PRINTFORMW 「軽く運動するには良いかも知れないわね」
					ENDIF
				ENDIF
				CFLAG:401 = 5
			;キス経験有り
			ELSEIF EXP:96 > 0 && (CFLAG:401 < 4 || FLAG:7 == 2)
				;戦闘技能Lv5以上
				IF ABL:88 >= 5
					A = RAND:2
					IF A == 1
						PRINTFORMW 「相変わらず避けるわね、それじゃこういうのはどうかしら！」
					ELSE
						PRINTFORMW 「ほらほら、上手く逃げないと当たっちゃうわよ！」
					ENDIF
				;戦闘技能Lv5以下
				ELSEIF ABL:88 <= 5
					A = RAND:2
					IF A == 1
						PRINTFORMW 「勝負ね？　負けないわよ！」
					ELSE
						PRINTFORMW 「ルールは簡単だけど実際は結構頭を使うわね。こういうのって存外好きよ」
					ENDIF
				ENDIF
				CFLAG:401 = 4
			;デート経験有り
			ELSEIF EXP:94 > 0 && (CFLAG:401 < 3 || FLAG:7 == 2)
				;戦闘技能Lv5以上
				IF ABL:88 >= 5
					A = RAND:2
					IF A == 1
						PRINTFORMW 「これくらい濃い弾幕を張れば…え？　回避不可な物は駄目？　むぅ…」
					ELSE
						PRINTFORMW 「ええ！？　今の避けられちゃうの！？　もっと工夫しないと駄目なのね」
					ENDIF
				;戦闘技能Lv5以下
				ELSEIF ABL:88 <= 5
					A = RAND:2
					IF A == 1
						PRINTFORMW 「座学が無い分、実戦でないと得られないものが多いわね」
					ELSE
						PRINTFORMW 「この弾幕は避けられるかしら！？」
					ENDIF
				ENDIF
				CFLAG:401 = 3
			;それ以外
			ELSEIF CFLAG:401 < 2 || FLAG:7 == 2
				;戦闘技能Lv5以上
				IF ABL:88 >= 5
					A = RAND:2
					IF A == 1
						PRINTFORMW 「戦い方にも大分慣れてきたわ。ちょっと勝負してみない？」
					ELSE
						PRINTFORMW 「あなたもかなり力が付いてきたんじゃない？」
					ENDIF
				;戦闘技能Lv5以下
				ELSEIF ABL:88 <= 5
					A = RAND:2
					IF A == 1
						PRINTFORMW 「ねえ、こんなスペルカード考えてみたんだけどどうかしら」
						PRINTFORMW ………これは
						B = RAND:3
						IF B == 2
							PRINTFORMW 「回避できない物は駄目？　当てなきゃいけないのに、変なルールね」
						ELSEIF B == 1
							PRINTFORMW 「美しさに欠ける？　一々面倒なルールを作ったものね」
						ELSE
							PRINTFORMW 「使えそう？　それじゃ早速名前を決めなくちゃね！」
						ENDIF
					ELSE
						PRINTFORMW 「弾幕の練習って言っても、何をどうすれば良いのかさっぱりだわ」
					ENDIF
				ENDIF
