;口上ファイル存在判定
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:195 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:195 = 0

@EVENTSHOP
SIF TARGET < 0
	RETURN 0
SIF NO:MASTER != 0
	RETURN 0
SIF TALENT:MASTER:122 == 0
	RETURN 0
IF NO:TARGET != 95
	RETURN 0
ELSE
	
ENDIF

;--------------------------------------------------
;地の文カットが立ってたらOFFる
;--------------------------------------------------
SIF CFLAG:99 && (NO:TARGET == 95)
	CFLAG:99 = 0

;--------------------------------------------------
;朝イベントカット判定
;--------------------------------------------------
SIF CFLAG:600 && (NO:TARGET == 95)
	TFLAG:121 = 1

;--------------------------------------------------
;夜イベントカットが立ってたらOFFる
;--------------------------------------------------
SIF CFLAG:98 && (NO:TARGET == 95)
	CFLAG:98 = 0

;--------------------------------------------------
;膣内射精フラグ立ってたらOFFる
;--------------------------------------------------
SIF CFLAG:627 && (NO:TARGET == 95)
	CFLAG:627 = 0

;--------------------------------------------------
;休憩で特性逃がしてたら復帰する
;--------------------------------------------------
SIF CFLAG:624 & 1 && (NO:TARGET == 95)
	TALENT:54 = 1
SIF CFLAG:624 & 2 && (NO:TARGET == 95)
	TALENT:124 = 1
CFLAG:624 = 0

;--------------------------------------------------
;エキストラモード構文関数 CFLAG:230を使用
;初調教時に口上設定用の素質に変更したり、オプションの有無を選択させたり出来ます。
;下記に処女化する場合の構文をサンプルとして載せておきます
;また、キャラ固有デート先を追加するかを選択させる構文も追加(使わない場合は削除or放置してください)
;複数選択させる際は$XXXが被らない様に注意してください。GOTO XX → $XXへと処理が飛びます
;IF文内でGOTOを実行するとエラーになるので注意(eramakerのみのバグ)
;又、0以下の数値と比較させた際に正常に動かない可能性があるので要注意
;--------------------------------------------------
@EXTRA_MODE_K95
PRINTL あなたの知ってる星ちゃんは猫舌ですか？
PRINTL [0] もちろんさ！
PRINTL [1] あ、猫舌という体（てゐ）で
$EX_LOOP1
INPUT
SIF RESULT > 1 || (RESULT+1) < 1
	GOTO EX_LOOP1
IF RESULT == 0
	PRINTFORML 星ちゃんに熱いお茶をご馳走しよう
	PRINTFORML フーフーするラヴリーな姿が見れるぞっ
	PRINTL  
	PRINTFORMW ― 通常モードで開始します ―
ELSEIF RESULT == 1
	PRINTFORML 何かと不便ですしね。え？違う？
	PRINTFORML とりあえず人間的な猫舌という体（てゐ）で…
	PRINTL  
	PRINTFORMW ― 星の素質から猫舌を外しました ―
	TALENT:54 = 0
ENDIF

PRINTL  
PRINTL 星ちゃんの珠のような笑顔から視線を下に落とすとそこには…
PRINTL [0] モンゴルを思わせる大平原が！           (ぺたーん)
PRINTL [1] 豊かな山岳地帯を思わせる二つの宝山が！ (ふかふか)
PRINTL [2] 緩やかな美しい丘陵地帯が！             (そのままの君で)
$EX_LOOP2
INPUT
SIF RESULT > 2 || (RESULT+1) < 1
	GOTO EX_LOOP2
IF RESULT == 0
	PRINTFORML スレンダーな星ちゃん可愛い。
	PRINTFORML つるっとしてぺたーん
	PRINTL  
	PRINTFORMW ― 星の素質を貧乳にしました ―
	TALENT:109 = 1
ELSEIF RESULT == 1
	PRINTFORML ふかふかな星ちゃんか。胸が熱くなるな。
	PRINTFORML ぷにぷにふかふか
	PRINTL  
	PRINTFORMW ― 星の素質を巨乳にしました ―
	TALENT:110 = 1
ELSEIF RESULT == 2
	PRINTFORML ナチュラルな星ちゃん素敵。
	PRINTL  
	PRINTFORMW ― 通常モードで開始します ―
ENDIF

SIF TALENT:109
	RETURN 0

PRINTL  
PRINTW ずばり、単刀直入に聞きます。
PRINTL 星ちゃんの搾乳なら…
PRINTL [0] ちょっと見てみたいかも (特殊口上追加)
PRINTL [1] >> 301                 (一般口上のみ)
$EX_LOOP3
INPUT
SIF RESULT > 1 || (RESULT+1) < 1
	GOTO EX_LOOP3
IF RESULT == 0
	PRINTFORML ぃよっしゃぁぁああ！！
	PRINTFORML 若干引く可能性がありますがご了承ください
	PRINTL  
	PRINTFORMW ― 作者の自重制限(リミッター)が解除されます ―
	CFLAG:623 = 1
ELSEIF RESULT == 1
	PRINTFORML ﾄﾞｺﾞｫ
	PRINTFORML ちょっと頭が沸いていた時期に書いた部分が制限されます
	PRINTL  
	PRINTFORMW ― 作者の自重制限(リミッター)が設定されました ―
	CFLAG:623 = 0
ENDIF

RETURN 0

