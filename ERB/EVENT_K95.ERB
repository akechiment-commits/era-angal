;=== 命蓮寺メンバー救出度チェック ===========
@RESCUE_MEMBER_K95
;メンバーの命連寺内発言力と星との友好度を加味してフラグON
;正直、ムラサと一輪の発言力&友好度がどの辺か分からぬぇ…
;響子ちゃんはちょっと保留

;呼ばれる度に再チェックするのでフラグクリア
CFLAG:607 = 0

;ナズーリンを助けている
T = 91
CALL GET_EXISTANCE2
SIF E
	CFLAG:607 |= 8
;一輪を助けている
T = 93
CALL GET_EXISTANCE2
SIF E
	CFLAG:607 |= 2
;ムラサを助けている
T = 94
CALL GET_EXISTANCE2
SIF E
	CFLAG:607 |= 4
;聖を助けている
T = 96
CALL GET_EXISTANCE2
SIF E
	CFLAG:607 |= 16
;ぬえを助けている
T = 97
CALL GET_EXISTANCE2
SIF E
	CFLAG:607 |= 1
RETURN 0
