;TFLAG:41の値が射精箇所が異なる(Wフェラ時は3固定)
;       =1:膣内射精
;       =2:アナル射精
;       =3:口内射精
;-------------------------------------------------
IF TFLAG:6 > 0 && 0
	;初めて
	IF CFLAG:341 == 0
		;恋慕
		IF TALENT:85
			;膣内射精
			IF TFLAG:41 == 1
				PRINTFORMW 
			;アナル射精
			ELSEIF TFLAG:41 == 2
				PRINTFORMW 
			;口内射精
			ELSEIF TFLAG:41 == 3
				PRINTFORMW 
			ENDIF
		;それ以外
		ELSE
			;膣内射精
			IF TFLAG:41 == 1
				PRINTFORMW 
			;アナル射精
			ELSEIF TFLAG:41 == 2
				PRINTFORMW 
			;口内射精
			ELSEIF TFLAG:41 == 3
				PRINTFORMW 
			ENDIF
		ENDIF
		CFLAG:341 = 1
	;二回目以降
	ELSE
		;恋慕
		IF TALENT:85 && (CFLAG:341 < 3 || FLAG:7 == 2)
			;膣内射精
			IF TFLAG:41 == 1
				PRINTFORMW 
			;アナル射精
			ELSEIF TFLAG:41 == 2
				PRINTFORMW 
			;口内射精
			ELSEIF TFLAG:41 == 3
				PRINTFORMW 
			ENDIF
			CFLAG:341 = 3
		;それ以外
		ELSEIF CFLAG:341 < 2 || FLAG:7 == 2
			;膣内射精
			IF TFLAG:41 == 1
				PRINTFORMW 
			;アナル射精
			ELSEIF TFLAG:41 == 2
				PRINTFORMW 
			;口内射精
			ELSEIF TFLAG:41 == 3
				PRINTFORMW 
			ENDIF
			CFLAG:341 = 2
		ENDIF
	ENDIF
	;コンドームを外す
	CFLAG:499 -= (CFLAG:499 & 2)
ENDIF

;-------------------------------------------------
;助手を犯すで射精した(主人のみ) CFLAG340
;-------------------------------------------------
IF TFLAG:6 > 0 && 0
	;初めて
	IF CFLAG:340 == 0
		;恋慕
		IF TALENT:85
			PRINTFORMW 
		;それ以外
		ELSE
			PRINTFORMW 
		ENDIF
		CFLAG:340 = 1
	;二回目以降
	ELSE
		;恋慕
		IF TALENT:85 && (CFLAG:340 < 3 || FLAG:7 == 2)
			PRINTFORMW 
			CFLAG:340 = 3
		;それ以外
		ELSEIF CFLAG:340 < 2 || FLAG:7 == 2
			PRINTFORMW 
			CFLAG:340 = 2
		ENDIF
	ENDIF
	;コンドームを外す
	CFLAG:499 -= (CFLAG:499 & 1)
ENDIF

