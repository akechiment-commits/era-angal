;------------------------------------------------
;愛の結晶生成関数
;------------------------------------------------
;星の身篭った際の状況により子供の特性を決める
;要するにどんな赤ちゃんが生まれるか決める関数
@CHILD_CHAR_K95
CFLAG:630 = 0
;MASTARが親じゃない場合、終了
SIF CFLAG:111 != NO:MASTER
	RETURN 0
;N = 人数	1 or 2
N = 1
;既に子持ちの場合だけ双子発生
IF CFLAG:631
	IF TEQUIP:86 && TALENT:137
		SIF RAND:100 < 30
			N = 2
	ELSEIF TEQUIP:86 || TALENT:137
		SIF RAND:100 < 10
			N = 2
	ELSE
		SIF RAND:100 == 0
			N = 2
	ENDIF
ENDIF

;S = SEX	0 or 1
;絶頂回数と精液量を勘案し、性別決定
S = ((EX:0 + EX:1 + EX:3 + 2)*3)  % CFLAG:101

;E = EX		0 or 1
E = 0
;人数が１人でかつ条件を満たした場合、子供が霊獣化（白虎）
IF N == 1
	IF BASE:0 > 500 && TALENT:85 && EXP:50 == 0 && EXP:23 > 50 && CFLAG:101 > 6 && ((EX:0 > 9 && EX:1 > 9 && EX:3 > 9) || RAND:3 == 0)
		E = 1
	ENDIF
ELSE
	;S = 0 or 1 or 2
	S = S + RAND:2
ENDIF
;結果をセット
;人数bit 0 性別 00 霊獣化 0

SIF N
	CFLAG:630 |= 1
IF S == 2
	CFLAG:630 |= 6
ELSEIF S
	CFLAG:630 |= 2
ENDIF

SIF E
	CFLAG:630 |= 8

RETURN 1




