;-------------------------------------------------
;弾幕ごっこ CFLAG401
;-------------------------------------------------
;恋慕がついてもデレないとか
IF SELECTCOM == 300
	PRINTL 
	;デート中に弾幕はないよな
	IF TEQUIP:2 != 0
		PRINTW 「――この状況で弾幕ごっことか」
		PRINTW 「ばかなの？　死ぬの？」
		PRINTW 怒ったてゐに妖弾を投げつけられた。痛かった。
	;デート中以外
	ELSE
		;判定成功
		IF TFLAG:18 >= 0
			;戦闘技能Lv3以下
			IF ABL:88 <= 3
				A = RAND:7
				IF 0
				ELSEIF A == 0
					PRINTW 「あー、避け方が大きすぎ！」
					PRINTW 「隙だらけじゃないのさ、もう」
				ELSEIF A == 1
					PRINTW 「追い詰められる前に逆方向に切り返す！」
					PRINTW 「基本だよ、もう一度っ」
				ELSEIF A == 2
					PRINTW 「よそ見しないで。目の前の弾に集中しなさいよ」
					PRINTW 「だからぁ、弾幕全体を見ないと事故るんだってば」
				ELSEIF A == 3
					PRINTW 「違う違う。それは一歩。半歩じゃない」
					PRINTW 「空中機動の基礎からやりなおしね」
				ELSEIF A == 4
					PRINTW 「弾がかすっても大丈夫なところと、ダメなところ」
					PRINTW 「ちゃんと頭の中でイメージできてる？」
				ELSEIF A == 5
					PRINTW 「狙って墜とそうとか、考えないほうがいいわよ？」
					PRINTW 「標的は動くんだから」
				ELSEIF A == 6
					PRINTW 「あ、今の避けは結構いいかも」
					PRINTW 「おまけの花丸、あげよっか？」
				ENDIF
			;戦闘技能Lv6以下
			ELSEIF ABL:88 <= 6
				A = RAND:6
				IF 0
				ELSEIF A == 0
					PRINTW 「避けられないと“思う前に”霊撃！」
					PRINTW 「墜ちたくなかったら、そうすんのよ」
				ELSEIF A == 1
					PRINTW 「４分の１歩、８分の１歩、でもってこれが……１ドット」
					PRINTW 「最低限の動きって、こういうことよ？」
				ELSEIF A == 2
					PRINTW 「と、こんなふうに――」
					PRINTW 「遅くて大きい弾に、速くて小さい弾を重ねてやる、と」
					PRINTW 「ちょっとした騙しのテクニックね」
				ELSEIF A == 3
					PRINTW 「全力で悪あがきしてから負けなさいよ」
					PRINTW 「きっとそれが、あんたの糧になるから」
				ELSEIF A == 4
					PRINTW 「一旦仕切り直して次で勝とう、とか思ってなかった？」
					PRINTW 「賭けたコインをあっさり捨てるような真似は好きじゃないわ」
				ELSEIF A == 5
					PRINTW 「ふーん。いい動きしてるじゃない」
					PRINTW 「どう、楽しいでしょ？　弾幕ごっこ」
				ENDIF
			;戦闘技能Lv9以下
			ELSEIF ABL:88 <= 9
				A = RAND:3
				IF 0
				ELSEIF A == 0
					PRINTW 「少し上手くなったからって調子に乗らない」
					PRINTW 「適当な回避してたら痛い目見るよー」
				ELSEIF A == 1
					PRINTW てゐはスペルカードを抜き放った。
					PRINTW 「はい、脱兎『フラスターエスケープ』」
					PRINTW 「この弾道、あんたに読みきれるかしら？」
				ELSEIF A == 2
					PRINTW 「ふふん。良い攻め筋だけどまだまだ甘あぶっ」
					PRINTW 「……い、今のなし！　顔面セーフっ」
					PRINTW 顔面セーフありなんだ……
				ENDIF
			;戦闘技能Lv10以上
			ELSE
				A = RAND:3
				IF 0
				ELSEIF A == 0
					PRINTW 「うう～、おなかいたーい……」
					PRINTW 「きょうは女の子の日だから手加減してほしいウサ……（ﾁﾗｯ）」
					PRINTW そこまでして勝ちたいか。
				ELSEIF A == 1
					PRINTW 弾幕ごっこに勝ったらてゐがふてくされてしまった……
					PRINTW 「避けられない弾幕なんて、反則なんですけどー」
					PRINTW 「あたしが避けられないとか反則なんですけどー」
					PRINTW 理不尽を感じながらも、とにかく謝っておいた。
				ELSEIF A == 2
					PRINTW ｚ軸方向に避けたらめっちゃ怒られた……
					PRINTW 「あんたね、２Ｄ弾幕ＳＴＧを何だと思ってんのよ」
					PRINTW 何の話かわからないが、とにかく謝っておいた。
				ENDIF
			ENDIF
		;判定失敗
		ELSE
			;戦闘技能Lv3以下
			IF ABL:88 <= 3
				PRINTW 「あー、避け方が大きすぎ！」
				PRINTW 「隙だらけじゃないのさ、もう」
			;戦闘技能Lv6以下
			ELSEIF ABL:88 <= 6
				PRINTW 「避けられないと“思う前に”霊撃！」
				PRINTW 「墜ちたくなかったら、そうすんのよ」
			;戦闘技能Lv9以下
			ELSEIF ABL:88 <= 9
				PRINTW 「少し上手くなったからって調子に乗らない」
				PRINTW 「適当な回避してたら痛い目見るよー」
			;戦闘技能Lv10以上
			ELSE
				PRINTW 「ざまぁｗｗｗｗｗｗ」
				PRINTW 最近のてゐは容赦がない……
			ENDIF
		ENDIF
	ENDIF
	PRINTL 
ENDIF

