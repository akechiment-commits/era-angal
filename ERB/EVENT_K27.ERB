	PRINTW 「ウチは月イチでやってるから、そんなに珍しくもないけど……あむ」
;ハロウィン
ELSEIF TIME:1 == 40 && TIME
	PRINTW 「とりっく・あんど・とりーと！　死ねー！」
	PRINTW 投げつけられたかぼちゃを、あなたは辛くものけぞってかわす。
	PRINTW ……これ絶対ハロウィンじゃない。
;天候別
ELSE
	IF 0
	;虹は出ているか？
	ELSEIF TIME:8
		PRINTW 「あの虹は吉兆ね。あたしが言うんだから間違いない」
		PRINTW 「あんたも拝んできたら？」
	;春
	ELSEIF DAY:2 == 0
		;晴れor快晴
		IF TIME:5 < 2
			IF TIME == 0
				PRINTW 「おはよ。そしておやすみ」
				PRINTW 「や、こんだけ暖かいと眠たくもなるってば」
				PRINTW ふぁ、と小さなあくびをひとつして、てゐは瞼をこすった。
			ELSE
				PRINTW 縁側から差す午後の陽の光に、てゐは目を細めている。
				PRINTW 「うん、花見にはもってこいの日和ね」
				PRINTW 「異変が起きててもそれはそれ、これはこれ」
			ENDIF
		;曇
		ELSEIF TIME:5 == 2
			PRINTW 「花曇りってやつかしら。はっきりしない天気ねぇ」
			PRINTW てゐは浮かない顔で独りごちた。
		;雨or大雨
		ELSEIF TIME:5 < 5
			PRINTW 「……」
			PRINTW てゐは雨音に聞き入っているようだ。
			PRINTW 耳が時折思い出したように持ち上がり、はたりと落ちる。
		;表示されないはずだけど一応
		ELSE
			PRINTW 「さあ、これからどうしようか？」
		ENDIF
	;夏
	ELSEIF DAY:2 == 1
		;晴れor快晴
		IF TIME:5 < 2
			IF TIME == 0
				PRINTW 「おはよ。死にたくなるくらい良い天気ね」
				PRINTW 「まだまだ暑くなるわよ。うぅ、死にたい」
				PRINTW 連日の暑さにすっかり参ってしまっている様子だ。
			ELSE
				PRINTW 「あーづーいー」
				PRINTW 「あ゛ー、氷が恋しくなるー」
				PRINTW 耳をぱたぱたさせている。団扇がわりなのかもしれない。
			ENDIF
		;曇
		ELSEIF TIME:5 == 2
			PRINTW 「うがー、蒸し暑いっ」
			PRINTW 「耳の後ろが蒸れるー、きもちわるいー」
			PRINTW 兎も大変らしい。
		;雨
		ELSEIF TIME:5 == 3
			PRINTW 「降るわねー……」
			PRINTW てゐは窓の外を眺めている。
		;大雨
		ELSEIF TIME:5 == 4
			PRINTW 「台風来ちゃったか。外歩きはできそうにないね」
			PRINTW 「……なんか揺れてるんだけど、この家大丈夫？」
			PRINTW たぶん。
		;表示されないはず（ｒｙ
		ELSE
			PRINTW 「さあ、これからどうしようか？」
		ENDIF
	;秋
	ELSEIF DAY:2 == 2
		;晴れor快晴
		IF TIME:5 < 2
			PRINTW 「水が冷えて、葉が朽ちて、虫が眠って」
			PRINTW 「秋は空気の匂いが違うの。わかる？」
			PRINTW 人が知りうるよりずっと多くの匂いを、彼女は嗅ぎ分けているのだろう。
		;曇
		ELSEIF TIME:5 == 2
			PRINTW 「秋の曇り空は憂いを誘う」
			PRINTW 「そこでよ。八意永琳謹製の元気の出るおクスリを――」
			PRINTW 丁重にお断りした。
		;雨
		ELSEIF TIME:5 == 3
			PRINTW 「この時期の雨って冷たいからイヤ……」
			PRINTW てゐは毛布を羽織って呻いている。
		;大雨
		ELSEIF TIME:5 == 4
			PRINTW 「うぇー、ひっどい雨。耳が湿気っちゃう」
			PRINTW 「この状況で外には出たくないわねー」
		;表示されないはず（ｒｙ
		ELSE
			PRINTW 「さあ、これからどうしようか？」
		ENDIF
	;冬
	ELSEIF DAY:2 == 3
		;晴れor快晴
		IF TIME:5 < 2
			IF TIME == 0
				PRINTW 「うう。寒いわねー」
				PRINTW 「冬毛生やしちゃってもいい？」
				PRINTW どこからどう生えるのか。
			ELSE
				PRINTW 「これだけ晴れると、夜中の冷え込みが怖いわね」
				PRINTW 「放射冷却？　なにそれ」
			ENDIF
		;曇
		ELSEIF TIME:5 == 2
			PRINTW 「暗いわ。まるで黄昏時みたい」
			PRINTW 「ま、こんな天気でも楽しみ方はあるんだけど」
		;雪
		ELSEIF TIME:5 == 5
			PRINTW 「あ、ほら。降ってきた」
			PRINTW ふたりで窓からの雪景色を楽しんだ。
		;大雪
		ELSEIF TIME:5 == 6
			PRINTW 雪はいつ終わるともなく降り積もった。
			PRINTW 「この屋根、潰れたりしないよね……？」
		;細氷
		ELSEIF TIME:5 == 8
			PRINTW 「早く早く。珍しいものが見れるよ」
			PRINTW 興奮気味のてゐに誘われて家の外に出る。
			PRINTW 無数の氷の結晶が風に舞い、陽光を撥ねて輝いていた……
		;表示されないはず（ｒｙ
		ELSE
			PRINTW 「さあ、これからどうしようか？」
		ENDIF
	ENDIF
	RETURN 1
ENDIF

