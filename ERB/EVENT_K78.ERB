;J用ヤマメ口上
;DMでちょくちょく使い始めて口上入れたら俺が死んだ
;RR用ヤマメ口上をとにかく参考にさせていただいてます。魅力のどれだけ出せたかわかりませんが
;っていうか可愛杉だろうえろ杉だろうヤマメさんうおおおおおおおおおおおああああああああああ
;おかげで姐御っぽいイメージが少々付いた。絵を見直したら可愛かった。
;一部表現の使用許可もらっちゃったもらっちゃったあ
;J用のレティ、ゆうかりん、輝夜、早苗さん、スレに上げられた日付イベント案、J幽香ver2、魔理沙口上、もこてる講座、美鈴口上などを参考にさせていただきました。
;明るい人はお天道様に当たっても大丈夫！何それ
;
;この口上の改変などについて
;構文に関しては全面的に許可します。むしろどんどん使ってやってください。
;だって俺と同じ趣味と言うことでしょ（ｒｙ
;台詞や文章については、丸コピでない限りまあ。
;むしろ、あなたの嫁がつまらなくなってしまう可能性があるので、なるべく考えてあげてください。
;ネタの取っ掛かりとして使うのなら問題ないと思います。嫁。嫁こそ全て。
;
;注意書き
;CFLAG:137 クリア前にリングを贈っていると立つフラグ。式までの進行管理に利用
;CFLAG:533 ステータス変更アリ
;CFLAG:502 精液中毒Lvの一時保存
;CFLAG:541 旅館独自処理
;CFLAG:542 絶頂時の口上強さ判定 1:静か 2:強い

;--------------------------------------------------
;クリア後から式までの間をどうにかしてみよう構文
;およめさんがやまめちゃんのばあい
;-------------------------------------------------;
@EVENTSHOP
IF FLAG:29 == 78 && FLAG:28 == 1
	CALL YOUBI
	;ヤマメの場所を探す
	A = -1
	REPEAT CHARANUM
		SIF NO:COUNT == 78
			A = COUNT
	REND
	IF A > -1
		;素のJ用朝イベントを発生させないで一時的に0にした精液中毒を戻す
		IF CFLAG:A:502
			ABL:A:11 = CFLAG:A:502
			CFLAG:A:502 = 0
		ENDIF
		
		;リングを贈っている、クリア後で次の日曜日の朝
		IF CFLAG:A:137 == 1 && (TIME:4 & 2) && TIME == 0
			CFLAG:A:137 = 2
			;朝イベントを発生させない
			TFLAG:121 = 1
			;素のJ用朝イベントを発生させない(精液中毒を一時的に0にする)
			CFLAG:A:502 = ABL:A:11
			ABL:A:11 = 0
		;リングを贈っている、クリア後で次の日曜日の夜
		ELSEIF CFLAG:A:137 == 2 && (TIME:4 & 2) && TIME
			CFLAG:A:137 = 3
		ELSEIF CFLAG:A:137 == 3
			IF DAY:5 == 0
				CFLAG:A:137 = 4
			ELSE
				;朝イベントを発生させない
				TFLAG:121 = 1
				;素のJ用朝イベントを発生させない(精液中毒を一時的に0にする)
				CFLAG:A:502 = ABL:A:11
				ABL:A:11 = 0
			ENDIF
		;リングを贈っている、クリア後で次の日曜日　上の条件を満たしていない場合
		;ヤマメさんにリングを贈っておきつつラスボスをヤマメさん以外で倒した場合　どんなやねん
		ELSEIF CFLAG:A:137 == 1 && FLAG:28 == 1 && DAY:5 == 6 && TIME == 0
			CFLAG:A:137 = 0
		ENDIF
	ENDIF
ENDIF

@EVENTSHOP
#LATER
IF TIME
	;ヤマメの番号を取る
	T = 78
	CALL GET_EXISTANCE
	IF E
		E -= 1
		IF CFLAG:E:541 == 3
			CFLAG:E:152 = 1
			CFLAG:E:541 = 1
		ENDIF
	ENDIF
ENDIF

