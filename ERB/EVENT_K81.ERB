;--------------------------------------------------
;親愛取得イベント後の選択肢 CFLAG271
;エキストラモード構文同様のバグ防止措置
;--------------------------------------------------
@SATORI_SHIN_AI3
$INPUT_LOOP5
PRINTL 「早速使ってみます？」
PRINTL [0] 自分に使う
PRINTL [1] さとりに使う
PRINTL [2] 売る
INPUT
SIF RESULT != 0 && RESULT != 1 && RESULT != 2
	GOTO INPUT_LOOP5
;自分に使う
IF RESULT == 0
	PRINTFORMW 　%CALLNAME:MASTER%は[さとりの書]を使った。
	PRINTFORMW 　何か新しい境地へ目覚めた気分だ……。
	PRINTFORML 　
	;技巧アップ
	IF ABL:MASTER:2 < 99
		A = ABL:MASTER:2 + 3
		SIF A > 99
			A = 99
		ABL:MASTER:2 = A
		PRINTFORMW 　書物から得た知識を技術に変えた。
		PRINTFORMW 　%CALLNAME:MASTER%の技巧レベルが{A}になりました
		PRINTFORML 　
		CFLAG:271 |= 1
	ENDIF
	;調合知識
	IF TALENT:MASTER:55 == 0
		PRINTFORMW 　書物から調合に関する知識を習得した。
		PRINTFORMW 　%CALLNAME:MASTER%は[%TALENTNAME:55%]を得た
		PRINTFORML 　
		TALENT:MASTER:55 = 1
		CFLAG:271 |= 2
	ENDIF
	;早漏
	IF TALENT:MASTER:133 == 1
		PRINTFORMW 　何だか欲から解き放たれた気分になった……。
		PRINTFORMW 　%CALLNAME:MASTER%は[%TALENTNAME:133%]を失った
		PRINTFORML 　
		TALENT:MASTER:133 = 0
		CFLAG:271 |= 4
	ENDIF
	IF CFLAG:271 & 4
		PRINTFORMW 「あなたにはそれくらいで丁度良いでしょう」
		SIF ABL:11 > 0
			PRINTFORMW 「多少勿体無い気もしますが、ね」
	ELSEIF CFLAG:271 & 2 || CFLAG:271 & 1
		PRINTFORMW 「こんな処ですかね」
	ELSE
		PRINTFORMW 「あなたには不要でしたか」
	ENDIF
	CFLAG:2 -= 100
;さとりに使う
ELSEIF RESULT == 1
	PRINTFORMW 　%CALLNAME:TARGET%は[さとりの書]を使った。
	PRINTFORMW 　何か新しい境地へ目覚めた気分だ……。
	PRINTFORML 　
	;技巧アップ
	IF ABL:2 < 99
		B = ABL:2 + 10
		SIF B > 99
			B = 99
		ABL:2 = B
		PRINTFORMW 　書物から得た知識を技術に変えた。
		PRINTFORMW 　%CALLNAME:TARGET%の技巧レベルが{B}になりました
		PRINTFORML 　
	ENDIF
	;欲望ダウン
	IF ABL:1 > 0
		C = ABL:1 - 5
		SIF C < 0
			C = 0
		ABL:1 = C
		PRINTFORMW 　何だか欲から解き放たれた気分になった……。
		PRINTFORMW 　%CALLNAME:TARGET%の欲望レベルが{C}になりました
		PRINTFORML 　
	ENDIF
	PRINTFORMW 「こんな処ですかね」
	CFLAG:2 -= 200
;売る
ELSEIF RESULT == 2
	PRINTFORMW 「まぁ、それも良いでしょう」
	D += 200000
	PRINTFORMW  [さとりの書]を売って${D}手に入れました
	MONEY += D
	CFLAG:2 -= 500
ENDIF

;-------------------------------------------------
;地の文カットテンプレ
;-------------------------------------------------
;ちくっと拝借
;-------------------------------------------------
;X1をパートナーのキャラ番号に、Y1を主人公のキャラ番号(特定主人公時の口上の場合のみ)置換
;番号が一桁の場合の頭の0はどちらでも良いようですが、口上テンプレに合わせるなら無しです
;
;各イベント毎に、「カットする」「カットしない」の次の行のコメントアウトを解除
;両方解除した場合、カットしません
;また、両方解除しない場合、直前のイベントでの設定が引き継がれます
;このテンプレでは時系列順に並べてあるので、上にある設定が引き継がれるという事になります
;ただし、上下は繋がっているので、食後の運動の設定をしないと朝イベントの設定を引き継ぎます
;------------------
@EVENTEND
IF TARGET > -1
	SIF NO:TARGET != 81
		RETURN 0
	;調教後イベントの地の文をカットする
	CFLAG:99 = 1
ENDIF

@EVENTTURNEND
IF TARGET > -1
	SIF NO:TARGET != 81
		RETURN 0
	;朝イベントの地の文をカットする
	CFLAG:99 = 1
ENDIF

