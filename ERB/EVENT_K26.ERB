;-------------------------------------------------
;パートナーと過ごす（2回目以降、26をキャラ番号に変更する） CFLAG:151 
;-------------------------------------------------
@K26_KOJO2

;反発感情Lv2以上
IF MARK:3 >= 2 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「む、お前か」
	PRINTFORMW 「先日のアレはいただけないぞ、もう少し女性には優しくするのが…」
	RETURN 1

;結婚記念日
ELSEIF DAY:2 == TIME:10 && DAY:1 == TIME:9
	;昼
	IF TIME == 0
		PRINTFORMW 今日は結婚記念日だ。この日の事を忘れる筈が無い。
		PRINTFORMW 「ああ、そうか、もうそんな日なのか……何だかついこの前のように感じるな」
		PRINTFORMW それは同感。月日の流れは早いものだ。
		PRINTFORMW 「ふむ、ではどこかに出かけてみないか？　たまにはそういうのも良いだろう」
		PRINTFORMW うん、昔の思い出に浸るのも悪くないかもしれない………。
	;夜
	ELSE
		PRINTFORMW 「ふむ、%CALLNAME:MASTER%　今日は何の日か知っているか？」
		PRINTFORMW 勿論だ。今日は二人の結婚記念日である。
		PRINTFORMW 「ふふふ、やはり覚えていてくれたか。嬉しいぞ」
		PRINTFORMW 「さて、ケーキの代わりに、羊羹でも食べるか？」
		PRINTFORMW そうして、二人でとても美味しい羊羹を食べた。
	ENDIF

;十五夜 月関連のイベントは必須かな？と思いまして（何
ELSEIF TIME:1 == 35
	PRINTFORMW 「ふむ、月が綺麗だな………」
	PRINTFORMW 「時に……私はハクタク化しているけれど……恐ろしくないか？」
	PRINTFORMW 今日は十五夜、満月が綺麗な日。つまり慧音もハクタク化している。
	PRINTFORMW だが、別に問題は無い。そんな事を気にしていたら慧音とは一緒にいれないし、
	PRINTFORMW 何より満月がとても美しいからそんな事は全く気にならなかった。

;進展無し（デート経験0）
ELSEIF EXP:94 == 0 && FLAG:7 == 2
	DRAWLINE
	;ランダムで口上が変化する
	A = RAND:3
	IF A == 0
		PRINTFORML 「今日の食事はお前の当番だ。」
		PRINTFORMW 「いつも作っている？気のせいだろう。」
	ELSEIF A == 1
		PRINTFORML 「あ！そ、それは洗わなくて良い！！！」
		PRINTFORMW 慌てて走ってきた慧音に洗濯籠をひったくられた。
	ELSE
		PRINTFORMW 「ほら、そこにもごみが落ちている。」
	ENDIF
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	A = RAND:3
	IF A == 0
		PRINTFORML 「いつも和食ばかりで悪いな。」
		PRINTFORMW 「洋食が上手いのは悪魔のメイドか、騒霊の長女…今度聞きに行ってみるよ」
	ELSEIF A == 1
		PRINTFORML 「この染みは落ちそうに無いな」
		PRINTFORMW 「無かった事にする？無理に隠しても…って、私の力を何だと思っているんだ。」
	ELSE
		PRINTFORMW 「うん、今日はまぁまぁ綺麗にしている様だな。」
	ENDIF
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	A = RAND:3
	IF A == 0
		PRINTFORML 「中華料理？あの門番なら詳しそうだな…」
		PRINTFORMW 「うん、今度会うときにでも聞いてみるよ、楽しみにしててくれ。」
	ELSEIF A == 1
		PRINTFORML 「こんなに汚して…」
		PRINTFORMW 「子供達だってもう少し気を使うぞ。…全く仕方ない奴だな。」
	ELSE
		PRINTFORML 散らかった部屋を片付けていると、慧音が%CALLNAME:MASTER%の部屋を尋ねてきた
		PRINTFORMW 「うん？掃除とは感心だな、私も手伝うよ。」
	ENDIF
	RETURN 1

;恋慕かつ恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 1 && FLAG:7 == 2
	DRAWLINE
	A = RAND:3
	IF A == 0
		PRINTFORML 「ふふ、そんなに慌てなくてもご飯は逃げないよ。」
		PRINTFORMW 「頬にご飯粒が付いているぞ。ほら、取ってやるから動くな…」
	ELSEIF A == 1
		IF CFLAG:151 == 0
			PRINTFORML 慧音の部屋に入ると色とりどりの下着が干してあった。
			PRINTFORML 「え…きゃっ！！ば、馬鹿っ！見るなっ！！」
			PRINTFORML 慧音は慌てて片付け始めたが、量が多くてなかなか終わりそうに無い。
			PRINTFORML 「早く、出ていけっ！！見るんじゃないっ！！」
			PRINTFORMW 真っ赤になりながら涙目で訴える慧音の迫力に圧され、部屋を出た%CALLNAME:MASTER%の背後で派手に転ぶ音がした。
			CFLAG:151 = 1
		ELSE
			PRINTFORML 「む、よく来たな…今日はそっちの部屋に行って良いか…？」
			PRINTFORML 部屋に入ったときに慧音が後ろ手に何かを隠したのが見えたが、気付かない振りをして自室に戻った。
			PRINTFORMW 「……ふう、どうしてあんなに間が悪いんだ。」
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:MASTER%が自室に戻ると慧音が洗濯物を持ち込んでいた。
		PRINTFORML 「乾いたから畳んでおいたぞ…と、それも汚れているな。こっちのと着替えろ」
		PRINTFORMW 慧音は%CALLNAME:MASTER%から服を無理やり脱がせ、にこにこしながら裏手の洗濯場に持って行った。
	ENDIF
	RETURN 1
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（26をキャラ番号に置換）
;パートナーと一旦別れる
