	;二回目以降
;	ELSEIF CFLAG:202 == 1 && FLAG:7 ==2
		;恋慕
;		IF TALENT:TARGET:85 == 1
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			RETURN 1
;	ENDIF

;ELSEIF NO:ASSI == Y1
;	DRAWLINE
	;初めて
;	IF CFLAG:203 == 0
		;恋慕＋恋慕時初口上（陥落イベント）が発生済み
;		IF TALENT:TARGET:85 == 1 && CFLAG:201 >= 5
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			CFLAG:203 = 1
;			RETURN 1
	;二回目以降
;	ELSEIF CFLAG:203 == 1 && FLAG:7 ==2
		;恋慕
;		IF TALENT:TARGET:85 == 1
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			RETURN 1
;	ENDIF
