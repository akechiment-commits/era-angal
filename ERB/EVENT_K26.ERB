;--------------------------------------------------
;口上ファイルの存在判定（26をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:126 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:126 = 0

;--------------------------------------------------
;EVENTTRAIN関係（26をキャラ番号に置換）
;調教開始時のセリフ CFLAG 201～219を使用
