IF MARK:3 >= 2
	DRAWLINE
	PRINTFORMW 「全く、次来るまでに自分のした事を良く考えて来い…」
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「行くのか？わかったよ。私もやることがあるしな…」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	A = RAND:2
	IF A == 0
		PRINTFORML 部屋を出ようとする慧音を呼び止め、頬に口付けしてやった。
		PRINTFORMW 「ん…また来るからな」
	ELSE
		PRINTFORML 「…ちょっとこっち向いて…」
		PRINTFORML 呼び止められて振り向くと、慧音が背伸びして頬に口付けしてきた。
		PRINTFORMW 「…また来るからな」
		RETURN 1
	ENDIF
;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0
	DRAWLINE
	A = RAND:2
	IF A == 0
		PRINTFORMW 「ん、また来てくれよ。いつも待ってるんだからな」
	ELSE
		PRINTFORML 「他の娘に手を出さないようにするおまじないだ…」
		PRINTFORMW 慧音は%CALLNAME:MASTER%の顔を両手で押さえ、そのまま唇に吸いついた。
	ENDIF
	RETURN 1

;恋慕＋体力500未満
ELSEIF TALENT:TARGET:85 == 1 && BASE:0 < 500
	DRAWLINE
	PRINTFORML 「もう…ダメだ…ぅぅ」
	PRINTFORMW 「次はもう少し優しくしてくれよ…？」
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1
	DRAWLINE
	A = RAND:2
	IF A == 0
		IF TIME == 0
			PRINTFORML 「もう行くのか……？」
			PRINTFORMW 「暫くここに居ても良いんだぞ…」
		ELSE
			PRINTFORML 「もう行くのか……？」
			PRINTFORMW 「このまま寝てしまっても良いんだぞ…」
		ENDIF
	ELSE
		PRINTFORML 「ん、もう良いよ…」
		PRINTFORMW 最後に強く抱きしめてやると満足したのか、そっと%CALLNAME:MASTER%から身体を離した
	ENDIF
	RETURN 1
ENDIF
RETURN 0
