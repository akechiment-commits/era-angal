	; 精液経験
	EXP:CHARA_ID:20 += TIER * 2
	; 絶頂経験
	EXP:CHARA_ID:2 += TIER
	; 非処女ならV経験
	SIF TALENT:CHARA_ID:0 == 0
		EXP:CHARA_ID:0 += TIER
	; 珠加算
	JUEL:CHARA_ID:1 += TIER * 150	; 快Vの珠
	JUEL:CHARA_ID:4 += TIER * 100	; 恭順の珠
	JUEL:CHARA_ID:5 += TIER * 200	; 欲情の珠
	JUEL:CHARA_ID:17 += TIER * 100	; 恥情の珠
