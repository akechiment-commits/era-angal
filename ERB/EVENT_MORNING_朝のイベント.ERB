			IF TALENT:83
				PRINTFORML %CALLNAME:TARGET%の唇がうなじから耳の裏まで丁寧に舐め上げ、止まる気配がない
			ELSEIF TALENT:76
				PRINTFORML 首筋から鎖骨へと唇を這わせ、%CALLNAME:TARGET%の息が次第に乱れてきている
			ELSEIF TALENT:89 || TALENT:153
				PRINTFORML %CALLNAME:TARGET%が首元に顔を埋め、ゆっくりと唇を押しつけている
			ELSE
				PRINTFORML %CALLNAME:TARGET%が首筋に顔を近づけ、そっと唇を寄せていた
			ENDIF
		ENDIF
		;イベント時の口上呼び出し
		LOCAL = A
		CALL SELF_KOJO
		A = LOCAL

		IF (CFLAG:99 & 1) == 0
			IF TALENT:83
				PRINTFORML 肌に赤い痕を残してから、%CALLNAME:TARGET%はようやく唇を離した
			ELSEIF TALENT:76
				PRINTFORML %CALLNAME:TARGET%は名残惜しそうにしながらも、ゆっくりと顔を引いた
			ELSE
				PRINTFORML %CALLNAME:TARGET%はそっと唇を離し、%CALLNAME:MASTER%の顔を覗き込んだ
			ENDIF
		ENDIF
		EXP:23 += A
		EXP:96 += A
		EXP:40 += A
		EXP:MASTER:96 += A
		PRINTFORML %EXPNAME:23%＋{A}
		PRINTFORML %EXPNAME:96%＋{A}
		PRINTFORML %EXPNAME:40%＋{A}
		PRINTFORML %PALAMNAME:15%の珠＋{A*100}
		PRINTFORMW %PALAMNAME:4%の珠＋{A*50}
		JUEL:15 += A*100
		JUEL:4 += A*50
		CFLAG:2 += A
		PRINTFORML 好感度上昇:{A}
		SIF ((FLAG:23 & 1p26) == 0) && FLAG:2 != 1
			PRINTFORMW 好感度合計:{CFLAG:2}
		;カットフラグを戻す
		CFLAG:99 = LOCAL:100
		RETURN 1
	ELSE
		RETURN 0
	ENDIF
ELSE
	RETURN 0
ENDIF


