			A = 1
		ELSEIF ABL:1+ABL:6 < 12	; 【[欲望] / [奉仕精神]Lv<12】
			A = 2
		ELSEIF ABL:1+ABL:6 < 18	; 【[欲望] / [奉仕精神]Lv<18】
			A = 3
		ELSEIF ABL:1+ABL:6 < 24	; 【[欲望] / [奉仕精神]Lv<24】
			A = 4
		ELSEIF ABL:1+ABL:6 >= 24	; 【[欲望] / [奉仕精神]Lv>=24】
			A = 3 + (MIN(ABL:1, 10) / 6) + (MIN(ABL:6, 10) / 6) + SQRT(MAX(ABL:1 - 10, 0)) + SQRT(MAX(ABL:6 - 10, 0))
		ENDIF
		
		;男嫌い
		SIF TALENT:82 && TALENT:MASTER:122	; 【[男嫌い] / MASTER:[オトコ]】
			A -= 1
		;両刀
		SIF TALENT:81 && TALENT:MASTER:122 == 0	; 【[両刀] / MASTER:[オトコ]なし】
			A += 1
		;献身的
		SIF TALENT:63	; 【[献身的]】
			A += 1
		;快感に素直
		SIF TALENT:70	; 【[快感に素直]】
			A += 1
		;親愛
		SIF TALENT:88	; 【[親愛]】
			A += 1
		;相愛
		SIF TALENT:89	; 【[相愛]】
			A += 1
		;淫乱
		SIF TALENT:85	; 【[恋慕]】
			A += 1
		;V鈍感
		SIF TALENT:103	; 【[Ｖ鈍感]】
			A -= 1
		;V敏感
		SIF TALENT:104	; 【[Ｖ敏感]】
			A += 1
		;淫壷
		SIF TALENT:74	; 【[淫壷]】
			A += 1
		;反発感情があるとダメ
		SIF MARK:3 > 0	; 【[反発感情]Lv>0】
			RETURN 0
		
				;ソフトキャップ補正（朝の行為回数ストッパー）
		IF TALENT:76 || TALENT:85	; 【淫乱】または【恋慕】
			IF A > 8
				A = 8 + SQRT((A - 8) * 2)
			ENDIF
			SIF A > 12
				A = 12
