;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;-------------------------------------------------
;朝に起こるイベント
;-------------------------------------------------
@EVENT_NEWDAY
;スペルの名前変更
TRYCALL SPELL_NAME_CHANGE
IF TARGET > -1
	IF TFLAG:121
		;朝イベントスキップ
	ELSEIF MARK:3 >= 3
		;騒音で起こされる
		CALL EVENT_NEWDAY_OTO
	ELSEIF TALENT:85 == 0 && TALENT:76 == 0
		;朝イベントは起きない
	ELSE
		;朝に起こるイベントが発生するかチェック
		CALL EVENT_NEWDAY_CHECK
	ENDIF
ENDIF
;出産関係チェック
CALL NINSSINXTU
;主人公が臨月の場合出産まで自動進行
IF MARK:MASTER:90
	FOR LOCAL, 0, 3
		CALL EVENT_NEXTDAY
		CALL EVENT_DANGERDAY
		DAY = DAY+1
		DAY:7 = DAY:7+1
		PRINTFORMW 
		PRINTFORMW ―――{LOCAL+1}日経過―――
		PRINTFORMW …………
		PRINTFORMW ………
		PRINTFORMW ……
		CALL NINSSINXTU
	NEXT
ENDIF
CALL CHILD_ALLOWANCE_CHECK
RETURN 0


;-------------------------------------------------
; 子ども手当（毎月＝ゲーム内10日ごとに1回支給）
;   FLAG:121 = 最終支給月(DAY:7/10)
;   全キャラの累計出産数(EXP:61)に応じて資金＋キミサキダイヤ少量
;   ※金額はLOCAL:2/LOCAL:3の係数で調整可
;-------------------------------------------------
@CHILD_ALLOWANCE_CHECK
LOCAL:0 = DAY:7 / 10
SIF FLAG:121 == LOCAL:0
	RETURN 0
FLAG:121 = LOCAL:0
;累計出産数を集計
LOCAL:1 = 0
REPEAT CHARANUM
	LOCAL:1 += EXP:COUNT:61
REND
SIF LOCAL:1 <= 0
	RETURN 0
;子供がいれば子宝図鑑を解放（既存セーブ救済）
FLAG:122 = 1
;支給額（資金=人数×10000 / ダイヤ=人数×1）
LOCAL:2 = LOCAL:1 * 10000
LOCAL:3 = LOCAL:1
MONEY += LOCAL:2
FLAG:112 += LOCAL:3
DRAWLINE
PRINTFORML ★ 子ども手当 ★
PRINTFORML 学院の子ども{LOCAL:1}人ぶんの手当が支給されました
PRINTFORML 　資金 ＋{LOCAL:2}
PRINTFORML 　キミサキダイヤ ＋{LOCAL:3}
DRAWLINE
WAIT
RETURN 0
@NINSSINXTU
;出産関連
IF (FLAG:62 & 1)
	REPEAT CHARANUM
		;妊娠時
		IF TALENT:COUNT:134
			;出産3日前からは臨月突入で調教不可に
			IF (CFLAG:COUNT:110 - 3) <= DAY:7 && (MARK:COUNT:90 != 1)
				DRAWLINE
				CALL REACH_FULL_TERM
			;出産予定日なら出産
			ELSEIF CFLAG:COUNT:110 <= DAY:7
				IF CFLAG:COUNT:21 == 0
					DRAWLINE
					CALL CHILD_BIRTH
				ELSE
					TALENT:COUNT:134 = 0
					TALENT:COUNT:135 = 1
				ENDIF
			ENDIF
		;育児中
		ELSEIF TALENT:COUNT:135
			;出産20日で親離れで調教可能に
			IF (CFLAG:COUNT:110 + 20) <= DAY:7
				IF CFLAG:COUNT:21 == 0
					DRAWLINE
					CALL DEPEARENT
				ELSE
					TALENT:COUNT:135 = 0
					MARK:COUNT:90 = 0
				ENDIF
			ENDIF
		ENDIF
	REND
ENDIF

@EVENT_NEWDAY_CHECK
;ランダムに発生するかとチェックし、全部やってダメなら終了
;疑似乱数だから収束しない可能性もあるが、まあ多分大丈夫
I = 0
$LOOP_M
R = RAND:14
IF R == 0
	SIF I & 1
		GOTO LOOP_M
	CALL EVENT_NEWDAY_PI
	I |= 1
ELSEIF R == 1
	SIF I & 2
		GOTO LOOP_M
	CALL EVENT_NEWDAY_SEX
	I |= 2
ELSEIF R == 2
	SIF I & 4
		GOTO LOOP_M
	CALL EVENT_NEWDAY_YOME
	I |= 4
ELSEIF R == 3
	SIF I & 8
		GOTO LOOP_M
	CALL EVENT_NEWDAY_KISS
	I |= 8
ELSEIF R == 4
	SIF I & 16
		GOTO LOOP_M
	CALL EVENT_NEWDAY_F
	I |= 16
ELSEIF R == 5
	SIF I & 32
		GOTO LOOP_M
	CALL EVENT_NEWDAY_SOINE
	I |= 32
ELSEIF R == 6
	SIF I & 64
		GOTO LOOP_M
	CALL EVENT_NEWDAY_NEGAO
	I |= 64
ELSEIF R == 7
	SIF I & 128
		GOTO LOOP_M
	CALL EVENT_NEWDAY_FEMALE
	I |= 128
ELSEIF R == 8
	SIF I & 256
		GOTO LOOP_M
	CALL EVENT_NEWDAY_TE
	I |= 256
ELSEIF R == 9
	SIF I & 512
		GOTO LOOP_M
	CALL EVENT_NEWDAY_MIMI
	I |= 512
ELSEIF R == 10
	SIF I & 1024
		GOTO LOOP_M
	CALL EVENT_NEWDAY_NORI
	I |= 1024
ELSEIF R == 11
	SIF I & 2048
		GOTO LOOP_M
	CALL EVENT_NEWDAY_KUBISUJI
	I |= 2048
ELSEIF R == 12
	SIF I & 4096
		GOTO LOOP_M
	CALL EVENT_NEWDAY_SURI
	I |= 4096
ELSEIF R == 13
	SIF I & 8192
		GOTO LOOP_M
	CALL EVENT_NEWDAY_ASHIKOSHI
	I |= 8192
ENDIF
SIF RESULT == 0 && I < 16383
	GOTO LOOP_M
RETURN 0

@EVENT_NEWDAY_PI
;カットフラグが立っていたらリターン
SIF CFLAG:97 & 1
	RETURN 0
;パートナーがオトコならリターン
SIF TALENT:122
	RETURN 0
;反発感情があるとダメ
SIF MARK:3 > 0
	RETURN 0
;パイズリで起こされる
;欲望8以上奉仕精神8以上精液経験1以上で発生、奉仕精神と精液中毒で回数判定
IF ABL:1 >= 8 && ABL:6 >= 8 && ABL:11 >= 1 && (TALENT:MASTER:119 || TALENT:MASTER:121 || TALENT:MASTER:122) && TALENT:TARGET:85
	IF ABL:6+ABL:11 < 6
		A = 1
	ELSEIF ABL:6+ABL:11 < 12
		A = 2
	ELSEIF ABL:6+ABL:11 < 18
		A = 3
	ELSEIF ABL:6+ABL:11 < 24
		A = 4
	ELSEIF ABL:6+ABL:11 >= 24
		A = 2 + (ABL:6 / 6) + (ABL:11 / 4)
	ENDIF
	
	;男嫌い
	SIF TALENT:82 && TALENT:MASTER:122
		A -= 1
	;両刀
	SIF TALENT:81 && TALENT:MASTER:122 == 0
		A += 1
	;汚臭鈍感
	SIF TALENT:61
		A += 1
	;汚臭敏感
	SIF TALENT:62
		A -= 1
	;献身的
	SIF TALENT:63
		A += 1
	;親愛
	SIF TALENT:88
		A += 1
	;相愛
	SIF TALENT:89
		A += 1
	;淫乱
	SIF TALENT:85
		A += 1
	;B鈍感
	SIF TALENT:107
		A -= 1
	;B敏感
	SIF TALENT:108
		A += 1
	;淫乳
	SIF TALENT:78
		A += 1
	
	A:1 = A
	SIF A >= 64
		A = 64
	
	IF A > 0
		DRAWLINE
		DRAWLINE
		;カットフラグを退避
		LOCAL:100 = CFLAG:99
		;口上開始前の地の文をカットするか
		TFLAG:13 = 8
		CALL SELF_MAEKOJO
		;地の文章カット
		IF (CFLAG:99 & 1) == 0
			PRINTFORML 朝、%CALLNAME:MASTER%が目覚めると下腹部に違和感があるのに気づいた
			;貧乳の場合
			IF TALENT:109
				PRINTFORML 気づかれないように目をやると、%CALLNAME:TARGET%が胸でペニスを弄っていた
				PRINTFORML どうやらパイズリの練習をしているらしい……
			;超乳の場合
			ELSEIF TALENT:143
				PRINTFORML 目をやると%CALLNAME:TARGET%が常識外れの大きさの胸でペニスをすっかり埋め、激しく擦り上げている
			;巨乳の場合	
			ELSEIF TALENT:141 || TALENT:110
				PRINTFORML 目をやると%CALLNAME:TARGET%が大きな胸でペニスを挟み、擦り上げている
			;それ以外
			ELSE
				
				PRINTFORML 目をやると%CALLNAME:TARGET%が胸でペニスを擦り上げ、出てきた精液を吸っている
			ENDIF
		ENDIF
		;イベント時の口上呼び出し。CALL前にAをLOCALに退避、CALL後戻す
		LOCAL = A
		LOCAL:1 = A:1
		CALL SELF_KOJO
		A = LOCAL
		A:1 = LOCAL:1
		
		EXP:20 += A
		PRINTFORML %EXPNAME:20%＋{A}
		;主人公射精量記録（パイズリ）
		SIF TALENT:MASTER:121 || TALENT:MASTER:122
			GLOBAL:240 += A * (8 + RAND:5)
			GLOBAL:(1000 + NO:TARGET) += A * (8 + RAND:5)
			SAVEGLOBAL
		EXP:21 += A/2
		PRINTFORML %EXPNAME:21%＋{A/2}
		IF (TALENT:MASTER:122 == 0) && (TALENT:122 == 0)
			PRINTFORML %EXPNAME:40%＋{A*2}
			EXP:40 += A*2
			EXP:MASTER:40 += A*2
		ENDIF
		PRINTFORML %PALAMNAME:4%の珠＋{A:1*100}
		;巨乳の場合のボーナス,欲情が2倍
		IF TALENT:110
			PRINTFORML %PALAMNAME:5%の珠＋{A:1*60}
		ELSE
			PRINTFORML %PALAMNAME:5%の珠＋{A:1*30}
		ENDIF
		PRINTFORMW %PALAMNAME:6%の珠＋{A:1*40}
		;普乳の場合のボーナス追加、習得が少し増える
		IF TALENT:109 == 0 && TALENT:110 == 0
			PRINTFORML %PALAMNAME:7%の珠＋{A:1*60}
		ELSE
			PRINTFORML %PALAMNAME:7%の珠＋{A:1*40}
		ENDIF
		;貧乳の場合のボーナス,恥情が入る
		PRINTFORML %PALAMNAME:8%の珠＋{A:1*30}
		JUEL:4 += A:1*100
		IF TALENT:110
			JUEL:5 += A:1*60
		ELSE
			JUEL:5 += A:1*30
		ENDIF
		JUEL:6 += A*40
		IF TALENT:109 == 0 && TALENT:110 == 0
			JUEL:7 += A:1*60
		ELSE
			JUEL:7 += A:1*40
		ENDIF
		SIF TALENT:109
			JUEL:8 += A:1*30
		;カットフラグを戻す
		CFLAG:99 = LOCAL:100
		RETURN 1
	ELSE
		RETURN 0
	ENDIF
ELSE
	RETURN 0
ENDIF

