	EJAC_COUNT = 5 + RAND:4
ELSEIF TIER == 2
	EJAC_COUNT = 10 + RAND:7
ELSEIF TIER == 3
	EJAC_COUNT = 18 + RAND:11
ELSEIF TIER == 4
	EJAC_COUNT = 30 + RAND:16
ELSEIF TIER == 5
	EJAC_COUNT = 45 + RAND:21
ELSE
	; 第6段階（51～72人）：極限超越（65～90回射精）
	EJAC_COUNT = 65 + RAND:26
ENDIF

; 体力・気力は一切減らさず、耐力（BASE:MASTER:4）のみを割合消費（残耐力 1 を下限とする）
LOSE_TAIRYOKU = 0
IF BASE:MASTER:4 > 1
	LOCAL:30 = BASE:MASTER:4
	IF TIER == 1
		LOCAL:31 = 30
	ELSEIF TIER == 2
		LOCAL:31 = 45
	ELSEIF TIER == 3
		LOCAL:31 = 60
	ELSEIF TIER == 4
		LOCAL:31 = 75
	ELSEIF TIER == 5
		LOCAL:31 = 85
	ELSE
		LOCAL:31 = 95
	ENDIF
	LOCAL:32 = MAX(LOCAL:30 * (100 - LOCAL:31) / 100, 1)
	LOSE_TAIRYOKU = LOCAL:30 - LOCAL:32
	BASE:MASTER:4 = LOCAL:32
ENDIF

; 主人の射精・絶頂経験加算
EXP:MASTER:3 += EJAC_COUNT
FLAG:5040 += EJAC_COUNT

