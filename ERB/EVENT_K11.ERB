;-------------------------------------------------
;背景色フェード処理用関数@FADE_BGCOLOR_K11
;	引数0：コマ数
;	引数1：変化前の背景色
;	引数2：変化後の背景色
;	引数3：振動エフェクト
;	引数4：ウェイト
;ぱにめーしょんを参考にしました。
;-------------------------------------------------
@FADE_BGCOLOR_K11(ARG = 8, ARG:1, ARG:2, ARG:3 = 0, ARG:4 = 0)
#LOCALSIZE 2
#DIM PRIBGCOLOR, 1
#DIM BGRED,2
#DIM BGGREEN,2
#DIM BGBLUE,2
VARSET BGRED
VARSET BGGREEN
VARSET BGBLUE

;元の背景色を取得
PRIBGCOLOR = GETBGCOLOR()

SETBGCOLOR ARG:1

BGRED = GETRED(GETBGCOLOR())
IF BGRED > GETRED(ARG:2)
	BGRED:1 = MAX(1, (BGRED-GETRED(ARG:2))/ARG)
ELSEIF BGRED < GETRED(ARG:2)
	BGRED:1 = MIN(-1, (BGRED-GETRED(ARG:2))/ARG)
ENDIF
BGGREEN = GETGREEN(GETBGCOLOR())
IF BGGREEN > GETGREEN(ARG:2)
	BGGREEN:1 = MAX(1, (BGGREEN-GETGREEN(ARG:2))/ARG)
ELSEIF BGGREEN < GETGREEN(ARG:2)
	BGGREEN:1 = MIN(-1, (BGGREEN-GETGREEN(ARG:2))/ARG)
ENDIF
BGBLUE = GETBLUE(GETBGCOLOR())
IF BGBLUE > GETBLUE(ARG:2)
	BGBLUE:1 = MAX(1, (BGBLUE-GETBLUE(ARG:2))/ARG)
ELSEIF BGBLUE < GETBLUE(ARG:2)
	BGBLUE:1 = MIN(-1, (BGBLUE-GETBLUE(ARG:2))/ARG)
ENDIF

FOR LOCAL:1, 0, ARG
	BGRED = MAX(0, BGRED-BGRED:1)
	BGGREEN = MAX(0, BGGREEN-BGGREEN:1)
	BGBLUE = MAX(0, BGBLUE-BGBLUE:1)
	SETBGCOLOR BGRED, BGGREEN, BGBLUE
	REDRAW 2
	SIF ARG:3
		CALL QUAKE()
NEXT

SIF ARG:4
	TWAIT ARG:4, 0

REDRAW 0

;背景色を元に戻す
SETBGCOLOR PRIBGCOLOR

RETURN RESULT

