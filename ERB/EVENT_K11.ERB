;人里
@DATE_1_K11
;初回
IF !(CFLAG:407 & 1p0)
	SELECTCASE NO:PLAYER
	;PLAYERが咲夜
	CASE 9
		PRINTW 「やっぱり周囲の視線がきついね」
		PRINTW 『所詮は人食いの化け物ですから』
		;助手がいる AND NONPLAYERが(慧音 OR 星 OR 白蓮)
		IF ASSI > -1 && GROUPMATCH(NO:NONPLAYER(), 26, 95, 96)
			PRINTL 『……っ！ 何てことを』
			PRINTFORMDW 思わず声を上げる%CALLNAME:NONPLAYER()%。
			PRINTW 「良いよ、その通りだから」
			PRINTL 『……』
			PRINTFORMDW %CALLNAME:NONPLAYER()%は気味の悪いものを見るような目でフランドールと%CALLNAME:PLAYER%を交互に見やった。
		;それ以外
		ELSE
			PRINTW 「ごもっとも。貴女のそういうところ、凄く好きよ」
		ENDIF
	;PLAYERがレミリア
	CASE 10
		PRINTL 『あー……その、何だ。あまり気にするな』
		PRINTW 『有名税みたいなものよ。この遠巻きの……必ずしも好意的じゃない視線は』
		PRINTL 「……え。もしかして、気を遣ってくれたの？」
		PRINTDW フランドールは目を丸くする。
		PRINTW 『……察しなさい。苦手なのよ、こういうの』
		PRINTW 「でも、人里で吸血鬼の評判が悪いのはもっぱらお姉様のせいだと思うけど」
		;PRINTW 「だって、吸血鬼異変にも紅霧異変にも、私は関与していないもの」
		PRINTW 『……やっぱり言わなきゃよかった』
		PRINTL 「冗談よ。ありがとう、凄く嬉しい」
		PRINTDW ぎゅっとレミリアの手を握るフランドール。
		PRINTL 『……ああ、うん』
		PRINTDW レミリアは気恥ずかしげに目を逸らした。
	;PLAYERが慧音
	CASE 26
		PRINTW 『なぁ、フランドール。人間は嫌いか？』
		PRINTW 「そんなことはないよ。好きでもないけどね」
		PRINTW 『そうか。それは良かった』
		PRINTW 「……？」
		PRINTW 『妖怪の中には人間に偏見を持つ者も多くてな。お前にはそうなって欲しくないんだ』
		PRINTW 「……努力はするよ」
		CALL READ_MIND_K11("（どっちみち、それほど仲良くはなれないだろうけど）", "W")
	;PLAYERが白蓮
	CASE 96
		PRINTL 『あんなふうに』
		PRINTDW 道を行く人間と妖怪の夫婦を指し示し、白蓮は口を開く。
		PRINTW 『人と妖怪はわかりあえると、私は信じています』
		PRINTW 「……ええ。それはそう、でしょうね」
		PRINTW 『……何か？』
		PRINTW 「いえ。何でもないわ」
		CALL READ_MIND_K11("（仮にわかりあえたとしても、仲良くなれるとは限らない）", "L")
		CALL READ_MIND_K11("（……でも、そんなことを今ここでこの人に言っても仕方ないよね）", "W")
	;それ以外
	CASEELSE
		PRINTL 「……意外に活気があるのね」
		PRINTDW フランドールは物珍しそうに辺りを見回した。
	ENDSELECT
;二回目以降
ELSE
	SELECTCASE TIME:1
	;元日
	CASE 11
		PRINTDW 梅の枝にかかった切れ凧の糸が、ときおり吹く風に揺られている。
	;こどもの日
	CASE 14
		PRINTDW 人家の庭前にこいのぼりが立てられている。
	;母の日
	CASE 16
		PRINTL 「……随分とカーネーションが多いわね」
		PRINTDW 花屋を覗き込んで、フランドールが不思議そうに呟いた。
	;それ以外
	CASEELSE
		;失敗
		IF TFLAG:18 == -1
			PRINTW 「……人の多い場所は苦手なんだけど」
		;それ以外
		ELSE
			SELECTCASE RAND_FILTERED_K11((DAY:1 <= 10 && DAY:2 == 0 && TIME:5 < 2), 0, (DAY:2 == 1 && !TIME && TIME:5 < 2), 1, (DAY:2 == 2 && TIME:5 < 2), 2, (DAY:2 == 3 && TIME:5 < 2), 3, TRUE(1), 4)
			;初春 AND (晴れ OR 快晴)
			CASE 0
				;夜
				IF TIME
					PRINTDW 道の辺に仄白く淡雪が消え残っている。
				;昼
				ELSE
					PRINTDW どこかでウグイスが鳴いた。
				ENDIF
			;夏 AND 昼 AND (晴れ OR 快晴)
			CASE 1
				;初夏
				IF DAY:1 <= 10
					SELECTCASE RAND:3
					CASE 0
						PRINTDW 井戸のはね釣瓶が高く初夏の空を指さしている。
					CASE 1
						PRINTDW 葡萄棚の下に日光を透かす青い影が落ちている。
					CASE 2
						PRINTDW 何組かの親子がザリガニ釣りに興じている。
					ENDSELECT
				;それ以外
				ELSE
					SELECTCASE RAND:2
					CASE 0
						PRINTDW 向日葵の花が垣根に咲き出ている。
					CASE 1
						PRINTDW 土蔵の壁に火の見櫓の影が落ちている。
					ENDSELECT
				ENDIF
			;秋 AND (晴れ OR 快晴)
			CASE 2
				;夜
				IF TIME
					PRINTDW 庭先に植えられた金木犀の香が風に乗って漂った。
				;昼
				ELSE
					SELECTCASE RAND:2
					CASE 0
						PRINTDW 人家の庭に植えられた秋海棠の花が波打つように揺れた。
					CASEELSE
						PRINTDW しなやかに撓んだ小枝の上でツグミが鳴いている。
					ENDSELECT
				ENDIF
			;冬 AND (晴れ OR 快晴)
			CASE 3
				;晩冬
				IF DAY:1 > 20
					PRINTDW 里の人々が慌ただしく行き来している。
				;それ以外
				ELSE
					PRINTDW 霜柱を踏んで歩くと、サクサクと音がした。
				ENDIF
			;条件なし
			CASE 4
				;夜
				IF TIME
					SELECTCASE RAND:3
					CASE 0
						PRINTL 「……もう、日が暮れるわね」
						PRINTDW フランドールは縹色に染まる遠方を見やった。
					CASE 1
						PRINTDW 石燈の灯袋に仄かな陽炎が揺れている。
					CASEELSE
						PRINTL 『戸締まり用心、火の用心』
						;晩秋
						IF DAY:2 == 2 && DAY:1 > 20
							PRINTDW 冬の夜寒に撃柝の音が響く。
						;それ以外
						ELSE
							PRINTDW 拍子木を打ち鳴らしながら、警防団が見回りをしている。
						ENDIF
					ENDSELECT
				;昼
				ELSE
					PRINTL 「ねえ、あれ食べてみない？」
					PRINTDW 甘味処の看板を指差してフランドールが言った。
				ENDIF
			ENDSELECT
		ENDIF
	ENDSELECT
ENDIF

