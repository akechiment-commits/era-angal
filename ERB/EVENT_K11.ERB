B = 0

;ABL:技巧をみる
IF ABL:2 <= 1
	B = 200 + ABL:2 * 100
ELSEIF ABL:2 <= 3
	B = 300 + ABL:2 * 100
ELSEIF ABL:2 <= 5
	B = 300 + ABL:2 * 150
ELSEIF ABL:2 <= 8
	B = 500 + ABL:2 * 150
ELSEIF ABL:2 <= 11
	B = 200 + ABL:2 * 200
ELSE
	B = 500 + ABL:2 * 200
ENDIF

;ABL:従順をみる
IF ABL:0 <= 1
	TIMES B , 0.80
ELSEIF ABL:0 <= 3
	TIMES B , 0.90
ELSEIF ABL:0 <= 5
	TIMES B , 1.00
ELSEIF ABL:0 <= 8
	TIMES B , 1.10
ELSEIF ABL:0 <= 11
	TIMES B , 1.20
ELSE
	B = B * (ABL:0 * 2 + 105) / 100
ENDIF

;ABL:奉仕精神をみる
IF ABL:6 <= 1
	TIMES B , 0.50
ELSEIF ABL:6 <= 3
	TIMES B , 0.80
ELSEIF ABL:6 <= 5
	TIMES B , 1.20
ELSEIF ABL:6 <= 8
	TIMES B , 1.50
ELSEIF ABL:6 <= 11
	TIMES B , 1.80
ELSE
	B = B * (ABL:6 * 10 + 90) / 100
ENDIF

;プレイヤーのABL:Ｃ感覚をみる
IF ABL:PLAYER:3 == 0
	TIMES B , 1.00
ELSEIF ABL:PLAYER:3 == 1
	TIMES B , 1.50
ELSEIF ABL:PLAYER:3 == 2
	TIMES B , 2.00
ELSEIF ABL:PLAYER:3 == 3
	TIMES B , 2.50
ELSEIF ABL:PLAYER:3 == 4
	TIMES B , 3.50
ELSE
	B = B * ABL:PLAYER:3
ENDIF

SIF TALENT:PLAYER:119 || TALENT:PLAYER:122  || TALENT:PLAYER:121
	BASE:PLAYER:2 += B

;-------------------------------------------------
;射精チェック
;-------------------------------------------------
CALL SAMEN_CHECK

;射精している
IF E >= 1
	TIMES SOURCE:4 , 3.00
	
	;ABL:精液中毒をみる
	IF ABL:11 == 0
		SOURCE:7 = 0
		TIMES SOURCE:5 , 2.00
		TIMES SOURCE:13, 2.00
	ELSEIF ABL:11 == 1
		SOURCE:7 = 200
		TIMES SOURCE:5 , 2.50
		TIMES SOURCE:13, 1.60
	ELSEIF ABL:11 == 2
		SOURCE:7 = 600
		TIMES SOURCE:5 , 3.00
		TIMES SOURCE:13, 1.00
	ELSEIF ABL:11 == 3
		SOURCE:7 = 1500
		TIMES SOURCE:5 , 4.00
		TIMES SOURCE:13, 0.70
	ELSEIF ABL:11 == 4
		SOURCE:7 = 3000
		TIMES SOURCE:5 , 5.00
		TIMES SOURCE:13, 0.40
	ELSE
		SOURCE:7 = (ABL:11 * 1500) - 1000
		SOURCE:5 = SOURCE:5 * (ABL:11 * 50 + 350) / 100
		TIMES SOURCE:13, 0.10
	ENDIF
	
	;射精先タイプの設定
	TFLAG:703 = 0
	;射精先選択の可・不可
	TFLAG:704 = 0
	;汎用的な処理はこの関数で行う
	;（射精ゲージの再計算や射精経験の上昇と共通部分の表示）
	CALL SAMEN_SHOOT
ENDIF

;奴隷の指⇔調教者のＰの汚れが移動
IF TALENT:PLAYER:119 || TALENT:PLAYER:122  || TALENT:PLAYER:121
	STAIN:1 |= STAIN:PLAYER:2
	STAIN:PLAYER:2 |= STAIN:1
;奴隷の指⇔調教者のＶの汚れが移動
ELSE
	STAIN:3 |= STAIN:PLAYER:2
	STAIN:PLAYER:2 |= STAIN:3
ENDIF

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTS EXPNAME:40
	PRINTL +4
	EXP:40 += 4
	EXP:PLAYER:40 += 4
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1
	PRINTS EXPNAME:41
	PRINTL +4
	EXP:41 += 4
	EXP:PLAYER:41 += 4
ENDIF

TFLAG:100 = 1

;既成事実2に相当
TFLAG:200 = 2

;調教者がふたなり
SIF TALENT:PLAYER:121
	SOURCE:13 /= 2

