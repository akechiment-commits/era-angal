;-------------------------------------------------
;@DIFFCOLOR_K11
;-------------------------------------------------
@DIFFCOLOR_K11(ARG:0, ARG:1, ARG:2, ARG:3, ARG:4, ARG:5)
;引数0:コマ数
;引数1:最初の文字色
;引数2:最後の文字色
;引数3:PREVRED
;引数4:PREVGREEN
;引数5:PREVBLUE
IF !INRANGE(ARG:3, 0, 255) || !INRANGE(ARG:4, 0, 255) || !INRANGE(ARG:5, 0, 255)
	ARG:3 = GETRED(ARG:1)
	ARG:4 = GETGREEN(ARG:1)
	ARG:5 = GETBLUE(ARG:1)
ENDIF
RESULT:0 = ARG:3 - DIFFRED_K11(ARG:0, ARG:1, ARG:2)
RESULT:1 = ARG:4 - DIFFGREEN_K11(ARG:0, ARG:1, ARG:2)
RESULT:2 = ARG:5 - DIFFBLUE_K11(ARG:0, ARG:1, ARG:2)
SETCOLOR MAX(0, RESULT:0), MAX(0, RESULT:1), MAX(0, RESULT:2)
RETURN RESULT:0, RESULT:1, RESULT:2

@DIFFRED_K11(ARG:0, ARG:1, ARG:2)
#FUNCTION
#DIM RED, 2
RED = GETRED(ARG:1)
IF RED > GETRED(ARG:2)
	RED:1 = MAX(1, (RED-GETRED(ARG:2))/ARG)
ELSEIF RED < GETRED(ARG:2)
	RED:1 = MIN(-1, (RED-GETRED(ARG:2))/ARG)
ENDIF
RETURNF RED:1

@DIFFGREEN_K11(ARG:0, ARG:1, ARG:2)
#FUNCTION
#DIM GREEN, 2
GREEN = GETGREEN(ARG:1)
IF GREEN > GETGREEN(ARG:2)
	GREEN:1 = MAX(1, (GREEN-GETGREEN(ARG:2))/ARG)
ELSEIF GREEN < GETGREEN(ARG:2)
	GREEN:1 = MIN(-1, (GREEN-GETGREEN(ARG:2))/ARG)
ENDIF
RETURNF GREEN:1

@DIFFBLUE_K11(ARG:0, ARG:1, ARG:2)
#FUNCTION
#DIM BLUE, 2
BLUE = GETBLUE(ARG:1)
IF BLUE > GETBLUE(ARG:2)
	BLUE:1 = MAX(1, (BLUE-GETBLUE(ARG:2))/ARG)
ELSEIF BLUE < GETBLUE(ARG:2)
	BLUE:1 = MIN(-1, (BLUE-GETBLUE(ARG:2))/ARG)
ENDIF
RETURNF BLUE:1

