;--------------------------------------------------
;体型比較関数@BODYSIZE
;	引数0;比較対象1の登録番号
;	引数1;比較対象2の登録番号
;--------------------------------------------------
@BODYSIZE_K11(ARG:0, ARG:1)
#FUNCTION
SIF ARG:0 < 0 || ARG:1 < 0
	RETURNF 0
IF 0
ELSEIF TALENTCHECK(ARG:0, "小人体型")
	IF 0
	ELSEIF TALENTCHECK(ARG:1, "小人体型")
		RETURNF 3
	ELSE
		RETURNF 1
	ENDIF
ELSEIF TALENTCHECK(ARG:0, "小柄体型")
	IF 0
	ELSEIF TALENTCHECK(ARG:1, "小人体型")
		RETURNF 2
	ELSEIF TALENTCHECK(ARG:1, "小柄体型")
		RETURNF 3
	ELSE
		RETURNF 1
	ENDIF
ELSE
	IF 0
	ELSEIF TALENTCHECK(ARG:1, "小人体型") || TALENTCHECK(ARG:1, "小柄体型")
		RETURNF 2
	ELSE
		RETURNF 3
	ENDIF
ENDIF

;-------------------------------------------------
;@HOMOSEX
;ARG:0とARG:1で子供を作れるかどうかを判定する。
;作れるなら0、作れないなら1（オトコ）か2（オトコでない）を返す
;-------------------------------------------------
@HOMOSEX_K11(ARG:0, ARG:1)
#FUNCTION
IF 0
;ARG:0がふたなり OR ARG:1がふたなり
ELSEIF TALENT:(ARG:0):121 || TALENT:(ARG:1):121
	RETURNF 0
;ARG:0がオトコ AND ARG:1がオトコ
ELSEIF TALENT:(ARG:0):122 && TALENT:(ARG:1):122
	RETURNF 1
;ARG:0がオトコでない AND ARG:1がオトコでない
ELSEIF !TALENT:(ARG:0):122 && !TALENT:(ARG:1):122
	RETURNF 2
;それ以外
ELSE
	RETURNF 0
ENDIF

;--------------------------------------------------
;月の名前
;	ARG;日付
;--------------------------------------------------
@MOONNAME_K11(ARG)
#FUNCTIONS
SELECTCASE ARG
CASE 1
	RETURNF "新月"
CASE 2
	RETURNF "二日月"
CASE 3
	RETURNF "三日月"
CASE 7
	RETURNF "上弦の月"
CASE 14
	RETURNF "小望月"
CASE 15
	SELECTCASE RAND:2
	CASE 0
		RETURNF "満月"
	CASEELSE
		RETURNF "望月"
	ENDSELECT
CASE 16
	RETURNF "十六夜"
CASE 17
	RETURNF "立待月"
CASE 18
	RETURNF "居待月"
CASE 19
	SELECTCASE RAND:2
	CASE 0
		RETURNF "寝待月"
	CASEELSE
		RETURNF "臥待月"
	ENDSELECT
CASE 23
	RETURNF "下弦の月"
CASE 26
	RETURNF "有明の月"
CASE 30
	RETURNF "三十日月"
CASEELSE
	RETURNF "月"
ENDSELECT

