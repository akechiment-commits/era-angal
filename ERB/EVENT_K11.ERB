;-------------------------------------------------
;@KEYTYPING_K11
;変換前の文字列を1文字ずつ順に表示した後でそれを消して変換後の文字列を表示する。奇数は変換前、偶数は変換後。"/"で区切る。
;使用例：CALL KEYTYPING_K11("あくま/悪魔", "W", 2)；あ → あく → あくま → 悪魔
;ARGS：元の文字列
;ARGS:1：入力待ちの有無
;ARG：表示速度
;-------------------------------------------------
@KEYTYPING_K11(ARGS, ARGS:1, ARG)
#DIM LCOUNT, 2

VARSET LOCALS

;"/"で区切る
SPLIT ARGS, "/", LOCALS, LOCAL

;文字列を表示
FOR LCOUNT, 0, LOCAL, 2
	FOR LCOUNT:1, 0, STRLENS(LOCALS:LCOUNT), 1
		SIF LCOUNT
			PRINTFORM %LOCALS%
		PRINTFORML %SUBSTRING(LOCALS:LCOUNT, 0, LCOUNT:1)%
		TWAIT ARG, 1
		CLEARLINE 1
	NEXT
	SIF LOCALS:(LCOUNT + 1) == ""
		LOCALS:(LCOUNT + 1) = %LOCALS:LCOUNT%
	IF !LCOUNT
		LOCALS = %LOCALS:(LCOUNT + 1)%
	ELSE
		LOCALS = %LOCALS%%LOCALS:(LCOUNT + 1)%
	ENDIF
NEXT

;入力待ち
PRINTFORM %LOCALS%
SELECTCASE ARGS:1
CASE "L"
	PRINTL 
CASE "W"
	PRINTW 
ENDSELECT

RETURN RESULT

;-------------------------------------------------
;@RAND_CHARA_NAME_K11
;ランダムで選択された{ARG}人のキャラクターの呼び名を取得してTSTR(:0, 1, …)に代入
;ARG：人数
;-------------------------------------------------
@RAND_CHARA_NAME_K11(ARG)

#DIM CHECK, 1000

;{ARG}人の名前を取得
FOR COUNT, 0, ARG, 1
	;主人公とターゲットと助手と選択済みのキャラクターを除外
	DO
		LOCAL = RAND:CHARANUM
	LOOP GROUPMATCH(LOCAL, MASTER, TARGET, ASSI) || (CHECK:LOCAL == 1)
