;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;11をキャラ番号に置換してください。（例:霊夢→1）
;-------------------------------------------------

;--------------------------------------------------
;口上ファイルの存在判定（11をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:(100+11) = 1
SIF FLAG:7 == 0
	FLAG:7 = 2

@EVENTEND
#LATER
FLAG:(100+11) = 0

;--------------------------------------------------
;同定構文（era紅魔館レミリア口上からアイデアをお借りしました）
;--------------------------------------------------
;口上の存在を返す
@KOJO_K11(ARG)
;RESULTS = ""
RETURN 1

;口上IDを返す(IDは8桁[A-Z+0-9])
@KOJO_K11_IDENTIFY
RESULTS = 85QCIUG7
RETURN 1

;口上名称を返す
@KOJO_K11_NAME
RESULTS = eratohoJ+用フランドール（妹様）口上
RETURN 1

;--------------------------------------------------
;純愛イベント口上　 CFLAG221(11をキャラ番号に置き換え)
;--------------------------------------------------
@KOJO_JUN_K11
;フランドール以外の相手にエンゲージリングを渡した
IF !GROUPMATCH(FLAG:29, 0, 11) && GROUPMATCH(TFLAG:600, 1, 2, 3, 4, 5, 6, 7, 25, 26, 27, 37)
	SELECTCASE TFLAG:600
	;服を脱がせる
	CASE 4 TO 7
		CALL KOJO_MESSAGE_REJECTION_K11
		TFLAG:44 = 0
	;押し倒される
	CASE 27
		CALL CONFLICT
	;アクセサリプレゼント
	CASE 37
		FLAG:(6000 + NO:TARGET) -= 1
	ENDSELECT
	TFLAG:600 = 0
	RETURN 1
ENDIF

;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;-------------------------------------------------
IF TFLAG:600 == 0 && CFLAG:220 == 0 && NO:MASTER == 0
	PRINTDL 口上に合わせて素質を変更しますか？
	PRINTDL [0] はい
	PRINTDL [1] いいえ
	CALL INPUTINT(0, 1)
	SELECTCASE RESULT
	;はい
	CASE 0
		PRINTFORMDW ―素質を変更します―
		;[習得遅い]喪失
		TALENT:TARGET:51 = 0
		;[快感に素直]喪失
		TALENT:TARGET:70 = 0
		;[サド]喪失
		TALENT:TARGET:83 = 0
		;[素直]取得
		TALENT:TARGET:13 = 1
		;[習得早い]取得
		TALENT:TARGET:50 = 1
		;[小悪魔]取得
		TALENT:TARGET:87 = 1
		;素質変更
		CFLAG:686 = 1
	ENDSELECT
	CALL SET_CALLMASTER_K11
	CFLAG:220 = 1
ENDIF
