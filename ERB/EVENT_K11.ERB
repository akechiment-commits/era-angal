		CALL READ_MIND_K11("（こんなの、寺子屋のワーハクタクの仕事なのに）", "W")
		PRINTW 『えー？ でも、楽しいよ？』
		;ASSIがいる AND NONPLAYERが(レティ OR アリス OR 慧音 OR 四季映姫 OR 雛 OR 神綺 OR 豊姫 OR 依姫 OR 衣玖 OR 小兎姫 OR 星 OR 白蓮)
		IF ASSI > -1 && GROUPMATCH(NO:NONPLAYER(), 12, 14, 26, 36, 39, 52, 53, 54, 62, 67, 95, 96)
			PRINTFORMDL フランドールは%CALLNAME:NONPLAYER()%をちらりと見る。
			PRINTFORMDW %CALLNAME:NONPLAYER()%は素知らぬ顔で明後日の方向を見ている。
		ENDIF
		PRINTL 「……」
		PRINTDW 小さく溜息をついて、フランドールは再び口を開く。
		PRINTW 「同じ理由で私が貴女の友達を傷つけたら、どんな気持ちがする？」
		PRINTW 『そんなの……！ あ、そういう、こと……』
		PRINTW 「うん。わかってくれて嬉しいよ」
		CALL READ_MIND_K11("（相互性を認めない相手の説得は手間ばかりかかるから）", "L")
		CALL READ_MIND_K11("（仮に成功したとしてもそうで、", "L")
		CALL READ_MIND_K11("  大抵の場合は上手くいきさえもしないけど）", "W")
		;ASSIがいる AND NONPLAYERが(小悪魔 OR レミリア OR 幽々子 OR 紫 OR 夢月 OR 幻月)
		SIF ASSI > -1 && GROUPMATCH(NO:NONPLAYER(), 7, 10, 20, 22, 75, 76)
			PRINTFORMDW 含み笑いする%CALLNAME:NONPLAYER()%を横目で見て、フランドールは深く溜息をついた。
	;それ以外
	CASEELSE
		PRINTDL 物音に驚いて水鳥が飛び立った。
		PRINTW 「……ああ、吃驚した」
	ENDSELECT
;二回目以降
ELSE
	SELECTCASE RAND_FILTERED_K11((DAY:2 == 0 && !TIME && TIME:5 < 2), 0, (DAY:2 == 1 && !TIME && TIME:5 < 2), 1, TRUE(1), 2)
	;春 AND 昼 AND (晴れ OR 快晴)
	CASE 0
		;初春
		IF DAY:1 <= 10
			PRINTDW 浅い水に蘆の芽が鋭い角を覗かせている。
		;それ以外
		ELSE
			SELECTCASE RAND:2
			CASE 0
				PRINTDL 湖上を吹き通う春風が小波を立て、桜の花弁をそっと水面に舞わせる。
				PRINTDW 片手で軽く帽子を押さえて、フランドールは口元に微笑を浮かべた。
			CASEELSE
				PRINTDW フランドールは湖畔に佇み、水面に揺らめく陽光を見つめた。
			ENDSELECT
		ENDIF
	;夏 AND 昼 AND (晴れ OR 快晴)
	CASE 1
		SELECTCASE RAND:3
		CASE 0
			PRINTDW 銀色に光る水面に、二人の影が映った。
		CASE 1
			PRINTFORMDW 木漏れ日が湖面に\@ !RAND:2 ? まだらの影を落としている # 反射して煌めいた \@。
		CASEELSE
			PRINTL 「泳ぐのは無理だよ。傘を手放せないし」
			;レミリアが助手 ?
			PRINTFORMW 「……そう言えば、\@ ASSINO() == 10 ? あいつ # お姉様 \@が室内プールを造ってたっけ」
		ENDSELECT
	;条件なし
	CASE 2
		PRINTL 「……妖精はいないのかな？」
		;(恋慕 AND 恋人) ?
		PRINTFORMW 「まあ、\@ (TALENT:TARGET:85 && TALENT:TARGET:153) ? 邪魔 # 悪戯 \@されなくて好都合だけどね」
	ENDSELECT
ENDIF

