;霧の湖
@DATE_3_K11
;初回
IF !(CFLAG:407 & 1p2)
	SELECTCASE NO:PLAYER
	;PLAYERがチルノ
	CASE 5
		PRINTL 『あ、そうだ。こんな遊び知ってる？』
		PRINTW 『こうやってね、カエルを凍らせて……』
		PRINTW 「……やめなよ、チルノ。可哀想でしょ？」
		PRINTL 「ネズミみたいに害をなすならともかく、
		PRINTW   そのカエルは貴女に何もしてないじゃない」
