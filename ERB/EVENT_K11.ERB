;;J1.064本体のみでもパッチまとめでも封印されてるコマンドです
;-------------------------------------------------
IF SELECTCOM == 70
	;地の文（改変）
	IF TALENT:PLAYER:122 == 1
		PRINTFORMDW %CALLNAME:PLAYER%は思いつく限りの罵詈雑言をフランドールに浴びせた。
	ELSE
		PRINTFORMDW %CALLNAME:PLAYER%はフランドールを罵倒した。
	ENDIF
	PRINTL 
	;ボールギャグ装着中
	IF TEQUIP:45
		PRINTD フランドールは
		;縄で緊縛中
		IF TEQUIP:44
			PRINTDW 僅かに眉を顰めた。
		;それ以外（ボールギャグのみ）
		ELSE
			PRINTDATAW
				DATA ひょいと肩を竦めた。
				DATAFORM 不思議そうに%CALLNAME:PLAYER%の顔を覗き込んだ。
			ENDDATA
		ENDIF
	;それ以外
	ELSE
		;パートナー ?
		CFLAG:669 = TALENT:150 ? RAND:4 # RAND:3
		SELECTCASE CFLAG:669
		CASE 0
			PRINTW 「まあまあ、少し落ち着いて。不満があるなら聞いてあげるから、ね？」
		CASE 1
			PRINTW 「……どうしたの？ 小魚食べる？」
		CASE 2
			PRINTW 「そっか。そういう言い回しもあるんだ」
		CASEELSE
			PRINTW 「おや。パートナーで鬱憤晴らしとは感心しないね」
		ENDSELECT
	ENDIF
	PRINTL 
ENDIF

;-------------------------------------------------
;秘貝開帳 CFLAG:497
;アナル汚れに関しては省略。　嫁にアナル挿入した後のペニスを挿入するなんて、普通は出来っこないよね？
;ちょっとだけやりすぎた、今は反省している。
;J = 1でC自慰、J = 2でV自慰、J = 3でA自慰、J = 0で自慰しない
;K = 0で膣内に精液なし、K = 1で表示だけ、K = 2でいきんで出せ、K = 3で指でかきだせ
;-------------------------------------------------
IF SELECTCOM == 71
	;地の文（改変）
	PRINTFORMDL %CALLNAME:PLAYER%に頼まれたフランドールは、
	SELECTCASE H
	CASE 0
		;小柄体型 ?
		PRINTFORMDL しぶしぶといった様子で自分の\@ TALENT:TARGET:100 ? 幼いワレメ # 陰唇 \@に指を当て、左右に広げて見せた
	CASE 1
		PRINTDL 顔を真っ赤にしながらもおずおずと自分の陰唇を拡げて見せた
	CASE 2
		PRINTDL 下腹部に手を置き、
		PRINTFORMDL 人差し指と中指でチョキを作るようにして%CALLNAME:PLAYER%に自分の秘所を曝した
	CASE 3
		PRINTDL 慣れた様子で片手で陰唇を開いて
		PRINTDL こちらの反応を窺うように見つめてきた
	CASE IS >= 4
		PRINTDL 両手の指を使って陰唇だけでなく、膣口も同時に拡げた
	ENDSELECT
	WAIT
	PRINTL 
	;台詞
	;恋慕かつ主人のセックスによる処女喪失（反発感情未取得）
	IF (STAIN:3 & 1p5) && (CFLAG:351 & 1p1) && !(CFLAG:497 & 1p0) 
		;押し倒された ?
		PRINTFORML 「\@ CFLAG:604 == 1 ? ほら、 # …… \@見て。繋がった証」
		PRINTW 「痛かったけど……それ以上に、嬉しかった」
		CFLAG:497 |= 1p0
	;それ以外
	ELSE
		;押し倒された
		IF CFLAG:604 == 1
			SELECTCASE H
			CASE IS < 2
				PRINTW 「……」
			CASEELSE
				PRINTDATAW
					;膣内に精液がある ?
					DATAFORM 「ね\@ K > 0 ? ぇ……もっと、 # …… \@ちょうだい？」
					DATA 「んっ……どう、かな？ 興奮……する？」
				ENDDATA
			ENDSELECT
		;押し倒した
		ELSE
			SELECTCASE H
			CASE IS < 2
				PRINTW 「うう……は、恥ずかしい……」
			CASEELSE
				SELECTCASE K
				CASE 0
					PRINTDATAW
						DATA 「や……顔、近、すぎっ……」
						DATA 「んっ……息が、かかって……」
						DATA 「や……そんな、まじまじと……」
					ENDDATA
				CASEELSE
					PRINTW 「あ……や……溢れちゃう……」
				ENDSELECT
			ENDSELECT
		ENDIF
	ENDIF
	;地の文（改変）
	SELECTCASE K
	CASE 0
		;処女
		IF TALENT:TARGET:0
			;淫乱
			IF TALENT:TARGET:76
				PRINTFORMDL 陰門の入り口には純潔の証が貫かれるのを待っているかのように艶めいている
			;淫乱でない
			ELSE
				PRINTFORMDL 陰門の入り口に純潔の証が頼りなさげにひくついているのが見て取れる
			ENDIF
		;処女でない
		ELSE
			SELECTCASE H
			CASE 2, 3
				PRINTDL 広がりきった陰門からこちらを覗く膣口が
				PRINTDL まるで何かを待っているかのように妖しげに蠢いている……
			CASE IS >= 4
				PRINTDL 膣の中まで見られていることに感じているのか、
				PRINTDL フランドールの頬は仄かに紅く染まっている……
			ENDSELECT
		ENDIF
	CASE 1
		PRINTDL 先ほど膣内にたっぷりと注ぎ込んだ精液が、
		PRINTDL フランドールの呼吸のリズムに合わせて、
		PRINTDL 膣口からこぽり、こぽりと溢れ出ている……
	CASE IS >= 2
		PRINTDL じっと見ていると、
		PRINTDL 精液と愛液が混じりあって薄く濁った液体が、
		PRINTDL 膣口からとろとろと流れ出てきた……
	ENDSELECT
	WAIT
	PRINTL 
ENDIF

