;解答関数
@QUIZ_QUESTION_ANSWER_K11

;解答取得
CALL INPUTINT(0, 1, 2, 3)

;クイズ解答（Vは正解番号、Pは正解数を表す）
IF RESULT == V
	PRINTL 
	PRINTDW 正解です！
	PRINTL 
	P += 1
ELSE
	PRINTL 
	PRINTDW 不正解です！
	PRINTL 
ENDIF

RETURN 0

;クイズ
@QUIZ_K11

;正解スコアを初期化
P = 0

;問題数・出題数を取得
CALL QUIZ_QUESTION_NUMBER_K11

;問題数・出題数をセット
V = T
L:0 = S

;問題番号リスト生成
U = COUNT
REPEAT L:0
	$QUESTION_NUMBER_CHECK_LOOP_OUT
	S = RAND:V
	;重複チェック
	T = 1
	$QUESTION_NUMBER_CHECK_LOOP_IN
	;チェック範囲か？
	;最初はT == 1でCOUNT == 0だからT > COUNT
	IF T <= COUNT
		;既に存在する番号か？
		SIF L:T == S
			;問題番号Sを選び直す
			GOTO QUESTION_NUMBER_CHECK_LOOP_OUT
		;次のチェックへ進む
		T += 1
		;L:1をチェック、L:2をチェック、…
		GOTO QUESTION_NUMBER_CHECK_LOOP_IN
	ENDIF
	;問題番号代入
	;L:TにT問目の問題番号Sが入る
	T = COUNT + 1
	L:T = S
REND
COUNT = U

;出題ループ
T = 1
$QUIZ_QUESTION_LOOP
IF T <= L:0
	;UにT問目の問題番号L:Tが入る
	U = L:T
	CALL QUIZ_QUESTION_K11

	;ループ
	T += 1
	GOTO QUIZ_QUESTION_LOOP
ENDIF
	
RETURN 0

