;-------------------------------------------------
;コンドーム精飲
;CFLAG:108で誰の精液かを取得可能(1:主人、2:助手、3:パートナー)
;パートナーが飲む CFLAG:504 SELECTCOM == 182
;助手が飲む CFLAG:505 SELECTCOM == 183
;主人が飲む CFLAG:506 SELECTCOM == 184
;J1.064本体のみの場合、存在しないコマンド
;-------------------------------------------------
IF GROUPMATCH(SELECTCOM, 182, 183, 184)
	PRINTFORMD %AUTO_SPLIT(@"フランドールに/%CALLNAME:MASTER%は%CALLASSI_K11("CALLNAME")%に/%CALLNAME:MASTER%は", "/", SELECTCOM - 182)%
	PRINTFORMD %AUTO_SPLIT(@"%CALLNAME:MASTER%/%CALLASSI_K11("CALLNAME")%/フランドール", "/", CFLAG:108 - 1)%の
	PRINTFORMDW 使用済みコンドームを手%AUTO_SPLIT("渡し/渡し/に取っ", "/", SELECTCOM - 182)%た……
	SELECTCASE SELECTCOM
	;パートナーが飲む
	CASE 182
		;精液中毒
		SELECTCASE ABL:11
		;Lv0
		CASE 0
			PRINTL 「やっぱり喉に絡むわね。別に美味しくもないし」
		;それ以外
		CASEELSE
			SELECTCASE RAND:3
			CASE 0
				PRINTL 「特に栄養価が高いわけでもないのにね」
			CASE 1
				PRINTL 「私はサキュバスの類じゃないんだけど」
			CASE 2
				PRINTL 「飲尿健康法があるのなら飲精健康法もあるのかしら」
			ENDSELECT
		ENDSELECT
		;恋慕 AND 主人の精液 AND 精液中毒Lv3以上 ?
		PRINTFORMD フランドールは\@ TALENT:85 && CFLAG:108 == 1 && ABL:11 >= 3 ? 微かに頬を赤らめ、 # 淡々と \@
		;パートナーの精液 ?
		PRINTFORMDW \@ CFLAG:108 == 3 ? 自分自身 # %CALLNAME:PLAYER% \@の精液を飲み下した。
	;助手が飲む OR 主人が飲む
	CASE 183, 184
		PRINT そして、
		;助手が飲む
		SIF SELECTCOM == 183
			PRINTFORMD %CALLNAME:ASSI%は
		;(助手が飲む AND 助手がサド) OR (主人が飲む AND 主人がサド)
		IF (SELECTCOM == 183 && TALENT:ASSI:83) || (SELECTCOM == 184 && TALENT:MASTER:83)
			PRINTFORMD フランドールが舌をのばせば届きそうなぐらいの距離で、
		;それ以外
		ELSE
			PRINTFORMD フランドールに見せびらかすように
		ENDIF
		;(助手が飲む AND 助手の精液中毒Lv5以上) OR (主人が飲む AND 主人の精液中毒Lv5以上)
		IF (SELECTCOM == 183 && ABL:ASSI:11 >= 5) || (SELECTCOM == 184 && ABL:MASTER:11 >= 5)
			;助手が飲む ?
			PRINTFORMDW 恍惚の表情で精液を味わっ\@ SELECTCOM == 183 ? ている # た \@……
		ELSE
			;助手が飲む ?
			PRINTFORMDW おいしそうに精液を味わっ\@ SELECTCOM == 183 ? ている # た \@……
		ENDIF
		PRINTDW しかしフランドールはただ首を傾げるばかりで、その眼差しには嫌悪の色も羨望の色も見えない。
	ENDSELECT
	PRINTL 
ENDIF

