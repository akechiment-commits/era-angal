					PRINTW 「……ふぅん。これも何かの役に立つの？」
				CASE "十字架"
					;PLAYERが紅魔館関係者
					IF GROUPMATCH(NO:PLAYER, 6, 7, 8, 9, 10)
						PRINTW 「……どうしてこれは平気なのかしら？」
					;それ以外
					ELSE
						PRINTL 「うん、これは平気なんだ」
						PRINTW 「理由はわからないけどね」
					ENDIF
				CASE "聖骸布"
					SELECTCASE RAND:2
					CASE 0
						PRINTW 「変な話ね。そんな布きれをありがたがるなんて」
					CASEELSE
						PRINTL 「自分の名前を書いた紙を渡して、それを破り捨てるように言うと」
						PRINTW 「何の躊躇いもなく破り捨てる人と、そうでない人に分かれるんだとか」
					ENDSELECT
				ENDSELECT
			ELSEIF CFLAG:669 < STRCOUNT(LLIST, "/") + STRCOUNT(TSTR:1, "/")
				;最後の/を除去
				LOCALS '= SUBSTRINGU(TSTR:1, 0, STRLENSU(TSTR:1) - 1)
				;ランダマイズ
				SELECTCASE RAND_SPLIT(LOCALS)
				CASE "肉まん"
					PRINTW 「……拾い食い？」
				CASE "早苗さんのぱんつ"
					;PLAYERが早苗 ?
					CFLAG:669 = NO:PLAYER == 42 ? 0 # RAND:3
					SELECTCASE CFLAG:669
					CASE 0
						PRINTW 「……」
					CASE 1
						PRINTW 「主食？ まさかね」
					CASE 2
						PRINTW 「下着の収集が趣味なの？」
					ENDSELECT
				CASE "小銭"
					SELECTCASE RAND:3
					CASE 0
						PRINTW 「どれだけあれば人命が買えるのかしら」
					CASE 1
						PRINTW 「後で回収しないのかな。咲夜のナイフみたいに」
					CASE 2
						PRINTW 「お金を稼ぐこと自体が善行なら、商売で人を殺すのも善行だよね」
					ENDSELECT
				CASE "オレンジジュース"
					PRINTL 「オレンジジュース、うんしゅうみかんジュース、ミックス果汁ジュース」
					PRINTW 「ちょっと面白いね」
				CASE "乗船券の半券"
					SELECTCASE RAND:3
					CASE 0
						PRINTW 「変わっているわね。嫌いじゃないけど」
					CASE 1
						PRINTW 「フリーライダーを排除できないとねぇ」
					CASE 2
						PRINTW 「便益の享受なしでコスト負担の強制に納得できることはあるのかしら」
					ENDSELECT
				ENDSELECT
			ELSEIF CFLAG:669 < STRCOUNT(LLIST, "/") + STRCOUNT(TSTR:1, "/") + STRCOUNT(TSTR:2, "/")
				;最後の/を除去
				LOCALS '= SUBSTRINGU(TSTR:2, 0, STRLENSU(TSTR:2) - 1)
				;ランダマイズ
				SELECTCASE RAND_SPLIT(LOCALS)
				CASE "ローション", "媚薬", "コンドーム"
					PRINTW 「……拾い物を使うの？」
				ENDSELECT
			ENDIF
		ENDIF
	ENDSELECT
ENDIF

