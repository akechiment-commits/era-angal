@KOJO_MESSAGE_REJECTION_K11
PRINTL 
;初めて
IF !(CFLAG:623 & 1p7)
	;PLAYERがオトコ ?
	PRINTFORM 「……貴\@ TALENT:PLAYER:122 ? 方 # 女 \@、
	;6面以降 ?
	PRINTFORMW \@ FLAG:24 > 6 ? 既婚者 # 婚約者いる \@でしょう？」
	;(霊夢 OR 魔理沙 OR 美鈴 OR 小悪魔 OR パチュリー OR 咲夜 OR レミリア)にエンゲージリングを渡した
	SIF GROUPMATCH(FLAG:29, 1, 2, 6, 7, 8, 9, 10)
		PRINTFORMW 「しかも相手は%CNAME_K11(NO:TARGET, FLAG:29)%じゃない」
	LOCAL = 0
	REPEAT CHARANUM
		;恋人
		SIF TALENT:COUNT:153
			LOCAL += 1
	REND
	;恋人の数が10人以上
	IF LOCAL >= 10
		;PLAYERがオトコ ?
		PRINTFORM 「貴\@ TALENT:PLAYER:122 ? 方 # 女 \@の思い通りになれば、%CNAME_K11(NO:TARGET, FLAG:29)%の恨みは私に向くでしょうね。
		;PLAYERがオトコ ?
		PRINTFORML 元凶の貴\@ TALENT:PLAYER:122 ? 方 # 女 \@を通り越して」
		PRINTW 「だからこそ好き放題やってるんだろうけど。そんな茶番に付き合う義理は私にはないよ」
	;恋人の数が10人未満
	ELSE
		PRINTL 「何しようが勝手だけど、
		PRINTW   くだらないゴタゴタに私を巻き込まないでね。面倒臭いから」
		;恋慕 AND 恋人
		IF TALENT:TARGET:85 && TALENT:TARGET:153
			;PLAYERがオトコ ?
			PRINTFORML 「もちろん、貴\@ TALENT:PLAYER:122 ? 方 # 女 \@のことは好きよ。
			PRINTW   でも、それとこれとは話が別。当然のことでしょうに」
		ENDIF
	ENDIF
	CFLAG:623 |= 1p7
;二回目以降
ELSE
	PRINTL 「……」
	CALL READ_MIND_K11("（……ああ、もう。しつこいなぁ）", "L")
	CALL READ_MIND_K11("（恋愛依存者と陳腐なメロドラマでも演じていれば良いのに）", "L")
	PRINTFORMDW フランドールは無言で%CALLNAME:PLAYER%を拒絶した。
ENDIF
RETURN RESULT

