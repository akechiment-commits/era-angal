;----------------------------------------------------------------
;@SPEVENTSELECT
;	ARGS
;		"TYPE0":TFLAG:600
;		"TYPE1":TFLAG:13
;		"TYPE2":SELECTCOM
;----------------------------------------------------------------
@SPEVENTSELECT_K11(ARGS)
#DIM DYNAMIC SPEVENTNO, 1
#DIM DYNAMIC CANHAPPEN, 100
#DIM DYNAMIC LCOUNT, 1

VARSET CANHAPPEN
VARSET LCOUNT

FOR SPEVENTNO, 0, 100
	SELECTCASE ARGS
	CASE "TYPE0"
		CALL CHECK_CANHAPPEN_SPEVENT_TYPE0_K11(TFLAG:600, SPEVENTNO)
	CASE "TYPE1"
		CALL CHECK_CANHAPPEN_SPEVENT_TYPE1_K11(TFLAG:13, SPEVENTNO)
	CASE "TYPE2"
		CALL CHECK_CANHAPPEN_SPEVENT_TYPE2_K11(SELECTCOM, TEQUIP:2, SPEVENTNO)
	CASEELSE
		RETURN 0
	ENDSELECT
	SELECTCASE RESULT
	CASE -1
		BREAK
	CASE 1
		CANHAPPEN:LCOUNT = SPEVENTNO
		LCOUNT += 1
	ENDSELECT
NEXT

IF LCOUNT > 0
	SPEVENTNO = CANHAPPEN:(RAND:LCOUNT)
	SELECTCASE ARGS
	CASE "TYPE0"
		CALLFORM SPEVENT_TYPE0_{TFLAG:600}_{SPEVENTNO}_K11
	CASE "TYPE1"
		CALLFORM SPEVENT_TYPE1_{TFLAG:13}_{SPEVENTNO}_K11
	CASE "TYPE2"
		CALLFORM SPEVENT_TYPE2_{SELECTCOM}_{TEQUIP:2}_{SPEVENTNO}_K11
	ENDSELECT
	RETURN RESULT
ELSE
	RETURN 0
ENDIF

