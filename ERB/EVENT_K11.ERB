		;NONPLAYERがアリス
		CASE 14
			;eratohoJ+用アリス口上別人版3
			IF RESULTS == "NMUVT590"
				PRINTL 『……あなたが大した理由もなくレミリアに敵対するとは思えないけど』
				PRINTDW 静観していたアリスが沈黙を破った。
				PRINTW 『アピール不足なのかしらね。不器用と言うか何と言うか』
				PRINTW 「蓋然性の問題なんじゃない？ 理由があればするわけだし」
			ENDIF
		;NONPLAYERがリリーブラック
		CASE 56
			;eratohoJ+用リリーブラック口上
			IF RESULTS == "H95L7UPT"
				PRINTL 『そんな悲しくなること、よく平気で言えるわね』
				PRINTDW リリーブラックが口を開く。
				PRINTW 「卑下しているわけじゃなくて、事実を述べているだけだもの」
				PRINTW 『……』
				PRINTL 「貴女は情が深いのね。でも私なら大丈夫だから」
				PRINTDW リリーブラックの頭を撫でるフランドール。その声はいつもより少しだけ優しげだった。
			ENDIF
		ENDSELECT
	ENDIF
;それ以外
ELSE
	PRINTW 「もともと私には何の権限もないんだけどね」
ENDIF
CFLAG:660 |= 1p3
RETURN 1

