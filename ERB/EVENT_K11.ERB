			FOR LCOUNT, 800, 1000
				SIF TFLAG:LCOUNT > 0
					LLIST += ITEMNAME:LCOUNT + "/"
			NEXT
			
			;ランダマイズ
			CFLAG:669 = RAND:(STRCOUNT(LLIST, "/") + STRCOUNT(TSTR:1, "/") + STRCOUNT(TSTR:2, "/"))
			IF 0
			ELSEIF CFLAG:669 < STRCOUNT(LLIST, "/")
				;最後の/を除去
