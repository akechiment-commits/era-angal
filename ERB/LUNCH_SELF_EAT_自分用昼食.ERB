;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@LUNCH_SELF_EAT
;主人が自分で弁当を作ってパートナーに食べさせるオプション。
;-------------------------------------------------
;K = 料理の種類
;L = 習得の珠取得量の補正値を決定
;O = 習得の珠増加量
;P = 乱数処理用
;R = 料理の評価
;-------------------------------------------------
K = RAND:16
L = 0
M = 0
N = 0
O = 0
P = 0


L = (ABL:MASTER:2 + ABL:MASTER:90 * 2 + 33)

;EXP:調理経験をみる
IF EXP:MASTER:90 < EXPLV:1	; 【MASTER:[家事経験]<EXPLV:1】
	TIMES L , 0.80
ELSEIF EXP:MASTER:90 < EXPLV:2	; 【MASTER:[家事経験]<EXPLV:2】
	TIMES L , 1.00
ELSEIF EXP:MASTER:90 < EXPLV:3	; 【MASTER:[家事経験]<EXPLV:3】
	TIMES L , 1.20
ELSEIF EXP:MASTER:90 < EXPLV:4	; 【MASTER:[家事経験]<EXPLV:4】
	TIMES L , 1.40
ELSEIF EXP:MASTER:90 < EXPLV:5	; 【MASTER:[家事経験]<EXPLV:5】
	TIMES L , 1.70
ELSE
	TIMES L , 2.00
ENDIF

;献身的
SIF TALENT:MASTER:63	; 【MASTER:[献身的]】
	TIMES L , 1.20

;料理の種類決定
LOCAL:0 = MASTER
LOCAL:1 = TARGET
TARGET = MASTER
CALL LUNCH_MENU
MASTER = LOCAL:0
TARGET = LOCAL:1

;料理素質で補正を掛けてみる
IF ABL:MASTER:50 >= 2	; 【MASTER:[料理素質]Lv>=2】
	TIMES L , 1.20
ELSEIF ABL:MASTER:50 == 1	; 【MASTER:[料理素質]Lv==1】
	TIMES L , 1.10
ELSEIF ABL:MASTER:50 == -1	; 【MASTER:[料理素質]】
	TIMES L , 0.90
ENDIF

;♂の主人公より下手な事にコンプレックスを感じて効果アップ
;オトコ
SIF TALENT:MASTER:122 && ABL:MASTER:90 >= ABL:90	; 【MASTER:[オトコ] / MASTER:[料理技能] / [料理技能]】
	TIMES L , 1.10

;R = 料理の出来栄え
R = (RAND:100 + ABL:MASTER:90 + 1) / 10
SIF R <= 0
	R = 1
SIF R >= 10
	R = 10

SIF BASE:MASTER:0 < MAXBASE:MASTER:0	; 【MASTER:[体力]<MAXBASE:MASTER:0】
	BASE:MASTER:0 = MAXBASE:MASTER:0
BASE:MASTER:4 = MAXBASE:MASTER:4
IF TARGET >= 0 && BASE:TARGET:0 > 0	; 【TARGET:[体力]>0】
	BASE:TARGET:0 = MAXBASE:TARGET:0
	BASE:TARGET:4 = MAXBASE:TARGET:4
	CFLAG:TARGET:1202 += 1
	CFLAG:TARGET:1204 += 1
ENDIF
IF ASSI > 0 && BASE:ASSI:0 > 0	; 【ASSI:[体力]>0】
	BASE:ASSI:0 = MAXBASE:ASSI:0
	BASE:ASSI:4 = MAXBASE:ASSI:4
ENDIF

;地の文カット
SIF CFLAG:99 == 1 || FLAG:6 == 0	; 【[地の文カットフラグ]==1】
	GOTO LUNCH_EVALUATE

PRINTL 
PRINTFORMW %CALLNAME:MASTER%は自分で料理を作った
PRINTL 
PRINTW      ･
PRINTW      ･
PRINTW      ･
PRINTW      !
PRINTL 
PRINTFORM %CALLNAME:MASTER%は
IF R <= 2
	PRINT 微妙な
ELSEIF R <= 4
	PRINT 普通の
ELSEIF R <= 6
	PRINT 美味しい
ELSEIF R <= 8
	PRINT 非常に美味しい
ELSEIF R <= 10
	PRINT 最高の味がする
ENDIF
PRINTFORMW %TSTR:1%を作った。
PRINTL      ･
PRINTL      ･
PRINTL      ･
PRINTL 
PRINTL さて……せっかくの料理。
IF TARGET >= 0 && BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
	PRINTFORMW （%CALLNAME:TARGET%は保健室で衰弱療養（休み）中だ……）
	WAIT
	IF ASSI > 0
		PRINTFORML %CALLNAME:MASTER%は%CALLNAME:ASSI%と昼食を食べ、%CALLNAME:TARGET%には後で消化の良い差し入れを届けた。
	ELSE
		PRINTFORML %CALLNAME:MASTER%は一人で昼食を食べ、%CALLNAME:TARGET%には後で消化の良い差し入れを届けた。
	ENDIF
	PRINTL
	PRINTFORML %CALLNAME:MASTER%は英気・気力を養った。
	PRINTL
ELSE
	IF ASSI > 0
		PRINTW みんなで昼食を食べよう……
		WAIT
		PRINTFORML %CALLNAME:MASTER%はみんなで昼食を食べることにした。
	ELSE
		PRINTFORMW %CALLNAME:TARGET%はよろこんでくれるかな……？
		WAIT
		PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%はいっしょに昼食を食べることにした。
	ENDIF
	PRINTL      ・
	PRINTL      ・
	PRINTW      ・
	PRINT 今日の料理は
	IF R >= 10
		PRINTL 会心の出来だ。
		PRINTFORML %CALLNAME:TARGET%は出された料理を夢中で平らげている。
		PRINTFORML あまりに美味いのか食べ終えた%CALLNAME:TARGET%はおかわりを催促したそうに
		PRINTFORMW 空の皿を持ったまま物欲しそうな表情で見つめている。
		SIF RAND:4 == 0
			TFLAG:14 = 1
	ELSEIF R >= 8 && R < 10
		PRINTL なかなか上手く出来たと思う。
		PRINTFORML ふと顔を上げてみると%CALLNAME:TARGET%の皿は既に空になっていた。
		PRINTFORMW 気に入ったのか%CALLNAME:TARGET%は満足そうな笑みを浮かべている……
	ELSEIF R >= 5 && R < 8
		PRINTL それなりに仕上がっている。
		PRINTFORMW 食べている間、%CALLNAME:TARGET%の口元はずっと緩みっぱなしだった。
	ELSEIF R >= 3 && R < 5
		PRINTL 普通だ。
		PRINTFORMW %CALLNAME:MASTER%と%CALLNAME:TARGET%は談笑しながら料理を平らげた。
	ELSEIF R < 3
		PRINTFORML 残念ながら%CALLNAME:TARGET%の口に合わなかったみたいだ。
		PRINTFORMW %CALLNAME:MASTER%は%CALLNAME:TARGET%の残した料理も食べることにした。
	ENDIF
	PRINTW      ・
	PRINTW      ・
	PRINTW      ・
	PRINTFORM %CALLNAME:MASTER%と%CALLNAME:TARGET%
	IF ASSI > 0
		PRINTFORM と%CALLNAME:ASSI%
	ENDIF
	PRINTL は英気・気力を養った
	PRINTL  
ENDIF
$LUNCH_EVALUATE
;親密でL(恭順・好意の珠取得数)を補正
L = L * ABL:0 / 15
;EXキャラ補正(恋慕有りだと効果UP、恋慕無しだと珠なし)
IF CFLAG:0 && TALENT:85	; 【[恋慕] / [EXフラグ]】
	TIMES L , 1.20
ELSEIF CFLAG:0 && TALENT:85 == 0	; 【[恋慕]なし / [EXフラグ]】
	L = 0
ENDIF
IF L > 0
	IF ABL:MASTER:90 >= 10 && TALENT:153	; 【[恋人] / MASTER:[料理技能]Lv>=10】
		JUEL:4 += L * 22
		JUEL:15 += L * 33
		PRINTFORML %PALAMNAME:4%の珠＋{L*22}
		PRINTFORML %PALAMNAME:15%の珠＋{L*33}
	ELSE
		JUEL:4 += L * 11
		JUEL:15 += L * 17
		PRINTFORML %PALAMNAME:4%の珠＋{L*11}
		PRINTFORML %PALAMNAME:15%の珠＋{L*17}
	ENDIF
ENDIF

IF R >= 10
	PRINTFORML %EXPNAME:90% ＋5
	EXP:MASTER:90 += 5
ELSEIF R >= 5
	PRINTFORML %EXPNAME:90% ＋4
	EXP:MASTER:90 += 4
ELSE
	PRINTFORML %EXPNAME:90% ＋3
	EXP:MASTER:90 += 3
ENDIF
;好感度増加（浪費癖/10をマイナスし、Aがマイナスになる場合好感度は増加しない）
A = RAND:41 + 60 - (ABL:97 / 10)
IF A > 0
	CFLAG:2 += A
	PRINTFORMW 好感度が {A} 増えた
ENDIF
O = ABL:MASTER:90 + (1 + RAND:5)
SIF ABL:MASTER:90 < 9999	; 【MASTER:[料理技能]Lv<9999】
	FLAG:4 += O + R

IF ABL:MASTER:90 < 5 && FLAG:4 >= 25	; 【MASTER:[料理技能]Lv<5】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 < 20 && FLAG:4 >= 50	; 【MASTER:[料理技能]Lv<20】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 < 50 && FLAG:4 >= 100	; 【MASTER:[料理技能]Lv<50】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 < 60 && FLAG:4 >= 150	; 【MASTER:[料理技能]Lv<60】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 < 70 && FLAG:4 >= 250	; 【MASTER:[料理技能]Lv<70】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 < 90 && FLAG:4 >= 500	; 【MASTER:[料理技能]Lv<90】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 < 1000 && FLAG:4 >= 1000	; 【MASTER:[料理技能]Lv<1000】
	TFLAG:14 += 10
ELSEIF ABL:MASTER:90 >= 1000 && FLAG:4 >= 10000	; 【MASTER:[料理技能]Lv>=1000】
	TFLAG:14 += 10
ENDIF

IF TFLAG:14 >= 10 && ABL:MASTER:90 < 9999	; 【MASTER:[料理技能]Lv<9999 / [食後の運動]>=10】
	ABL:MASTER:90 += 1
	PRINTL  
	PRINTFORML %CALLNAME:MASTER%の%ABLNAME:90%のレベルが{ABL:MASTER:90}になりました。
	FLAG:4 = 0
	TFLAG:14 -= 10
ENDIF
WAIT

;食後の運動イベント
;衰弱療養中の場合は食後運動を発生させない
SIF TARGET >= 0 && BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
	TFLAG:14 = 0
IF TFLAG:14 == 1 && (TALENT:152 || TALENT:153) && TALENT:0 == 0 && TALENT:MASTER:154 == 0	; 【[合意] / [恋人] / [処女]なし / MASTER:[童貞]なし / [食後の運動]==1】
	CALL LUNCH_EXERCISE
ELSE
	TFLAG:14 = 0
ENDIF

;休憩フラグを立てる
FLAG:0 = 1
BEGIN TURNEND
RETURN 1
