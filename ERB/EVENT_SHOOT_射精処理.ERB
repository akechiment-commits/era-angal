;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;-------------------------------------------------
;射精関係の処理
;-------------------------------------------------
;TFLAG:703　～　デフォルト射精先設定一時変数
;1=膣内射精、2=アナル射精、3=手淫関係、4=フェラ・パイズリ、5=素股、
;6=助手（主人から）、7=クンニ、8=助手(奴隷から)、9=逆レイプ
;
;TFLAG:704　～　射精箇所選択可能か否か 0=不可、1=可
;TFLAG:302　～　射精量記録 1:射精　2:大量射精　4:超大量射精
;-------------------------------------------------
;射精チェックの例
;-------------------------------------------------
;CALL SAMEN_CHECK

;IF E >= 1
;	SIF ABL:0 >= 3 && ABL:1 >= 3 && FLAG:6
;		PRINTFORML %CALLNAME:TARGET%は%CALLNAME:PLAYER%に足を絡め腰を押し付けてきた…

;	;射精先タイプの設定
;	TFLAG:703 = 1
;	;射精先選択の可・不可
;	TFLAG:704 = 0
;	;汎用的な処理はこの関数で行う
;	;（射精ゲージの再計算や射精経験の上昇と共通部分の表示）
;	CALL SAMEN_SHOOT
;ENDIF

;---------------------------------------------------------
;射精するかのチェック
;---------------------------------------------------------
@SAMEN_CHECK, ARG = -1
#DIM DYNAMIC SHOOTER, 1
;通常は調教者。別の人物が射精するコマンドでは明示して判定する。
SHOOTER = PLAYER
SIF ARG >= 0
	SHOOTER = ARG
SIF SHOOTER < 0 || SHOOTER >= CHARANUM
	RETURN 0
;汎用的な関数なので、将来的にはすべての調教コマンドの射精チェックをここでやることも可能

;育成の余地を確保しつつオーバーフローを防ぐ。負数は上限ではなく0へ戻す。
IF BASE:SHOOTER:2 > 1000000000000000
	BASE:SHOOTER:2 = 1000000000000000
ELSEIF BASE:SHOOTER:2 < 0
	BASE:SHOOTER:2 = 0
ENDIF
S = BASE:SHOOTER:2
EJAC = LIMIT(MAXBASE:SHOOTER:2, 1, 1000000000000000)

;Eに射精量を記録。1:射精　2:大量射精
;超大量射精用にTFLAG:302に射精量記録。1:射精　2:大量射精　4:超大量射精
IF S > EJAC * 4
	;口上などで射精、大量射精の場合のみ考慮している条件が多いため、
	;超大量射精時でも大量射精の口上が表示されるようにEは2とする
	E = 2
	TFLAG:302 = 4
ELSEIF S > EJAC * 2
	E = 2
	TFLAG:302 = 2
ELSEIF S > EJAC
	E = 1
	TFLAG:302 = 1
ELSE
	E = 0
	TFLAG:302 = 0
ENDIF
TFLAG:714 = S / EJAC
SIF TFLAG:714 < 1
	TFLAG:714 = 1
A = 3 + 57 * (TFLAG:714 - 1) / (TFLAG:714 + 4)
B = A / 4
C = B * 2 + 1
TFLAG:719 = A - B + RAND:C
SIF TFLAG:719 < 1
	TFLAG:719 = 1

;---------------------------------------------------------
;射精場所選択
;---------------------------------------------------------
@SAMEN_SHOOT
;射精した人物の設定
;ダブル素股、ダブルフェラ
IF SELECTCOM == 62 || SELECTCOM == 68	; 【コマンド:[ダブル素股] / コマンド:[ダブルフェラ]】
	P = MASTER
;助手を犯させる
ELSEIF SELECTCOM == 65	; 【コマンド:[助手を犯させる]】
	P = TARGET
ELSE
	P = PLAYER
ENDIF

;射精する対象（受け手・搾り手）の設定（ドライ絶頂メッセージより先に設定して自己参照を防ぐ）
;助手を犯す、助手を犯させる
IF SELECTCOM == 56 || SELECTCOM == 65	; 【コマンド:[助手を犯す] / コマンド:[助手を犯させる]】
	T = ASSI
ELSE
	T = TARGET
ENDIF

;耐力消費の対象を射精した瞬間に記録する。後段の処理でPが変わっても判定を失わない。
TFLAG:994 = 0
TFLAG:996 = P
SIF (FLAG:62 & 1p17) || TFLAG:997
	TFLAG:994 = 1
;耐力が尽きた射精者は、精を出さないまま快感だけを味わう。
IF TFLAG:994 && BASE:(TFLAG:996):4 <= 0 && TFLAG:302	; 【[同時絶頂]】
	;精を出せないまま搾られた回数も、絶頂経験とは別に耐力上限を鍛える。
	CFLAG:(TFLAG:996):1154 += 16 + RAND(9)
	E = 0
	TFLAG:302 = 0
	TFLAG:714 = 0
	SIF EJAC > 0
		BASE:(TFLAG:996):2 = EJAC - 1
	LOCAL = T
	IF LOCAL == TFLAG:996 || LOCAL < 0
		IF ASSI > 0 && ASSI != TFLAG:996
			LOCAL = ASSI
		ELSE
			LOCAL = PLAYER
		ENDIF
	ENDIF
	;相手の意識があるか判定（0=意識あり、1=気絶・意識なし）
	LOCAL:1 = 0
	IF LOCAL >= 0 && LOCAL < CHARANUM
		IF TFLAG:898 || TFLAG:899 || BASE:LOCAL:0 <= 0
			LOCAL:1 = 1
		ELSEIF LOCAL == TARGET && (BASE:LOCAL:0 - LOSEBASE:0 <= 0)
			LOCAL:1 = 1
		ENDIF
	ENDIF

	;今回のコマンド開始時にはまだ耐力があった（今回出し切った）か、調教中初めて出なくなった場合
	IF TFLAG:993 > 0 || TFLAG:995 == 0
		TFLAG:995 = 1
		IF LOCAL:1
			;相手の意識が無い場合のメッセージ（出し切った瞬間）
			SELECTCASE RAND(4)
			CASE 0
				PRINTFORML 意識を失いぐったりと横たわる%CALLNAME:LOCAL%の中で、%CALLNAME:(TFLAG:996)%は最後の一滴まで出し尽くし、完全に精根を使い果たした……
			CASE 1
				PRINTFORML 気を失った%CALLNAME:LOCAL%の生ぬるい肉体に全てを搾り取られ、%CALLNAME:(TFLAG:996)%は力なくその上に倒れ込んだ……
			CASE 2
				PRINTFORML 眠るように静まり返った%CALLNAME:LOCAL%を相手に限界まで絞り出され、%CALLNAME:(TFLAG:996)%は出し切った快感に震えながら果てた……
			CASEELSE
				PRINTFORML これで完全に空っぽだ。反応のない%CALLNAME:LOCAL%の身体に最後の一滴まで吸い取られ、%CALLNAME:(TFLAG:996)%は虚脱感に沈んだ……
			ENDSELECT
		ELSE
			;相手の意識がある場合のメッセージ（出し切った瞬間）
			SELECTCASE RAND(4)
			CASE 0
				PRINTFORML 今回の絶頂で最後の一滴まで出し尽くし、%CALLNAME:(TFLAG:996)%の余力は完全に底を突いた……
			CASE 1
				PRINTFORML 全てを搾り取られた%CALLNAME:(TFLAG:996)%は、激しい快感の余韻の中で力なく身体を脱力させた……
			CASE 2
				PRINTFORML %CALLNAME:LOCAL%の激しい責めに限界まで絞り出され、%CALLNAME:(TFLAG:996)%は出し切った快感に震えながら果てた……
			CASEELSE
				PRINTFORML これで完全に空っぽだ。%CALLNAME:(TFLAG:996)%は最後の一滴まで搾り取られ、熱いため息を漏らした……
			ENDSELECT
		ENDIF
	ELSE
		TFLAG:995 += 1
		IF LOCAL:1
			;相手の意識が無い場合のメッセージ（既に出し切っている状態での空撃ち）
			SELECTCASE RAND(4)
			CASE 0
				PRINTFORML とっくに身体は出し尽くし、何も出せないはずなのに……意識のない%CALLNAME:LOCAL%の体温に刺激され、%CALLNAME:(TFLAG:996)%は空撃ちの絶頂に震えた……
			CASE 1
				PRINTFORML 気を失った%CALLNAME:LOCAL%の肉体が無意識に締め付け、空っぽの%CALLNAME:(TFLAG:996)%は一滴も出ないまま乾いたオーガズムを強いられた……
			CASE 2
				PRINTFORML もうこれ以上は何も出ない。ぐったりと動かない%CALLNAME:LOCAL%の上で、%CALLNAME:(TFLAG:996)%は声もなくただ身体を跳ねさせる……
			CASEELSE
				PRINTFORML 意識のない%CALLNAME:LOCAL%の温もりになお弄ばれ、出し尽くしたはずの身体は出ない快感に何度も引き攣っている……
			ENDSELECT
		ELSE
			;相手の意識がある場合のメッセージ（既に出し切っている状態での空撃ち）
			SELECTCASE RAND(4)
			CASE 0
				PRINTFORML もう何も出せないはずなのに、%CALLNAME:LOCAL%の執拗な責めが%CALLNAME:(TFLAG:996)%の身体を何度も震わせる……
			CASE 1
				PRINTFORML とっくに空になったはずの奥をなお弄ばれ、%CALLNAME:(TFLAG:996)%は一滴も出ないまま声のない絶頂を繰り返した……
			CASE 2
				PRINTFORML %CALLNAME:LOCAL%は限界を超えても容赦なく快感を重ね、出ない%CALLNAME:(TFLAG:996)%から残り香まで搾り取っていく……
			CASEELSE
				PRINTFORML もうこれ以上は何も出ない。それなのに容赦なく続く刺激に、%CALLNAME:(TFLAG:996)%は力なく身悶えさせられている……
			ENDSELECT
		ENDIF
	ENDIF
	;次回以降の空撃ち判定用にコマンド開始時耐力を0に更新
	TFLAG:993 = 0
	RETURN 0
ENDIF

S = 0
;射精時の処理の分岐
CALL COMMAND_CHECK

;カウンターシステムにおける耐力減少量の算出
CALL COUNTER_ECSTASY

;---------------------------------------------------------
;射精処理関数
;---------------------------------------------------------
@COMMAND_CHECK

;コンドームの有無で分岐、コンドーム射精の場合即RETURN
CALL CONDOM_CHECK
SIF RESULT == 1
	RETURN 0

;射精時の共通処理
CALL SAMEN_SHOOT_CALC

;射精時の処理の分岐
;コマンドによる処理ターゲットの確認と分岐
IF TFLAG:703 == 1	; 【[射精箇所]==1】
	;膣内射精
	CALL SAMEN_SHOOT_OLD_SEX
	TFLAG:2 = E
ELSEIF TFLAG:703 == 2	; 【[射精箇所]==2】
	;アナル射精
	CALL SAMEN_SHOOT_OLD_SEX2
	TFLAG:2 = E
ELSEIF TFLAG:703 == 3	; 【[射精箇所]==3】
	;手淫
	CALL SAMEN_SHOOT_OLD_FINGER
	TFLAG:1 = E
ELSEIF TFLAG:703 == 4	; 【[射精箇所]==4】
	;フェラ・パイズリ
	CALL SAMEN_SHOOT_OLD_ORAL
	TFLAG:0 = E
	;パイズリ
	IF SELECTCOM == 32	; 【コマンド:[パイズリ]】
		;胸で射精フラグ
		TFLAG:540 = E
		;衣装着用時、服の汚れ（精液）フラグ
		SIF TEQUIP:65	; 【[コスプレ]使用中】
			TFLAG:265 = 1
	ENDIF
ELSEIF TFLAG:703 == 5	; 【[射精箇所]==5】
	;素股
	CALL SAMEN_SHOOT_OLD_SUMATA
	TFLAG:9 = E
ELSEIF TFLAG:703 == 6	; 【[射精箇所]==6】
	;助手を犯す
	CALL SAMEN_SHOOT_OLD_ASSISTANT
	TFLAG:7 = E
ELSEIF TFLAG:703 == 7	; 【[射精箇所]==7】
	;クンニ強制
	CALL SAMEN_SHOOT_OLD_PUSSY
	TFLAG:5 = E
ELSEIF TFLAG:703 == 8	; 【[射精箇所]==8】
	;助手を犯させるで射精
	CALL SAMEN_SHOOT_OLD_TO_ASSISTANT
	TFLAG:6 = E
ELSEIF TFLAG:703 == 9	; 【[射精箇所]==9】
	;逆レイプ
	CALL SAMEN_SHOOT_OLD_RAPED
	TFLAG:12 = E
ELSEIF TFLAG:703 == 10	; 【[射精箇所]==10】
	;足扱き
	CALL SAMEN_SHOOT_OLD_SOLE
	TFLAG:16 = E
ELSEIF TFLAG:703 == 11	; 【[射精箇所]==11】
	;キスで射精
	CALL SAMEN_SHOOT_KISS
	TFLAG:4 = E
ELSEIF TFLAG:703 == 12	; 【[射精箇所]==12】
	;3P(主人・助手が射精する場合)
	CALL SAMEN_SHOOT_THREE_PLAY
ELSEIF TFLAG:703 == 13	; 【[射精箇所]==13】
	;アナルに挿入させるでプレイヤーが射精
	CALL SAMEN_SHOOT_RAPED_ASS
	TFLAG:13 = E
ENDIF

;キャラ反応フック（射精回数カウント）
;射精セリフは実行→絶頂の後に表示するためSOURCE_CHECKに移動
IF T == TARGET
	TFLAG:711 += 1
	TFLAG:712 = 1
ENDIF

EXP:T:20 += S
IF T == TARGET
	PRINTFORML 精液経験＋{S}
ELSE
	PRINTFORML 精液経験＋{S}(%CALLNAME:T%)
ENDIF
;膣射経験（膣内射精のみ、1-3）
IF TFLAG:703 == 1 || TFLAG:703 == 9	; 【[射精箇所]==1 / [射精箇所]==9】
	EXP:T:24 += MIN(TFLAG:302, 3)
	IF T == TARGET
		PRINTFORML 膣射経験＋{MIN(TFLAG:302, 3)}
	ENDIF
	;膣射経験によるSOURCEボーナス
	IF EXP:T:24 >= EXPLV:4	; 【T:[膣射経験]>=EXPLV:4】
		SOURCE:12 += 5000
	ELSEIF EXP:T:24 >= EXPLV:3	; 【T:[膣射経験]>=EXPLV:3】
		SOURCE:12 += 3000
	ELSEIF EXP:T:24 >= EXPLV:2	; 【T:[膣射経験]>=EXPLV:2】
		SOURCE:12 += 1500
	ENDIF
;精飲経験（フェラ系のみ、パイズリ除く、1-3）
ELSEIF TFLAG:703 == 4 && SELECTCOM != 32	; 【コマンド:[パイズリ]以外 / [射精箇所]==4】
	EXP:T:26 += MIN(TFLAG:302, 3)
	IF T == TARGET
		PRINTFORML 精飲経験＋{MIN(TFLAG:302, 3)}
	ENDIF
	;精飲経験によるSOURCEボーナス
	IF EXP:T:26 >= EXPLV:4	; 【T:[精飲経験]>=EXPLV:4】
		SOURCE:12 += 5000
	ELSEIF EXP:T:26 >= EXPLV:3	; 【T:[精飲経験]>=EXPLV:3】
		SOURCE:12 += 3000
	ELSEIF EXP:T:26 >= EXPLV:2	; 【T:[精飲経験]>=EXPLV:2】
		SOURCE:12 += 1500
	ENDIF
ENDIF

;中出しかどうかの確認（妊娠機能使用時のみ）
CALL IN_VAGINA_CHECK

;---------------------------------------------------------
;射精時の共通処理
;---------------------------------------------------------
@SAMEN_SHOOT_CALC
;精液汚れの設定
STAIN:P:2 |= 4

IF TFLAG:302 == 4	; 【[絶頂]==4】
	PRINTFORML 超量射精×{TFLAG:714}（{TFLAG:719}ml）
ELSEIF TFLAG:302 == 2	; 【[絶頂]==2】
	PRINTFORML 大量射精×{TFLAG:714}（{TFLAG:719}ml）
ELSEIF TFLAG:302 == 1	; 【[絶頂]==1】
	PRINTFORML 射精×{TFLAG:714}（{TFLAG:719}ml）
ENDIF

;射精経験
EXP:P:3 += TFLAG:302
;主人公射精量記録（セーブ固有。旧GLOBAL:240=通算mL、旧GLOBAL:1000+キャラNO=相手別mL）
IF P == PLAYER || P == MASTER
	FLAG:5040 += TFLAG:719
	FLAG:(5800 + NO:T) += TFLAG:719
	;相手別射精統計の記録（絶頂強度ではなく実際の射精回数＝1回として加算）
	IF T >= 0 && T < CHARANUM
		CFLAG:T:1220 += 1
		CFLAG:T:1221 += TFLAG:719
		SIF TFLAG:719 > CFLAG:T:1240	; 【T:[1回の最高射精量(mL)]】
			CFLAG:T:1240 = TFLAG:719
		IF TFLAG:703 == 1	; 【[射精箇所]==1】
			CFLAG:T:1222 += 1
			CFLAG:T:1223 += TFLAG:719
		ELSEIF TFLAG:703 == 2	; 【[射精箇所]==2】
			CFLAG:T:1224 += 1
			CFLAG:T:1225 += TFLAG:719
		ELSEIF TFLAG:703 == 4	; 【[射精箇所]==4】
			CFLAG:T:1226 += 1
			CFLAG:T:1227 += TFLAG:719
		ELSE
			CFLAG:T:1228 += 1
			CFLAG:T:1229 += TFLAG:719
		ENDIF
		CFLAG:T:1230 += 1
	ENDIF
	;パートナーのターン追加中の主人公射精は、回数と実射精量で最大耐力を鍛える。
	SIF TFLAG:994 && TFLAG:996 == MASTER
		CFLAG:MASTER:1150 += 1
	SIF TFLAG:994 && TFLAG:996 == MASTER
		CFLAG:MASTER:1151 += TFLAG:719
ENDIF

;射精値調整
BASE:P:2 -= EJAC*TFLAG:302
SIF BASE:P:2 >= EJAC
	BASE:P:2 = EJAC-1
SIF BASE:P:2 < 0
	BASE:P:2 = 0


;-------------------------------------------------------------------------
;各射精タイプごとの処理関数
;-------------------------------------------------------------------------
;今後はCOMF内では処理せず、必要に応じてここから呼び出す。
;汚れ移動等の処理は各COMF内でやってくれるので移動の必要無し

;=========================================================================
@SAMEN_SHOOT_OLD_SEX
;これまでCOMF内で使用されていたセックス射精の処理
;大量射精
IF E == 2
	;騎乗位
	IF SELECTCOM == 34	; 【コマンド:[騎乗位]】
		TIMES SOURCE:7 , 1.50
		TIMES SOURCE:5 , 1.20
	ENDIF
ENDIF

;精液量
S = 10 * TFLAG:302
;騎乗位
SIF SELECTCOM == 34	; 【コマンド:[騎乗位]】
	S += 5

;妊娠していないのであれば中田氏時の恐怖判定等(妊娠出産パッチのみ)
SIF TALENT:T:134 == 0 && T == TARGET && (FLAG:62 & 1)	; 【T:[妊娠]なし】
	CALL SAMEN_SHOOT_SOURCE

;=========================================================================
@SAMEN_SHOOT_OLD_SEX2
;これまでCOMF内で使用されていたセックス射精の処理を改造。
;アナルセックス系コマンドに使用する。

;精液量
S = 10 * TFLAG:302
;騎乗位アナル
SIF SELECTCOM == 36	; 【コマンド:[騎乗位アナル]】
	S += 5

;=========================================================================
@SAMEN_SHOOT_OLD_FINGER
;これまでCOMF内で使用されていた手コキ射精の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 2.00
	TIMES SOURCE:5 , 1.50
ENDIF

;精液量
S = 1 + ((TFLAG:302 - 1) * 2)

;=========================================================================
@SAMEN_SHOOT_OLD_ORAL
;これまでCOMF内で使用されていたフェラ・パイズリ射精の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 2.00
	TIMES SOURCE:5 , 1.50
ENDIF

;精液量
S = 3 + ((TFLAG:302 - 1) * 3)

;=========================================================================
@SAMEN_SHOOT_OLD_SUMATA
;これまでCOMF内で使用されていた素股射精の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 1.50
	TIMES SOURCE:5 , 1.20
ENDIF

;精液量
S = TFLAG:302

;=========================================================================
@SAMEN_SHOOT_OLD_ASSISTANT
;これまでCOMF内で使用されていた助手を犯した時の射精の処理

;大量射精
IF E == 2
	TIMES SOURCE:10 , 1.50
;通常の射精
ELSEIF E == 1
	;精液汚れ
	STAIN:MASTER:2 |= 4
ENDIF

;精液量
S = TFLAG:302

;=========================================================================
@SAMEN_SHOOT_OLD_PUSSY
;これまでCOMF内で使用されていたクンニ強制時の射精の処理

;精液量
S = 1 + ((TFLAG:302 - 1) * 3)

;=========================================================================
@SAMEN_SHOOT_OLD_TO_ASSISTANT
;これまでCOMF内で使用されていた助手を犯させた時の助手の射精の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 2.00
	TIMES SOURCE:5 , 1.50
ENDIF

;精液量
S = TFLAG:302

;=========================================================================
@SAMEN_SHOOT_OLD_RAPED
;これまでCOMF内で使用されていた逆レイプで射精の時の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 2.00
	TIMES SOURCE:5 , 1.50
ENDIF

;精液量
S = TFLAG:302

;=========================================================================
@SAMEN_SHOOT_OLD_SOLE
;これまでCOMF内で使用されていた足扱きで射精の時の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 2.00
	TIMES SOURCE:5 , 1.50
ENDIF

;精液量
S = 1 + ((TFLAG:302 - 1) * 2)

;=========================================================================
@SAMEN_SHOOT_KISS
;キスで射精の処理

;大量射精
IF E == 2
	TIMES SOURCE:7 , 2.00
	TIMES SOURCE:5 , 1.50
ENDIF

;精液量
S = TFLAG:302

;=========================================================================
@SAMEN_SHOOT_THREE_PLAY
;元来の3Pを端折って記述

L = 40 + ASSIPLAY

;セックスで射精
IF TFLAG:L == 1
	TFLAG:2 = E
