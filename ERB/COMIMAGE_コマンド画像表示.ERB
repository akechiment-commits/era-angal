;---------------------------------------------------------
; コマンド実行時画像表示システム
; EVENT_S の顔グラ表示と同じく CSV リソース名 + HTML_PRINT 方式
; （資料/EmueraEE_リファレンス.md 第3節 推奨方式）
;---------------------------------------------------------
@SHOW_COM_IMAGE
SIF TARGET < 0
	RETURN 0
A = NO:TARGET
SIF A <= 0 || A > 71
	RETURN 0

; "<img src='face_XX' height='150px'>" を組み立てる
; += は式モードなのでクォートは剥がれる。= "..." は罠なので使わない
LOCALS = ""
LOCALS += "<img src='face_"
IF A < 10
	LOCALS += "0"
ENDIF
LOCALS += TOSTR(A)
LOCALS += "' height='150px'>"
; 回り込み対策（画像高さ150px なら <br> を 12個ほど）
REPEAT 12
	LOCALS += "<br>"
REND
HTML_PRINT LOCALS
RETURN 0

@HAS_COMIMG
RETURN 0
