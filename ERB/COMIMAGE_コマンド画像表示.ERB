;---------------------------------------------------------
; コマンド実行時画像表示システム
;---------------------------------------------------------

;---------------------------------------------------------
; @SHOW_COM_IMAGE
; コマンド実行時に対象キャラの顔グラを表示
; 画像: resources/face_{charanum2桁}.png
;---------------------------------------------------------
@SHOW_COM_IMAGE
SIF TARGET < 0
	RETURN 0
A = NO:TARGET
SIF A <= 0 || A > 71
	RETURN 0

; ファイルパス構築: resources/face_29.png のような形式
LOCALS = "resources/face_"
IF A < 10
	LOCALS += "0"
ENDIF
LOCALS += TOSTR(A) + ".png"

; 既存スプライトを解放してからロード
SPRITEDISPOSE "face_img"
GCREATEFROMFILE 0, LOCALS, 1
SIF GCREATED(0) == 0
	RETURN 0

; スプライト作成 → HTML描画
SPRITECREATE "face_img", 0, 0, 0, GWIDTH(0), GHEIGHT(0)
HTML_PRINT "<img src='face_img' height='150px'>", 1
REPEAT 10
	PRINTL
REND
RETURN 0

;---------------------------------------------------------
; @HAS_COMIMG
; コマンド固有画像の有無（将来実装用スタブ）
; SIF NO:TARGET == cno && SELECTCOM == comid  RETURN 1
;---------------------------------------------------------
@HAS_COMIMG
RETURN 0
