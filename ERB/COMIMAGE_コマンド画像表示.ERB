;---------------------------------------------------------
; コマンド実行時画像表示システム
;---------------------------------------------------------
@SHOW_COM_IMAGE
SIF TARGET < 0
	RETURN 0
A = NO:TARGET
SIF A <= 0 || A > 71
	RETURN 0

; 2桁ゼロ埋めで "face_XX.png" を構築（'= で書式代入）
IF A < 10
	LOCALS '= @"face_0{A}.png"
ELSE
	LOCALS '= @"face_{A}.png"
ENDIF

; 既存スプライト解放
SPRITEDISPOSE "face_img"

; 試行1: resources/ 相対パス (EmueraEE デフォルト)
GCREATEFROMFILE 0, LOCALS
IF GCREATED(0)
	SPRITECREATE "face_img", 0, 0, 0, GWIDTH(0), GHEIGHT(0)
	LOCALS:1 '= @"<img src='face_img' height='150px'>"
	HTML_PRINT LOCALS:1, 1
	REPEAT 10
		PRINTL
	REND
	RETURN 0
ENDIF

; 試行2: exe 相対パス (resources/ プレフィックス付き)
LOCALS:2 '= @"resources/%LOCALS%"
GCREATEFROMFILE 1, LOCALS:2, 1
IF GCREATED(1)
	SPRITECREATE "face_img", 1, 0, 0, GWIDTH(1), GHEIGHT(1)
	LOCALS:1 '= @"<img src='face_img' height='150px'>"
	HTML_PRINT LOCALS:1, 1
	REPEAT 10
		PRINTL
	REND
	RETURN 0
ENDIF

; 両方失敗: 診断表示
PRINTFORML [画像NG: %LOCALS%]
RETURN 0

@HAS_COMIMG
RETURN 0
