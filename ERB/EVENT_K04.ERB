;ELSEIF NO:ASSI == Y1
;	DRAWLINE
	;初めて
;	IF CFLAG:202 == 0
		;恋慕＋恋慕時初口上（陥落イベント）が発生済み
;		IF TALENT:TARGET:85 == 1 && CFLAG:201 >= 5
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			CFLAG:202 = 1
;			RETURN 1
	;二回目以降
;	ELSEIF CFLAG:202 == 1 && FLAG:7 ==2
		;恋慕
;		IF TALENT:TARGET:85 == 1
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			RETURN 1
;	ENDIF

;ELSEIF NO:ASSI == Y1
;	DRAWLINE
	;初めて
;	IF CFLAG:203 == 0
		;恋慕＋恋慕時初口上（陥落イベント）が発生済み
;		IF TALENT:TARGET:85 == 1 && CFLAG:201 >= 5
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			CFLAG:203 = 1
;			RETURN 1
	;二回目以降
;	ELSEIF CFLAG:203 == 1 && FLAG:7 ==2
		;恋慕
;		IF TALENT:TARGET:85 == 1
;			PRINTFORMW 
		;それ以外
;		ELSE
;			PRINTFORMW 
;		ENDIF
;			RETURN 1
;	ENDIF
;口上のある助手が居ない場合は、通常の二回目以降の口上へ飛ぶ
ELSE
	CALL K4_KOJO2
ENDIF


;-------------------------------------------------
;パートナーと過ごす（2回目以降、4をキャラ番号に変更する） CFLAGなし 
;-------------------------------------------------
@K4_KOJO2
;反発感情Lv1以上
IF MARK:3 >= 1 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 大妖精は%CALLNAME:MASTER%と目を合わせないようにしている…
	RETURN 1

;進展無し（デート経験0）
ELSEIF EXP:94 == 0 && FLAG:7 == 2
	DRAWLINE
	IF RAND:5 == 0
		PRINTFORMW 「いつもは何してるの？」
		PRINTFORMW 「わたし？チルノちゃんと遊んでる事が多いかな…」
	ELSEIF RAND:4==0
		PRINTFORMW 「あ、おはようございます」
		PRINTFORMW 大妖精は%CALLNAME:MASTER%に、挨拶をした。
	ELSEIF RAND:3==0
		PRINTFORMW 「今日も、いくのですか？怖いですけど…異変解決のためなら仕方がないですよね」
		PRINTFORMW 大妖精は、そう言いながら%CALLNAME:MASTER%の隣に近づいた。その顔には緊張の面持ちがある。
	ELSEIF RAND:2 == 0
		PRINTFORMW 「チルノちゃんって、すごく元気で優しい妖精なんだけど…
		PRINTFORMW 無茶するときがあるからちょっと不安なときがあるんです…
		PRINTFORMW 今は、まさにそんな気持ちです…不安な気持ちで…心が一杯に…」
	ELSE
		PRINTFORMW 「今日は、どんなことがあるのかな？」
		PRINTFORMW 「今日は、少しでも笑えるような日であってほしいです」
	ENDIF
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「あ、いらっしゃい」
	PRINTFORMW 「今日もお出かけするの？」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	PRINTFORMW 「いらっしゃい」
	PRINTFORMW 部屋に入ってきた%CALLNAME:MASTER%を笑顔で迎え入れてくれた…
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0 && FLAG:7 == 2
	DRAWLINE
	;誕生日判定
	IF TIME:4 & 1
		PRINTFORMW 朝、大妖精に呼び止められた。
		PRINTFORMW 「%CALLNAME:MASTER%さん…あ、あの…お誕生日おめでとうございます」
		PRINTFORMW %CALLNAME:MASTER%は、大妖精からプレゼントをもらった。
		PRINTFORMW 好感度10アップした。
		CFLAG:2 += 10
	ELSE
		PRINTFORMW 大妖精はこちらを見かけると、嬉しそうにすりよってきた。
		PRINTFORMW 「%CALLNAME:MASTER%さんの…音が聞こえます…」
		PRINTFORMW 大妖精は、%CALLNAME:MASTER%の手をとり自分の胸にあてた…
		PRINTFORMW 「私のも聞こえますか？%CALLNAME:MASTER%さんに会えたから、こんなにドキドキしています」
	ENDIF
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1 && FLAG:7 == 2
	DRAWLINE
	;誕生日判定
	IF TIME:4 & 1
		PRINTFORMW 朝、大妖精に呼び止められた。
		PRINTFORMW 「%CALLNAME:MASTER%さん…あ、あの…お誕生日おめでとうございます」
		PRINTFORMW %CALLNAME:MASTER%は、大妖精からプレゼントをもらった。
		PRINTFORMW 好感度20アップした。
		CFLAG:2 += 20
	ELSE
		;ランダムで口上が変化する（使わない場合はすべて同じにすればよい）
		A = RAND:5
		IF A == 0
			PRINTFORMW 「いらっしゃい。　待ってたんだよ？」
		ELSEIF A == 1
			PRINTFORMW 「ふふ、お粗末さまでした」
			PRINTFORMW 「…ご飯も食べちゃったし、なにしようか…？」
		ELSEIF A == 2
			PRINTFORMW 「あの、ずっと一緒にいましょうね」
			PRINTFORMW 大妖精は、%CALLNAME:MASTER%の袖をつかみ顔を腕につけ目を閉じて言った。
		ELSEIF A == 3
			PRINTFORMW 「ん…ちゅ…」
			PRINTFORMW 「%CALLNAME:MASTER%さん…のそばにいると心が落ち着きます」
		ELSE
			PRINTFORMW 「来てくれたんだ。嬉しい…」
			PRINTFORMW 「ね、今日は何しよっか…？」
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 0

;-------------------------------------------------
;EVENTEND関係（4をキャラ番号に置換）
;パートナーと一旦別れる
;-------------------------------------------------
@EVENTEND
SIF FLAG:7 == 0
	RETURN 0
SIF NO:TARGET != 4
	RETURN 0
;--------------------------------------------------
;パートナーと一旦別れる
;--------------------------------------------------
;反発感情Lv1以上
IF MARK:3 >= 1
	DRAWLINE
	PRINTFORMW 「しばらく一人にしてくれませんか」
	RETURN 1

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「うん、またあとでね」
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「また、ね」
	PRINTFORMW 大妖精は、はにかみながら手を振った。
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0
	DRAWLINE
	PRINTFORMW 「うん、またね…」
	PRINTFORMW 大妖精は名残惜しそうにこちらを見つめている
	RETURN 1

;恋慕＋体力500未満
ELSEIF TALENT:TARGET:85 == 1 && BASE:0 < 500
	DRAWLINE
	PRINTFORMW 「疲れちゃった、ここで休ませて」
	PRINTFORMW そう言うと大妖精は%CALLNAME:MASTER%の肩にもたれかかって来た…
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1
	DRAWLINE
	;夜
	IF TIME
		A = RAND:5
		IF A == 0
			PRINTFORMW 「ん…もぉ…まずはお風呂に入らないと…それから、ね」
		ELSEIF A == 1
			PRINTFORMW 「私、%CALLNAME:MASTER%さんと、これからも…ずっと一緒に…」
		ELSEIF A == 2
			PRINTFORMW 「あの、もう少しだけ…一緒に居てもいいですか？もう少し、%CALLNAME:MASTER%さんを感じていたいから…」
		ELSEIF A == 3
			PRINTFORMW 「%CALLNAME:MASTER%さん、ちょっとお話でもしませんか」
			PRINTFORMW 「あ、あの…私…もう少し…%CALLNAME:MASTER%さんとお話したくて…」
		ELSE
			PRINTFORMW 「ちゅ…またね」
		ENDIF
	ELSE
		A = RAND:4
		IF A == 0
			PRINTFORMW 「ん…やぁ…まだ昼ですよ」
			PRINTFORMW 「でも…気持ちいいから…もうちょっとお願いしてもいいですか？」
			PRINTFORMW 大妖精は、時間まで%CALLNAME:MASTER%とじゃれあった。
		ELSEIF A == 1
			PRINTFORMW 「………」
			PRINTFORMW 大妖精は、寝息を立てている%CALLNAME:MASTER%の頭を優しく撫でている。
		ELSEIF A == 2
			PRINTFORMW 「ふふふ…もっと強く抱きしめて…」
			PRINTFORMW 「そうするとすごく落ちくんです」
		ELSEIF A == 3
			PRINTFORMW 「すやすや…」
			PRINTFORMW 大妖精は、%CALLNAME:MASTER%に寄りかかって静かに寝息を立ている。
			PRINTFORMW 柔らかい髪とその香りが鼻腔をくすぐるのを感じながら%CALLNAME:MASTER%は空を見ていた。
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%さん、時間になるまで一緒にお話ししませんか？」
		ENDIF
	ENDIF
	RETURN 1
;その他
ELSE
	DRAWLINE
	;夜
	IF TIME
		PRINTFORMW 「お休みなさい。また、明日です」
	;昼
	ELSE
		PRINTFORMW 「それじゃ、また後で」
	ENDIF
	RETURN 1
ENDIF
RETURN 0
