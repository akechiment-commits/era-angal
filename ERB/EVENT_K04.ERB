;	SIF NO:ASSI == Y1
;		CFLAG:201 =1
;ENDIF
;-------------------------------------------------
;初パートナーと過ごす CFLAG201
;-------------------------------------------------

IF CFLAG:201 == 0
	DRAWLINE
	;素質:パートナーの場合
	IF TALENT:150 == 1
		PRINTFORMW 「これからよろしくお願いします」
	;それ以外
	ELSE
		PRINTFORMW 「どうぞよろしくお願いします」
	ENDIF
		CFLAG:201 = 1
	RETURN 1

;-------------------------------------------------
;パートナーと過ごす（一回のみ） CFLAG201
;-------------------------------------------------

;デート経験済み
ELSEIF EXP:94 > 0 && TALENT:TARGET:85 == 0 && CFLAG:201 < 2
	DRAWLINE
	PRINTFORMW 「あ…」
	PRINTFORMW 大妖精はこちらを見かけると、柔らかい笑顔を見せてくれる
	PRINTFORMW 「おはようございます」
	CFLAG:201 = 2
	RETURN 1

;キス経験済み
ELSEIF EXP:96 > 0 && TALENT:TARGET:85 == 0 && CFLAG:201 < 3
	DRAWLINE
	PRINTFORMW 「ま、待ってください…！」
	PRINTFORMW 折り悪く、大妖精が着替えをしていた時に入ってしまったようだ。
	PRINTFORMW 「もう、次から気をつけてくださいね」
	CFLAG:201 = 3
	RETURN 1

;恋人
ELSEIF TALENT:TARGET:153 == 1 && TALENT:TARGET:85 == 0 && CFLAG:201 < 4
	DRAWLINE
	PRINTFORMW 「ちょっといい？」
	PRINTFORMW 大妖精に呼ばれて振り向くと、背伸びして突然%CALLNAME:MASTER%の頬にキスしてきた
	PRINTFORMW 「うふふ。顔、赤くなってるよ」
	PRINTFORMW そういった大妖精の頬も、みるみる真っ赤になっていった…
	CFLAG:201 = 4
	RETURN 1

;恋慕
ELSEIF TALENT:TARGET:85 == 1 && CFLAG:201 < 5
	DRAWLINE
	PRINTFORMW 「…ん……ふぁん……ぅん…」
	PRINTFORMW %CALLNAME:MASTER%は大妖精の腰を引き寄せ、情熱的なキスを重ねている…
	PRINTFORMW 「……%CALLNAME:MASTER%…」
	PRINTFORMW 「…ん、なんでもないです。続けて…ください…」
	PRINTFORMW 大妖精の顔がゆっくりと近づき、%CALLNAME:MASTER%に優しく口づけた…
	CFLAG:201 = 5
	RETURN 1

;助手の有無をチェック（いない場合は二回目以降へ飛ぶ）
ELSEIF ASSI < 0 
	CALL K4_KOJO2

;-------------------------------------------------
;簡易助手口上（Y1を助手のキャラ番号に置換、4をキャラ番号に変更する) CFLAG202
;掛け合いをするキャラを増やす場合は、コピー＆ペーストをして、CFLAGの数を203、204と増やす
;-------------------------------------------------
