;--------------------------------------------------
;キャラ種族番号格納関数@GET_STRAINNAME CFLAG14
;@GET_STRAINCORR_VALUEを用いて取得した種族をCFLAGに格納するだけの関数
;--------------------------------------------------
@GET_STRAINVALUE
COUNT = 0
REPEAT CHARANUM
	L = COUNT
	CALL GET_STRAINCORR_VALUE
	RESULT = L
	IF RESULT != 99
		;格納
		CFLAG:COUNT:14 = RESULT
	ELSE
		;該当データが無い場合は0を格納
		CFLAG:COUNT:14 = 0
	ENDIF
REND
RETURN 0

