;-------------------------------------------------------------------
;簡易喘ぎ装置　Ver.081014
;ぱ氏の自動喘ぎ生成機を参考にさせていただきました
;前提として一行目が喘ぎ、二行目がセリフになると想定していますので
;この関数単体では余り役に立たないでしょう。ワンパターンですし
;-------------------------------------------------------------------
;JKLの一文字変数
;ARG=喘ぎ強度を関数外部から取得、0,1,2のいずれか
;LOCAL:0=喘ぎ表示回数
;LOCAL:1=喘ぎ声の種類
@AUTO_AEGI(ARG)
#DIM LCOUNT, 1
;＊＊＊　まずLOCAL:0の値をARGに従って決定　＊＊＊
;快感強い時、喘ぎ回数多め
LOCAL:0 = RAND:4
IF ARG == 2
	LOCAL:0 += 7
;快感中くらい、喘ぎ回数中くらい
ELSEIF ARG == 1
	LOCAL:0 += 5
;快感少ない、喘ぎ回数少なめ
ELSE
	LOCAL:0 += 3
ENDIF

;＊＊＊　喘ぎ生成開始　＊＊＊
;純愛版のキス時喘ぎ　＊未実装＊
;キス時は変数ARGの意味合いが変わっています
;IF SELECTCOM:310 || SELECTCOM:311
;	PRINT 「
	;バードキス
;	IF SELECTCOM:309
;		IF ARG == 2
;			LOCAL:0 = RAND:3 + 2
;		ELSEIF ARG == 1
;			LOCAL:0 = RAND:3 + 1
;		ELSE
;			LOCAL:0 = RAND:3
;		ENDIF
;		REPEAT LOCAL:0
;			PRINT ちゅっ…
;		REND
;	ENDIF
PRINT 「
;えっち喘ぎ口上の組み立て開始。ARGの値で種類を変化
FOR LCOUNT, 0, LOCAL:0
	LOCAL:1 = RAND:9
	;ARGの値別にLを補正
	IF ARG == 2
		LOCAL:1 += 9
	ELSEIF ARG == 1
		LOCAL:1 += 5
	ENDIF
	;基本的に喘ぎ声が羅列されるだけの感じ
	PRINTFORM %AUTO_SPLIT("ひっ…/…うあ…/ん…う…/あ…/…/く…あ…/…あんっ！…/ふっ…あっ…/んっ…/あうっ…/んあ…/あ…はっ…/ふあぁっ！　/ひぁっ！　/はあんっ！　/んあっ！　/はうっ！　/あんっ！　", "/", LOCAL:1)%
NEXT
;セリフを付与するかどうか決める
IF RAND:3 == 0 && ARG == 2
	;挿入系の場合
	IF ((SELECTCOM > 19 && SELECTCOM < 30) || SELECTCOM == 34)
		PRINTFORM %RAND_SPLIT("あ…熱い…あついよぉ/もっと…！もっとぉっ…/あ…イクぅ…！")%
	;愛撫系の場合　＊この関数制作時点で愛撫が埋まっていたので省略ｗ＊
	;ELSEIF SELECTCOM == 0 || SELECTCOM == 5 || SELECTCOM == 2 || SELECTCOM == 9
	ENDIF
ENDIF
PRINTFORML 」

RETURN 1

