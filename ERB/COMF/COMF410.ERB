;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE410
;口上独自純愛コマンド実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;プレイヤーのみ（アシスタントプレイ中は使用不可）
SIF ASSIPLAY
	RETURN 0
;ウフフ中だと無理
SIF TFLAG:44 == 1
	RETURN 0
;CFLAGがたてられてないと無理
SIF !GETBIT(CFLAG:TARGET:独自コマンド使用判定, 5)
	RETURN 0
;恋人のみ（純愛独自コマンドは恋人必須）
SIF TALENT:153 == 0
	RETURN 0
;独自コマンドは1回の調教につきいずれか1つだけ
SIF TFLAG:独自コマンド使用済
	RETURN 0
RESULT = 1
TRYCALLFORM COM_ABLE410_{NO:TARGET}
SIF RESULT == 0
	RETURN 0
;プレイヤーのみ（アシスタントプレイ中は使用不可）
SIF ASSIPLAY
	RETURN 0
;ファーストキス前はコマンド使用不可（キスしないため）
SIF TALENT:151
	RETURN 0
RETURN 1

@COM410
;この調教で独自コマンドを使用済みにする（1調教1回限り）
TFLAG:独自コマンド使用済 = 1
PRINTSL CSTR:85
STR:0 = %CSTR:85%
;実行判定を使用する場合はこの関数で、真で戻ってくれば判定失敗
TRYCCALLFORM COM_ORDER410_{NO:TARGET}
	IF RESULT == 1
		;口上呼び出し
		TFLAG:13 = 99
		CALL SELF_KOJO
		RETURN 0
	ENDIF
CATCH
ENDCATCH
;地の文を呼ぶ
CALL TRAIN_MESSAGE_B
;デフォルト効果（独自純愛共通・キャラ個別関数で上書き可能）
LOSEBASE:0 += 150
LOSEBASE:1 += 350
SOURCE:3 = 5000
SOURCE:18 = 4000
SOURCE:9 = 3000
SOURCE:24 = 2500
SOURCE:21 = 2000
;キス経験を加算
PRINTFORML %EXPNAME:96%＋１
EXP:96 += 1
EXP:PLAYER:96 += 1
;キャラ固有処理（ソース上書き等）
TRYCALLFORM COM410_{NO:TARGET}
RETURN 1

;コマンド前の地の文
@TRAIN_MESSAGE_COM410
TRYCALLFORM TRAIN_MESSAGE_B410_{NO:TARGET}

;絶頂時などの地の文
@TRAIN_MESSAGE_A410
TRYCALLFORM TRAIN_MESSAGE_A410_{NO:TARGET}

;コマンド本体後に出てくる地の文
@TEXT410
TRYCALLFORM TEXT410_{NO:TARGET}
