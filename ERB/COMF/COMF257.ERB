;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@_COMF257_PUBES_GLOW
#FUNCTION
RETURNF 200

@_COMF257_ENABLE_SHAVING
#FUNCTION
RETURNF 150

@COM_ABLE257
;剃毛プレイ実行判定
;YM Mk3改7.1を参考に

;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0

;恋慕か合意＆恋人が必要
SIF TALENT:85 == 0 && (TALENT:152 == 0 || TALENT:153 == 0)	; 【[恋慕]なし / [合意]なし / [恋人]なし】
	RETURN 0

;反発は不可。刃物扱うし。
SIF MARK:3	; 【[反発感情]】
	RETURN 0

;ウフフ中/お風呂場プレイ中じゃないと無理
SIF TFLAG:44 == 0 || TEQUIP:58 == 0	; 【無[お風呂場プレイ中] / 無[ウフフ中]】
	RETURN 0

;プレイマットが必要
SIF ITEM:13 == 0	; 【アイテム:[プレイマット]==0】
	RETURN 0

;触手調教中・暗闇プレイはダメ
SIF TEQUIP:90 || TEQUIP:80	; 【[触手プレイ]使用中 / [暗闇プレイ]使用中】
	RETURN 0

;縄で緊縛はダメ
SIF TEQUIP:44	; 【[縄で緊縛]使用中】
	RETURN 0

;PLAYER主導権時の実行判定
CALL COM_ABLE257_PLAYER_MAIN
LOCAL:0 = RESULT

;TARGET主導権時の実行判定
CALL COM_ABLE257_TARGET_MAIN
LOCAL:1 = RESULT

;PLAYER主導権時、TARGET主導権時のどちらも実行できない場合はダメ
SIF LOCAL:0 == 0 && LOCAL:1 == 0
	RETURN 0

RETURN 1

@COM_ABLE257_PLAYER_MAIN
;PLAYER主導権時の実行判定
;バイブ・クスコ・焼き芋・オナホ・オムツはダメ
SIF TEQUIP:11 || TEQUIP:61 || TEQUIP:71 || TEQUIP:17 || TEQUIP:20	; 【[バイブ]使用中 / [クスコ]使用中 / [焼芋]使用中 / [オナホール]使用中 / [オムツ]使用中】
	RETURN 0
;子供体型だとダメ
SIF TALENT:TARGET:149	; 【TARGET:[子供体型]】
	RETURN 0
;一度剃った後、ある程度伸びないうちはダメ
SIF BASE:TARGET:8 < _COMF257_ENABLE_SHAVING()
	RETURN 0
;技巧 3 + 酩酊度 / 20 以上
;[酒豪]持ってると技巧 3 + 酩酊度 / 25
SIF ABL:PLAYER:2 < (3 + TFLAG:47 / (TALENT:PLAYER:217 ? 25 # 20))	; 【PLAYER:[酒豪] / PLAYER:[技巧] / [酩酊度]】
	RETURN 0
RETURN 1

@COM_ABLE257_TARGET_MAIN
;TARGET主導権時の実行判定
;プレイヤーが子供体型だとダメ
SIF TALENT:PLAYER:149	; 【PLAYER:[子供体型]】
	RETURN 0
;プレイヤーが一度剃った後、ある程度伸びないうちはダメ
SIF BASE:PLAYER:8 < _COMF257_ENABLE_SHAVING()
	RETURN 0
;技巧 3 + 酩酊度 / 20 以上
;[酒豪]持ってると技巧 3 + 酩酊度 / 25
SIF ABL:TARGET:2 < (3 + TFLAG:47 / (TALENT:TARGET:217 ? 25 # 20))	; 【TARGET:[酒豪] / TARGET:[技巧] / [酩酊度]】
	RETURN 0
RETURN 1

@COM257
;PLAYER主導権時の実行判定
CALL COM_ABLE257_PLAYER_MAIN
LOCAL:0 = RESULT

;TARGET主導権時の実行判定
CALL COM_ABLE257_TARGET_MAIN
LOCAL:1 = RESULT

;プレイヤーに主導権がある時にPLAYER主導権時の実行ができない場合はパートナーに主導権が移る
IF LOCAL:0 == 0 && TFLAG:45 == 0	; 【無[主導権]】
	TFLAG:45 = 1
;パートナーに主導権がある時にTARGET主導権時の実行ができない場合はプレイヤーに主導権が移る
ELSEIF LOCAL:1 == 0 && TFLAG:45	; 【[主導権]】
	TFLAG:45 = 0
ENDIF

IF TFLAG:45	; 【[主導権]】
	PRINTL 剃毛される
ELSE
	PRINTL 剃毛プレイ
ENDIF
STR:0 = 剃毛プレイ

CALL TRAIN_MESSAGE_B

;主導権がPLAYER
IF TFLAG:45 == 0	; 【無[主導権]】
	;体力・気力減少
	LOSEBASE:0 += 50
	LOSEBASE:1 += 100

	;PALAM:潤滑を見てSOURCE:痛み
	IF PALAM:3 < PALAMLV:1	; 【[潤滑]<PALAMLV:1】
		SOURCE:6 = 600
	ELSEIF PALAM:3 < PALAMLV:2	; 【[潤滑]<PALAMLV:2】
		SOURCE:6 = 250
	ELSEIF PALAM:3 < PALAMLV:3	; 【[潤滑]<PALAMLV:3】
		SOURCE:6 = 100
	ELSEIF PALAM:3 < PALAMLV:4	; 【[潤滑]<PALAMLV:4】
		SOURCE:6 = 30
	ENDIF

	LOCAL:1 = 500

	;ABL:露出癖を見る
	IF ABL:7 == 0	; 【[露出癖]Lv==0】
		TIMES LOCAL:1 , 0.80
	ELSEIF ABL:7 == 1	; 【[露出癖]Lv==1】
		TIMES LOCAL:1 , 1.00
	ELSEIF ABL:7 == 2	; 【[露出癖]Lv==2】
		TIMES LOCAL:1 , 1.20
	ELSEIF ABL:7 == 3	; 【[露出癖]Lv==3】
		TIMES LOCAL:1 , 1.50
	ELSEIF ABL:7 == 4	; 【[露出癖]Lv==4】
		TIMES LOCAL:1 , 2.00
	ELSE
		TIMES LOCAL:1 , 2.60
	ENDIF

	;ABL:マゾっ気を見る
	IF ABL:8 == 0	; 【[マゾっ気]Lv==0】
		TIMES LOCAL:1 , 0.80
	ELSEIF ABL:8 == 1	; 【[マゾっ気]Lv==1】
		TIMES LOCAL:1 , 1.00
	ELSEIF ABL:8 == 2	; 【[マゾっ気]Lv==2】
		TIMES LOCAL:1 , 1.20
	ELSEIF ABL:8 == 3	; 【[マゾっ気]Lv==3】
		TIMES LOCAL:1 , 1.40
	ELSEIF ABL:8 == 4	; 【[マゾっ気]Lv==4】
		TIMES LOCAL:1 , 1.70
	ELSE
		TIMES LOCAL:1 , 2.00
	ENDIF

	;中毒充足
	SOURCE:7 += LOCAL:1
	;欲情追加
	SOURCE:11 += LOCAL:1
	;露出
	SOURCE:12 += LOCAL:1
	;逸脱
	SOURCE:14 += 1500

	;;小柄体型、子供体型以外
	;SIF TALENT:128 == 0 && TALENT:127 == 0
	;	TIMES SOURCE:12 , 2.50

	;小柄体型、子供体型はcom_ableで弾いてる
	TIMES SOURCE:12, 2.50

	;[パイパン]付加
	IF TALENT:TARGET:65 == 0	; 【TARGET:[パイパン]なし】
		PRINTL 
		PRINTFORML %CALLNAME:TARGET%は[%TALENTNAME:65%]になった
		TALENT:TARGET:65 = 1
	ENDIF

	;BASE:陰毛
	P:8 = BASE:TARGET:8
	BASE:TARGET:8 = 0

	;TALENT:122 オトコ
	IF TALENT:TARGET:122 == 0 && TALENT:PLAYER:122 == 0	; 【TARGET:[オトコ]なし / PLAYER:[オトコ]なし】
		;EXP:40 レズ経験
		PRINTFORML %EXPNAME:40%+2
		EXP:TARGET:40 += 2
		EXP:PLAYER:40 += 4
	ELSEIF TALENT:122 && TALENT:PLAYER:122	; 【[オトコ] / PLAYER:[オトコ]】
		;EXP:41 BL経験
		PRINTFORML %EXPNAME:41%+2
		EXP:TARGET:41 += 2
		EXP:PLAYER:41 += 2
	ENDIF

;主導権がTARGET
ELSE
	;体力・気力減少
	LOSEBASE:0 += 25
	LOSEBASE:1 += 50

	;ABL:15 サドっ気
	;SOURCE:20 征服
	IF ABL:15 == 0	; 【[サドっ気]Lv==0】
		SOURCE:20 = 800
	ELSEIF ABL:15 == 1	; 【[サドっ気]Lv==1】
		SOURCE:20 = 1350
	ELSEIF ABL:15 == 2	; 【[サドっ気]Lv==2】
		SOURCE:20 = 2000
	ELSEIF ABL:15 == 3	; 【[サドっ気]Lv==3】
		SOURCE:20 = 3000
	ELSEIF ABL:15 == 4	; 【[サドっ気]Lv==4】
		SOURCE:20 = 4000
	ELSE
		SOURCE:20 = 2500 + (ABL:15 * 500)
	ENDIF

	;[パイパン]付加
	IF TALENT:PLAYER:65 == 0	; 【PLAYER:[パイパン]なし】
		PRINTL 
		PRINTFORML %CALLNAME:PLAYER%は[%TALENTNAME:65%]になった
		TALENT:PLAYER:65 = 1
	ENDIF

	P:8 = BASE:PLAYER:8
	BASE:PLAYER:8 = 0

	;TALENT:122 オトコ
	IF TALENT:TARGET:122 == 0 && TALENT:PLAYER:122 == 0	; 【TARGET:[オトコ]なし / PLAYER:[オトコ]なし】
		;EXP:40 レズ経験
		PRINTFORML %EXPNAME:40%+2
		EXP:TARGET:40 += 2
		EXP:PLAYER:40 += 4
	ELSEIF TALENT:122 && TALENT:PLAYER:122	; 【[オトコ] / PLAYER:[オトコ]】
		;EXP:41 BL経験
		PRINTFORML %EXPNAME:41%+2
		EXP:TARGET:41 += 2
		EXP:PLAYER:41 += 2
	ENDIF
ENDIF

RETURN 1

@TRAIN_MESSAGE_COM257
;TARGET主導権
IF TFLAG:45	; 【[主導権]】
	IF BASE:PLAYER:8 < _COMF257_PUBES_GLOW()
		IF MAXBASE:PLAYER:8 == 1000
			PRINTFORML %CALLNAME:TARGET%はようやく伸びてきた%CALLNAME:PLAYER%の陰毛を綺麗さっぱり剃り落した
		ELSE
			PRINTFORML %CALLNAME:TARGET%はまだ薄く産毛に近いような%CALLNAME:PLAYER%の陰毛を綺麗さっぱり剃り落した
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:TARGET%は%CALLNAME:PLAYER%の陰毛を綺麗さっぱり剃り落した
	ENDIF
	PRINTFORM %CALLNAME:TARGET%は
	;ABL:7 露出癖
	SELECTCASE ABL:7
		CASE 0, 1
			PRINTFORML 顔を真っ赤にしてツルツルになった%CALLNAME:PLAYER%の性器から目を背けている…
		CASE 2
			PRINTFORML 露わになった%CALLNAME:PLAYER%の性器を恥ずかしそうに見つめている…
		CASE 3
			PRINTL 少し顔を俯かせている…
		CASE 4
			PRINTFORML %CALLNAME:PLAYER%の性器が丸見えの状態をどことなく楽しんでいるようだ…
		CASEELSE
			PRINTFORML 陰毛をすべて剃り落して丸見えになった%CALLNAME:PLAYER%の性器を大いに楽しんでいるようだ…
	ENDSELECT
;PLAYER主導権
ELSE
	IF BASE:TARGET:8 < _COMF257_PUBES_GLOW()
		IF MAXBASE:TARGET:8 == 1000
			PRINTFORML %CALLNAME:PLAYER%はようやく伸びてきた%CALLNAME:TARGET%の陰毛を綺麗さっぱり剃り落した
		ELSE
			PRINTFORML %CALLNAME:PLAYER%はまだ薄く産毛に近いような%CALLNAME:TARGET%の陰毛を綺麗さっぱり剃り落した
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:PLAYER%は%CALLNAME:TARGET%の陰毛を綺麗さっぱり剃り落した
	ENDIF
	PRINTFORM %CALLNAME:TARGET%は
	;ABL:7 露出癖
	SELECTCASE ABL:7
		CASE 0, 1
			PRINT 顔を真っ赤にして
			;縄で緊縛
			IF TEQUIP:44	; 【[縄で緊縛]使用中】
				PRINTFORML %CALLNAME:PLAYER%と視線を合わせないように背けている…
			ELSE
				PRINTL 手でツルツルになった性器を隠そうとしている…
			ENDIF
		CASE 2
			PRINTL 露わになった自分の性器を恥ずかしそうに見つめている…
		CASE 3
			PRINTL 少し顔を俯かせている…
		CASE 4
			PRINTL 性器が丸見えの状態に恥ずかしさを感じつつも、どことなく楽しんでいるようだ…
		CASEELSE
			PRINTL 空気が性器を撫でつける感触を大いに楽しんでいるようだ…
	ENDSELECT
ENDIF

;SYSTEM.ERBの@EVENTTURNENDに追加してもよかったけど、現状ここで済ませてしまう
;本体に取り込むならそのときそっちに持って行った方がいいかもです。
@EVENTTURNEND
REPEAT CHARANUM
	;昼
	IF TIME == 0
		LOCAL:5 = 20
		;日光浴
		SIF TALENT:COUNT:115	; 【COUNT:[日光浴]】
			LOCAL:5 = 25
	ELSE
		LOCAL:5 = 35
		;月光浴
		SIF TALENT:COUNT:114	; 【COUNT:[吸血鬼]】
			LOCAL:5 = 40
	ENDIF

	;回復早い
	IF TALENT:COUNT:111	; 【COUNT:[回復早い]】
		TIMES LOCAL:5, 1.25
	;回復遅い
	ELSEIF TALENT:COUNT:112	; 【COUNT:[回復遅い]】
		TIMES LOCAL:5, 0.75
	ENDIF

	;小柄体型
	SIF TALENT:COUNT:100	; 【COUNT:[小柄体型]】
		TIMES LOCAL:5, 0.95

	SIF MAXBASE:COUNT:8 == 300
		TIMES LOCAL:5, 0.95

	BASE:COUNT:8 = MIN(BASE:COUNT:8 + MAX(LOCAL:5, 1), MAXBASE:COUNT:8)
	IF TALENT:COUNT:65 && BASE:COUNT:8 > _COMF257_PUBES_GLOW()	; 【COUNT:[パイパン]】
		DRAWLINE
		PRINTFORML %CALLNAME:COUNT%の陰毛が生えそろいました
		PRINTFORML %CALLNAME:COUNT%は[%TALENTNAME:65%]ではなくなりました
		TALENT:COUNT:65 = 0
	;ELSEIF TALENT:COUNT:65
		;PRINTFORML %CALLNAME:COUNT%は[%TALENTNAME:65%]です
	;ELSE
		;PRINTFORML %CALLNAME:COUNT%は[%TALENTNAME:65%]ではありません
	ENDIF
REND

