;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM18
;シャワー
IF TEQUIP:65	; 【[コスプレ]使用中】
	PRINTL 着衣シャワー
	STR:0 = 着衣シャワー
ELSE
	PRINTL シャワー
	STR:0 = シャワー
ENDIF

LOSEBASE:0 += 0
LOSEBASE:1 += 10

SOURCE:12 = 50
SOURCE:14 = 50
SOURCE:5 = 400
SOURCE:16 = 200

;PALAM:欲情をみる
IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
	SOURCE:12 += 10
ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
	SOURCE:12 += 30
ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
	SOURCE:12 += 60
ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
	SOURCE:12 += 100
ELSEIF PALAM:5 >= PALAMLV:4	; 【[欲情]>=PALAMLV:4】
	SOURCE:12 += 150
ENDIF

;奉仕精神をみる
IF ABL:6 == 0	; 【[奉仕精神]Lv==0】
	SOURCE:3 = 0
ELSEIF ABL:6 == 1	; 【[奉仕精神]Lv==1】
	SOURCE:3 = 20
ELSEIF ABL:6 == 2	; 【[奉仕精神]Lv==2】
	SOURCE:3 = 40
ELSEIF ABL:6 == 3	; 【[奉仕精神]Lv==3】
	SOURCE:3 = 70
ELSEIF ABL:6 == 4	; 【[奉仕精神]Lv==4】
	SOURCE:3 = 110
ELSE
	SOURCE:3 = 50 + (ABL:6 * 20)
ENDIF

;ABL:従順をみる
IF ABL:0 == 0	; 【[親密]Lv==0】
	TIMES SOURCE:5 , 0.80
ELSEIF ABL:0 == 1	; 【[親密]Lv==1】
	TIMES SOURCE:5 , 0.90
ELSEIF ABL:0 == 2	; 【[親密]Lv==2】
	TIMES SOURCE:5 , 1.00
ELSEIF ABL:0 == 3	; 【[親密]Lv==3】
	TIMES SOURCE:5 , 1.10
ELSEIF ABL:0 == 4	; 【[親密]Lv==4】
	TIMES SOURCE:5 , 1.20
ELSE
	SOURCE:5 = SOURCE:5 * (ABL:0 * 5 + 105) / 100
ENDIF

;吸血鬼の場合
IF TALENT:114	; 【[吸血鬼]】
	SOURCE:6 = 100
	TIMES SOURCE:6 , 1.60
	TIMES SOURCE:13 , 2.00
	TIMES SOURCE:15 , 1.40
ENDIF


;動物耳の場合
IF TALENT:124	; 【[動物耳]】
	TIMES SOURCE:14 , 1.60
	TIMES SOURCE:13 , 1.50
	TIMES SOURCE:15 , 2.00
ENDIF

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
	PRINTS EXPNAME:40
	PRINTL +3
	EXP:40 += 3
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1	; 【[オトコ] / PLAYER:[オトコ]】
	PRINTS EXPNAME:41
	PRINTL +1
	EXP:41 += 1
ENDIF

CALL TRAIN_MESSAGE_B

;シャワーの開始と終了
IF TEQUIP:18	; 【[シャワー]使用中】
	TEQUIP:18 = 0
ELSE
	TEQUIP:18 = 1
ENDIF

;シャワーで汚れがリセット
STAIN:0 = 0
STAIN:1 = 0
STAIN:2 = 2
STAIN:3 = 1
STAIN:4 = 8
STAIN:5 = 0

;（できれば）潤滑が半分に
PALAM:3 /= 2
PALAM:12 /= 2


;主導権をチェック
IF TFLAG:45 == 0	; 【無[主導権]】
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1	; 【[親密]Lv<=1】
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3	; 【[親密]Lv<=3】
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5	; 【[親密]Lv<=5】
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8	; 【[親密]Lv<=8】
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11	; 【[親密]Lv<=11】
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0	; 【[サドっ気]Lv==0】
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1	; 【[サドっ気]Lv==1】
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2	; 【[サドっ気]Lv==2】
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3	; 【[サドっ気]Lv==3】
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4	; 【[サドっ気]Lv==4】
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 5
;合意がないと好感度が下がる
IF TALENT:152 == 0 && TFLAG:48 == 0	; 【[合意]なし / 無[よっぱウフフ]】
	A -= 2
	SOURCE:15 += 50
ENDIF
TFLAG:30 += A
TFLAG:37 += A / 2


RETURN 1

@TRAIN_MESSAGE_COM18
;シャワーの開始と終了
IF TEQUIP:18	; 【[シャワー]使用中】
	PRINTFORML %CALLNAME:TARGET%にシャワーを止めさせた
ELSE
	IF TEQUIP:65	; 【[コスプレ]使用中】
		PRINTFORML %CALLNAME:TARGET%に%GET_CLOTH_SHORT_NAME(TEQUIP:65)%を着たままシャワーを浴びさせた
	ELSE
		PRINTFORML %CALLNAME:TARGET%にシャワーを浴びさせた
	ENDIF
ENDIF

@EQUIP_COM18
;シャワー使用中

PRINTL ＜シャワー使用中＞

LOSEBASE:0 += 0
LOSEBASE:1 += 10

A = 400
SOURCE:16 += 300
;PALAM:欲情をみる
IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
	SOURCE:12 += 10
ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
	SOURCE:12 += 30
ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
	SOURCE:12 += 60
ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
	SOURCE:12 += 100
ELSEIF PALAM:5 >= PALAMLV:4	; 【[欲情]>=PALAMLV:4】
	SOURCE:12 += 150
ENDIF

;奉仕精神をみる
IF ABL:6 == 0	; 【[奉仕精神]Lv==0】
	SOURCE:3 += 0
ELSEIF ABL:6 == 1	; 【[奉仕精神]Lv==1】
	SOURCE:3 += 20
ELSEIF ABL:6 == 2	; 【[奉仕精神]Lv==2】
	SOURCE:3 += 40
ELSEIF ABL:6 == 3	; 【[奉仕精神]Lv==3】
	SOURCE:3 += 70
ELSEIF ABL:6 == 4	; 【[奉仕精神]Lv==4】
	SOURCE:3 += 110
ELSE
	SOURCE:3 += 50 + (ABL:6 * 20)
ENDIF

;ABL:従順をみる
IF ABL:0 == 0	; 【[親密]Lv==0】
	TIMES A , 0.80
ELSEIF ABL:0 == 1	; 【[親密]Lv==1】
	TIMES A , 0.90
ELSEIF ABL:0 == 2	; 【[親密]Lv==2】
	TIMES A , 1.00
ELSEIF ABL:0 == 3	; 【[親密]Lv==3】
	TIMES A , 1.10
ELSEIF ABL:0 == 4	; 【[親密]Lv==4】
	TIMES A , 1.20
ELSE
	A = A * (ABL:0 * 5 + 105) / 100
ENDIF

SOURCE:5 += A
SOURCE:11 += 50
SOURCE:12 += 50

;吸血鬼の場合
IF TALENT:114	; 【[吸血鬼]】
	SOURCE:6 += 150
	TIMES SOURCE:6 , 1.60
	TIMES SOURCE:13 , 2.00
	TIMES SOURCE:15 , 1.40
ENDIF

;動物耳の場合
IF TALENT:124	; 【[動物耳]】
	SOURCE:15 += 150
	TIMES SOURCE:14 , 1.60
	TIMES SOURCE:13 , 1.50
	TIMES SOURCE:15 , 2.00
ENDIF

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
	PRINTS EXPNAME:40
	PRINTL +3
	EXP:40 += 3
	EXP:PLAYER:40 += 3
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1	; 【[オトコ] / PLAYER:[オトコ]】
	PRINTS EXPNAME:41
	PRINTL +1
	EXP:41 += 1
	EXP:PLAYER:41 += 1
ENDIF

;シャワーで汚れがリセット
STAIN:0 = 0
STAIN:1 = 0
STAIN:2 = 2
STAIN:3 = 1
STAIN:4 = 8
STAIN:5 = 0
IF TEQUIP:65	; 【[コスプレ]使用中】
	TFLAG:262 = 0
	TFLAG:264 = 0
	TFLAG:265 = 0
ENDIF

PALAM:3 /= 2
PALAM:12 /= 2

RETURN 1
