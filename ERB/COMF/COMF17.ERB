@COM17
;オナホール
;実行者が[淫具知識]を持っているなら効果増
SIF TALENT:PLAYER:58
	PRINT 高性能
PRINTL オナホール
STR:0 = オナホール

LOSEBASE:0 += 10
LOSEBASE:1 += 80

SOURCE:12 = 120
SOURCE:14 = 70

;ABL:Ｃ感覚をみる
IF ABL:3 == 0
	SOURCE:0 = 200
ELSEIF ABL:3 == 1
	SOURCE:0 = 400
ELSEIF ABL:3 == 2
	SOURCE:0 = 900
ELSEIF ABL:3 == 3
	SOURCE:0 = 1600
ELSEIF ABL:3 == 4
	SOURCE:0 = 2400
ELSE
	SOURCE:0 = 1500 + (ABL:3 * 300)
ENDIF

;実行者が[淫具知識]を持っているなら効果増
SIF TALENT:PLAYER:58
	TIMES SOURCE:0 , 1.20

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTS EXPNAME:40
	PRINTL +3
	EXP:40 += 3
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1
	PRINTS EXPNAME:41
	PRINTL +1
	EXP:41 += 1
ENDIF

CALL TRAIN_MESSAGE_B

;オナホールの着脱
IF TEQUIP:17
	TEQUIP:17 = 0
ELSE
	TEQUIP:17 = 1
ENDIF

RETURN 1

@TRAIN_MESSAGE_COM17
;オナホールの着脱
IF TEQUIP:17
	PRINTFORML %CALLNAME:TARGET%からオナホールを外した
	;ペニスの大きさで外した後の様子が変わる
	IF TALENT:146
		PRINTFORML オナホールを引き抜くと、収まりきらなかった凶悪なペニスが勢いよく弾け出て、なおも雄々しく反り返っている…
	ELSEIF TALENT:145
		PRINTFORML きつく咥え込んでいたオナホールを外すと、逞しいペニスが糸を引きながら姿を現した…
	ELSEIF TALENT:144
		PRINTFORML オナホールを外すと、ささやかなペニスがちょこんと顔を出し、物足りなさげにひくついている…
	ELSE
		PRINTFORML オナホールを外すと、濡れ光るペニスが現れた…
	ENDIF
ELSE
	PRINTFORML %CALLNAME:TARGET%のペニスをオナホールに挿入した
	;ペニスの大きさで描写が変わる
	IF TALENT:146
		PRINTFORML 凶悪なまでに巨大なペニスはオナホールに収まりきらず、根元と先端が大きくはみ出してびくついている…
	ELSEIF TALENT:145
		PRINTFORML 逞しいペニスがオナホールをはち切れんばかりに押し広げ、内壁にみっちりと食い締められている…
	ELSEIF TALENT:144
		PRINTFORML ささやかなペニスはオナホールの中で泳いでしまい、奥まで届かずもどかしげに震えている…
	ELSE
		PRINTFORML ペニスがオナホールに包み込まれ、ぬめる内壁に締めつけられている…
	ENDIF
ENDIF

@EQUIP_COM17
;オナホール装備中
PRINTL ＜オナホール装備中＞

LOSEBASE:0 += 5
LOSEBASE:1 += 20

;ABL:Ｃ感覚をみる
IF ABL:3 == 0
	A = 40
ELSEIF ABL:3 == 1
	A = 120
ELSEIF ABL:3 == 2
	A = 250
ELSEIF ABL:3 == 3
	A = 450
ELSEIF ABL:3 == 4
	A = 600
ELSE
	A = 375 + (ABL:3 * 75)
ENDIF

;PALAM:欲情をみる
IF PALAM:5 < PALAMLV:1
	TIMES A , 0.80
ELSEIF PALAM:5 < PALAMLV:2
	TIMES A , 0.90
ELSEIF PALAM:5 < PALAMLV:3
	TIMES A , 1.00
ELSEIF PALAM:5 < PALAMLV:4
	TIMES A , 1.10
ELSEIF PALAM:5 >= PALAMLV:4
	TIMES A , 1.20
ENDIF

;ABL:従順をみる
IF ABL:0 == 0
	TIMES A , 0.80
ELSEIF ABL:0 == 1
	TIMES A , 0.90
ELSEIF ABL:0 == 2
	TIMES A , 1.00
ELSEIF ABL:0 == 3
	TIMES A , 1.10
ELSEIF ABL:0 == 4
	TIMES A , 1.20
ELSE
	A = A * (ABL:0 * 5 + 105) / 100
ENDIF

;実行者が[淫具知識]を持っているなら効果増
SIF TALENT:PLAYER:58
	TIMES A , 1.20

SOURCE:0 += A
SOURCE:11 += 50
SOURCE:12 += 50

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTS EXPNAME:40
	PRINTL +3
	EXP:40 += 3
	EXP:PLAYER:40 += 3
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1
	PRINTS EXPNAME:41
	PRINTL +1
	EXP:41 += 1
	EXP:PLAYER:41 += 1
ENDIF


RETURN 1
