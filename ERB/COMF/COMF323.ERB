		ELSEIF COUNT == 8 && (MONEY > 5000 + N || (FLAG:8 && MONEY > 2000 + N))
		
		;遊覧船
		ELSEIF COUNT == 9 && (MONEY > 15000 || (FLAG:8 && MONEY > 12000))
		
		;スポーツ観戦
		ELSEIF COUNT == 12 && (MONEY > 10000 || ( FLAG:8 && MONEY > 7000))
		
		;キャラ固有デート先
		ELSEIF COUNT == 13 && O == 0
		
		;条件を満たしていないと表示しない
		ELSE
			CONTINUE
		ENDIF
	ENDIF
	
	;名前が長いデート名は特殊
	IF SELECTCOM == 323
		IF COUNT == 8
			PRINTFORM  [{COUNT, 2}] %TSTR:(COUNT+30)%(${N}が更に必要です)    
			D:1 += 1
		ELSEIF COUNT == 9
			PRINTFORM  [{COUNT, 2}] %TSTR:(COUNT+30)%($10000が更に必要です)  
			D:1 += 1
		ELSEIF COUNT == 12
			PRINTFORM  [{COUNT, 2}] %TSTR:(COUNT+30)%($5000が更に必要です)   
			D:1 += 1
		ELSE
			PRINTFORM  [{COUNT, 2}] %TSTR:(COUNT+30), 12, LEFT%
		ENDIF
	ELSE
		PRINTFORM  [{COUNT, 2}] %TSTR:(COUNT+30), 12, LEFT%
	ENDIF
	
	;改行処理
	D:1 += 1
	IF D:1 > 2
		PRINTL 
		D:1 = 0
	ENDIF
REND

