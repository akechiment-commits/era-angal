;幻想郷
;---------------------------------------------------------
@GENSOUKYO_DATE
K = 0
J = 0
H = 0
L = 0
M = 0
R = 0
S = 0
;初めにデート条件に関わる素質等を判定
;マスター、助手、パートナーのいずれかが結界操作保持で外界へ行ける
;マスター、助手、パートナーのいずれかが羽、角、動物の耳、しっぽのいずれかを持っていると変身魔法が必要
;結界操作は削除済み。常に外界へ行ける
K = 1
;羽、角、獣の耳、しっぽを持っているか判定。持っているとJ=1
SIF TALENT:TARGET:213 || TALENT:TARGET:214 || TALENT:TARGET:215 || TALENT:TARGET:124 || TALENT:MASTER:213 || TALENT:MASTER:214 || TALENT:MASTER:215 || TALENT:MASTER:124
	J = 1
IF ASSI > 0
	SIF TALENT:ASSI:213 || TALENT:ASSI:214 || TALENT:ASSI:215 || TALENT:ASSI:124 
		J = 1
ENDIF
;変身魔法は削除済み。常に月の都へ行ける
H = 1

REPEAT CHARANUM
	;別れているキャラはチェックしない
	SIF CFLAG:COUNT:21 == 1
		CONTINUE
	;紫か小町か映姫、幽霊が仲間にいると彼岸に行ける
	SIF (NO:COUNT >= 16 && NO:COUNT <= 20) || NO:COUNT == 22 || NO:COUNT == 35 || NO:COUNT == 36 || NO:COUNT == 51 || NO:COUNT == 68 || NO:COUNT == 87 || NO:COUNT == 94
		L = COUNT + 1
	
	;紫か鈴仙か永琳か輝夜か豊姫か依姫かレイセンが仲間にいると月の都に行ける
	SIF NO:COUNT == 22 || (NO:COUNT >= 28 && NO:COUNT <= 30) || (NO:COUNT >= 53 && NO:COUNT <= 55)
		M = COUNT + 1
	
	;聖輦船実行判定 水蜜が仲間にいる
	SIF NO:COUNT == 94
		R = COUNT + 1
REND

;変身魔法ゲート削除済み
IF 0
	;削除済み
	SIF ((NO:PLAYER >= 53 && NO:PLAYER <= 55) != 1 && (NO:TARGET >= 53 && NO:TARGET <= 55) != 1) && (((NO:PLAYER >= 16 && NO:PLAYER <= 20) || NO:PLAYER == 22 || (NO:PLAYER >= 35 && NO:PLAYER <= 39) || NO:PLAYER == 43 || NO:PLAYER == 44 || NO:PLAYER == 51 || NO:PLAYER == 68 || NO:PLAYER == 87 || NO:PLAYER == 94) != 1 || ((NO:TARGET >= 16 && NO:TARGET <= 20) || NO:TARGET == 22 || (NO:TARGET >= 35 && NO:TARGET <= 39) || NO:TARGET == 43 || NO:TARGET == 44 || NO:TARGET == 51 || NO:TARGET == 68 || NO:TARGET == 87 || NO:TARGET == 94) != 1)
		M = 0
ELSEIF ((NO:MASTER >= 53 && NO:MASTER <= 55) != 1 && (NO:TARGET >= 53 && NO:TARGET <= 55) != 1) && H == 0
	;霊同士なら月の都に行ける
	SIF ((NO:MASTER >= 16 && NO:MASTER <= 20) || NO:MASTER == 22 || (NO:MASTER >= 35 && NO:MASTER <= 39) || NO:MASTER == 43 || NO:MASTER == 44 || NO:MASTER == 51 || NO:MASTER == 68 || NO:MASTER == 87 || NO:MASTER == 94) != 1 || ((NO:TARGET >= 16 && NO:TARGET <= 20) || (NO:TARGET >= 35 && NO:TARGET <= 39) || NO:TARGET == 43 || NO:TARGET == 44 || NO:TARGET == 51 || NO:TARGET == 68 || NO:TARGET == 87 || NO:TARGET == 94) != 1
		M = 0
ENDIF

;禁断の知識を持っているか
SIF TALENT:MASTER:125 || TALENT:TARGET:125
	S = 1
IF ASSI > 0
	SIF TALENT:ASSI:125
		S = 1
ENDIF

;調合でデート先を表示する場合、制限は解除された状態（聖輦船は行き先不明の船になるだけなので除く）
IF SELECTCOM == 310
	K = 1
	J = 1
	H = 1
	L = 1
	M = 1
	;R = 1
	S = 1
ENDIF

;表示処理の前にデート場所名とCFLAG:778,779に対応する変数を設定
CALL DATE_NAME

;綺麗に並べるためのフラグ
D:1 = 0
;表示処理
PRINTL どこに向かいますか？
REPEAT 21
	;口上側による行き先制限判定。制限されていれば表示しない
	SIF CFLAG:778 & (T:COUNT)
		CONTINUE
	
	;TSTR:COUNTが空白の場合表示しない（主にキャラ固有デート先に関係）
	SIF TSTR:COUNT == ""
		CONTINUE

	;条件のあるデート先はここで判定（IF文が行ける場合の条件で条件を満たしていない場合は表示しない）
	IF (COUNT == 6 || COUNT == 9 || COUNT == 10 || COUNT == 11 || COUNT == 18 || COUNT == 19 || COUNT == 20) && SELECTCOM == 323
		;温泉
		IF COUNT == 6 && (TALENT:153 || (ABL:0 >= 10 && ((TALENT:122 == 0 && TALENT:MASTER:122 == 0) || (TALENT:122 && TALENT:MASTER:122))))
		
		;外界(TFLAG:62は聖輦船に載っていると1）
		ELSEIF COUNT == 9 && K && TFLAG:62 == 0 && (J && H || J == 0)
		
		;彼岸
		ELSEIF COUNT == 10 && L
		
		;月の都
		ELSEIF COUNT == 11 && (M || (TFLAG:62 && H))
		
		;魔界
		ELSEIF COUNT == 18 && (K || TFLAG:62)
		
		;キャラ固有デート先
		ELSEIF COUNT == 19
		
		;聖輦船（行き先の分からない船）
