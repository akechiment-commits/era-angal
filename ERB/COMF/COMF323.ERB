IF DAY:1 == 1
	N = 2000
ELSE
	;PLAYERがオトコの場合
	IF TALENT:PLAYER:122
		;火曜日はメンズディ（紳士$1000）、木曜日はレディースディ（淑女$1000）
		IF DAY:5 == 1 || DAY:5 == 3
			N = 2800
		ELSE
		;それ以外の日
			N = 3600
		ENDIF
	ELSE
	;PLAYERがオトコじゃない場合
		IF DAY:5 == 3
		;木曜日はレディースディ（淑女$1000）
			N = 2000
		ELSE
		;それ以外の日
			N = 3600
		ENDIF
	ENDIF
