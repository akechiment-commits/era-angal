REPEAT 15
	;口上側による行き先制限判定。制限されていれば表示しない
	IF COUNT <= 7 && (CFLAG:779 & (T:COUNT))
		CONTINUE
	ELSEIF COUNT >= 9 && (CFLAG:779 & (T:(COUNT+5)))
		CONTINUE
	ENDIF
	
