;デート中
PRINTFORML ＜%STR:4%でデート中＞

LOSEBASE:1 += 35

;恋慕・恋人・親愛による気力消費軽減（デートが長続きする、の再現だとでも脳内補完）
SIF TALENT:85
	LOSEBASE:1 -= 5
SIF TALENT:153
	LOSEBASE:1 -= 5
SIF TALENT:88
	LOSEBASE:1 -= 10

B = 0
C = 0
D = 0
E = 0


;固定で獲得するソース
B = 100
C = 50

;ABL:従順をみる
IF ABL:0 <= 1
	B += (ABL:0 * 20)
	C += (ABL:0 * 10)
ELSEIF ABL:0 <= 3
	B += 200 + (ABL:0 * 40)
	C += 100 + (ABL:0 * 15)
ELSEIF ABL:0 <= 5
	B += 500 + (ABL:0 * 50)
	C += 200 + (ABL:0 * 20)
ELSEIF ABL:0 <= 8
	B += 700 + (ABL:0 * 80)
	C += 300 + (ABL:0 * 30)
ELSEIF ABL:0 <= 11
	B += 1200 + (ABL:0 * 100)
	C += 400 + (ABL:0 * 35)
ELSE
	B += 2000 + (ABL:0 * 130)
	C += 800 + (ABL:0 * 40)
ENDIF

;好感度をみる
IF CFLAG:2 <= 500
	B += CFLAG:2
ELSEIF CFLAG:2 <= 5000
	B += 500 + (CFLAG:2 - 500) / 3
ELSE
	B += 2000 + (CFLAG:2 - 5000) / 5
ENDIF

;主導権をチェック
IF TFLAG:45 == 0
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1
		E += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3
		E += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5
		E += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8
		E += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11
		E += 1200 + (ABL:0 * 160)
	ELSE
		E += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0
		D = 600
	ELSEIF ABL:15 == 1
		D = 900
	ELSEIF ABL:15 == 2
		D = 1200
	ELSEIF ABL:15 == 3
		D = 1600
	ELSEIF ABL:15 == 4
		D = 2000
	ELSE
		D = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:3 + 1
;10%で好感度-3
SIF RAND:10 == 0
	A = -3
TFLAG:30 += A
F = 0

IF A == -3
	TIMES B , 0.10
	TIMES C , 0.50
	TIMES D , 0.50
	TIMES E , 0.50
	TFLAG:37 -= 1
ELSEIF A < 3
	TIMES B , 1.00
	TIMES C , 1.00
	TIMES D , 1.00
	TIMES E , 1.00
	TFLAG:37 += 2 + A * 2
	F = 1
ELSE
	TIMES B , 1.50
	TIMES C , 1.50
	TIMES D , 1.50
	TIMES E , 1.50
	TFLAG:30 += 2
	TFLAG:37 += 5 + A * 2
	F = 2
ENDIF

;恋慕
IF TALENT:85
	TIMES B , 1.10
	TIMES C , 1.30
	TIMES D , 1.10
	TIMES E , 1.20
ENDIF
;恋人
IF TALENT:153
	TIMES B , 1.20
	TIMES C , 1.50
	TIMES D , 1.20
	TIMES E , 1.10
ENDIF
;親愛
IF TALENT:88
	TIMES B , 1.50
	TIMES C , 2.00
	TIMES D , 1.50
	TIMES E , 1.50
ENDIF

;実行中の効果は、実行時の20%
TIMES B , 0.20
TIMES C , 0.20
TIMES D , 0.20
TIMES E , 0.20

;行き先に応じた補正

;人里
IF TEQUIP:2 == 1
	;歓楽のソースに+100～400
	SOURCE:18 += RAND:301 + 100
;霧の湖
ELSEIF TEQUIP:2 == 3
	;露出のソースに+200～500
	SOURCE:12 += RAND:301 + 200
	;夏は更にUP
	IF DAY:2 == 1
		SOURCE:12 += RAND:201
	;冬は更にDOWNするかわりに接触のソースに+0～10
	ELSEIF DAY:2 == 3
		SOURCE:12 -= RAND:201
		SOURCE:9 += RAND:11
	ENDIF
;花畑
ELSEIF TEQUIP:2 == 4
	;ムードに更に+1～3
	TFLAG:37 += RAND:3 + 1
;肝試し
ELSEIF TEQUIP:2 == 5
	;不安のソースに+200～500
	SOURCE:23 += RAND:301 + 200
	;夏は更にUP
	IF DAY:2 == 1
		SOURCE:23 += 100
	ENDIF
	;素質発覚イベント
	CALL FIND_BUSTSIZE
;カラオケ
ELSEIF TEQUIP:2 == 6
	;ネチョ中は、歌わない代わりに狭いところなのでよくくっつく
	IF TFLAG:44
		SOURCE:9 += RAND:301 + 200
	ELSE
		IF ABL:92 >= 5
			PRINTFORML %EXPNAME:93%＋{ABL:92 / 5 +1}
			EXP:93 += ABL:92 / 5 + 1
		ELSE
			;歌唱経験に＋1
