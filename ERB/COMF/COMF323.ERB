;告白判定
;最低でも従順5、好感度1000が必要
IF ABL:0 >= 5 && CFLAG:2 >= 1000 && TALENT:153 == 0 && ASSIPLAY == 0
	A = 0
	;目標難易度は190
	V = 190

	;純愛系コマンド実行値取得
	CALL GET_JUN_VALUE

	;好感度
	A += CFLAG:2 / 50

	;キス未経験
	SIF TALENT:151
		A -= 10

	;恋慕
	SIF TALENT:85
		A += 30

	;臆病
	SIF TALENT:10
		A -= 10

	;恥じらい
	SIF TALENT:35
		A -= 10

	;恥薄い
	SIF TALENT:36
		A += 5

	;悲観的
	SIF TALENT:26
		A -= 5

	;一線越えない
	SIF TALENT:27
		A -= 15

	;Aの値を退避
	Z = A
	;主導権基準値ボーナス
	T = TARGET
	CALL GET_INITIATIVE_RATE
	;退避させた値を戻す
	A = Z
	;従順なキャラには＋ボーナス、強気なキャラには－ボーナス
	IF R < 0
		;負の値の計算がeramakerのバグで怪しいので要注意
		R = R * -1
		A += R / 5 + 5
	ELSEIF R > 0
		A -= R / 5
	ENDIF

	;ムードボーナス この値が本命
	IF TFLAG:37 < 10
		A -= 10
	ELSEIF TFLAG:37 < 30
		A -= 1
	ELSEIF TFLAG:37 < 50
		A += 1
	ELSEIF TFLAG:37 < 100
		A += TFLAG:37 / 6
	ELSEIF TFLAG:37 < 300
		A += TFLAG:37 / 4
	ELSE
		A += TFLAG:37
	ENDIF

	;デート経験 これも割と大きい
	IF EXP:94 < 50
		A -= 5
	ELSEIF EXP:94 < 100
		A += 5
	ELSEIF EXP:94 < 500
		A += EXP:94 / 15
	ELSE
		A += EXP:94 / 10
	ENDIF

	;桃色の秘薬使用中
	IF TEQUIP:28
		A += 5
	ENDIF

	;判定成功
	IF A >= V
		;この辺の描写は口上との兼ね合いが難しいけど、とりあえず暫定処置
		;口上表示
		TFLAG:600 = 26
		TALENT:153 = 1
