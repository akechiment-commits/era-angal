@COM323
;デート

IF TEQUIP:2 && MONEY > 2000 && TFLAG:44 == 0 && TFLAG:62 == 0
	PRINTL [0] デート終了
	PRINTL [1] 場所を変える($2000を消費)
	PRINTL [100] やっぱりやめる
	$INPUT_LOOP2
	INPUT
	IF RESULT != 100 && (RESULT < 0 || RESULT > 1)
		GOTO INPUT_LOOP2
	ELSEIF RESULT == 1
		FLAG:8 = TEQUIP:2
		PRINT デートの場所を変更します。
		GOTO DATE_LOOP4
	ELSEIF RESULT == 0
		TEQUIP:2 = 0
		TEQUIP:6 = 0
		CALL CHECK_DATE
		PRINTW デートから帰ってきました
		STR:0 = デート終了
		STR:4 = 
		CALL TRAIN_MESSAGE_B
		RETURN 1
	ELSEIF RESULT == 100
		RETURN 0
	ENDIF
ELSEIF TEQUIP:2
	TEQUIP:2 = 0
	TFLAG:62 = 0
	CALL CHECK_DATE
	PRINTW デートから帰ってきました
	STR:0 = デート終了
	STR:4 = 
	CALL TRAIN_MESSAGE_B
	RETURN 1
ELSE
	PRINTL デート($5000を消費)
ENDIF

CALL GET_SUCCESS_RATE
B = 90 + A / 10
SIF B > 99
	B = 99
A = RAND:100
IF A <= 9
	;10％で大成功
	TFLAG:18 = 1
ELSEIF A >= B
	;10～1％で失敗
	TFLAG:18 = -1
ELSE
	;残りは成功
	TFLAG:18 = 0
ENDIF
;TFLAG:17でデートの種類を判別　通常：0　パートナーが勝手に決定：1　パートナーの行きたいデート先：2　パートナーが行きたいデート先以外：3
TFLAG:17 = 0

;-------------------------------------------------
;実行できるかの判定
;-------------------------------------------------
CALL COM_ORDER_COMMON
SIF RESULT == 0
	RETURN 0

$DATE_LOOP4

;強制行き先決定
IF CFLAG:780 && CFLAG:781
	TEQUIP:2 = CFLAG:780
	CFLAG:780 = 0
	SIF TEQUIP:2 == 26
		TEQUIP:6 = CFLAG:781 - 1
	CFLAG:781 = 0
ELSE
	VARSET LOCAL, 0
	;相手が行きたいデート先を決定しLOCALに保存
	CALL PARTNER_SELECT_DATE
	;本体で設定した各キャラ好みのデート先を1/5の確率で出るように
	SIF RAND:5 == 0
		CALL PARTNER_DATE_PLACE
	;好みのデート先を1/5の確率で出るように
	SIF CFLAG:777 && RAND:5 == 0 && FLAG:8 != CFLAG:777
		TEQUIP:2 = CFLAG:777
	CALL PLACE_NAME
	LOCAL = TEQUIP:2
	TEQUIP:2 = 0

	;主導権ポイント計算
	T = TARGET
	CALL GET_INITIATIVE_RATE
	;相手の主導権ポイントが極端に高い＆パートナーに主導権があると、たまにデートの行き先を勝手に決定される
	IF R >= 50
		A = R / 10
		;確率に上限アリ
		SIF A > 15
			A = 15
	ENDIF
	IF A > RAND:100 && TFLAG:45
		;相手が握る
		PRINTFORMW デートに誘うと%CALLNAME:TARGET%の行きたいところに連れて行かれた…
		;大成功
		TFLAG:18 = 1
		TEQUIP:2 = LOCAL
		TFLAG:17 = 1
	ELSE
		IF RAND:10 == 0
			;1/10の確率でパートナーに行きたいデート先あり。選んだデート先が同じ場合ボーナス追加
			;パートナーに主導権あり
			IF TFLAG:45
				PRINTFORMW %CALLNAME:TARGET%は%STR:4%に行きたいようだ…
			ELSE
				PRINTFORMW %CALLNAME:TARGET%は%STR:4%に行きたそうにしている…
			ENDIF
		ELSE
			;パートナーに行きたいデート先がない場合LOCALクリア
			LOCAL = 0
		ENDIF
		CALL GENSOUKYO_DATE
	ENDIF
ENDIF

;何処も選択しなかった場合
IF TEQUIP:2 == 0 || FLAG:8 == 100
	FLAG:8 = 0
	TFLAG:62 = 0
	;パートナーに行きたいデート先がある場合好感度減少
	IF LOCAL
		A = -10 + RAND:10
		CFLAG:2 += A
		PRINTFORML %CALLNAME:TARGET%はデートが中止になり残念そうだ…
		PRINTFORML 好感度上昇:{A}
		SIF ((FLAG:23 & 1p26) == 0) && FLAG:2 != 1
			PRINTFORML 好感度合計:{CFLAG:2}
		WAIT
	ENDIF
	RETURN 0
ENDIF

;パートナーに行きたいデート先があり、パートナーの行きたいデート先だった場合大成功扱い。
;違う場合成功・失敗を再判定し成功もしくは失敗扱い。確率は通常の判定より厳しめ
IF LOCAL
	IF TEQUIP:2 == LOCAL
		;大成功
		TFLAG:18 = 1
		TFLAG:17 = 2
	ELSE
		;成功もしくは失敗
		CALL GET_SUCCESS_RATE
		B = 50 + A / 10
		SIF B > 99
			B = 99
		A = RAND:100
		IF A >= B
			;50～1％で失敗
			TFLAG:18 = -1
		ELSE
			;残りは成功
			TFLAG:18 = 0
		ENDIF
	ENDIF
ENDIF

STR:0 = デート
CALL TRAIN_MESSAGE_B

IF FLAG:8
	;行き先変更場所によっての体力消費
	IF ((FLAG:8 >= 10 && FLAG:8 <= 23) || (FLAG:8 >= 33 && FLAG:8 <= 36)) && (TEQUIP:2 <= 9 || (TEQUIP:2 >= 24 && TEQUIP:2 <= 32) || TEQUIP:2 == 37)
		LOSEBASE:0 += 25
	ELSEIF ((TEQUIP:2 >= 10 && TEQUIP:2 <= 23) || (TEQUIP:2 >= 33 && TEQUIP:2 <= 36)) && (FLAG:8 <= 9 || (FLAG:8 >= 24 && FLAG:8 <= 32) || FLAG:8 == 37)
		LOSEBASE:0 += 25
	ELSE
		LOSEBASE:0 += 15
	ENDIF
	;恋慕or恋人による体力消費軽減（デートとウフフが長続きする、の再現だとでも脳内補完）
	SIF TALENT:85 || TALENT:153
		LOSEBASE:0 -= 7
	GOTO DATE_LOOP1
ENDIF


IF TFLAG:62
	LOSEBASE:1 += 50
ELSE
	LOSEBASE:1 += 220
	;恋慕・恋人・親愛による気力消費軽減（デートが長続きする、の再現だとでも脳内補完）
	SIF TALENT:85
		LOSEBASE:1 -= 40
	SIF TALENT:153
		LOSEBASE:1 -= 50
	SIF TALENT:88
		LOSEBASE:1 -= 90
ENDIF


;固定で獲得するソース
SOURCE:18 = 100
SOURCE:9 = 50

;ABL:従順をみる
IF ABL:0 <= 1
	SOURCE:18 += (ABL:0 * 20)
	SOURCE:9 += (ABL:0 * 10)
ELSEIF ABL:0 <= 3
	SOURCE:18 += 200 + (ABL:0 * 40)
	SOURCE:9 += 100 + (ABL:0 * 15)
ELSEIF ABL:0 <= 5
	SOURCE:18 += 500 + (ABL:0 * 50)
	SOURCE:9 += 200 + (ABL:0 * 20)
ELSEIF ABL:0 <= 8
	SOURCE:18 += 700 + (ABL:0 * 80)
	SOURCE:9 += 300 + (ABL:0 * 30)
ELSEIF ABL:0 <= 11
	SOURCE:18 += 1200 + (ABL:0 * 100)
	SOURCE:9 += 400 + (ABL:0 * 35)
ELSE
	SOURCE:18 += 2000 + (ABL:0 * 130)
	SOURCE:9 += 800 + (ABL:0 * 40)
ENDIF

;好感度をみる
IF CFLAG:2 <= 500
	SOURCE:18 += CFLAG:2
ELSEIF CFLAG:2 <= 5000
	SOURCE:18 += 500 + (CFLAG:2 - 500) / 3
ELSE
	SOURCE:18 += 2000 + (CFLAG:2 - 5000) / 5
ENDIF
SIF SOURCE:18 < 0
	SOURCE:18 = 0

;主導権をチェック
IF TFLAG:45 == 0
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:6 - 1
TFLAG:30 += A
B = 0

IF TFLAG:18 == -1
	TIMES SOURCE:18 , 0.10
	TIMES SOURCE:9 , 0.50
	TIMES SOURCE:20 , 0.50
	TIMES SOURCE:21 , 0.50
	TFLAG:30 -= 10
	TFLAG:37 -= 5
	B = 1
ELSEIF TFLAG:18 == 0
	TIMES SOURCE:18 , 1.00
	TIMES SOURCE:9 , 1.00
	TIMES SOURCE:20 , 1.00
	TIMES SOURCE:21 , 1.00
	TFLAG:37 += 2 + A * 3
	B = 10
ELSE
	TIMES SOURCE:18 , 2.00
	TIMES SOURCE:9 , 2.00
	TIMES SOURCE:20 , 2.00
	TIMES SOURCE:21 , 2.00
	TFLAG:30 += 2
	TFLAG:37 += 5 + A * 4
	B = 25
ENDIF

;恋慕
IF TALENT:85
	TIMES SOURCE:18 , 1.10
	TIMES SOURCE:9 , 1.30
	TIMES SOURCE:20 , 1.10
	TIMES SOURCE:21 , 1.20
ENDIF
;恋人
IF TALENT:153
	TIMES SOURCE:18 , 1.20
	TIMES SOURCE:9 , 1.50
	TIMES SOURCE:20 , 1.20
	TIMES SOURCE:21 , 1.10
ENDIF
;親愛
IF TALENT:88
	TIMES SOURCE:18 , 1.50
	TIMES SOURCE:9 , 2.00
	TIMES SOURCE:20 , 1.50
	TIMES SOURCE:21 , 1.50
ENDIF

PRINTFORML %CALLNAME:TARGET%とデートに出発しました
MONEY -= 5000


IF B > 0
	PRINTFORML %EXPNAME:94%+{B}
	EXP:94 += B
ENDIF

$DATE_LOOP1
SIF FLAG:8
	MONEY -= 2000
FLAG:8 = 0
SIF TEQUIP:2 != 26 && TEQUIP:2 != 50
	TEQUIP:6 = 0
;地の文
PRINTFORM %CALLNAME:PLAYER%達は
IF TFLAG:62 == 1
	PRINT 聖輦船に乗り、
	TFLAG:62 = 0
ENDIF
;地名呼び出し
CALL PLACE_NAME
PRINTS STR:4
;幻想郷内
IF TEQUIP:2 <= 9 || (TEQUIP:2 >= 24 && TEQUIP:2 <= 32) || TEQUIP:2 == 37
	PRINTW へと向かいました
;外界
ELSEIF (TEQUIP:2 >= 10 && TEQUIP:2 <= 17) || (TEQUIP:2 >= 33 && TEQUIP:2 <= 36)
	PRINTW へと行きました
;映画
ELSEIF TEQUIP:2 >= 18 && TEQUIP:2 <= 22
	PRINTW を見ることにしました
;乗り物
ELSEIF TEQUIP:2 == 23 || TEQUIP:2 == 50
	PRINTW に乗ることにしました
ENDIF
;行き先に応じた補正
;神社の場合
IF TEQUIP:2 == 2
	IF MONEY < 1000
		PRINTFORMW そこで%CALLNAME:PLAYER%達はお賽銭を入れようとしましたが、お金が足りませんでした
	ELSE
		PRINTFORML そこで%CALLNAME:PLAYER%達はお賽銭を入れて、神様に色々と願い事をしました
		MONEY -= 1000
		A = RAND:5
		B = RAND:100

		;好感度増減
		IF A <= 1
			;80%で成功
			IF B < 80
				PRINTFORMW ……何だか%CALLNAME:TARGET%と仲良くなれたような気がした
				CFLAG:2 += 30
			ELSE
				PRINTFORMW ……何だか%CALLNAME:TARGET%と仲が悪くなったような気がした
				CFLAG:2 -= 5
			ENDIF
		;ムード増減
		ELSEIF A <= 3
			;80%で成功
			IF B < 80
				PRINTFORMW ……何だかその場のムードが良くなったような気がした
				TFLAG:37 += 35
			ELSE
				PRINTFORMW ……何だかその場のムードが悪くなったような気がした
				TFLAG:37 -= 5
			ENDIF
		;歓楽増減
		ELSE
			;80%で成功
			IF B < 80
				PRINTFORMW ……%CALLNAME:TARGET%はいつもよりこの状況を楽しんでいるようだ
				TIMES SOURCE:18 , 3.00
			ELSE
				PRINTFORMW ……%CALLNAME:TARGET%はいつもよりこの状況が楽しくないようだ
				TIMES SOURCE:18 , 0.70
			ENDIF
		ENDIF
	ENDIF
;霧の湖
ELSEIF TEQUIP:2 == 3
	;素質発覚イベント
	CALL FIND_BUSTSIZE
	;オムツ解除
	TEQUIP:20 = 0
;花畑
ELSEIF TEQUIP:2 == 4
;拡張するのか分からないので目安として一応残す
;	IF RAND:3 == 0
;		PRINTFORMW %CALLNAME:PLAYER%達は花畑へと向かいました
;	ELSEIF RAND:2 == 0
;		PRINTFORMW %CALLNAME:PLAYER%達は太陽の畑へと向かいました
;	ELSE
;		PRINTFORMW %CALLNAME:PLAYER%達は無名の丘へと向かいました
;	ENDIF
;温泉
ELSEIF TEQUIP:2 == 7
	;オムツ解除
	TEQUIP:20 = 0
;海
ELSEIF TEQUIP:2 == 14
	;素質発覚イベント
	CALL FIND_BUSTSIZE
	;オムツ解除
	TEQUIP:20 = 0
;映画館
ELSEIF TEQUIP:2 >= 18 && TEQUIP:2 <= 22
	MONEY -= N
	N = 0
;遊覧船
ELSEIF TEQUIP:2 == 23
	MONEY -= 10000
;スポーツ観戦
ELSEIF TEQUIP:2 == 35
	MONEY -= 5000
ENDIF

RETURN 1

