		SIF TALENT:153 == 0
			RETURN 0
		IF TALENT:85 == 0
			TALENT:85 = 1
			PRINTFORMW %CALLNAME:TARGET%は【恋慕】を得ました
			;堕とした人数＋１
			FLAG:30 += 1

			;堕とした人数が5人以上で、謎の魅力が付く
			IF FLAG:30 >= 5 && TALENT:MASTER:92 == 0
				PRINTFORMW %NAME:MASTER%は【謎の魅力】を身につけた
				TALENT:MASTER:92 = 1
			ENDIF
		ENDIF
		T = TARGET
		CALL GET_LOVERS
		IF TALENT:PLAYER:151
			PRINTFORMW %CALLNAME:PLAYER%は【キス未経験】を失いました
			TALENT:PLAYER:151 = 0
		ENDIF
		IF TALENT:151
			TALENT:151 = 0
			PRINTFORMW %CALLNAME:TARGET%は【キス未経験】を失いました
			TFLAG:38 = 1
		ENDIF
		EXP:96 += 1
		EXP:PLAYER:96 += 1

		;既成事実２に相当
		TFLAG:200 = 2
		
		TFLAG:33 = 0
	ENDIF
