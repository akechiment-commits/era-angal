;============================================================
;  【重要】このゲームの登場人物は全員20歳以上の成人であり、
;          自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE76
;双頭バイブ実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;ウフフ中じゃないと無理
SIF TFLAG:44 == 0
	RETURN 0
;オトコかふたなりだとダメ
SIF TALENT:121 || TALENT:122
	RETURN 0
;調教者がオトコかふたなりだとダメ
SIF TALENT:PLAYER:121 || TALENT:PLAYER:122
	RETURN 0
;バイブを持っているか、アイテムなし設定でないとダメ
SIF ITEM:1 == 0 && NOITEM == 0
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:90
	RETURN 0
;クスコ挿入中はダメ
SIF TEQUIP:61
	RETURN 0
;レズっ気2以上
SIF ABL:9 <= 1
	RETURN 0
RETURN 1

@COM76
;双頭バイブ
PRINTL 双頭バイブ
STR:0 = 双頭バイブ
CALL TRAIN_MESSAGE_B

LOSEBASE:0 += 20
LOSEBASE:1 += 90

SOURCE:9 = 300
SOURCE:12 = 150

;ABL:C感覚をみる
IF ABL:3 == 0
	SOURCE:0 = 300
ELSEIF ABL:3 == 1
	SOURCE:0 = 700
ELSEIF ABL:3 == 2
	SOURCE:0 = 1400
ELSEIF ABL:3 == 3
	SOURCE:0 = 2400
ELSEIF ABL:3 == 4
	SOURCE:0 = 3600
ELSE
	SOURCE:0 = 1800 + (ABL:3 * 400)
ENDIF

;膣内挿入による快V（快Cの60%）
SOURCE:1 = SOURCE:0 * 60 / 100

;[淫具知識]で効果増
IF TALENT:PLAYER:58
	TIMES SOURCE:0 , 1.25
	TIMES SOURCE:1 , 1.25
ENDIF

;C敏感/C鈍感
SIF TALENT:102
	TIMES SOURCE:0 , 1.50
SIF TALENT:101
	TIMES SOURCE:0 , 0.60

;レズ経験
IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTFORML %EXPNAME:40%＋6
	EXP:40 += 6
	EXP:PLAYER:40 += 6
ENDIF

;主導権をチェック
IF TFLAG:45 == 0
	IF ABL:0 <= 1
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	IF ABL:15 == 0
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 5
IF TALENT:152 == 0 && TFLAG:48 == 0
	A -= 7
	SOURCE:15 += 200
ENDIF
TFLAG:30 += A
TFLAG:37 += A / 2

RETURN 1

;双頭バイブ
@TRAIN_MESSAGE_COM76
PRINTFORM %CALLNAME:PLAYER%と%CALLNAME:TARGET%は
IF EXP:0 == 0
	;V未経験
	IF RAND:3 == 0
		PRINTW 双頭バイブの両端をそれぞれの蜜口に押し当て、じりじりと奥へ沈めていった…
		PRINTFORMW 内側を初めて異物に広げられる感触に%CALLNAME:TARGET%の腰がわずかに逃げたが、
		PRINTFORMW それでもバイブはゆっくりと二人を繋いでいった…
	ELSEIF RAND:2 == 0
		PRINTW 双頭バイブの先端を蜜口に宛がい、慎重に押し込んでいった…
		PRINTFORMW %CALLNAME:TARGET%は初めて知る充填感に体を強張らせながら、
		PRINTW それでも腰を引かずバイブが奥へ進むのを受け入れた…
	ELSE
		PRINTW 互いの秘所にバイブを宛てがい、腰を少しずつ寄せ合った…
		PRINTFORMW 柔らかな内壁が知らない感触に締まり、
		PRINTFORMW %CALLNAME:TARGET%の指が%CALLNAME:PLAYER%の体をぎゅっと掴んだ…
	ENDIF
ELSEIF EXP:0 < EXPLV:2
	;V経験少ない
	IF RAND:3 == 0
		PRINTW 双頭バイブを互いの中へゆっくりと押し込んでいった…
		PRINTFORMW まだ慣れない内側がバイブの形を確かめるように締まり、
		PRINTFORMW %CALLNAME:TARGET%の腰が小刻みに揺れた…
	ELSEIF RAND:2 == 0
		PRINTW 双頭バイブを二人の蜜裂へ差し込み、腰をゆっくりと寄せ合った…
		PRINTFORMW %CALLNAME:TARGET%の体は異物の充填感を思い出すように締まり、
		PRINTW 腰から全身へと震えが広がった…
	ELSE
		PRINTW 双頭バイブを互いの秘裂に埋め込み、震える腰をそっと押しつけた…
		PRINTFORMW バイブが奥に達するたびに%CALLNAME:TARGET%の体がびくりと跳ね、
		PRINTW その瞳がうっすらと潤んだ…
	ENDIF
ELSE
	;V経験豊富
	IF RAND:3 == 0
		PRINTW 双頭バイブを互いの中へ一気に埋め込み、腰と腰を打ちつけ合った…
		PRINTFORMW バイブの振動が体の奥まで伝わり、
		PRINTFORMW %CALLNAME:TARGET%の腰がそれを追いかけるようにうねった…
	ELSEIF RAND:2 == 0
		PRINTW 双頭バイブを秘所で咥え込み、腰と腰を密着させてぐりぐりと押しつけ合った…
		PRINTFORMW 振動が二人の腰を繋いだまま広がり、
		PRINTFORMW %CALLNAME:TARGET%の体が快感に抗えずしなやかに揺れた…
	ELSE
		PRINTW 双頭バイブの振動を共有しながら、腰をくねらせて互いの快楽を高め合った…
		PRINTFORMW %CALLNAME:TARGET%の体が震えるたびにその振動が%CALLNAME:PLAYER%にも伝わり、
		PRINTW 二人の息が同じリズムで乱れていった…
	ENDIF
ENDIF
