;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM1


;羞恥プレイ中は
IF TEQUIP:57
JUMP COM87
ENDIF

PRINTL クンニ
STR:0 = クンニ
CALL TRAIN_MESSAGE_B

;クンニ
LOSEBASE:0 += 5
LOSEBASE:1 += 50

SOURCE:10 = 100
SOURCE:12 = 220
SOURCE:14 = 50

;ABL:Ｃ感覚をみる
IF ABL:3 == 0
	SOURCE:0 = 40
ELSEIF ABL:3 == 1
	SOURCE:0 = 160
ELSEIF ABL:3 == 2
	SOURCE:0 = 700
ELSEIF ABL:3 == 3
	SOURCE:0 = 1500
ELSEIF ABL:3 == 4
	SOURCE:0 = 2400
ELSE
	SOURCE:0 = 1050 + (ABL:3 * 450)
ENDIF

;調教者のABL:奉仕精神をみる
IF ABL:PLAYER:6 == 0
	TIMES SOURCE:0 , 0.60
ELSEIF ABL:PLAYER:6 == 1
	TIMES SOURCE:0 , 0.80
ELSEIF ABL:PLAYER:6 == 2
	TIMES SOURCE:0 , 1.00
ELSEIF ABL:PLAYER:6 == 3
	TIMES SOURCE:0 , 1.50
ELSEIF ABL:PLAYER:6 == 4
	TIMES SOURCE:0 , 2.50
ELSE
	SOURCE:0 = SOURCE:0 * (ABL:PLAYER:6 * 75 + 25) / 100
ENDIF

;クスコ装着中は効果変動
IF TEQUIP:61
	TIMES SOURCE:0 , 0.30
	SOURCE:12 += 500
ENDIF

;調教者のTALENT:舌使いをみる
IF TALENT:PLAYER:52
	TIMES SOURCE:0 , 2.00
	SOURCE:16 += SOURCE:0/20
ENDIF

;奴隷のＶ⇔調教者の口の汚れが移動
STAIN:3 |= STAIN:PLAYER:0
STAIN:PLAYER:0 |= STAIN:3

;PALAM:潤滑をみる（C感覚補正・愛液フレーバー）
IF PALAM:3 >= PALAMLV:4
	TIMES SOURCE:0 , 2.00
	SOURCE:10 += 300
	PRINTFORML 溢れる愛液が口を満たし、甘く濃い蜜の味が広がる
ELSEIF PALAM:3 >= PALAMLV:3
	TIMES SOURCE:0 , 1.50
	SOURCE:10 += 150
	PRINTFORML 滴る愛液が舌先に絡みついてくる
ELSEIF PALAM:3 >= PALAMLV:2
	TIMES SOURCE:0 , 1.20
	SOURCE:10 += 50
	PRINTFORML 淡い潤いが口の中に広がる
ELSEIF PALAM:3 >= PALAMLV:1
ELSE
	TIMES SOURCE:0 , 0.60
ENDIF

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTS EXPNAME:40
	PRINTL +3
	EXP:40 += 3
	EXP:PLAYER:40 += 3
ENDIF


;主導権をチェック
IF TFLAG:45 == 0
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 5
;合意がないと好感度が下がる
IF TALENT:152 == 0 && TFLAG:48 == 0
	A -= 7
	SOURCE:15 += 200
ENDIF
TFLAG:30 += A
TFLAG:37 += A / 2

RETURN 1
