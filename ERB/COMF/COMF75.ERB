;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM75
;言葉責め

PRINTL 言葉責め
STR:0 = 言葉責め
CALL TRAIN_MESSAGE_B

;-------------------------------------------------
;ソースの計算
;-------------------------------------------------

;主導権をチェック
IF TFLAG:45 == 0	; 【無[主導権]】
	;主導権が主人公側

	LOSEBASE:0 += 5
	LOSEBASE:1 += 150
	
	SOURCE:12 = 1000
	SOURCE:13 = 1200
	SOURCE:14 = 300
	SOURCE:15 = 100
	

	;PALAM:潤滑
	IF PALAM:3 < PALAMLV:1	; 【[潤滑]<PALAMLV:1】
		SOURCE:12 += 0
	ELSEIF PALAM:3 < PALAMLV:2	; 【[潤滑]<PALAMLV:2】
		SOURCE:12 += 100
	ELSEIF PALAM:3 < PALAMLV:3	; 【[潤滑]<PALAMLV:3】
		SOURCE:12 += 200
	ELSEIF PALAM:3 < PALAMLV:4	; 【[潤滑]<PALAMLV:4】
		SOURCE:12 += 400
	ELSEIF PALAM:3 < PALAMLV:5	; 【[潤滑]<PALAMLV:5】
		SOURCE:12 += 650
	ELSE
		SOURCE:12 += 1000
	ENDIF

	;PALAM:欲情
	IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
		SOURCE:12 += 0
	ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
		SOURCE:12 += 100
	ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
		SOURCE:12 += 200
	ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
		SOURCE:12 += 350
	ELSEIF PALAM:5 < PALAMLV:5	; 【[欲情]<PALAMLV:5】
		SOURCE:12 += 550
	ELSE
		SOURCE:12 += 800
	ENDIF
	
	;ABL:マゾっ気をみる
	IF ABL:8 == 0	; 【[マゾっ気]Lv==0】
		SOURCE:5 = 150
		SOURCE:11 = 0
	ELSEIF ABL:8 == 1	; 【[マゾっ気]Lv==1】
		SOURCE:5 = 300
		SOURCE:11 = 100
	ELSEIF ABL:8 == 2	; 【[マゾっ気]Lv==2】
		SOURCE:5 = 600
		SOURCE:11 = 150
	ELSEIF ABL:8 == 3	; 【[マゾっ気]Lv==3】
		SOURCE:5 = 900
		SOURCE:11 = 250
	ELSEIF ABL:8 == 4	; 【[マゾっ気]Lv==4】
		SOURCE:5 = 1500
		SOURCE:11 = 500
	ELSE
		SOURCE:5 = 700 + (ABL:8 * 300)
		SOURCE:11 = ABL:8 * 200
	ENDIF
	
	;TALENT:反抗的をみる
	IF TALENT:11 == 1	; 【[反抗的]】
		TIMES SOURCE:13 , 1.50
		TIMES SOURCE:15 , 2.50
	ENDIF
	
	;TALENT:気丈をみる
	IF TALENT:12 == 1	; 【[気丈]】
		TIMES SOURCE:13 , 2.50
		TIMES SOURCE:15 , 1.50
	ENDIF
	
	;TALENT:プライド高いをみる
	IF TALENT:15 == 1	; 【[プライド高い]】
		TIMES SOURCE:13 , 2.00
		TIMES SOURCE:15 , 2.00
	ENDIF

	;TALENT:生意気をみる
	IF TALENT:16 == 1	; 【[生意気]】
		TIMES SOURCE:13 , 1.75
		TIMES SOURCE:15 , 1.75
	ENDIF
	
	;TALENT:プライド低いをみる
	IF TALENT:17 == 1	; 【[プライド低い]】
		TIMES SOURCE:13 , 0.75
		TIMES SOURCE:15 , 0.75
	ENDIF
	
	;TALENT:感情乏しいをみる
	IF TALENT:22 == 1	; 【[感情乏しい]】
		TIMES SOURCE:5 , 0.50
		TIMES SOURCE:13 , 0.50
		TIMES SOURCE:14 , 0.50
		TIMES SOURCE:15 , 0.50
	ENDIF


	;バイブ挿入中のとき効果上昇
	IF TEQUIP:11	; 【[バイブ]使用中】
		SOURCE:12 += 200
	ENDIF
	;アナルバイブ挿入中のとき効果上昇
	IF TEQUIP:13	; 【[アナルバイブ]使用中】
		SOURCE:12 += 300
	ENDIF
	;クリキャップ中のとき効果上昇
	IF TEQUIP:14	; 【[クリキャップ]使用中】
		SOURCE:12 += 100
	ENDIF
	;ニプルキャップ中のとき効果上昇
	IF TEQUIP:15	; 【[クリップローター]使用中】
		SOURCE:12 += 100
	ENDIF
	;アイマスク中のとき効果上昇
	IF TEQUIP:43	; 【[アイマスク]使用中】
		SOURCE:12 += 100
	ENDIF
	;縄で緊縛中のとき効果上昇
	IF TEQUIP:44	; 【[縄で緊縛]使用中】
		TIMES SOURCE:13 , 1.50
		SOURCE:12 += 300
	ENDIF
	;ボールギャグ装着中のとき効果上昇
	IF TEQUIP:45	; 【[ボールギャグ]使用中】
		TIMES SOURCE:13 , 1.75
		SOURCE:12 += 300
	ENDIF



	;ABL:サドっ気をみる
	IF ABL:PLAYER:15 == 0	; 【PLAYER:[サドっ気]Lv==0】
		TIMES SOURCE:13 , 1.00
	ELSEIF ABL:PLAYER:15 == 1	; 【PLAYER:[サドっ気]Lv==1】
		TIMES SOURCE:13 , 1.05
	ELSEIF ABL:PLAYER:15 == 2	; 【PLAYER:[サドっ気]Lv==2】
		TIMES SOURCE:13 , 1.10
	ELSEIF ABL:PLAYER:15 == 3	; 【PLAYER:[サドっ気]Lv==3】
		TIMES SOURCE:13 , 1.20
	ELSEIF ABL:PLAYER:15 == 4	; 【PLAYER:[サドっ気]Lv==4】
		TIMES SOURCE:13 , 1.30
	ELSE
		SOURCE:13 = SOURCE:13 * GET_PLAYER_SADO_RATE(ABL:PLAYER:15) / 100
	ENDIF
	

	IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
		PRINTS EXPNAME:40
		PRINTL +3
		EXP:40 += 3
		EXP:PLAYER:40 += 3
	ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1	; 【[オトコ] / PLAYER:[オトコ]】
		PRINTS EXPNAME:41
		PRINTL +1
		EXP:41 += 1
		EXP:PLAYER:41 += 1
	ENDIF

	SIF ASSIPLAY == 0 && ABL:8 >= 2	; 【[マゾっ気]Lv>=2 / 調教者:[主人]】
		TFLAG:30 += 1

ELSE
	;主導権が相手側
	LOSEBASE:0 += 5
	LOSEBASE:1 += 100
	
	SOURCE:14 = 500
	
	;ABL:サドっ気をみる
	IF ABL:15 == 0	; 【[サドっ気]Lv==0】
		SOURCE:20 = 500
		SOURCE:22 = 1500
	ELSEIF ABL:15 == 1	; 【[サドっ気]Lv==1】
		SOURCE:20 = 1000
		SOURCE:22 = 1200
	ELSEIF ABL:15 == 2	; 【[サドっ気]Lv==2】
		SOURCE:20 = 1500
		SOURCE:22 = 800
	ELSEIF ABL:15 == 3	; 【[サドっ気]Lv==3】
		SOURCE:20 = 2000
		SOURCE:22 = 500
	ELSEIF ABL:15 == 4	; 【[サドっ気]Lv==4】
		SOURCE:20 = 2500
		SOURCE:22 = 300
	ELSE
		SOURCE:20 = 1500 + (ABL:15 * 300)
		SOURCE:22 = 350 - (ABL:15 * 50)
		SIF SOURCE:22 < 0
			SOURCE:22 = 0
	ENDIF

	;反発感情が高いほど熱が入る
	IF MARK:3 == 1	; 【[反発感情]Lv==1】
		SOURCE:20 += 500
	ELSEIF MARK:3 == 2	; 【[反発感情]Lv==2】
		SOURCE:20 += 1200
	ELSEIF MARK:3 >= 3	; 【[反発感情]Lv>=3】
		SOURCE:20 += 2500
	ENDIF
	
	;サド持ちは懐疑1/4
	SIF TALENT:83	; 【[サド]】
		TIMES SOURCE:22 , 0.25

	;小悪魔持ちは懐疑1/2
	SIF TALENT:87	; 【[小悪魔]】
		TIMES SOURCE:22 , 0.50
	
	IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
		PRINTS EXPNAME:40
		PRINTL +3
		EXP:40 += 3
		EXP:PLAYER:40 += 3
	ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1	; 【[オトコ] / PLAYER:[オトコ]】
		PRINTS EXPNAME:41
		PRINTL +1
		EXP:41 += 1
		EXP:PLAYER:41 += 1
	ENDIF
	
	SIF ASSIPLAY == 0 && ABL:15 >= 1	; 【[サドっ気]Lv>=1 / 調教者:[主人]】
		TFLAG:30 += 1
ENDIF

RETURN 1
