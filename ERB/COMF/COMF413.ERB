;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE413
;口上独自純愛コマンド実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;プレイヤーのみ（アシスタントプレイ中は使用不可）
SIF ASSIPLAY	; 【調教者:[助手]】
	RETURN 0
;ウフフ中だと無理
SIF TFLAG:44 == 1	; 【[ウフフ中]==1】
	RETURN 0
;CFLAGがたてられてないと無理
SIF !GETBIT(CFLAG:TARGET:独自コマンド使用判定, 8)
	RETURN 0
;恋人のみ（純愛独自コマンドは恋人必須）
SIF TALENT:153 == 0	; 【[恋人]なし】
	RETURN 0
;独自コマンドの1調教あたり使用回数上限チェック（カード収集・レア度で緩和）
CALL GET_MAX_DOKUJI_COM_USES, TARGET
SIF TFLAG:独自コマンド使用済 >= RESULT
	RETURN 0
RESULT = 1
TRYCALLFORM COM_ABLE413_{NO:TARGET}
SIF RESULT == 0
	RETURN 0
;プレイヤーのみ（アシスタントプレイ中は使用不可）
SIF ASSIPLAY	; 【調教者:[助手]】
	RETURN 0
;ファーストキス前はコマンド使用不可（キスしないため）
SIF TALENT:151	; 【[キス未経験]】
	RETURN 0
RETURN 1

@COM413
;この調教での独自コマンド使用回数を加算
TFLAG:独自コマンド使用済 += 1
PRINTSL CSTR:88
STR:0 = %CSTR:88%
;実行判定を使用する場合はこの関数で、真で戻ってくれば判定失敗
TRYCCALLFORM COM_ORDER413_{NO:TARGET}
	IF RESULT == 1
		;口上呼び出し
		TFLAG:13 = 99
		CALL SELF_KOJO
		RETURN 0
	ENDIF
CATCH
ENDCATCH
;地の文を呼ぶ
CALL TRAIN_MESSAGE_B
;デフォルト効果（独自純愛 COM413：癒し）
;体力/気力消費を抑え、情愛・歓楽・受動で癒す。
;キャラ個別で上書きする場合は COM413_<NO> で SOURCE/LOSEBASE を再設定
LOSEBASE:0 += 50	;体力
LOSEBASE:1 += 150	;気力
SOURCE:3 = 4500	;情愛
SOURCE:9 = 2500	;接触
SOURCE:18 = 4500	;歓楽
SOURCE:21 = 3500	;受動
SOURCE:24 = 0	;快Ｍ（非ウフフ固有コマンドのため性感判定なし）
;キス経験を加算
PRINTFORML %EXPNAME:96%＋１
EXP:96 += 1
EXP:PLAYER:96 += 1
;キャラ固有処理（ソース上書き等）
TRYCALLFORM COM413_{NO:TARGET}
;カード収集・高レア所持による固有コマンド威力・ムードボーナス
CALL APPLY_CARD_DOKUJI_BONUS, 1
RETURN 1

;コマンド前の地の文
@TRAIN_MESSAGE_COM413
TRYCALLFORM TRAIN_MESSAGE_B413_{NO:TARGET}

;絶頂時などの地の文
@TRAIN_MESSAGE_A413
TRYCALLFORM TRAIN_MESSAGE_A413_{NO:TARGET}

;コマンド本体後に出てくる地の文
@TEXT413
TRYCALLFORM TEXT413_{NO:TARGET}
