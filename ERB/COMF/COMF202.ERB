PRINTL 乳首合わせ
STR:0 = 乳首合わせ
CALL TRAIN_MESSAGE_B

LOSEBASE:0 += 8
LOSEBASE:1 += 75

SOURCE:4 = 70
SOURCE:8 = 20
SOURCE:9 = 200
SOURCE:12 = 100

;ABL:B感覚をみる（乳首への直接刺激）
IF ABL:14 == 0
	SOURCE:17 = 80
	SOURCE:3 = 30
ELSEIF ABL:14 == 1
	SOURCE:17 = 500
	SOURCE:3 = 80
ELSEIF ABL:14 == 2
	SOURCE:17 = 1500
	SOURCE:3 = 150
ELSEIF ABL:14 == 3
	SOURCE:17 = 3000
	SOURCE:3 = 200
ELSEIF ABL:14 == 4
	SOURCE:17 = 5000
	SOURCE:3 = 240
ELSE
	SOURCE:17 = 2000 + (ABL:14 * 800)
	SOURCE:3 = 200 + (ABL:14 * 10)
ENDIF

;対象の胸サイズによる倍率
IF TALENT:143
	TIMES SOURCE:17 , 2.00
	TIMES SOURCE:3 , 1.80
ELSEIF TALENT:141
	TIMES SOURCE:17 , 1.70
	TIMES SOURCE:3 , 1.50
ELSEIF TALENT:110
	TIMES SOURCE:17 , 1.40
	TIMES SOURCE:3 , 1.20
ENDIF

;調教者の胸サイズ倍率
IF TALENT:PLAYER:143
	TIMES SOURCE:17 , 1.50
ELSEIF TALENT:PLAYER:141
	TIMES SOURCE:17 , 1.30
ELSEIF TALENT:PLAYER:110
	TIMES SOURCE:17 , 1.15
ENDIF

;対象が貧乳は効果減
SIF TALENT:109
	TIMES SOURCE:17 , 0.50

;汚れ交換（胸→胸）
STAIN:5 |= STAIN:PLAYER:5
STAIN:PLAYER:5 |= STAIN:5

;レズ経験
IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTFORML %EXPNAME:40%＋5
	EXP:40 += 5
	EXP:PLAYER:40 += 5
ENDIF

;主導権をチェック
IF TFLAG:45 == 0
	IF ABL:0 <= 1
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	IF ABL:15 == 0
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 8
IF TALENT:152 == 0 && TFLAG:48 == 0
	A -= 7
	SOURCE:15 += 200
ENDIF
TFLAG:30 += A
TFLAG:37 += A

RETURN 1

