@COM51
;媚薬

PRINTL 媚薬
STR:0 = 媚薬
CALL TRAIN_MESSAGE_B

;調合知識があれば消費を抑える
D = 0
IF TALENT:MASTER:55
	D = 1
ELSEIF ASSI >= 0
	SIF TALENT:ASSI:55
		D = 1
ENDIF

IF D
	LOSEBASE:0 += 150
	LOSEBASE:1 += 150
ELSE
	LOSEBASE:0 += 300
	LOSEBASE:1 += 300
ENDIF

SOURCE:14 = 2000
;媚薬効果で欲情のアップが2倍になるので実際には+10000
SOURCE:11 = 5000

;子供体型/小柄は体格比で媚薬がまわりやすい（効果は控えめ＋地の文）
IF TALENT:149
	TIMES SOURCE:11 , 1.20
	TIMES SOURCE:14 , 1.20
	PRINTFORMW 幼く小さな身体には薬のまわりも早く、たちまち目を潤ませて、内股をもじもじと擦り合わせ始めた…
ELSEIF TALENT:100
	TIMES SOURCE:11 , 1.10
	TIMES SOURCE:14 , 1.10
	PRINTFORMW 小柄な身体は薬の巡りが早く、頬を上気させて落ち着かなげに腰をくねらせ始めた…
ENDIF

SIF TEQUIP:90 == 0
	ITEM:26 -= 1

TEQUIP:21 = 1

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTS EXPNAME:40
	PRINTL +1
	EXP:40 += 1
	EXP:PLAYER:40 += 1
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1
	PRINTS EXPNAME:41
	PRINTL +1
	EXP:41 += 1
	EXP:PLAYER:41 += 1
ENDIF

EXP:50 += 1
PRINTFORML %EXPNAME:50%＋１

RETURN 1

