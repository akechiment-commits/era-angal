; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM52
;利尿剤

PRINTL 利尿剤
STR:0 = 利尿剤
CALL TRAIN_MESSAGE_B

;調合知識があれば消費を抑える
D = 0
IF TALENT:MASTER:55	; 【MASTER:[調合知識]】
	D = 1
ELSEIF ASSI >= 0
	SIF TALENT:ASSI:55	; 【ASSI:[調合知識]】
		D = 1
ENDIF

IF D
	LOSEBASE:0 += 50
	LOSEBASE:1 += 50
ELSE
	LOSEBASE:0 += 120
	LOSEBASE:1 += 120
ENDIF

SOURCE:14 = 2000
;利尿剤効果で軽く変動
SOURCE:15 = 150

SIF TEQUIP:90 == 0	; 【無[触手プレイ]】
	ITEM:27 -= 1

TEQUIP:22 = 1

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
	PRINTS EXPNAME:40
	PRINTL +3
	EXP:40 += 3
	EXP:PLAYER:40 += 3
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1	; 【[オトコ] / PLAYER:[オトコ]】
	PRINTS EXPNAME:41
	PRINTL +1
	EXP:41 += 1
	EXP:PLAYER:41 += 1
ENDIF

RETURN 1
