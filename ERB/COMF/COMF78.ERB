;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE78
;母乳飲み実行判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;母乳体質必須
SIF TALENT:130 == 0
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:90
	RETURN 0
;貞操帯があると胸に直接アクセスできない
SIF TEQUIP:44
	RETURN 0
RETURN 1

@COM78
;母乳飲み

PRINTL 母乳飲み
STR:0 = 母乳飲み
CALL TRAIN_MESSAGE_COM78

LOSEBASE:0 += 8
LOSEBASE:1 += 50

;胸快感（ABL:14による）
IF ABL:14 == 0
	SOURCE:17 = 50
ELSEIF ABL:14 == 1
	SOURCE:17 = 350
ELSEIF ABL:14 == 2
	SOURCE:17 = 1000
ELSEIF ABL:14 == 3
	SOURCE:17 = 2000
ELSEIF ABL:14 == 4
	SOURCE:17 = 3200
ELSE
	SOURCE:17 = 1600 + ABL:14 * 500
ENDIF

;接触感
SOURCE:9 = 250

;胸の大きさで補正
IF TALENT:143
	TIMES SOURCE:17 , 2.00
ELSEIF TALENT:141
	TIMES SOURCE:17 , 1.70
ELSEIF TALENT:110
	TIMES SOURCE:17 , 1.30
ELSEIF TALENT:109
	TIMES SOURCE:17 , 0.60
ENDIF

;胸汚れ（母乳）
STAIN:5 |= 16

;噴乳経験加算
EXP:54 += 1

;噴乳フラグ
TFLAG:11 += 1

RETURN

@TRAIN_MESSAGE_COM78
;母乳飲み地の文

IF EXP:54 == 0
	;初めて飲まれる
	IF RAND:3 == 0
		PRINTFORML 「……っ！ そんなとこ……口で……！」
		PRINTFORML %CALLNAME:PLAYER%が乳首に唇を当て、そっと吸い上げると、温かな白濁液がじわりと溢れ出してきた。
		PRINTFORML 「……んっ……飲んでる……飲んでるの……っ」
		PRINTFORML 自分の母乳が%CALLNAME:PLAYER%に直接飲まれているという事実に、%CALLNAME:TARGET%は言いようのない羞恥と昂りを覚えた。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%が%CALLNAME:TARGET%の乳首に口を寄せ、ゆっくりと吸い始めると、先端からとろりとした液体が滲み出してきた。
		PRINTFORML 「……やだ、そんな……飲まないで……」
		PRINTFORML 恥ずかしさで顔を背けながらも、%CALLNAME:TARGET%の体はぴくぴくと反応していた。温かな吸引の感覚が、胸の奥まで響いてくる。
	ELSE
		PRINTFORML 乳首にそっと唇を重ね、じっくりと吸い上げると、とろりとした白い液体が口内に広がった。
		PRINTFORML 「……あ……んぁ……なんか……変な感じ……」
		PRINTFORML 初めて母乳を直接飲まれる経験に、%CALLNAME:TARGET%は戸惑いながらも、胸の奥から広がる不思議な充足感に身を任せていた。
	ENDIF
ELSEIF EXP:54 < EXPLV:2
	;少ない経験
	IF RAND:3 == 0
		PRINTFORML 「……ん……また飲んでる……」
		PRINTFORML %CALLNAME:PLAYER%が乳首に唇を当てて吸い始めると、すぐに白濁した液体が溢れ出してきた。%CALLNAME:TARGET%の体が、吸われるたびにびくりと震える。
		PRINTFORML 温かな口腔が母乳を飲み下すたびに、胸の奥から甘い疼きが広がっていった。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%の唇が乳首を優しく包み込む。ゆっくりと吸われると、とろりとした母乳がすぐに溢れ出してきた。
		PRINTFORML 「……ふぁ……そんなに吸わないで……もれちゃう……」
		PRINTFORML 羞恥に染まりながらも、%CALLNAME:TARGET%はその心地よい感覚に抗えずにいた。
	ELSE
		PRINTFORML 「……んっ……お乳、飲んでるの……？」
		PRINTFORML 吸われるたびに白濁液が溢れ出し、%CALLNAME:PLAYER%の口の中に流れ込んでいく。%CALLNAME:TARGET%の頬は羞恥に染まりながらも、その目はうっすらとろりと潤んでいた。
	ENDIF
ELSE
	;豊富な経験
	IF RAND:3 == 0
		PRINTFORML 「……ん……もっと、飲んで……」
		PRINTFORML %CALLNAME:TARGET%が自ら胸を%CALLNAME:PLAYER%に押しつける。唇が乳首を包んで吸い上げると、すぐにとろりとした母乳が口内へと溢れ出した。
		PRINTFORML 「……はぁ……気持ちいい……全部飲んで……」
		PRINTFORML 吸われるたびに甘い疼きが胸に広がり、%CALLNAME:TARGET%は恍惚とした表情でその感覚に身を委ねた。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%が乳首に唇を当てると、待ちわびていたかのようにとろとろと白濁液が溢れ出してきた。
		PRINTFORML 「……んぁ……吸って……いっぱい飲んで……」
		PRINTFORML 飲まれる感覚にすっかり慣れた%CALLNAME:TARGET%は、羞恥よりも快感が上回り、うっとりとした声で%CALLNAME:PLAYER%をせがんだ。
	ELSE
		PRINTFORML 乳首に唇が触れた瞬間、もうとろとろと母乳が溢れ出す。すっかり飲まれることを学習した体は、吸われるたびに甘い充足感を訴えてくる。
		PRINTFORML 「……ふぁ……全部、飲んでくれるよね……？」
		PRINTFORML %CALLNAME:TARGET%は熱っぽい視線で%CALLNAME:PLAYER%を見上げながら、白濁液が流れ込んでいく温かな感触に、ひっそりと溜め息をついた。
	ENDIF
ENDIF
RETURN
