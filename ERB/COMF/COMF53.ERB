;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM53
;ビデオカメラ
STR:0 = ビデオカメラ

;カウントは10回とします
K = 10

IF TEQUIP:53	; 【[撮影中]使用中】
;ビデオ撮影がされていれば終了させる
;テープは終了時に数を減らす
	TEQUIP:53 = 0
	ITEM:28 -= 1
	PRINTW ★★★ビデオ撮影を終了します★★★
ELSE
;ビデオ撮影してなければ初期化して開始
;TODO 起動条件を作成する
	TEQUIP:53 = 1
	TFLAG:70 = 0
	REPEAT K
		S = COUNT + 11
		FLAG:S = 0
	REND

	IF ASSI > 0
		PRINTL 撮影者を選択してください。途中変更はできません
		PRINTL （撮影者を変更する場合、一度撮影を終了してください）
		PRINTL 
		PRINTFORML [0] %CALLNAME:MASTER%
		PRINTFORML [1] %CALLNAME:ASSI%
		PRINTFORML 
	
		$INPUT_LOOP
		INPUT
	
		IF RESULT == 0
			FLAG:22 = 1
			PRINTFORML 撮影者は %CALLNAME:MASTER% です
		ELSEIF RESULT == 1
			FLAG:22 = 2
			PRINTFORML 撮影者は %CALLNAME:ASSI% です
		ELSE
			GOTO INPUT_LOOP
		ENDIF
	ELSE
		FLAG:22 = 0
	ENDIF

	PRINTW ★★★ビデオ撮影を開始します★★★
ENDIF

RETURN 1


@EQUIP_COM53
;ビデオ撮影中
;カウントを10とします
K = 10

IF TFLAG:70 == 0	; 【無[ビデオ撮影カウンタ]】
;初回はカウントに入らない
	TFLAG:70 = 1

	EXP:50 += 1
	PRINTL 異常経験＋１
ELSEIF TFLAG:70 > 0 && TFLAG:70 <= K	; 【[ビデオ撮影カウンタ]>0 / [ビデオ撮影カウンタ]<=K】
	S = TFLAG:70 + 10
	IF TFLAG:90 >= 1	; 【[ビデオ撮影中の自慰の内容フラグ]>=1】
		FLAG:S = TFLAG:90
		TFLAG:90 = 0
	ELSE
		FLAG:S = SELECTCOM
	ENDIF
	;TODO 助白や助手による調教の記録はどうするか？
	PRINTFORML ビデオ撮影中{TFLAG:70}/{K}回

	;パラメータ変化
	;TODO バランス(ビデオによるパラメータ変化は考えない？)
	LOSEBASE:0 += 0
	LOSEBASE:1 += 50

	A = 370
	B = 1750
	C = 700

	;PALAM:欲情を見る
	IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
		TIMES A , 0.80
	ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
		TIMES A , 0.90
	ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
		TIMES A , 1.00
	ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
		TIMES A , 1.10
	ELSEIF PALAM:5 >= PALAMLV:4	; 【[欲情]>=PALAMLV:4】
		TIMES A , 1.20
	ENDIF

	;ABL:従順を見る
	IF ABL:0 == 0	; 【[親密]Lv==0】
		TIMES A , 0.40
	ELSEIF ABL:0 == 1	; 【[親密]Lv==1】
		TIMES A , 0.60
	ELSEIF ABL:0 == 2	; 【[親密]Lv==2】
		TIMES A , 0.80
	ELSEIF ABL:0 == 3	; 【[親密]Lv==3】
		TIMES A , 1.00
	ELSEIF ABL:0 == 4	; 【[親密]Lv==4】
		TIMES A , 1.10
	ELSE
		A = A * (ABL:0 * 5 + 95) / 100
	ENDIF

	;ABL:露出癖を見る
	IF ABL:7 == 0	; 【[露出癖]Lv==0】
		TIMES A , 0.80
		TIMES C , 2.00
	ELSEIF ABL:7 == 1	; 【[露出癖]Lv==1】
		TIMES A , 1.00
		TIMES C , 1.70
	ELSEIF ABL:7 == 2	; 【[露出癖]Lv==2】
		TIMES A , 1.30
		TIMES C , 1.40
	ELSEIF ABL:7 == 3	; 【[露出癖]Lv==3】
		TIMES A , 1.60
		TIMES C , 1.00
	ELSEIF ABL:7 == 4	; 【[露出癖]Lv==4】
		TIMES A , 2.00
		TIMES C , 0.80
	ELSE
		A = A * (ABL:7 * 50 + 50) / 100
		IF ABL:7 <= 10	; 【[露出癖]Lv<=10】
			C = C * (110 - ABL:7 * 10) / 100
		ELSE
			TIMES C , 0.10
		ENDIF
	ENDIF

	;倒錯的
	SIF TALENT:80	; 【[倒錯的]】
		TIMES A , 2.00
	;目立ちたがり
	SIF TALENT:28	; 【[目立ちたがり]】
		TIMES A , 1.50
	;臆病
	SIF TALENT:10	; 【[臆病]】
		TIMES C , 1.70


	SOURCE:10 += A
	SOURCE:12 += B
	SOURCE:14 += C

	UP:5 += A
	UP:10 += SOURCE:14

	EXP:50 += 1
	PRINTL 異常経験＋１

	;10回目に達した場合は自動終了
	IF TFLAG:70 >= K	; 【[ビデオ撮影カウンタ]>=K】
		TEQUIP:53 = 0
		ITEM:28 -= 1
		PRINTW テープの残量がなくなりました。ビデオ撮影を終了します
	ELSE
		TFLAG:70 += 1
	ENDIF
ENDIF

SIF ASSIPLAY == 0 && ABL:7 >= 3	; 【[露出癖]Lv>=3 / 調教者:[主人]】
	TFLAG:30 += 1

RETURN 1
