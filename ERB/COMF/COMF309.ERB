@REFERENCE_BOOK
;参考書を読む。条件を満たせばレシピを取得

DRAWLINE
PRINTFORML どの参考書を読みますか？
PRINTL 
REPEAT 10
	;T:COUNTの初期化（INPUT時の判断に使用）
	T:COUNT = 0

	;レシピの断片はCONTINUE
	SIF COUNT == 0
		CONTINUE

	IF ITEM:(COUNT + 800)
		;絵で見る錬金術～高等錬金術講座には章が設定されており、条件(調合経験)を満たした章まで読める
		IF COUNT <= 4
			;各参考書の条件をLOCAL～で設定。第１章は入手時の条件があるのでこちらでは設定しなくてOK
			;絵で見る錬金術
			IF COUNT == 1
				LOCAL:1 = 0
				LOCAL:2 = 50
				LOCAL:3 = 100
				LOCAL:4 = 150
				LOCAL:5 = 200
			;初等錬金術講座
			ELSEIF COUNT == 2
