				LOCAL:5 = 1400
			ENDIF
			;読めなくても表示はされる。表示される場合T:COUNT = 1
			PRINTFORM [{COUNT, 3}] %ITEMNAME:(COUNT + 800)%
			T:COUNT = 1
			;第５章まで読み終わってる場合第○章は表示されない
			IF ITEM:(COUNT + 800) <= 5
				PRINTFORM  第{ITEM:(COUNT + 800)}章 
