;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM82
;アナルフィスト
PRINTL アナルフィスト
STR:0 = アナルフィスト

;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:0 += 600
LOSEBASE:1 += 300

SOURCE:6 = 1200
SOURCE:12 = 1200
SOURCE:13 = 1200
SOURCE:14 = 1200
SOURCE:16 = 1200

;ABL:Ａ感覚をみる
IF ABL:5 == 0	; 【[Ａ感覚]Lv==0】
	SOURCE:2 = 10
	SOURCE:3 = 10
	SOURCE:13 = 100
ELSEIF ABL:5 == 1	; 【[Ａ感覚]Lv==1】
	SOURCE:2 = 30
	SOURCE:3 = 30
	SOURCE:13 = 700
ELSEIF ABL:5 == 2	; 【[Ａ感覚]Lv==2】
	SOURCE:2 = 500
	SOURCE:3 = 100
	SOURCE:13 = 1500
ELSEIF ABL:5 == 3	; 【[Ａ感覚]Lv==3】
	SOURCE:2 = 1000
	SOURCE:3 = 200
	SOURCE:13 = 3000
ELSEIF ABL:5 == 4	; 【[Ａ感覚]Lv==4】
	SOURCE:2 = 1700
	SOURCE:3 = 450
	SOURCE:13 = 5000
ELSE
	SOURCE:2 = 950 + (ABL:5 * 250)
	SOURCE:3 = ABL:5 * 150
	SOURCE:13 = 500 + (ABL:5 * 1500)
ENDIF

;ABL:サドっ気をみる
IF ABL:PLAYER:15 == 0	; 【PLAYER:[サドっ気]Lv==0】
	TIMES SOURCE:6 , 1.00
ELSEIF ABL:PLAYER:15 == 1	; 【PLAYER:[サドっ気]Lv==1】
	TIMES SOURCE:6 , 1.05
ELSEIF ABL:PLAYER:15 == 2	; 【PLAYER:[サドっ気]Lv==2】
	TIMES SOURCE:6 , 1.10
ELSEIF ABL:PLAYER:15 == 3	; 【PLAYER:[サドっ気]Lv==3】
	TIMES SOURCE:6 , 1.20
ELSEIF ABL:PLAYER:15 == 4	; 【PLAYER:[サドっ気]Lv==4】
	TIMES SOURCE:6 , 1.30
ELSE
	SOURCE:6 = SOURCE:6 * GET_PLAYER_SADO_RATE(ABL:PLAYER:15) / 100
ENDIF

;EXP:Ａ経験をみる
IF EXP:1 < EXPLV:1	; 【[Ａ経験]<EXPLV:1】
	TIMES SOURCE:2 , 0.10
	SOURCE:6 = 20000
ELSEIF EXP:1 < EXPLV:2	; 【[Ａ経験]<EXPLV:2】
	TIMES SOURCE:2 , 0.30
	SOURCE:6 = 12000
ELSEIF EXP:1 < EXPLV:3	; 【[Ａ経験]<EXPLV:3】
	TIMES SOURCE:2 , 0.50
	SOURCE:6 = 5000
ELSEIF EXP:1 < EXPLV:4	; 【[Ａ経験]<EXPLV:4】
	TIMES SOURCE:2 , 1.00
	SOURCE:6 = 1800
ELSEIF EXP:1 < EXPLV:5	; 【[Ａ経験]<EXPLV:5】
	TIMES SOURCE:2 , 1.40
	SOURCE:6 = 1000
ELSE
	TIMES SOURCE:2 , 1.60
	SOURCE:6 = 600
ENDIF

;PALAM:潤滑をみる
IF PALAM:3 < PALAMLV:1	; 【[潤滑]<PALAMLV:1】
	TIMES SOURCE:2 , 0.40
	SOURCE:6 += 10000
ELSEIF PALAM:3 < PALAMLV:2	; 【[潤滑]<PALAMLV:2】
	TIMES SOURCE:2 , 0.80
	SOURCE:6 += 3600
ELSEIF PALAM:3 < PALAMLV:3	; 【[潤滑]<PALAMLV:3】
	TIMES SOURCE:2 , 1.00
	SOURCE:6 += 1200
ELSEIF PALAM:3 < PALAMLV:4	; 【[潤滑]<PALAMLV:4】
	TIMES SOURCE:2 , 1.40
	SOURCE:6 += 200
ELSEIF PALAM:3 >= PALAMLV:4	; 【[潤滑]>=PALAMLV:4】
	TIMES SOURCE:2 , 1.80
	SOURCE:6 += 100
ENDIF

;PALAM:欲情をみる
IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
	TIMES SOURCE:2 , 0.60
	TIMES SOURCE:13 , 0.60
ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
	TIMES SOURCE:2 , 0.80
	TIMES SOURCE:13 , 0.80
ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
	TIMES SOURCE:2 , 1.00
	TIMES SOURCE:13 , 1.00
ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
	TIMES SOURCE:2 , 1.20
	TIMES SOURCE:13 , 1.20
ELSEIF PALAM:5 >= PALAMLV:4	; 【[欲情]>=PALAMLV:4】
	TIMES SOURCE:2 , 1.40
	TIMES SOURCE:13 , 1.40
ENDIF

;小柄体形
SIF TALENT:100 || TALENT:149	; 【[小柄体型] / [子供体型]】
	TIMES SOURCE:6 , 2.00
;子供体型は痛みが上位（さらに上乗せ）
SIF TALENT:149	; 【[子供体型]】
	TIMES SOURCE:6 , 1.50

;Ａ敏感、鈍感をみる
;快Ａ自体のチェックは後でまとめてやる
IF TALENT:105	; 【[Ａ鈍感]】
	TIMES SOURCE:6 , 1.50
	TIMES SOURCE:13 , 1.50
	TIMES SOURCE:14 , 1.50
ELSEIF TALENT:106	; 【[Ａ敏感]】
	TIMES SOURCE:6 , 0.60
	TIMES SOURCE:13 , 0.60
	TIMES SOURCE:14 , 0.60
ENDIF

;処女で貞操観念
IF EXP:0 == 0 && TALENT:30	; 【[貞操観念] / [Ｖ経験]==0】
	SOURCE:13 /= 3
ENDIF


EXP:1 += 25
PRINTL Ａ経験＋２５

CALL EVENTKAKUTYOU_A


IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTS EXPNAME:40
	PRINTL +4
	EXP:40 += 4
	EXP:PLAYER:40 += 4
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1
	PRINTS EXPNAME:41
	PRINTL +2
	EXP:41 += 2
	EXP:PLAYER:41 += 2
ENDIF

RETURN 1

