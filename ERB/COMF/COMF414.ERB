;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE414
;口上独自純愛コマンド実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;プレイヤーのみ（アシスタントプレイ中は使用不可）
SIF ASSIPLAY
	RETURN 0
;ウフフ中だと無理
SIF TFLAG:44 == 1
	RETURN 0
;CFLAGがたてられてないと無理
SIF !GETBIT(CFLAG:TARGET:独自コマンド使用判定, 9)
	RETURN 0
;恋人のみ（純愛独自コマンドは恋人必須）
SIF TALENT:153 == 0
	RETURN 0
;独自コマンドは1回の調教につきいずれか1つだけ
SIF TFLAG:独自コマンド使用済
	RETURN 0
RESULT = 1
TRYCALLFORM COM_ABLE414_{NO:TARGET}
SIF RESULT == 0
	RETURN 0
;プレイヤーのみ（アシスタントプレイ中は使用不可）
SIF ASSIPLAY
	RETURN 0
;ファーストキス前はコマンド使用不可（キスしないため）
SIF TALENT:151
	RETURN 0
RETURN 1

@COM414
;この調教で独自コマンドを使用済みにする（1調教1回限り）
TFLAG:独自コマンド使用済 = 1
PRINTSL CSTR:89
STR:0 = %CSTR:89%
;実行判定を使用する場合はこの関数で、真で戻ってくれば判定失敗
TRYCCALLFORM COM_ORDER414_{NO:TARGET}
	IF RESULT == 1
		;口上呼び出し
		TFLAG:13 = 99
		CALL SELF_KOJO
		RETURN 0
	ENDIF
CATCH
ENDCATCH
;地の文を呼ぶ
CALL TRAIN_MESSAGE_B
;デフォルト効果（独自純愛 COM414：ディープキス）
;快M最大。キス経験+2。
;キャラ個別で上書きする場合は COM414_<NO> で SOURCE/LOSEBASE を再設定
LOSEBASE:0 += 130	;体力
LOSEBASE:1 += 320	;気力
SOURCE:3 = 3500	;情愛
SOURCE:9 = 3500	;接触
SOURCE:18 = 3000	;歓楽
SOURCE:21 = 2000	;受動
SOURCE:24 = 5500	;快Ｍ
;キス経験を加算（ディープキス）
PRINTFORML %EXPNAME:96%＋２
EXP:96 += 2
EXP:PLAYER:96 += 2
;キャラ固有処理（ソース上書き等）
TRYCALLFORM COM414_{NO:TARGET}
RETURN 1

;コマンド前の地の文
@TRAIN_MESSAGE_COM414
TRYCALLFORM TRAIN_MESSAGE_B414_{NO:TARGET}

;絶頂時などの地の文
@TRAIN_MESSAGE_A414
TRYCALLFORM TRAIN_MESSAGE_A414_{NO:TARGET}

;コマンド本体後に出てくる地の文
@TEXT414
TRYCALLFORM TEXT414_{NO:TARGET}
