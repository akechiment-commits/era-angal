;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE322
;廃止済み。旧セーブ・旧参照との互換性維持のため関数本体は残す。
RETURN 0


@COM322
;ストリートライブ
;劣化公開野外ライブ。
PRINTL ストリートライブ
;-------------------------------------------------
;成功できるかの判定
;歌唱技能・ライブ経験・舞台向きの性格で決まる
;欲望・露出癖・欲情・性的な刻印はライブの成否には使わない
;-------------------------------------------------
A = 0
S = 0

;ABL:歌唱技能
IF ABL:92
	IF ABL:92 <= 5
		A += ABL:92 * 5
	ELSEIF ABL:92 <= 10
		A += 30 + ABL:92 / 3
	ELSEIF ABL:92 <= 20
		A += 40 + ABL:92 / 6
	ELSE
		A += 50 + ABL:92 / 9
	ENDIF
ENDIF

;歌唱経験
A += MIN(EXP:93 / 5, 20)

;舞台での振る舞いに関係する性格・素質
SIF TALENT:10
	A -= 5
SIF TALENT:23
	A += 2
SIF TALENT:28
	A += 5
SIF TALENT:91
	A += 3
SIF TALENT:92
	A += 5
SIF TALENT:118
	A += 5
SIF TALENT:126
	A += 5

;目標難易度を設定（成功：11～51　大成功：更に+40）
V = 11 + RAND:41

;初期化(必要無い筈だけど、念のため初期化)
TFLAG:17 = 0

;成功、失敗
IF A < V
	;失敗
	TFLAG:18 = -1
	CALL STREET_LIVE_FAIL
ELSEIF A > V + 40
	;大成功
	TFLAG:18 = 1
	CALL STREET_LIVE_SUCCESS
ELSE
	;成功
	TFLAG:18 = 0
	CALL STREET_LIVE_SUCCESS
ENDIF
TFLAG:79 = 1
RETURN 1

@STREET_LIVE_SUCCESS
;-------------------------------------------------
;実行決定
;-------------------------------------------------
STR:0 = ストリートライブ

;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:0 += 100
LOSEBASE:1 += 400

A = 500
B = 600
C = 0

;PALAM:欲情をみる
IF PALAM:5 < PALAMLV:1
	TIMES A , 0.80
	C += 0
ELSEIF PALAM:5 < PALAMLV:2
	TIMES A , 0.90
	C += 1
ELSEIF PALAM:5 < PALAMLV:3
	TIMES A , 1.00
	C += 2
ELSEIF PALAM:5 < PALAMLV:4
	TIMES A , 1.10
	C += 4
ELSEIF PALAM:5 >= PALAMLV:4
	TIMES A , 1.20
	C += 8
ENDIF
;ABL:露出癖をみる
IF ABL:7 == 0
	SOURCE:21 += 0
	C += 0
	TIMES A, 1.00
ELSEIF ABL:7 == 1
	SOURCE:21 += 50
	C += 1
	TIMES A, 1.20
ELSEIF ABL:7 == 2
	SOURCE:21 += 100
	C += 2
	TIMES A, 1.40
ELSEIF ABL:7 == 3
	SOURCE:21 += 200
	C += 3
	TIMES A, 1.60
ELSEIF ABL:7 == 4
	SOURCE:21 += 400
	C += 4
	TIMES A, 2.00
ELSE
	SOURCE:21 += 800
	C += 5
	TIMES A, 3.00
ENDIF
;ABL:歌唱技能をみる
IF ABL:92 == 0
	C += 0
	TIMES A , 0.80
ELSEIF ABL:92 == 1
	C += 1
	TIMES A , 1.00
ELSEIF ABL:92 == 2
	C += 2
	TIMES A , 1.30
ELSEIF ABL:92 == 3
	C += 3
	TIMES A , 1.60
ELSEIF ABL:92 == 4
	C += 4
	TIMES A , 2.00
ELSE
	C += 5
	TIMES A , 3.00
ENDIF

;目立ちたがり
IF TALENT:28
	TIMES A , 1.50
	C += 10
ENDIF
;解放
IF TALENT:33
	TIMES A , 1.50
	C += 5
ENDIF
;臆病
IF TALENT:10
	TIMES B , 2.00
	C -= 10
ENDIF
;恥じらい
IF TALENT:35
	TIMES B , 2.00
	C -= 7
ENDIF
;恥じ薄い
IF TALENT:36
	TIMES B , 0.80
	C += 7
ENDIF

;魅惑
SIF TALENT:91
	C += 10
;謎の魅力
SIF TALENT:92
	C += 25
;魅力
SIF TALENT:113
	C += 20
;鼓舞
SIF TALENT:118
	C += 50
;人気
SIF TALENT:126
	C += 30

;大成功補正
IF TFLAG:18
	A *= 2
	B *= 2
ENDIF

SOURCE:12 += A/8
SOURCE:18 += A/4
SOURCE:23 += B/2

UP:7 += A/6
UP:8 += A/9

C /= 1 + RAND:3
IF RAND:3 != 0
	C += RAND:21
ELSE
	C -= RAND:21
	SIF C < 0
		C = 0
ENDIF
;お捻りが貰える際は、フラグを立てておく
SIF C > 60
	TFLAG:17 = 1

CALL TRAIN_MESSAGE_B

IF C > 60
	T = 1 + EXP:93
	T = (ABL:92 * 90) + (ABL:92 * RAND:20) + (RAND:T * 10)
	;クリア前はリミットを加える
	IF (FLAG:28 & 1) != 0
		SIF T >= 20000
			T = 20000
	ENDIF
;	T = 1 + RAND:3
	MONEY += T
	PRINTFORML 所持金 ${T}増加
	WAIT
	SOURCE:5 += 1500
	SOURCE:20 += 3000
	T = 3 + RAND:4
	;大成功補正
	IF TFLAG:18
		SOURCE:5 += 1500
		SOURCE:20 += 3000
		T += 3 + RAND:4
	ENDIF
ELSE
	SOURCE:5 += 500
	T = 3 + RAND:4
	;大成功補正
	IF TFLAG:18
		SOURCE:5 += 500
		T += 3 + RAND:4
	ENDIF
ENDIF
PRINTFORML %EXPNAME:93%+{T}
EXP:93 += T

RETURN 1

