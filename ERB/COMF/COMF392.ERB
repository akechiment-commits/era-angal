@TRAIN_MESSAGE_COM392
IF TEQUIP:90	; 【[触手プレイ]使用中】
	IF TEQUIP:44	; 【[縄で緊縛]使用中】
		PRINTFORML %CALLNAME:TARGET%を緊縛している触手はグニャリと体をひねり
