;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE258
;助手顔面騎乗実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;マスターが調教者のときのみ（マスターの顔に助手が跨がる）
SIF ASSIPLAY
	RETURN 0
;ウフフ中じゃないと無理
SIF TFLAG:44 == 0
	RETURN 0
;前回コマンドが騎乗位でないとダメ
SIF PREVCOM != 34 && PREVCOM != 258
	RETURN 0
;助手がいないとダメ
SIF ASSI < 0
	RETURN 0
;調教対象がオトコだとダメ
SIF TALENT:122
	RETURN 0
;助手がオトコだとダメ
SIF TALENT:ASSI:122
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:90
	RETURN 0
RETURN 1

@COM258
;助手顔面騎乗
;騎乗位挿入を維持したまま助手がプレイヤーの顔面に跨がりクンニさせる

PRINTL 助手顔面騎乗
STR:0 = 助手顔面騎乗

SELECTCOM = 258
CALL TRAIN_MESSAGE_B

;V経験を伴うコマンドのフラグ(処女膜再生対応)
TFLAG:19 = 1
SIF TALENT:85 && EXP:0 == 0
	TFLAG:20 = 1

;射精ゲージチェック
SIF TALENT:PLAYER:121 || TALENT:PLAYER:122
	BASE:PLAYER:2 += CALC_EJAC(SELECTCOM, PLAYER)

;ソースの計算
;騎乗位継続効果（TARGET向け）+ 顔面騎乗のレズ/興奮要素
LOSEBASE:0 += 50
LOSEBASE:1 += 120

SOURCE:12 = 700

;奉仕精神（TARGETが騎乗位で奉仕しながら助手と向き合う羞恥/興奮）
IF ABL:6 == 0
	SOURCE:4 = 150
	SOURCE:5 = 80
ELSEIF ABL:6 == 1
	SOURCE:4 = 200
	SOURCE:5 = 250
ELSEIF ABL:6 == 2
	SOURCE:4 = 280
	SOURCE:5 = 600
ELSEIF ABL:6 == 3
	SOURCE:4 = 370
	SOURCE:5 = 1000
ELSEIF ABL:6 == 4
	SOURCE:4 = 500
	SOURCE:5 = 1600
ELSE
	SOURCE:4 = 310 + (ABL:6 * 60)
	SOURCE:5 = 480 + (ABL:6 * 350)
ENDIF

;Ｖ感覚
IF ABL:4 == 0
	SOURCE:1 = 15
	SOURCE:3 = 20
ELSEIF ABL:4 == 1
	SOURCE:1 = 55
	SOURCE:3 = 55
ELSEIF ABL:4 == 2
	SOURCE:1 = 150
	SOURCE:3 = 95
ELSEIF ABL:4 == 3
	SOURCE:1 = 370
	SOURCE:3 = 130
ELSEIF ABL:4 == 4
	SOURCE:1 = 640
	SOURCE:3 = 225
ELSE
	SOURCE:1 = 340 + (ABL:4 * 95)
	SOURCE:3 = 95 + (ABL:4 * 45)
ENDIF

;Ｖ経験
IF EXP:0 < EXPLV:1
	TIMES SOURCE:1 , 0.20
	SOURCE:6 = 4500
	SOURCE:12 = 10000
ELSEIF EXP:0 < EXPLV:2
	TIMES SOURCE:1 , 0.60
	SOURCE:6 = 200
ELSEIF EXP:0 < EXPLV:3
	TIMES SOURCE:1 , 1.00
	SOURCE:6 = 25
ELSEIF EXP:0 < EXPLV:4
	TIMES SOURCE:1 , 1.20
ELSEIF EXP:0 < EXPLV:5
	TIMES SOURCE:1 , 1.35
ELSE
	TIMES SOURCE:1 , 1.50
ENDIF

;潤滑
IF PALAM:3 < PALAMLV:1
	TIMES SOURCE:1 , 0.20
	SOURCE:6 += 900
	TIMES SOURCE:6 , 3.00
ELSEIF PALAM:3 < PALAMLV:2
	TIMES SOURCE:1 , 0.40
	SOURCE:6 += 300
ELSEIF PALAM:3 < PALAMLV:3
	TIMES SOURCE:1 , 1.00
ELSEIF PALAM:3 < PALAMLV:4
	TIMES SOURCE:1 , 1.40
ELSE
	TIMES SOURCE:1 , 1.80
ENDIF

;欲情
IF PALAM:5 < PALAMLV:1
	TIMES SOURCE:1 , 0.60
	TIMES SOURCE:4 , 0.50
ELSEIF PALAM:5 < PALAMLV:2
	TIMES SOURCE:1 , 0.80
ELSEIF PALAM:5 < PALAMLV:3
	TIMES SOURCE:1 , 1.00
ELSEIF PALAM:5 < PALAMLV:4
	TIMES SOURCE:1 , 1.20
ELSE
	TIMES SOURCE:1 , 1.50
ENDIF

;従順
IF ABL:0 == 0
	TIMES SOURCE:1 , 0.50
	TIMES SOURCE:4 , 0.60
	TIMES SOURCE:15 , 2.00
ELSEIF ABL:0 == 1
	TIMES SOURCE:1 , 0.80
ELSEIF ABL:0 == 2
	TIMES SOURCE:1 , 1.00
ELSEIF ABL:0 == 3
	TIMES SOURCE:1 , 1.20
ELSEIF ABL:0 == 4
	TIMES SOURCE:1 , 1.40
ELSE
	SOURCE:1 = SOURCE:1 * (ABL:0 * 10 + 110) / 100
	SOURCE:4 = SOURCE:4 * (ABL:0 * 10 + 110) / 100
ENDIF

;好感度ランダム変化
A = RAND:10 + 6
SIF TALENT:85 || TALENT:153
	A += 5
IF TALENT:152 == 0 && TFLAG:48 == 0
	A -= 15
	SOURCE:15 += 1200
ENDIF
TFLAG:30 += A
TFLAG:37 += A / 2

EXP:0 += 1
PRINTL Ｖ経験＋１

;汚れ
STAIN:3 |= STAIN:PLAYER:2
STAIN:PLAYER:2 |= STAIN:3

;射精チェック
CALL SAMEN_CHECK
IF E >= 1
	TFLAG:703 = 1
	TFLAG:704 = 0
	CALL SAMEN_SHOOT
ENDIF

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0
	PRINTFORML %EXPNAME:40%＋4
	EXP:40 += 4
ENDIF

RETURN 1

;コマンド前の地の文
@TRAIN_MESSAGE_COM258
IF EXP:0 < EXPLV:2
	SELECTCASE RAND:3
	CASE 0
		PRINTFORML %CALLNAME:ASSI%が%CALLNAME:PLAYER%の顔の上に跨り、秘部を口元へ押しつけた…
		PRINTFORMW 騎乗位のまま挿入され続けながら、%CALLNAME:TARGET%は間近に迫る%CALLNAME:ASSI%の蜜を見上げていた…
	CASE 1
		PRINTFORML %CALLNAME:ASSI%が%CALLNAME:PLAYER%の顔に跨り、上の%CALLNAME:TARGET%と向き合う形になった…
		PRINTFORMW 騎乗位を崩さぬまま、%CALLNAME:PLAYER%の舌が%CALLNAME:ASSI%の奥をくすぐり始めた…
	CASE 2
		PRINTFORML 挿入したまま%CALLNAME:ASSI%の顔面騎乗を受け、%CALLNAME:PLAYER%は二重の重さと熱に息を詰めた…
		PRINTFORMW %CALLNAME:TARGET%は騎乗位のまま二人の様子を見下ろし、熱を帯びた吐息を漏らした…
	ENDSELECT
ELSEIF EXP:0 < EXPLV:4
	SELECTCASE RAND:3
	CASE 0
		PRINTFORML %CALLNAME:TARGET%が腰を沈めるたびに、%CALLNAME:ASSI%の腰も%CALLNAME:PLAYER%の口元へきつく押しつけられた…
		PRINTFORMW 三人の動きがやがて一つのリズムに揃い、熱だけが膨れ上がっていった…
	CASE 1
		PRINTFORML %CALLNAME:TARGET%の締め付けと%CALLNAME:ASSI%の蜜が、同時に%CALLNAME:PLAYER%へ押し寄せた…
		PRINTFORMW 上下から挟まれた%CALLNAME:PLAYER%は二重の快楽に、息を詰めながら舌先を動かし続けた…
	CASE 2
		PRINTFORML %CALLNAME:TARGET%は騎乗位のまま%CALLNAME:ASSI%と向き合い、互いの熱と吐息を感じた…
		PRINTFORMW %CALLNAME:PLAYER%の舌が%CALLNAME:ASSI%をくすぐるたびその振動が%CALLNAME:TARGET%にまで伝わり、腰が震えた…
	ENDSELECT
ELSE
	SELECTCASE RAND:3
	CASE 0
		PRINTFORML %CALLNAME:TARGET%の内側がきつく締まる瞬間、%CALLNAME:ASSI%の腰も本能的に%CALLNAME:PLAYER%の口へ押しつけられた…
		PRINTFORMW 二人の快楽が共鳴し、三つの体が溶け合うように乱れていった…
	CASE 1
		PRINTFORML %CALLNAME:TARGET%が騎乗位のまま絶頂に引き寄せられ、%CALLNAME:ASSI%も甘い蜜を溢れさせた…
		PRINTFORMW 誰が誰を快楽に溺れさせているのか判らぬまま、三人の熱が一点へ収束していった…
	CASE 2
		PRINTFORML 上の%CALLNAME:TARGET%は挿入の深さに溺れ、下の%CALLNAME:ASSI%は口淫の熱に揺れ…
		PRINTFORMW %CALLNAME:PLAYER%を挟んだ二人の女が、互いに引き立て合うように乱れていった…
	ENDSELECT
ENDIF
