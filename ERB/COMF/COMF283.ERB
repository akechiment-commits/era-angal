;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE283
;口上独自ウフフコマンド実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;ウフフ中じゃないと無理
SIF TFLAG:44 == 0
	RETURN 0
;CFLAGがたてられてないと無理
SIF !GETBIT(CFLAG:TARGET:独自コマンド使用判定, 3)
	RETURN 0
;恋人または好感度500以上が必要
SIF TALENT:153 == 0 && CFLAG:2 < 500
	RETURN 0
RESULT = 1
TRYCALLFORM COM_ABLE283_{NO:TARGET}
SIF RESULT == 0
	RETURN 0
RETURN 1

@COM283
PRINTSL CSTR:83
STR:0 = %CSTR:83%
;実行判定を使用する場合はこの関数で、真で戻ってくれば判定失敗
TRYCCALLFORM COM_ORDER283_{NO:TARGET}
	IF RESULT == 1
		;口上呼び出し
		TFLAG:13 = 99
		CALL SELF_KOJO
		RETURN 0
	ENDIF
CATCH
ENDCATCH
;地の文を呼ぶ
CALL TRAIN_MESSAGE_B
;デフォルト効果（独自ウフフ共通・キャラ個別関数で上書き可能）
LOSEBASE:1 += 30
SOURCE:9 = 400
SOURCE:18 = 200
;キャラ固有処理（ソース上書き等）
TRYCALLFORM COM283_{NO:TARGET}
RETURN 1

;コマンド前の地の文
@TRAIN_MESSAGE_COM283
TRYCALLFORM TRAIN_MESSAGE_B283_{NO:TARGET}

;絶頂時などの地の文
@TRAIN_MESSAGE_A283
TRYCALLFORM TRAIN_MESSAGE_A283_{NO:TARGET}

;コマンド本体後に出てくる地の文
@TEXT283
TRYCALLFORM TEXT283_{NO:TARGET}
