;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE77
;乳搾り実行判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;母乳体質必須
SIF TALENT:130 == 0
	RETURN 0
;胸感覚がないとダメ
SIF ABL:14 < 1
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:90
	RETURN 0
RETURN 1

@COM77
;乳搾り

PRINTL 乳搾り
STR:0 = 乳搾り
CALL TRAIN_MESSAGE_COM77

LOSEBASE:0 += 10
LOSEBASE:1 += 70

;胸快感（ABL:14による）
IF ABL:14 == 0
	SOURCE:17 = 30
ELSEIF ABL:14 == 1
	SOURCE:17 = 200
ELSEIF ABL:14 == 2
	SOURCE:17 = 700
ELSEIF ABL:14 == 3
	SOURCE:17 = 1600
ELSEIF ABL:14 == 4
	SOURCE:17 = 2800
ELSE
	SOURCE:17 = 1200 + ABL:14 * 500
ENDIF

;接触感
SOURCE:9 = 300

;胸の大きさで母乳量補正
IF TALENT:143
	TIMES SOURCE:17 , 2.00
ELSEIF TALENT:141
	TIMES SOURCE:17 , 1.70
ELSEIF TALENT:110
	TIMES SOURCE:17 , 1.30
ELSEIF TALENT:109
	TIMES SOURCE:17 , 0.60
ENDIF

;胸汚れ（母乳）
STAIN:5 |= 16

;噴乳経験加算
EXP:54 += 1

;噴乳フラグ
TFLAG:11 += 1

RETURN

@TRAIN_MESSAGE_COM77
;乳搾り地の文

IF EXP:54 == 0
	;初噴乳
	IF RAND:3 == 0
		PRINTFORML 「……っ、何を……！」
		PRINTFORML %CALLNAME:PLAYER%が指先でその乳首をそっと摘まみ上げ、ゆっくりと搾り始めると、やがて先端からとろりとした白濁液が滲み出てきた。
		PRINTFORML 「あ……出て……る……」
		PRINTFORML 自分の体から初めて溢れ出る温かな液体に、%CALLNAME:TARGET%は驚きと羞恥で頬を赤く染めた。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%が%CALLNAME:TARGET%の乳首を指でそっと挟み、ゆっくりと搾り上げると、白濁した液体がぷっくりと滲み出てきた。
		PRINTFORML 「……ひゃっ……こんなの……初めて……」
		PRINTFORML それが自分から出てきた母乳だと気づいた瞬間、%CALLNAME:TARGET%の体が恥ずかしさでぶるりと震えた。
	ELSE
		PRINTFORML 乳首を丁寧に揉みしだくと、やがて先端からとろりとした白い液体が溢れ始めた。
		PRINTFORML 「……あ、やだ……なんで……っ」
		PRINTFORML 初めて体から母乳が滲み出てくる感覚に、%CALLNAME:TARGET%は声を詰まらせた。温かくて甘ったるい液体が、%CALLNAME:PLAYER%の指先を濡らしていく。
	ENDIF
ELSEIF EXP:54 < EXPLV:2
	;少ない経験
	IF RAND:3 == 0
		PRINTFORML 「……ん……っ、また……」
		PRINTFORML 乳首を優しく摘まみ上げると、すぐに白濁した液体が滲み出してきた。まだ慣れていないのか、%CALLNAME:TARGET%の体がびくびくと細かく揺れる。
		PRINTFORML 搾られるたびに、とろりとした母乳が%CALLNAME:PLAYER%の指を伝って滴り落ちた。
	ELSEIF RAND:2 == 0
		PRINTFORML 搾られる感覚はまだ慣れないらしく、%CALLNAME:TARGET%は小さな嬌声を漏らし続けながら%CALLNAME:PLAYER%に身を任せていた。
		PRINTFORML 「……ふ、ふぁ……そこ、強く……しないで……」
		PRINTFORML 乳首を柔らかく刺激するたびに、とろりと溢れ出る白濁した液体が%CALLNAME:PLAYER%の指先を濡らしていく。
	ELSE
		PRINTFORML 「……んっ……また出ちゃう……」
		PRINTFORML %CALLNAME:TARGET%の乳首を丁寧に搾り上げると、白い液体がじわりと滲み出してきた。まだ恥ずかしさが抜けきれないのか、その頬はほんのりと赤みを帯びている。
	ENDIF
ELSE
	;豊富な経験
	IF RAND:3 == 0
		PRINTFORML 乳首を優しく挟んで搾り始めると、すぐさまとろりとした白濁液が溢れ出してきた。
		PRINTFORML 「……ん、ふぁ……上手……」
		PRINTFORML 搾られることにすっかり慣れた%CALLNAME:TARGET%は、%CALLNAME:PLAYER%の手の動きに合わせてうっとりと目を細めた。滴る母乳が甘い香りを漂わせる。
	ELSEIF RAND:2 == 0
		PRINTFORML 「……もっと……ちゃんと搾って……」
		PRINTFORML %CALLNAME:TARGET%がせがむように腰をくねらせる。乳首を丁寧に刺激するたびに、豊かな胸からとろとろと白い液体が溢れ出し、甘い香りが辺りに広がった。
	ELSE
		PRINTFORML すっかり搾乳に慣れた体は、乳首に触れるだけでとろとろと母乳を滲ませる。
		PRINTFORML 「……はぁ……気持ちいい……」
		PRINTFORML %CALLNAME:TARGET%は恍惚とした表情で%CALLNAME:PLAYER%に体を預けながら、溢れ出る白濁した液体が胸元を濡らすのを感じていた。
	ENDIF
ENDIF
RETURN
