;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE77
;乳搾り実行判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;母乳体質必須
SIF TALENT:130 == 0
	RETURN 0
;胸感覚がないとダメ
SIF ABL:14 < 1
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:90
	RETURN 0
RETURN 1

@COM77
;乳搾り

PRINTL 乳搾り
STR:0 = 乳搾り
CALL TRAIN_MESSAGE_COM77

LOSEBASE:0 += 10
LOSEBASE:1 += 70

;胸快感（ABL:14による）
IF ABL:14 == 0
	SOURCE:17 = 30
ELSEIF ABL:14 == 1
	SOURCE:17 = 200
ELSEIF ABL:14 == 2
	SOURCE:17 = 700
ELSEIF ABL:14 == 3
	SOURCE:17 = 1600
ELSEIF ABL:14 == 4
	SOURCE:17 = 2800
ELSE
	SOURCE:17 = 1200 + ABL:14 * 500
ENDIF

;接触感
SOURCE:9 = 300

;胸の大きさで母乳量補正
IF TALENT:143
	TIMES SOURCE:17 , 2.00
ELSEIF TALENT:141
	TIMES SOURCE:17 , 1.70
ELSEIF TALENT:110
	TIMES SOURCE:17 , 1.30
ELSEIF TALENT:109
	TIMES SOURCE:17 , 0.60
ENDIF

;胸汚れ（母乳）
STAIN:5 |= 16

;噴乳経験加算
EXP:54 += 1

;噴乳フラグ
TFLAG:11 += 1

RETURN

@TRAIN_MESSAGE_COM77
;乳搾り地の文

IF EXP:54 == 0
	;初噴乳
	IF RAND:3 == 0
		PRINTFORML %CALLNAME:PLAYER%が指先で%CALLNAME:TARGET%の乳首をそっと摘まみ上げ、
		PRINTL ゆっくりと搾り始めると、先端からとろりとした白濁液が初めて滲み出てきた。
		PRINTFORML 自分の体から温かな液体が溢れ出してくる事実に、
		PRINTFORML %CALLNAME:TARGET%は驚きと羞恥で頬を赤く染め、身を縮めるように肩を震わせた。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%が%CALLNAME:TARGET%の乳首を指でそっと挟んでゆっくりと搾り上げると、
		PRINTL 白濁した液体がぷっくりと先端に盛り上がり、やがてとろりと滴り落ちた。
		PRINTFORML それが自分の体から出てきた母乳だと気づいた瞬間、
		PRINTFORML %CALLNAME:TARGET%の体が恥ずかしさと戸惑いでぶるりと震えた。
	ELSE
		PRINTFORML %CALLNAME:PLAYER%が丁寧に乳首を揉みしだくと、
		PRINTL 先端からとろりとした白い液体が溢れ始めた。
		PRINTFORML 初めて滲み出る温かな液体の感触に%CALLNAME:TARGET%は声を詰まらせ、
		PRINTL 手を掴もうとしながらも全身の力が抜けていった。
	ENDIF
ELSEIF EXP:54 < EXPLV:2
	;少ない経験
	IF RAND:3 == 0
		PRINTL 乳首をそっと摘まみ上げると、すぐに白濁した液体が滲み出てきた。
		PRINTFORML まだ慣れていないのか%CALLNAME:TARGET%の体がびくびくと細かく揺れ、
		PRINTFORML 搾られるたびにとろりとした母乳が%CALLNAME:PLAYER%の指を伝って滴り落ちた。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%が%CALLNAME:TARGET%の乳首を柔らかく刺激するたびに、
		PRINTL 白濁した液体がとろりと溢れ出してきた。
		PRINTFORML 搾られる感覚にまだ体が慣れず、
		PRINTFORML %CALLNAME:TARGET%の腰が小刻みに揺れ続けた。
	ELSE
		PRINTFORML %CALLNAME:TARGET%の乳首を丁寧に搾り上げると、白い液体がじわりと滲み出してきた。
		PRINTFORML まだ恥ずかしさが抜けきれないのか、%CALLNAME:TARGET%は顔をそむけながらも、
		PRINTL 腰だけが快感を求めるようにうごめいた。
	ENDIF
ELSE
	;豊富な経験
	IF RAND:3 == 0
		PRINTL 乳首を優しく挟んで搾り始めると、すぐさまとろりとした白濁液が溢れ出してきた。
		PRINTFORML 搾られることにすっかり慣れた%CALLNAME:TARGET%の体は
		PRINTFORML %CALLNAME:PLAYER%の手の動きに合わせてうっとりと弛緩し、
		PRINTL 滴る母乳が甘い香りを漂わせた。
	ELSEIF RAND:2 == 0
		PRINTFORML %CALLNAME:PLAYER%が乳首を丁寧に刺激するたびに、
		PRINTL 豊かな胸からとろとろと白い液体が溢れ出し、甘い香りが辺りに広がった。
		PRINTFORML %CALLNAME:TARGET%はその感覚に抗えず、
		PRINTL もっとと訴えるように腰をくねらせた。
	ELSE
		PRINTFORML すっかり搾乳に慣れた体は、乳首に触れるだけでとろとろと母乳を滲ませる。
		PRINTFORML %CALLNAME:TARGET%は恍惚とした表情で%CALLNAME:PLAYER%に体を預け、
		PRINTL 溢れ出す白濁した液体が胸元を濡らしていくのをただ受け入れていた。
	ENDIF
ENDIF
RETURN
