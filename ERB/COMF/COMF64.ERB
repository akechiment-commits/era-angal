	IF EXP:1 < EXPLV:1	; 【[Ａ経験]<EXPLV:1】
		TIMES SOURCE:2 , 0.10
		SOURCE:6 += 5000
		SOURCE:11 += 1000
	ELSEIF EXP:1 < EXPLV:2	; 【[Ａ経験]<EXPLV:2】
		TIMES SOURCE:2 , 0.30
