;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM64
;3P

;直接コマンドを指定した場合
IF SELECTCOM == 64
	TFLAG:40 = 1
	TFLAG:41 = 2
ELSE
	SIF SELECTCOM == 20 || SELECTCOM == 21	; 【コマンド:[正常位] / コマンド:[後背位]】
		A = 1
	SIF SELECTCOM == 22	; 【コマンド:[アナルセックス]】
		A = 2
	SIF SELECTCOM == 31 || SELECTCOM == 80	; 【コマンド:[フェラチオ] / コマンド:[イラマチオ]】
		A = 3
	SIF PREVCOM == 20 || PREVCOM == 21	; 【前コマンド:[正常位] / 前コマンド:[後背位]】
		B = 1
	SIF PREVCOM == 22	; 【前コマンド:[アナルセックス]】
		B = 2
	SIF PREVCOM == 31 || PREVCOM == 80	; 【前コマンド:[フェラチオ] / 前コマンド:[イラマチオ]】
		B = 3
	;前回コマンドが3Pでない
	IF TFLAG:42 == 0	; 【無[前回コマンドが３Ｐかどうか]】
		;今回調教者が助手=前回調教者が主人
		IF ASSIPLAY	; 【調教者:[助手]】
			TFLAG:40 = B
			TFLAG:41 = A
		;今回調教者が主人=前回調教者が助手
		ELSE
			TFLAG:40 = A
			TFLAG:41 = B
		ENDIF
	;前回コマンドが3Pである
	ELSE
		;今回調教者が助手=前回調教者が主人
		IF ASSIPLAY	; 【調教者:[助手]】
			;助手の使用部位が前回の主人と同じ場合
			SIF A == TFLAG:40	; 【[３Ｐ時主人行動]】
				TFLAG:40 = TFLAG:41
			TFLAG:41 = A
		ELSE
			;主人の使用部位が前回の助手と同じ場合
			SIF A == TFLAG:41	; 【[３Ｐ時助手行動]】
				TFLAG:41 = TFLAG:40
			TFLAG:40 = A
		ENDIF
	ENDIF
ENDIF

