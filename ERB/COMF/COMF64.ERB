IF TFLAG:41 == 1	; 【[３Ｐ時助手行動]==1】
	;奴隷のＶ⇔助手のＰの汚れが移動
	IF TALENT:ASSI:121 || TALENT:ASSI:122	; 【ASSI:[ふたなり] / ASSI:[オトコ]】
		STAIN:3 |= STAIN:ASSI:2
		STAIN:ASSI:2 |= STAIN:3
	ENDIF
ELSEIF TFLAG:41 == 2	; 【[３Ｐ時助手行動]==2】
	;奴隷のＡ⇔助手のＰの汚れが移動
	IF TALENT:ASSI:121 || TALENT:ASSI:122	; 【ASSI:[ふたなり] / ASSI:[オトコ]】
		STAIN:4 |= STAIN:ASSI:2
		STAIN:ASSI:2 |= STAIN:4
	ENDIF
ELSEIF TFLAG:41 == 3	; 【[３Ｐ時助手行動]==3】
	;奴隷の口⇔助手のＰの汚れが移動
	IF TALENT:ASSI:121 || TALENT:ASSI:122	; 【ASSI:[ふたなり] / ASSI:[オトコ]】
		STAIN:0 |= STAIN:ASSI:2
		STAIN:ASSI:2 |= STAIN:0
	ENDIF
ENDIF

IF TFLAG:40 == 1	; 【[３Ｐ時主人行動]==1】
	;奴隷のＶ⇔主人のＰの汚れが移動
	IF TALENT:MASTER:121 || TALENT:MASTER:122	; 【MASTER:[ふたなり] / MASTER:[オトコ]】
		STAIN:3 |= STAIN:MASTER:2
		STAIN:MASTER:2 |= STAIN:3
	ENDIF
ELSEIF TFLAG:40 == 2	; 【[３Ｐ時主人行動]==2】
	;奴隷のＡ⇔主人のＰの汚れが移動
	IF TALENT:MASTER:121 || TALENT:MASTER:122	; 【MASTER:[ふたなり] / MASTER:[オトコ]】
		STAIN:4 |= STAIN:MASTER:2
		STAIN:MASTER:2 |= STAIN:4
	ENDIF
ELSEIF TFLAG:40 == 3	; 【[３Ｐ時主人行動]==3】
	;奴隷の口⇔主人のＰの汚れが移動
	IF TALENT:MASTER:121 || TALENT:MASTER:122	; 【MASTER:[ふたなり] / MASTER:[オトコ]】
		STAIN:0 |= STAIN:MASTER:2
		STAIN:MASTER:2 |= STAIN:0
	ENDIF
ENDIF

;マスターと奴隷のレズorBL
IF TALENT:122 == 0 && TALENT:MASTER:122 == 0	; 【[オトコ]なし / MASTER:[オトコ]なし】
	PRINTFORML %EXPNAME:40%+7
	EXP:40 += 7
	EXP:MASTER:40 += 7
ELSEIF TALENT:122 == 1 && TALENT:MASTER:122 == 1	; 【[オトコ] / MASTER:[オトコ]】
	PRINTFORML %EXPNAME:41%+7
	EXP:41 += 7
	EXP:MASTER:41 += 7
ENDIF

;助手と奴隷のレズorBL
IF TALENT:122 == 0 && TALENT:ASSI:122 == 0	; 【[オトコ]なし / ASSI:[オトコ]なし】
	PRINTFORML %EXPNAME:40%(助手)+7
	PRINTFORML %EXPNAME:40%+7
	EXP:40 += 7
	EXP:ASSI:40 += 7
ELSEIF TALENT:122 == 1 && TALENT:ASSI:122 == 1	; 【[オトコ] / ASSI:[オトコ]】
	PRINTFORML %EXPNAME:41%(助手)+7
	PRINTFORML %EXPNAME:41%+7
	PRINTL +7
	EXP:41 += 7
	EXP:ASSI:41 += 7
ENDIF

;ASSIPLAYとPLAYERの戻し
ASSIPLAY = A:1
IF A:1
	PLAYER = ASSI
ELSE
	PLAYER = MASTER
ENDIF

TFLAG:100 = 1

;既成事実２に相当
TFLAG:200 = 2

RETURN 1

;-------------------------------------------------
;固有の実行判定
;-------------------------------------------------
@COM_ORDER_64
A = 0
S = 0
V = 150
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
CALL COM_ORDER

;ABL:欲望
IF ABL:1	; 【[欲望]】
	A += ABL:1 * 3
ENDIF
;ABL:奉仕精神
IF ABL:6	; 【[奉仕精神]】
	A += ABL:6 * 4
ENDIF
;ABL:精液中毒
IF ABL:11	; 【[精液中毒]】
	A += ABL:11 * 1
ENDIF
IF MARK:1	; 【[快楽依存]】
	A += MARK:1 * 3
ENDIF

;PALAM:潤滑（の不足）
IF PALAM:3 < PALAMLV:3	; 【[潤滑]<PALAMLV:3】
	A -= 5
ENDIF
;PALAM:欲情
IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
	L = 0
ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
	L = 1
ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
	L = 2
ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
	L = 3
ELSEIF PALAM:5 < PALAMLV:5	; 【[欲情]<PALAMLV:5】
	L = 4
ELSE
	L = 5
ENDIF
IF L
	A += L * 3
ENDIF

;恥じらい
IF TALENT:35	; 【[恥じらい]】
	A -= 2
ENDIF
;快感の否定
IF TALENT:71 == 1	; 【[快感の否定]】
	A -= 5
ENDIF
;男嫌い
IF TALENT:82 && TALENT:PLAYER:122	; 【[男嫌い] / PLAYER:[オトコ]】
	A -= 12
ENDIF
;恋慕
IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
	A += 5
	S = 5
ENDIF
;調教者がふたなり
IF TALENT:PLAYER:121	; 【PLAYER:[ふたなり]】
	A += 4
ENDIF


;媚薬
IF TEQUIP:21	; 【[媚薬効果発揮中]使用中】
	A += 6
ENDIF

;好感度
IF CFLAG:2 < 3000	; 【[好感度]<3000】
	B = 0
	IF CFLAG:2 < 1000	; 【[好感度]<1000】
		B = 50
	ELSEIF CFLAG:2 < 2000	; 【[好感度]<2000】
		B = 20
	ELSEIF CFLAG:2 < 2500	; 【[好感度]<2500】
		B = 10
	ELSE
		B = 5
	ENDIF
	A -= B
ENDIF
;好感度
IF CFLAG:2 >= 4000	; 【[好感度]>=4000】
	B = 0
	IF CFLAG:2 < 5000	; 【[好感度]<5000】
		B = 5
	ELSE
		B = CFLAG:2 / 300
	ENDIF
	A += B
ENDIF


;合意
IF TALENT:152 == 0	; 【[合意]なし】
	A -= 40
ENDIF

IF ((FLAG:23 & 1p27) == 0) && FLAG:2 != 1
	;ABL:欲望
	IF ABL:1	; 【[欲望]】
		SIF S
			PRINT  + 
		PRINTS ABLNAME:1
		PRINTV 'LV,ABL:1,'(,ABL:1 * 3,')
		S = 1
	ENDIF
	;ABL:奉仕精神
	IF ABL:6	; 【[奉仕精神]】
		SIF S
			PRINT  + 
		PRINTS ABLNAME:6
		PRINTV 'LV,ABL:6,'(,ABL:6 * 4,')
		S = 1
	ENDIF
	;ABL:精液中毒
	IF ABL:11	; 【[精液中毒]】
		SIF S
			PRINT  + 
		PRINTS ABLNAME:11
		PRINTV 'LV,ABL:11,'(,ABL:11 * 1,')
		S = 1
	ENDIF
	IF MARK:1	; 【[快楽依存]】
		SIF S
			PRINT  + 
		PRINTS MARKNAME:1
		PRINTV 'LV,MARK:1,'(,MARK:1 * 3,')
		S = 1
	ENDIF

	;PALAM:潤滑（の不足）
	IF PALAM:3 < PALAMLV:3	; 【[潤滑]<PALAMLV:3】
		PRINT  - 
		PRINT 潤滑不足
		PRINTV '(,5,')
		S = 1
	ENDIF
	;PALAM:欲情
	IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
		L = 0
	ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
		L = 1
	ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
		L = 2
	ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
		L = 3
	ELSEIF PALAM:5 < PALAMLV:5	; 【[欲情]<PALAMLV:5】
		L = 4
	ELSE
		L = 5
	ENDIF
	IF L
		SIF S
			PRINT  + 
		PRINTS PALAMNAME:5
		PRINTV 'LV,L,'(,L * 3,')
		S = 1
	ENDIF

	;恥じらい'
	IF TALENT:35	; 【[恥じらい]】
		PRINT  - 
		PRINTS TALENTNAME:35
		PRINTV '(,2,')
		S = 1
	ENDIF
	;快感の否定
	IF TALENT:71	; 【[快感の否定]】
		PRINT  - 
		PRINTS TALENTNAME:71
		PRINTV '(,5,')
		S = 1
	ENDIF
	;男嫌い
	IF TALENT:82 && TALENT:PLAYER:122	; 【[男嫌い] / PLAYER:[オトコ]】
		PRINT  - 
		PRINTS TALENTNAME:82
		PRINTV '(,12,')
		S = 1
	ENDIF
	;恋慕
	IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:85
		PRINTV '(,5,')
		S = 5
	ENDIF
	;調教者がふたなり
	IF TALENT:PLAYER:121	; 【PLAYER:[ふたなり]】
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:121
		PRINTV '(,4,')
		S = 1
	ENDIF


	;媚薬
	IF TEQUIP:21	; 【[媚薬効果発揮中]使用中】
		SIF S
			PRINT  + 
		PRINTS ITEMNAME:26
		PRINTV '(,6,')
		S = 1
	ENDIF

	;好感度
	IF CFLAG:2 < 3000	; 【[好感度]<3000】
		B = 0
		PRINT  - 
		IF CFLAG:2 < 1000	; 【[好感度]<1000】
			B = 50
		ELSEIF CFLAG:2 < 2000	; 【[好感度]<2000】
			B = 20
		ELSEIF CFLAG:2 < 2500	; 【[好感度]<2500】
			B = 10
		ELSE
			B = 5
		ENDIF
		PRINT 好感度不足
		PRINTV '(,B,')
		S = 1
	ENDIF
	;好感度
	IF CFLAG:2 >= 4000	; 【[好感度]>=4000】
		B = 0
		SIF S
			PRINT  + 
		IF CFLAG:2 < 5000	; 【[好感度]<5000】
			B = 5
		ELSE
			B = CFLAG:2 / 300
		ENDIF
		PRINT 好感度
		PRINTV '(,B,')
		S = 1
	ENDIF


	;合意
	IF TALENT:152 == 0	; 【[合意]なし】
		PRINT  - 
		PRINTFORM %TALENTNAME:152%無し
		PRINTV '(,40,')
		S = 1
	ENDIF

	;合計を表示(150以上で実行)
	PRINT  = 
	PRINTV A

	SIF A < V
		PRINT  < 
	SIF A == V
		PRINT  = 
	SIF A > V
		PRINT  > 
	PRINT 実行値
	PRINTV V
	WAIT
ENDIF

