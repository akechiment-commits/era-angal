		SOURCE:3 += 350
	ELSEIF ABL:4 == 4	; 【[Ｖ感覚]Lv==4】
		SOURCE:1 = 1700
		SOURCE:3 += 600
	ELSE
		SOURCE:1 = 950 + (ABL:4 * 250)
		SOURCE:3 += 225 + (ABL:4 * 125)
	ENDIF

	;EXP:Ｖ経験をみる
	IF EXP:0 < EXPLV:1	; 【[Ｖ経験]<EXPLV:1】
		TIMES SOURCE:1 , 0.20
		SOURCE:6 += 20000
		SOURCE:11 += 2000

		IF TALENT:MASTER:122 == 0	; 【MASTER:[オトコ]なし】
			EXP:50 += 2
			IF TALENT:ASSI:122 == 0	; 【ASSI:[オトコ]なし】
				EXP:50 += 1
				PRINTFORML %EXPNAME:50%+3
			ELSE
				PRINTFORML %EXPNAME:50%+2
			ENDIF
		ENDIF
	ELSEIF EXP:0 < EXPLV:2	; 【[Ｖ経験]<EXPLV:2】
		TIMES SOURCE:1 , 0.60
		SOURCE:6 += 300
	ELSEIF EXP:0 < EXPLV:3	; 【[Ｖ経験]<EXPLV:3】
		TIMES SOURCE:1 , 1.00
		SOURCE:6 += 50
	ELSEIF EXP:0 < EXPLV:4	; 【[Ｖ経験]<EXPLV:4】
		TIMES SOURCE:1 , 1.20
		SOURCE:6 += 10
	ELSEIF EXP:0 < EXPLV:5	; 【[Ｖ経験]<EXPLV:5】
		TIMES SOURCE:1 , 1.40
		SOURCE:6 += 0
	ELSE
		TIMES SOURCE:1 , 1.60
		SOURCE:6 = 0
	ENDIF
ENDIF

IF TFLAG:40 == 2 || TFLAG:41 == 2	; 【[３Ｐ時主人行動]==2 / [３Ｐ時助手行動]==2】
