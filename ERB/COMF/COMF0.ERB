SOURCE:4 = 60
SOURCE:8 = 30
SOURCE:12 = 100

;ABL:Ｃ感覚をみる
IF ABL:3 == 0	; 【[Ｃ感覚]Lv==0】
	SOURCE:0 = 20
	SOURCE:3 = 50
ELSEIF ABL:3 == 1	; 【[Ｃ感覚]Lv==1】
	SOURCE:0 = 100
	SOURCE:3 = 100
ELSEIF ABL:3 == 2	; 【[Ｃ感覚]Lv==2】
	SOURCE:0 = 500
	SOURCE:3 = 160
ELSEIF ABL:3 == 3	; 【[Ｃ感覚]Lv==3】
	SOURCE:0 = 1200
	SOURCE:3 = 200
ELSEIF ABL:3 == 4	; 【[Ｃ感覚]Lv==4】
	SOURCE:0 = 2000
	SOURCE:3 = 230
ELSE
	SOURCE:0 = 800 + (ABL:3 * 400)
	SOURCE:3 = 200 + (ABL:3 * 10)
ENDIF

;ABL:Ｂ感覚をみる
IF ABL:14 == 0	; 【[Ｂ感覚]Lv==0】
	SOURCE:17 = 15
ELSEIF ABL:14 == 1	; 【[Ｂ感覚]Lv==1】
	SOURCE:17 = 50
ELSEIF ABL:14 == 2	; 【[Ｂ感覚]Lv==2】
	SOURCE:17 = 300
ELSEIF ABL:14 == 3	; 【[Ｂ感覚]Lv==3】
	SOURCE:17 = 700
ELSEIF ABL:14 == 4	; 【[Ｂ感覚]Lv==4】
	SOURCE:17 = 1100
ELSE
	SOURCE:17 = 350 + (ABL:14 * 250)
ENDIF

;着衣中でかつコンフィグがONだと性能低下
IF TEQUIP:65	; 【[コスプレ]使用中】
	TIMES SOURCE:0 , 0.80
	TIMES SOURCE:17 , 0.80
ENDIF

IF (STAIN:0 >= 2 && (STAIN:0 != 16 || STAIN:0 != 17) && ASSIPLAY == 0 && TALENT:MASTER:64 == 0) || TEQUIP:45 || TALENT:151	; 【MASTER:[汚れ無視]なし / [キス未経験] / [ボールギャグ]使用中 / 汚れ:[口] / 調教者:[主人]】
;奴隷の口の汚れがあるときキスはない（愛液と母乳よごれはＯＫ、汚れ無視か助手調教時は問題なし）
;ボールギャグ使用中もなし
;キス未経験でもなし
	SOURCE:8 = 0
	SOURCE:0 /= 2
	SOURCE:3 /= 4
	SOURCE:10 /= 2
ELSE
	;Ｍ感覚を設定している場合快Ｍソース等取得
	SIF FLAG:62 & 4194304
		CALL SOURCE_M_COM0
	
	;汚臭鈍感
	SIF TALENT:61	; 【[汚臭鈍感]】
		SOURCE:8 /= 4
	;汚臭敏感
	SIF TALENT:62	; 【[汚臭敏感]】
		SOURCE:8 *= 3
	;自尊心
	SIF TALENT:15	; 【[プライド高い]】
		SOURCE:8 *= 2
	;恋慕
	IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
		SOURCE:3 *= 2
		SOURCE:8 /= 10
	ENDIF
	IF STAIN:PLAYER:0	; 【汚れ:[口]】
	;主人の口の汚れがあると不潔150%
		SOURCE:8 *= 3
		SOURCE:8 /= 2
	ENDIF

	;奴隷の口⇔調教者の口の汚れが移動
	STAIN:0 |= STAIN:PLAYER:0
	STAIN:PLAYER:0 |= STAIN:0

	PRINTFORML %EXPNAME:96%＋１
	EXP:96 += 1
	EXP:PLAYER:96 += 1
	IF TALENT:151
		PRINTFORMW %CALLNAME:TARGET%は【キス未経験】を失いました
		TALENT:151 = 0
		CALL SET_FIRST_KISS_RECORD, TARGET, PLAYER
	ENDIF
	IF TALENT:PLAYER:151	; 【PLAYER:[キス未経験]】
		PRINTFORMW %CALLNAME:PLAYER%は【キス未経験】を失いました
		TALENT:PLAYER:151 = 0
		CALL SET_FIRST_KISS_RECORD, PLAYER, TARGET
	ENDIF
ENDIF

IF TEQUIP:90	; 【[触手プレイ]使用中】
	;奴隷に触手の汚れがつく
	STAIN:1 |= 2
	STAIN:1 |= 4
	STAIN:5 |= 2
	STAIN:5 |= 4
ELSE
	;奴隷のＶ⇔調教者の指の汚れが移動
	STAIN:3 |= STAIN:PLAYER:1
	STAIN:PLAYER:1 |= STAIN:3

	;奴隷のＢ⇔調教者の指の汚れが移動
	STAIN:5 |= STAIN:PLAYER:1
	STAIN:PLAYER:1 |= STAIN:5
ENDIF

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
	PRINTS EXPNAME:40
	PRINTL +5
	EXP:40 += 5
	EXP:PLAYER:40 += 5
ELSEIF TALENT:122 == 1 && TALENT:PLAYER:122 == 1	; 【[オトコ] / PLAYER:[オトコ]】
	PRINTS EXPNAME:41
	PRINTL +5
	EXP:41 += 5
	EXP:PLAYER:41 += 5
ENDIF

;主導権をチェック
IF TFLAG:45 == 0	; 【無[主導権]】
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1	; 【[親密]Lv<=1】
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3	; 【[親密]Lv<=3】
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5	; 【[親密]Lv<=5】
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8	; 【[親密]Lv<=8】
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11	; 【[親密]Lv<=11】
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0	; 【[サドっ気]Lv==0】
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1	; 【[サドっ気]Lv==1】
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2	; 【[サドっ気]Lv==2】
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3	; 【[サドっ気]Lv==3】
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4	; 【[サドっ気]Lv==4】
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 5
;合意がないと好感度が下がる
IF TALENT:152 == 0 && TFLAG:48 == 0	; 【[合意]なし / 無[よっぱウフフ]】
	A -= 7
	SOURCE:15 += 200
ENDIF
TFLAG:30 += A
TFLAG:37 += A

RETURN 1

