;============================================================
@COM0
;愛撫
SIF TEQUIP:65	; 【[コスプレ]使用中】
	PRINT 着衣
PRINTL 愛撫
STR:0 = 愛撫
CALL TRAIN_MESSAGE_B

LOSEBASE:0 += 5
