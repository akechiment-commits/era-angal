;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
@COM_ABLE201
;指フェラ実行判定
;COM_ABLE共通判定
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
;ウフフ中じゃないと無理
SIF TFLAG:44 == 0	; 【無[ウフフ中]】
	RETURN 0
;[猫舌]だとダメ
SIF TALENT:54	; 【[猫舌]】
	RETURN 0
;蜘蛛の巣にかけているときはダメ
SIF TEQUIP:44 == 7	; 【[縄で緊縛]==7】
	RETURN 0
;ボールギャグ使用中は不可
SIF TEQUIP:45	; 【[ボールギャグ]使用中】
	RETURN 0
;女体盛り中はダメ
SIF TEQUIP:69	; 【[女体盛りプレイ中]使用中】
	RETURN 0
;時止め中は無理
SIF TEQUIP:81
	RETURN 0
;触手調教中はダメ
SIF TEQUIP:90	; 【[触手プレイ]使用中】
	RETURN 0
RETURN 1

@COM201
;指フェラ
PRINTL 指フェラ

;-------------------------------------------------
;実行できるかの判定
;-------------------------------------------------
CALL COM_ORDER_COMMON
SIF RESULT == 0
	RETURN 0

STR:0 = 指フェラ
CALL TRAIN_MESSAGE_B

;-------------------------------------------------
;実行決定
;-------------------------------------------------

;-------------------------------------------------
;ソースの計算
;-------------------------------------------------
LOSEBASE:0 += 5
LOSEBASE:1 += 50

SOURCE:13 = 500
SOURCE:14 = 200

;上のほうで計算した汚れデータ
SOURCE:8 = Y*80 + 50

;Ｍ感覚を設定している場合快Ｍソース等取得
SIF FLAG:62 & 4194304
	CALL SOURCE_M_COM201

;ABL:奉仕精神をみる
IF ABL:6 == 0	; 【[奉仕精神]Lv==0】
	SOURCE:4 = 210
	SOURCE:5 = 100
	TIMES SOURCE:8 , 4.00
ELSEIF ABL:6 == 1	; 【[奉仕精神]Lv==1】
	SOURCE:4 = 250
	SOURCE:5 = 200
	TIMES SOURCE:8 , 2.50
ELSEIF ABL:6 == 2	; 【[奉仕精神]Lv==2】
	SOURCE:4 = 290
	SOURCE:5 = 400
	TIMES SOURCE:8 , 1.50
ELSEIF ABL:6 == 3	; 【[奉仕精神]Lv==3】
	SOURCE:4 = 330
	SOURCE:5 = 600
	TIMES SOURCE:8 , 1.00
ELSEIF ABL:6 == 4	; 【[奉仕精神]Lv==4】
	SOURCE:4 = 370
	SOURCE:5 = 1000
	TIMES SOURCE:8 , 0.50
ELSE
	SOURCE:4 = 310 + (ABL:6 * 20)
	SOURCE:5 = 300 + (ABL:6 * 240)
	TIMES SOURCE:8 , 0.10
ENDIF

;ABL:技巧をみる
IF ABL:2 == 0	; 【[技巧]Lv==0】
	TIMES SOURCE:4 , 0.50
	TIMES SOURCE:5 , 0.50
ELSEIF ABL:2 == 1	; 【[技巧]Lv==1】
	TIMES SOURCE:4 , 0.80
	TIMES SOURCE:5 , 0.80
ELSEIF ABL:2 == 2	; 【[技巧]Lv==2】
	TIMES SOURCE:4 , 1.00
	TIMES SOURCE:5 , 1.00
ELSEIF ABL:2 == 3	; 【[技巧]Lv==3】
	TIMES SOURCE:4 , 1.50
	TIMES SOURCE:5 , 1.50
ELSEIF ABL:2 == 4	; 【[技巧]Lv==4】
	TIMES SOURCE:4 , 2.50
	TIMES SOURCE:5 , 2.50
ELSE
	SOURCE:4 = SOURCE:4 * (ABL:2 * 75 + 25) / 100
	SOURCE:5 = SOURCE:5 * (ABL:2 * 75 + 25) / 100
ENDIF


;主導権をチェック
IF TFLAG:45 == 0	; 【無[主導権]】
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1	; 【[親密]Lv<=1】
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3	; 【[親密]Lv<=3】
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5	; 【[親密]Lv<=5】
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8	; 【[親密]Lv<=8】
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11	; 【[親密]Lv<=11】
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0	; 【[サドっ気]Lv==0】
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1	; 【[サドっ気]Lv==1】
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2	; 【[サドっ気]Lv==2】
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3	; 【[サドっ気]Lv==3】
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4	; 【[サドっ気]Lv==4】
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 5
;合意がないと好感度が下がる
IF TALENT:152 == 0 && TFLAG:48 == 0	; 【[合意]なし / 無[よっぱウフフ]】
	A -= 9
	SOURCE:15 += 400
ENDIF
TFLAG:30 += A
TFLAG:37 += A / 2

;奴隷の口⇔調教者の手の汚れが移動
STAIN:0 |= STAIN:PLAYER:1
STAIN:PLAYER:1 |= STAIN:0

PRINTFORML %EXPNAME:22%＋１
EXP:22 += 1

IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
	PRINTFORML %EXPNAME:40%＋3
	EXP:40 += 3
ENDIF

TFLAG:100 = 1

;既成事実１に相当
TFLAG:200 = 1

RETURN 1

;Ｍ感覚を設定している場合快Ｍソース等取得
@SOURCE_M_COM201
;快Mのソース・M感覚を見る
IF ABL:17 == 1	; 【[Ｍ感覚]Lv==1】
	SOURCE:24 = 20
ELSEIF ABL:17 == 2	; 【[Ｍ感覚]Lv==2】
	SOURCE:24 = 50
ELSEIF ABL:17 == 3	; 【[Ｍ感覚]Lv==3】
	SOURCE:24 = 100
ELSEIF ABL:17 == 4	; 【[Ｍ感覚]Lv==4】
	SOURCE:24 = 200
ELSEIF ABL:17 >= 5	; 【[Ｍ感覚]Lv>=5】
	SOURCE:24 = 200 + (100 * (ABL:17 - 4))
ENDIF

;TALENT:恋慕をみる
SIF TALENT:85	; 【[恋慕]】
	TIMES SOURCE:24 , 1.50
;TALENT:恋人をみる
SIF TALENT:153	; 【[恋人]】
	TIMES SOURCE:24 , 1.50
;TALENT:親愛をみる
SIF TALENT:88	; 【[親愛]】
	TIMES SOURCE:24 , 2.00
;TALENT:相愛をみる
SIF TALENT:89	; 【[相愛]】
	TIMES SOURCE:24 , 2.00

;ABL:奉仕精神をみる
IF ABL:6 == 0	; 【[奉仕精神]Lv==0】
	TIMES SOURCE:24 , 0.00
ELSEIF ABL:6 == 1	; 【[奉仕精神]Lv==1】
	TIMES SOURCE:24 , 0.00
ELSEIF ABL:6 == 2	; 【[奉仕精神]Lv==2】
	TIMES SOURCE:24 , 0.00
ELSEIF ABL:6 == 3	; 【[奉仕精神]Lv==3】
	TIMES SOURCE:24 , 0.85
ELSEIF ABL:6 == 4	; 【[奉仕精神]Lv==4】
	TIMES SOURCE:24 , 1.00
ELSE
	TIMES SOURCE:24 , 1.15
ENDIF

;指フェラ
@TRAIN_MESSAGE_COM201
PRINTFORM %CALLNAME:TARGET%は
SIF TALENT:85	; 【[恋慕]】
	PRINT 慈しむような表情で、
PRINTFORMW %CALLNAME:PLAYER%の指を咥えて舐め回している…

;-------------------------------------------------
;固有の実行判定
;-------------------------------------------------
@COM_ORDER_201
A = 0
S = 0
V = 60

;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
CALL COM_ORDER

;ABL:欲望
IF ABL:1	; 【[欲望]】
	S = ABL:1
	A += S
ENDIF
;ABL:奉仕精神
IF ABL:6	; 【[奉仕精神]】
	S = ABL:6
	A += S * 4
ENDIF

;快楽刻印
IF MARK:1	; 【[快楽依存]】
	S = MARK:1
	A += S * 2
ENDIF

;PALAM:欲情
IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
	L = 0
ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
	L = 1
ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
	L = 2
ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
	L = 3
ELSEIF PALAM:5 < PALAMLV:5	; 【[欲情]<PALAMLV:5】
	L = 4
ELSE
	L = 5
ENDIF
IF L
	S = L
	A += S
ENDIF

;恥じらい
IF TALENT:35	; 【[恥じらい]】
	A -= S
ENDIF
;汚臭鈍感
IF TALENT:61	; 【[汚臭鈍感]】
	A += 3
ENDIF
;汚臭敏感
IF TALENT:62	; 【[汚臭敏感]】
	A -= 3
ENDIF
;献身的
IF TALENT:63	; 【[献身的]】
	S = 6
	A += S
ENDIF
;快感の否定
IF TALENT:71 == 1	; 【[快感の否定]】
	A -= S
ENDIF
;恋慕
IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
	S = 5
	A += S
ENDIF

Y = 0
;愛液の汚れ
SIF STAIN:PLAYER:1 & 1	; 【汚れ:[手]】
	Y += 1
;精液の汚れ
SIF STAIN:PLAYER:1 & 4	; 【汚れ:[手]】
	Y += 3
;アナルの汚れ
SIF STAIN:PLAYER:1 & 8	; 【汚れ:[手]】
	Y += 7
SIF STAIN:PLAYER:1 & 16	; 【汚れ:[手]】
	Y += 15

SIF TALENT:61	; 【[汚臭鈍感]】
	Y /= 3
SIF TALENT:62	; 【[汚臭敏感]】
	Y *= 2

;汚れあり
IF Y
	A -= Y
ENDIF

;好感度
IF CFLAG:2 < 1000	; 【[好感度]<1000】
	B = 0
	IF CFLAG:2 < 500	; 【[好感度]<500】
		B = 50
	ELSEIF CFLAG:2 < 750	; 【[好感度]<750】
		B = 20
	ELSEIF CFLAG:2 < 900	; 【[好感度]<900】
		B = 10
	ELSE
		B = 5
	ENDIF
	A -= B
ENDIF
;好感度
IF CFLAG:2 >= 1500	; 【[好感度]>=1500】
	B = 0
	IF CFLAG:2 < 2000	; 【[好感度]<2000】
		B = 5
	ELSE
		B = CFLAG:2 / 200
	ENDIF
	A += B
ENDIF

;合意
IF TALENT:152 == 0	; 【[合意]なし】
	A -= 10
ENDIF

IF ((FLAG:23 & 1p27) == 0) && FLAG:2 != 1
	;ABL:欲望
	IF ABL:1	; 【[欲望]】
		SIF S
			PRINT  + 
		S = ABL:1
		PRINTFORM %ABLNAME:1%LV{S}({S})
	ENDIF
	;ABL:奉仕精神
	IF ABL:6	; 【[奉仕精神]】
		SIF S
			PRINT  + 
		S = ABL:6
		PRINTFORM %ABLNAME:6%LV{S}({S * 4})
	ENDIF

	;快楽刻印
	IF MARK:1	; 【[快楽依存]】
		SIF S
			PRINT  + 
		S = MARK:1
		PRINTFORM %MARKNAME:1%LV{S}({S * 2})
	ENDIF

	;PALAM:欲情
	IF PALAM:5 < PALAMLV:1	; 【[欲情]<PALAMLV:1】
		L = 0
	ELSEIF PALAM:5 < PALAMLV:2	; 【[欲情]<PALAMLV:2】
		L = 1
	ELSEIF PALAM:5 < PALAMLV:3	; 【[欲情]<PALAMLV:3】
		L = 2
	ELSEIF PALAM:5 < PALAMLV:4	; 【[欲情]<PALAMLV:4】
		L = 3
	ELSEIF PALAM:5 < PALAMLV:5	; 【[欲情]<PALAMLV:5】
		L = 4
	ELSE
		L = 5
	ENDIF
	IF L
		SIF S
			PRINT  + 
		S = L
		PRINTFORM %PALAMNAME:5%LV{L}({S})
	ENDIF

	;恥じらい
	IF TALENT:35	; 【[恥じらい]】
		PRINT  - 
		S = 1
		PRINTFORM %TALENTNAME:35%({S})
	ENDIF
	;汚臭鈍感
	IF TALENT:61	; 【[汚臭鈍感]】
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:61
		PRINTV '(,3,')
		S = 1
	ENDIF
	;汚臭敏感
	IF TALENT:62	; 【[汚臭敏感]】
		PRINT  - 
		PRINTS TALENTNAME:62
		PRINTV '(,3,')
		S = 1
	ENDIF
	;献身的
	IF TALENT:63	; 【[献身的]】
		SIF S
			PRINT  + 
		S = 6
		PRINTFORM %TALENTNAME:63%({S})
	ENDIF
	;快感の否定
	IF TALENT:71	; 【[快感の否定]】
		PRINT  - 
		S = 1
		PRINTFORM %TALENTNAME:71%({S})
	ENDIF
	;恋慕
	IF TALENT:85 && ASSIPLAY == 0	; 【[恋慕] / 調教者:[主人]】
		SIF S
			PRINT  + 
		S = 5
		PRINTFORM %TALENTNAME:85%({S})
	ENDIF

	Y = 0
	;愛液の汚れ
	SIF STAIN:PLAYER:1 & 1	; 【汚れ:[手]】
		Y += 1
	;精液の汚れ
	SIF STAIN:PLAYER:1 & 4	; 【汚れ:[手]】
		Y += 3
	;アナルの汚れ
	SIF STAIN:PLAYER:1 & 8	; 【汚れ:[手]】
		Y += 7
	SIF STAIN:PLAYER:1 & 16	; 【汚れ:[手]】
		Y += 15

	SIF TALENT:61	; 【[汚臭鈍感]】
		Y /= 3
	SIF TALENT:62	; 【[汚臭敏感]】
		Y *= 2

	;汚れあり
	IF Y
		PRINT  - 
		PRINT 汚れあり
		;汚臭鈍感
		IF TALENT:61	; 【[汚臭鈍感]】
			PRINTFORM 、%TALENTNAME:61%
		ELSEIF TALENT:62	; 【[汚臭敏感]】
			PRINTFORM 、%TALENTNAME:62%
		ENDIF
		PRINTFORM ({Y})
		S = 1
	ENDIF

	;好感度
	IF CFLAG:2 < 1000	; 【[好感度]<1000】
		B = 0
		PRINT  - 
		IF CFLAG:2 < 500	; 【[好感度]<500】
			B = 50
		ELSEIF CFLAG:2 < 750	; 【[好感度]<750】
			B = 20
		ELSEIF CFLAG:2 < 900	; 【[好感度]<900】
			B = 10
		ELSE
			B = 5
		ENDIF
		PRINT 好感度不足
		PRINTV '(,B,')
		S = 1
	ENDIF
	;好感度
	IF CFLAG:2 >= 1500	; 【[好感度]>=1500】
		B = 0
		SIF S
			PRINT  + 
		IF CFLAG:2 < 2000	; 【[好感度]<2000】
			B = 5
		ELSE
			B = CFLAG:2 / 200
		ENDIF
		PRINT 好感度
		PRINTV '(,B,')
		S = 1
	ENDIF

	;合意
	IF TALENT:152 == 0	; 【[合意]なし】
		PRINT  - 
		PRINTFORM %TALENTNAME:152%無し
		PRINTV '(,10,')
		S = 1
	ENDIF

	;合計を表示(60以上で実行)
	PRINT  = 
	PRINTV A


	SIF A < V
		PRINT  < 
	SIF A == V
		PRINT  = 
	SIF A > V
		PRINT  > 
	PRINT 実行値
	PRINTV V
	WAIT
ENDIF

