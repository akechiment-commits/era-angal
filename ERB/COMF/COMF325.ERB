;縁側でくつろぐ。キャラ固有の制限・特殊イベントは使用しない。
@COM_ABLE325
CALL COM_ABLE_COMMON, SELECTCOM
SIF RESULT == 0
	RETURN 0
SIF TFLAG:44 || TEQUIP:2 != 2 || ASSIPLAY || TFLAG:52
	RETURN 0
RETURN 1

@COM325
PRINTL 縁側でくつろぐ
CALL COM_ORDER_COMMON
SIF RESULT == 0
	RETURN 0
STR:0 = 縁側でくつろぐ
LOSEBASE:1 += 30
TFLAG:52 = 1
TFLAG:17 = 0
TFLAG:18 = 0
CALL GET_SUCCESS_RANK
A:1 = 190
A:2 = 190
IF TFLAG:18 == 1
	A:1 = 210
	A:2 = 230
ELSEIF TFLAG:18 == -1
	A:1 = 30
	A:2 = 30
ENDIF
CALL TRAIN_MESSAGE_B
CALL HEALING_COM325
SOURCE:18 += 150 + MAX(0, ABL:0) * 20
SOURCE:19 += 50 + MAX(0, ABL:0) * 20
TFLAG:30 += RAND:6 - 1
TFLAG:37 += 2
RETURN 1

@HEALING_COM325
BASE:TARGET:0 += A:1
BASE:TARGET:1 += A:2
BASE:TARGET:4 += A:1
BASE:MASTER:0 += A:1
BASE:MASTER:1 += A:2
BASE:MASTER:4 += A:1
CALL LIFE_LIMIT_MAXBASE
RETURN 0

@TRAIN_MESSAGE_COM325
SIF FLAG:6 && CFLAG:99 == 0
	PRINTFORML %CALLNAME:MASTER%と%CALLNAME:TARGET%は、縁側でお茶を飲みながらくつろいだ。
RETURN 0

@GET_SUCCESS_RANK
CALL GET_SUCCESS_RATE
B = MIN(99, 85 + A / 10)
A = RAND:100
IF A <= 9
	TFLAG:18 = 1
ELSEIF A >= B
	TFLAG:18 = -1
ELSE
	TFLAG:18 = 0
ENDIF
RETURN 0

@COM_ORDER_325

A = 0
B = 0
S = 0
V = 50

;すべての命令に共通の要素を考慮
;(親密が高いと命令に従いやすいなど)
CALL COM_ORDER

;男嫌い
IF TALENT:82 && TALENT:MASTER:122	; 【[男嫌い] / MASTER:[オトコ]】
	A -= 7
ENDIF
;恥じらい
IF TALENT:35	; 【[恥じらい]】
	A -= 5
ENDIF
;献身的
IF TALENT:63	; 【[献身的]】
	A += 6
ENDIF
;恋慕
IF TALENT:85	; 【[恋慕]】
	A += 5
ENDIF

;好感度不足
IF CFLAG:2 < 400	; 【[好感度]<400】
	IF CFLAG:2 < 50	; 【[好感度]<50】
		B = 40
	ELSEIF CFLAG:2 < 150	; 【[好感度]<150】
		B = 20
	ELSEIF CFLAG:2 < 300	; 【[好感度]<300】
		B = 10
	ELSE
		B = 5
	ENDIF
	A -= B
;好感度ボーナス
ELSEIF CFLAG:2 >= 500	; 【[好感度]>=500】
	B = CFLAG:2 / 75
	A += B
ENDIF

IF ((FLAG:23 & 1p27) == 0) && FLAG:2 != 1
	;男嫌い
	IF TALENT:82 && TALENT:MASTER:122	; 【[男嫌い] / MASTER:[オトコ]】
		PRINT  - 
		PRINTS TALENTNAME:82
		PRINTV '(,7,')
		S = 1
	ENDIF
	;恥じらい
	IF TALENT:35	; 【[恥じらい]】
		PRINT  - 
		PRINTS TALENTNAME:35
		PRINTV '(,5,')
		S = 1
	ENDIF
	;献身的
	IF TALENT:63	; 【[献身的]】
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:63
		PRINTV '(,6,')
		S = 1
	ENDIF
	;恋慕
	IF TALENT:85	; 【[恋慕]】
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:85
		PRINTV '(,5,')
		S = 1
	ENDIF

	;好感度
	IF CFLAG:2 < 400	; 【[好感度]<400】
		B = 0
		PRINT  - 
		IF CFLAG:2 < 50	; 【[好感度]<50】
			B = 40
		ELSEIF CFLAG:2 < 150	; 【[好感度]<150】
			B = 20
		ELSEIF CFLAG:2 < 300	; 【[好感度]<300】
			B = 10
		ELSE
			B = 5
		ENDIF
		PRINT 好感度不足
		PRINTV '(,B,')
		S = 1
	ENDIF

	;好感度
	IF CFLAG:2 >= 500	; 【[好感度]>=500】
		B = 0
		SIF S
			PRINT  + 
		B = CFLAG:2 / 75
		PRINT 好感度
		PRINTV '(,B,')
		S = 1
	ENDIF

	;合計を表示(50以上で実行)
	PRINT  = 
	PRINTV A

	IF A < V
		PRINT  < 
		PRINT 実行値
		PRINTV V
	ELSEIF A == V
		PRINT  = 
		PRINT 実行値
		PRINTV V
	ELSEIF A > V
		PRINT  > 
		PRINT 実行値
		PRINTV V
	ENDIF
	WAIT
ENDIF

