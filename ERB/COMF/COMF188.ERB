	;ゲージ消費
	BASE:TARGET:2 -= MAXBASE:TARGET:2
	SIF BASE:TARGET:2 >= MAXBASE:TARGET:2
		BASE:TARGET:2 = MAXBASE:TARGET:2 - 1
	;PLAYERのVに精液汚れ
	STAIN:MASTER:3 |= 4
	PRINTFORML 　
	IF LOCAL:51 >= 4
		PRINTFORML %CALLNAME:TARGET%もまた激しく腰を震わせ、%CALLNAME:PLAYER%の最奥めがけて大量の精を注ぎ込んだ……！
		PRINTFORML 受け止めきれない白濁が結合部から逆流し、二人の股間をどろどろに濡らしていく……
	ELSEIF LOCAL:51 >= 2
		PRINTFORML %CALLNAME:TARGET%もびくびくとペニスを脈打たせ、%CALLNAME:PLAYER%の膣奥にたっぷりと精を放った……！
		PRINTFORML 満ちた精液が結合部からとろりと溢れ出していく……
	ELSE
		PRINTFORML %CALLNAME:TARGET%もまた限界を迎え、%CALLNAME:PLAYER%の中に熱い精を吐き出した……！
	ENDIF
	;ふたなり同士、同時に注ぎ合った実感
	SIF LOCAL:50
		PRINTFORML 出しながら出される――二人は互いの最奥に精を注ぎ合い、混じり合う熱に深く打ち震えた……
ENDIF

;汚れ移動
STAIN:3 |= STAIN:PLAYER:2
STAIN:PLAYER:2 |= STAIN:3

;ふたなり同士V経験（双方）
PRINTS EXPNAME:40
PRINTL ＋４
