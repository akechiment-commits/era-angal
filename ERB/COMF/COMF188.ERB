IF BASE:TARGET:2 >= MAXBASE:TARGET:2
	;射精量の段階を算出（MAXBASEに対する倍率）
	LOCAL:51 = BASE:TARGET:2 / MAXBASE:TARGET:2
	SIF LOCAL:51 < 1
		LOCAL:51 = 1
