@COM_ORDER_188
A = 0
S = 0
V = 100

CALL COM_ORDER

;ABL:欲望
IF ABL:1
	A += ABL:1 * 3
ENDIF
;ABL:V感覚（TARGET）
IF ABL:4
	A += ABL:4 * 2
ENDIF
;ABL:奉仕精神
IF ABL:6
	A += ABL:6 * 4
ENDIF

;ムードボーナス
B = 0
IF TFLAG:37 < 10
	B -= 10
ELSEIF TFLAG:37 < 30
	B -= 1
ELSEIF TFLAG:37 < 50
	B += 1
ELSEIF TFLAG:37 < 100
	B += TFLAG:37 / 10
ELSE
	B += TFLAG:37 / 5
ENDIF
A += B

;好感度
IF CFLAG:2 < 2000
	IF CFLAG:2 < 1000
		A -= 50
	ELSEIF CFLAG:2 < 1300
		A -= 20
	ELSEIF CFLAG:2 < 1700
		A -= 10
	ELSE
		A -= 5
		ENDIF
ENDIF
SIF CFLAG:2 >= 2500
	A += CFLAG:2 / 250

;処女
IF TALENT:0
	A -= 20
ELSEIF EXP:0 < EXPLV:2
	A -= 5
ENDIF

;合意
SIF TALENT:152 == 0
	A -= 30

;恋慕・親愛
SIF TALENT:85 && ASSIPLAY == 0
	A += 5
SIF TALENT:88
	A += 8

;ふたなり同士の相性ボーナス
A += 10

IF ((FLAG:23 & 1p27) == 0) && FLAG:2 != 1
	;ABL:欲望
	IF ABL:1
		SIF S
			PRINT  + 
		PRINTS ABLNAME:1
		PRINTV 'LV,ABL:1,'(,ABL:1 * 3,')
		S = 1
	ENDIF
	;ABL:V感覚
	IF ABL:4
		SIF S
			PRINT  + 
		PRINTS ABLNAME:4
		PRINTV 'LV,ABL:4,'(,ABL:4 * 2,')
		S = 1
	ENDIF
	;ABL:奉仕精神
	IF ABL:6
		SIF S
			PRINT  + 
		PRINTS ABLNAME:6
		PRINTV 'LV,ABL:6,'(,ABL:6 * 4,')
		S = 1
	ENDIF
	;ムードボーナス
	B = 0
	IF TFLAG:37 < 10
		B -= 10
	ELSEIF TFLAG:37 < 30
		B -= 1
	ELSEIF TFLAG:37 < 50
		B += 1
	ELSEIF TFLAG:37 < 100
		B += TFLAG:37 / 10
	ELSE
		B += TFLAG:37 / 5
	ENDIF
	IF B < 0
		B = B * -1
		PRINT  - 
		PRINT ムード悪い
		PRINTV '(,B,')
		S = 1
	ELSEIF B > 0
		SIF S
			PRINT  + 
		PRINT ムード良い
		PRINTV '(,B,')
		S = 1
	ENDIF
	;好感度
	IF CFLAG:2 < 2000
		PRINT  - 
		IF CFLAG:2 < 1000
			B = 50
		ELSEIF CFLAG:2 < 1300
			B = 20
		ELSEIF CFLAG:2 < 1700
			B = 10
		ELSE
			B = 5
		ENDIF
		PRINT 好感度不足
		PRINTV '(,B,')
		S = 1
	ELSEIF CFLAG:2 >= 2500
		SIF S
			PRINT  + 
		PRINT 好感度
		PRINTV '(,CFLAG:2 / 250,')
		S = 1
	ENDIF
	;処女・V経験
	IF TALENT:0
		PRINT  - 
		PRINTS TALENTNAME:0
		PRINTV '(,20,')
		S = 1
	ELSEIF EXP:0 < EXPLV:2
		PRINT  - 
		PRINT V経験不足
		PRINTV '(,5,')
		S = 1
	ENDIF
	;合意
	IF TALENT:152 == 0
		PRINT  - 
		PRINTFORM %TALENTNAME:152%無し
		PRINTV '(,30,')
		S = 1
	ENDIF
	;恋慕・親愛
	IF TALENT:85 && ASSIPLAY == 0
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:85
		PRINTV '(,5,')
		S = 1
	ENDIF
	IF TALENT:88
		SIF S
			PRINT  + 
		PRINTS TALENTNAME:88
		PRINTV '(,8,')
		S = 1
	ENDIF
	;ふたなり同士の相性
	SIF S
		PRINT  + 
	PRINT ふたなり相性
	PRINTV '(,10,')
	S = 1
	;合計と必要値
	PRINT  = 
	PRINTV A
	SIF A < V
		PRINT  < 
	SIF A == V
		PRINT  = 
	SIF A > V
		PRINT  > 
	PRINT 実行値
	PRINTV V
	WAIT
ENDIF

RETURN A

