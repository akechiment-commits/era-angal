	SOURCE:3 = 150
ELSEIF ABL:4 == 1
	SOURCE:1 = 150
	SOURCE:3 = 250
ELSEIF ABL:4 == 2
	SOURCE:1 = 400
	SOURCE:3 = 350
ELSEIF ABL:4 == 3
	SOURCE:1 = 1000
	SOURCE:3 = 500
ELSEIF ABL:4 == 4
	SOURCE:1 = 1700
	SOURCE:3 = 700
ELSE
	SOURCE:1 = 950 + (ABL:4 * 250)
	SOURCE:3 = 250 + (ABL:4 * 150)
ENDIF

