@COM13
;アナルバイブ
;実行者が[淫具知識]を持っているなら効果増
SIF TALENT:PLAYER:58	; 【PLAYER:[淫具知識]】
	PRINT 高性能
PRINTL アナルバイブ

;-------------------------------------------------
;実行できるかの判定
;-------------------------------------------------
CALL COM_ORDER_COMMON
SIF RESULT == 0
	RETURN 0

STR:0 = アナルバイブ
CALL TRAIN_MESSAGE_B

;-------------------------------------------------
;実行決定
;-------------------------------------------------
LOSEBASE:0 += 60
LOSEBASE:1 += 150

;ABL:Ａ感覚をみる
IF ABL:5 == 0	; 【[Ａ感覚]Lv==0】
	SOURCE:2 = 80
	SOURCE:13 = 300
ELSEIF ABL:5 == 1	; 【[Ａ感覚]Lv==1】
	SOURCE:2 = 250
	SOURCE:13 = 800
ELSEIF ABL:5 == 2	; 【[Ａ感覚]Lv==2】
	SOURCE:2 = 600
	SOURCE:13 = 1400
ELSEIF ABL:5 == 3	; 【[Ａ感覚]Lv==3】
	SOURCE:2 = 1000
	SOURCE:13 = 1800
ELSEIF ABL:5 == 4	; 【[Ａ感覚]Lv==4】
	SOURCE:2 = 1300
	SOURCE:13 = 2100
ELSE
	SOURCE:2 = 700 + (ABL:5 * 200)
	SOURCE:13 = 1650 + (ABL:5 * 150)
ENDIF

;EXP:Ａ経験をみる
IF EXP:1 < EXPLV:1	; 【[Ａ経験]<EXPLV:1】
	TIMES SOURCE:2 , 0.50
	SOURCE:6 = 2000
ELSEIF EXP:1 < EXPLV:2	; 【[Ａ経験]<EXPLV:2】
	TIMES SOURCE:2 , 1.00
	SOURCE:6 = 300
ELSEIF EXP:1 < EXPLV:3	; 【[Ａ経験]<EXPLV:3】
	TIMES SOURCE:2 , 1.10
	SOURCE:6 = 50
ELSEIF EXP:1 < EXPLV:4	; 【[Ａ経験]<EXPLV:4】
	TIMES SOURCE:2 , 1.20
	SOURCE:6 = 10
ELSEIF EXP:1 < EXPLV:5	; 【[Ａ経験]<EXPLV:5】
	TIMES SOURCE:2 , 1.40
	SOURCE:6 = 0
ELSE
	TIMES SOURCE:2 , 1.60
	SOURCE:6 = 0
ENDIF

;PALAM:潤滑をみる
IF PALAM:3 < PALAMLV:1	; 【[潤滑]<PALAMLV:1】
	TIMES SOURCE:2 , 0.40
	SOURCE:6 += 800
ELSEIF PALAM:3 < PALAMLV:2	; 【[潤滑]<PALAMLV:2】
	TIMES SOURCE:2 , 0.80
	SOURCE:6 += 500
ELSEIF PALAM:3 < PALAMLV:3	; 【[潤滑]<PALAMLV:3】
	TIMES SOURCE:2 , 1.00
	SOURCE:6 += 300
ELSEIF PALAM:3 < PALAMLV:4	; 【[潤滑]<PALAMLV:4】
	TIMES SOURCE:2 , 1.40
	SOURCE:6 += 120
ELSEIF PALAM:3 >= PALAMLV:4	; 【[潤滑]>=PALAMLV:4】
	TIMES SOURCE:2 , 1.80
	SOURCE:6 += 100
ENDIF

;PALAM:欲情をみる
GETPALAMLV PALAM:5, 36
SOURCE:2 = SOURCE:2 * (8 + RESULT) / 10

;ABL:従順をみる
IF ABL:0 == 0	; 【[親密]Lv==0】
	TIMES SOURCE:2 , 0.80
ELSEIF ABL:0 == 1	; 【[親密]Lv==1】
	TIMES SOURCE:2 , 0.90
ELSEIF ABL:0 == 2	; 【[親密]Lv==2】
	TIMES SOURCE:2 , 1.00
ELSEIF ABL:0 == 3	; 【[親密]Lv==3】
	TIMES SOURCE:2 , 1.10
ELSEIF ABL:0 == 4	; 【[親密]Lv==4】
	TIMES SOURCE:2 , 1.20
ELSE
	IF SOURCE:2 < 100000
		SOURCE:2 = SOURCE:2 * (ABL:0 * 5 + 105) / 100
	ELSEIF SOURCE:2 < 100000000
		SOURCE:2 = SOURCE:2 / 100 * (ABL:0 * 5 + 105)
	ENDIF
ENDIF

;小柄体型
SIF TALENT:100	; 【[小柄体型]】
	TIMES SOURCE:6 , 2.00

;Ａ敏感、鈍感をみる
;快Ａ自体のチェックは後でまとめてやる
IF TALENT:105	; 【[Ａ鈍感]】
	TIMES SOURCE:6 , 1.50
	TIMES SOURCE:13 , 1.50
	TIMES SOURCE:14 , 1.50
ELSEIF TALENT:106	; 【[Ａ敏感]】
	TIMES SOURCE:6 , 0.60
	TIMES SOURCE:13 , 0.60
	TIMES SOURCE:14 , 0.60
ENDIF

IF EXP:0 == 0 && TALENT:30	; 【[貞操観念] / [Ｖ経験]==0】
	SOURCE:13 /= 3
ENDIF

;実行者が[淫具知識]を持っているなら効果増
SIF TALENT:PLAYER:58	; 【PLAYER:[淫具知識]】
	TIMES SOURCE:2 , 1.20

EXP:1 += 2
PRINTL Ａ経験＋２

;アナルバイブの着脱
IF TEQUIP:13	; 【[アナルバイブ]使用中】
	TEQUIP:13 = 0
ELSE
	TEQUIP:13 = 1
ENDIF

;主導権をチェック
IF TFLAG:45 == 0	; 【無[主導権]】
	;主導権が主人公側
	;ABL:従順をみる
	IF ABL:0 <= 1	; 【[親密]Lv<=1】
		SOURCE:21 += 300 + (ABL:0 * 50)
	ELSEIF ABL:0 <= 3	; 【[親密]Lv<=3】
		SOURCE:21 += 600 + (ABL:0 * 100)
	ELSEIF ABL:0 <= 5	; 【[親密]Lv<=5】
		SOURCE:21 += 800 + (ABL:0 * 120)
	ELSEIF ABL:0 <= 8	; 【[親密]Lv<=8】
		SOURCE:21 += 1000 + (ABL:0 * 140)
	ELSEIF ABL:0 <= 11	; 【[親密]Lv<=11】
		SOURCE:21 += 1200 + (ABL:0 * 160)
	ELSE
		SOURCE:21 += 1500 + (ABL:0 * 180)
	ENDIF
ELSE
	;主導権が相手側
	;ABL:サドっ気をみる
	IF ABL:15 == 0	; 【[サドっ気]Lv==0】
		SOURCE:20 = 600
	ELSEIF ABL:15 == 1	; 【[サドっ気]Lv==1】
		SOURCE:20 = 900
	ELSEIF ABL:15 == 2	; 【[サドっ気]Lv==2】
		SOURCE:20 = 1200
	ELSEIF ABL:15 == 3	; 【[サドっ気]Lv==3】
		SOURCE:20 = 1600
	ELSEIF ABL:15 == 4	; 【[サドっ気]Lv==4】
		SOURCE:20 = 2000
	ELSE
		SOURCE:20 = 1000 + (ABL:15 * 300)
	ENDIF
ENDIF

;好感度ランダム変化
A = RAND:10 + 5
;合意がないと好感度が下がる
IF TALENT:152 == 0 && TFLAG:48 == 0	; 【[合意]なし / 無[よっぱウフフ]】
	A -= 10
	SOURCE:15 += 500
ENDIF
TFLAG:30 += A
TFLAG:37 += A / 2

EXP:50 += 1
PRINTFORML %EXPNAME:50%＋１


RETURN 1

