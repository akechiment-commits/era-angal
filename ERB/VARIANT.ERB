@SPELL_NAME_CHANGE
CALL WEEK_MOYASHI

@WEEK_MOYASHI
;ぱっちぇさんのスペルは毎日変化するようにする
;※ただしイk…変えてないときに限る
P = -1
REPEAT CHARANUM
	SIF NO:COUNT == 8
		P = COUNT
REND
IF P > -1
	IF (CSTR:P:21 == "月符" && CSTR:P:22 == "サイレントセレナ") || (CSTR:P:21 == "火符" && CSTR:P:22 == "アグニレイディアンス") || (CSTR:P:21 == "水符" && CSTR:P:22 == "ベリーインレイク") || (CSTR:P:21 == "木符" && CSTR:P:22 == "グリーンストーム") || (CSTR:P:21 == "金符" && CSTR:P:22 == "シルバードラゴン") || (CSTR:P:21 == "土符" && CSTR:P:22 == "トリリトンシェイク") || (CSTR:P:21 == "日符" && CSTR:P:22 == "ロイヤルフレア")
		IF DAY:5 == 0
			CSTR:P:21 = 月符
			CSTR:P:22 = サイレントセレナ
		ELSEIF DAY:5 == 1
			CSTR:P:21 = 火符
			CSTR:P:22 = アグニレイディアンス
		ELSEIF DAY:5 == 2
			CSTR:P:21 = 水符
			CSTR:P:22 = ベリーインレイク
		ELSEIF DAY:5 == 3
			CSTR:P:21 = 木符
			CSTR:P:22 = グリーンストーム
		ELSEIF DAY:5 == 4
			CSTR:P:21 = 金符
			CSTR:P:22 = シルバードラゴン
		ELSEIF DAY:5 == 5
			CSTR:P:21 = 土符
			CSTR:P:22 = トリリトンシェイク
		ELSE
			CSTR:P:21 = 日符
			CSTR:P:22 = ロイヤルフレア
		ENDIF
	ENDIF
	IF (CSTR:P:23 == "日＆月符" && CSTR:P:24 == "ロイヤルダイアモンドリング") || (CSTR:P:23 == "火水木金土符" && CSTR:P:24 == "賢者の石")
		IF DAY:5 == 0 || DAY:5 == 6
			CSTR:P:23 = 日＆月符
			CSTR:P:24 = ロイヤルダイアモンドリング
		ELSE
			CSTR:P:23 = 火水木金土符
			CSTR:P:24 = 賢者の石
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------------------
;口上があるキャラ強調表示判定
;キャラ強調表示用の関数を用意する代わりに@SELF_KOJO_K関数で判定
;-------------------------------------------------------------
@KOJO_EXIST, ARG
VARSET LOCAL, 0
;現在のTARGET保存
LOCAL:1 = TARGET

;キャラの素質等の判定時にエラーが出るため一時的にあなたをTARGETにする
ADDCHARA 0
TARGET = CHARANUM - 1

;念のため非表示
SKIPDISP 1
;TFLAG:13に設定されていない数値を入れた上で呼び出す
TFLAG:13 = 999

TRYCCALLFORM SELF_KOJO_K{ARG}
	;口上がある場合
	LOCAL = 1
CATCH
	;口上がない場合
	LOCAL = 0
ENDCATCH

;非表示解除
SKIPDISP 0
DELCHARA TARGET

;TARGETを戻す
TARGET = LOCAL:1

;口上があれば1、なければ0でRETURN
RETURN LOCAL

