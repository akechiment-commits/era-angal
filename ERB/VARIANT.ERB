@EVENTTRAIN

;調教対象が慧音で時間が夜の時、1/3の確率で変身
IF TARGET >= 0
	IF NAME_CSV(NO:TARGET, 0) == "慧音" && TIME != 0 && RAND:3 == 0
		CALL HENSHIN
		DRAWLINE
		PRINTFORMW ＜慧音はハクタクの姿になった＞
	ENDIF
ENDIF

;助手が慧音で時間が夜の時、1/3の確率で変身
IF ASSI >= 0
	IF NAME_CSV(NO:ASSI, 0) == "慧音" && TIME != 0 && RAND:3 == 0
		CALL HENSHIN
		DRAWLINE
		PRINTFORMW ＜慧音はハクタクの姿になった＞
	ENDIF
ENDIF

@HENSHIN
;たぶん今後も使われないと思うので変身フラグにTEQUIP:1を使用。変身での素質変更を行なう。
IF TEQUIP:1 == 0
	;変身時(ハクタク化)
	TEQUIP:1 = 1
	IF NAME_CSV(NO:TARGET, 0) == "慧音"
		;種族変更
		CFLAG:14 = 6
		REPEAT 200
		L = COUNT + 600
		;素質の消滅処理。既に消滅している場合、PBAND:600～799に1を立てるだけで消滅しない
		;消滅素質：自制心(20)、保守的(24)、一線を越えない(27)、貞操観念(30)、濡れにくい(43)、人気(126)
		IF COUNT == 20 || COUNT == 24 || COUNT == 27 || COUNT == 30 || COUNT == 43 || COUNT == 126
			IF TALENT:COUNT == 0
				PBAND:L = 1
			ELSE
				PBAND:L = 0
				TALENT:COUNT = 0
			ENDIF
		;素質の習得処理。既に習得している場合、PBAND:600～799に2を立てるだけで習得しない
		;習得素質：解放(33)、濡れやすい(42)、汚れ無視(64)、両刀(81)、月光浴(116)
		ELSEIF COUNT == 33 || COUNT == 42 || COUNT == 64 || COUNT == 81 || COUNT == 116
			IF TALENT:COUNT == 1
				PBAND:L = 2
			ELSE
				PBAND:L = 0
				TALENT:COUNT = 1
			ENDIF
		ENDIF
		REND
	ELSE
		;種族変更
		CFLAG:ASSI:14 = 6
		REPEAT 200
		L = COUNT + 800
		;素質の消滅処理。既に消滅している場合、PBAND:800～999に1を立てるだけで消滅しない
		;消滅素質：自制心(20)、保守的(24)、一線を越えない(27)、貞操観念(30)、濡れにくい(43)、人気(126)
		IF COUNT == 20 || COUNT == 24 || COUNT == 27 || COUNT == 30 || COUNT == 43 || COUNT == 126
			IF TALENT:ASSI:COUNT == 0
				PBAND:L = 1
			ELSE
				PBAND:L = 0
				TALENT:ASSI:COUNT = 0
			ENDIF
		;素質の習得処理。既に習得している場合、PBAND:800～999に2を立てるだけで習得しない
		;習得素質：解放(33)、濡れやすい(42)、汚れ無視(64)、両刀(81)、月光浴(116)
		ELSEIF COUNT == 33 || COUNT == 42 || COUNT == 64 || COUNT == 81 || COUNT == 116
			IF TALENT:ASSI:COUNT == 1
				PBAND:L = 2
			ELSE
				PBAND:L = 0
				TALENT:ASSI:COUNT = 1
			ENDIF
		ENDIF
		REND
	ENDIF
ELSE
	;解除時(ハクタク解除)
	TEQUIP:1 = 0
	IF NAME_CSV(NO:TARGET, 0) == "慧音"
		;種族変更(人間になりた～い)
		CFLAG:14 = 1
		REPEAT 200
		L = COUNT + 600
		;変身解除時、習得処理を行なう(消滅していた素質は除く。PBAND:600～799に1が立っていたら習得処理を飛ばす)
		;習得素質：自制心(20)、保守的(24)、一線を越えない(27)、貞操観念(30)、濡れにくい(43)、人気(126)
		IF COUNT == 20 || COUNT == 24 || COUNT == 27 || COUNT == 30 || COUNT == 43 || COUNT == 126
			SIF PBAND:L == 0
				TALENT:COUNT = 1
		;変身解除時、消滅処理を行なう(習得していた素質は除く。PBAND:600～799に2が立っていたら消滅処理を飛ばす)
		;消滅素質：解放(33)、濡れやすい(42)、汚れ無視(64)、両刀(81)、月光浴(116)
		ELSEIF COUNT == 33 || COUNT == 42 || COUNT == 64 || COUNT == 81 || COUNT == 116
			SIF PBAND:L == 0
				TALENT:COUNT = 0
		ENDIF
		REND
	ELSE
		;種族変更(人間になりた～い)
		CFLAG:ASSI:14 = 1
		REPEAT 200
		L = COUNT + 800
		;変身解除時、習得処理を行なう(消滅していた素質は除く。PBAND:800～999に1が立っていたら習得処理を飛ばす)
		;習得素質：自制心(20)、保守的(24)、一線を越えない(27)、貞操観念(30)、濡れにくい(43)、人気(126)
		IF COUNT == 20 || COUNT == 24 || COUNT == 27 || COUNT == 30 || COUNT == 43 || COUNT == 126
			SIF PBAND:L == 0
				TALENT:ASSI:COUNT = 1
		;変身解除時、消滅処理を行なう(習得していた素質は除く。PBAND:800～999に2が立っていたら消滅処理を飛ばす)
		;消滅素質：解放(33)、濡れやすい(42)、汚れ無視(64)、両刀(81)、月光浴(116)
		ELSEIF COUNT == 33 || COUNT == 42 || COUNT == 64 || COUNT == 81 || COUNT == 116
			SIF PBAND:L == 0
				TALENT:ASSI:COUNT = 0
		ENDIF
		REND
	ENDIF
ENDIF

