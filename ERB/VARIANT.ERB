;-------------------------------------------------------------
;口上があるキャラ強調表示判定
;-------------------------------------------------------------
@KOJO_EXIST, ARG
VARSET LOCAL, 0
LOCAL:1 = TARGET

ADDCHARA 0
TARGET = CHARANUM - 1

SKIPDISP 1
TFLAG:13 = 999

TRYCCALLFORM SELF_KOJO_K{ARG}
	LOCAL = 1
CATCH
	LOCAL = 0
ENDCATCH

SKIPDISP 0
DELCHARA TARGET

TARGET = LOCAL:1

RETURN LOCAL

