;---------------------------------------------------------
;学習状況の表示
;---------------------------------------------------------
@SHOW_STUDY_STATUS
CALL CALC_ACADEMIC_LEVEL, MASTER
DRAWLINE

IF TARGET >= 0
	CALL CALC_ACADEMIC_LEVEL, TARGET
	PRINTFORML （%CALLNAME:TARGET%）  学力：{ABL:88}  学習素質：{ABL:98}  学習経験：{EXP:TARGET:95}
	PRINT 体力
	A = BASE:0
	SIF BASE:0 < 0
		A = 0
	CALL PRINT_BAR_0, A, MAXBASE:0, 32
	PRINTFORML ({A}/{MAXBASE:0})
	PRINT 気力
	A = BASE:1
	SIF BASE:1 < 0
		A = 0
	CALL PRINT_BAR, A, MAXBASE:1, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
	PRINTFORML ({A}/{MAXBASE:1})
ENDIF

PRINTFORML （%CALLNAME:MASTER%）  学力：{ABL:MASTER:88}  学習素質：{ABL:MASTER:98}  学習経験：{EXP:MASTER:95}
PRINT 体力
A = BASE:MASTER:0
SIF BASE:MASTER:0 < 0
	A = 0
CALL PRINT_BAR_0, A, MAXBASE:MASTER:0, 32
PRINTFORML ({A}/{MAXBASE:MASTER:0})
PRINT 気力
A = BASE:MASTER:1
SIF BASE:MASTER:1 < 0
	A = 0
CALL PRINT_BAR, A, MAXBASE:MASTER:1, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
PRINTFORML ({A}/{MAXBASE:MASTER:1})

DRAWLINE
RETURN 1

;---------------------------------------------------------
;授業・自習セッション（旧BATTLE_NORMAL）
;---------------------------------------------------------
@STUDY_SESSION
PRINTL 

;授業の種類をランダム決定
A = RAND:100
IF A <= 20
	STR:0 = 国語
ELSEIF A <= 40
	STR:0 = 数学
ELSEIF A <= 55
	STR:0 = 英語
ELSEIF A <= 70
	STR:0 = 理科
ELSEIF A <= 85
	STR:0 = 社会
ELSEIF A <= 92
	STR:0 = 体育
ELSEIF A <= 96
	STR:0 = 音楽
ELSE
	STR:0 = 家庭科
ENDIF

;成否判定
CALL GET_EXAM_SCORE
B = 70 + P / 50
SIF B > 99
	B = 99
A = RAND:100
IF A <= 10
	;10%で大成功（よく理解できた）
	TFLAG:18 = 1
ELSEIF A >= B
	;失敗（ついていけなかった）
	TFLAG:18 = -1
ELSE
	;通常
	TFLAG:18 = 0
ENDIF

;メッセージ表示
IF TARGET >= 0
	PRINTFORMW %CALLNAME:MASTER%は%CALLNAME:TARGET%と一緒に%STR:0%の授業を受けた
ELSE
	PRINTFORMW %CALLNAME:MASTER%は%STR:0%の授業を受けた
ENDIF

IF TFLAG:18 == 1
	PRINTFORML 今日の授業はとてもよく理解できた！
ELSEIF TFLAG:18 == -1
	PRINTFORML ……しかし、内容が難しくてあまり理解できなかった
ENDIF

;体力・気力消費
BASE:MASTER:4 -= 30
BASE:MASTER:1 -= 50

;学習経験の獲得
A = RAND:10
IF A <= 5
	B = 1
ELSEIF A <= 8
	B = 2
ELSE
	B = 3
ENDIF

IF TFLAG:18 == -1
	B -= 1
	SIF B < 0
		B = 0
ELSEIF TFLAG:18 == 1
	B += 1
ENDIF

IF B > 0
	EXP:MASTER:95 += B
	PRINTFORML %EXPNAME:95%+{B}（%CALLNAME:MASTER%）
	IF TARGET >= 0
		EXP:TARGET:95 += B
		PRINTFORML %EXPNAME:95%+{B}（%CALLNAME:TARGET%）
	ENDIF
ENDIF

;好感度変動（パートナーと一緒の場合）
IF TARGET >= 0
	A = RAND:5 - 1
	IF TFLAG:18 == 1
		A += 2
	ELSEIF TFLAG:18 == -1
		A -= 1
	ENDIF
	TFLAG:30 += A

ENDIF

;ソース（好感度ポイント）
SOURCE:18 = 50
IF TFLAG:18 == 1
	TIMES SOURCE:18 , 2.00
ELSEIF TFLAG:18 == -1
	TIMES SOURCE:18 , 0.50
ENDIF

;学習進度を進める
SIF FLAG:27 < 10
	FLAG:27 += 1
SIF FLAG:27 > 10 && FLAG:27 < 20
	FLAG:27 += 1

RETURN 1

;---------------------------------------------------------
;試験を受ける（旧BATTLE_BOSS）
;---------------------------------------------------------
@TAKE_EXAM
PRINTL 

;試験名決定（TFLAG:83 0=中間 1=期末）
IF TFLAG:83 == 0
	STR:0 = 中間試験
ELSE
	STR:0 = 期末試験
ENDIF

CALL GET_SEMESTER_NAME
PRINTFORML ＝＝＝ %STR:10% %STR:0% ＝＝＝
PRINTL 

;試験スコア計算（学力を事前に自動算出）
CALL CALC_ACADEMIC_LEVEL, MASTER
CALL GET_EXAM_SCORE

;難易度による合格ラインの調整
;合格ライン（学年が進むほど難化: 1年=45, 2年=55, 3年=65）
LOCAL:5 = 35 + FLAG:24 * 10

;ランダム変動（±10点）
A = RAND:21 - 10
P += A

;パートナーがいれば勉強を教えてもらえるボーナス
IF TARGET >= 0
	;パートナーの学力で補正
	LOCAL:3 = ABL:88 / 5
	;好感度でさらに補正
	IF CFLAG:2 >= 500
		LOCAL:3 += 10
	ELSEIF CFLAG:2 >= 200
		LOCAL:3 += 5
	ELSEIF CFLAG:2 >= 50
		LOCAL:3 += 2
	ENDIF
	P += LOCAL:3
	PRINTFORML %CALLNAME:TARGET%が勉強を手伝ってくれた（+{LOCAL:3}点）
ENDIF

SIF P < 0
	P = 0
SIF P > 100
	P = 100

;結果表示
PRINTFORML あなたの得点：{P}点（合格ライン：{LOCAL:5}点）
PRINTL 

;気力消費（試験は疲れる）
BASE:MASTER:1 -= 100

;合否判定
IF P >= LOCAL:5
	;合格
	PRINTFORML ＊＊＊ 合格！ ＊＊＊
	IF P >= LOCAL:5 + 30
		PRINTFORML 素晴らしい成績です！クラスでもトップクラスの点数でした
		SOURCE:18 = 500
		SOURCE:5 = 200
	ELSEIF P >= LOCAL:5 + 15
		PRINTFORML なかなかの好成績です
		SOURCE:18 = 300
		SOURCE:5 = 100
	ELSE
		PRINTFORML ギリギリですが、合格は合格です
		SOURCE:18 = 150
		SOURCE:5 = 50
	ENDIF
	
	;学習経験ボーナス（学期で微増）
	LOCAL:9 = DAY / 10 % 12
	IF LOCAL:9 <= 3
		B = 3
	ELSEIF LOCAL:9 <= 8
		B = 4
	ELSE
		B = 5
	ENDIF
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度ボーナス
	IF TARGET >= 0
		TFLAG:30 += 5
	ENDIF
	
	;試験クリア処理（FLAG:27=ビットマスク bit0=中間1,bit1=期末1,bit2=中間2,bit3=期末2,bit4=試験3）
	IF TFLAG:83 == 0
		;中間試験合格
		FLAG:27 |= TFLAG:84
		PRINTFORMW 中間試験に合格！後半戦もしっかり頑張ろう。
		RETURN 1
	ELSE
		;期末試験合格
		FLAG:27 |= TFLAG:84
		CALL SEMESTER_DECK_RESULT
		CALL GET_SEMESTER_NAME
		PRINTFORMW 期末試験に合格！次のステージへ！
		RETURN 2
	ENDIF
ELSE
	;不合格
	PRINTFORML ……不合格
	IF P < LOCAL:5 - 20
		PRINTFORML かなり厳しい結果です。もっと勉強が必要でしょう
	ELSE
		PRINTFORML もう少しで合格でした。次は頑張りましょう
	ENDIF
	SOURCE:18 = 30
	
	;不合格でも経験値は少し入る
	B = 1
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度少し下がる
	SIF TARGET >= 0
		TFLAG:30 -= 2
ENDIF

PRINTW 

RETURN 1

;---------------------------------------------------------
;試験スコア計算
;結果はPに格納（0～100の範囲目安）
;ABL:88は学習素質・学習経験から自動算出済み（CALC_ACADEMIC_LEVEL参照）
;---------------------------------------------------------
@GET_EXAM_SCORE
P = 0

;学力（ABL:88 = 学習素質+学習経験から自動算出）
P = 20 + ABL:MASTER:88 * 4

;知識技能(ABL:95)の補正
LOCAL:0 = ABL:MASTER:95
IF LOCAL:0 > 0
	IF LOCAL:0 <= 10
		P += LOCAL:0 * 2
	ELSEIF LOCAL:0 <= 30
		P += 20 + (LOCAL:0 - 10)
	ELSE
		P += 40 + (LOCAL:0 - 30) / 2
	ENDIF
ENDIF

;上限
SIF P > 95
	P = 95

RETURN 1

;---------------------------------------------------------
;学力の自動算出（学習素質 + 学習経験 → ABL:88にセット）
;ARG:0 = キャラインデックス（例: CALL CALC_ACADEMIC_LEVEL, MASTER）
;---------------------------------------------------------
@CALC_ACADEMIC_LEVEL
LOCAL:0 = ARG:0
ABL:LOCAL:0:88 = EXP:LOCAL:0:95 * ABL:LOCAL:0:98 * ABL:LOCAL:0:98 / 50000
RETURN 1

;---------------------------------------------------------
;以下、旧戦闘システムの関数（互換性のため残置）
;emuera.configの設定により呼び出されなければ無視される
;---------------------------------------------------------

;---------------------------------------------------------
;学期末試験 自動発動版
;ENDING_CHECK(日数切れ)から呼ばれる
;合格 → 次の学期へ（RETURN 1）
;不合格 → バッドエンド処理
;---------------------------------------------------------
@SEMESTER_EXAM_AUTO
;TFLAG:83: 0=中間試験 1=期末試験
PRINTL
CALL GET_SEMESTER_NAME
IF TFLAG:83 == 0
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
	PRINTFORML 　%STR:10% 中間試験の時期になりました！
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
ELSE
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
	PRINTFORML 　%STR:10% 期末試験の時期になりました！
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
ENDIF
WAIT

CALL TAKE_EXAM

IF RESULT == 2
	;期末合格 → 次学期（FLAG:24はTAKE_EXAM内で進んでいる）
	RETURN 1
ELSEIF RESULT == 1
	;中間合格 → 後半へ（FLAG:27=1はTAKE_EXAM内で設定済み）
	RETURN 1
ELSE
	;不合格 → バッドエンド
	PRINTFORML
	IF TFLAG:83 == 0
		PRINTFORML 中間試験に合格できなかった。
	ELSE
		PRINTFORML 期末試験に合格できなかった。
	ENDIF
	PRINTFORMW %CALLNAME:MASTER%の学院生活はここで終わりを迎えた……
	PRINTFORML
	PRINTFORMW 　　　　　　　　―― Bad Ending（試験不合格）
	PRINTFORML
	PRINTFORMW 今の状態を引き継いで、最初からやり直せます。どうしますか？
	PRINTFORML [0] こんな事はなかった事に！
	PRINTFORML [1] やり直さない（ゲーム終了）
	$INPUT_LOOP_FAIL
	INPUT
	SIF RESULT != 0 && RESULT != 1
		GOTO INPUT_LOOP_FAIL
	IF RESULT == 0
		PRINTFORMW それでは1日目、1年生の4月に戻ります。
		REPEAT CHARANUM
			SIF TALENT:COUNT:134 || MARK:COUNT:90
				CFLAG:COUNT:110 -= DAY
		REND
		DAY = 0
		TIME = 0
		FLAG:24 = 1
		FLAG:25 = 0
		FLAG:26 += 1
		FLAG:27 = 0
		FLAG:31 = 0
		FLAG:32 = 0
		TARGET = -1
		ASSI = -1
		CALL START_PARTNER_SELECT
	ELSEIF RESULT == 1
		PRINTFORMW お疲れ様でした。
		QUIT
	ENDIF
ENDIF
RETURN 1

