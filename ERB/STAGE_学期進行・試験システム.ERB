	LOCAL:19 = LOCAL:0 + RAND:2	; 【[愛情経験]増加量】
	LOCAL:20 = LOCAL:0 + 2 + RAND:4	; 【[キス経験]増加量】
	LOCAL:25 = LOCAL:20 * (110 + RAND:50) + RAND:60	; 【[快Ｍの珠]】
	LOCAL:26 = LOCAL:0 * (240 + RAND:80) + RAND:90	; 【[恭順の珠]】
	LOCAL:27 = LOCAL:0 * (200 + RAND:70) + RAND:80	; 【[好意の珠]】
	LOCAL:40 = LOCAL:0 * (11 + RAND:5) + RAND:10	; 【[好感度]増加量】
	CFLAG:TARGET:2 += LOCAL:40	; 【TARGET:[好感度]加算】
	EXP:TARGET:23 += LOCAL:19	; 【TARGET:[愛情経験]加算】
	EXP:TARGET:96 += LOCAL:20	; 【TARGET:[キス経験]加算】
	EXP:MASTER:96 += LOCAL:20	; 【MASTER:[キス経験]加算】
	JUEL:TARGET:18 += LOCAL:25	; 【TARGET:[快Ｍの珠]加算】
	JUEL:TARGET:4 += LOCAL:26	; 【TARGET:[恭順の珠]加算】
	JUEL:TARGET:15 += LOCAL:27	; 【TARGET:[好意の珠]加算】
	CFLAG:TARGET:1286 = 1 + (ARG >= 15)	; 【TARGET:[行事後余韻フラグ]=1～2】
	FLAG:1286 = 1	; 【行事後余韻新規付与フラグ】
	PRINTL
	PRINTFORM 好感度＋{LOCAL:40} ／ %EXPNAME:23%＋{LOCAL:19} ／ %EXPNAME:96%＋{LOCAL:20} ／ %NAME:MASTER%の%EXPNAME:96%＋{LOCAL:20}
	IF FLAG:23 & 1p25
		PRINTFORML  ／ %PALAMNAME:18%の珠＋{LOCAL:25} ／ %PALAMNAME:4%の珠＋{LOCAL:26} ／ %PALAMNAME:15%の珠＋{LOCAL:27}
	ELSE
		PRINTL  ／ 宝珠獲得
	ENDIF
	WAIT
	RETURN 1
ENDIF
RETURN 0
