@GET_SEMESTER_NAME
;FLAG:24=学年(1=1年生,2=2年生,3=3年生,4+=卒業)、月で学期名をSTR:10に設定
LOCAL:9 = DAY / 10 % 12
IF FLAG:24 >= 4
	STR:10 = 卒業済み
ELSEIF LOCAL:9 <= 3
	STR:10 = {FLAG:24}年 1学期（4～7月）
ELSEIF LOCAL:9 == 4
	STR:10 = {FLAG:24}年 夏休み（8月）
ELSEIF LOCAL:9 <= 8
	STR:10 = {FLAG:24}年 2学期（9～12月）
ELSE
	STR:10 = {FLAG:24}年 3学期（1～3月）
ENDIF
RETURN 1

