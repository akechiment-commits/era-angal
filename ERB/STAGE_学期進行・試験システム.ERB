@TAKE_EXAM
; RETURN 1=中間試験合格、2=期末試験合格、3=不合格（追試へ）
PRINTL 

;試験名決定（TFLAG:83 0=中間 1=期末）
IF TFLAG:83 == 0
	STR:0 = 中間試験
ELSE
	STR:0 = 期末試験
ENDIF

CALL GET_SEMESTER_NAME
PRINTFORML ＝＝＝ %STR:10% %STR:0% ＝＝＝
PRINTL 

;試験スコア計算（学力を事前に自動算出）
CALL CALC_ACADEMIC_LEVEL, MASTER
CALL GET_EXAM_SCORE

;難易度による合格ラインの調整
;合格ライン（学年が進むほど難化: 1年=45, 2年=55, 3年=65）
LOCAL:5 = 35 + FLAG:24 * 10

;ランダム変動（±10点）
A = RAND:21 - 10
P += A

;パートナーがいれば勉強を教えてもらえるボーナス
IF TARGET >= 0 && CFLAG:TARGET:2 > -100	; 嫌悪時は手伝わない
	;パートナーの学力で補正
	CALL CALC_ACADEMIC_LEVEL, TARGET
	LOCAL:3 = ABL:TARGET:88 / 20
	;好感度でさらに補正
	IF CFLAG:2 >= 500	; 【[好感度]>=500】
		LOCAL:3 += 10
	ELSEIF CFLAG:2 >= 200	; 【[好感度]>=200】
		LOCAL:3 += 5
	ELSEIF CFLAG:2 >= 50	; 【[好感度]>=50】
		LOCAL:3 += 2
	ENDIF
	P += LOCAL:3
	PRINTFORML %CALLNAME:TARGET%が勉強を手伝ってくれた（+{LOCAL:3}点）
ENDIF

SIF P < 0
	P = 0
SIF P > 100
	P = 100

;結果表示
PRINTFORML あなたの得点：{P}点（合格ライン：{LOCAL:5}点）
	;パートナーとの試験結果記録
	IF TARGET >= 1 && TARGET < CHARANUM
		CFLAG:TARGET:1272 = P
		SIF P > CFLAG:TARGET:1271	; 【TARGET:[最高試験得点]】
			CFLAG:TARGET:1271 = P
	ENDIF
PRINTL 

;気力消費（試験は疲れる）
BASE:MASTER:1 -= 100

;--- 学期の区切り：長期学習経験の忘却(減衰)＋今学期勉強量のリセット ---
;過去の貯金だけで合格できないよう、試験のたびに学習経験を約1割忘れ、今学期分は0に戻す
EXP:MASTER:95 -= EXP:MASTER:95 / 10
SIF EXP:MASTER:95 < 0	; 【MASTER:[学習経験]<0】
	EXP:MASTER:95 = 0
FLAG:210 = 0

;合否判定
IF P >= LOCAL:5
	;合格
	PRINTFORML ＊＊＊ 合格！ ＊＊＊
	IF P >= LOCAL:5 + 30
		PRINTFORML 素晴らしい成績です！クラスでもトップクラスの点数でした
		SOURCE:18 = 500
		SOURCE:5 = 200
	ELSEIF P >= LOCAL:5 + 15
		PRINTFORML なかなかの好成績です
		SOURCE:18 = 300
		SOURCE:5 = 100
	ELSE
		PRINTFORML ギリギリですが、合格は合格です
		SOURCE:18 = 150
		SOURCE:5 = 50
	ENDIF
	
	;学習経験ボーナス（学期で微増）
	LOCAL:9 = DAY / 10 % 12
	IF LOCAL:9 <= 3
		B = 3
	ELSEIF LOCAL:9 <= 8
		B = 4
	ELSE
		B = 5
	ENDIF
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度ボーナス
	IF TARGET >= 0
		TFLAG:30 += 5
	ENDIF
	
	;試験クリア処理（FLAG:27=ビットマスク bit0=中間1,bit1=期末1,bit2=中間2,bit3=期末2,bit4=試験3）
	IF TFLAG:83 == 0
		;中間試験合格
		FLAG:27 |= TFLAG:84
		IF TARGET >= 0 && BASE:TARGET:0 > 0	; 【TARGET:[体力]>0】
			LOCAL:7 = 1
			SIF P >= LOCAL:5 + 30
				LOCAL:7 = 2
			SIF CFLAG:TARGET:2 > -100	; 【TARGET:[好感度]>-100（嫌悪中は口上を表示しない）】
			TRYCALLFORM CHAR_EXAM_RESULT_{NO:TARGET}(LOCAL:7)
			CALL EXAM_PASS_AFTER_ICHA, (P - LOCAL:5)
		ENDIF
		PRINTFORMW 中間試験に合格！後半戦もしっかり頑張ろう。
		RETURN 1
	ELSE
		;期末試験合格
		FLAG:27 |= TFLAG:84
		CALL SEMESTER_DECK_RESULT
		CALL GET_SEMESTER_NAME
		IF TARGET >= 0 && BASE:TARGET:0 > 0	; 【TARGET:[体力]>0】
			LOCAL:7 = 1
			SIF P >= LOCAL:5 + 30
				LOCAL:7 = 2
			SIF CFLAG:TARGET:2 > -100	; 【TARGET:[好感度]>-100（嫌悪中は口上を表示しない）】
			TRYCALLFORM CHAR_EXAM_RESULT_{NO:TARGET}(LOCAL:7)
			CALL EXAM_PASS_AFTER_ICHA, (P - LOCAL:5)
		ENDIF
		PRINTFORMW 期末試験に合格！次のステージへ！
		RETURN 2
	ENDIF
ELSE
	;不合格
	PRINTFORML ……不合格
	IF P < LOCAL:5 - 20
		PRINTFORML かなり厳しい結果です。もっと勉強が必要でしょう
	ELSE
		PRINTFORML もう少しで合格でした。次は頑張りましょう
	ENDIF
	IF TARGET >= 0 && BASE:TARGET:0 > 0	; 【TARGET:[体力]>0】
		SIF CFLAG:TARGET:2 > -100	; 【TARGET:[好感度]>-100（嫌悪中は口上を表示しない）】
		TRYCALLFORM CHAR_EXAM_RESULT_{NO:TARGET}(0)
	ENDIF
	SOURCE:18 = 30
	
	;不合格でも経験値は少し入る
	B = 1
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度少し下がる
	SIF TARGET >= 0
		TFLAG:30 -= 2

	;--- 不合格ペナルティ：ゲームオーバーではなく追試期間に入る ---
	;追試期間中は女の子と過ごしたり部活ができず、自習で挽回する
	FLAG:211 = 1
	PRINTFORMW 追試になってしまった……。自習で学力を上げてから「追試を受ける」で受け直そう。それまでは女の子と過ごしたり、部活に出ることはできない。
ENDIF

PRINTW 

RETURN 3

;---------------------------------------------------------
;試験スコア計算
;結果はPに格納（0～100の範囲目安）
;ABL:88は学習素質・学習経験から自動算出済み（CALC_ACADEMIC_LEVEL参照）
;---------------------------------------------------------
@GET_EXAM_SCORE
P = 0

;--- 学力＝「長期の基礎学力」＋「今学期の勉強量」のハイブリッド ---
;基礎成分（学習素質ABL:98＋長期の学習経験EXP:95）。上限45 ≒ 全体の約4割
LOCAL:0 = 20 + ABL:MASTER:98 / 4 + EXP:MASTER:95 / 12
SIF LOCAL:0 > 45
	LOCAL:0 = 45
;今学期の勉強成分（FLAG:210）。上限60 ≒ 全体の約6割。試験のたびに0へリセットされる
LOCAL:1 = FLAG:210 * 2
SIF LOCAL:1 > 60
	LOCAL:1 = 60
P = LOCAL:0 + LOCAL:1

;知識技能(ABL:95)の小補正（上限10）
LOCAL:2 = ABL:MASTER:95
SIF LOCAL:2 > 10
	LOCAL:2 = 10
SIF LOCAL:2 > 0
	P += LOCAL:2

;上限
SIF P > 100
	P = 100

RETURN 1

;---------------------------------------------------------
;学力の自動算出（学習素質 + 学習経験 → ABL:88にセット）
;ARG:0 = キャラインデックス（例: CALL CALC_ACADEMIC_LEVEL, MASTER）
;---------------------------------------------------------
@CALC_ACADEMIC_LEVEL(ARG)
LOCAL:0 = TARGET
TARGET = ARG:0
;学力は学習素質と学習経験だけで算出する（学力購入は廃止）
CFLAG:TARGET:88 = 0
ABL:TARGET:88 = ABL:TARGET:98 + EXP:TARGET:95 * ABL:TARGET:98 / 500
TARGET = LOCAL:0
RETURN 1

;---------------------------------------------------------
;以下、旧戦闘システムの関数（互換性のため残置）
;emuera.configの設定により呼び出されなければ無視される
;---------------------------------------------------------

;---------------------------------------------------------
;学期末試験 自動発動版
;ENDING_CHECK(日数切れ)から呼ばれる
; TAKE_EXAMの結果に応じて処理
;不合格 → 追試ルートへ
;---------------------------------------------------------
@SEMESTER_EXAM_AUTO
;TFLAG:83: 0=中間試験 1=期末試験
PRINTL
CALL GET_SEMESTER_NAME
IF TFLAG:83 == 0
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
	PRINTFORML 　%STR:10% 中間試験の時期になりました！
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
ELSE
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
	PRINTFORML 　%STR:10% 期末試験の時期になりました！
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
ENDIF
WAIT

IF TARGET >= 0
	IF BASE:TARGET:0 <= 0	; 【TARGET:[体力]<=0】
		PRINTFORML 保健室で静かに療養している%CALLNAME:TARGET%のことを気にかけつつ、試験会場へと向かった……
	ELSE
		SIF CFLAG:TARGET:2 > -100	; 嫌悪時は試験前口上なし
		TRYCALLFORM CHAR_EXAM_BEFORE_{NO:TARGET}
	ENDIF
ENDIF
CALL TAKE_EXAM

IF RESULT == 2
	;期末合格 → 次学期（FLAG:24はTAKE_EXAM内で進んでいる）
	RETURN 1
ELSEIF RESULT == 1
	;中間合格 → 後半へ（FLAG:27=1はTAKE_EXAM内で設定済み）
	RETURN 1
ELSEIF RESULT == 3
	; 不合格は追試ルートへ進める
	RETURN 1
ELSE
	; 想定外の戻り値 → バッドエンド
	PRINTFORML
	IF TFLAG:83 == 0
		PRINTFORML 中間試験に合格できなかった。
	ELSE
		PRINTFORML 期末試験に合格できなかった。
	ENDIF
	PRINTFORMW %CALLNAME:MASTER%の学院生活はここで終わりを迎えた……
	PRINTFORML
	PRINTFORMW 　　　　　　　　―― Bad Ending（試験不合格）
	PRINTFORML
	PRINTFORMW 今の状態を引き継いで、最初からやり直せます。どうしますか？
	PRINTFORML [0] こんな事はなかった事に！
