;---------------------------------------------------------
;学期進行・試験システム
;旧STAGE.ERB（戦闘システム）を学園生活用に全面改修
;
;学期進行メニュー
;	@STAGE_CAPTURE
@GET_SEMESTER_NAME
;FLAG:24=学年(1=1年生,2=2年生,3=3年生,4+=卒業)、月で学期名をSTR:10に設定
LOCAL:9 = DAY / 10 % 12
IF FLAG:24 >= 4
	STR:10 = 卒業済み
ELSEIF LOCAL:9 <= 3
	STR:10 = {FLAG:24}年 1学期（4～7月）
ELSEIF LOCAL:9 == 4
	STR:10 = {FLAG:24}年 夏休み（8月）
ELSEIF LOCAL:9 <= 8
	STR:10 = {FLAG:24}年 2学期（9～12月）
ELSE
	STR:10 = {FLAG:24}年 3学期（1～3月）
ENDIF
RETURN 1

;---------------------------------------------------------
;学期進行メインメニュー
;---------------------------------------------------------
@STAGE_CAPTURE
DRAWLINE
CALL GET_SEMESTER_NAME

;今月残り日数
LOCAL:0 = 10 - DAY % 10 - 1

PRINTFORML 【どこへ行く？】
PRINTFORML 現在: %STR:10%　{DAY:8}月 {DAY:1}日（今月残り{LOCAL:0}日）
PRINTFORML 今月イベントPT:{FLAG:32}　体力:{BASE:MASTER:0}/{MAXBASE:MASTER:0}
PRINTL
PRINTFORML [0] 教室へ行く（各クラスを訪問）
PRINTFORML [1] 部室へ行く（各部活の部室を訪問）
PRINTFORML [2] 委員会室へ行く（各委員会を訪問）
PRINTFORML [3] イベントボード（体力消費でPT獲得）
PRINTFORML [4] ガチャ（カードを引いてキャラを強化）
PRINTFORML [5] カードコレクション（所持カード確認）
PRINTFORML [9] 戻る
PRINTL

$INPUT_LOOP
INPUT
IF RESULT == 0
	CALL LOCATION_SUBMENU_CLASS
	RETURN RESULT
ELSEIF RESULT == 1
	CALL LOCATION_SUBMENU_CLUB
	RETURN RESULT
ELSEIF RESULT == 2
	CALL LOCATION_SUBMENU_COMMITTEE
	RETURN RESULT
ELSEIF RESULT == 3
	CALL EVENT_BOARD_MAIN
	RETURN RESULT
ELSEIF RESULT == 4
	CALL GACHA_MAIN
ELSEIF RESULT == 5
	CALL CARD_COLLECTION_MAIN
ELSEIF RESULT == 9
	RETURN 0
ELSE
	GOTO INPUT_LOOP
ENDIF
RETURN 0


