;---------------------------------------------------------
; スコア上位5人を自動選出
; REPEAT 5（COUNT=スロット）× FOR LOCAL（キャラループ）
; CFLAG:LOCAL:X で2引数、正常
;---------------------------------------------------------
@AUTO_SELECT_DECK
;カード所持数から補正を更新してから、実戦と同じ式で選ぶ
CALL CARD_RECALC_BONUSES
REPEAT 5
	FLAG:(200 + COUNT) = -1
REND

REPEAT 5
	A = -1	;ベストキャラインデックス
	B = -1	;ベストスコア
	FOR LOCAL, 0, CHARANUM
		SIF LOCAL == MASTER
			CONTINUE
		SIF CFLAG:LOCAL:21 == 1	; 【LOCAL:[別れ]==1】
			CONTINUE
		SIF BASE:LOCAL:0 <= 0	; 衰弱療養中（お休み）のキャラは自動選出から除外
			CONTINUE
	SIF CFLAG:LOCAL:2 <= -100	; 嫌悪キャラは自動選出から除外
		CONTINUE
		;既に選出済みかチェック
		C = 0
		SIF FLAG:200 == LOCAL
			C = 1
		SIF FLAG:201 == LOCAL
			C = 1
		SIF FLAG:202 == LOCAL
			C = 1
		SIF FLAG:203 == LOCAL
			C = 1
		SIF FLAG:204 == LOCAL
			C = 1
		SIF C == 1
			CONTINUE
		D = DECK_MEMBER_SCORE(LOCAL)
		IF D > B
			B = D
			A = LOCAL
			ENDIF
	NEXT
	FLAG:(200 + COUNT) = A
REND
FLAG:205 = 1
RETURN 1


