; 校内定期戦 勝利後の親愛・淫乱メンバー自動祝勝会（ハーレム搾精） (@DECK_BATTLE_HAREM_AFTER)
; 【引数】
;   ・ARG:0 = 定期戦難度 (1=下級 / 2=中級 / 3=上級)
;   ・ARG:1 = 勝敗ランク (1=勝利 / 2=圧倒的勝利)
; 【自動選出・発動条件】
;   ・選択肢なしで、デッキ編成メンバー5枠(FLAG:200～204)のうち
;     [体力(BASE:0)] > 0 かつ ([親愛(TALENT:88)] または [相愛(TALENT:89)] または [淫乱(TALENT:76)]) を持つキャラを自動選出
;   ・選出メンバー内の [淫乱(TALENT:76)] 所持人数(LOCAL:8 = 0～5人)に応じて6段階（各RAND:3分岐）で描写と激しさが変化
;
; 【獲得経験・獲得珠・好感度・耐力消耗（すべてRANDによるランダム幅付き）】
;   ・主人公側：
;       [射精経験(EXP:MASTER:3)]   += 各メンバーに搾り取られた合計射精回数
;       [キス経験(EXP:MASTER:96)]  += 各メンバーとのキス回数合計
;       [耐力(BASE:MASTER:4)]      -= 段階0(65～78%) / 段階1(82～89%) / 段階2(91～94%) / 段階3(95～97%) / 段階4(98～99%) / 段階5(残り1～数点までほぼ全損)
;   ・参加メンバー全員（個人別ランダム算出・未経験ブロック付き）：
;       [Ｖ経験(EXP:0)] / [膣射経験(EXP:24)] / [快Ｖの珠(1)]（MASTER非[童貞] かつ 対象が非[処女]・[Ｖ経験]>0・非[オトコ]時のみ）
;       [Ａ経験(EXP:1)] / [快Ａの珠(2)]（対象の[Ａ経験]>=20 かつ ([Ａ感覚]>=3 または [尻穴狂い]) のＡ開発済み時のみ）
;       [フェラ経験(EXP:22)] / [精飲経験(EXP:26)]（対象が非[キス未経験] かつ 経験・能力条件を満たす時のみ）
;       [キス経験(EXP:96)] / [快Ｍの珠(18)]（対象・MASTER双方とも非[キス未経験]時のみ）
;       [絶頂経験(EXP:2)] / [精液経験(EXP:20)] / [奉仕快楽経験(EXP:21)] / [愛情経験(EXP:23)]
;       [レズ経験(EXP:40)]（参加人数2人以上 かつ 対象が非[オトコ]時）
;   ・獲得珠（JUEL）：
;       [快Ｃ(0)] / [快Ｖ(1)] / [快Ａ(2)] / [快Ｂ(14)] / [快Ｍ(18)] / [恭順(4)] / [欲情(5)] / [屈服(6)] / [習得(7)]
;       ※コンフィグ詳細報告(FLAG:23 & 1p25)がONなら各珠の具体値を表示、OFFなら「宝珠獲得」と簡潔に表示
;---------------------------------------------------------
@DECK_BATTLE_HAREM_AFTER(ARG, ARG:1)
LOCAL:0 = 0
LOCAL:8 = 0
FOR LOCAL:1, 0, 5
	LOCAL:2 = FLAG:(200 + LOCAL:1)
	SIF LOCAL:2 < 1 || LOCAL:2 >= CHARANUM || LOCAL:2 == MASTER
		CONTINUE
	SIF BASE:(LOCAL:2):0 <= 0	; 【対象:[体力]<=0】
		CONTINUE
	SIF CFLAG:(LOCAL:2):2 <= -100	; 嫌悪メンバーは祝勝会に参加しない
		CONTINUE
	IF TALENT:(LOCAL:2):88 || TALENT:(LOCAL:2):89 || TALENT:(LOCAL:2):76	; 【対象:[親愛] / [相愛] / [淫乱]】
		LOCAL:(10 + LOCAL:0) = LOCAL:2
		LOCAL:(60 + LOCAL:0) = LOCAL:2	; 【報酬ループ用退避（LOCAL:10～29との衝突防止）】
		LOCAL:0 += 1
		IF TALENT:(LOCAL:2):76	; 【対象:[淫乱]】
			LOCAL:(20 + LOCAL:8) = LOCAL:2
			LOCAL:8 += 1
		ENDIF
	ENDIF
NEXT

