			PRINTFORML （%CALLNAME:LOCAL%は主人公を嫌悪しているため、校内定期戦デッキから外れました）
			FLAG:(200 + COUNT) = -1
			LOCAL:95 = 1
		ENDIF
	ENDIF
REND
SIF LOCAL:95
	FLAG:205 = 1
RETURN LOCAL:95
