ENDIF
EXP:93 += O
PRINTFORML %EXPNAME:93% +{O}
SIF ASSI > 0
	EXP:ASSI:93 += 1 + RAND:O
PRINTL 

M = L + N
;クリア後インフレ
IF (FLAG:28 & 1) != 0
	IF DAY >= 120
		M += RAND:(1 + (EXP:93 / 10))
	ELSEIF DAY >= 90
;		M = L + N
	ELSEIF DAY >= 60
		M /= 5
	ELSEIF DAY >= 48
