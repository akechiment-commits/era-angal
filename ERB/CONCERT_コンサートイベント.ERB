	ELSEIF K >= 3 && K < 6
		N += 70 + ABL:92 / 8
	ELSEIF K >= 6 && K < 10
		N += 50 + ABL:92 / 6
	ELSEIF K >= 10 && K < 15
		N += 30 + ABL:92 / 4
	ELSE
		N += 10 + ABL:92 / 2
	ENDIF
