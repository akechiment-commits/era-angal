@CONCERT
;奴隷に歌を歌わせてチケットを売るオプション。
;ここでは野外ライブ成功判定を行う
;-------------------------------------------------
;成功判定
;-------------------------------------------------
H = 0
L = 0
P = 0

;EXP:歌唱経験
IF EXP:93 < EXPLV:1
	L = 1
ELSEIF EXP:93 < EXPLV:2
	L = 2
ELSEIF EXP:93 < EXPLV:3
	L = 5
ELSEIF EXP:93 < EXPLV:4
	L = 10
ELSEIF EXP:93 < EXPLV:5
	L = 15
ELSE
	L = 20
ENDIF

;ABL:露出癖
IF ABL:92 < 1
	L += 1
ELSEIF ABL:7 < 9
	L += ABL:7
ELSE
	L += 10
ENDIF

;ABL:歌唱技能
IF ABL:92 < 1
	L += 1
ELSEIF ABL:92 < 15
	L += ABL:92 + 1
ELSE
	L += 15
ENDIF

;臆病
SIF TALENT:10
	L -= 2
;恥じらい
SIF TALENT:35
	L -= 1

;自制心
SIF TALENT:20
	L += 1
;好奇心
SIF TALENT:23
	L += 1
;目立ちたがり
SIF TALENT:28
	L += 2
;解放
SIF TALENT:33
	L += 1
;恥薄い
SIF TALENT:36
	L += 2

SIF L <= 0
	L = 0
;鼓舞
IF TALENT:118
	L += 1 + RAND:15
ELSE
	L += 1 + RAND:10
ENDIF

P = 20
;親愛
IF TALENT:88
	P += RAND:16
;恋人or恋慕
ELSEIF TALENT:153 || TALENT:85
	P += RAND:21
ELSE
	P += RAND:26
ENDIF

;歌唱素質によって難易度変化
SIF ABL:52 >= 3
	P -= 5
IF ASSI > 0
	;助手の歌唱素質によって難易度低下
	IF ABL:52 >= 3
		P -= 3
	;助手が鼓舞持ちまたは歌唱技能Lv20以上だと難易度低下
	ELSEIF TALENT:ASSI:118 || ABL:ASSI:92 >= 20
		P -= 2
	ENDIF
ENDIF
;歌苦手
SIF ABL:52 <= -2
	P += 3

IF L < P
	;失敗
	CALL CONCERT_FAILURE
ELSE
	;成功
	CALL CONCERT_SUCCESS
ENDIF

TFLAG:79 = 1
;休憩フラグを立てる
FLAG:0 = 1
BEGIN TURNEND

RETURN 1

@CONCERT_FAILURE
;野外ライブ失敗

L = 0
M = 0
N = 10
P = 0

;ABL:歌唱技能をみる
IF ABL:92 == 0
	L = 1
ELSEIF ABL:92 < 10
	L = ABL:92
ELSEIF ABL:92 <= 20
	L = 5 + (ABL:92 / 2)
ELSEIF ABL:92 <= 40
	L = 15 + (ABL:92 / 5)
ELSEIF ABL:92 <= 64
	L = 23 + (ABL:92 / 8)
ELSEIF ABL:92 <= 90
	L = 31 + (ABL:92 / 10)
ELSE
	L = 40 + (ABL:92 / 20)
ENDIF

;ABL:露出癖をみる
IF ABL:7 <= 5
	TIMES L , 0.70
ELSEIF ABL:7 < 10
	TIMES L , 0.90
ELSEIF ABL:7 < 20
	TIMES L , 1.00
ELSEIF ABL:7 < 30
	TIMES L , 1.10
ELSEIF ABL:7 < 40
	TIMES L , 1.30
ELSEIF ABL:7 < 50
	TIMES L , 1.40
ELSE
	TIMES L , 1.50
ENDIF

;EXP:歌唱経験をみる
IF EXP:93 < EXPLV:1
	TIMES L , 0.80
ELSEIF EXP:93 < EXPLV:2
	TIMES L , 1.00
ELSEIF EXP:93 < EXPLV:3
	TIMES L , 1.20
ELSEIF EXP:93 < EXPLV:4
	TIMES L , 1.40
ELSEIF EXP:93 < EXPLV:5
	TIMES L , 1.70
ELSE
	TIMES L , 2.00
ENDIF

;臆病
SIF TALENT:10
	TIMES L , 0.80

;目立ちたがり
SIF TALENT:28
	TIMES L , 1.20

;献身的
SIF TALENT:63
	TIMES L , 1.20

;恋慕
SIF TALENT:85
	TIMES L , 2.00

;歌の上手そうな人ボーナス
CALL SINGER_BONUS

;カットフラグを退避
Z:302 = CFLAG:99
;!;LOCAL:100 = CFLAG:99
;口上開始前の地の文をカットするか
TFLAG:13 = 17
CALL SELF_MAEKOJO
;地の文章カット
IF (CFLAG:99 & 1) == 0 && FLAG:6
	PRINTL 
	PRINTFORMW %CALLNAME:TARGET%は野外ライブを開いた
	PRINTL 　
	PRINTW   「♪～」
	PRINTW  「♪♪～」
	PRINTW 「♪～♪～」
	PRINTW 「…………」
	PRINTW ………………
	PRINTL 　
	PRINTFORML 緊張しすぎたのか、歌っている最中に%CALLNAME:TARGET%は固まってしまった。
	PRINTW どうやら今回のライブは失敗したようだ……
	PRINTW      ･
	PRINTW      ･
	PRINTW      ･
ENDIF
;イベント口上野外ライブ失敗用
;TFLAG:13 = 17
H = 0
CALL SELF_KOJO
;地の文章カット
SIF (CFLAG:99 & 1) == 0 && FLAG:6
	PRINTFORMW 部屋に戻った%CALLNAME:MASTER%は泣いている%CALLNAME:TARGET%の頭を抱き寄せるとそっと撫でてやった……
PRINTL 　
P = ABL:92
SIF P > 6
	P = 5
O = (P + RAND:6) / 2
SIF O <= 1
	O = 1
JUEL:4 += L * 20
PRINTFORML %PALAMNAME:4%の珠+{L*20}
IF P > 0
	JUEL:7 += L * P * (ABL:92 / 4 + 1)
	PRINTFORML %PALAMNAME:7%の珠+{L * P * (ABL:92 / 4 + 1)}
ENDIF
JUEL:8 += N * (P+15)
PRINTFORML %PALAMNAME:8%の珠+{N * (P+15)}
EXP:93 += O
PRINTFORML %EXPNAME:93% +{O}
SIF ASSI > 0
	EXP:ASSI:93 += 1 + RAND:O
PRINTL 
WAIT
;カットフラグを戻す
CFLAG:99 = Z:302
;!;CFLAG:99 = LOCAL:100

RETURN 1

@CONCERT_SUCCESS
