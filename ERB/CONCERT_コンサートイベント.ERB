;EXP:歌唱経験をみる
IF EXP:93 < EXPLV:1
	TIMES L , 0.80
ELSEIF EXP:93 < EXPLV:2
	TIMES L , 1.00
ELSEIF EXP:93 < EXPLV:3
	TIMES L , 1.20
ELSEIF EXP:93 < EXPLV:4
