;O = 習得の珠増加量
;P = 乱数処理用
;-------------------------------------------------

;K = RAND:21
K = 0
L = 0
M = 0
N = 0
P = 0

;ABL:歌唱技能
IF ABL:92 <= 10
	L += ABL:92
ELSEIF ABL:92 <= 20
	L += 20 + ABL:92 / 2
ELSEIF ABL:92 <= 40
	L += 30 + ABL:92 / 4
ELSEIF ABL:92 <= 60
	L += 40 + ABL:92 / 6
ELSEIF ABL:92 <= 80
	L += 50 + ABL:92 / 8
ELSE
	L += 60 + ABL:92 / 10
ENDIF

