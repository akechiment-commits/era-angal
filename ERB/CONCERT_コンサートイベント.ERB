	PRINTFORML 開いたライブで{M}枚の音楽チケットが売れた。
ENDIF
;カットフラグを戻す
CFLAG:99 = Z:302
;!;CFLAG:99 = LOCAL:100

;ここでL+Mを再計算する必要性はあるのだろうか
;無いと思ったので書き換えてやるー
;さらに安定処理
IF P > 0
	P = (P + RAND:P) / 2
	M *= 5 * P
ELSE
	M *= 5
ENDIF
MONEY += M
PRINTFORML 売上金 +${M}
PRINTL 
WAIT
RETURN 1

