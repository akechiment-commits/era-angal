; ランダムに1人選ぶ（LOCAL:1..N に格納されたキャラ番号から）
B = LOCAL:0
A = LOCAL:(RAND:B + 1)

; キャラが未ロードなら追加し、インデックスを取得
LOCAL:98 = -1
REPEAT CHARANUM
	IF NO:COUNT == A
		LOCAL:98 = COUNT
	ENDIF
REND
IF LOCAL:98 < 0
	ADDCHARA A
	LOCAL:98 = CHARANUM - 1
ENDIF
TFLAG:85 = LOCAL:98

CALL ENCOUNTER_SCENE
RETURN RESULT

;---------------------------------------------------------
; 誰もいない時のランダムご褒美イベント
;---------------------------------------------------------
@LOCATION_SOLO_EVENT
DRAWLINE
A = RAND:5

IF A == 0
	PRINTFORML 誰もいなかったが、棚の奥に古い参考書を発見した。
	PRINTFORML 読み込んでみると意外な発見があった。
	PRINTL
	ABL:95 += 1
	PRINTFORML （知識技能 +1）
ELSEIF A == 1
	PRINTFORML 誰もいなかった。せっかくなので一人で自主トレをすることにした。
	PRINTL
	ABL:93 += 1
	PRINTFORML （運動技能 +1）
ELSEIF A == 2
	PRINTFORML 誰もいなかったが、窓から見える景色に何かを感じた。
	PRINTFORML 自分の中に新しいイメージが浮かんだ気がする。
	PRINTL
	ABL:94 += 1
	PRINTFORML （表現技能 +1）
ELSEIF A == 3
	PRINTFORML 誰もいなかった。静かな空間で少し休憩することにした。
	PRINTFORML 気分がすっきりした。
	PRINTL
	IF BASE:0 < MAXBASE:0
		BASE:0 += MAXBASE:0 / 5 + 1
		IF BASE:0 > MAXBASE:0
			BASE:0 = MAXBASE:0
		ENDIF
	ENDIF
	PRINTFORML （体力 少し回復）
ELSE
	PRINTFORML 誰もいなかった。
	PRINTFORML しばらくぼーっとしていると、なんだか力が湧いてくる気がした。
	PRINTL
	ABL:93 += 1
	ABL:94 += 1
	ABL:95 += 1
	PRINTFORML （ラッキー！ 全技能 +1）
ENDIF

PRINTL
PRINTFORMW （ターン消費）
RETURN 1

;---------------------------------------------------------
; 遭遇シーン本体
; TFLAG:85 = キャラインデックス
;---------------------------------------------------------
@ENCOUNTER_SCENE
A = TFLAG:85
DRAWLINE

; 再遭遇判定
IF CFLAG:A:2 > 0
	CALL ENCOUNTER_SCENE_REPEAT
	RETURN RESULT
ENDIF

;部活・所属を表示
IF CSTR:A:25 != ""
	PRINTFORML %CALLNAME:A%（%CSTR:A:25%）と出会った。
ELSE
	PRINTFORML %CALLNAME:A%と出会った。
ENDIF
PRINTL

;カテゴリ別フレーバーテキスト
IF TFLAG:86 == 0
	;教室
	IF CFLAG:A:2 >= 100
		PRINTFORML %CALLNAME:A%は笑顔で「また来たの？」と言った。
	ELSEIF CFLAG:A:2 >= 30
		PRINTFORML %CALLNAME:A%は少し驚いた様子で会釈した。
	ELSE
		PRINTFORML %CALLNAME:A%は軽く頷いて視線を前に戻した。
	ENDIF
ELSEIF TFLAG:86 == 1
	;部室
	IF CSTR:A:25 != ""
		PRINTFORML %CSTR:A:25%の部室。%CALLNAME:A%が活動中だった。
	ENDIF
	IF CFLAG:A:2 >= 50
		PRINTFORML 「見学？ちょうど良かった、一緒にやってみる？」と%CALLNAME:A%が言った。
	ELSEIF CFLAG:A:2 >= 20
		PRINTFORML 「見学なら構わないけど」と%CALLNAME:A%が軽く言った。
	ELSE
		PRINTFORML %CALLNAME:A%は手を止めてこちらを見た。
	ENDIF
ELSEIF TFLAG:86 == 2
	;委員会室
	PRINTFORML 委員会室で%CALLNAME:A%が仕事中だった。
	IF CFLAG:A:2 >= 50
		PRINTFORML 「休憩中だからちょっと話せるよ」と%CALLNAME:A%が言った。
	ELSE
		PRINTFORML %CALLNAME:A%は書類から顔を上げて軽く会釈した。
	ENDIF
ENDIF

; キャラ別セリフ
TRYCALLFORM KOJO_ENCOUNTER_FIRST_K{NO:A}
PRINTL
;好感度UP
CFLAG:A:2 += 3
PRINTL
PRINTFORML %CALLNAME:A%の好感度 +3（現在：{CFLAG:A:2}）
PRINTL

;パートナー選択
IF TARGET == A
	PRINTFORMW %CALLNAME:A%はもう今のパートナーだ。
	RETURN 1
ENDIF

IF TARGET < 0
	PRINTFORML %CALLNAME:A%をパートナーにしますか？
ELSE
	PRINTFORML 今のパートナーは%CALLNAME:TARGET%。%CALLNAME:A%に変えますか？
ENDIF
PRINTFORML [0] はい　[1] いいえ

$INPUT_LOOP_ENC
INPUT
IF RESULT == 0
	TARGET = A
	PRINTFORMW %CALLNAME:A%がパートナーになった。
	RETURN 1
ELSEIF RESULT == 1
	PRINTFORMW そのまま別れた。
	RETURN 1
ELSE
	GOTO INPUT_LOOP_ENC
ENDIF

RETURN 1

