ELSE
	PRINTFORML 今のパートナーは%CALLNAME:TARGET%。%CALLNAME:A%に変えますか？
ENDIF
PRINTFORML [0] はい　[1] 別れた

$INPUT_LOOP_RENC
INPUT
IF RESULT == 0
	TARGET = A
	PRINTFORMW %CALLNAME:A%がパートナーになった。
	RETURN 1
ELSEIF RESULT == 1
	PRINTFORMW そのまま別れた。
	RETURN 1
ELSE
	GOTO INPUT_LOOP_RENC
