@LOCATION_SUBMENU_CLASS
DRAWLINE
PRINTFORML 【教室 - どのクラスへ？】
PRINTL
PRINTFORML [0] 1年1組(A組)
PRINTFORML [1] 1年2組(B組)
PRINTFORML [2] 1年3組(C組)
PRINTFORML [3] 2年1組(A組)
PRINTFORML [4] 2年2組(B組)
PRINTFORML [5] 2年3組(C組)
PRINTFORML [6] 3年1組(A組)
PRINTFORML [7] 3年2組(B組)
PRINTFORML [8] 3年3組(C組)
PRINTFORML [9] 戻る
PRINTL
$INPUT_LOOP_CLS
INPUT
IF RESULT >= 0 && RESULT <= 8
	TFLAG:86 = 0
	TFLAG:84 = RESULT
	CALL LOCATION_ENCOUNTER
	SIF RESULT
		BEGIN TURNEND
	RETURN 1
ELSEIF RESULT == 9
	RETURN 0
ELSE
	GOTO INPUT_LOOP_CLS
ENDIF
RETURN 0

