;---------------------------------------------------------
; KOJO_CLUB: 部活動イベント台詞
;---------------------------------------------------------
@KOJO_CLUB_K4
A = RAND:3
IF A == 0
	PRINTFORMW 「ピッコロの練習してたら、また楽器落としそうになっちゃいました……おろろ～。先輩、見てましたか？」
ELSEIF A == 1
	PRINTFORMW 「吹奏楽部の練習、楽しいですよ！　先輩も来てみます？　みよちゃんもいますよ♪」
ELSE
	PRINTFORMW 「今日の練習、なっちゃん先輩にいっぱい褒めてもらえました！　えへへ、うれしかったです♪」
ENDIF
RETURN 0

;---------------------------------------------------------
; KOJO_ENCOUNTER_FIRST: 初回遭遇
;---------------------------------------------------------
@KOJO_ENCOUNTER_FIRST_K4
PRINTFORMW 「あっ……えっと、転校生の先輩ですよね？　あたし、早川きこっていいます！　一年A組で……あ、あはは、よろしくですっ♪」
RETURN 0

;---------------------------------------------------------
; KOJO_ENCOUNTER_REPEAT: 再遭遇
;---------------------------------------------------------
@KOJO_ENCOUNTER_REPEAT_K4
A = RAND:3
IF A == 0
	PRINTFORMW 「あっ、先輩！　えへへ、また会えましたね～♪」
ELSEIF A == 1
	PRINTFORMW 「先輩先輩！　今日ね、みよちゃんと一緒に練習してたんですよ～。おろろ～、疲れました♪」
ELSE
	PRINTFORMW 「わあ、ちょうどよかった！　先輩に話したいことがあったんです～！」
ENDIF
RETURN 0

;---------------------------------------------------------
; SELF_KOJO: コマンド実行失敗時
;---------------------------------------------------------
@SELF_KOJO_K4
A = RAND:3
IF A == 0
	PRINTFORMW 「おろろ～……うまくいかなかったです。えへへ、あたしってやっぱりドジですよね」
ELSEIF A == 1
	PRINTFORMW 「え、ダメでしたか……？　あはは、またやっちゃった～」
ELSE
	PRINTFORMW 「うう……失敗しちゃいました。もう一回がんばります、おろろ～」
ENDIF
RETURN 0
