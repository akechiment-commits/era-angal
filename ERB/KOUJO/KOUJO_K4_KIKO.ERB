;---------------------------------------------------------
; 君咲学院 口上ファイル
; 早川きこ　NO:4  1年A組 吹奏楽部
; CFLAG:401～412 を初回フラグとして使用
;---------------------------------------------------------

@KOJO_MESSAGE_COM_4
SIF TEQUIP:45 && SELECTCOM != 45
	RETURN 0

;--- COM300 一緒に勉強する ---
IF SELECTCOM == 300
	IF CFLAG:401 == 0
		PRINTFORMW 「え、一緒に勉強ですか？　あはは、あたし教えるの得意じゃないけど、一緒にがんばりましょう！」
		CFLAG:401 = 1
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「おろろ～、この問題難しいなあ。先輩、わかります？　あたしもわかんないですけど……」
		ELSEIF A == 1
			PRINTFORMW 「みよちゃんに教えてもらおうとしたら、ちょうど先輩がいてよかったです！　えへへ♪」
		ELSE
			PRINTFORMW 「試験、絶対一緒に乗り越えましょうね！　あたし、前回のテスト全部忘れちゃったので……おろろ～」
		ENDIF
	ENDIF
ENDIF

;--- COM301 会話 ---
IF SELECTCOM == 301
	IF CFLAG:402 == 0
		PRINTFORMW 「転校生の先輩とこうしてお話しするの、初めてですね！　あ、あたし早川きこっていいます、よろしくですっ」
		CFLAG:402 = 1
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「ピッコロって小さいのに音が大きくって、先輩びっくりしませんでした？　あはは、あたしも最初はびっくりしたんです♪」
		ELSEIF A == 1
			PRINTFORMW 「みよちゃん……三善さんとは小学校からの幼馴染なんですよ～。あ、みよちゃんって呼ぶの内緒ですよ？」
		ELSE
			PRINTFORMW 「あ、そういえば今日また転んじゃいましたっ！　廊下の角で……おろろ～？　先輩笑わないでください～」
		ENDIF
	ENDIF
ENDIF

;--- COM302 プレゼント ---
IF SELECTCOM == 302
	IF CFLAG:403 == 0
		PRINTFORMW 「え、あたしに？　うひっ、びっくりした！　わあ、ありがとうございます～、大事にしますね♪」
		CFLAG:403 = 1
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「またプレゼント！？　えええっ、そんなにもらっちゃっていいんですか！　おろろ～、嬉しい～♪」
		ELSEIF A == 1
			PRINTFORMW 「先輩って、こういうの上手ですよね。えへへ、なんか照れちゃいます♪」
		ELSE
			PRINTFORMW 「ありがとうございます！　吹奏楽部のみんなにちょっと自慢しちゃおうかなあ……あはは♪」
		ENDIF
	ENDIF
ENDIF

;--- COM303 スキンシップ ---
IF SELECTCOM == 303
	IF CFLAG:404 == 0
		PRINTFORMW 「うひょっ、びっくりした！？　もう、急にそんなことしないでくださいよ～！　……でも、悪くないですけど」
		CFLAG:404 = 1
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「もう、先輩ってば～！　あたし今日また転びそうになってたんだから、もう少しそっとしてください……おろろ～」
		ELSEIF A == 1
			PRINTFORMW 「え、えへへ……先輩とこうしてるの、なんかちょっと照れますね。悪くないですけど！」
		ELSE
			PRINTFORMW 「あ、あたしのこと驚かせようとしましたね？　みよちゃんといつもこういうのやるから慣れてますよ～……おろろっ、やっぱり慣れてない！」
		ENDIF
	ENDIF
ENDIF

;--- COM311 甘い言葉 ---
IF SELECTCOM == 311
	IF CFLAG:405 == 0
		PRINTFORMW 「えっ、そんな……うわあ、なんか急に言われてもう、どうしたらいいのかわかんないですよ！　えへへ♪」
		CFLAG:405 = 1
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「もう、先輩ってそういうこと言うのうまいんですから～！　あたしが照れるじゃないですかっ♪」
		ELSEIF A == 1
			PRINTFORMW 「ほんとに？　ほんとにそう思ってくれてます？　えへへ、なんか頑張れそうです♪」
		ELSE
			PRINTFORMW 「お世辞でも嬉しいです！　みよちゃんはぜんぜんそういうこと言ってくれないから……あはは♪」
		ENDIF
	ENDIF
ENDIF

;--- COM312 頭を撫でる ---
IF SELECTCOM == 312
	IF CFLAG:406 == 0
		PRINTFORMW 「え、えっ、ちょっ、な、なんですかっ！？　……なんか、くすぐったい……ですけど、悪くはないです、よ？」
		CFLAG:406 = 1
	ELSE
		A = RAND:3
		IF A == 0
			PRINTFORMW 「もう、子供扱いしないでくださいよ～……でもまあ、嫌じゃないですけど。えへへ♪」
		ELSEIF A == 1
			PRINTFORMW 「先輩に撫でてもらってると、なんか安心しますね。ふふ、変ですかね？」
		ELSE
			PRINTFORMW 「おろろ～、こういうのって……うう、どうリアクションすればいいかわかんないですっ！」
		ENDIF
	ENDIF
ENDIF

;--- COM315 お散歩する ---
IF SELECTCOM == 315
	IF CFLAG:407 == 0
		PRINTFORMW 「お散歩！　いいですねいいですね♪　あたし転ばないように気をつけながら行きます、おろろ～」
		CFLAG:407 = 1
	ELSE
		A = RAND:2
		IF A == 0
			PRINTFORMW 「先輩と一緒だと、なんかいつもより転ばないですよ？　不思議ですよね、あはは♪」
		ELSE
			PRINTFORMW 「今日は気持ちいいですね～！　あ、あたし昨日もここで転んだんですけど、今日は大丈夫そうです！　……おろろ～っ！」
		ENDIF
	ENDIF
ENDIF

;--- COM320 学食に行く ---
IF SELECTCOM == 320
	IF CFLAG:408 == 0
		PRINTFORMW 「学食、一緒に行きましょう！　あたし今日はうっかりお弁当忘れちゃって……えへへ、助かりました♪」
		CFLAG:408 = 1
	ELSE
		A = RAND:2
		IF A == 0
			PRINTFORMW 「今日の日替わり定食なんですかね？　前においしかったやつ、また食べたいんですよね～♪」
		ELSE
			PRINTFORMW 「あ、あそこみよちゃんいますよ！　一緒に食べましょうよ～、みよちゃ～ん！」
		ENDIF
	ENDIF
ENDIF

;--- COM321 遊びに行く ---
IF SELECTCOM == 321
	IF CFLAG:409 == 0
		PRINTFORMW 「わあ、遊びに行くんですか！？　どこどこ、あたしどこでも行きますよ～♪　転ばないように気をつけながら！」
		CFLAG:409 = 1
	ELSE
		A = RAND:2
		IF A == 0
			PRINTFORMW 「先輩と遊びに行くの、楽しいですね！　えへへ、また行きましょう♪」
		ELSE
			PRINTFORMW 「ゲームセンターとか行きます？　あ、でもあたし機械系は得意じゃないかも……コンタクトとかで……おろろ～」
		ENDIF
	ENDIF
ENDIF

;--- COM323 デート ---
IF SELECTCOM == 323
	PRINTFORMW 「……デート、ですか？　え、えへへ……今は、ちょっと、まだそういう感じじゃないかなあって……ごめんなさい」
ENDIF

;--- COM393 見つめあう ---
IF SELECTCOM == 393
	PRINTFORMW 「え……？　なんですか、そんなじっと見て……。あっ、やだ、照れてきちゃった。えへへ……」
ENDIF

;--- COM399 告白する ---
IF SELECTCOM == 399
	PRINTFORMW 「……先輩。あの……もう少しだけ、待ってください。あたし、うまく気持ちの整理ができなくって……おろろ……」
ENDIF

;--- キス系 ---
IF SELECTCOM >= 340 && SELECTCOM <= 342
	A = RAND:3
	IF A == 0
		PRINTFORMW 「っ！　ちょ、ちょっと先輩！　そういうことは心の準備が……おろろ～っ！」
	ELSEIF A == 1
		PRINTFORMW 「……ダメです、まだ。そういう間柄じゃないですよ、あたしたち……」
	ELSE
		PRINTFORMW 「も、もうっ！　びっくりしたじゃないですかっ！　……悪くはないですけど！」
	ENDIF
ENDIF

;--- ウフフ系 ---
IF SELECTCOM >= 360 && SELECTCOM <= 399
	IF SELECTCOM != 393 && SELECTCOM != 399
		A = RAND:3
		IF A == 0
			PRINTFORMW 「ちょ、ちょっと！　なにするんですかっ、おろろ～っ！？」
		ELSEIF A == 1
			PRINTFORMW 「……そういうことは、まだちょっと……えへへ、ダメですよ？」
		ELSE
			PRINTFORMW 「やめてくださいよ～！　まだそういう間柄じゃないですって！」
		ENDIF
	ENDIF
ENDIF

;--- えっち系全般 ---
IF SELECTCOM < 300
	A = RAND:3
	IF A == 0
		PRINTFORMW 「ちょっ、ちょっと！　なにするんですかっ！　おろろ～っ！？」
	ELSEIF A == 1
		PRINTFORMW 「……ダメです！　そういうことをされる理由がないですよっ！」
	ELSE
		PRINTFORMW 「もうっ、先輩ったら！　あたしのこと、なんだと思ってるんですかっ！」
	ENDIF
ENDIF

RETURN 0

