;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;---------------------------------------------------------
; 妊娠・出産・育児 口上ファイル
;
; TFLAG:13 の値ごとに口上を出す:
;   20  … 妊娠発覚（本人 TARGET = 妊婦）
;   94  … 妊娠発覚２（父親側/相手方のリアクション）
;   25  … 臨月（育児室移動直前）
;   21  … 出産
;   22  … 親離れ（育児終了）
;   23  … 育児室コマンド
;
; TFLAG:17（出産分岐）:
;   1 … グッド（恋慕あり・主人公が父親）
;   2 … ノーマル
;   3 … バッド（感情乏しい）
;
; CFLAG:TARGET:104（誰が妊娠させたか）:
;   1 … マスター  2 … 助手  3 … パートナー
;
; 各キャラ個別口上: KOJO_NINSIN_K{NO:TARGET} を同ファイル内か
; CHAR/CHAR_XX_名前.ERB 内に定義すればそちらが優先される。
; 未定義キャラは共通セリフが出る。
;---------------------------------------------------------

@KOJO_NINSIN_COMMON
;--- 妊娠発覚 ---
IF TFLAG:13 == 20
	IF CFLAG:TARGET:104 == 1
		PRINTFORMW  「…妊娠、してる」
	ELSE
		PRINTFORMW  「……赤ちゃん、できちゃった」
	ENDIF
	RETURN 0
ENDIF
;--- 妊娠発覚２（相手方） ---
IF TFLAG:13 == 94
	PRINTFORMW  「……赤ちゃんができたんですか」
	RETURN 0
ENDIF
;--- 臨月 ---
IF TFLAG:13 == 25
	PRINTFORMW  「もうすぐ……産まれる」
	RETURN 0
ENDIF
;--- 出産 ---
IF TFLAG:13 == 21
	IF TFLAG:17 == 1
		PRINTFORMW  「産まれた……あなたとの子よ」
	ELSEIF TFLAG:17 == 3
		PRINTFORMW  「……産んだ。それだけ」
	ELSE
		PRINTFORMW  「産まれました……」
	ENDIF
	RETURN 0
ENDIF
;--- 育児室 ---
IF TFLAG:13 == 23
	PRINTFORMW  「……静かにしてください、寝てるんです」
	RETURN 0
ENDIF
;--- 親離れ ---
IF TFLAG:13 == 22
	PRINTFORMW  「……行ってしまった」
	RETURN 0
ENDIF
RETURN 0
