;--------------------------------------------------
;クリア後から式までの間をどうにかしてみよう構文
;およめさんがもみじのばあいだよ！
;けっこんしきのひのこうじょうとかもかけるかもね！
;-------------------------------------------------;
@EVENTSHOP
IF FLAG:29 == 41 && FLAG:28 == 1
	;椛の場所を探す
	A = -1
	REPEAT CHARANUM
		SIF NO:COUNT == 41
			A = COUNT
	REND
	IF A > -1
		IF CFLAG:A:137 <= 4 && CFLAG:A:137 >= 1 && (TIME:4 & 2) && TIME == 0
			CFLAG:A:137 += 5
		ELSEIF CFLAG:A:137 <= 9 && CFLAG:A:137 >= 6 && (TIME:4 & 2) && TIME
			CFLAG:A:137 += 5
		ELSEIF CFLAG:A:137 <= 14 && CFLAG:A:137 >= 11
			CFLAG:A:137 += 5
		ENDIF
	ENDIF
ENDIF

