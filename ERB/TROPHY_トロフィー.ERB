		LOCAL:6 = 4
	CASE 11
		LOCAL:5 = 44
		LOCAL:6 = 4
	CASE 12
		LOCAL:5 = 48
		LOCAL:6 = 4
	ENDSELECT
	LOCAL:7 = 0
	FOR LOCAL:4, 0, LOCAL:6
		GETBIT GLOBAL:204, LOCAL:5 + LOCAL:4
		LOCAL:7 += RESULT
