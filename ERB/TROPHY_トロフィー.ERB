;--------------------------------------------------
;特殊能力取得（スキルポイント制）
; GLOBAL:205 = 消費済みスキルポイント
; 獲得SP = B:1×1 + S:1×2 + G:1×3 + P:1×10
; コスト: 強化系8SP、それ以外5SP
;--------------------------------------------------
@TROPHY_FEAT_GET
;=== スキルポイント計算 ===
CALL TROPHY_COUNT_ALL
LOCAL:90 = B:1 + S:1 * 2 + G:1 * 3 + P:1 * 10
LOADGLOBAL
LOCAL:91 = LOCAL:90 - GLOBAL:205

VARSET LOCALS, ""
LOCALS:0 = 恋人ボーナス
LOCALS:1 = 恋人ボーナス強化
LOCALS:2 = 恋慕ボーナス
LOCALS:3 = 恋慕ボーナス強化
LOCALS:4 = 親愛ボーナス
LOCALS:5 = 親愛ボーナス強化
LOCALS:6 = 淫乱ボーナス
LOCALS:7 = 淫乱ボーナス強化
LOCALS:8 = 舌使い
LOCALS:9 = 針さばき
LOCALS:10 = 調合知識
LOCALS:11 = 魅惑
LOCALS:12 = 魅力
LOCALS:13 = 回復早い
LOCALS:14 = 日光浴
LOCALS:15 = 月光浴
LOCALS:16 = 治療
LOCALS:17 = 鼓舞
LOCALS:18 = 淫具知識

DRAWLINE
PRINTFORML スキルポイント: {LOCAL:91} SP（累計取得 {LOCAL:90} / 消費済 {GLOBAL:205}）
PRINTFORML B×1 / S×2 / G×3 / P×10　強化系8SP・それ以外5SP
PRINTL 
PRINTFORML 　[番号]　特殊能力　　　　コスト  状態

FOR LOCAL, 0, 19
	;コスト判定（強化系=8、その他=5）
	IF LOCAL == 1 || LOCAL == 3 || LOCAL == 5 || LOCAL == 7
		LOCAL:2 = 8
	ELSE
		LOCAL:2 = 5
	ENDIF
	PRINTFORM [{LOCAL,3}] 
	IF TALENT:MASTER:(LOCALS:LOCAL)
		SETCOLOR 80, 200, 220
		PRINTFORM %LOCALS:LOCAL,16,LEFT%
		RESETCOLOR
		PRINTFORML {LOCAL:2}SP [取得済]
	ELSEIF LOCAL:2 <= LOCAL:91
		PRINTFORM %LOCALS:LOCAL,16,LEFT%
		PRINTFORML {LOCAL:2}SP [取得可]
	ELSE
		SETCOLOR 105, 105, 105
		PRINTFORM %LOCALS:LOCAL,16,LEFT%
		RESETCOLOR
		PRINTFORML {LOCAL:2}SP [SP不足]
	ENDIF
NEXT
PRINTL 
DRAWLINE
PRINTL [ 98] 全特殊能力取得
PRINTL [ 99] 全特殊能力を忘れる（ポイント全還元）
PRINTL [100] 戻る

$INPUT_LOOP
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 98
	;全スキル取得（SP不足チェックあり）
	LOCAL:3 = 0
	FOR LOCAL, 0, 19
		IF TALENT:MASTER:(LOCALS:LOCAL) == 0
			IF LOCAL == 1 || LOCAL == 3 || LOCAL == 5 || LOCAL == 7
				LOCAL:3 += 8
			ELSE
				LOCAL:3 += 5
			ENDIF
		ENDIF
	NEXT
	IF LOCAL:3 > LOCAL:91
		PRINTFORMW SP不足（必要{LOCAL:3} / 現在{LOCAL:91}）
	ELSE
		FOR LOCAL, 0, 19
			IF TALENT:MASTER:(LOCALS:LOCAL) == 0
				TALENT:MASTER:(LOCALS:LOCAL) = 1
				IF LOCAL == 1 || LOCAL == 3 || LOCAL == 5 || LOCAL == 7
					GLOBAL:205 += 8
				ELSE
					GLOBAL:205 += 5
				ENDIF
			ENDIF
		NEXT
		SAVEGLOBAL
		PRINTFORMW 全特殊能力を取得しました（{LOCAL:3}SP消費）
	ENDIF
	RESTART
ELSEIF RESULT == 99
	;全スキルを忘れる
	LOCAL:3 = 0
	FOR LOCAL, 0, 19
		IF TALENT:MASTER:(LOCALS:LOCAL)
			TALENT:MASTER:(LOCALS:LOCAL) = 0
			IF LOCAL == 1 || LOCAL == 3 || LOCAL == 5 || LOCAL == 7
				LOCAL:3 += 8
			ELSE
				LOCAL:3 += 5
				ENDIF
		ENDIF
	NEXT
	GLOBAL:205 -= LOCAL:3
	SAVEGLOBAL
	PRINTFORMW 全特殊能力を忘れました（{LOCAL:3}SP還元）
	RESTART
ELSEIF RESULT >= 19 || LOCALS:RESULT == ""
	PRINTFORML 正しい値を入力してください
	GOTO INPUT_LOOP
ENDIF

LOCAL:4 = RESULT
;コスト
IF LOCAL:4 == 1 || LOCAL:4 == 3 || LOCAL:4 == 5 || LOCAL:4 == 7
	LOCAL:5 = 8
ELSE
	LOCAL:5 = 5
ENDIF

IF TALENT:MASTER:(LOCALS:(LOCAL:4))
	;取得済み → 忘れる確認
	;強化スキルを保持している場合は連動して忘れる
	LOCAL:6 = 0
	LOCAL:7 = -1
	IF LOCAL:4 == 0 && TALENT:MASTER:恋人ボーナス強化
		LOCAL:7 = 1
		LOCAL:6 = 8
	ELSEIF LOCAL:4 == 2 && TALENT:MASTER:恋慕ボーナス強化
		LOCAL:7 = 3
		LOCAL:6 = 8
	ELSEIF LOCAL:4 == 4 && TALENT:MASTER:親愛ボーナス強化
		LOCAL:7 = 5
		LOCAL:6 = 8
	ELSEIF LOCAL:4 == 6 && TALENT:MASTER:淫乱ボーナス強化
		LOCAL:7 = 7
		LOCAL:6 = 8
	ENDIF
	LOCAL:8 = LOCAL:5 + LOCAL:6
	IF LOCAL:7 >= 0
		PRINTFORML 【%LOCALS:(LOCAL:4)%】【%LOCALS:(LOCAL:7)%】をまとめて忘れますか？
	ELSE
		PRINTFORML 【%LOCALS:(LOCAL:4)%】を忘れますか？
	ENDIF
	PRINTFORML {LOCAL:8}SP を返還します
	PRINTL [0] はい
	PRINTL [1] いいえ
	$INPUT_LOOP_FORGET
	INPUT
	IF RESULT == 0
		TALENT:MASTER:(LOCALS:(LOCAL:4)) = 0
		GLOBAL:205 -= LOCAL:5
		IF LOCAL:7 >= 0
			TALENT:MASTER:(LOCALS:(LOCAL:7)) = 0
			GLOBAL:205 -= LOCAL:6
		ENDIF
		SAVEGLOBAL
		PRINTFORMW 忘れました（{LOCAL:8}SP還元）
		RESTART
	ELSEIF RESULT == 1
		RESTART
	ELSE
		GOTO INPUT_LOOP_FORGET
	ENDIF
ELSEIF LOCAL:5 <= LOCAL:91
	;未取得 かつ SP足りる → 習得確認
	;強化系は対応する基底スキルが必要
	LOCAL:6 = 0
	IF LOCAL:4 == 1 && TALENT:MASTER:恋人ボーナス == 0
		LOCAL:6 = 1
	ELSEIF LOCAL:4 == 3 && TALENT:MASTER:恋慕ボーナス == 0
		LOCAL:6 = 1
	ELSEIF LOCAL:4 == 5 && TALENT:MASTER:親愛ボーナス == 0
		LOCAL:6 = 1
	ELSEIF LOCAL:4 == 7 && TALENT:MASTER:淫乱ボーナス == 0
		LOCAL:6 = 1
	ENDIF
	IF LOCAL:6
		PRINTFORMW 先に基本スキル（強化前）を習得してください
		RESTART
	ENDIF
	TRYCALLFORM TROPHY_FEAT_GET_%LOCALS:(LOCAL:4)%
	PRINTFORML 効果：%RESULTS:3%
	PRINTFORML 【%LOCALS:(LOCAL:4)%】を習得しますか？（{LOCAL:5}SP）
	PRINTL [0] はい
	PRINTL [1] いいえ
	$INPUT_LOOP_GET
	INPUT
	IF RESULT == 0
		TALENT:MASTER:(LOCALS:(LOCAL:4)) = 1
		GLOBAL:205 += LOCAL:5
		SAVEGLOBAL
		PRINTFORMW 【%LOCALS:(LOCAL:4)%】を習得しました（{LOCAL:5}SP消費）
		RESTART
	ELSEIF RESULT == 1
		RESTART
	ELSE
		GOTO INPUT_LOOP_GET
	ENDIF
ELSE
	PRINTFORMW スキルポイントが不足しています（必要{LOCAL:5} / 現在{LOCAL:91}）
	RESTART
ENDIF

