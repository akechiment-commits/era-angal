		LOCAL:2 += 1
	SIF TALENT:LOCAL:88
		LOCAL:2 += 2
	SIF TALENT:LOCAL:76
		LOCAL:2 += 4

	IF LOCAL:2 == 7
		SETCOLOR 217, 217, 140
		PRINT [P]
	ELSEIF LOCAL:2 & 4
		SETCOLOR 180, 158, 83
		PRINT [G]
	ELSEIF LOCAL:2 & 2
		SETCOLOR 158, 158, 158
		PRINT [S]
	ELSEIF LOCAL:2 & 1
		SETCOLOR 151, 107, 47
		PRINT [B]
	ELSE
		SETCOLOR 105, 105, 105
		PRINT [ ]
	ENDIF
	RESETCOLOR
	PRINTFORM  %NAME:LOCAL,16,LEFT%
	SIF TALENT:LOCAL:85
		PRINT [恋慕]
	SIF TALENT:LOCAL:88
		PRINT [親愛]
	SIF TALENT:LOCAL:76
		PRINT [淫乱]
	;好感度表示（<2000=グレー、2000-=オレンジ、10000-=水色、50000-=黄金）
	IF CFLAG:LOCAL:2 >= 50000
		SETCOLOR 230, 200, 0
	ELSEIF CFLAG:LOCAL:2 >= 10000
		SETCOLOR 80, 200, 220
	ELSEIF CFLAG:LOCAL:2 >= 2000
		SETCOLOR 210, 130, 40
	ELSE
		SETCOLOR 105, 105, 105
	ENDIF
	PRINTFORM  好感度{CFLAG:LOCAL:2}
	RESETCOLOR
	PRINTL

	SIF TALENT:LOCAL:85
		LOCAL:10 += 1
	SIF TALENT:LOCAL:88
		LOCAL:11 += 1
	SIF TALENT:LOCAL:76
		LOCAL:12 += 1
NEXT

DRAWLINE
PRINTFORML 恋慕 {LOCAL:10}/{CHARANUM-1}人　親愛 {LOCAL:11}/{CHARANUM-1}人　淫乱 {LOCAL:12}/{CHARANUM-1}人

;--------------------------------------------------
; @TROPHY_COUNT_CHAR  キャラ編実績数集計
; B=恋慕/S=親愛/G=淫乱 の達成数をB:0/S:0/G:0等に格納
;--------------------------------------------------
@TROPHY_COUNT_CHAR
#DIM LCHAR, 1
VARSET B, 0
VARSET S, 0
VARSET G, 0
VARSET P, 0
VARSET LOCAL, 0

;総数: 恋慕+好2k=B、親愛+好1万=S、淫乱+好5万=G（各71+71=142）、P=1
LCHAR = CHARANUM - 1
B:0 = LCHAR * 2
S:0 = LCHAR * 2
G:0 = LCHAR * 2
P:0 = 1

;達成数カウント
FOR LOCAL, 1, CHARANUM
	SIF TALENT:LOCAL:85
		B:1 += 1
	SIF CFLAG:LOCAL:2 >= 2000
		B:1 += 1
	SIF TALENT:LOCAL:88
		S:1 += 1
	SIF CFLAG:LOCAL:2 >= 10000
		S:1 += 1
	SIF TALENT:LOCAL:76
		G:1 += 1
	SIF CFLAG:LOCAL:2 >= 50000
		G:1 += 1
	;プラチナ条件カウント（恋慕・親愛・淫乱・好感度50000）
	IF TALENT:LOCAL:85 && TALENT:LOCAL:88 && TALENT:LOCAL:76 && CFLAG:LOCAL:2 >= 50000
		LOCAL:8 += 1
	ENDIF
NEXT

;プラチナ: 全キャラが全6条件達成
SIF LOCAL:8 == LCHAR
	P:1 = 1

