;--------------------------------------------------
;判定（GLOBAL:202　イベント編-Lunatic-）
;--------------------------------------------------
@TROPHY_CHECK_202
LOADGLOBAL

VARSET T, 0
VARSET LOCAL, 0
;経験～～以上等の実績はここで一括して判定
FOR LOCAL, 1, CHARANUM
	;好感度
	SIF CFLAG:LOCAL:2 >= 200000
		GLOBAL:202 |= 1p20
	SIF CFLAG:LOCAL:2 >= 300000
		GLOBAL:202 |= 1p21
	SIF CFLAG:LOCAL:2 >= 500000
		GLOBAL:202 |= 1p22
	SIF CFLAG:LOCAL:2 >= 999999
		GLOBAL:202 |= 1p23
NEXT

VARSET LOCAL, 0
FOR LOCAL, 0, 50
	;条件をクリアしているか
	TRYCALLFORM TROPHY_202_{LOCAL}
	SIF RESULT
		SETBIT GLOBAL:202, LOCAL
NEXT

SIF GLOBAL:202
	GLOBAL:202 |= 1p1

SAVEGLOBAL

;全実績取得判定
;実績数カウント
CALL TROPHY_COUNT(202)
LOCAL:0 = B:0 + S:0 + G:0
LOCAL:1 = B:1 + S:1 + G:1
SIF LOCAL:0 == LOCAL:1
	GLOBAL:202 |= 1p0

SAVEGLOBAL

