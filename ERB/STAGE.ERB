;---------------------------------------------------------
;学期進行・試験システム
;旧STAGE.ERB（戦闘システム）を学園生活用に全面改修
;
;学期進行メニュー
;	@STAGE_CAPTURE
;学習状況の表示
;	@SHOW_STUDY_STATUS
;授業・自習（旧：道中攻略）
;	@STUDY_SESSION
;試験を受ける（旧：ボス戦）
;	@TAKE_EXAM
;試験スコア計算
;	@GET_EXAM_SCORE
;試験結果の表示
;	@SHOW_EXAM_RESULT
;学期名取得
;	@GET_SEMESTER_NAME
;---------------------------------------------------------
;使用変数（旧戦闘システムと互換）
;FLAG:24 → 現在の学期（1～6: 1年1学期～3年2学期）
;FLAG:25 → （未使用、旧ボスNO）
;FLAG:27 → 学習進度（0～9:授業中、10:中間試験可、11～19:中間後、20:期末試験可）
;FLAG:5  → 難易度（0=EASY～3=LUNATIC）
;TFLAG:46 → 授業回数カウンタ
;ABL:88  → 学力
;ABL:98  → 学力素質
;EXP:95  → 学習経験
;P       → 試験スコア計算用
;---------------------------------------------------------

@GET_SEMESTER_NAME
;FLAG:24から学期名をSTR:10に設定（3学期制・9学期）
IF FLAG:24 == 1
	STR:10 = 1年1学期
ELSEIF FLAG:24 == 2
	STR:10 = 1年2学期
ELSEIF FLAG:24 == 3
	STR:10 = 1年3学期
ELSEIF FLAG:24 == 4
	STR:10 = 2年1学期
ELSEIF FLAG:24 == 5
	STR:10 = 2年2学期
ELSEIF FLAG:24 == 6
	STR:10 = 2年3学期
ELSEIF FLAG:24 == 7
	STR:10 = 3年1学期
ELSEIF FLAG:24 == 8
	STR:10 = 3年2学期
ELSEIF FLAG:24 == 9
	STR:10 = 3年3学期
ELSE
	STR:10 = 卒業済み
ENDIF
RETURN 1

;---------------------------------------------------------
;学期進行メインメニュー
;---------------------------------------------------------
@STAGE_CAPTURE
;---------------------------------------------------------
;ストーリー進行 - 場所選択→キャラ出会いシステム
;---------------------------------------------------------
DRAWLINE
CALL GET_SEMESTER_NAME

;残り日数計算
LOCAL:0 = FLAG:24
IF FLAG:5 == 0
	LOCAL:0 *= 15
ELSEIF FLAG:5 == 1
	LOCAL:0 *= 10
ELSEIF FLAG:5 == 2
	LOCAL:0 *= 8
ELSE
	LOCAL:0 *= 5
ENDIF
LOCAL:1 = LOCAL:0 - DAY
SIF LOCAL:1 < 0
	LOCAL:1 = 0

PRINTFORML 【どこへ行く？】
PRINTFORML 現在学期: %STR:10%
IF FLAG:27 == 0
	PRINTFORML 試験フェーズ: 前半（中間試験待ち）　残り{LOCAL:1}日
ELSE
	PRINTFORML 試験フェーズ: 後半（期末試験待ち）　残り{LOCAL:1}日
ENDIF
PRINTL
PRINTFORML [0] 1年生の教室　　[1] 2年生の教室　　[2] 3年生の教室
PRINTFORML [3] 運動系部室　　[4] 表現系部室　　[5] 知識系部室
PRINTFORML [6] 図書室　　　　[7] 保健室　　　　[8] 食堂
PRINTFORML [9] 戻る
PRINTL

$INPUT_LOOP
INPUT
IF RESULT >= 0 && RESULT <= 8
	TFLAG:84 = RESULT
	CALL LOCATION_ENCOUNTER
	SIF RESULT
		BEGIN TURNEND
	RETURN 1
ELSEIF RESULT == 9
	RETURN 0
ELSE
	GOTO INPUT_LOOP
ENDIF
RETURN 0

@SCHOOL_LIFE_EVENT
DRAWLINE
A = RAND:8

IF A == 0
	PRINTFORML 【エピソード：廊下で】
	IF TARGET >= 0
		PRINTFORML 廊下を歩いていると%CALLNAME:TARGET%と鉢合わせした。
		PRINTFORML 「あ、%CALLNAME:MASTER%」と%CALLNAME:TARGET%が微笑んだ。
		PRINTFORML 短い時間だが、他愛ない話をした。
		CFLAG:TARGET:2 += 1
		PRINTFORMW 好感度 +1
	ELSE
		PRINTFORML 廊下を歩いていると同級生に声をかけられた。
		PRINTFORMW 君咲学院の日常はこういう偶然の出会いでできている。
	ENDIF

ELSEIF A == 1
	PRINTFORML 【エピソード：掲示板】
	PRINTFORML 学校の掲示板に目が止まった。
	PRINTFORML 来週のイベント告知、部活の試合結果、進路説明会の案内……。
	IF DAY:2 == 2
		PRINTFORMW 「体育祭の出場クラス分けが発表されていた。」
	ELSEIF DAY:2 == 0
		PRINTFORMW 「入学式の写真が飾られていた。新しいスタートを思い出す。」
	ELSE
		PRINTFORMW 「何気ない掲示板のひとコマ。でも学校って感じがした。」
	ENDIF

ELSEIF A == 2
	PRINTFORML 【エピソード：屋上】
	PRINTFORML 昼休みに屋上へ行ってみた。
	IF TARGET >= 0
		PRINTFORML %CALLNAME:TARGET%も来ていた。
		PRINTFORML 二人で空を見ながら、何も言わずにいた。
		PRINTFORML それだけで、なんとなく充電できた気がした。
		CFLAG:TARGET:2 += 2
		PRINTFORMW 好感度 +2
	ELSE
		PRINTFORML 一人で空を眺めた。青い空に、少し気持ちが楽になった。
		PRINTFORMW 体力が少し回復した。
		BASE:MASTER:4 += MAXBASE:MASTER:4 / 10
		SIF BASE:MASTER:4 > MAXBASE:MASTER:4
			BASE:MASTER:4 = MAXBASE:MASTER:4
	ENDIF

ELSEIF A == 3
	PRINTFORML 【エピソード：図書室】
	PRINTFORML 図書室に立ち寄った。静かで、外の喧騒が遠くなる。
	IF TARGET >= 0
		PRINTFORML %CALLNAME:TARGET%も本を読んでいた。
		PRINTFORML 目が合って、小さく手を振った。
		EXP:MASTER:95 += 1
		EXP:TARGET:95 += 1
		PRINTFORMW 学習経験 +1（ふたりとも）
	ELSE
		PRINTFORML 気になった本を少し読んだ。
		EXP:MASTER:95 += 1
		PRINTFORMW 学習経験 +1
	ENDIF

ELSEIF A == 4
	PRINTFORML 【エピソード：放課後の教室】
	PRINTFORML 放課後、誰もいない教室で一人でいた。
	PRINTFORML 窓から夕日が差し込んで、チョークの匂いがした。
	IF TARGET >= 0
		PRINTFORML そこに%CALLNAME:TARGET%が「まだいたの？」と入ってきた。
		PRINTFORML 一緒に帰ることになった。
		CFLAG:TARGET:2 += 2
		PRINTFORMW 好感度 +2
	ELSE
		PRINTFORMW しばらくぼんやりした後、帰ることにした。
	ENDIF

ELSEIF A == 5
	PRINTFORML 【エピソード：保健室】
	PRINTFORML ちょっと頭が痛くて保健室に寄った。
	PRINTFORML 先生に「最近無理してない？」と言われた。
	BASE:MASTER:4 += MAXBASE:MASTER:4 / 5
	BASE:MASTER:1 += MAXBASE:MASTER:1 / 5
	SIF BASE:MASTER:4 > MAXBASE:MASTER:4
		BASE:MASTER:4 = MAXBASE:MASTER:4
	SIF BASE:MASTER:1 > MAXBASE:MASTER:1
		BASE:MASTER:1 = MAXBASE:MASTER:1
	PRINTFORMW 耐力・気力が少し回復した。

ELSEIF A == 6
	PRINTFORML 【エピソード：購買】
	PRINTFORML 購買でパンを買った。人気のメロンパンは売り切れだった。
	IF TARGET >= 0
		PRINTFORML %CALLNAME:TARGET%が「これ好きなんだ」と言いながら同じパンを選んでいた。
		PRINTFORML なんとなく嬉しかった。
		CFLAG:TARGET:2 += 1
		PRINTFORMW 好感度 +1
	ELSE
		PRINTFORMW 気を取り直して別のパンにした。まあ美味しかった。
	ENDIF

ELSE
	PRINTFORML 【エピソード：朝のHR】
	PRINTFORML 朝のホームルームで担任が「最近みんな顔色がいい」と言った。
	IF FLAG:24 <= 2
		PRINTFORML 「1年生、学校に慣れてきたかな」
	ELSEIF FLAG:24 <= 4
		PRINTFORML 「2年生、一番楽しい時期だからね」
	ELSE
		PRINTFORML 「3年生、後悔のないようにね」
	ENDIF
	PRINTFORMW 何気ない一言が、少し心に残った。
ENDIF

RETURN 1

;---------------------------------------------------------
;パートナーとの思い出（好感度に応じたエピソード）
;ストーリー進行[1]から呼ばれる
;---------------------------------------------------------
@PARTNER_MEMORY
IF TARGET < 0
	PRINTFORMW パートナーを選んでいません。
	RETURN 0
ENDIF

DRAWLINE
PRINTFORML 【%CALLNAME:TARGET%との思い出】
PRINTL

;好感度で分岐
IF CFLAG:TARGET:2 >= 500
	PRINTFORML %CALLNAME:TARGET%と過ごした日々が走馬灯のように蘇る。
	PRINTFORML 最初はこんなに仲良くなるとは思わなかった。
	IF CSTR:TARGET:25 != 
		PRINTFORML 部活の%CSTR:TARGET:25%、一緒に笑った瞬間、ふたりきりの時間……。
	ENDIF
	PRINTFORML %CALLNAME:TARGET%は%CALLNAME:MASTER%にとって、かけがえのない存在になっていた。
	CFLAG:TARGET:2 += 3
	PRINTFORMW 好感度 +3
ELSEIF CFLAG:TARGET:2 >= 200
	PRINTFORML 最近の%CALLNAME:TARGET%とのやりとりが頭に浮かぶ。
	IF CSTR:TARGET:25 != 
		PRINTFORML %CSTR:TARGET:25%での姿、授業中のふとした表情。
	ENDIF
	PRINTFORML 一緒にいると自然と笑顔になれる。そういう相手だった。
	CFLAG:TARGET:2 += 2
	PRINTFORMW 好感度 +2
ELSEIF CFLAG:TARGET:2 >= 50
	PRINTFORML %CALLNAME:TARGET%とのやりとりを振り返ってみる。
	PRINTFORML まだ知らないことがたくさんある。もっと話してみたいと思った。
	CFLAG:TARGET:2 += 1
	PRINTFORMW 好感度 +1
ELSE
	PRINTFORML %CALLNAME:TARGET%とはまだそこまで話せていない。
	PRINTFORML でも、少しずつ距離が縮まっている気がした。
	PRINTFORMW 好感度は変わらないが、何か芽生えるものがあった。
ENDIF

WAIT
RETURN 1
;---------------------------------------------------------
;学習状況の表示
;---------------------------------------------------------
@SHOW_STUDY_STATUS
DRAWLINE

IF TARGET >= 0
	PRINTFORML （%CALLNAME:TARGET%）  学力：{ABL:88}  学力素質：{ABL:98}
	PRINT 体力
	A = BASE:4
	SIF BASE:4 < 0
		A = 0
	CALL PRINT_BAR_4, A, MAXBASE:4, 32
	PRINTFORML ({A}/{MAXBASE:4})
	PRINT 気力
	A = BASE:1
	SIF BASE:1 < 0
		A = 0
	CALL PRINT_BAR, A, MAXBASE:1, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
	PRINTFORML ({A}/{MAXBASE:1})
ENDIF

PRINTFORML （%CALLNAME:MASTER%）  学力：{ABL:MASTER:88}
PRINT 体力
A = BASE:MASTER:4
SIF BASE:MASTER:4 < 0
	A = 0
CALL PRINT_BAR_4, A, MAXBASE:MASTER:4, 32
PRINTFORML ({A}/{MAXBASE:MASTER:4})
PRINT 気力
A = BASE:MASTER:1
SIF BASE:MASTER:1 < 0
	A = 0
CALL PRINT_BAR, A, MAXBASE:MASTER:1, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
PRINTFORML ({A}/{MAXBASE:MASTER:1})

DRAWLINE
RETURN 1

;---------------------------------------------------------
;授業・自習セッション（旧BATTLE_NORMAL）
;---------------------------------------------------------
@STUDY_SESSION
PRINTL 

;授業の種類をランダム決定
A = RAND:100
IF A <= 20
	STR:0 = 国語
ELSEIF A <= 40
	STR:0 = 数学
ELSEIF A <= 55
	STR:0 = 英語
ELSEIF A <= 70
	STR:0 = 理科
ELSEIF A <= 85
	STR:0 = 社会
ELSEIF A <= 92
	STR:0 = 体育
ELSEIF A <= 96
	STR:0 = 音楽
ELSE
	STR:0 = 家庭科
ENDIF

;成否判定
CALL GET_EXAM_SCORE
B = 70 + P / 50
SIF B > 99
	B = 99
A = RAND:100
IF A <= 10
	;10%で大成功（よく理解できた）
	TFLAG:18 = 1
ELSEIF A >= B
	;失敗（ついていけなかった）
	TFLAG:18 = -1
ELSE
	;通常
	TFLAG:18 = 0
ENDIF

;メッセージ表示
IF TARGET >= 0
	PRINTFORMW %CALLNAME:MASTER%は%CALLNAME:TARGET%と一緒に%STR:0%の授業を受けた
ELSE
	PRINTFORMW %CALLNAME:MASTER%は%STR:0%の授業を受けた
ENDIF

IF TFLAG:18 == 1
	PRINTFORML 今日の授業はとてもよく理解できた！
ELSEIF TFLAG:18 == -1
	PRINTFORML ……しかし、内容が難しくてあまり理解できなかった
ENDIF

;体力・気力消費
BASE:MASTER:4 -= 30
BASE:MASTER:1 -= 50

;学習経験の獲得
A = RAND:10
IF A <= 5
	B = 1
ELSEIF A <= 8
	B = 2
ELSE
	B = 3
ENDIF

IF TFLAG:18 == -1
	B -= 1
	SIF B < 0
		B = 0
ELSEIF TFLAG:18 == 1
	B += 1
ENDIF

IF B > 0
	EXP:MASTER:95 += B
	PRINTFORML %EXPNAME:95%+{B}（%CALLNAME:MASTER%）
	IF TARGET >= 0
		EXP:TARGET:95 += B
		PRINTFORML %EXPNAME:95%+{B}（%CALLNAME:TARGET%）
	ENDIF
ENDIF

;好感度変動（パートナーと一緒の場合）
IF TARGET >= 0
	A = RAND:5 - 1
	IF TFLAG:18 == 1
		A += 2
	ELSEIF TFLAG:18 == -1
		A -= 1
	ENDIF
	TFLAG:30 += A
	LOSEBASE:4 += 20
ENDIF

;ソース（好感度ポイント）
SOURCE:18 = 50
IF TFLAG:18 == 1
	TIMES SOURCE:18 , 2.00
ELSEIF TFLAG:18 == -1
	TIMES SOURCE:18 , 0.50
ENDIF

;学習進度を進める
SIF FLAG:27 < 10
	FLAG:27 += 1
SIF FLAG:27 > 10 && FLAG:27 < 20
	FLAG:27 += 1

RETURN 1

;---------------------------------------------------------
;試験を受ける（旧BATTLE_BOSS）
;---------------------------------------------------------
@TAKE_EXAM
PRINTL 

;試験名決定（TFLAG:83 0=中間 1=期末）
IF TFLAG:83 == 0
	STR:0 = 中間試験
ELSE
	STR:0 = 期末試験
ENDIF

CALL GET_SEMESTER_NAME
PRINTFORML ＝＝＝ %STR:10% %STR:0% ＝＝＝
PRINTL 

;試験スコア計算
CALL GET_EXAM_SCORE

;難易度による合格ラインの調整
IF FLAG:5 == 0
	;EASY: 合格ライン低め
	LOCAL:5 = 40 + FLAG:24 * 5
ELSEIF FLAG:5 == 1
	;NORMAL
	LOCAL:5 = 50 + FLAG:24 * 8
ELSEIF FLAG:5 == 2
	;HARD
	LOCAL:5 = 55 + FLAG:24 * 10
ELSE
	;LUNATIC
	LOCAL:5 = 60 + FLAG:24 * 12
ENDIF

;ランダム変動（±10点）
A = RAND:21 - 10
P += A

;パートナーがいれば勉強を教えてもらえるボーナス
IF TARGET >= 0
	;パートナーの学力で補正
	LOCAL:3 = ABL:88 / 5
	;好感度でさらに補正
	IF CFLAG:2 >= 500
		LOCAL:3 += 10
	ELSEIF CFLAG:2 >= 200
		LOCAL:3 += 5
	ELSEIF CFLAG:2 >= 50
		LOCAL:3 += 2
	ENDIF
	P += LOCAL:3
	PRINTFORML %CALLNAME:TARGET%が勉強を手伝ってくれた（+{LOCAL:3}点）
ENDIF

SIF P < 0
	P = 0
SIF P > 100
	P = 100

;結果表示
PRINTFORML あなたの得点：{P}点（合格ライン：{LOCAL:5}点）
PRINTL 

;体力・気力消費（試験は疲れる）
BASE:MASTER:4 -= 80
BASE:MASTER:1 -= 100
SIF TARGET >= 0
	LOSEBASE:4 += 50

;合否判定
IF P >= LOCAL:5
	;合格
	PRINTFORML ＊＊＊ 合格！ ＊＊＊
	IF P >= LOCAL:5 + 30
		PRINTFORML 素晴らしい成績です！クラスでもトップクラスの点数でした
		SOURCE:18 = 500
		SOURCE:5 = 200
	ELSEIF P >= LOCAL:5 + 15
		PRINTFORML なかなかの好成績です
		SOURCE:18 = 300
		SOURCE:5 = 100
	ELSE
		PRINTFORML ギリギリですが、合格は合格です
		SOURCE:18 = 150
		SOURCE:5 = 50
	ENDIF
	
	;学習経験ボーナス
	B = 3 + FLAG:24
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度ボーナス
	IF TARGET >= 0
		TFLAG:30 += 5
	ENDIF
	
	;学力レベルアップ判定
	IF EXP:MASTER:95 >= (ABL:MASTER:88 + 1) * 50
		ABL:MASTER:88 += 1
		PRINTFORMW %CALLNAME:MASTER%の学力がレベルアップした！（学力Lv{ABL:MASTER:88}）
	ENDIF
	
	;試験クリア処理
	IF TFLAG:83 == 0
		;中間試験合格 → 後半（期末フェーズ）へ
		FLAG:27 = 1
		PRINTFORMW 中間試験に合格！後半戦もしっかり頑張ろう。
		RETURN 1
	ELSE
		;期末試験合格 → 次の学期へ
		FLAG:27 = 0
		FLAG:24 += 1
		IF FLAG:24 > 9
			;全学期クリア（卒業）
			PRINTFORMW おめでとう！ 全ての試験に合格し、卒業を迎えました！
			TRYCALL GAME_CONTINUE
			RETURN 2
		ELSE
			CALL GET_SEMESTER_NAME
			PRINTFORMW 期末試験に合格！%STR:10%に進みます！
		ENDIF
		RETURN 2
	ENDIF
ELSE
	;不合格
	PRINTFORML ……不合格
	IF P < LOCAL:5 - 20
		PRINTFORML かなり厳しい結果です。もっと勉強が必要でしょう
	ELSE
		PRINTFORML もう少しで合格でした。次は頑張りましょう
	ENDIF
	SOURCE:18 = 30
	
	;不合格でも経験値は少し入る
	B = 1
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度少し下がる
	SIF TARGET >= 0
		TFLAG:30 -= 2
ENDIF

PRINTW 

RETURN 1

;---------------------------------------------------------
;試験スコア計算
;結果はPに格納（0～100の範囲目安）
;---------------------------------------------------------
@GET_EXAM_SCORE
P = 0

;基礎学力（ABL:88）
IF ABL:MASTER:88 <= 1
	P = 20 + ABL:MASTER:88 * 10
ELSEIF ABL:MASTER:88 <= 3
	P = 30 + ABL:MASTER:88 * 5
ELSEIF ABL:MASTER:88 <= 5
	P = 40 + ABL:MASTER:88 * 3
ELSEIF ABL:MASTER:88 <= 10
	P = 45 + ABL:MASTER:88 * 2
ELSE
	P = 50 + ABL:MASTER:88
ENDIF

;学力素質（ABL:98）の補正
IF ABL:MASTER:98 > 0
	IF ABL:MASTER:98 <= 30
		P += ABL:MASTER:98 / 5
	ELSEIF ABL:MASTER:98 <= 60
		P += 6 + (ABL:MASTER:98 - 30) / 4
	ELSE
		P += 14 + (ABL:MASTER:98 - 60) / 3
	ENDIF
ENDIF

;学習経験（EXP:95）の補正
IF EXP:MASTER:95 > 0
	IF EXP:MASTER:95 <= 50
		P += EXP:MASTER:95 / 5
	ELSEIF EXP:MASTER:95 <= 200
		P += 10 + (EXP:MASTER:95 - 50) / 10
	ELSE
		P += 25 + (EXP:MASTER:95 - 200) / 20
	ENDIF
ENDIF

;上限
SIF P > 95
	P = 95

RETURN 1

;---------------------------------------------------------
;以下、旧戦闘システムの関数（互換性のため残置）
;emuera.configの設定により呼び出されなければ無視される
;---------------------------------------------------------

;---------------------------------------------------------
;学期末試験 自動発動版
;ENDING_CHECK(日数切れ)から呼ばれる
;合格 → 次の学期へ（RETURN 1）
;不合格 → バッドエンド処理
;---------------------------------------------------------
@SEMESTER_EXAM_AUTO
;TFLAG:83: 0=中間試験 1=期末試験
PRINTL
CALL GET_SEMESTER_NAME
IF TFLAG:83 == 0
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
	PRINTFORML 　%STR:10% 中間試験の時期になりました！
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
ELSE
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
	PRINTFORML 　%STR:10% 期末試験の時期になりました！
	PRINTFORML ★━━━━━━━━━━━━━━━━━━━━━━━━★
ENDIF
WAIT

CALL TAKE_EXAM

IF RESULT == 2
	;期末合格 → 次学期（FLAG:24はTAKE_EXAM内で進んでいる）
	RETURN 1
ELSEIF RESULT == 1
	;中間合格 → 後半へ（FLAG:27=1はTAKE_EXAM内で設定済み）
	RETURN 1
ELSE
	;不合格 → バッドエンド
	PRINTFORML
	IF TFLAG:83 == 0
		PRINTFORML 中間試験に合格できなかった。
	ELSE
		PRINTFORML 期末試験に合格できなかった。
	ENDIF
	PRINTFORMW %CALLNAME:MASTER%の学院生活はここで終わりを迎えた……
	PRINTFORML
	PRINTFORMW 　　　　　　　　―― Bad Ending（試験不合格）
	PRINTFORML
	PRINTFORMW 今の状態を引き継いで、最初からやり直せます。どうしますか？
	PRINTFORML [0] こんな事はなかった事に！
	PRINTFORML [1] やり直さない（ゲーム終了）
	$INPUT_LOOP_FAIL
	INPUT
	SIF RESULT != 0 && RESULT != 1
		GOTO INPUT_LOOP_FAIL
	IF RESULT == 0
		PRINTFORMW それでは1日目、1年1学期に戻ります。
		REPEAT CHARANUM
			SIF TALENT:COUNT:134 || MARK:COUNT:90
				CFLAG:COUNT:110 -= DAY
		REND
		DAY = 0
		TIME = 0
		FLAG:24 = 1
		FLAG:25 = 0
		FLAG:26 += 1
		FLAG:27 = 0
		TARGET = -1
		ASSI = -1
		CALL START_PARTNER_SELECT
	ELSEIF RESULT == 1
		PRINTFORMW お疲れ様でした。
		QUIT
	ENDIF
ENDIF
RETURN 1

