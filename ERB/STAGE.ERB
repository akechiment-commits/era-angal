;---------------------------------------------------------
;学期進行・試験システム
;旧STAGE.ERB（戦闘システム）を学園生活用に全面改修
;
;学期進行メニュー
;	@STAGE_CAPTURE
;学習状況の表示
;	@SHOW_STUDY_STATUS
;授業・自習（旧：道中攻略）
;	@STUDY_SESSION
;試験を受ける（旧：ボス戦）
;	@TAKE_EXAM
;試験スコア計算
;	@GET_EXAM_SCORE
;試験結果の表示
;	@SHOW_EXAM_RESULT
;学期名取得
;	@GET_SEMESTER_NAME
;---------------------------------------------------------
;使用変数（旧戦闘システムと互換）
;FLAG:24 → 現在の学期（1～6: 1年1学期～3年2学期）
;FLAG:25 → （未使用、旧ボスNO）
;FLAG:27 → 学習進度（0～9:授業中、10:中間試験可、11～19:中間後、20:期末試験可）
;FLAG:5  → 難易度（0=EASY～3=LUNATIC）
;TFLAG:46 → 授業回数カウンタ
;ABL:88  → 学力
;ABL:98  → 学力素質
;EXP:95  → 学習経験
;P       → 試験スコア計算用
;---------------------------------------------------------

@GET_SEMESTER_NAME
;FLAG:24から学期名をSTR:10に設定
IF FLAG:24 == 1
	STR:10 = 1年1学期
ELSEIF FLAG:24 == 2
	STR:10 = 1年2学期
ELSEIF FLAG:24 == 3
	STR:10 = 2年1学期
ELSEIF FLAG:24 == 4
	STR:10 = 2年2学期
ELSEIF FLAG:24 == 5
	STR:10 = 3年1学期
ELSEIF FLAG:24 == 6
	STR:10 = 3年2学期
ELSE
	STR:10 = 卒業済み
ENDIF
RETURN 1

;---------------------------------------------------------
;学期進行メインメニュー
;---------------------------------------------------------
@STAGE_CAPTURE
TFLAG:46 = 0

$START_POINT

;所持金の上限設定
SIF MONEY >= 999999999999999999
	MONEY = 999999999999999999

PRINTL  
CALL GET_SEMESTER_NAME
PRINTFORML 現在 %STR:10% （学習進度：{FLAG:27}）  所持金：${MONEY}

CALL SHOW_STUDY_STATUS

;初期化
VARSET V, 0
VARSET W, 0
VARSET X, 0
VARSET Y, 0
VARSET Z, 0
VARSET LOCAL, 0

PRINTFORML どうしますか？
PRINTFORML [0] 授業を受ける
IF FLAG:27 == 10
	PRINTFORML [1] 中間試験を受ける
	LOCAL:1 = 1
ELSEIF FLAG:27 >= 20
	PRINTFORML [1] 期末試験を受ける
	LOCAL:1 = 1
ENDIF
PRINTFORML [2] 教室に戻る
PRINTFORML [8] まとめて授業を受ける（回数指定）
PRINTFORML [9] まとめて授業を受ける（体力の限り）

$INPUT_LOOP
INPUT
IF RESULT == 0
	CALL STUDY_SESSION
	TFLAG:46 += 1
ELSEIF RESULT == 1 && LOCAL:1
	CALL TAKE_EXAM
	;試験で学期が進んだら終了
	SIF RESULT == 2
		RETURN 1
ELSEIF RESULT == 2
	IF TARGET >= 0
		PRINTFORMW %CALLNAME:MASTER%と%CALLNAME:TARGET%は教室に戻ることにした
	ELSE
		PRINTFORMW %CALLNAME:MASTER%は教室に戻ることにした
	ENDIF
	TFLAG:600 = 35
	TRYCALL KOJO_JUN
	RETURN 1
ELSEIF RESULT == 8
	PRINTFORML 何コマ分受けますか？
	INPUT
	SIF RESULT <= 0
		RESULT = 1
	K:1 = RESULT
	PRINTFORMW %CALLNAME:MASTER%は集中して授業を受けることにした……
	REPEAT K:1
		;体力チェック
		IF BASE:MASTER:4 <= MAXBASE:MASTER:4 / 4
			PRINTFORMW 疲れてきたので切り上げることにした
			BREAK
		ENDIF
		CALL STUDY_SESSION
		TFLAG:46 += 1
	REND
ELSEIF RESULT == 9
	PRINTFORMW %CALLNAME:MASTER%は体力の続く限り授業を受けることにした……
	REPEAT 99
		;体力チェック
		IF BASE:MASTER:4 <= MAXBASE:MASTER:4 / 4
			PRINTFORMW 疲れてきたので切り上げることにした
			BREAK
		ENDIF
		CALL STUDY_SESSION
		TFLAG:46 += 1
	REND
ELSE
	PRINTFORML 正しい値を入力してください
	GOTO INPUT_LOOP
ENDIF

;体力切れチェック
IF BASE:MASTER:4 <= 0
	PRINTFORMW %CALLNAME:MASTER%は疲れ果てて寝てしまった……
	RETURN 1
ENDIF
SIF TARGET >= 0 && BASE:4 <= 0
	RETURN 1

;試験出現判定
IF FLAG:27 < 10 || (FLAG:27 > 10 && FLAG:27 < 20)
	A = RAND:100
	IF FLAG:27 < 10 && FLAG:27 >= 3
		;3回以上授業を受ければ、進度×15%で中間試験期間に
		IF A <= FLAG:27 * 15
			FLAG:27 = 10
			PRINTFORMW そろそろ中間試験の時期です。準備はいいですか？
		ENDIF
	ELSEIF FLAG:27 > 10 && FLAG:27 < 20 && FLAG:27 >= 13
		;中間試験後3回以上で、進度×11%で期末試験期間に
		IF A <= (FLAG:27 - 10) * 11
			FLAG:27 = 20
			PRINTFORMW いよいよ期末試験が近づいてきました。しっかり復習しましょう！
		ENDIF
	ENDIF
ENDIF

GOTO START_POINT

RETURN 1

;---------------------------------------------------------
;学習状況の表示
;---------------------------------------------------------
@SHOW_STUDY_STATUS
DRAWLINE

IF TARGET >= 0
	PRINTFORML （%CALLNAME:TARGET%）  学力：{ABL:88}  学力素質：{ABL:98}
	PRINT 体力
	A = BASE:4
	SIF BASE:4 < 0
		A = 0
	CALL PRINT_BAR_4, A, MAXBASE:4, 32
	PRINTFORML ({A}/{MAXBASE:4})
	PRINT 気力
	A = BASE:1
	SIF BASE:1 < 0
		A = 0
	CALL PRINT_BAR, A, MAXBASE:1, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
	PRINTFORML ({A}/{MAXBASE:1})
ENDIF

PRINTFORML （%CALLNAME:MASTER%）  学力：{ABL:MASTER:88}
PRINT 体力
A = BASE:MASTER:4
SIF BASE:MASTER:4 < 0
	A = 0
CALL PRINT_BAR_4, A, MAXBASE:MASTER:4, 32
PRINTFORML ({A}/{MAXBASE:MASTER:4})
PRINT 気力
A = BASE:MASTER:1
SIF BASE:MASTER:1 < 0
	A = 0
CALL PRINT_BAR, A, MAXBASE:MASTER:1, 32, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1
PRINTFORML ({A}/{MAXBASE:MASTER:1})

DRAWLINE
RETURN 1

;---------------------------------------------------------
;授業・自習セッション（旧BATTLE_NORMAL）
;---------------------------------------------------------
@STUDY_SESSION
PRINTL 

;授業の種類をランダム決定
A = RAND:100
IF A <= 20
	STR:0 = 国語
ELSEIF A <= 40
	STR:0 = 数学
ELSEIF A <= 55
	STR:0 = 英語
ELSEIF A <= 70
	STR:0 = 理科
ELSEIF A <= 85
	STR:0 = 社会
ELSEIF A <= 92
	STR:0 = 体育
ELSEIF A <= 96
	STR:0 = 音楽
ELSE
	STR:0 = 家庭科
ENDIF

;成否判定
CALL GET_EXAM_SCORE
B = 70 + P / 50
SIF B > 99
	B = 99
A = RAND:100
IF A <= 10
	;10%で大成功（よく理解できた）
	TFLAG:18 = 1
ELSEIF A >= B
	;失敗（ついていけなかった）
	TFLAG:18 = -1
ELSE
	;通常
	TFLAG:18 = 0
ENDIF

;メッセージ表示
IF TARGET >= 0
	PRINTFORMW %CALLNAME:MASTER%は%CALLNAME:TARGET%と一緒に%STR:0%の授業を受けた
ELSE
	PRINTFORMW %CALLNAME:MASTER%は%STR:0%の授業を受けた
ENDIF

IF TFLAG:18 == 1
	PRINTFORML 今日の授業はとてもよく理解できた！
ELSEIF TFLAG:18 == -1
	PRINTFORML ……しかし、内容が難しくてあまり理解できなかった
ENDIF

;体力・気力消費
BASE:MASTER:4 -= 30
BASE:MASTER:1 -= 50

;学習経験の獲得
A = RAND:10
IF A <= 5
	B = 1
ELSEIF A <= 8
	B = 2
ELSE
	B = 3
ENDIF

IF TFLAG:18 == -1
	B -= 1
	SIF B < 0
		B = 0
ELSEIF TFLAG:18 == 1
	B += 1
ENDIF

IF B > 0
	EXP:MASTER:95 += B
	PRINTFORML %EXPNAME:95%+{B}（%CALLNAME:MASTER%）
	IF TARGET >= 0
		EXP:TARGET:95 += B
		PRINTFORML %EXPNAME:95%+{B}（%CALLNAME:TARGET%）
	ENDIF
ENDIF

;好感度変動（パートナーと一緒の場合）
IF TARGET >= 0
	A = RAND:5 - 1
	IF TFLAG:18 == 1
		A += 2
	ELSEIF TFLAG:18 == -1
		A -= 1
	ENDIF
	TFLAG:30 += A
	LOSEBASE:4 += 20
ENDIF

;ソース（好感度ポイント）
SOURCE:18 = 50
IF TFLAG:18 == 1
	TIMES SOURCE:18 , 2.00
ELSEIF TFLAG:18 == -1
	TIMES SOURCE:18 , 0.50
ENDIF

;学習進度を進める
SIF FLAG:27 < 10
	FLAG:27 += 1
SIF FLAG:27 > 10 && FLAG:27 < 20
	FLAG:27 += 1

RETURN 1

;---------------------------------------------------------
;試験を受ける（旧BATTLE_BOSS）
;---------------------------------------------------------
@TAKE_EXAM
PRINTL 

;試験名決定
IF FLAG:27 == 10
	STR:0 = 中間試験
ELSE
	STR:0 = 期末試験
ENDIF

CALL GET_SEMESTER_NAME
PRINTFORML ＝＝＝ %STR:10% %STR:0% ＝＝＝
PRINTL 

;試験スコア計算
CALL GET_EXAM_SCORE

;難易度による合格ラインの調整
IF FLAG:5 == 0
	;EASY: 合格ライン低め
	LOCAL:5 = 40 + FLAG:24 * 5
ELSEIF FLAG:5 == 1
	;NORMAL
	LOCAL:5 = 50 + FLAG:24 * 8
ELSEIF FLAG:5 == 2
	;HARD
	LOCAL:5 = 55 + FLAG:24 * 10
ELSE
	;LUNATIC
	LOCAL:5 = 60 + FLAG:24 * 12
ENDIF

;ランダム変動（±10点）
A = RAND:21 - 10
P += A

;パートナーがいれば勉強を教えてもらえるボーナス
IF TARGET >= 0
	;パートナーの学力で補正
	LOCAL:3 = ABL:88 / 5
	;好感度でさらに補正
	IF CFLAG:2 >= 500
		LOCAL:3 += 10
	ELSEIF CFLAG:2 >= 200
		LOCAL:3 += 5
	ELSEIF CFLAG:2 >= 50
		LOCAL:3 += 2
	ENDIF
	P += LOCAL:3
	PRINTFORML %CALLNAME:TARGET%が勉強を手伝ってくれた（+{LOCAL:3}点）
ENDIF

SIF P < 0
	P = 0
SIF P > 100
	P = 100

;結果表示
PRINTFORML あなたの得点：{P}点（合格ライン：{LOCAL:5}点）
PRINTL 

;体力・気力消費（試験は疲れる）
BASE:MASTER:4 -= 80
BASE:MASTER:1 -= 100
SIF TARGET >= 0
	LOSEBASE:4 += 50

;合否判定
IF P >= LOCAL:5
	;合格
	PRINTFORML ＊＊＊ 合格！ ＊＊＊
	IF P >= LOCAL:5 + 30
		PRINTFORML 素晴らしい成績です！クラスでもトップクラスの点数でした
		SOURCE:18 = 500
		SOURCE:5 = 200
	ELSEIF P >= LOCAL:5 + 15
		PRINTFORML なかなかの好成績です
		SOURCE:18 = 300
		SOURCE:5 = 100
	ELSE
		PRINTFORML ギリギリですが、合格は合格です
		SOURCE:18 = 150
		SOURCE:5 = 50
	ENDIF
	
	;学習経験ボーナス
	B = 3 + FLAG:24
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度ボーナス
	IF TARGET >= 0
		TFLAG:30 += 5
	ENDIF
	
	;学力レベルアップ判定
	IF EXP:MASTER:95 >= (ABL:MASTER:88 + 1) * 50
		ABL:MASTER:88 += 1
		PRINTFORMW %CALLNAME:MASTER%の学力がレベルアップした！（学力Lv{ABL:MASTER:88}）
	ENDIF
	
	;試験クリア処理
	IF FLAG:27 == 10
		;中間試験合格 → 期末試験フェーズへ
		FLAG:27 = 11
		PRINTFORMW 中間試験に合格しました。引き続き期末試験に備えましょう
	ELSE
		;期末試験合格 → 次の学期へ
		FLAG:27 = 0
		FLAG:24 += 1
		IF FLAG:24 > 6
			;全学期クリア（卒業）
			PRINTFORMW おめでとう！ 全ての試験に合格し、卒業を迎えました！
			TRYCALL GAME_CONTINUE
			RETURN 2
		ELSE
			CALL GET_SEMESTER_NAME
			PRINTFORMW %STR:0%に合格！ %STR:10%に進級しました！
		ENDIF
		RETURN 2
	ENDIF
ELSE
	;不合格
	PRINTFORML ……不合格
	IF P < LOCAL:5 - 20
		PRINTFORML かなり厳しい結果です。もっと勉強が必要でしょう
	ELSE
		PRINTFORML もう少しで合格でした。次は頑張りましょう
	ENDIF
	SOURCE:18 = 30
	
	;不合格でも経験値は少し入る
	B = 1
	PRINTFORML %EXPNAME:95%+{B}
	EXP:MASTER:95 += B
	SIF TARGET >= 0
		EXP:95 += B
	
	;好感度少し下がる
	SIF TARGET >= 0
		TFLAG:30 -= 2
ENDIF

PRINTW 

RETURN 1

;---------------------------------------------------------
;試験スコア計算
;結果はPに格納（0～100の範囲目安）
;---------------------------------------------------------
@GET_EXAM_SCORE
P = 0

;基礎学力（ABL:88）
IF ABL:MASTER:88 <= 1
	P = 20 + ABL:MASTER:88 * 10
ELSEIF ABL:MASTER:88 <= 3
	P = 30 + ABL:MASTER:88 * 5
ELSEIF ABL:MASTER:88 <= 5
	P = 40 + ABL:MASTER:88 * 3
ELSEIF ABL:MASTER:88 <= 10
	P = 45 + ABL:MASTER:88 * 2
ELSE
	P = 50 + ABL:MASTER:88
ENDIF

;学力素質（ABL:98）の補正
IF ABL:MASTER:98 > 0
	IF ABL:MASTER:98 <= 30
		P += ABL:MASTER:98 / 5
	ELSEIF ABL:MASTER:98 <= 60
		P += 6 + (ABL:MASTER:98 - 30) / 4
	ELSE
		P += 14 + (ABL:MASTER:98 - 60) / 3
	ENDIF
ENDIF

;学習経験（EXP:95）の補正
IF EXP:MASTER:95 > 0
	IF EXP:MASTER:95 <= 50
		P += EXP:MASTER:95 / 5
	ELSEIF EXP:MASTER:95 <= 200
		P += 10 + (EXP:MASTER:95 - 50) / 10
	ELSE
		P += 25 + (EXP:MASTER:95 - 200) / 20
	ENDIF
ENDIF

;上限
SIF P > 95
	P = 95

RETURN 1

