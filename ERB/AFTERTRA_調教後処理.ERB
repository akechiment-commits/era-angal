@GET_DIGIT
LOCAL:1 = 100000000000000000
LOCAL:2 = 18
FOR LOCAL, 0, 19
	SIF LOCAL:2 == 0
		RETURN 0
	IF (T / LOCAL:1) >= 1
		RETURN LOCAL:2
	ELSE
