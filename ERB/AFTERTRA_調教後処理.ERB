RETURN 0

;-------------------------------------------------
;コマンド多様性ボーナス（セッション終了時）
;-------------------------------------------------
@CMD_VARIETY_BONUS
;使用済みフラグをリセット
FOR LOCAL:0, 0, 500
	FLAG:(16010 + LOCAL:0) = 0
NEXT
IF FLAG:16002 == 0
	FLAG:16002 = 0
	RETURN 0
ENDIF
;種類数×2%を全珠に乗算してJUELへ追加（JUEL_CHECK後なのでJUELへ直接）
LOCAL:1 = FLAG:16002 * 2
FOR LOCAL:0, 0, 21
	;GOTJUEL:LOCAL:0だとLOCAL:0をキャラ番号と誤解釈し範囲外エラー。括弧でパラム番号として評価する
	SIF GOTJUEL:(LOCAL:0) > 0
		JUEL:(LOCAL:0) += GOTJUEL:(LOCAL:0) * LOCAL:1 / 100
NEXT
;表示
PRINTFORML 　（コマンド{FLAG:16002}種 +{LOCAL:1}％）
;リセット
FLAG:16002 = 0
RETURN 0
