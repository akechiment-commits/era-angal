;上のTARGETとかMASTERを返すシステム
@IS_SYSTEM(ARG)
#FUNCTION

SELECTCASE ARG
	CASE -1
		RETURNF TARGET
	CASE 0
		RETURNF MASTER
	CASEELSE
		SIF GETCHARA(NO:ARG) == -1
			THROW エラー：対象が正しく指定されていません！
		RETURNF ARG
ENDSELECT

