@KOJO_JUN_K100
;--------------------------------------------------
;エキストラモード構文　CFLAG:220を使用
;はいを選択した時に初調教時に口上設定用の素質に変更できます
;下記に処女化する場合の構文をサンプルとして載せておきます
;------------------------------------------------
IF TFLAG:600 == 0 && CFLAG:220 == 0
	PRINTL 華扇を処女にします。
	PRINTL [0] いいですよ
	PRINTL [1] そのままでいいですよ
	$INPUT_LOOP
	INPUT
	IF RESULT == 0
		PRINTFORMW ―処女モードに素質、能力を変更します―
;素質：処女を得る、能力：V感覚を0にする、経験：V経験を0にする。
		TALENT:TARGET:0 = 1
		ABL:TARGET:4 = 0
		EXP:TARGET:0 = 0
	ELSEIF RESULT == 1
		PRINTFORMW やっぱり経験があるんですかねぇ
	ELSE
		GOTO INPUT_LOOP
	ENDIF
	CFLAG:220 = 1
ENDIF

