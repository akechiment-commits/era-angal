;純愛口上用雛形
;このテンプレートはeratohoJ用の口上テンプレートですので、
;eratohoJ系列以外のバリアントでは使用しないようにしてください
;純愛イベント口上ではCALL COMMON_PLANE_TEXTを挿入することで、共通の地の文を呼び出せます
;X1、X2をキャラ番号に置換してください。
;なお、キャラ番号が0番代の場合はX1は一桁で置換（例:1）し、
;X2は0を含めて二桁で置換（例:01）してください
;-------------------------------------------------
;朝イベントを回避する関数とパッチを提供していただきました
;また、スレで朝イベントを呼ぶタイミングなども教えていただきました。心より御礼を申し上げます
;-------------------------------------------------
@EVENTSHOP
;現在のパートナーがいないときは即終了
SIF TARGET < 0
	RETURN 0
;パートナーがリリーでないなら即終了
SIF NO:TARGET != 15
	RETURN 0
;パートナーがリリーで体操フラグが立っていたら朝イベントをカットするフラグを立てる
SIF CFLAG:623
	TFLAG:121 = 1
;特定のエンディング時に朝イベントをカットするフラグを立てる
SIF CFLAG:616
	TFLAG:121 = 1
;--------------------------------------------------
;口上ファイルの存在判定（15をキャラ番号に置換）
;--------------------------------------------------
@EVENTTRAIN
#PRI
FLAG:115 = 1
SIF FLAG:7 == 0
FLAG:7 = 2

@EVENTEND
#LATER
FLAG:115 = 0
;--------------------------------------------------
;純愛イベント口上　 CFLAG221
;--------------------------------------------------
@KOJO_JUN_K15
;壊れた時（狂気がある）口上をスキップする
;このスキップ構文はJ美鈴口上から頂きました。ありがとうございます
SIF TALENT:123
	RETURN 0
IF TFLAG:600 == 0 && CFLAG:220 == 0
	PRINTL  
	PRINTL 口上内のイベントで、珠や経験が、ちみっと増えたりしても構いませんか？
	PRINTL [0] 構いません
	PRINTL [1] ダメ
	$INPUT_LOOP_K15_EX_01
	INPUT
	SIF RESULT != 0 && RESULT != 1
		GOTO INPUT_LOOP_K15_EX_01
	IF RESULT == 0
		PRINTW ―了解しました―
		CFLAG:610 = 1
	ELSE
		PRINTL ―了解しました。ただし、口上の文章と、実際の現象が異なる可能性があります。
		PRINTW 　その場合、口上はただの演出とお考え下さい―
	ENDIF
	PRINTL  
	PRINTL 口上の頻度を選択してください
	PRINTL [0] 一度見た口上はできるだけ表示しない
	PRINTL [1] 何度でも表示する
	$INPUT_LOOP_K15_EX_02
	INPUT
	SIF RESULT < 0 && RESULT > 1
		GOTO INPUT_LOOP_K15_EX_02
	SIF RESULT == 1
		CFLAG:712 = 1
	PRINTW ―了解しました―
	CFLAG:220 = 1
	CFLAG:711 = 1
ENDIF
