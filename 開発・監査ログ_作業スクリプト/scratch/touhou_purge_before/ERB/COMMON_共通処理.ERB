CALL GET_STRAINNAME
CFLAG:A:14 = RESULT

;初期月経周期を設定
L = A
CALL EVENT_ADD_CHARA_MENSTRUATION

;キャラ加入時の陰毛設定
CALL GET_BASE8, A

;デフォルトのコマンドを指示
CFLAG:A:13 = CFLAG:MASTER:13

;初期の耐力と魔力を計算
;耐力＝体力を基準値として、絶頂経験で増加
MAXBASE:A:4 = MAXBASE:A:0 * (100 + EXP:A:2) / 100
;魔力＝気力の10%を基準値として、精液経験で増加
MAXBASE:A:5 = MAXBASE:A:1 / 10 * (50 + EXP:A:20) / 50
BASE:A:4 = MAXBASE:A:4
BASE:A:5 = MAXBASE:A:5

;SPキャラ加入時、通常状態のSPキャラにエンゲージリングを贈っていた場合、
;SPキャラとして加入後エンゲージリングが贈れなくなってしまう為初期化
IF CFLAG:A:0 && FLAG:29 == NO:A	; 【A:[EXフラグ]】
	FLAG:29 = 0
	TIME:9 = 0
	TIME:10 = 0
ENDIF

