@PUSH_OVER
;IF ASSIPLAY == 0 && (ABL:1 >= 7 || PALAM:3 >= 3000 || PALAM:5 >= 3000 || CFLAG:2 >= 10000)
;この条件で呼び出されているため、助手プレイ中は押し倒されない
;また、欲望Lv7以上、潤滑3000以上、欲情3000以上、好感度10000以上のどれかを満たす必要あり

;既に押し倒されてたら無視
;TFLAG:48は酔ってるお陰で服脱がせが成功したら１になるフラグ
;	または酔ってる勢いで押し倒されたら１になるフラグ
;TFLAG:51は押し倒されたら（押し倒され判定をクリアしたら）１になるフラグ
SIF TFLAG:48 || TFLAG:51	; 【[よっぱウフフ] / [押し倒され]】
	RETURN 0

;既に脱いでたら無視
SIF TFLAG:44	; 【[ウフフ中]】
	RETURN 0

;押し倒され数値判定。Aを使用
CALL PUSH_OVER_RATE

;合意有
IF TALENT:TARGET:152	; 【TARGET:[合意]】
	;ムード300突破で襲われる
	IF TFLAG:37 >= 300	; 【[ムード]>=300】
		;個別の口上があれば口上表示
		TRYCCALLFORM KOJO_PUSH_OVER_{NO:TARGET}
		CATCH
			;個別ないなら共通の地の文
			PRINTFORMW %CALLNAME:MASTER%が%CALLNAME:TARGET%と一旦別れようとして振り返ると、突然%CALLNAME:TARGET%に押し倒されてしまった
			PRINTFORMW 焦る%CALLNAME:MASTER%の服を%CALLNAME:TARGET%は上気した顔で次々と脱がしていく……
			PRINTFORMW そして完全に%CALLNAME:MASTER%の服を脱がした%CALLNAME:TARGET%は、自らも一糸纏わぬ姿になった
			PRINTFORMW ……どうやらこれは覚悟を決めねばならないようだ
		ENDCATCH
		
		;気力半分回復
		BASE:1 += MAXBASE:1 / 2
		SIF BASE:1 > MAXBASE:1	; 【[気力]>MAXBASE:1】
			BASE:1 = MAXBASE:1
		
		;ウフフ開始
		TFLAG:44 = 1
		;映画館から追い出される
		CALL GET_OUT_MOVIE
		;押し倒されフラグON
		TFLAG:51 = 1
		RETURN 1
	;酔い300突破で酔った勢いで襲われる
	ELSEIF TFLAG:47 >= 300	; 【[酩酊度]>=300】
		TFLAG:48 = 1
		;個別の口上があれば口上表示
		TRYCCALLFORM KOJO_PUSH_OVER_{NO:TARGET}
		CATCH
			;個別ないなら共通の地の文
			PRINTFORMW %CALLNAME:MASTER%が%CALLNAME:TARGET%と一旦別れようとして振り返ると、突然%CALLNAME:TARGET%に押し倒されてしまった
			PRINTFORMW 焦る%CALLNAME:MASTER%の服を%CALLNAME:TARGET%は上気した顔で次々と脱がしていく……
			PRINTFORMW そして完全に%CALLNAME:MASTER%の服を脱がした%CALLNAME:TARGET%は、自らも一糸纏わぬ姿になった
			IF TFLAG:48 == 1	; 【[よっぱウフフ]==1】
				PRINTFORMW その間何度も呼びかけてみたが、%CALLNAME:TARGET%の返事はどうも要領を得ない
				PRINTFORM 少し飲ませすぎてしまっただろうか
			ENDIF
			PRINTFORMW ……どうやらこれは覚悟を決めねばならないようだ
		ENDCATCH
		
		;気力半分回復
		BASE:1 += MAXBASE:1 / 2
		SIF BASE:1 > MAXBASE:1	; 【[気力]>MAXBASE:1】
			BASE:1 = MAXBASE:1
		
		;ウフフ開始
		TFLAG:44 = 1
		;映画館から追い出される
		CALL GET_OUT_MOVIE
		;押し倒されフラグON
		TFLAG:51 = 1
		RETURN 1
	ENDIF
;合意なし
ELSE
	;220突破で襲われる
	IF A >= 220
		TFLAG:48 = 0
		TFLAG:600 = 27
		CALL KOJO_JUN
		PRINTL  

		IF ASSIPLAY == 0 && TALENT:152 == 0	; 【[合意]なし / 調教者:[主人]】
			PRINTFORMW %CALLNAME:TARGET%の【合意】を得た
			TALENT:152 = 1
		ENDIF
		;気力全快
		BASE:1 = MAXBASE:1

		TFLAG:44 = 1

		;映画館から追い出される
		CALL GET_OUT_MOVIE
		;既成事実２に相当
		TFLAG:200 = 2
		CALL MARK_GOT_CHECK
		RETURN 1
	;酔った勢いで襲われる
	ELSEIF A >= 220 - TFLAG:47 / 2	; 【[酩酊度]】
		TFLAG:48 = 1
		TFLAG:600 = 27
		CALL KOJO_JUN
		PRINTL  

		;気力半分回復
		BASE:1 += MAXBASE:1 / 2
		SIF BASE:1 > MAXBASE:1	; 【[気力]>MAXBASE:1】
			BASE:1 = MAXBASE:1

		TFLAG:44 = 1
		;映画館から追い出される
		CALL GET_OUT_MOVIE
		;既成事実２に相当
		TFLAG:200 = 2
		CALL MARK_GOT_CHECK
		RETURN 1
	ENDIF
ENDIF

RETURN 0

