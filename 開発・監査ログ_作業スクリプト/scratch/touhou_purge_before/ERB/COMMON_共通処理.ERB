;目立ちたがり
SIF TALENT:28	; 【[目立ちたがり]】
	A += 2

;抑圧
SIF TALENT:32 == 1	; 【[抑圧]】
	A -= 10

;抵抗
SIF TALENT:34 == 1	; 【[抵抗]】
	A -= 10

