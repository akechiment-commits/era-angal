;-------------------------------------------------
;霧に飲まれかけているキャラ取得
;-------------------------------------------------
@GET_LOST_CHARA
;霧に飲まれかけているキャラの番号をランダムで取得し、Cに入れて返す。誰もいなければ０を返す

A = 0
B = 0
C = 0
D = 0

FOR LOCAL, 0, CHARANUM
	IF LOCAL == 0
		CONTINUE
	ELSEIF CFLAG:LOCAL:17	; 【LOCAL:[臨月・育児中]】
		A:B = LOCAL
		B += 1
	ENDIF
NEXT

IF B == 0
	C = 0
ELSE
	D = RAND:B
	C = A:D
ENDIF

RETURN 0


@SET_TMP_PARTNER
;暫定パートナーを選択
;好感度が一番高いキャラを暫定パートナーに
;臨月、育児中のキャラは回避
;別れているキャラは回避

A = 0
B = 0
FOR LOCAL, 0, CHARANUM
	SIF LOCAL == NO:MASTER
		CONTINUE
	SIF (FLAG:62 & 1) && (MARK:LOCAL:90 == 1)
		CONTINUE
	SIF CFLAG:LOCAL:21	; 【LOCAL:[別れ]】
		CONTINUE
	IF CFLAG:LOCAL:17 == 0	; 【LOCAL:[臨月・育児中]==0】
		IF CFLAG:LOCAL:2 > A	; 【LOCAL:[好感度]>A】
			A = CFLAG:LOCAL:2
			B = LOCAL
		ENDIF
	ENDIF
NEXT

IF B != 0
	SIF ASSI == B
		ASSI = -1
	TARGET = B
	SIF CFLAG:16 == 1	; 【[非表示]==1】
		CFLAG:16 = 0
	PRINTFORMW %CALLNAME:TARGET%をパートナーに選びました
	RETURN 1
ENDIF

RETURN 0


