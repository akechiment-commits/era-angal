@GET_BOSS_NO
;次のボスのNoを取得して、Bに入れて返す
A = 0
B = 0
D = 0

;!!!
;ボスになる可能性のあるキャラを全部チェックし、F配列に追加していく
;ボスのランダム選択(完全にランダムで選ぶ)変更。変数Gを追加で使用。
FOR LOCAL, 0, 200
	;今のところあなたがボスになる予定は無し
	SIF LOCAL == 0
		CONTINUE
	
	;CSVが存在しない番号（存在すればRESULT = 1）は選択しない
	EXISTCSV LOCAL,0
	SIF RESULT == 0
		CONTINUE

	;ランダム決定用に出現する可能性があるキャラを保存
	G:D = LOCAL
	D += 1
	
	T = LOCAL
	CALL GET_EXISTANCE
	;既に仲間になっているキャラは出さない
	SIF E
		CONTINUE


	;ここまで残ったキャラはボス候補
	F:A = LOCAL
	A += 1
NEXT

SIF D == 0
	RETURN 0

;ボス候補が誰もいない場合
IF A == 0
	;完全にランダムで選ぶ（幻影登場）
	A = RAND:D
	B = G:A
ELSE
	;誰か候補がいる場合
	;候補キャラの中からランダムで選ぶ
	D = RAND:A
	B = F:D
ENDIF

RETURN 1



@GET_CHARA_NAME
;Tで指定されたキャラ番号のキャラの名前をSTR:Nに入れて返す
;EXISTCSVは対応するキャラが定義されているかどうかをチェックし定義されていればRESULTに1、されていなければ0を返します
EXISTCSV T,0
IF RESULT == 1
	CSVNAME T, 0
	STR:N = %RESULTS%
ELSE
	STR:N = 誰かの幻影
ENDIF

RETURN 1



