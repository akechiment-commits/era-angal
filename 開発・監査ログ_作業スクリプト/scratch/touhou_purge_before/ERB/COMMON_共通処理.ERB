@GET_BATTLE_POWER_LIMIT
;戦闘力計算途中のオーバーフロー防止
IF 0
ELSEIF P > 999999999999999999
	P /= 100000
	V *= 100000
ELSEIF P > 99999999999999999
	P /= 10000
	V *= 10000
ELSEIF P > 9999999999999999
	P /= 1000
	V *= 1000
ELSEIF P > 999999999999999
	P /= 100
	V *= 100
ELSEIF P > 99999999999999
	P /= 10
	V *= 10
ENDIF

@GET_BATTLE_POWER
;Tで指定されたキャラの戦闘力をPに入れて返す
P = 0
;カンストチェック用にV使用
V = 1

;好感度
IF CFLAG:T:2 <= 50	; 【T:[好感度]<=50】
	P = CFLAG:T:2
ELSEIF CFLAG:T:2 <= 500	; 【T:[好感度]<=500】
	P = 50 + (CFLAG:T:2 - 50) / 2
ELSEIF CFLAG:T:2 <= 5000	; 【T:[好感度]<=5000】
	P = 300 + (CFLAG:T:2 - 500) / 3
ELSEIF CFLAG:T:2 <= 50000	; 【T:[好感度]<=50000】
	P = 2000 + (CFLAG:T:2 - 5000) / 4
ELSE
	P = 15000 + (CFLAG:T:2 - 50000) / 5
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;素質の無いキャラほど、好感度の影響を大きくする。愛だよ、愛
IF ABL:T:98 == 0	; 【T:[学力素質]Lv==0】
	;素質未設定はLv50とみなす＝倍率３倍
	TIMES P , 3.00
ELSEIF ABL:T:98 <= 10	; 【T:[学力素質]Lv<=10】
	;最弱
	TIMES P , 10.00
ELSEIF ABL:T:98 <= 20	; 【T:[学力素質]Lv<=20】
	;最弱クラス
	TIMES P , 7.00
ELSEIF ABL:T:98 <= 30	; 【T:[学力素質]Lv<=30】
	;弱い方
	TIMES P , 5.00
ELSEIF ABL:T:98 <= 50	; 【T:[学力素質]Lv<=50】
	;弱い方
	TIMES P , 3.00
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;戦闘技能レベル
IF ABL:T:88 <= 1	; 【T:[学力]Lv<=1】
	P += 50 + 50 * ABL:T:88
ELSEIF ABL:T:88 <= 3	; 【T:[学力]Lv<=3】
	P += 100 + 75 * ABL:T:88
ELSEIF ABL:T:88 <= 5	; 【T:[学力]Lv<=5】
	P += 300 + 100 * ABL:T:88
ELSEIF ABL:T:88 <= 8	; 【T:[学力]Lv<=8】
	P += 500 + 120 * ABL:T:88
ELSEIF ABL:T:88 <= 11	; 【T:[学力]Lv<=11】
	P += 800 + 150 * ABL:T:88
ELSEIF ABL:T:88 <= 25	; 【T:[学力]Lv<=25】
	P += 800 + 200 * ABL:T:88
ELSE
	P += 1000 + 300 * ABL:T:88
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;戦闘素質
IF ABL:T:98 == 0	; 【T:[学力素質]Lv==0】
	;素質未設定はLv50とみなす＝倍率55/25倍
	P = P * 55 / 25
ELSEIF ABL:T:98 <= 20	; 【T:[学力素質]Lv<=20】
	;最弱クラス
	P = P * (ABL:T:98 + 10) / 30
ELSEIF ABL:T:98 <= 50	; 【T:[学力素質]Lv<=50】
	;弱い方
	P = P * (ABL:T:98 + 5) / 25
ELSEIF ABL:T:98 < 80	; 【T:[学力素質]Lv<80】
	;強い方
	P = P * ABL:T:98 / 20
ELSE
	;最強クラス
	P = P * ABL:T:98 / 15
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;魔力(魔力による戦闘力は素質の影響を受けない)
IF BASE:T:5 <= 100
	P += BASE:T:5
ELSEIF BASE:T:5 <= 200
	P += BASE:T:5 * 3
ELSEIF BASE:T:5 <= 400
	P += BASE:T:5 * 5
ELSEIF BASE:T:5 <= 800
	P += BASE:T:5 * 8
ELSEIF BASE:T:5 <= 5000
	P += BASE:T:5 * 12
ELSE
	IF BASE:T:5 >= 588235294117647
		P += 999999999999999999
	ELSE
		P += BASE:T:5 * 17
	ENDIF
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;サドい人は戦闘力1.2倍
SIF TALENT:T:83	; 【T:[サド]】
	TIMES P , 1.20

;生理中はイラだって戦闘力1.2倍
SIF TALENT:T:138 && (FLAG:62 & 1)	; 【T:[生理]】
	TIMES P , 1.20

;母は強し
SIF TALENT:T:136	; 【T:[母性]】
	TIMES P , 1.20

CALL GET_BATTLE_POWER_LIMIT

;アクセサリ関係
IF FLAG:62 & 4
	;主人公のアクセサリで1%補正
	SIF CFLAG:MASTER:24 == NO:T	; 【MASTER:[アクセサリ2]==NO:T】
		TIMES P , 1.01
	
	;キャラが装備中のアクセサリで補正
	;アクセサリから戦闘素質を算出
	IF CFLAG:T:23 > 0	; 【T:[アクセサリ1]>0】
		CSVABL CFLAG:T:23, 98, 0
		LOCAL = RESULT
		;例えば戦闘素質が50のキャラのアクセサリを付けていた場合1.050倍になる
		IF P >= 9999999999999
			P = P / 1000 * (1000 + LOCAL)
		ELSE
			P = P * (1000 + LOCAL) / 1000
		ENDIF
	ENDIF
	IF CFLAG:T:24 > 0	; 【T:[アクセサリ2]>0】
		CSVABL CFLAG:T:24, 98, 0
		LOCAL = RESULT
		;例えば戦闘素質が50のキャラのアクセサリを付けていた場合1.050倍になる
		IF P >= 9999999999999
			P = P / 1000 * (1000 + LOCAL)
		ELSE
			P = P * (1000 + LOCAL) / 1000
		ENDIF
	ENDIF
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;Phモード限定の恋人ボーナス
IF FLAG:5 == 10 || TALENT:MASTER:恋人ボーナス || TALENT:MASTER:恋人ボーナス強化
	LOCAL:20 = 0
	FOR LOCAL, 0, CHARANUM
		SIF TALENT:LOCAL:153	; 【LOCAL:[恋人]】
			LOCAL:20 += 1
	NEXT
	SIF TALENT:MASTER:203	; 【MASTER:[恋人ボーナス強化]】
		TIMES LOCAL:20 , 1.50
	P = P / 10 * (10 + LOCAL:20)
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;Phモード限定の親愛ボーナス
IF FLAG:5 == 10 || TALENT:MASTER:親愛ボーナス || TALENT:MASTER:親愛ボーナス強化
	LOCAL:20 = 0
	FOR LOCAL, 0, CHARANUM
		SIF TALENT:LOCAL:88	; 【LOCAL:[親愛]】
			LOCAL:20 += 1
	NEXT
	SIF TALENT:MASTER:205	; 【MASTER:[親愛ボーナス強化]】
		TIMES LOCAL:20 , 3.00
	P = P / 5 * (5 + LOCAL:20)
ENDIF

CALL GET_BATTLE_POWER_LIMIT

;戦闘技能レベルによる倍率
IF P < 1000000
	IF ABL:T:88 <= 1	; 【T:[学力]Lv<=1】
		P = P * (ABL:T:88 * 10 + 50) / 100
	ELSEIF ABL:T:88 <= 3	; 【T:[学力]Lv<=3】
		P = P * (ABL:T:88 * 10 + 50) / 100
	ELSEIF ABL:T:88 <= 5	; 【T:[学力]Lv<=5】
		P = P * (ABL:T:88 * 7 + 60) / 100
	ELSEIF ABL:T:88 <= 8	; 【T:[学力]Lv<=8】
		P = P * (ABL:T:88 * 5 + 70) / 100
	ELSEIF ABL:T:88 <= 11	; 【T:[学力]Lv<=11】
		P = P * (ABL:T:88 * 4 + 80) / 100
	ELSEIF ABL:T:88 <= 25	; 【T:[学力]Lv<=25】
		P = P * (ABL:T:88 * 4 + 90) / 100
	ELSE
		P = P * (ABL:T:88 * 5 + 70) / 100
	ENDIF
ELSE
	P /= 200
	IF ABL:T:88 <= 1	; 【T:[学力]Lv<=1】
		P = P * (ABL:T:88 * 20 + 100)
	ELSEIF ABL:T:88 <= 3	; 【T:[学力]Lv<=3】
		P = P * (ABL:T:88 * 20 + 100)
	ELSEIF ABL:T:88 <= 5	; 【T:[学力]Lv<=5】
		P = P * (ABL:T:88 * 14 + 120)
	ELSEIF ABL:T:88 <= 8	; 【T:[学力]Lv<=8】
		P = P * (ABL:T:88 * 10 + 140)
	ELSEIF ABL:T:88 <= 11	; 【T:[学力]Lv<=11】
		P = P * (ABL:T:88 * 8 + 160)
	ELSEIF ABL:T:88 <= 25	; 【T:[学力]Lv<=25】
		P = P * (ABL:T:88 * 8 + 180)
	ELSEIF ABL:T:88 <= 100	; 【T:[学力]Lv<=100】
		P = P * (ABL:T:88 * 6 + 230)
	ELSEIF ABL:T:88 <= 1000	; 【T:[学力]Lv<=1000】
		P = P * (ABL:T:88 * 4 + 430)
	ELSE
		P = P * (ABL:T:88 + 3430)
	ENDIF
ENDIF

IF V > 1
	IF P >= 999999999999999999 / V
		P = 999999999999999999
	ELSE
		P *= V
	ENDIF
ENDIF

;カンストする場合。Emuera専用になったのでカンスト値上昇
SIF P >= 999999999999999999
	P = 999999999999999999

SIF TALENT:T:134	; 【T:[妊娠]】
	P = P / 20 * (CFLAG:T:110 - DAY:7)

SIF P < 1
	P = 1

RETURN 1

