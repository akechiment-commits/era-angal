;あなたの戦闘能力計算
;---------------------------------------------------------
@GET_BATTLE_POWER_MASTER
VARSET LOCAL, 0

;あなた自身の戦闘能力（LOCALに退避）
T = MASTER
CALL GET_BATTLE_POWER
LOCAL = P

;戦闘能力強化
IF ABL:MASTER:87 >= 1	; 【MASTER:[学力強化]Lv>=1】
	IF 999999999999999999 / ABL:MASTER:87 < LOCAL	; 【MASTER:[学力強化]】
		LOCAL = 999999999999999999
	ELSE
		IF ABL:MASTER:87 == 1	; 【MASTER:[学力強化]Lv==1】
			TIMES LOCAL , 1.50
		ELSE
			LOCAL *= ABL:MASTER:87
		ENDIF
	ENDIF
ENDIF

;パートナーが居れば、パートナーの戦闘能力の1/3をあなたの戦闘能力に加える
IF TARGET>= 0
	T = TARGET
	CALL GET_BATTLE_POWER
	;パートナーの戦闘能力を退避
	LOCAL:1 = P / 3
ENDIF

;助手が居れば、助手の戦闘能力の半分をあなたの戦闘能力に加える
IF ASSI >= 0
	T = ASSI
	CALL GET_BATTLE_POWER
	LOCAL:2 = P / 2
ENDIF

;戦闘能力合計
P = LOCAL + LOCAL:1 + LOCAL:2



@GET_STUFF
;Tで指定されたキャラ番号のキャラの各素質をS～S:4に入れて返す

ADDCHARA T
A = CHARANUM - 1
S = ABL:A:98	;学力素質
S:1 = ABL:A:54	;運動素質
S:2 = ABL:A:55	;表現素質
S:3 = ABL:A:56	;知識素質
S:4 = CFLAG:A:12	;主導権基準値（性格）
DELCHARA A

RETURN 1


@GET_EXISTANCE
;Tで指定されたキャラ番号のキャラが仲間にいる場合、Eにキャラの加入番号+1を入れて返す。居なければ0を返す
;例えば、主人公がそのキャラなら0+1＝1を返すし、最初のパートナーなら1+1＝2を返す

E = 0
FOR LOCAL, 0, CHARANUM
	SIF CFLAG:LOCAL:21 == 1	; 【LOCAL:[別れ]==1】
		CONTINUE
	SIF NO:LOCAL == T
		E = LOCAL + 1
NEXT

RETURN 1

@GET_EXISTANCE2
;Tで指定されたキャラ番号のキャラが仲間にいる場合、Eにキャラの加入番号+1を入れて返す。居なければ0を返す
;例えば、主人公がそのキャラなら0+1＝1を返すし、最初のパートナーなら1+1＝2を返す
;CFLAG:21が立っている一時離別中のキャラも居る扱いにする

E = 0
FOR LOCAL, 0, CHARANUM
