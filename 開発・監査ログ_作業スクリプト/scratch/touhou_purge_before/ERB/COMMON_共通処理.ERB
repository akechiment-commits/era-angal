;-------------------------------------------------
;CSVの名前取得関数
;-------------------------------------------------
@NAME_CSV(ARG, ARG:1)
#FUNCTIONS
;CSVが存在するか判定
;CSVが存在しない場合（存在すればRESULT = 1）は空白
EXISTCSV ARG, ARG:1
SIF RESULT == 0
	RETURNF ""

CSVNAME ARG, ARG:1
RETURNF RESULTS

;----------------------------------------------------------------
;ARGSで放り込んだ文字列を一文字刻みで区切り文字(ARGS:1)で区切って返す関数
;適当に作ったけど没……にするのも惜しいから適当に利用
;----------------------------------------------------------------
@SPLIT_EASY(ARGS, ARGS:1 = "/")
#FUNCTIONS
FOR LOCAL, 0, STRLENSU(ARGS)
	LOCALS += CHARATU(ARGS, LOCAL) + ARGS:1
NEXT

RETURNF LOCALS

;----------------------------------------------------------------
;キャラが居るか、別れてるか、それとも仲間にしてないのかを判定する式中関数
;居ない = 0, 居る = 1, 別れてる = 2
;----------------------------------------------------------------
@CHARA_NOW(ARG)
#FUNCTION
GETCHARA ARG
;居るまたはデータのみ居る
IF RESULT > -1
	;別れている
	SIF CFLAG:RESULT:別れ
		RETURNF 2
	;別れてない
	RETURNF 1
ENDIF
;居ない
RETURNF 0

