@ADD_NEW_CHARA_COMMON
;FLAG:25のキャラを追加
T = FLAG:25
CALL GET_EXISTANCE
IF E == 0
	T = FLAG:25
	FOR LOCAL, 0, CHARANUM
		SIF CFLAG:LOCAL:21 == 1 && NO:LOCAL == T	; 【LOCAL:[別れ]==1】
			E = LOCAL
	NEXT
	IF E != 0
		T = E
		CFLAG:T:21 = 0
		E = TARGET
		LOCAL:1 = TARGET
		TARGET = T
		T = FLAG:25
		TFLAG:600 = 36
		;口上の条件はTFLAG:600 == 36にしてください
		CALL KOJO_JUN
		TARGET = LOCAL:1
		TFLAG:600 = 0
	ELSE
		ADDCHARA FLAG:25
		A = CHARANUM - 1
		;キャラ加入時の共通設定
		CALL NEWCHARA_INIT
		
		;エクストラ構文呼び出し
		TFLAG:600 = 0
		Z = TARGET
		LOCAL:1 = TARGET
		TARGET = A
		CALL KOJO_JUN
		
		A = CHARANUM - 1
		
		;仲間になった場合FLAG:1000～に2を代入し、一度仲間になった判定に使用する
		FLAG:(999+ T) = 2
		
		;FLAG:23 & 4194304がONなら休憩所で休ませる
		SIF FLAG:23 & 4194304
			CFLAG:A:16 = 1
		;仲間にしたキャラのコマンドフィルタを自動的に共通設定にする
		SIF FLAG:61 & 1p10
			CALL INVERT_COM_FILTERING(1001, A)
		
		TARGET = LOCAL:1
	ENDIF
	E = 0
	;「あなた」はサポート対象外
	SIF FLAG:25 == 0
		TALENT:A:210 = 1
ENDIF

RETURN 1

