DRAWLINE

;--- 【二人の歩み・学園生活】 ---
LOCAL:10 = (CFLAG:ARG:1213 > 0) || (CFLAG:ARG:1200 > 0) || (CFLAG:ARG:1202 > 0) || (CFLAG:ARG:1270 > 0) || (CFLAG:ARG:1207 > 0) || (CFLAG:ARG:1271 > 0) || (CFLAG:ARG:1208 > 0) || (CFLAG:ARG:1206 > 0) || (CFLAG:ARG:1209 > 0) || (CFLAG:ARG:1210 > 0) || (CFLAG:ARG:1275 > 0)

IF LOCAL:10
	SETCOLOR 150, 220, 255
	PRINTL □ 二人の歩み・学園生活の記録
	RESETCOLOR
	IF CFLAG:ARG:1213 > 0 || CFLAG:ARG:1200 > 0	; 【ARG:[一緒に過ごした回数]>0 / ARG:[共に過ごした総時間(ターン数)]>0】
		SIF CFLAG:ARG:1213 > 0	; 【ARG:[一緒に過ごした回数]>0】
			PRINTFORML 　・一緒に過ごした回数　: {CFLAG:ARG:1213, 6} 回 （調教開始回数）
		IF CFLAG:ARG:1200 > 0	; 【ARG:[共に過ごした総時間(ターン数)]>0】
			PRINTFORM 　・共に過ごした時間　　: {CFLAG:ARG:1200, 6} ターン
			IF CFLAG:ARG:1200 >= 300	; 【ARG:[共に過ごした総時間(ターン数)]>=300】
				PRINTL  （かけがえのない青春のすべて）
			ELSEIF CFLAG:ARG:1200 >= 100	; 【ARG:[共に過ごした総時間(ターン数)]>=100】
				PRINTL  （すっかり日常の一部）
			ELSEIF CFLAG:ARG:1200 >= 30	; 【ARG:[共に過ごした総時間(ターン数)]>=30】
				PRINTL  （打ち解けてきた日々）
			ELSE
				PRINTL  （まだまだこれからの関係）
			ENDIF
			IF CFLAG:ARG:1211 > 0 || CFLAG:ARG:1212 > 0	; 【ARG:[日常(非ウフフ)ターン数]>0 / ARG:[親密(ウフフ)ターン数]>0】
				PRINTFORML 　　［内訳］ 日常(非ウフフ): {CFLAG:ARG:1211, 5} ターン ／ 親密(ウフフ): {CFLAG:ARG:1212, 5} ターン
			ENDIF
		ENDIF
	ENDIF

	IF CFLAG:ARG:1202 > 0	; 【ARG:[一緒にお昼を食べた回数]>0】
		PRINTFORM 　・一緒に食事をした回数: {CFLAG:ARG:1202, 6} 回
		IF CFLAG:ARG:1203 > 0 || CFLAG:ARG:1204 > 0	; 【ARG:[料理を作ってもらった回数]>0 / ARG:[料理を作ってあげた回数]>0】
			PRINTFORML  (奢った: {CFLAG:ARG:1203}回 ／ 奢られた: {CFLAG:ARG:1204}回)
		ELSE
			PRINTL
		ENDIF
	ENDIF

	IF CFLAG:ARG:1270 > 0	; 【ARG:[部活動参加回数]>0】
		PRINTFORML 　・一緒に寄り道した回数: {CFLAG:ARG:1270, 6} 回
	ENDIF

	IF CFLAG:ARG:1207 > 0	; 【ARG:[勉強累計]>0】
		PRINTFORML 　・一緒に勉強した回数　: {CFLAG:ARG:1207, 6} 回
	ENDIF
	IF CFLAG:ARG:1271 > 0	; 【ARG:[最高試験得点]>0】
		PRINTFORML 　・定期試験最高得点　　: {CFLAG:ARG:1271} 点 (直近: {CFLAG:ARG:1272} 点)
	ENDIF

	SIF CFLAG:ARG:1208 > 0	; 【ARG:[学園行事出場回数]>0】
		PRINTFORML 　・学園行事に出場した回数: {CFLAG:ARG:1208, 6} 回
	SIF CFLAG:ARG:1206 > 0	; 【ARG:[保健室療養回数]>0】
		PRINTFORML 　・保健室で療養・看病: {CFLAG:ARG:1206, 6} 回
	IF CFLAG:ARG:1209 > 0 || CFLAG:ARG:1210 > 0	; 【ARG:[裏カジノ同伴回数]>0 / ARG:[裏カジノ身代わり回数]>0】
		IF CFLAG:ARG:1209 > 0	; 【ARG:[裏カジノ同伴回数]>0】
			PRINTFORML 　・裏カジノ同伴: {CFLAG:ARG:1209}回 (身代わり担保: {CFLAG:ARG:1210}回)
		ELSE
			PRINTFORML 　・裏カジノ身代わり担保: {CFLAG:ARG:1210}回
		ENDIF
	ENDIF

	IF CFLAG:ARG:1275 > 0	; 【ARG:[貢いだ総額($)]>0】
		PRINTFORM 　・貢いだ総額($)　　　:  
		IF CFLAG:ARG:1275 >= 10000000	; 【ARG:[貢いだ総額($)]>=10000000】
			PRINTL  （国家予算級の惜しみない献身）
		ELSEIF CFLAG:ARG:1275 >= 1000000	; 【ARG:[貢いだ総額($)]>=1000000】
			PRINTL  （湯水のように注ぎ込んだ愛の証）
		ELSEIF CFLAG:ARG:1275 >= 100000	; 【ARG:[貢いだ総額($)]>=100000】
			PRINTL  （特別な想いが込められた投資）
		ELSE
			PRINTL
		ENDIF
	ENDIF
	PRINTL
ENDIF

;--- 【大切な記念日の記録】 ---
LOCAL:11 = (CFLAG:ARG:1242 > 0 || TALENT:ARG:151 == 0) || (CFLAG:ARG:1241 > 0 || TALENT:ARG:0 == 0) || (CFLAG:ARG:1243 > 0 || TALENT:ARG:153) || (CFLAG:ARG:1244 > 0 || TALENT:ARG:89)

IF LOCAL:11
	SETCOLOR 255, 230, 120
	PRINTL □ 二人の大切な記念日
	RESETCOLOR
	IF CFLAG:ARG:1242 > 0	; 【ARG:[初キス記念日]>0】
		PRINTFORML 　・ファーストキス記念日: %FORMAT_DATE_STR(CFLAG:ARG:1242)%
	ELSEIF TALENT:ARG:151 == 0	; 【ARG:[キス未経験]なし】
		PRINTL 　・ファーストキス記念日: 達成済み（記録開始前）
	ENDIF

	IF CFLAG:ARG:1241 > 0	; 【ARG:[処女喪失記念日]>0】
		PRINTFORML 　・初めて結ばれた日　　: %FORMAT_DATE_STR(CFLAG:ARG:1241)%
	ELSEIF TALENT:ARG:0 == 0	; 【ARG:[処女]なし】
		PRINTL 　・初めて結ばれた日　　: 達成済み（記録開始前）
	ENDIF

	IF CFLAG:ARG:1243 > 0	; 【ARG:[恋人記念日(日目)]>0】
		PRINTFORML 　・恋人になった日　　　: %FORMAT_DATE_STR(CFLAG:ARG:1243)%
	ELSEIF TALENT:ARG:153	; 【ARG:[恋人]】
		PRINTL 　・恋人になった日　　　: 達成済み（甘い恋人関係）
	ENDIF

	IF CFLAG:ARG:1244 > 0	; 【ARG:[相愛記念日(日目)]>0】
		PRINTFORML 　・永遠の絆を結んだ日　: %FORMAT_DATE_STR(CFLAG:ARG:1244)%
	ELSEIF TALENT:ARG:89	; 【ARG:[相愛]】
		PRINTL 　・永遠の絆を結んだ日　: 達成済み（深く愛し合う相愛）
	ENDIF
	PRINTL
ENDIF

;--- 【スキンシップ・身体のプロフィールの変化】 ---
LOCAL:2 = BUST_TENTHS(ARG)
LOCAL:3 = 800
SIF STRLENS(CSTR:ARG:23) >= 3
	LOCAL:3 = TOINT(SUBSTRING(CSTR:ARG:23, 1, 2)) * 10
LOCAL:4 = LOCAL:2 - LOCAL:3  ;バスト変化(0.1cm)

LOCAL:7 = HEIGHT_CM(ARG)
LOCAL:8 = TOINT(SUBSTRING(CSTR:ARG:22, 0, 3))
SIF LOCAL:8 <= 0
	LOCAL:8 = 150
LOCAL:9 = LOCAL:7 - LOCAL:8  ;身長変化(cm)

LOCAL:12 = (CFLAG:ARG:1201 > 0) || (CFLAG:ARG:1260 > 0) || (CFLAG:ARG:1262 > 0) || (CFLAG:ARG:1261 > 0) || (LOCAL:4 != 0) || (LOCAL:9 != 0)

IF LOCAL:12
	SETCOLOR 180, 230, 180
	PRINTL □ スキンシップ・身体のプロフィールの変化
	RESETCOLOR
	SIF CFLAG:ARG:1201 > 0	; 【ARG:[お茶淹れ累計]>0】
		PRINTFORML 　・お茶・会話(日常)  : {CFLAG:ARG:1201, 6} 回
	SIF CFLAG:ARG:1260 > 0	; 【ARG:[頭撫で累計]>0】
		PRINTFORML 　・頭を撫でてもらった: {CFLAG:ARG:1260, 6} 回
	SIF CFLAG:ARG:1262 > 0	; 【ARG:[見つめ合い累計]>0】
		PRINTFORML 　・抱きしめられた回数: {CFLAG:ARG:1262, 6} 回
	SIF CFLAG:ARG:1261 > 0	; 【ARG:[囁き累計]>0】
		PRINTFORML 　・甘い言葉を囁かれた: {CFLAG:ARG:1261, 6} 回

	; バスト変化（差分がある場合のみ表示）
	IF LOCAL:4 > 0
		PRINTFORML 　・バストの変化量　　　: +{LOCAL:4 / 10}.{LOCAL:4 % 10}cm （初期:{LOCAL:3 / 10}.{LOCAL:3 % 10}cm → 現在:{LOCAL:2 / 10}.{LOCAL:2 % 10}cm）
	ELSEIF LOCAL:4 < 0
		LOCAL:5 = -LOCAL:4
		PRINTFORML 　・バストの変化量　　　: -{LOCAL:5 / 10}.{LOCAL:5 % 10}cm （初期:{LOCAL:3 / 10}.{LOCAL:3 % 10}cm → 現在:{LOCAL:2 / 10}.{LOCAL:2 % 10}cm）
	ENDIF

	; 身長変化（差分がある場合のみ表示）
	IF LOCAL:9 > 0
		PRINTFORML 　・身長の変化量　　　　: +{LOCAL:9}cm （初期:{LOCAL:8}cm → 現在:{LOCAL:7}cm）
	ELSEIF LOCAL:9 < 0
		LOCAL:5 = -LOCAL:9
		PRINTFORML 　・身長の変化量　　　　: -{LOCAL:5}cm （初期:{LOCAL:8}cm → 現在:{LOCAL:7}cm）
	ENDIF
	PRINTL
ENDIF

;--- 【衣装・お気に入りの装い】 ---
LOCAL:16 = (CFLAG:ARG:1215 > 0) || (CFLAG:ARG:1217 > 0)
IF LOCAL:16
	SETCOLOR 255, 180, 220
	PRINTL □ 衣装・お気に入りの装い
	RESETCOLOR
	CALL CLOTH_NAME
	IF CFLAG:ARG:1215 > 0	; 【ARG:[ウフフ時指定衣装]>0】
		PRINTFORML 　・ウフフ時指定衣装: %TSTR:(CFLAG:ARG:1215)% （優先着用）
	ENDIF
	IF CFLAG:ARG:1217 > 0 && CFLAG:ARG:1216 > 0	; 【ARG:[最多衣装着用ターン数]>0 / ARG:[最長着用衣装]>0】
		PRINTFORML 　・最も着て過ごした衣装: %TSTR:(CFLAG:ARG:1216)% （{CFLAG:ARG:1217} ターン）
	ENDIF
	PRINTL
ENDIF

;--- 【愛の行為の記録】 ---
LOCAL:1 = CFLAG:ARG:1221
LOCAL:13 = (CFLAG:ARG:1220 > 0) || (CFLAG:ARG:1230 > 0) || (CFLAG:ARG:1231 > 0) || (CFLAG:ARG:1212 > 0) || (CFLAG:ARG:1238 > 0)

IF LOCAL:13
	SETCOLOR 255, 180, 200
	PRINTFORML □ 愛の行為の記録（あなた → %CALLNAME:ARG%）
	RESETCOLOR
	IF CFLAG:ARG:1220 > 0	; 【ARG:[主人公からの総射精回数]>0】
		PRINTFORM 　・あなたの総射精回数: {CFLAG:ARG:1220, 6} 回
		PRINTFORM 　・総射精量: {LOCAL:1, 6} mL 
		IF LOCAL:1 >= 10000
			PRINTFORML （約 {LOCAL:1 / 1000} リットル！溢れる愛の証）
		ELSEIF LOCAL:1 >= 1000
			PRINTFORML （約 {LOCAL:1 / 1000}.{LOCAL:1 % 1000 / 100} リットル）
		ELSE
			PRINTL
		ENDIF

		; 射精箇所内訳（0でないもののみ表示）
		PRINTFORML 　［射精の内訳］
		SIF CFLAG:ARG:1222 > 0	; 【ARG:[膣内射精回数]>0】
			PRINTFORML 　　・膣内への注ぎ込み　: {CFLAG:ARG:1222, 5} 回 ({CFLAG:ARG:1223, 6} mL)
		SIF CFLAG:ARG:1224 > 0	; 【ARG:[肛門射精回数]>0】
			PRINTFORML 　　・肛門への注ぎ込み　: {CFLAG:ARG:1224, 5} 回 ({CFLAG:ARG:1225, 6} mL)
		SIF CFLAG:ARG:1226 > 0	; 【ARG:[口内射精回数]>0】
			PRINTFORML 　　・お口への注ぎ込み　: {CFLAG:ARG:1226, 5} 回 ({CFLAG:ARG:1227, 6} mL)
		SIF CFLAG:ARG:1228 > 0	; 【ARG:[外出し射精回数]>0】
			PRINTFORML 　　・胸・手・外出し等　: {CFLAG:ARG:1228, 5} 回 ({CFLAG:ARG:1229, 6} mL)
		SIF CFLAG:ARG:1240 > 0	; 【ARG:[1回の最高射精量(mL)]>0】
			PRINTFORML 　・一回の最高射精量記録: {CFLAG:ARG:1240, 6} mL
	ENDIF

	SIF CFLAG:ARG:1238 > 0	; 【ARG:[同時絶頂累計]>0】
		PRINTFORML 　・ふたりで同時に達した: {CFLAG:ARG:1238, 6} 回 (同時絶頂)
	SIF CFLAG:ARG:1230 > 0	; 【ARG:[主人公を射精させた回数]>0】
		PRINTFORML 　・主人公を射精させた回数: {CFLAG:ARG:1230, 6} 回
	SIF CFLAG:ARG:1231 > 0	; 【ARG:[キス累計]>0】
		PRINTFORML 　・唇を重ねた回数(キス)　: {CFLAG:ARG:1231, 6} 回
	SIF CFLAG:ARG:1212 > 0	; 【ARG:[親密(ウフフ)ターン数]>0】
		PRINTFORML 　・愛し合って過ごした時間: {CFLAG:ARG:1212, 6} ターン （ウフフ時間）
	PRINTL
ENDIF

;--- 【体位別の結合記録（愛のフォーム）】 ---
LOCAL:6 = CFLAG:ARG:1250 + CFLAG:ARG:1251 + CFLAG:ARG:1252 + CFLAG:ARG:1253 + CFLAG:ARG:1254
IF LOCAL:6 > 0
	SETCOLOR 255, 200, 255
	PRINTL □ 体位別の結合記録（愛のフォーム）
	RESETCOLOR
	SIF CFLAG:ARG:1250 > 0	; 【ARG:[正常位累計]>0】
		PRINTFORM 　・正常位: {CFLAG:ARG:1250, 4} 回
	SIF CFLAG:ARG:1251 > 0	; 【ARG:[後背位累計]>0】
		PRINTFORM 　・後背位: {CFLAG:ARG:1251, 4} 回
	SIF CFLAG:ARG:1252 > 0	; 【ARG:[騎乗位累計]>0】
		PRINTFORM 　・騎乗位: {CFLAG:ARG:1252, 4} 回
	SIF CFLAG:ARG:1253 > 0	; 【ARG:[対面座位累計]>0】
		PRINTFORM 　・対面座位: {CFLAG:ARG:1253, 4} 回
	SIF CFLAG:ARG:1254 > 0	; 【ARG:[背面座位累計]>0】
		PRINTFORM 　・背面座位: {CFLAG:ARG:1254, 4} 回
	PRINTL

	; 最多体位コメント
	LOCAL:14 = MAX(CFLAG:ARG:1250, CFLAG:ARG:1251, CFLAG:ARG:1252, CFLAG:ARG:1253, CFLAG:ARG:1254)
	IF LOCAL:14 > 0
		PRINTFORM 　［好みの体位］ 
		IF LOCAL:14 == CFLAG:ARG:1252	; 【ARG:[騎乗位累計]】
			PRINTL 騎乗位（主導権を握って自ら腰を振るのを好む）
		ELSEIF LOCAL:14 == CFLAG:ARG:1253	; 【ARG:[対面座位累計]】
			PRINTL 対面座位（抱き合ってお互いの顔を見つめ合うのを好む）
		ELSEIF LOCAL:14 == CFLAG:ARG:1251	; 【ARG:[後背位累計]】
			PRINTL 後背位（後ろから深く突かれるのを好む）
		ELSEIF LOCAL:14 == CFLAG:ARG:1250	; 【ARG:[正常位累計]】
			PRINTL 正常位（王道かつ見つめ合いながらの結合を好む）
		ELSE
			PRINTL 背面座位（背中を預けて密着する結合を好む）
		ENDIF
	ENDIF
	PRINTL
ENDIF

;--- 【快楽・身体反応の記録】 ---
LOCAL:15 = (CFLAG:ARG:1232 > 0) || (CFLAG:ARG:1233 > 0) || (CFLAG:ARG:1280 > 0) || (CFLAG:ARG:1282 > 0) || (CFLAG:ARG:1236 > 0) || (CFLAG:ARG:1239 > 0)

IF LOCAL:15
	SETCOLOR 255, 220, 150
	PRINTL □ 快楽・身体反応の記録
	RESETCOLOR
	SIF CFLAG:ARG:1232 > 0	; 【ARG:[絶頂累計]>0】
		PRINTFORML 　・絶頂に達した総回数　: {CFLAG:ARG:1232, 6} 回
	SIF CFLAG:ARG:1239 > 0	; 【ARG:[最高絶頂記録]>0】
		PRINTFORML 　・一回の最高絶頂数記録: {CFLAG:ARG:1239, 6} 回
	SIF CFLAG:ARG:1233 > 0	; 【ARG:[潮吹き回数]>0】
		PRINTFORML 　・潮を吹いた回数　　　: {CFLAG:ARG:1233, 6} 回 (噴出量約: {CFLAG:ARG:1234} mL)
	SIF CFLAG:ARG:1280 > 0	; 【ARG:[本人の総射精回数]>0】
		PRINTFORML 　・本人の射精回数　　　: {CFLAG:ARG:1280, 6} 回 (総射精量: {CFLAG:ARG:1281} mL)
	SIF CFLAG:ARG:1282 > 0	; 【ARG:[総噴乳回数]>0】
		PRINTFORML 　・母乳を噴出した回数　: {CFLAG:ARG:1282, 6} 回 (総噴乳量: {CFLAG:ARG:1283} mL)
	SIF CFLAG:ARG:1236 > 0	; 【ARG:[反発恐怖回数]>0】
		PRINTFORML 　・恐怖・反発を覚えた回数: {CFLAG:ARG:1236, 6} 回
ENDIF

; まだ何も記録がない場合のフォールバック表示
IF !LOCAL:10 && !LOCAL:11 && !LOCAL:12 && !LOCAL:13 && !LOCAL:6 && !LOCAL:15 && !LOCAL:16
	PRINTL
	PRINTFORML 　（%CALLNAME:ARG%との記録はまだ刻まれていません）
	PRINTFORML 　（学園生活や調教を共に過ごすことで、様々な個人データがここに記録されていきます）
	PRINTL
ENDIF

DRAWLINE
RETURN 0
