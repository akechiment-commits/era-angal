;-------------------------------------------------
;カスタムバー用色セット関数@BARCOLORSET
;PRINT_COLORBARのARG:3に利用し、ARG;4にRESULTを使う
;-------------------------------------------------
@BARCOLORSET, ARGS
#FUNCTION
;LOCALに色を代入
SELECTCASE ARGS
	CASE "濃赤"
		RESULT:1 = 0x701000
		RETURNF 0xF06050
	CASE "赤"
		RESULT:1 = 0x502020
		RETURNF 0xC07070
	CASE "青"
		RESULT:1 = 0x202050
		RETURNF 0x7070C0
	CASE "薄青"
		RESULT:1 = 0x002060
		RETURNF 0x50B0FF
	CASE "紺"
		RESULT:1 = 0x100060
		RETURNF 0x6666FF
	CASE "緑"
		RESULT:1 = 0x205020
		RETURNF 0x66DD66
	CASE "紫"
		RESULT:1 = 0x502050
		RETURNF 0xC070C0
	CASE "黄"
		RESULT:1 = 0x505020
		RETURNF 0xC0B050
	CASE "桃"
		RESULT:1 = 0x300020
		RETURNF 0xFFCCFF
	CASE "青緑"
		RESULT:1 = 0x205050
		RETURNF 0x70C0C0
	CASE "灰"
		RESULT:1 = 0x333333
		RETURNF 0x666666
	;白
	CASEELSE
		RESULT:1 = 0x202020
		RETURNF 0xC0C0C0
ENDSELECT

;==================================================
; キャラクター詳細統計・同期処理
; ARG: キャラ登録番号
;==================================================
@SYNC_CHARA_MISC_STATS, ARG
#LOCALSIZE 5
#DIM IS_SACRIFICED
SIF ARG <= 0 || ARG >= CHARANUM
	RETURN 0

LOCAL = NO:ARG

; カジノ身代わり回数同期（CFLAG:786と同期）
IF CFLAG:ARG:786 > CFLAG:ARG:1210
	CFLAG:ARG:1210 = CFLAG:ARG:786
ENDIF
IS_SACRIFICED = (CFLAG:ARG:786 > 0 || CFLAG:ARG:1210 > 0)

;--------------------------------------------------
; カジノ身代わり犠牲者の個人ログ誤爆クリーンアップ
; （他人に犯された性的経験が主人公との愛の記録に誤変換されていた場合の修復）
;--------------------------------------------------
IF IS_SACRIFICED
	; 性的経験の合計値
	LOCAL:1 = EXP:ARG:0 + EXP:ARG:1 + EXP:ARG:10 + EXP:ARG:21 + EXP:ARG:22

	; ウフフターン数が性的経験合計値（旧逆算値）と一致している場合、主人公調教実績ではないためリセット
	IF CFLAG:ARG:1212 == LOCAL:1 && LOCAL:1 > 0	; 【ARG:[親密(ウフフ)ターン数]==LOCAL:1】
		CFLAG:ARG:1212 = 0
		CFLAG:ARG:1235 = 0
		; 共に過ごした時間も日常ターンのみに修正
		CFLAG:ARG:1200 = CFLAG:ARG:1211
	ENDIF

	; 体位別結合記録が旧逆算比率（40/30/20/10）と一致している場合、リセット
	IF EXP:ARG:0 > 0 && CFLAG:ARG:1250 == (EXP:ARG:0 * 40 / 100) && CFLAG:ARG:1251 == (EXP:ARG:0 * 30 / 100) && CFLAG:ARG:1252 == (EXP:ARG:0 * 20 / 100) && CFLAG:ARG:1253 == (EXP:ARG:0 * 10 / 100)	; 【ARG:[Ｖ経験]>0 / ARG:[Ｖ経験]あり / ARG:[正常位累計] / ARG:[後背位累計] / ARG:[騎乗位累計] / ARG:[対面座位累計]】
		CFLAG:ARG:1250 = 0
		CFLAG:ARG:1251 = 0
		CFLAG:ARG:1252 = 0
		CFLAG:ARG:1253 = 0
		CFLAG:ARG:1254 = 0
	ENDIF

	; 主人公とウフフ実績がない場合、絶頂・潮吹き・射精の旧同期値をリセット
	IF CFLAG:ARG:1212 == 0	; 【ARG:[親密(ウフフ)ターン数]==0】
		IF CFLAG:ARG:1232 == EXP:ARG:2	; 【ARG:[絶頂経験]あり / ARG:[絶頂累計]==EXP:ARG:2】
			CFLAG:ARG:1232 = 0
			CFLAG:ARG:1239 = 0
		ENDIF
		IF CFLAG:ARG:1233 == EXP:ARG:31	; 【ARG:[放尿経験]あり / ARG:[潮吹き回数]==EXP:ARG:31】
			CFLAG:ARG:1233 = 0
			CFLAG:ARG:1234 = 0
		ENDIF
		IF CFLAG:ARG:1280 == EXP:ARG:3	; 【ARG:[射精経験]あり / ARG:[本人の総射精回数]==EXP:ARG:3】
			CFLAG:ARG:1280 = 0
			CFLAG:ARG:1281 = 0
		ENDIF
		IF CFLAG:ARG:1282 == EXP:ARG:54	; 【ARG:[噴乳経験]あり / ARG:[総噴乳回数]==EXP:ARG:54】
			CFLAG:ARG:1282 = 0
			CFLAG:ARG:1283 = 0
		ENDIF
	ENDIF
ENDIF

; 射精量の同期（トロフィー等のFLAG:5800+NOに記録がある場合、CFLAG:1221が少なければ同期）
IF FLAG:(5800 + LOCAL) > CFLAG:ARG:1221	; 【ARG:[主人公からの総射精量(mL)]】
	CFLAG:ARG:1221 = FLAG:(5800 + LOCAL)
ENDIF

; 射精量があるのに射精回数が未初期化(0)の場合、平均15mL換算で推定補正
IF CFLAG:ARG:1221 > 0 && CFLAG:ARG:1220 == 0	; 【ARG:[主人公からの総射精量(mL)]>0 / ARG:[主人公からの総射精回数]==0】
	CFLAG:ARG:1220 = MAX(1, CFLAG:ARG:1221 / 15)
	IF EXP:ARG:20 > 0	; 【ARG:[精液経験]>0】
		CFLAG:ARG:1222 = MIN(CFLAG:ARG:1220, EXP:ARG:20)
		CFLAG:ARG:1223 = CFLAG:ARG:1222 * (CFLAG:ARG:1221 / CFLAG:ARG:1220)
		CFLAG:ARG:1228 = CFLAG:ARG:1220 - CFLAG:ARG:1222
		CFLAG:ARG:1229 = CFLAG:ARG:1221 - CFLAG:ARG:1223
	ELSE
		CFLAG:ARG:1228 = CFLAG:ARG:1220
		CFLAG:ARG:1229 = CFLAG:ARG:1221
	ENDIF
ENDIF

; 体位別の未初期化補正（V経験があるのに体位が全0なら推定分配、身代わり経験者は除外）
IF !IS_SACRIFICED && EXP:ARG:0 > 0 && (CFLAG:ARG:1250 + CFLAG:ARG:1251 + CFLAG:ARG:1252 + CFLAG:ARG:1253 + CFLAG:ARG:1254 == 0)	; 【ARG:[Ｖ経験]>0 / ARG:[正常位累計] / ARG:[後背位累計] / ARG:[騎乗位累計] / ARG:[対面座位累計] / ARG:[背面座位累計]==0】
	CFLAG:ARG:1250 = EXP:ARG:0 * 40 / 100
	CFLAG:ARG:1251 = EXP:ARG:0 * 30 / 100
	CFLAG:ARG:1252 = EXP:ARG:0 * 20 / 100
	CFLAG:ARG:1253 = EXP:ARG:0 * 10 / 100
ENDIF

; 同時絶頂の初期推定（射精と絶頂が共にあれば一部を反映）
IF CFLAG:ARG:1220 > 0 && EXP:ARG:2 > 0 && CFLAG:ARG:1238 == 0	; 【ARG:[絶頂経験]>0 / ARG:[主人公からの総射精回数]>0 / ARG:[同時絶頂累計]==0】
	CFLAG:ARG:1238 = MIN(CFLAG:ARG:1220, EXP:ARG:2) / 3
ENDIF

; 1回の最高射精量の初期推定
IF CFLAG:ARG:1221 > 0 && CFLAG:ARG:1240 == 0	; 【ARG:[主人公からの総射精量(mL)]>0 / ARG:[1回の最高射精量(mL)]==0】
	CFLAG:ARG:1240 = MIN(CFLAG:ARG:1221, MAX(20, CFLAG:ARG:1221 / MAX(1, CFLAG:ARG:1220) + 10))
ENDIF

; 本人の射精同期（射精経験がある場合、身代わり経験者は除外）
IF !IS_SACRIFICED && EXP:ARG:3 > 0 && CFLAG:ARG:1280 == 0	; 【ARG:[射精経験]>0 / ARG:[本人の総射精回数]==0】
	CFLAG:ARG:1280 = EXP:ARG:3
	CFLAG:ARG:1281 = EXP:ARG:3 * 15
ENDIF

; 噴乳同期（噴乳経験がある場合、身代わり経験者は除外）
IF !IS_SACRIFICED && EXP:ARG:54 > 0 && CFLAG:ARG:1282 == 0	; 【ARG:[噴乳経験]>0 / ARG:[総噴乳回数]==0】
	CFLAG:ARG:1282 = EXP:ARG:54
	CFLAG:ARG:1283 = EXP:ARG:54 * 20
ENDIF

; 貢いだ金額の初期補正（エンゲージリング所持なら最低1,000,000）
IF CFLAG:ARG:29 > 0 && CFLAG:ARG:1275 < 1000000	; 【ARG:[エンゲージリング受取]>0 / ARG:[貢いだ総額($)]<1000000】
	CFLAG:ARG:1275 = MAX(CFLAG:ARG:1275, 1000000)
ENDIF

; 1回の最高絶頂数記録の同期（未記録なら絶頂経験ベースで初期推定、身代わり経験者は除外）
IF !IS_SACRIFICED && EXP:ARG:2 > 0 && CFLAG:ARG:1239 == 0	; 【ARG:[絶頂経験]>0 / ARG:[最高絶頂記録]==0】
	CFLAG:ARG:1239 = MIN(EXP:ARG:2, MAX(1, EXP:ARG:2 / MAX(1, CFLAG:ARG:1235) + 3))
ENDIF

; 累計好感度（現在好感度を下回っていれば同期）
IF CFLAG:ARG:2 > CFLAG:ARG:1214	; 【ARG:[好感度]>CFLAG:ARG:1214】
	CFLAG:ARG:1214 = CFLAG:ARG:2
ENDIF

; 絶頂回数（未記録なら絶頂経験をベースに同期、身代わり経験者は除外）
IF !IS_SACRIFICED && EXP:ARG:2 > CFLAG:ARG:1232	; 【ARG:[絶頂経験]>CFLAG:ARG:1232 / ARG:[絶頂累計]】
	CFLAG:ARG:1232 = EXP:ARG:2
ENDIF

; 潮吹き回数（未記録なら放尿経験・異常経験等から同期、身代わり経験者は除外）
IF !IS_SACRIFICED && EXP:ARG:31 > CFLAG:ARG:1233 && EXP:ARG:31 > 0	; 【ARG:[放尿経験]>CFLAG:ARG:1233 / ARG:[放尿経験]>0 / ARG:[潮吹き回数]】
	CFLAG:ARG:1233 = EXP:ARG:31
	CFLAG:ARG:1234 = CFLAG:ARG:1233 * 30
ENDIF

; 勉強回数の補正（総ターン数を超えている場合は上限を総ターン数に補正）
IF CFLAG:ARG:1207 > CFLAG:ARG:1200	; 【ARG:[勉強累計]>CFLAG:ARG:1200】
	CFLAG:ARG:1207 = CFLAG:ARG:1200
ENDIF

; ウフフターン数・調教回数の同期（性的経験合計をベースにウフフを補正、身代わり経験者は除外）
IF !IS_SACRIFICED
	LOCAL:1 = EXP:ARG:0 + EXP:ARG:1 + EXP:ARG:10 + EXP:ARG:21 + EXP:ARG:22
	IF CFLAG:ARG:1212 == 0 && LOCAL:1 > 0	; 【ARG:[親密(ウフフ)ターン数]==0】
		CFLAG:ARG:1212 = LOCAL:1
	ENDIF
	; 非ウフフ（調教外）行動を除外して調教回数をウフフターン数に合わせる
	CFLAG:ARG:1235 = CFLAG:ARG:1212
ENDIF

; 一緒に過ごした総ターン数と内訳の同期
IF CFLAG:ARG:1211 == 0 && CFLAG:ARG:1200 > CFLAG:ARG:1212	; 【ARG:[日常(非ウフフ)ターン数]==0 / ARG:[共に過ごした総時間(ターン数)]>CFLAG:ARG:1212】
	CFLAG:ARG:1211 = CFLAG:ARG:1200 - CFLAG:ARG:1212
ELSEIF CFLAG:ARG:1211 + CFLAG:ARG:1212 > CFLAG:ARG:1200	; 【ARG:[日常(非ウフフ)ターン数] / ARG:[親密(ウフフ)ターン数]>CFLAG:ARG:1200】
	CFLAG:ARG:1200 = CFLAG:ARG:1211 + CFLAG:ARG:1212
ENDIF

; 一緒に過ごした時間（未記録なら好感度から初期推定）
IF CFLAG:ARG:1200 == 0 && CFLAG:ARG:2 > 0	; 【ARG:[共に過ごした総時間(ターン数)]==0 / ARG:[好感度]>0】
	CFLAG:ARG:1200 = MAX(1, CFLAG:ARG:2 / 50)
	CFLAG:ARG:1211 = CFLAG:ARG:1200
ENDIF

; 一緒に過ごした回数（調教開始回数）の初期推定
IF CFLAG:ARG:1213 == 0 && CFLAG:ARG:1200 > 0	; 【ARG:[一緒に過ごした回数]==0 / ARG:[共に過ごした総時間(ターン数)]>0】
	CFLAG:ARG:1213 = MAX(1, CFLAG:ARG:1200 / 8)
ENDIF

; 記念日の旧日目形式（1～9999）から日付形式（YYYYMMDD）への移行変換
IF CFLAG:ARG:1242 > 0 && CFLAG:ARG:1242 < 10000	; 【ARG:[初キス記念日]>0 / ARG:[初キス記念日]<10000】
	CFLAG:ARG:1242 = CONVERT_DAY_INT_TO_DATE_INT(CFLAG:ARG:1242)
ENDIF
IF CFLAG:ARG:1241 > 0 && CFLAG:ARG:1241 < 10000	; 【ARG:[処女喪失記念日]>0 / ARG:[処女喪失記念日]<10000】
	CFLAG:ARG:1241 = CONVERT_DAY_INT_TO_DATE_INT(CFLAG:ARG:1241)
ENDIF
IF CFLAG:ARG:1243 > 0 && CFLAG:ARG:1243 < 10000	; 【ARG:[恋人記念日(日目)]>0 / ARG:[恋人記念日(日目)]<10000】
	CFLAG:ARG:1243 = CONVERT_DAY_INT_TO_DATE_INT(CFLAG:ARG:1243)
ENDIF
IF CFLAG:ARG:1244 > 0 && CFLAG:ARG:1244 < 10000	; 【ARG:[相愛記念日(日目)]>0 / ARG:[相愛記念日(日目)]<10000】
	CFLAG:ARG:1244 = CONVERT_DAY_INT_TO_DATE_INT(CFLAG:ARG:1244)
ENDIF
IF TALENT:ARG:153 && CFLAG:ARG:1243 == 0	; 【ARG:[恋人] / ARG:[恋人記念日(日目)]==0】
	CFLAG:ARG:1243 = GET_CURRENT_DATE_INT()
ENDIF
IF TALENT:ARG:89 && CFLAG:ARG:1244 == 0	; 【ARG:[相愛] / ARG:[相愛記念日(日目)]==0】
	CFLAG:ARG:1244 = GET_CURRENT_DATE_INT()
ENDIF

; カジノ等で誰のものとも知れぬ子を妊娠している場合の父親フラグ修正
IF CFLAG:ARG:104 == 99 && CFLAG:ARG:111 >= 0	; 【ARG:[種提供者]==99 / ARG:[父親]>=0】
	CFLAG:ARG:111 = -1
ENDIF

RETURN 0

