	SIF CFLAG:1100 == 0	; 【[ペニスサイズ(0.1cm単位)]==0】
		CFLAG:1100 = LIMIT(LOCAL * 7 / 16 - 213, 40, 400)
	PRINTFORML 　バストサイズ：{LOCAL / 10}.{LOCAL % 10}cm　　ペニスサイズ：{CFLAG:1100 / 10}.{CFLAG:1100 % 10}cm
ELSE
