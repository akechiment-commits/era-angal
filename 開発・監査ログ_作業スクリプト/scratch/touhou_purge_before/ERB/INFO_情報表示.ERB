;=== バスト/ペニスサイズ表示ヘルパー ===
;ステータス用バスト(0.1cm)を返す。未設定ならプロフィール(CSTR:23 "B##/W##/H##"のB値)から初期化
;※プロフィール画面は不変。これは別管理の可変値で、今後ゲーム内イベントで変動させる想定
@BUST_TENTHS(C)
#FUNCTION
SIF CFLAG:C:1101 != 0	; 【C:[バストサイズ(0.1cm単位)]!=0】
	RETURNF CFLAG:C:1101
LOCAL = 800
SIF STRLENS(CSTR:C:23) >= 3
	LOCAL = TOINT(SUBSTRING(CSTR:C:23, 1, 2)) * 10
SIF LOCAL <= 0
	LOCAL = 800
CFLAG:C:1101 = LOCAL
RETURNF CFLAG:C:1101

;バストサイズ(0.1cm)を D 変動。未設定なら初期化。下限60.0cm・上限190.0cm
@BUST_ADJUST(C, D)
;関数内呼び出しでグローバルRESULTが壊れるため退避→復元（呼び出し側のキャラ選択を保護）
LOCAL:1 = RESULT
LOCAL = BUST_TENTHS(C)
CFLAG:C:1101 = LIMIT(CFLAG:C:1101 + D, 600, 1900)
CALL SYNC_BUST_TALENT, C
RESULT = LOCAL:1
RETURN

;バストcm(0.1cm)から胸素質(貧乳109/巨乳110/爆乳141)を導出して付け直す（cmが唯一の正）
;しきい値: <75.0cm=貧乳 / 75.0-82.9=普通 / 83.0-89.9=巨乳 / 90.0cm-=爆乳
;バスト指数(bust*100/height)で胸素質を付け直す
;しきい値: <490=貧乳 / 490-509=普通 / 510-554=巨乳 / >=555=爆乳
;身長はCSTR:22の先頭3文字（例"148cm/39kg"→148）
@SYNC_BUST_TALENT(C)
TALENT:C:109 = 0
TALENT:C:110 = 0
TALENT:C:141 = 0
TALENT:C:143 = 0
LOCAL = TOINT(SUBSTRING(CSTR:C:22, 0, 3))
IF LOCAL > 0
	;バスト指数 = バスト(0.1cm) * 100 / 身長(cm)
	LOCAL:1 = CFLAG:C:1101 * 100 / LOCAL
	SIF LOCAL:1 < 490
		TALENT:C:109 = 1
	SIF LOCAL:1 >= 534 && LOCAL:1 < 575
		TALENT:C:110 = 1
	SIF LOCAL:1 >= 575 && LOCAL:1 < 700
		TALENT:C:141 = 1
	SIF LOCAL:1 >= 700
		TALENT:C:143 = 1
ELSE
	;身長不明時は絶対値判定（フォールバック）
	SIF CFLAG:C:1101 < 750	; 【C:[バストサイズ(0.1cm単位)]<750】
		TALENT:C:109 = 1
	SIF CFLAG:C:1101 >= 830 && CFLAG:C:1101 < 900	; 【C:[バストサイズ(0.1cm単位)]>=830 / C:[バストサイズ(0.1cm単位)]<900】
		TALENT:C:110 = 1
	SIF CFLAG:C:1101 >= 900 && CFLAG:C:1101 < 1120	; 【C:[バストサイズ(0.1cm単位)]>=900 / C:[バストサイズ(0.1cm単位)]<1120】
		TALENT:C:141 = 1
	SIF CFLAG:C:1101 >= 1120	; 【C:[バストサイズ(0.1cm単位)]>=1120】
		TALENT:C:143 = 1
ENDIF
RETURN

;対象(TARGET)のバスト／ペニスサイズを1行表示。ふたなりは両方、それ以外はバストのみ
;=== 身長ヘルパー（CFLAG:1103=cm。未設定ならプロフィールCSTR:22の先頭3文字で初期化）===
@HEIGHT_CM(C)
#FUNCTION
SIF CFLAG:C:1103 != 0
	RETURNF CFLAG:C:1103
LOCAL = TOINT(SUBSTRING(CSTR:C:22, 0, 3))
SIF LOCAL <= 0
	LOCAL = 150
CFLAG:C:1103 = LOCAL
RETURNF CFLAG:C:1103

;身長(cm)を D 変動。下限110・上限190。変動後に体型素質を同期
@HEIGHT_ADJUST(C, D)
LOCAL:1 = RESULT
LOCAL = HEIGHT_CM(C)
CFLAG:C:1103 = LIMIT(CFLAG:C:1103 + D, 55, 250)
CALL SYNC_BODY_TALENT, C
RESULT = LOCAL:1
RETURN

;身長から体型素質(小柄体型100/子供体型149)を導出（身長が唯一の正）
;しきい値: 140cm以上=通常 / 131-139cm=小柄体型 / 130cm以下=子供体型(小柄も併発)
@SYNC_BODY_TALENT(C)
LOCAL = HEIGHT_CM(C)
IF LOCAL <= 130
	;子供体型のみ（小柄体型とは排他）
	TALENT:C:100 = 0
	TALENT:C:149 = 1
ELSEIF LOCAL < 140
	;小柄体型のみ
	TALENT:C:100 = 1
	TALENT:C:149 = 0
ELSE
	TALENT:C:149 = 0
	;一時的な小柄装備(TEQUIP:40の8/16ビット)が無ければ小柄も解除
	SIF (TEQUIP:C:40 & 8) == 0 && (TEQUIP:C:40 & 16) == 0	; 【[素質変化記録]使用中】
		TALENT:C:100 = 0
ENDIF
RETURN

;ペニスcm(CFLAG:1100=0.1cm)から短小144/巨根145を導出（地の文段階準拠: 8cm未満=短小 / 16cm以上=巨根）
@SYNC_PENIS_TALENT(C)
TALENT:C:144 = 0
TALENT:C:145 = 0
TALENT:C:146 = 0
SIF CFLAG:C:1100 <= 0	; 【C:[ペニスサイズ(0.1cm単位)]<=0】
	RETURN
IF CFLAG:C:1100 < 80	; 【C:[ペニスサイズ(0.1cm単位)]<80】
	TALENT:C:144 = 1
ELSEIF CFLAG:C:1100 >= 250	; 【C:[ペニスサイズ(0.1cm単位)]>=250】
	TALENT:C:146 = 1
ELSEIF CFLAG:C:1100 >= 160	; 【C:[ペニスサイズ(0.1cm単位)]>=160】
	TALENT:C:145 = 1
ENDIF
RETURN

@SHOW_BODY_SIZE
