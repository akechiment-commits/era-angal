;射精経験0かつオトコ、不思議な根、具現を持ってない場合は射精すると異常経験+5
IF EXP:3 == 0 && TALENT:122 == 0 && TALENT:120 == 0 && TALENT:127 == 0	; 【[オトコ]なし / [不思議な根]なし / [具現]なし / [射精経験]==0】
	EXP:50 += 5
	PRINTL 異常経験＋5
ENDIF

;パートナーの各コマンドでの中田氏チェック
CALL IN_VAGINA_CHECK_T

;Ｐに精液汚れ
STAIN:2 |= 4

BASE:2 -= EJAC
SIF BASE:2 >= EJAC
	BASE:2 = EJAC-1

;調教対象が射精フラグ
TFLAG:10 = 1
TFLAG:713 = E
NOWEX:5 += 1
	;本人の射精統計加算
	CFLAG:TARGET:1280 += TFLAG:715
	CFLAG:TARGET:1281 += TFLAG:717
EX:5 += 1
	;気絶中にふたなり・オトコが射精した場合の描写
	SIF (TFLAG:899 || BASE:TARGET:0 <= 0) && (TALENT:TARGET:121 || TALENT:TARGET:122)	; 【TARGET:[ふたなり] / TARGET:[オトコ] / [気絶継続中] / TARGET:[体力]<=0】
		CALL FAINT_SHOOT_MESSAGE

;-------------------------------------------------
;調教対象の噴乳チェック
;-------------------------------------------------
@TARGET_MILK_CHECK
SIF TALENT:130 == 0	; 【[母乳体質]なし】
	RETURN 0

;オーバーフローチェック。
;本来の処理はA = UP:0 / 20 + UP:1 / 20 + UP:2 / 20 + UP:14 * 4 + UP:18 / 20
;快B(胸・乳首)が主役、V/C/Aはほぼ寄与しない
IF UP:0 / 10 >= 1000000	; 【[快Ｃ上昇]】
	A = 10000000
ELSEIF UP:0 / 10 + UP:1 / 10 >= 1000000	; 【[快Ｃ上昇] / [快Ｖ上昇]】
	A = 10000000
ELSEIF UP:0 / 10 + UP:1 / 10 + UP:2 / 10 >= 1000000	; 【[快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇]】
	A = 10000000
ELSEIF UP:0 / 10 + UP:1 / 10 + UP:2 / 10 + UP:14 / 10>= 1000000	; 【[快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇] / [快Ｂ上昇]】
	A = 10000000
ELSE
	A = UP:0 / 20 + UP:1 / 20 + UP:2 / 20 + UP:14 * 4 + UP:18 / 20
ENDIF

;自制心
IF TALENT:20 == 1	; 【[自制心]】
	A /= 2
ELSEIF TALENT:20 == 2	; 【[自制心:強]】
	TIMES A , 2.00
ENDIF

;快感に素直
SIF TALENT:70	; 【[快感に素直]】
	TIMES A , 1.20

;淫乱化
SIF TALENT:76	; 【[淫乱]】
	TIMES A , 1.10

;快感の否定
IF TALENT:71 == 1	; 【[快感の否定]】
	TIMES A , 0.80
ELSEIF TALENT:71 == 2	; 【[快感の否定:強]】
	TIMES A , 1.25
ENDIF
;B敏感
SIF TALENT:108	; 【[Ｂ敏感]】
	TIMES A , 1.50

;胸サイズによる母乳量増加
SIF TALENT:141	; 【[爆乳]】
	TIMES A , 2.00
SIF TALENT:110	; 【[巨乳]】
	TIMES A , 1.50

;媚薬
SIF TEQUIP:21	; 【[媚薬効果発揮中]使用中】
	A *= 2

;利尿剤
SIF TEQUIP:22	; 【[利尿剤効果発揮中]使用中】
	A /= 2

;調教者が幼児退行
SIF TALENT:PLAYER:131	; 【PLAYER:[幼児]】
	A *= 2

;調教者が幼稚
SIF TALENT:PLAYER:132	; 【PLAYER:[幼稚]】
	A *= 2

;貧乳
SIF TALENT:109	; 【[貧乳]】
	TIMES A , 0.50

;淫蟲
SIF TEQUIP:92 == 1	; 【[蟲風呂プレイ]==1】
	A *= 2

IF TFLAG:44 && A > 0	; 【[ウフフ中]】
	A = 50 + A / 20
ELSE
	A /= 20
ENDIF
BASE:3 += A

S = BASE:3
EJAC = MAXBASE:3

IF  S > EJAC * 2
	E = 2
ELSEIF S > EJAC
	E = 1
ELSE
	E = 0
ENDIF
TFLAG:716 = S / EJAC
SIF TFLAG:716 < 1
	TFLAG:716 = 1
A = 5 + 195 * (TFLAG:716 - 1) / (TFLAG:716 + 9)
B = A / 4
C = B * 2 + 1
TFLAG:718 = A - B + RAND:C
SIF TFLAG:718 < 1
	TFLAG:718 = 1

;大量噴乳
IF E == 2
	LOSEBASE:0 += 20
	LOSEBASE:1 += 100

	IF EXP:54 < EXPLV:1	; 【[噴乳経験]<EXPLV:1】
		SOURCE:12 += 20000
		SOURCE:13 += 10000
	ELSEIF EXP:54 < EXPLV:2	; 【[噴乳経験]<EXPLV:2】
		SOURCE:12 += 10000
		SOURCE:13 += 8000
	ELSEIF EXP:54 < EXPLV:3	; 【[噴乳経験]<EXPLV:3】
		SOURCE:12 += 7000
		SOURCE:13 += 6000
	ELSEIF EXP:54 < EXPLV:4	; 【[噴乳経験]<EXPLV:4】
		SOURCE:12 += 5000
		SOURCE:13 += 4000
	ELSEIF EXP:54 < EXPLV:5	; 【[噴乳経験]<EXPLV:5】
		SOURCE:12 += 3000
		SOURCE:13 += 2000
	ELSE
		SOURCE:12 += 1800
		SOURCE:13 += 1200
	ENDIF

	;噴乳経験によるLOSEBASE軽減
	IF EXP:54 >= EXPLV:4	; 【[噴乳経験]>=EXPLV:4】
		LOSEBASE:0 -= 10
		LOSEBASE:1 -= 50
	ELSEIF EXP:54 >= EXPLV:3	; 【[噴乳経験]>=EXPLV:3】
		LOSEBASE:0 -= 7
		LOSEBASE:1 -= 35
	ELSEIF EXP:54 >= EXPLV:2	; 【[噴乳経験]>=EXPLV:2】
		LOSEBASE:0 -= 5
		LOSEBASE:1 -= 25
	ENDIF

	PRINTFORML %NAME:TARGET%は乳首から大量の母乳を噴出した×{TFLAG:716}（{TFLAG:718}ml）
	PRINTL 噴乳経験＋2

	;マスターとの子供であり、恋慕あり、又は恋慕が無くても恋人で反発２未満なら妊娠中・育児中は異常経験がつかない
	IF CFLAG:111 == NO:MASTER && (TALENT:85 || (TALENT:85 == 0 && TALENT:153 && MARK:3 < 2)) && (TALENT:134 || TALENT:135 || TALENT:136)	; 【[恋慕] / [恋慕]なし / [恋人] / [妊娠] / [育児中] / [母性] / [反発感情]Lv<2 / [父親]==NO:MASTER】
		PRINTL 
	;それ以外の時にお乳が初めて出たら異常経験が付く
	ELSEIF (EXP:54 - CFLAG:25) == 0	; 【[噴乳経験]あり / [初期噴乳経験]】
		EXP:50 += 5
		PRINTL 異常経験＋5
	ENDIF
	;母乳回収
	IF CFLAG:11 == 0 && TEQUIP:16 == 0 && ITEM:31 > 0	; 【無[搾乳機]】
		CFLAG:11 = 1
		ITEM:31 -= 1
		IF ASSIPLAY == 0	; 【調教者:[主人]】
			PRINTFORML %CALLNAME:PLAYER%は噴出した%CALLNAME:TARGET%の母乳を丁寧に瓶で採取すると、
			PRINTFORML 「%CALLNAME:TARGET%の母乳」と書かれたラベルを見せつけるようにして瓶に貼り付けた
			PRINTFORML そして母乳が漏れ出ないようにしっかりと蓋をした後、それを懐にしまい込んだ
		ELSE
			PRINTFORML %CALLNAME:PLAYER%は噴出した%CALLNAME:TARGET%の母乳を丁寧に瓶で採取すると、
			PRINTFORML 「%CALLNAME:TARGET%の母乳」と書かれたラベルを見せつけるようにして瓶に貼り付けた
			PRINTFORML そして母乳が漏れ出ないようにしっかりと蓋をした後、それを%CALLNAME:MASTER%に手渡した
		ENDIF
	ENDIF
	SIF CFLAG:111 == NO:MASTER && (TALENT:85 || (TALENT:85 == 0 && TALENT:153 && MARK:3 < 2)) && (TALENT:134 || TALENT:135 || TALENT:136)	; 【[恋慕] / [恋慕]なし / [恋人] / [妊娠] / [育児中] / [母性] / [反発感情]Lv<2 / [父親]==NO:MASTER】
		CFLAG:25 += 2
	EXP:54 += 2
	;Ｂに母乳汚れ
	STAIN:5 |= 16

	BASE:3 -= EJAC*2
	SIF BASE:3 >= EJAC
		BASE:3 = EJAC-1

	;調教対象が噴乳フラグ
	TFLAG:11 += 2
	;搾乳器で母乳が集められているかチェック
	SIF TEQUIP:16	; 【[搾乳機]使用中】
		TFLAG:35 += 2

	NOWEX:4 += 1
	;噴乳統計加算
	CFLAG:TARGET:1282 += TFLAG:716
	CFLAG:TARGET:1283 += TFLAG:718
	EX:4 += 1
;通常の噴乳
ELSEIF E == 1
	LOSEBASE:1 += 40

	IF EXP:54 < EXPLV:1	; 【[噴乳経験]<EXPLV:1】
		SOURCE:12 += 10000
		SOURCE:13 += 5000
	ELSEIF EXP:54 < EXPLV:2	; 【[噴乳経験]<EXPLV:2】
		SOURCE:12 += 5000
		SOURCE:13 += 4000
	ELSEIF EXP:54 < EXPLV:3	; 【[噴乳経験]<EXPLV:3】
		SOURCE:12 += 2500
		SOURCE:13 += 2000
	ELSEIF EXP:54 < EXPLV:4	; 【[噴乳経験]<EXPLV:4】
		SOURCE:12 += 1600
		SOURCE:13 += 1400
	ELSEIF EXP:54 < EXPLV:5	; 【[噴乳経験]<EXPLV:5】
		SOURCE:12 += 800
		SOURCE:13 += 500
	ELSE
		SOURCE:12 += 200
		SOURCE:13 += 250
	ENDIF

	;噴乳経験によるLOSEBASE軽減
	IF EXP:54 >= EXPLV:4	; 【[噴乳経験]>=EXPLV:4】
		LOSEBASE:1 -= 20
	ELSEIF EXP:54 >= EXPLV:3	; 【[噴乳経験]>=EXPLV:3】
		LOSEBASE:1 -= 15
	ELSEIF EXP:54 >= EXPLV:2	; 【[噴乳経験]>=EXPLV:2】
		LOSEBASE:1 -= 10
	ENDIF

	PRINTFORML %NAME:TARGET%は乳首から母乳を垂れ流した×{TFLAG:716}（{TFLAG:718}ml）
	PRINTL 噴乳経験＋1

	;マスターとの子供であり、恋慕あり、又は恋慕が無くても恋人で反発２未満なら妊娠中・育児中は異常経験がつかない
	IF CFLAG:111 == NO:MASTER && (TALENT:85 || (TALENT:85 == 0 && TALENT:153 && MARK:3 < 2)) && (TALENT:134 || TALENT:135 || TALENT:136)	; 【[恋慕] / [恋慕]なし / [恋人] / [妊娠] / [育児中] / [母性] / [反発感情]Lv<2 / [父親]==NO:MASTER】
		PRINTL 
	;それ以外の時にお乳が初めて出たら異常経験が付く
	ELSEIF (EXP:54 - CFLAG:25) == 0	; 【[噴乳経験]あり / [初期噴乳経験]】
		EXP:50 += 5
		PRINTL 異常経験＋5
	ENDIF
	;母乳回収
	IF CFLAG:11 == 0 && TEQUIP:16 == 0 && ITEM:31 > 0	; 【無[搾乳機]】
		CFLAG:11 = 1
		ITEM:31 -= 1
		IF ASSIPLAY == 0	; 【調教者:[主人]】
			PRINTFORML %CALLNAME:PLAYER%は垂れ出てきた%CALLNAME:TARGET%の母乳を慎重に瓶で採取すると、
			PRINTFORML 「%CALLNAME:TARGET%の母乳」と書かれたラベルを見せつけるようにして瓶に貼り付けた
			PRINTFORML そして母乳が漏れ出ないようにしっかりと蓋をした後、それを懐にしまい込んだ
		ELSE
			PRINTFORML %CALLNAME:PLAYER%は垂れ出てきた%CALLNAME:TARGET%の母乳を慎重に瓶で採取すると、
			PRINTFORML 「%CALLNAME:TARGET%の母乳」と書かれたラベルを見せつけるようにして瓶に貼り付けた
			PRINTFORML そして母乳が漏れ出ないようにしっかりと蓋をした後、それを%CALLNAME:MASTER%に手渡した
		ENDIF
	ENDIF
	SIF CFLAG:111 == NO:MASTER && (TALENT:85 || (TALENT:85 == 0 && TALENT:153 && MARK:3 < 2)) && (TALENT:134 || TALENT:135 || TALENT:136)	; 【[恋慕] / [恋慕]なし / [恋人] / [妊娠] / [育児中] / [母性] / [反発感情]Lv<2 / [父親]==NO:MASTER】
		CFLAG:25 += 1
	EXP:54 += 1
	;Ｂに母乳汚れ
	STAIN:5 |= 16

	BASE:3 -= EJAC
	SIF BASE:3 >= EJAC
		BASE:3 = EJAC-1

	;調教対象が噴乳フラグ
	TFLAG:11 += 1
	;搾乳器で母乳が集められているかチェック
	SIF TEQUIP:16	; 【[搾乳機]使用中】
		TFLAG:35 += 1

	NOWEX:4 += 1
	EX:4 += 1
ENDIF

;-------------------------------------------------
;同性の場合のチェック
;-------------------------------------------------
@SOURCE_SEX_CHECK
SIF TALENT:122 == 0 && TALENT:PLAYER:122	; 【[オトコ]なし / PLAYER:[オトコ]】
	RETURN 0
SIF TALENT:122 && TALENT:PLAYER:122 == 0	; 【[オトコ] / PLAYER:[オトコ]なし】
	RETURN 0

;感覚関係のSOURCEは分けてREPEAT処理
LOCAL:0 = 0
LOCAL:1 = 1
LOCAL:2 = 2
LOCAL:3 = 17
LOCAL:4 = 24
REPEAT 5
	;レズ
	IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
		;ABL:レズっ気をみる
		IF ABL:9	; 【[レズっ気]】
			IF SOURCE:(LOCAL:COUNT) < 100000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:9 * 10 + 100) / 100
			ELSEIF SOURCE:(LOCAL:COUNT) < 100000000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) / 100 * (ABL:9 * 10 + 100)
			ENDIF
		ENDIF

		;ABL:レズ中毒をみる
		IF ABL:12 && ABL:12 < 5	; 【[レズ中毒] / [レズ中毒]Lv<5】
			SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:12 * 20 + 100) / 100
		ELSEIF ABL:12	; 【[レズ中毒]】
			IF SOURCE:(LOCAL:COUNT) < 100000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:12 * 10 + 150) / 100
			ELSEIF SOURCE:(LOCAL:COUNT) < 100000000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) / 100 * (ABL:12 * 10 + 150)
			ENDIF
		ENDIF

		;調教者のABL:レズっ気
		IF ABL:PLAYER:9 == 0	; 【PLAYER:[レズっ気]Lv==0】
			TIMES SOURCE:(LOCAL:COUNT) , 0.40
		ELSEIF ABL:PLAYER:9 == 1	; 【PLAYER:[レズっ気]Lv==1】
			TIMES SOURCE:(LOCAL:COUNT) , 0.70
		ELSEIF ABL:PLAYER:9 == 2	; 【PLAYER:[レズっ気]Lv==2】
			TIMES SOURCE:(LOCAL:COUNT) , 1.00
		ELSEIF ABL:PLAYER:9 == 3	; 【PLAYER:[レズっ気]Lv==3】
			TIMES SOURCE:(LOCAL:COUNT) , 1.10
		ELSEIF ABL:PLAYER:9 == 4	; 【PLAYER:[レズっ気]Lv==4】
			TIMES SOURCE:(LOCAL:COUNT) , 1.20
		ELSE
			IF SOURCE:(LOCAL:COUNT) < 100000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:PLAYER:9 * 5 + 105) / 100
			ELSEIF SOURCE:(LOCAL:COUNT) < 100000000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) / 100 * (ABL:PLAYER:9 * 5 + 105)
			ENDIF
		ENDIF

		;調教者のABL:レズ中毒
		IF ABL:PLAYER:12 == 1	; 【PLAYER:[レズ中毒]Lv==1】
			TIMES SOURCE:(LOCAL:COUNT) , 1.10
		ELSEIF ABL:PLAYER:12 == 2	; 【PLAYER:[レズ中毒]Lv==2】
			TIMES SOURCE:(LOCAL:COUNT) , 1.20
		ELSEIF ABL:PLAYER:12 == 3	; 【PLAYER:[レズ中毒]Lv==3】
			TIMES SOURCE:(LOCAL:COUNT) , 1.40
		ELSEIF ABL:PLAYER:12 == 4	; 【PLAYER:[レズ中毒]Lv==4】
			TIMES SOURCE:(LOCAL:COUNT) , 1.60
		ELSEIF ABL:PLAYER:12 >= 5	; 【PLAYER:[レズ中毒]Lv>=5】
			IF SOURCE:(LOCAL:COUNT) < 100000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:PLAYER:12 * 10 + 130) / 100
			ELSEIF SOURCE:(LOCAL:COUNT) < 100000000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) / 100 * (ABL:PLAYER:12 * 10 + 130)
			ENDIF
		ENDIF
	;ＢＬ
	ELSEIF TALENT:122 && TALENT:PLAYER:122	; 【[オトコ] / PLAYER:[オトコ]】
		;ABL:ＢＬっ気をみる
		IF ABL:13 && ABL:13 < 5	; 【[ＢＬっ気] / [ＢＬっ気]Lv<5】
			SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:13 * 10 + 100) / 100
		ELSEIF ABL:13	; 【[ＢＬっ気]】
			IF SOURCE:(LOCAL:COUNT) < 100000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:13 * 5 + 125) / 100
			ELSEIF SOURCE:(LOCAL:COUNT) < 100000000
				SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) / 100 * (ABL:13 * 5 + 125)
			ENDIF
		ENDIF
	ENDIF
REND

;レズ
IF TALENT:122 == 0 && TALENT:PLAYER:122 == 0	; 【[オトコ]なし / PLAYER:[オトコ]なし】
	;調教者の自制心
	IF TALENT:PLAYER:20	; 【PLAYER:[自制心]】
		TIMES SOURCE:4 , 0.50
		TIMES SOURCE:5 , 0.50
	ENDIF

	;ABL:レズっ気をみる
	IF ABL:9 == 0	; 【[レズっ気]Lv==0】
		TIMES SOURCE:8 , 0.80
		TIMES SOURCE:14 , 0.80

		TIMES SOURCE:13 , 0.90
	ELSEIF ABL:9 == 1	; 【[レズっ気]Lv==1】
		SOURCE:7 += 100

		TIMES SOURCE:8 , 0.60
		TIMES SOURCE:14 , 0.60
		
		TIMES SOURCE:13 , 0.75
		
		TIMES SOURCE:5 , 1.10
	ELSEIF ABL:9 == 2	; 【[レズっ気]Lv==2】
		SOURCE:7 += 200

		TIMES SOURCE:8 , 0.40
		TIMES SOURCE:14 , 0.40

		TIMES SOURCE:13 , 0.60

		TIMES SOURCE:5 , 1.20
	ELSEIF ABL:9 == 3	; 【[レズっ気]Lv==3】
		SOURCE:7 += 350

		TIMES SOURCE:8 , 0.25
		TIMES SOURCE:14 , 0.25

		TIMES SOURCE:13 , 0.45

		TIMES SOURCE:5 , 1.30
	ELSEIF ABL:9 == 4	; 【[レズっ気]Lv==4】
		SOURCE:7 += 500

		TIMES SOURCE:8 , 0.15
		TIMES SOURCE:14 , 0.15

		TIMES SOURCE:13 , 0.30

		TIMES SOURCE:5 , 1.40
	ELSE
		SOURCE:7 += 125 + (ABL:9 * 125)

		TIMES SOURCE:8 , 0.10
		TIMES SOURCE:14 , 0.10

		TIMES SOURCE:13 , 0.15

		IF SOURCE:5 < 100000
			SOURCE:5 = SOURCE:5 * (ABL:9 * 10 + 110) / 100
		ELSEIF SOURCE:5 < 100000000
			SOURCE:5 = SOURCE:5 / 100 * (ABL:9 * 10 + 110)
		ENDIF
	ENDIF
	
	;ABL:レズ中毒をみる
	IF ABL:12 == 1	; 【[レズ中毒]Lv==1】
		TIMES SOURCE:8 , 0.60
		TIMES SOURCE:14 , 0.60

		TIMES SOURCE:5 , 1.20
	ELSEIF ABL:12 == 2	; 【[レズ中毒]Lv==2】
		TIMES SOURCE:8 , 0.40
		TIMES SOURCE:14 , 0.40

		TIMES SOURCE:5 , 1.40
	ELSEIF ABL:12 == 3	; 【[レズ中毒]Lv==3】
		TIMES SOURCE:8 , 0.30
		TIMES SOURCE:14 , 0.30

		TIMES SOURCE:5 , 1.60
	ELSEIF ABL:12 == 4	; 【[レズ中毒]Lv==4】
		TIMES SOURCE:8 , 0.20
		TIMES SOURCE:14 , 0.20

		TIMES SOURCE:5 , 1.80
	ELSEIF ABL:12 >= 5	; 【[レズ中毒]Lv>=5】
		TIMES SOURCE:8 , 0.10
		TIMES SOURCE:14 , 0.10

		IF SOURCE:5 < 100000
			SOURCE:5 = SOURCE:5 * (ABL:12 * 10 + 150) / 100
		ELSEIF SOURCE:5 < 100000000
			SOURCE:5 = SOURCE:5 / 100 * (ABL:12 * 10 + 150)
		ENDIF
	ENDIF

	;調教者のABL:レズっ気
	IF ABL:PLAYER:9 == 0	; 【PLAYER:[レズっ気]Lv==0】
		TIMES SOURCE:3 , 0.20
		TIMES SOURCE:4 , 0.30
		TIMES SOURCE:5 , 0.30
	ELSEIF ABL:PLAYER:9 == 1	; 【PLAYER:[レズっ気]Lv==1】
		TIMES SOURCE:3 , 0.60
		TIMES SOURCE:4 , 0.70
		TIMES SOURCE:5 , 0.70
	ELSEIF ABL:PLAYER:9 == 2	; 【PLAYER:[レズっ気]Lv==2】
		TIMES SOURCE:3 , 1.00
		TIMES SOURCE:4 , 1.00
		TIMES SOURCE:5 , 1.00
	ELSEIF ABL:PLAYER:9 == 3	; 【PLAYER:[レズっ気]Lv==3】
		TIMES SOURCE:3 , 1.40
		TIMES SOURCE:4 , 1.30
		TIMES SOURCE:5 , 1.30
	ELSEIF ABL:PLAYER:9 == 4	; 【PLAYER:[レズっ気]Lv==4】
		TIMES SOURCE:3 , 1.80
		TIMES SOURCE:4 , 1.60
		TIMES SOURCE:5 , 1.60
	ELSE
		IF SOURCE:3 < 100000
			SOURCE:3 = SOURCE:3 * (ABL:PLAYER:9 * 35 + 75) / 100
		ELSEIF SOURCE:3 < 100000000
			SOURCE:3 = SOURCE:3 / 100 * (ABL:PLAYER:9 * 35 + 75)
		ENDIF
		IF SOURCE:4 < 100000
			SOURCE:4 = SOURCE:4 * (ABL:PLAYER:9 * 20 + 100) / 100
		ELSEIF SOURCE:4 < 100000000
			SOURCE:4 = SOURCE:4 / 100 * (ABL:PLAYER:9 * 20 + 100)
		ENDIF
		IF SOURCE:5 < 100000
			SOURCE:5 = SOURCE:5 * (ABL:PLAYER:9 * 20 + 100) / 100
		ELSEIF SOURCE:5 < 100000000
			SOURCE:5 = SOURCE:5 / 100 * (ABL:PLAYER:9 * 20 + 100)
		ENDIF
	ENDIF

	;調教者のABL:レズ中毒
	IF ABL:PLAYER:12 == 1	; 【PLAYER:[レズ中毒]Lv==1】
		TIMES SOURCE:3 , 1.50
		TIMES SOURCE:4 , 1.50
		TIMES SOURCE:5 , 1.50
	ELSEIF ABL:PLAYER:12 == 2	; 【PLAYER:[レズ中毒]Lv==2】
		TIMES SOURCE:3 , 2.00
		TIMES SOURCE:4 , 2.00
		TIMES SOURCE:5 , 2.00
	ELSEIF ABL:PLAYER:12 == 3	; 【PLAYER:[レズ中毒]Lv==3】
		TIMES SOURCE:3 , 2.50
		TIMES SOURCE:4 , 2.50
		TIMES SOURCE:5 , 2.50
	ELSEIF ABL:PLAYER:12 == 4	; 【PLAYER:[レズ中毒]Lv==4】
		TIMES SOURCE:3 , 3.50
		TIMES SOURCE:4 , 3.00
		TIMES SOURCE:5 , 3.00
	ELSEIF ABL:PLAYER:12 >= 5	; 【PLAYER:[レズ中毒]Lv>=5】
		IF SOURCE:3 < 100000
			SOURCE:3 = SOURCE:3 * (ABL:PLAYER:12 * 75 + 125) / 100
		ELSEIF SOURCE:3 < 100000000
			SOURCE:3 = SOURCE:3 / 100 * (ABL:PLAYER:12 * 75 + 125)
		ENDIF
		IF SOURCE:4 < 100000
			SOURCE:4 = SOURCE:4 * (ABL:PLAYER:12 * 50 + 150) / 100
		ELSEIF SOURCE:4 < 100000000
			SOURCE:4 = SOURCE:4 / 100 * (ABL:PLAYER:12 * 50 + 150)
		ENDIF
		IF SOURCE:5 < 100000
			SOURCE:5 = SOURCE:5 * (ABL:PLAYER:12 * 50 + 150) / 100
		ELSEIF SOURCE:5 < 100000000
			SOURCE:5 = SOURCE:5 / 100 * (ABL:PLAYER:12 * 50 + 150)
		ENDIF
	ENDIF
ELSEIF TALENT:122 && TALENT:PLAYER:122	; 【[オトコ] / PLAYER:[オトコ]】
	IF ABL:13 == 0	; 【[ＢＬっ気]Lv==0】
		TIMES SOURCE:8 , 4.00
		TIMES SOURCE:14 , 4.00

		TIMES SOURCE:5 , 0.50
	ELSEIF ABL:13 == 1	; 【[ＢＬっ気]Lv==1】
		SOURCE:7 += 10

		TIMES SOURCE:8 , 2.00
		TIMES SOURCE:14 , 2.00

		TIMES SOURCE:5 , 0.70
	ELSEIF ABL:13 == 2	; 【[ＢＬっ気]Lv==2】
		SOURCE:7 += 40

		TIMES SOURCE:8 , 1.40
		TIMES SOURCE:14 , 1.40

		TIMES SOURCE:5 , 0.90
	ELSEIF ABL:13 == 3	; 【[ＢＬっ気]Lv==3】
		SOURCE:7 += 100

		TIMES SOURCE:8 , 1.00
		TIMES SOURCE:14 , 1.00

		TIMES SOURCE:5 , 1.10
	ELSEIF ABL:13 == 4	; 【[ＢＬっ気]Lv==4】
		SOURCE:7 += 200

		TIMES SOURCE:8 , 0.70
		TIMES SOURCE:14 , 0.70

		TIMES SOURCE:5 , 1.20
	ELSE
		SOURCE:7 += ABL:13 * 70

		TIMES SOURCE:8 , 0.50
		TIMES SOURCE:14 , 0.50

		TIMES SOURCE:5 , 1.30
	ENDIF

	;調教者の自制心
	IF TALENT:PLAYER:20	; 【PLAYER:[自制心]】
		TIMES SOURCE:4 , 0.50
		TIMES SOURCE:5 , 0.50
	ENDIF
ENDIF

;結婚記念日ボーナス（全ソースに×1.2）
IF TIME:4 & 2
	REPEAT 25
		TIMES SOURCE:COUNT , 1.20
	REND
ENDIF



@PLAYER_SKILL_CHECK
;感覚関係のSOURCEは分けてREPEAT処理
LOCAL:0 = 0
LOCAL:1 = 1
LOCAL:2 = 2
LOCAL:3 = 17
LOCAL:4 = 24
REPEAT 5
	;調教者のTALENT:解放をみる
	SIF TALENT:PLAYER:33	; 【PLAYER:[解放]】
		TIMES SOURCE:(LOCAL:COUNT) , 1.20
	;調教者のTALENT:魅惑をみる
	SIF TALENT:PLAYER:91	; 【PLAYER:[魅惑]】
		TIMES SOURCE:(LOCAL:COUNT) , 1.20
	;調教者のTALENT:謎の魅力をみる
	SIF TALENT:PLAYER:92	; 【PLAYER:[謎の魅力]】
		TIMES SOURCE:(LOCAL:COUNT) , 1.20
	;調教者のTALENT:eratohoを支配する程度の能力をみる
	SIF TALENT:PLAYER:201	; 【PLAYER:[eratohoJも支配する程度の能力]】
		TIMES SOURCE:(LOCAL:COUNT) , 2.00

	;調教者のABL:技巧
	IF ABL:PLAYER:2 == 0	; 【PLAYER:[技巧]Lv==0】
		TIMES SOURCE:(LOCAL:COUNT) , 0.50
	ELSEIF ABL:PLAYER:2 == 1	; 【PLAYER:[技巧]Lv==1】
		TIMES SOURCE:(LOCAL:COUNT) , 0.80
	ELSEIF ABL:PLAYER:2 == 2	; 【PLAYER:[技巧]Lv==2】
		TIMES SOURCE:(LOCAL:COUNT) , 1.00
	ELSEIF ABL:PLAYER:2 == 3	; 【PLAYER:[技巧]Lv==3】
		TIMES SOURCE:(LOCAL:COUNT) , 1.20
	ELSEIF ABL:PLAYER:2 == 4	; 【PLAYER:[技巧]Lv==4】
		TIMES SOURCE:(LOCAL:COUNT) , 1.50
	ELSE
		IF SOURCE:(LOCAL:COUNT) < 100000
			SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) * (ABL:PLAYER:2 * 25 + 75) / 100
		ELSEIF SOURCE:(LOCAL:COUNT) < 100000000
			SOURCE:(LOCAL:COUNT) = SOURCE:(LOCAL:COUNT) / 100 * (ABL:PLAYER:2 * 25 + 75)
		ENDIF
	ENDIF
REND

;調教者のTALENT:解放をみる
IF TALENT:PLAYER:33	; 【PLAYER:[解放]】
	TIMES SOURCE:3 , 1.20
ENDIF
;調教者のTALENT:小悪魔をみる
IF TALENT:PLAYER:87	; 【PLAYER:[小悪魔]】
	TIMES SOURCE:12 , 1.60
ENDIF
;調教者のTALENT:魅惑をみる
IF TALENT:PLAYER:91	; 【PLAYER:[魅惑]】
	TIMES SOURCE:8 , 0.50
	TIMES SOURCE:14 , 0.50

	TIMES SOURCE:5 , 1.20
ENDIF
;調教者のTALENT:謎の魅力をみる
IF TALENT:PLAYER:92	; 【PLAYER:[謎の魅力]】
	TIMES SOURCE:8 , 0.50
	TIMES SOURCE:14 , 0.50

	TIMES SOURCE:5 , 1.20
ENDIF
;調教者のTALENT:魅力をみる
IF TALENT:PLAYER:113	; 【PLAYER:[魅力]】
	TFLAG:37 += 1
ENDIF
;調教者のTALENT:eratohoを支配する程度の能力をみる
IF TALENT:PLAYER:201	; 【PLAYER:[eratohoJも支配する程度の能力]】
	TIMES SOURCE:5 , 2.00
ENDIF

;調教者のサドっ気・マゾっ気・主導権基準値を考慮
IF ABL:PLAYER:15 > 0	; 【PLAYER:[サドっ気]Lv>0】
	;調教者がサドいと、受動と苦痛が増える
	IF SOURCE:6 < 100000
		SOURCE:6 = SOURCE:6 * (ABL:PLAYER:15 * 10 + 100) / 100
	ELSEIF SOURCE:6 < 100000000
		SOURCE:6 = SOURCE:6 / 100 * (ABL:PLAYER:15 * 10 + 100)
	ENDIF
	IF SOURCE:21 < 100000
		SOURCE:21 = SOURCE:21 * (ABL:PLAYER:15 * 20 + 100) / 100
	ELSEIF SOURCE:21 < 100000000
		SOURCE:21 = SOURCE:21 / 100 * (ABL:PLAYER:15 * 20 + 100)
	ENDIF
ENDIF
IF ABL:PLAYER:8 > 0	; 【PLAYER:[マゾっ気]Lv>0】
	;調教者がマゾいと、征服が増える
	IF SOURCE:20 < 100000
		SOURCE:20 = SOURCE:20 * (ABL:PLAYER:8 * 20 + 100) / 100
	ELSEIF SOURCE:20 < 100000000
		SOURCE:20 = SOURCE:20 / 100 * (ABL:PLAYER:8 * 20 + 100)
	ENDIF
ENDIF

T = PLAYER
CALL GET_INITIATIVE_RATE
IF R > 0
	;調教者がサドいと、受動と苦痛が増える
	IF SOURCE:6 < 100000
		SOURCE:6 = SOURCE:6 * (R + 100) / 100
	ELSEIF SOURCE:6 < 100000000
		SOURCE:6 = SOURCE:6 / 100 * (R + 100)
	ENDIF
	IF SOURCE:21 < 100000
		SOURCE:21 = SOURCE:21 * (R + 100) / 100
	ELSEIF SOURCE:21 < 100000000
		SOURCE:21 = SOURCE:21 / 100 * (R + 100)
	ENDIF
ENDIF
IF R < 0
	R *= -1
	;調教者がマゾいと、征服が増える
	IF SOURCE:20 < 100000
		SOURCE:20 = SOURCE:20 * (R + 100) / 100
	ELSEIF SOURCE:20 < 100000000
		SOURCE:20 = SOURCE:20 / 100 * (R + 100)
	ENDIF
ENDIF


