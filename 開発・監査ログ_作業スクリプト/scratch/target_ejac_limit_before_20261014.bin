	TIMES UP:10 , 0.90
	TIMES UP:11 , 1.20
	TIMES UP:12 , 1.20
	TIMES UP:13 , 1.20
	TIMES UP:15 , 0.90
	TIMES UP:16 , 0.90
	TIMES UP:17 , 0.90
ENDIF

;反発感情廃止（ブロック削除済み）


;異常経験(＝淫乱度合とみなす)による、抑鬱の軽減
;でもあなた様だけはなかなか軽減しない
IF EXP:50 <= 0	; 【[異常経験]<=0】
	TIMES UP:13 , 1.30
ELSEIF EXP:50 < (10 + TALENT:201 * 255)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 1.10
ELSEIF EXP:50 < (50 + TALENT:201 * 500)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 0.90
ELSEIF EXP:50 < (100 + TALENT:201 * 1000)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 0.70
ELSEIF EXP:50 < (200 + TALENT:201 * 2000)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 0.40
ELSEIF EXP:50 < (400 + TALENT:201 * 4000)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 0.10
ELSEIF EXP:50 < (700 + TALENT:201 * 7000)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 0.01
ELSEIF EXP:50 < (1500 + TALENT:201 * 15000)	; 【[eratohoJも支配する程度の能力] / [異常経験]あり】
	TIMES UP:13 , 0.001
ELSE
	TIMES UP:13 , 0.0001
ENDIF

;調教者の技巧による反感と不快の軽減処理
IF ABL:PLAYER:2 >= 10 && ABL:PLAYER:2 <= 99 && (UP:0 + UP:1 + UP:2 + UP:14 + UP:18) > 0	; 【PLAYER:[技巧]Lv>=10 / PLAYER:[技巧]Lv<=99 / [快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇] / [快Ｂ上昇] / [快Ｍ上昇]】
	UP:11 = UP:11 * (110 - ABL:PLAYER:2) / 100
	UP:12 = UP:12 * (110 - ABL:PLAYER:2) / 100
ELSEIF ABL:PLAYER:2 >= 100 && ABL:PLAYER:2 <= 999 && (UP:0 + UP:1 + UP:2 + UP:14 + UP:18) > 0	; 【PLAYER:[技巧]Lv>=100 / PLAYER:[技巧]Lv<=999 / [快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇] / [快Ｂ上昇] / [快Ｍ上昇]】
	UP:11 = UP:11 * (1100 - ABL:PLAYER:2) / 10000
	UP:12 = UP:12 * (1100 - ABL:PLAYER:2) / 10000
ELSEIF ABL:PLAYER:2 >= 1000 && (UP:0 + UP:1 + UP:2 + UP:14 + UP:18) > 0	; 【PLAYER:[技巧]Lv>=1000 / [快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇] / [快Ｂ上昇] / [快Ｍ上昇]】
	UP:11 = UP:11 / 100
	UP:12 = UP:12 / 100
ENDIF

;合意がない時のウフフ中コマンドによる強い反感
IF TFLAG:44 != 0 && TARGET >= 0 && TALENT:TARGET:152 == 0	; 【TARGET:[合意]なし / [ウフフ中]】
	;基本倍率：反感(UP:11)を大幅に増加
	TIMES UP:11 , 3.00
	;不快(UP:12)も増加
	TIMES UP:12 , 2.00
	;従順に応じて反感のベース値を大幅追加
	IF ABL:TARGET:0 == 0	; 【TARGET:[親密]Lv==0】
		UP:11 += 3000
	ELSEIF ABL:TARGET:0 <= 2	; 【TARGET:[親密]Lv<=2】
		UP:11 += 2000
	ELSEIF ABL:TARGET:0 <= 4	; 【TARGET:[親密]Lv<=4】
		UP:11 += 1200
	ELSE
		UP:11 += 600
	ENDIF
ENDIF

;-------------------------------------------------
;刻印取得のチェック
;-------------------------------------------------
@MARK_GOT_CHECK
;LOCAL = 刻印のLV記録
;LOCAL:1 = 親密変動値記録

;-------------------------------------------------
;反発感情廃止（取得ブロック削除済み）
TFLAG:150 = 0

;-------------------------------------------------
;苦痛依存
;-------------------------------------------------
VARSET LOCAL, 0
IF UP:9 >= 500 && UP:9 < 1500 && MARK:0 <= 0	; 【[苦痛依存]Lv<=0 / [苦痛上昇]>=500 / [苦痛上昇]<1500】
	LOCAL = 1
	LOCAL:1 = 1
ELSEIF UP:9 >= 1500 && UP:9 < 3000 && MARK:0 <= 1	; 【[苦痛依存]Lv<=1 / [苦痛上昇]>=1500 / [苦痛上昇]<3000】
	LOCAL = 2
	LOCAL:1 = 3
ELSEIF UP:9 >= 3000 && MARK:0 <= 2	; 【[苦痛依存]Lv<=2 / [苦痛上昇]>=3000】
	LOCAL = 3
	LOCAL:1 = 5
ENDIF

;苦痛依存取得
IF LOCAL > 0
	MARK:0 = LOCAL
	TFLAG:22 = LOCAL
	PRINTFORML 苦痛依存LV{LOCAL}を取得
ENDIF

;マゾっ気LVが取得する苦痛依存LV以上かつ、気丈・感情乏しいがなく、反発感情がない場合は親密アップ
IF ABL:0 < LOCAL:1 && ABL:8 >= LOCAL && TALENT:12 == 0 && TALENT:22 == 0 && MARK:3 == 0	; 【[気丈]なし / [感情乏しい]なし / [親密] / [マゾっ気] / [反発感情]Lv==0】
	IF TFLAG:899 == 0 && BASE:TARGET:0 > 0	; 【無[気絶継続中] / TARGET:[体力]>0】
		ABL:0 = LOCAL:1
		PRINTFORML そして親密がLV{ABL:0}になった
	ENDIF
ENDIF

;苦痛依存LV3取得時に条件を満たすと異常経験増加
IF TFLAG:22 == 3	; 【[苦痛依存入手]==3】
	;実行者が【サド】持ち サドっ気が非常に高い場合正常位等でも苦痛依存LV3取得、異常経験増加してしまうためコメントアウト
	;IF TALENT:PLAYER:83
	;	PRINTFORML %EXPNAME:50%＋３
	;	EXP:50 += 3
	;針の実行者が【針さばき】持ち
	IF TALENT:PLAYER:53 && SELECTCOM == 42	; 【PLAYER:[針さばき] / コマンド:[針]】
		PRINTFORML %EXPNAME:50%＋３
		EXP:50 += 3
	ENDIF
ENDIF

SIF LOCAL > 0
	WAIT

;-------------------------------------------------
;快楽依存
;-------------------------------------------------
VARSET LOCAL, 0
;気絶中は快楽依存を取得しない
IF TFLAG:899 == 0 && BASE:TARGET:0 > 0	; 【無[気絶継続中] / TARGET:[体力]>0】
	A = UP:0 + UP:1 + UP:2 + UP:14 + UP:18

	IF A >= 500 && A < 1500 && MARK:1 <= 0	; 【[快楽依存]Lv<=0】
		LOCAL = 1
		LOCAL:1 = 1
	ELSEIF A >= 1500 && A < 3000 && MARK:1 <= 1	; 【[快楽依存]Lv<=1】
		LOCAL = 2
		LOCAL:1 = 3
	ELSEIF A >= 3000 && MARK:1 <= 2	; 【[快楽依存]Lv<=2】
		LOCAL = 3
		LOCAL:1 = 5
	ENDIF

	;快楽依存取得
	IF LOCAL > 0
		MARK:1 = LOCAL
		TFLAG:23 = LOCAL
		PRINTFORML 快楽依存LV{LOCAL}を取得
	ENDIF

	;自制心・感情乏しいがなく、反発感情がない場合は親密アップ
	IF ABL:0 < LOCAL:1 && TALENT:20 == 0 && TALENT:22 == 0 && MARK:3 == 0	; 【[自制心]なし / [感情乏しい]なし / [親密] / [反発感情]Lv==0】
		ABL:0 = LOCAL:1
		PRINTFORML そして親密がLV{ABL:0}になった
	ENDIF

	SIF LOCAL > 0
		WAIT
ENDIF

;-------------------------------------------------
;既成事実
;-------------------------------------------------
VARSET LOCAL, 0
;気絶中は既成事実を取得しない
IF TFLAG:899 == 0 && BASE:TARGET:0 > 0	; 【無[気絶継続中] / TARGET:[体力]>0】
	IF TFLAG:200 == 1 && MARK:2 <= 0	; 【[既成事実]Lv<=0 / [既成事実フラグ]==1】
		LOCAL = 1
		LOCAL:1 = 3
	ELSEIF TFLAG:200 == 2 && MARK:2 <= 1	; 【[既成事実]Lv<=1 / [既成事実フラグ]==2】
		LOCAL = 2
		LOCAL:1 = 5
	ELSEIF TFLAG:200 == 3 && MARK:2 <= 2	; 【[既成事実]Lv<=2 / [既成事実フラグ]==3】
		LOCAL = 3
		LOCAL:1 = 8
	ENDIF

	;既成事実取得
	IF LOCAL > 0
		MARK:2 = LOCAL
		TFLAG:24 = LOCAL
		PRINTFORML 既成事実LV{LOCAL}を取得
	ENDIF

	;感情乏しいがなく、反発感情がない場合は親密アップ
	IF ABL:0 < LOCAL:1 && TALENT:22 == 0 && MARK:3 == 0	; 【[感情乏しい]なし / [親密] / [反発感情]Lv==0】
		ABL:0 = LOCAL:1
		PRINTFORML そして親密がLV{ABL:0}になった
	ENDIF

	SIF LOCAL > 0
		WAIT
ENDIF

;-------------------------------------------------
;反発感情取得時は反発感情取得口上のみ表示
;-------------------------------------------------
IF TFLAG:21	; 【[反発感情入手]】
	TFLAG:22 = 0
	TFLAG:23 = 0
	TFLAG:24 = 0
ENDIF



;-------------------------------------------------
;欲望の上昇による[抑圧][抵抗]の消滅をチェック
;-------------------------------------------------
@YOKUBO_UP_CHECK
IF ABL:1 >= 6 && (TALENT:32 == 1 || TALENT:34 == 1)	; 【[抑圧] / [抵抗] / [欲望]Lv>=6】
	TFLAG:13 = 36
	CALL SELF_KOJO
	PRINTFORM %NAME:TARGET%は
	IF TALENT:32 == 1	; 【[抑圧]】
		PRINTFORM [%TALENTNAME:32%]
		TALENT:32 = 2
	ENDIF
	IF TALENT:34 == 1	; 【[抵抗]】
		PRINTFORM [%TALENTNAME:34%]
		TALENT:34 = 2
	ENDIF
	PRINTL が昇華した
	
	PRINTW 否定の珠が半分になった
	JUEL:100 /= 2

	TFLAG:25 = 1
ENDIF

;-------------------------------------------------
;ツンデレ持ちの親密上昇による[反抗的]の反転をチェック
;-------------------------------------------------
@JUJUN_UP_CHECK
IF ABL:0 >= 10 && TALENT:11 == 1 && TALENT:18	; 【[反抗的] / [ツンデレ] / [親密]Lv>=10】
	TFLAG:13 = 77
	CALL SELF_KOJO
	PRINTFORMW %NAME:TARGET%は[%TALENTNAME:11%]が昇華し、[%TALENTNAME:13%]を得た
	TALENT:11 = 2
	TALENT:13 = 1
ENDIF

;-------------------------------------------------
;苦痛快楽経験、奉仕快楽経験のチェック
;-------------------------------------------------
@EXP_GOT_CHECK

A = UP:0 + UP:1 + UP:2 + UP:14 +UP:18

;奉仕系である、奉仕快楽のチェック
E = 0

IF UP:7 < 100	; 【[習得上昇]<100】
	A = 0
ELSEIF UP:7 < 300	; 【[習得上昇]<300】
	A *= 1
ELSEIF UP:7 < 700	; 【[習得上昇]<700】
	A *= 2
ELSEIF UP:7 < 1500	; 【[習得上昇]<1500】
	A *= 3
ELSE
	A *= 4
ENDIF

IF TFLAG:100	; 【[ページ数]】
	IF A >= 1000000
		E = 64
		TIMES UP:11 , 0.55
		TIMES UP:12 , 0.10
	ELSEIF A >= 200000
		E = 32
		TIMES UP:11 , 0.60
		TIMES UP:12 , 0.20
	ELSEIF A >= 12000
		E = 16
		TIMES UP:11 , 0.65
		TIMES UP:12 , 0.30
	ELSEIF A >= 8000
		E = 12
		TIMES UP:11 , 0.70
		TIMES UP:12 , 0.40
	ELSEIF A >= 5000
		E = 8
		TIMES UP:11 , 0.75
		TIMES UP:12 , 0.50
	ELSEIF A >= 3000
		E = 4
		TIMES UP:11 , 0.80
		TIMES UP:12 , 0.60
	ELSEIF A >= 2000
		E = 2
		TIMES UP:11 , 0.85
		TIMES UP:12 , 0.70
	ELSEIF A >= 1000
		E = 1
		TIMES UP:11 , 0.90
		TIMES UP:12 , 0.80
	ENDIF
	
	IF E
		PRINT 奉仕快楽経験+
		PRINTVL E
		EXP:21 += E
		TFLAG:26 = E
	ENDIF
ENDIF

;苦痛快楽のチェック
A = UP:0 + UP:1 + UP:2 + UP:14 + UP:18

E = 0

IF A >= 12000 && UP:9 >= 8000	; 【[苦痛上昇]>=8000】
	E = 64
	TIMES UP:11 , 0.55
ELSEIF A >= 6000 && UP:9 >= 4000	; 【[苦痛上昇]>=4000】
	E = 32
	TIMES UP:11 , 0.60
ELSEIF A >= 3000 && UP:9 >= 2000	; 【[苦痛上昇]>=2000】
	E = 16
	TIMES UP:11 , 0.65
ELSEIF A >= 2500 && UP:9 >= 1500	; 【[苦痛上昇]>=1500】
	E = 12
	TIMES UP:11 , 0.70
ELSEIF A >= 1500 && UP:9 >= 1000	; 【[苦痛上昇]>=1000】
	E = 8
	TIMES UP:11 , 0.75
ELSEIF A >= 1000 && UP:9 >= 500	; 【[苦痛上昇]>=500】
	E = 4
	TIMES UP:11 , 0.80
ELSEIF A >= 600 && UP:9 >= 300	; 【[苦痛上昇]>=300】
	E = 2
	TIMES UP:11 , 0.85
ELSEIF A >= 300 && UP:9 >= 100	; 【[苦痛上昇]>=100】
	E = 1
	TIMES UP:11 , 0.90
ENDIF
IF E
	PRINT 苦痛快楽経験+
	PRINTVL E
	EXP:30 += E
	TFLAG:27 = E
ENDIF


A = UP:2

;アナル系である、Ａ快楽のチェック
E = 0

IF A >= 1000000
	E = 64
	TIMES UP:11 , 0.75
	TIMES UP:12 , 0.85
	TIMES UP:6 , 1.30
ELSEIF A >= 200000
	E = 32
	TIMES UP:11 , 0.80
	TIMES UP:12 , 0.85
	TIMES UP:6 , 1.25
ELSEIF A >= 12000
	E = 16
	TIMES UP:11 , 0.80
	TIMES UP:12 , 0.90
	TIMES UP:6 , 1.20
ELSEIF A >= 8000
	E = 12
	TIMES UP:11 , 0.85
	TIMES UP:12 , 0.90
	TIMES UP:6 , 1.15
ELSEIF A >= 5000
	E = 8
	TIMES UP:11 , 0.85
	TIMES UP:12 , 0.95
	TIMES UP:6 , 1.10
ELSEIF A >= 3000
	E = 4
	TIMES UP:11 , 0.90
	TIMES UP:12 , 0.95
	TIMES UP:6 , 1.05
ELSEIF A >= 2000
	E = 2
	TIMES UP:11 , 0.90
	TIMES UP:12 , 1.00
	TIMES UP:6 , 1.00
ELSEIF A >= 1000
	E = 1
	TIMES UP:11 , 0.95
	TIMES UP:12 , 1.00
	TIMES UP:6 , 1.00
ENDIF
IF E
	PRINT Ａ快楽経験+
	PRINTVL E
	EXP:32 += E
	TFLAG:128 = E
ENDIF

;-------------------------------------------------
;[即落ち]のチェック
;-------------------------------------------------
@SOKUOCHI_CHECK

SIF TALENT:73 == 0	; 【[即落ち]なし】
	RETURN 0

;UP代入
LOCAL:0 = 0
LOCAL:1 = 1
LOCAL:2 = 2
LOCAL:3 = 14
LOCAL:4 = 4
LOCAL:5 = 5
LOCAL:6 = 6
LOCAL:7 = 7
LOCAL:8 = 8
LOCAL:9 = 9
;ABL代入
LOCAL:100 = 3
LOCAL:101 = 4
LOCAL:102 = 5
LOCAL:103 = 14
LOCAL:104 = 0
LOCAL:105 = 1
LOCAL:106 = 6
LOCAL:107 = 2
LOCAL:108 = 7
LOCAL:109 = 8
REPEAT 10
	IF UP:(LOCAL:COUNT) > 1 && ABL:(LOCAL:(100+COUNT)) < 1
		ABL:(LOCAL:(100+COUNT)) = 1
		PRINTFORML %ABLNAME:(LOCAL:(100+COUNT))%LV1になった
	ELSEIF UP:(LOCAL:COUNT) > 30 && ABL:(LOCAL:(100+COUNT)) < 2
		ABL:(LOCAL:(100+COUNT)) = 2
		PRINTFORML %ABLNAME:(LOCAL:(100+COUNT))%LV2になった
	ELSEIF UP:(LOCAL:COUNT) > 60 && ABL:(LOCAL:(100+COUNT)) < 3
		ABL:(LOCAL:(100+COUNT)) = 3
		PRINTFORML %ABLNAME:(LOCAL:(100+COUNT))%LV3になった
	ELSEIF UP:(LOCAL:COUNT) > 200 && ABL:(LOCAL:(100+COUNT)) < 4
		ABL:(LOCAL:(100+COUNT)) = 4
		PRINTFORML %ABLNAME:(LOCAL:(100+COUNT))%LV4になった
	ELSEIF UP:(LOCAL:COUNT) > 1000 && ABL:(LOCAL:(100+COUNT)) < 5
		ABL:(LOCAL:(100+COUNT)) = 5
		PRINTFORML %ABLNAME:(LOCAL:(100+COUNT))%LV5になった
	ENDIF
REND

IF EXP:40 > 1 && ABL:9 < 1 && ABL:1 >= 1	; 【[レズっ気]Lv<1 / [欲望]Lv>=1 / [レズ経験]>1】
	ABL:9 = 1
	PRINTFORML %ABLNAME:9%LV1になった
ELSEIF EXP:40 > 5 && ABL:9 < 2 && ABL:1 >= 2	; 【[レズっ気]Lv<2 / [欲望]Lv>=2 / [レズ経験]>5】
	ABL:9 = 2
	PRINTFORML %ABLNAME:9%LV2になった
ELSEIF EXP:40 > 20 && ABL:9 < 3 && ABL:1 >= 3	; 【[レズっ気]Lv<3 / [欲望]Lv>=3 / [レズ経験]>20】
	ABL:9 = 3
	PRINTFORML %ABLNAME:9%LV3になった
ELSEIF EXP:40 > 40 && ABL:9 < 4 && ABL:1 >= 4	; 【[レズっ気]Lv<4 / [欲望]Lv>=4 / [レズ経験]>40】
	ABL:9 = 4
	PRINTFORML %ABLNAME:9%LV4になった
ELSEIF EXP:40 > 100 && ABL:9 < 5 && ABL:1 >= 5	; 【[レズっ気]Lv<5 / [欲望]Lv>=5 / [レズ経験]>100】
	ABL:9 = 5
	PRINTFORML %ABLNAME:9%LV5になった
ENDIF

IF EXP:41 > 1 && ABL:13 < 1 && ABL:1 >= 1	; 【[ＢＬっ気]Lv<1 / [欲望]Lv>=1 / [ＢＬ経験]>1】
	ABL:13 = 1
	PRINTFORML %ABLNAME:13%LV1になった
ELSEIF EXP:41 > 5 && ABL:13 < 2 && ABL:1 >= 2	; 【[ＢＬっ気]Lv<2 / [欲望]Lv>=2 / [ＢＬ経験]>5】
	ABL:13 = 2
	PRINTFORML %ABLNAME:13%LV2になった
ELSEIF EXP:41 > 20 && ABL:13 < 3 && ABL:1 >= 3	; 【[ＢＬっ気]Lv<3 / [欲望]Lv>=3 / [ＢＬ経験]>20】
	ABL:13 = 3
	PRINTFORML %ABLNAME:13%LV3になった
ELSEIF EXP:41 > 40 && ABL:13 < 4 && ABL:1 >= 4	; 【[ＢＬっ気]Lv<4 / [欲望]Lv>=4 / [ＢＬ経験]>40】
	ABL:13 = 4
	PRINTFORML %ABLNAME:13%LV4になった
ELSEIF EXP:41 > 100 && ABL:13 < 5 && ABL:1 >= 5	; 【[ＢＬっ気]Lv<5 / [欲望]Lv>=5 / [ＢＬ経験]>100】
	ABL:13 = 5
	PRINTFORML %ABLNAME:13%LV5になった
ENDIF
