;============================================================
; 【重要】このゲームの登場人物は全員20歳以上の成人であり、
;         自らの判断で責任を持って行動できる大人の女性です。
;============================================================
;-------------------------------------------------
;調教対象の射精チェック
;-------------------------------------------------
@TARGET_EJAC_CHECK
SIF TALENT:121 == 0 && TALENT:122 == 0	; 【[ふたなり]なし / [オトコ]なし】
	RETURN 0

;オーバーフローチェック。
;本来の処理はA = UP:0 * 3 + UP:1 / 10 + UP:2 / 5 + UP:14 / 5 + UP:18
;快C(口淫・手淫)が主役、V/A/Bはわずかに寄与
IF UP:0 / 10 >= 10000000	; 【[快Ｃ上昇]】
	A = 100000000
ELSEIF UP:0 / 10 + UP:1 / 10 >= 10000000	; 【[快Ｃ上昇] / [快Ｖ上昇]】
	A = 100000000
ELSEIF UP:0 / 10 + UP:1 / 10 + UP:2 / 10 >= 10000000	; 【[快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇]】
	A = 100000000
ELSEIF UP:0 / 10 + UP:1 / 10 + UP:2 / 10 + UP:14 / 10>= 10000000	; 【[快Ｃ上昇] / [快Ｖ上昇] / [快Ａ上昇] / [快Ｂ上昇]】
	A = 100000000
ELSE
	A = UP:0 * 3 + UP:1 / 10 + UP:2 / 5 + UP:14 / 5 + UP:18
ENDIF

;自制心
IF TALENT:20 == 1	; 【[自制心]】
	A /= 2
ELSEIF TALENT:20 == 2	; 【[自制心:強]】
	TIMES A , 2.00
ENDIF

;快感に素直
SIF TALENT:70	; 【[快感に素直]】
	TIMES A , 1.20

;淫乱化
SIF TALENT:76	; 【[淫乱]】
	TIMES A , 1.10

;快感の否定
IF TALENT:71 == 1	; 【[快感の否定]】
	TIMES A , 0.80
ELSEIF TALENT:71 == 2	; 【[快感の否定:強]】
	TIMES A , 1.25
ENDIF
;媚薬
SIF TEQUIP:21	; 【[媚薬効果発揮中]使用中】
	A *= 2

;利尿剤
SIF TEQUIP:22	; 【[利尿剤効果発揮中]使用中】
	A /= 2

;淫蟲
SIF TEQUIP:92 == 1	; 【[蟲風呂プレイ]==1】
	A *= 2
	
IF TFLAG:44 && A > 0	; 【[ウフフ中]】
	A = 50 + A / 20
ELSE
	A /= 20
ENDIF
BASE:2 += A

S = BASE:2
EJAC = MAXBASE:2

IF S > EJAC * 4
	E = 4
ELSEIF S > EJAC * 2
	E = 2
ELSEIF S > EJAC
	E = 1
ELSE
	E = 0
	RETURN 0
ENDIF
TFLAG:715 = S / EJAC
SIF TFLAG:715 < 1
	TFLAG:715 = 1
;快感が強烈(連射countが大きい)なほど量が増える。通常は控えめ、極限で約60ml
A = TFLAG:715
SIF A > 26
	A = 26
A = 3 + 57 * A * A / 676
B = A / 4
C = B * 2 + 1
TFLAG:717 = A - B + RAND:C
SIF TFLAG:717 < 1
	TFLAG:717 = 1

;超大量射精
IF E == 4
	LOSEBASE:0 += 40
	LOSEBASE:1 += 200

	IF EXP:3 < EXPLV:1	; 【[射精経験]<EXPLV:1】
		SOURCE:12 += 40000
		SOURCE:13 += 20000
	ELSEIF EXP:3 < EXPLV:2	; 【[射精経験]<EXPLV:2】
		SOURCE:12 += 20000
		SOURCE:13 += 16000
	ELSEIF EXP:3 < EXPLV:3	; 【[射精経験]<EXPLV:3】
		SOURCE:12 += 14000
		SOURCE:13 += 12000
	ELSEIF EXP:3 < EXPLV:4	; 【[射精経験]<EXPLV:4】
		SOURCE:12 += 10000
		SOURCE:13 += 8000
	ELSEIF EXP:3 < EXPLV:5	; 【[射精経験]<EXPLV:5】
		SOURCE:12 += 6000
		SOURCE:13 += 4000
	ELSE
		SOURCE:12 += 3600
		SOURCE:13 += 2400
	ENDIF

	;射精経験によるLOSEBASE軽減
	IF EXP:3 >= EXPLV:4	; 【[射精経験]>=EXPLV:4】
		LOSEBASE:0 -= 20
		LOSEBASE:1 -= 100
	ELSEIF EXP:3 >= EXPLV:3	; 【[射精経験]>=EXPLV:3】
		LOSEBASE:0 -= 15
		LOSEBASE:1 -= 75
	ELSEIF EXP:3 >= EXPLV:2	; 【[射精経験]>=EXPLV:2】
		LOSEBASE:0 -= 10
		LOSEBASE:1 -= 50
	ENDIF

	PRINTS NAME:TARGET
	PRINTFORML 超大量射精×{TFLAG:715}（{TFLAG:717}ml）
	PRINTL 精液経験＋2
	PRINTL 射精経験＋4

	EXP:20 += 2
	EXP:3 += 4
	;膣射/精飲経験（2）
	IF TFLAG:703 == 1 || TFLAG:703 == 9	; 【[射精箇所]==1 / [射精箇所]==9】
		EXP:24 += 2
		PRINTL 膣射経験＋2
		;膣射経験によるSOURCEボーナス
		IF EXP:24 >= EXPLV:4	; 【[膣射経験]>=EXPLV:4】
			SOURCE:12 += 5000
		ELSEIF EXP:24 >= EXPLV:3	; 【[膣射経験]>=EXPLV:3】
			SOURCE:12 += 3000
		ELSEIF EXP:24 >= EXPLV:2	; 【[膣射経験]>=EXPLV:2】
			SOURCE:12 += 1500
		ENDIF
	ELSEIF TFLAG:703 == 4 && SELECTCOM != 32	; 【コマンド:[パイズリ]以外 / [射精箇所]==4】
		EXP:26 += 2
		PRINTL 精飲経験＋2
		;精飲経験によるSOURCEボーナス
		IF EXP:26 >= EXPLV:4	; 【[精飲経験]>=EXPLV:4】
			SOURCE:12 += 5000
		ELSEIF EXP:26 >= EXPLV:3	; 【[精飲経験]>=EXPLV:3】
			SOURCE:12 += 3000
		ELSEIF EXP:26 >= EXPLV:2	; 【[精飲経験]>=EXPLV:2】
			SOURCE:12 += 1500
		ENDIF
	ENDIF
;大量射精
ELSEIF E == 2
	LOSEBASE:0 += 20
	LOSEBASE:1 += 100

	IF EXP:3 < EXPLV:1	; 【[射精経験]<EXPLV:1】
		SOURCE:12 += 20000
		SOURCE:13 += 10000
	ELSEIF EXP:3 < EXPLV:2	; 【[射精経験]<EXPLV:2】
		SOURCE:12 += 10000
		SOURCE:13 += 8000
	ELSEIF EXP:3 < EXPLV:3	; 【[射精経験]<EXPLV:3】
		SOURCE:12 += 7000
		SOURCE:13 += 6000
	ELSEIF EXP:3 < EXPLV:4	; 【[射精経験]<EXPLV:4】
		SOURCE:12 += 5000
		SOURCE:13 += 4000
	ELSEIF EXP:3 < EXPLV:5	; 【[射精経験]<EXPLV:5】
		SOURCE:12 += 3000
		SOURCE:13 += 2000
	ELSE
		SOURCE:12 += 1800
		SOURCE:13 += 1200
	ENDIF

	;射精経験によるLOSEBASE軽減
	IF EXP:3 >= EXPLV:4	; 【[射精経験]>=EXPLV:4】
		LOSEBASE:0 -= 10
		LOSEBASE:1 -= 50
	ELSEIF EXP:3 >= EXPLV:3	; 【[射精経験]>=EXPLV:3】
		LOSEBASE:0 -= 7
		LOSEBASE:1 -= 35
	ELSEIF EXP:3 >= EXPLV:2	; 【[射精経験]>=EXPLV:2】
		LOSEBASE:0 -= 5
		LOSEBASE:1 -= 25
	ENDIF

	PRINTS NAME:TARGET
	PRINTFORML 大量射精×{TFLAG:715}（{TFLAG:717}ml）
	PRINTL 精液経験＋1
	PRINTL 射精経験＋2

	EXP:20 += 1
	EXP:3 += 2
	;膣射/精飲経験（1）
	IF TFLAG:703 == 1 || TFLAG:703 == 9	; 【[射精箇所]==1 / [射精箇所]==9】
		EXP:24 += 1
		PRINTL 膣射経験＋1
		;膣射経験によるSOURCEボーナス
		IF EXP:24 >= EXPLV:4	; 【[膣射経験]>=EXPLV:4】
			SOURCE:12 += 5000
		ELSEIF EXP:24 >= EXPLV:3	; 【[膣射経験]>=EXPLV:3】
			SOURCE:12 += 3000
		ELSEIF EXP:24 >= EXPLV:2	; 【[膣射経験]>=EXPLV:2】
			SOURCE:12 += 1500
		ENDIF
	ELSEIF TFLAG:703 == 4 && SELECTCOM != 32	; 【コマンド:[パイズリ]以外 / [射精箇所]==4】
		EXP:26 += 1
		PRINTL 精飲経験＋1
		;精飲経験によるSOURCEボーナス
		IF EXP:26 >= EXPLV:4	; 【[精飲経験]>=EXPLV:4】
			SOURCE:12 += 5000
		ELSEIF EXP:26 >= EXPLV:3	; 【[精飲経験]>=EXPLV:3】
			SOURCE:12 += 3000
		ELSEIF EXP:26 >= EXPLV:2	; 【[精飲経験]>=EXPLV:2】
			SOURCE:12 += 1500
		ENDIF
	ENDIF
;通常の射精
ELSEIF E == 1
	LOSEBASE:1 += 40

	IF EXP:3 < EXPLV:1	; 【[射精経験]<EXPLV:1】
		SOURCE:12 += 10000
		SOURCE:13 += 5000
	ELSEIF EXP:3 < EXPLV:2	; 【[射精経験]<EXPLV:2】
		SOURCE:12 += 5000
		SOURCE:13 += 4000
	ELSEIF EXP:3 < EXPLV:3	; 【[射精経験]<EXPLV:3】
		SOURCE:12 += 2500
		SOURCE:13 += 2000
	ELSEIF EXP:3 < EXPLV:4	; 【[射精経験]<EXPLV:4】
		SOURCE:12 += 1600
		SOURCE:13 += 1400
	ELSEIF EXP:3 < EXPLV:5	; 【[射精経験]<EXPLV:5】
		SOURCE:12 += 800
		SOURCE:13 += 500
	ELSE
		SOURCE:12 += 200
		SOURCE:13 += 250
	ENDIF

	;射精経験によるLOSEBASE軽減
	IF EXP:3 >= EXPLV:4	; 【[射精経験]>=EXPLV:4】
		LOSEBASE:1 -= 20
	ELSEIF EXP:3 >= EXPLV:3	; 【[射精経験]>=EXPLV:3】
		LOSEBASE:1 -= 15
	ELSEIF EXP:3 >= EXPLV:2	; 【[射精経験]>=EXPLV:2】
		LOSEBASE:1 -= 10
	ENDIF

	PRINTS NAME:TARGET
	PRINTFORML 射精×{TFLAG:715}（{TFLAG:717}ml）
	PRINTL 射精経験＋1
	EXP:3 += 1
ENDIF

;-------------------------------------------------
;フェラ（COM4/着衣380・プレイヤー本人のみ）でふたなりを射精させた時、男性プレイヤーが口で受けて喜んで精液を飲む地の文
;量(E:1通常/2大量/4超大量)×連射回数(TFLAG:715)で分岐
;-------------------------------------------------
IF (SELECTCOM == 4 || SELECTCOM == 380) && ASSIPLAY == 0	; 【コマンド:[フェラする] / 調教者:[主人]】
	IF E == 4
		IF TFLAG:715 >= 2
			PRINTFORML %CALLNAME:MASTER%は、何度も爆ぜる超大量の精液を頬を緩ませて飲んでは飲み、一滴残らず喉へ流し込んだ……
		ELSE
			PRINTFORML %CALLNAME:MASTER%は、口では受けきれぬほどの量を喜んで受け止め、白濁を滴らせながらも一心に飲み干した……
		ENDIF
	ELSEIF E == 2
		IF TFLAG:715 >= 2
			PRINTFORML %CALLNAME:MASTER%は、立て続けに溢れる大量の精液を夢中で嚥下し、零れた分まで名残惜しげに舐め取った……
		ELSE
			PRINTFORML %CALLNAME:MASTER%は、口内を満たした濃い精液を、喉を鳴らして嬉々として飲み干した……
		ENDIF
	ELSE
		IF TFLAG:715 >= 2
			PRINTFORML %CALLNAME:MASTER%は、幾度も跳ねる精液を一滴も逃さず舌で絡め取り、美味そうに飲み下した……
		ELSE
			PRINTFORML %CALLNAME:MASTER%は、口内に放たれた精液を嬉しそうに舌で受け止め、こくりと飲み下した……
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;手淫（COM30/191・プレイヤー本体のみ）でのふたなり射精時
;-------------------------------------------------
IF (SELECTCOM == 30 || SELECTCOM == 191) && ASSIPLAY == 0	; 【コマンド:[手淫] / コマンド:[手淫する] / 調教者:[主人]】
	IF E == 4
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:MASTER%の指先が限界まで擦り上げると、鈴口から溢れんばかりの白濁が勢いよく噴き上がった！
			PRINTFORML 掌から零れ落ちた熱い雫は、%CALLNAME:MASTER%の腕や服までも白く染め上げていく……
		ELSE
			PRINTFORML %CALLNAME:MASTER%の手の中で狂おしく脈打つ肉茎から、止まることのない大量の精液が激しく迸った！
			PRINTFORML 指の隙間からどくどくと熱い飛沫が溢れ出し、あたり一面に濃密な雄の匂いを立ち上らせている……
		ENDIF
	ELSEIF E == 2
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:MASTER%が手のひらで緩急をつけてしごき上げると、先端から熱い精液が勢いよく弾け飛んだ！
			PRINTFORML びくびくと跳ねる剛直を受け止めながら、%CALLNAME:MASTER%の手はねっとりとした白濁で覆われていく……
		ELSE
			PRINTFORML 達する瞬間に%CALLNAME:MASTER%が強く握り込むと、鈴口から勢いよく白濁液が放たれた！
			PRINTFORML 熱を帯びた精液が弧を描いて飛び散り、絡めた指先を濡らしながら滴り落ちていく……
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:MASTER%の手の動きに合わせて肉茎が震え、先端からとろりとした精液が吐き出された……
			PRINTFORML 吐き出された熱い雫を指先で掬い取りながら、%CALLNAME:MASTER%は静かに余韻を見届けた……
		ELSE
			PRINTFORML %CALLNAME:MASTER%が丁寧に擦り上げる手に促され、先端からぴゅっと白い飛沫が放たれた……
			PRINTFORML 掌を伝うぬくもりを感じながら、%CALLNAME:TARGET%の昂ぶりが収まるのを優しく撫でさすった……
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;アナルに入れさせる（COM204・プレイヤー本体のみ）でのふたなり射精時
;-------------------------------------------------
IF SELECTCOM == 204 && ASSIPLAY == 0	; 【コマンド:[アナルに入れさせる] / 調教者:[主人]】
	IF E >= 2
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:MASTER%の狭小な後孔を押し広げたまま、肉茎が狂おしくびくびくと跳ね回った！
			PRINTFORML 腸壁の奥深くへと熱い白濁液が容赦なく吐き出され、逃げ場のない熱量が下腹を満たしていく……
		ELSE
			PRINTFORML 結合部の奥深くで鈴口が激しく脈打ち、耐えきれないほどの大量の精液が腸内に注ぎ込まれた！
			PRINTFORML 押し寄せる熱い拍動に貫かれながら、%CALLNAME:MASTER%は下腹の奥に刻まれる確かな重みを感じていた……
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML 締め付ける後孔の奥でペニスが硬直し、びくっと震えながら熱い精液が放たれた……
			PRINTFORML 腸壁を伝う熱い感触に、%CALLNAME:MASTER%は吐息を漏らしながらその重みを受け止めた……
		ELSE
			PRINTFORML 狭い腔内を押し広げる剛直が震え、先端から注ぎ込まれた精液が奥をじんわりと温めていく……
			PRINTFORML じっくりと注ぎ込まれる感触を味わいながら、%CALLNAME:MASTER%は身を委ねて受け入れた……
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;膣に入れさせる（COM23/381等・プレイヤー本体のみ）でのふたなり射精時
;-------------------------------------------------
IF (SELECTCOM == 23 || SELECTCOM == 381 || SELECTCOM == 363 || SELECTCOM == 366) && ASSIPLAY == 0	; 【コマンド:[逆レイプ] / コマンド:[セックスさせる] / コマンド:[着衣挿入] / コマンド:[着衣騎乗位] / 調教者:[主人]】
	IF E == 4
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:MASTER%の胎内深くに突き立てられた剛直が、狂おしいほど激しく跳ね上がった！
			PRINTFORML 子宮口を直接叩きつけるように濃密な白濁がドクドクと注ぎ込まれ、結合部からも溢れ返っていく……！
		ELSE
			PRINTFORML 限界まで達した%CALLNAME:TARGET%が腰を押し付けると、奥深くへと規格外の大量精液が解き放たれた！
			PRINTFORML 胎内を満たし尽くしてなお迸る熱い命の雫に、%CALLNAME:MASTER%の下腹はずっしりとした重みに満たされた……！
		ENDIF
	ELSEIF E == 2
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:MASTER%の最奥を貫いたまま肉茎が激しく脈打ち、熱い精液が一気に吐き出された！
			PRINTFORML 膣壁を押し広げるように注ぎ込まれる大量の白濁液が、%CALLNAME:MASTER%の芯までじんじんと染み渡る……！
		ELSE
			PRINTFORML 達する瞬間に深く腰を沈められ、子宮口の前に向けて勢いよく熱い雫が放たれた！
			PRINTFORML びくびくと脈打つたびにドクドクと注ぎ込まれ、奥を白濁で満たされていく感触に息を呑んだ……！
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML 膣内で昂ぶった剛直が震え、奥深くに向けてじんわりと温かい精液が注ぎ込まれた……
			PRINTFORML 胎内へと届けられた熱い感触を受け止めながら、%CALLNAME:MASTER%は深く息をついた……
		ELSE
			PRINTFORML 最奥に密着した鈴口からぴゅっと熱い飛沫が放たれ、膣壁をじんわりと満たしていった……
			PRINTFORML 吐き出される命のぬくもりを全身で感じながら、%CALLNAME:MASTER%は静かに腰を重ね合わせていた……
		ENDIF
	ENDIF
ENDIF

;-------------------------------------------------
;助手調教時（ASSIPLAY == 1）のふたなり射精時メッセージ
;-------------------------------------------------
;フェラ系（COM4/380）
IF (SELECTCOM == 4 || SELECTCOM == 380) && ASSIPLAY == 1	; 【コマンド:[フェラする] / 調教者:[助手]】
	IF E >= 2
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:ASSI%は溢れ出る熱い雫を口いっぱいに受け止め、喉を鳴らして飲み干した……
			PRINTFORML 吐き出される熱量を残さず吸い上げ、口元を拭いながら熱い視線を返している……
		ELSE
			PRINTFORML %CALLNAME:ASSI%の口内に激しく注ぎ込まれ、溢れた飛沫が唇から伝い落ちていく……
			PRINTFORML 息を乱しながらも舌を絡め、奥まで注がれたぬくもりを受け止めている……
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:ASSI%は先端から放たれた雫を素直に受け止め、静かに飲み下した……
		ELSE
			PRINTFORML %CALLNAME:ASSI%は注がれた熱をじっくりと味わうように飲み込み、静かに息をついた……
		ENDIF
	ENDIF
ENDIF

;手淫系（COM30/191）
IF (SELECTCOM == 30 || SELECTCOM == 191) && ASSIPLAY == 1	; 【コマンド:[手淫] / コマンド:[手淫する] / 調教者:[助手]】
	IF E >= 2
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:ASSI%の手の中で激しく脈打ち、指の間から勢いよく白濁が噴き零れた！
			PRINTFORML 掌を熱く濡らす感触に、%CALLNAME:ASSI%は妖艶な吐息を漏らしながら見届けている……
		ELSE
			PRINTFORML %CALLNAME:ASSI%が緩急をつけて擦り上げると、先端から熱い飛沫が激しく弾け飛んだ！
			PRINTFORML 飛び散る白濁を受け止めながら、%CALLNAME:ASSI%の手はねっとりと白く染まっていく……
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML %CALLNAME:ASSI%の指先の動きに促され、先端からとろりと熱い雫が放たれた……
		ELSE
