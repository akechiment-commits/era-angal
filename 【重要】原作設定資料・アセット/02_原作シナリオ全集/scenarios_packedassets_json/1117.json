    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（まったくもう、ほら見たことか！　男の子ってこれだから！）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（お休みの日とはいえ、こんな時間まで寝てるなんて～。もう、お昼前だよ？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-sp-civvies",
    "pose": 0,
