    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（エプロン姿のわたしが『おはよう』って振り向くの……。うわぁい、新婚っぽい♪）"
  },
  {
    "command": "update_character",
    "id": "center",
