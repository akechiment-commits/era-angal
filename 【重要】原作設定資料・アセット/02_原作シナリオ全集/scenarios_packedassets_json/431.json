    "text": "「きょろ、きょろ」"
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「ん〜、こっちかな——あっ、ほんとにいたっ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 40,
    "dress": "old-default",
    "pose": 0,
    "active": true,
