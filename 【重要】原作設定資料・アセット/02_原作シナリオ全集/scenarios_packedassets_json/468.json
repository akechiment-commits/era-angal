    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「こんな、その、えっちな……。困るよ、よくないと思う。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「男の子が、こういうの好きなのはわかるけど」"
