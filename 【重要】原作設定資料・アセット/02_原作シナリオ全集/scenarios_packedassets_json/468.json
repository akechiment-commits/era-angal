    "text": "「ん？」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「どうしたの、わたしの顔に何かついてる？」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「顔っていうか、服？　どういうこと？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
    "expression": "old-bunny_expression/surprise",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ん、んん？」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「わたし、何でこんな服を着てるのかな。ゆ、夢？」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「こんなの、着た覚えがないんだけど。んん、寝惚けてたのかな。」"
