    "dress": "old-bunny",
    "pose": 0,
    "active": true,
    "expression": "old-bunny_expression/surprise",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「というか、もしかして転校生くんが……わたしにこの服を着せたのかな？」"
