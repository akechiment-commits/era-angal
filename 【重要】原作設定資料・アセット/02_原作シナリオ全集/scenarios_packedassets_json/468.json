    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「わたし眠たいと、よく無意識に変なことしてるみたいなんだよね。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「いちか……妹に怒られるんだ、『神さまが乗りうつったのかと思ったよ！』ってね」"
