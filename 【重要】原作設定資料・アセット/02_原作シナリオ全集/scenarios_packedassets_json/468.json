    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「えぇっと……あっ！　あった♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
