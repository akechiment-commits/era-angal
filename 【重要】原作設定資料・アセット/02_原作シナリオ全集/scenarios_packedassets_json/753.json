    "pose": 0,
    "active": false,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「けれどまぁ、両親にも『教会にばかりいないで青春を楽しみなさい』と、よくお叱りを受けますし。」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「部活なども、やるべきなのでしょうね」"
