    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「ただ、なぜか勧誘されたとき『ではその代わり、わたくしの教会で洗礼を受けてくださいますか？』」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「と聞くとみなさん、潮が引くように去っていくのでございます」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「……なぜでしょう？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 18,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/sad",
