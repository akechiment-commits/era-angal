  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「もっと他にいろいろ、楽しいこともしたほうがいいよ〜？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「まりあちゃん、体験入部とか興味ある？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「よかったら一緒にどうかな〜、なんて思ってるんだけど。」"
