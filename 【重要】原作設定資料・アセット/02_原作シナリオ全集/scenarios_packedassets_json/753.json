    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「そうですね、興味がなくはないのですよ。たまに、誘っていただけることもありますし」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 18,
