    "expression_position": {
      "x": 6,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「うん。あんた昨日ぶっ倒れたんだから、ほんとに無理はしないでおくれよ。」"
  },
  {
    "command": "update_character",
    "id": "center",
