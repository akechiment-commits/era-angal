    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「何かあったら連絡するんだよ、ばいば～い♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 55,
    "dress": "old-s-civvies",
