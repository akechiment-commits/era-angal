  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「わかった。あんまり無理はするんじゃないよ、ほとりさん」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 55,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
