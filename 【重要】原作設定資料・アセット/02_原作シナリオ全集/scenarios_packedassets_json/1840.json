    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「夢から覚めて、元の場所に、ふつうの現実に戻ってきたわけッスか。あんたも、一緒に」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 59,
    "dress": "old-neko-maid",
    "pose": 0,
    "active": false,
