  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「もっと、どうせだから色んなことをしよう？」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あんたが戻ってきたおかげッスかね、いろんなこと思いだしてきた……。」"
