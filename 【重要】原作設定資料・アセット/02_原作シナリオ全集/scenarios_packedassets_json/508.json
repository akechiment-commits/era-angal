    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「丸子さんがきてくれたら、よかったのですけどね。彼女、誰とでもすぐ打ち解けられますから」"
  },
  {
    "command": "update_character",
    "id": "right",
