    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「そのようですね。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「羽森さんは、丸子さんと親しい桐島先輩と同じく合唱部に所属しているので、」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「その繋がりのようです。みんなで、お勉強会をするのでしょうね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 37,
