    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「みさきちゃん、もうひとりのアイドル……羽森さんの、お勉強を見てあげるんだっけ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 37,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
