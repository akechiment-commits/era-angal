    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「ふはぁ緊張するなぁ、アイドルと何を喋ればいいんだろ〜？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 37,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
