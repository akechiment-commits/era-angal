  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「『旧生徒会』と『新生徒会』のどちらにも『新制服の考案』を依頼していた、学院側の不手際だと思いますぅ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
