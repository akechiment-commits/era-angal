    "pose": 0,
    "active": false,
    "expression": "old-w-new_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「そう、そこが問題でした」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「『新制服』のデザインをする必要がある、と考えた学院側……。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「教師たちが、『旧生徒会』と『新生徒会』のどちらにも同じ依頼をしていました」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「そして各々の生徒会が足並みを揃えずに動いていたことで、ちょっとした騒動に発展してしまったと。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「教師たちも含めて、いちど全体で今後の方針を見直すべきですね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「『旧生徒会』と『新生徒会』の役員もすべて招集し、」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「同じような混乱が二度と起きないように協議すべきでしょう」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-w",
    "pose": 0,
    "active": true,
