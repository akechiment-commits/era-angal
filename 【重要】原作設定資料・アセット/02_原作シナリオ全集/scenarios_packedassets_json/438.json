    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「んん、急いでるアルか？　あんたはいつも忙しそうアルね〜？」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「何か、あったアルか？」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「ふぅん？　知りあいの女の子に、メールで呼びだされたアル？」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「転校生は知りあいが多いアルね〜、羨ましいアルよ！」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「どうして女子校のなかに男子ひとり、という無茶な状況なのに知りあいが増やせるアルか〜？」"
  },
  {
    "command": "update_character",
