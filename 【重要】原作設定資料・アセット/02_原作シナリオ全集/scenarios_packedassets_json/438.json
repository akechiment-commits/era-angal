  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「ほんとに何があったアルか〜っ、きな臭いにおいがプンプンするね！」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「こりゃあ、たしかに急がなきゃ駄目アルね！」"
