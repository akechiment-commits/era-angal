    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「たまにお手伝いしてるアルよ〜？　よかったら何か食べてくといいアルね♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 48,
