  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「はい、そのはずです。無駄にお金をかけますよね、相変わらず」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「おそらく、転校生さんもあそこに囚われているはずです。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「まったく、転校生さんを救出すれば特別ボーナス云々と言っておりましたが」"
  },
  {
    "command": "update_character",
    "id": "left",
