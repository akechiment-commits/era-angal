    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「明後日に一緒に行く子たちのなかには、君とデートだ～って思ってる子がいるかもだし？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-goth",
    "pose": 0,
    "active": true,
