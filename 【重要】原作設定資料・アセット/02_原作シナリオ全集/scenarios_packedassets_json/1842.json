    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「ゆきちゃんがね、くれたの。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「ほら、わたしいつもゆきちゃんのためにゴスロリ仕立ててるじゃない。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「そのお礼だってさ、せっかくだから着てみたの」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「さすがに、これで町中を歩く勇気はないけど……。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「まぁ君にならね、見られてもいいし。」"
