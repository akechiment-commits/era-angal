  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-goth",
    "pose": 0,
    "active": true,
    "expression": "old-goth_expression/angry",
    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あっ、感想はいらないから。どうせ、わたしの体格だとこういうのは似合わないですよ～だ」"
