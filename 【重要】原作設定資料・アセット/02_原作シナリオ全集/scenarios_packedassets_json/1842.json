    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「いいから、起きて～！　のしかかっちゃうぞ～っ、口から内臓をゲロってしまうがいい！」"
