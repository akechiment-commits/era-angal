  {
    "command": "update_character",
    "id": "center",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/joyful",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「あんたはほんと他人の気持ちを怖いぐらいに読み解くね～、ちょうど血が滾ってたところだわさっ☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「いいよ、湖南ちゃんたちを『どさくさ』まぎれに逃がしてやればいいんでしょ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/joyful",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「にゃはは、言われなくてもそうするつもりだったわさ♪」"
