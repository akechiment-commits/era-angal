  {
    "command": "update_character",
    "id": "center",
    "character": 61,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
    "expression_position": {
      "x": -30,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「湖南ちゃんなら、脱出経路ぐらい確保してるとは思うけどね～？」"
