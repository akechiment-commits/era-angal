    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「そ、そんなことはありません！　はやてさんは、今日も最高にかっこよくてかわいいです！」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「駄目なところも含めて、宇宙でいちばん愛おしいです……☆」"
