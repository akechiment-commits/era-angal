    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「うにゅ……？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「はう!?　いけない、あんまり騒いだら起こしちゃいますぅ！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「せっかく気持ちよさそうに寝てるのに〜、どうもお疲れのようですし？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「はやてさん、体育委員長ですもんね。『懇親会』で、新入生のお世話を焼いて走り回ってたんですよね。」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「さすがに体力の限界で、空き教室で休んでるうちに寝ちゃったと」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「わかりますぅ、ううん知ってますよぅ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「わたしにも立場ができちゃった、以前ほど『いつでも見ている』ことはできませんけど」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「わたしも、もう夢物語をキャーキャー言いながら楽しめる子供じゃない。三年生に、大人になりました。」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「『正義の味方』に、中のひとがいるって知ってます」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「ただ見ていることしかできなかった、以前とちがって……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「わたしはもうヒーローを演じる俳優さんを、舞台袖で眺めているだけの脚本家じゃない」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「はやてさんの、そばにいます。この現実に、同じ世界に」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「一生懸命、背伸びして、もう俯かずに前を見て歩き始めました」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「横に並んで、たまに目配せをして、できれば手を繋いで……。歩いていきましょう、これから先も。」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「お互いに、ひとりの人間として」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「わたしたちは女の子どうしだから、いつか見た夢みたいに結婚はできないけど」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「『正義の味方のはやてさん』は、わたしの心のなかで……。物語のなかで、いつまでも輝いてます」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「そんなはやてさんは、わたしが独り占め。永遠に、添い遂げます。誓います、生涯ずっと愛しつづけます。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「だから、はやてさん……はやてさんも自分自身の人生を」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「こんなふうに、疲れて眠りこけちゃうほど無理しなくてもいいから。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「たまにはヒーローの仮面を脱いで、はやてさん自身を甘やかしてあげてくださいね」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「愛してあげてくださいね。わたしも、そのために努力をしていますから」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「わたしみたいな下手くそな物書きがつくりあげた偶像に、押しこめてしまうには、もったいないぐらい……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「はやてさんは、すてきな女の子なんですから」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「じゃあ、わたし……。行きますね、お仕事がありますから」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
