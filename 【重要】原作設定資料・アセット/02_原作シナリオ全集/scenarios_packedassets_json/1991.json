    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「ごめん、困らせちゃって……。ほんと、グダグダでごめんね。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あたしゃ、もっと器用なやつのはずなのに。近ごろちっとも、ぜんぜん駄目だよ〜……？」"
