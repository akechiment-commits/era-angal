  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「……ほぇえ？　えっ、何ですかこれ？　はやてさん、ですよね？」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「どうして、誰もいない教室のなかに……。ていうか、なぜ着ぐるみ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-rabbit",
    "pose": 0,
    "active": true,
