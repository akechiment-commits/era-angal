    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「すう、すう……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「はやてさん、寝てますね……。んもう、何ですかこれ？　責任者をだしてください！」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「ふあぁああ……♪　いつも格好つけて、気障な言動ばっかりしてるのに！」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「無警戒な、赤ちゃんみたいな寝顔ををぉおおおお!?」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「やだぁああ！　かわいい！　気ぃ抜きすぎですよぉおお、誰が見てるかわかんないのに！」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「　『正義の味方』の自覚をもってくださいよぉ、んもうんもう！」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「はやてしゃ……はやてさん、はやてさぁああん♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-rabbit",
