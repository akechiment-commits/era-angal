  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「マイペースなところも変わんね〜な、長町。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「年度が切り替わったばっかりだしなぁ……そんなに人間、急に変わったりはしね〜か？」"
