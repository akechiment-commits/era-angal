    "expression_position": {
      "x": 0,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「そ〜だな。おまえが何で着ぐるみなのかとか、気になってるやつもいるだろうし。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「……つうか比較的どうでもいいけど、『夜霧先輩』じゃなくて『部長』って呼べよ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あたしゃ気にしね〜けどよ、周りがうるせ〜んだよ……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
