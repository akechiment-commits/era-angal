    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「だからこそお別れが寂しいけど」"
