    "pose": 0,
    "active": true,
    "expression": "old-w_expression/angry",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「むう、下僕くんは『おんぶ』が大好きだなあ。」"
