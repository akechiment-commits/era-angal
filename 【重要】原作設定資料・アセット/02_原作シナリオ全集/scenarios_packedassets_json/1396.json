    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「それが下僕くんの趣味なら、せえとかいちょおは尊重します。」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「存分に運ぶがいいのだあ、どうせもうすぐ私の家に到着するし」"
