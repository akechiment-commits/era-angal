  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「おまえがもし、むかし私がした『お願い』を律儀に守って、誰かを手助けして回ってるなら……」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「もう充分だ、『下僕くん』はお役御免なのだあ。今日かぎりで、おまえはクビです」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「私はもう、大丈夫。とても、幸せなのだあ。」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「毎日が夢みたいだ、私の夢をおまえが叶えてくれた。満ち足りている、」"
