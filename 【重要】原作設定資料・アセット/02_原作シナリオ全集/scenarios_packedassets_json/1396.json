    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「気がつけば誰か『おんぶ』してるもんなあ、あと荷物を運んだりとか……。仕方ないなあ？」"
