    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「明日以降も、大忙しですね……♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 1,
    "dress": "old-w",
    "pose": 0,
    "active": true,
