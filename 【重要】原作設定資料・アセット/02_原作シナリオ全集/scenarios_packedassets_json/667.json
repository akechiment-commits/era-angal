    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……つゆりちゃんとも、昔はもう少し、距離が近かったんだけどなぁ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「一年生のときも同じクラスで、仲良くしてたんだよ？」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「つゆりちゃんの体調がいいときには、一緒に遊びに行ったりもした」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「つゆりちゃんが世界に一人ぼっちでも、傍にいてあげたいと思った」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「でも、部活が忙しくなってからは、そういう機会も減っちゃったかも」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……いつの間にか、つゆりちゃんの周りには、いろんな人がいるようになって」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……それは嬉しいことだけど、複雑でもあるんだ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「今のつゆりちゃんには星海さんもいるし、」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「夢路さんも曽根先輩もいて、」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……ちょっと気に入らなくはあるけど、転校生もいるし」"
  },
  {
    "command": "update_character",
