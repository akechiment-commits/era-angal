    "text": "「……困る」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「たしかに、ゴミ袋は重いし、男手は必要かもしれないけど」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「わたし、転校生のこと苦手だし」"
