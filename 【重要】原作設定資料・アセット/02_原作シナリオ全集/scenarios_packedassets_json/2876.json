    "pose": "2",
    "expression": "default_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "あなたになら、できる。たまたま出会ったおかしな先輩や、他にもいっぱいいっぱい……いろんなひとに、あったかい気持ちを振りまいていた、あなたになら"
