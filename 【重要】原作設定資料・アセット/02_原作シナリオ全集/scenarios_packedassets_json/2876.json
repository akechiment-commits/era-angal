  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "default",
    "pose": "2",
    "expression": "default_expression/honest",
    "expression_position": {
      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "きっとできる。信じてる、わたしだけは"
