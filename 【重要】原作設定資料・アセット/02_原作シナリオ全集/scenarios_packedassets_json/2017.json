    "active": true
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "（部長も、わりと料理研の活動に参加してくれるようになったし。ギャフンと言わせたくて、たくさん料理つくっちゃって）"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
