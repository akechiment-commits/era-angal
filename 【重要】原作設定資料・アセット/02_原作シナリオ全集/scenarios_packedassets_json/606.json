    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「暗い海の底から、ただ見てるだけなのは、もうやめましたから。だから……」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
