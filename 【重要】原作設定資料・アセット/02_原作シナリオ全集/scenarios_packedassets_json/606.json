  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「先輩は、あったかいです」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-goth-loli",
    "pose": 0,
    "active": true,
