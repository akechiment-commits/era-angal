  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-goth-loli",
    "pose": 0,
    "active": true,
    "expression": "old-goth-loli_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「だけど、今はきっと言えます。手を繋げます、踊ることだってできちゃいます。」"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「そんなふうに、ゆっくりでも気持ちを伝えます。先輩の心に、触れてみせます」"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「好きです、先輩。大好きです。そばに、いさせてください。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
