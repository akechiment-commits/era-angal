    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「う、うう。終わりです、がんばりました。」"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「も、もう無理。わけわかんなくなってきた！」"
  },
