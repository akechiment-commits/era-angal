    "pose": 0,
    "active": true,
    "expression": "old-snow_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「せめて装飾とか凝っちゃお、あの地底湖になぜか咲いてた氷の桜を再現～♪」"
  },
  {
    "command": "update_character",
    "id": "right",
