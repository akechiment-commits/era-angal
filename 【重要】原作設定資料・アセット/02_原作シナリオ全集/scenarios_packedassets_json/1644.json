    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「えひゃいへひゅの、おひゅひゃれひゃま♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
