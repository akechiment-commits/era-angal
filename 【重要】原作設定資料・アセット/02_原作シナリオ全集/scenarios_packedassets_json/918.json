    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「あっ、フラミンゴ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「フラミンゴ……♪　かわいいです、なぜ片足で立っているのでしょう？」"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「疲れないのでしょうか？　わたし気になります！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/surprise",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「うあっ!?」"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「あ、ああっ……。びっくりしました。このへん、水鳥のコーナーなのですね。」"
