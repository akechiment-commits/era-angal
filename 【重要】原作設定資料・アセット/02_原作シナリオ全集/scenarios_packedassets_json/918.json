    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/amazed",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「湿地帯を再現しているのでしょうか、足下がぬかるんでいるようです」"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「危うく、転びそうになってしまいました。失敬、失敬……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「支えてくれて助かりました、転校生さん♪」"
