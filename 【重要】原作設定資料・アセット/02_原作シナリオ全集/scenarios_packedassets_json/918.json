  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/amazed",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「何ですか、その目は。『やはり保護者が必要だな』という目ですね、わかりますよ。」"
