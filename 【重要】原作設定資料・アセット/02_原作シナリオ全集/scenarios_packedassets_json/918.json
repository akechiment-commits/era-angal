    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/surprise",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「おや？　水鳥たちの群れのなかに、おかしな生き物がいるような？」"
