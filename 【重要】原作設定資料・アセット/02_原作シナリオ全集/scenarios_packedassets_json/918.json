  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "「侮らないでください、美術部の観察眼を……☆」"
