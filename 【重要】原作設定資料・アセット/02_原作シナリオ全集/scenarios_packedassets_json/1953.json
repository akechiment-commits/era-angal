  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あはは。ほんとに大変だったんだね、お疲れさま。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「傍から聞いてるぶんには、部活の仲間とあちこち小旅行……。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「って感じで、楽しそうですらあったんだけど」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「転校生くん、お土産とかやたら買ってくるし。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「仕事とかだったんなら、観光地を巡ったりはできなかったんだろうけど。」"
