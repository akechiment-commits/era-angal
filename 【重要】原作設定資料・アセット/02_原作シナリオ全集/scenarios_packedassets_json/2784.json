  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "見守って、わたしがまたウジウジ悩んでたら背中を叩いて『大丈夫だよ』って励ましてくださいね。会長さん……♪"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "new",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": -14,
      "y": 470
