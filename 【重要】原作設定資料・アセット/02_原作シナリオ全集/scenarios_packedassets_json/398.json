  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「部長ったら、急に『遊びに行っていい？』だなんて……。いつも、いきなりなんですから」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「夏休みだから、だらしなくしちゃってましたけど。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
