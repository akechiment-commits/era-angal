    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「でも部長、いったい何の用なんでしょう……？」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「『夏休みは新聞部の活動はお休み』って言われたから、小説とか書いてたのに」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「それは部長も知ってるはずだから、もしかして読んでくれるつもり……でしょうか？」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「部長、わたしが書いた原稿はぜんぶ見せなさいっていつも言ってますし」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
