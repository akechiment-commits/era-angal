    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「そんなひとに原稿を見てもらえるなんて、わたしラッキーかも……？」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「部長がくる前に、もうちょっと原稿を見直そっと。」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「まだ自信ないとこがいくつもあるんですぅ、やっぱり自分の想像だけじゃ限界があるんでしょうか。」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「部長、情報収集とか得意だから、頼っちゃおっかな……？」"
  },
