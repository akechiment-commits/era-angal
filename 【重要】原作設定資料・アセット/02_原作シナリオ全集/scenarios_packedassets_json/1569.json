    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あはは。君のお腹の虫が鳴いてるよ♪　おいしそうなにおいを嗅ぐと、急にお腹が空いてくるよね～？」"
  },
  {
    "command": "update_character",
