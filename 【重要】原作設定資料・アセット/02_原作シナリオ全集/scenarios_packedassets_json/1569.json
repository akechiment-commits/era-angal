    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あっ、あんずお姉ちゃんが来てくれたみたい。さすがに時間、かけすぎちゃったかな」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「んん……香辛料のにおいだ。夏野菜カレーかな？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-s-child",
    "pose": 0,
    "active": true,
    "expression": "old-s-child_expression/joyful",
    "expression_position": {
      "x": -6,
