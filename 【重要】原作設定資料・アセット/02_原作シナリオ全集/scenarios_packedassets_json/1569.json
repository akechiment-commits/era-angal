    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「夏は、わたしの季節なんだ……♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-s-child",
    "pose": 0,
    "active": true,
