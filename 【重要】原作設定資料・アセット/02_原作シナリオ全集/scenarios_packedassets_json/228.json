    "pose": 0,
    "active": false,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「しおんさんだけだよ、あたしがこういう発言をしたとき」"
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「『いや、あなたは若いよ。まだ高校生だよ』とか言わないのはさ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 55,
    "dress": "old-w",
    "pose": 0,
    "active": false,
