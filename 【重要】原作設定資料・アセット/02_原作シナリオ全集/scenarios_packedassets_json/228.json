    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「しおんさんも一緒にやるかい、テニス？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 55,
    "dress": "old-w",
    "pose": 0,
    "active": false,
    "expression": "old-w_expression/normal",
