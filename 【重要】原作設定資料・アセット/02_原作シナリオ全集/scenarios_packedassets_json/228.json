    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「『何でもない』ことはないだろう。私の前では、格好つける必要はないよ？」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「よければ相談に乗ろうじゃないか。またぞろ、何か厄介事かい？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 55,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 6,
      "y": 518
    }
  },
  {
