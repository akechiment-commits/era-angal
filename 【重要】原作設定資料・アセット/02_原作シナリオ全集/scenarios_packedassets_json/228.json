    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「その節は、しおんさんにお世話になったねぇ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 55,
    "dress": "old-w",
