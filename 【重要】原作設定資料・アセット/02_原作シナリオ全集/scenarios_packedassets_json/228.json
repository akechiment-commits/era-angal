    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「老成するのは、悪いことじゃないさ。」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「どうもみんな、歳をとることをマイナスと捉えがちだけどね。人間も果実も、成熟すると味が深まるものだよ？」"
  },
  {
    "command": "update_character",
