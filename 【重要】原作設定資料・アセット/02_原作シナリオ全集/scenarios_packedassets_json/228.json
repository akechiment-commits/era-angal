    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「しおんさんと喋ってると、落ちつくねぇ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 55,
    "dress": "old-w",
