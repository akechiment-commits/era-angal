    "pose": "1",
    "expression": "default_expression/sad2",
    "expression_position": {
      "x": 4,
      "y": 478
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（だけど、わたしは……。完璧でないわたしを愛せない。インターネットの外で生きられない。臆病で、小賢しいだけの存在だから）"
  },
  {
