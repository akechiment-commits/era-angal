    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（あぁもうっ、あたしの馬鹿！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（お姉ちゃんに『たまにはあたしがお弁当つくるよ！』って見得を切ったのに、ふつうに寝坊しちゃうなんて——）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（と、とりあえず材料は学校にもってきたから、何とか今からでもつくってみよう。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（さいあく、授業はサボってもいいや！　待っててねお姉ちゃん、あたしがんばるからね！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「うわぁ、家庭科室って授業以外では初めて入ったけど——広すぎて落ちつかないなぁ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「でも料理道具はひととおり揃ってるよね、お鍋と、お玉と、俎板と……」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「あ、あれ？」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「火が点かない……？　あ、そっかガスコンロの元栓が——って何か安全装置みたいなのついてる！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「暗証番号を入力しないと火が使えない……？　何このセキュリティ!?」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「うわ、包丁もきちんと錠前と鎖で封印されてる！」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「危険なものは部外者が勝手に使えないようにされてるんだ、あぁあ——どうしよう？」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「っていうか、その前に——材料はもってきたのにレシピを忘れたーっ!?」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ふだん料理なんてしないから、どうすればいいかわかんないよ！」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（あぁ、あたしって何でいつもこうなんだろう——お姉ちゃんに手伝ってもらわないと何にもできないのかなぁ？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/angry",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ううん、落ちこんでちゃだめだ！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「とりあえず食材は手でちぎるか、剣道部にたしか本物の日本刀があったからそれで切ろう！」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「ガスコンロが使えなくても、火がいらない料理にすればいいんだし！」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「お姉ちゃん——あたし、がんばるよ！」"
  }
]