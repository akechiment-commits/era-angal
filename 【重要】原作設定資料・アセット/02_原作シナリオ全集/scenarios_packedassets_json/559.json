    }
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「つゆちゃんがおらんかったら、どうしたらえぇかわからへんよ」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「怖い……。うちのお母やんも、最期まで元気そうやってん。」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「お見舞いにいったうちに『また明日ね』言うて、笑顔で頭を撫でてくれたんよ」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「でもその日のうちに、二度と会えへんようになったんよ。動かなくなって、冷たくなって……」"
