    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「旧校舎は足場がよくないから、何の準備もなくお遊び半分でくると怪我しちゃうの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
