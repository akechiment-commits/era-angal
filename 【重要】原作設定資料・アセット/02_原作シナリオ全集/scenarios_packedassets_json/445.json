  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「まぁメリメロは大人気のアイドルですからね、忙しいのでしょう。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「ライブとかのチケットも、毎回即座に完売ですし」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「君咲学院はけっこう校則とかゆるいから、ほとんど登校しなくても卒業できるかも〜っ、」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「てことで在籍したのかもしれませんし。わずかな学校生活を、楽しんでほしいですの。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「学校でまで、アイドル扱いされたくないかもしれませんしね」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「空気読めないファンが押しかけて、あの子たちの青春を台無しにしてはいけませんわよね」"
  },
