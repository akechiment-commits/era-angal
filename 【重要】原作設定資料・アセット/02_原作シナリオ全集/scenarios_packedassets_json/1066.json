  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "「そうだね。転校生くんには、話してもいいかな」"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "「わたし、あまり喋らないほうだけど。君はもっと無口だから」"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "「この話で、少しは間が保てばいいんだけど」"
