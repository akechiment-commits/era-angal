    "expression_position": {
      "x": 6,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "「うん？　なんで、過去形なのか……って？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 56,
    "dress": "old-default",
