    "expression_position": {
      "x": 6,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「でも、あたしはグッタリ疲れちゃったしなぁ。先に休ませてもらうわよ～♪」"
