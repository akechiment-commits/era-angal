    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（落ちつこう。冷静に、これまでの経緯を思いだそう……）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（龍泉寺さんに協力して、オカ研のひとたちに桜の根元を掘るのをやめさせよう、って話になって）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（転校生くんにも、お手伝いしてもらったんだよね）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（オカ研のひとたち、人手を集めるために一時的に離れてたみたいだから、）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（その隙にみんなで先に桜の根元を堀ったんだよ）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（そして、わたしと転校生くんは棺桶みたいなのに収納されて、堀った穴のなかに埋められたんだ）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（わたしは今、地中に埋められた、棺桶のなかにいる）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（転校生くんと、いっしょに）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（戻ってきたオカ研のひとたちが桜の根元を掘ったら、わたしたちがでてくる。）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（その前に、わたしは美術部に借りたこの、屍体っぽいマスクをかぶる）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/amazed",
    "expression_position": {
