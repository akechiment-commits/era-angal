  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「はあっ、息が白い！」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「陽が沈むと、だいぶ冷えるなぁ……」"
  },
  {
    "command": "update_character",
