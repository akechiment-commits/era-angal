    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「うん。あの子は、待たせない子。雨で、もろもろの悪意で冷え切ったわたしたちを……。」"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「すこしでも早く、長く、あっためてくれる子」"
