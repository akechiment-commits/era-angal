    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「どれだけ禁止されても討伐されても、海賊たちがお宝を求めて海原に漕ぎだしたみたいにね！」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
