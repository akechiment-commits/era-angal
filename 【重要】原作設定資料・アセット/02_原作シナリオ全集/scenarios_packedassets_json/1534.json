    }
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「それじゃあ、ね。急いで行ってあげて、ダッシュダッシュ♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 5,
