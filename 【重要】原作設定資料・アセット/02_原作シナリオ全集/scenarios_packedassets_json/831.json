  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「しょんぼりしてたから、心配だったっすよ！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「『駅伝大会』のとき、こまっち先輩は初めてやる気をだしてた！　でも、負けちゃったっす！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「だから、『一生懸命にやること』に臆病になってたらどうしようって……。」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「バスケとか、ぜんぶ、やる気なくなってたらどうしようって！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「嫌になって、やめちゃったらどうしようって……」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「あたしが心配してたのは、それだけっす！　こまっち先輩は、あたしの目標っす！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「その目標が消えちゃったら、どうしたらいいかわからないっすよ～！」"
