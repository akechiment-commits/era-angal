    "expression_position": {
      "x": -24,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「こまっち先輩には、いつでも自由でいてほしいっす！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「あたしや、バスケ部のことなんか気にしなくてもいいっす！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「こまっち先輩は、ぜったいに信頼を裏切らない！　いてほしいときには、必ずいてくれる！」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「あたし、それを知ってるっす！　ううん信じてるっすから！」"
  },
  {
