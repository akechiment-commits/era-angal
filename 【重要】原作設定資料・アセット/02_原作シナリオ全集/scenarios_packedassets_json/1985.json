    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "（近ごろ生徒会のお仕事が忙しそうで、先輩はあんまり保健委員会には顔だしてくれませんし？　）"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "（寂しいです〜、わたしたちの先輩なのに〜？）"
