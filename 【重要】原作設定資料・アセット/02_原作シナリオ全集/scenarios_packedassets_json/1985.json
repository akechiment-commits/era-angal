  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "（あそこのベンチに座ってるのって、転校生の先輩？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "（ふふん、わたしの目は誤魔化せませんよ！　先輩、ひとりだけ学ランですしね〜♪）"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "（後ろからこっそり近づいて、『せ〜んぱい♪』って抱きついて驚かせちゃいましょうかね〜？）"
