    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「ん～。でも、どうやったら取り返せるんだろうね？」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「風紀委員長の、弱点を知ってるひととか、いたらいいんだけど」"
