  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「湖南先輩だって、同じ立場ならそうするでしょう？　賢いひとですもんねぇ、尊敬してるんですよ～？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 44,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 4,
