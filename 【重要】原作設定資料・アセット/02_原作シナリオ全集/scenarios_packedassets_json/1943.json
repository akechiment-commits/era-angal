    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「これが利口なやりかたです、大人の判断ですよねぇ♪」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 44,
    "dress": "old-w",
    "pose": 0,
    "active": true,
