    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしなんか、汚れのかたまりみたいで……。不安と、憎悪と、苛立ちが凝り固まって。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんに出会うまでは、楽しいことなんてひとつもなかったわよ」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「そんなあたしから汚れをぜんぶ落としたら、あとには何も残らない。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「そう思ってたのに、さくらさんとの絆は残ったのよ」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「汚れだけで、悪いものだけで構成されてたはずだったのに。」"
