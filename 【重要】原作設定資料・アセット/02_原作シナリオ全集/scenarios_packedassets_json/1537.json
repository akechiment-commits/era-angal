    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「眼鏡は関係ないでしょ、さくらさんは頭良いわよ。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしが同じ大学に合格するために、どんだけ苦労したかわかってんの？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
