  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ありがとう、あたしの友達でいてくれて。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「誰も信じられない汚れきった野良犬みたいだったあたしを、」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんだけが時間をかけて綺麗にしようとしてくれたのよ」"
