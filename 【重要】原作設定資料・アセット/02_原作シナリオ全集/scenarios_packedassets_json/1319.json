  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ともあれ。転校生さんは起きているようですから、代わりにお手伝いをしてもらいましょうか。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「来年からはわたしたち二年生が、最上級生ですからね。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「いつまでも三年生の先輩方に頼っているようでは、いけません」"
  },
