  {
    "command": "update_character",
    "id": "center",
    "character": 68,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/sad",
    "expression_position": {
      "x": -12,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "むつみ",
    "text": "「それがですね、話が前後しちゃいますけど。」"
  },
  {
    "command": "talk",
    "speaker": "むつみ",
    "text": "「ピヨちゃん、波止場で失神しちゃったの覚えてます？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「あっ、はい。そのようですね……。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「転校生さんに押しつぶされちゃって、意識を失っちゃったみたい？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 68,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/sad",
    "expression_position": {
      "x": -12,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "むつみ",
    "text": "「ええ。あっしが、ふたりが『けいどろ』の追っ手なんじゃないかって勘違いして……。」"
