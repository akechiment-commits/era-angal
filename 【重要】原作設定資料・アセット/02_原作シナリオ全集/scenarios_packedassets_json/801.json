    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ううん。あたし、ぜんぜん平気。健康で元気。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 65,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
    "expression": "old-mizugi_expression/sad",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「だって。ここまで無理したのは相方の……大虎さんの、ほうだもん」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「大虎さんのほうが、無理してくれたのに」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ごめんね。最後にブルっちゃって、情けないよ。」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「大虎さん、がんばってくれたのに。素人なりに、全力を尽くしてくれたのに」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あたしはプロなのに、アイドルなのに」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「本番でこんな、役立たずになっちゃうなんて……」"
  },
  {
    "command": "update_character",
    "id": "right",
