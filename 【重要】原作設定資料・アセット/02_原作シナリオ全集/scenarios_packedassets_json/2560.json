  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（せっかく、みんな揃って『雛祭り』に参加できるのに。一秒でも長く、るりちゃん部長と楽しく過ごしたいはずやのに。うちのせいで、時間を無駄にさせてまう）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
    "dress": "winter-civvies2",
    "pose": "2",
