    "pose": "2",
    "expression": "winter-civvies2_expression/sad2",
    "expression_position": {
      "x": 0,
      "y": 456
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（恩返し、したかったのに。卒業してまう前に、ちょっとだけでも）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
    "dress": "winter-civvies2",
    "pose": "1",
    "expression": "winter-civvies2_expression/sad2",
    "expression_position": {
      "x": 0,
      "y": 456
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（情けないわぁ。うち、ほんまに自分だけやと何もでけへん。近ごろ友達が増えたりして、順調やったから……。自分が『たいしたもん』やと、誤解してたけど）"
