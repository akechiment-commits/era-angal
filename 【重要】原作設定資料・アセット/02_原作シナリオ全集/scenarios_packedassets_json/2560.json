  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（ごめんなぁ、月ちゃん先輩。うち、月ちゃん先輩にはずっとお世話になってたから）"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（うちが君咲学院で、友達おらんくても寂しくなかったんは月ちゃん先輩のお陰やから）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
