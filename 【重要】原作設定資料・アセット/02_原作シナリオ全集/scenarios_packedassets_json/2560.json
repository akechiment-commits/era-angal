    "active": true
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（友達百人つくって、お山のてっぺんで、おにぎりを食べるねん。ほいで天国にも聞こえるぐらい、おおきな声で笑うんよ）"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "（そしたら、お母やんも安心できるやろ。ううん、うちもお母やんが願ってくれたとおりに……。幸せに生きられる気ぃするんよ、愛して愛されて）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
