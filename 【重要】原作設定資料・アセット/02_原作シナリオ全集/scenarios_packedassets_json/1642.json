    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「味覚が回復したら、みんなと一緒に料理店巡りするんだっ♪」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「その日を楽しみにして、今はひたすら我慢の子だぞっ♪」"
