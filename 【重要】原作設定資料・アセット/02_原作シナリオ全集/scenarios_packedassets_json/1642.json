    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「だけど料理は火力だぞ、ダディもそう言ってた！　がうがう～♪」"
