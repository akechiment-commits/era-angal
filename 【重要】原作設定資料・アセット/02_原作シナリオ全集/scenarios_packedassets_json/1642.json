    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「料理店で食べると、お金がかかるし。おいらは一族の掟で、お小遣いをもらえないんだ」"
