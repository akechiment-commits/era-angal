  {
    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「おいらも一緒に行きたかったんだけど、おいら味わかんないから。」"
