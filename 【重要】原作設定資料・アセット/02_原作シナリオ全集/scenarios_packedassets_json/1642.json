    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「時間とお金を無駄にするぐらいだったら、おいらは料理の技術を磨く！」"
