  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「がう～☆」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「がうがう、きゅんきゅん♪　がう、きゅんきゅう～ん♪」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「がう～、料理って楽しい！　狩りも楽しいけど、料理も大好き！」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「チッチのおかげだな！」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「閣下は渋ってたけど、無事に料理研で活動できるようになった！　毎日、すっごく楽しいぞっ♪」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「まだ、レシピどおりにしかつくれないけど～？　お医者さんの話だと、そのうち味覚も回復するはずだしっ♪」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「そしたら味がわかるようになって、自分で考えた料理もつくれる！」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「チッチみたいに、閣下にも食べられる料理をつくれるかも～♪」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「その日のために、今はひたすら技術を磨くぞ！」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「基本は大事だ、応用はそのあと！　閣下もそう言ってた、がうがう～♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「おっと、焦げちゃう？　がう～、味覚と一緒に鼻もきかなくなってる気がする？」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「焦げたにおいがわからなかったぞ、家庭科室を火事にするところだった！」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「閣下に怒られる、料理研を追いだされる！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「気をつけないとっ、チッチのおかげで手に入れた居場所！」"
