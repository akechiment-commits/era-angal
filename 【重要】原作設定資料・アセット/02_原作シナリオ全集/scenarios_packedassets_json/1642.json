    "active": true,
    "expression": "old-default_expression/angry",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「がうっ、気配がする！　誰だっ、家庭科室は料理研の縄張りだぞ！　勝手に入っちゃ……」"
