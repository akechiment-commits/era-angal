    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「ううん、都会の文化に慣れないと。おいら、ちゃんと真人間にならなくちゃ」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「いつまでもジャングルにいる気分じゃ駄目だ、生きていけないぞ～。」"
