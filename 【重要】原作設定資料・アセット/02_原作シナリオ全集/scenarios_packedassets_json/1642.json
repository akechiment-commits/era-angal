    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「家庭科室に、何の用だ？」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「チッチならいないぞ、閣下と一緒にチッチのグランマ（祖母）のお店に行ってるんだぞ～？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「閣下はチッチを気に入ったらしくて、つれまわしてるんだっ♪」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「よく、一緒に料理店を巡ってるぞ！」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「今日はそのお礼ってことで、チッチが閣下を自分のグランマのお店に招いたみたい♪」"
