  {
    "command": "update_character",
    "id": "center",
    "character": 70,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「だからこそ、おいらは大好きなチッチに迷惑かけたくないぞ」"
