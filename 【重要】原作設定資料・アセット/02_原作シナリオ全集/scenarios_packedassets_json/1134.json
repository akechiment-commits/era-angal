  {
    "command": "talk",
    "speaker": "かな",
    "text": "「あたしが勉強がんばってるの、テストの結果として報告すれば、」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「ふたりとも安心して誕生日だけでもたっぷり甘やかしてくれるかもしれないのに～！」"
