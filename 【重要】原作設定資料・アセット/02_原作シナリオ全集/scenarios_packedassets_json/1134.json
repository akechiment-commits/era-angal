  {
    "command": "talk",
    "speaker": "かな",
    "text": "（もうっ！　うちの学校の教師は怠慢だわ！　定期考査の結果発表が遅れに遅れてるじゃない！）"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（今回はちょっと学園内がドタバタしてたせいだとか言い訳してっ、）"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（ふだんまともに働いてないんだから仕事ぐらいきちんとしなさいよね！）"
  },
  {
    "command": "update_character",
    "id": "center",
