    }
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（――まぁ、今回はちょっと自信あるけど！）"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（たぶん予想では、二学年のなかでは五位ぐらい、Ｂ組のなかでは一位ってとこかしら）"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（――ふふん、まぁＢ組は勉強できない子が多いから、一位なのは当然だけど！）"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（問題なのは二学年のなかでの順位よ、たまには二学年トップになりたいわね）"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（――今回は手応えがあったし、あながち夢じゃないかもしれないわ！）"
  },
  {
    "command": "update_character",
    "id": "center",
