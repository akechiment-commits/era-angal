    }
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（もう我慢できない、ちょくせつ職員室に乗りこんで自分の点数だけでも聞いてみよう）"
  },
  {
    "command": "update_character",
    "id": "center",
