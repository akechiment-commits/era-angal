    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「お願いだから。もう、あたしを待たないで。あたしのために足踏みして、人生を歪めないで。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「そんなの、また『自惚れないで』って言われるかもしれないけど」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ちょっとずつでも。一生かかっても、きっと追いつくから」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「『待ってて』なんて言わない、『仲直りしよう』とも言えない。今は、まだ。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしにはその資格がない、でもきっといつか」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「昔みたいに、今こうしてるみたいに……。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あんたの横に並ぶから、いちばん近くで一緒に星が見たいから」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしは諦めないから。あんたも、あたしが諦めないことを忘れないで」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「それだけ、伝えたかった」"
