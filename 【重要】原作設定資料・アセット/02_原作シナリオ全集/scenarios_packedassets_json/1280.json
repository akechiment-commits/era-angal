  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「相変わらず、お喋りは苦手ッスか。すっごく頭いいはずなのにね、あんたは」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしもそうだった、口を動かすより走り回るほうが好きだった。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「だから友達になれた、あたしとあんたは『ちがう』けど『似てる』から」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あんたは、あたしより特別に優秀で、出来のいい『おつむ』を神さまからもらっちゃった。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「『ちがう』のは、それだけ」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「すれちがって、遠ざかったのは、あたしが不甲斐なかったからッスよ」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「何度でも言うよ、あんたは何も悪くない。だから、お願いだからあたしを歪めたなんて思わないで。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「無理してあたしの速度に付きあわせて、あんたを歪めたのはあたし」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「誰よりも、偉大な高みに至れるはずだったあんたを引き留めて……。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「無理をさせてねじ曲げて、痛みを味わわせたのは、あたし」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ごめんね。ずっと謝りたかったッスよ、るり」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「むかぁし……。世界でたったひとりだけ、あたしの横に並んで星を見てくれた、大好きな友達」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あたしの大好きな、大事な……。この地球とだって交換できない、大事な大事な、るり」"
  },
