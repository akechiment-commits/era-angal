    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「あんたなら余裕で飛び越えちゃうような段差を、ひとつ乗り越えるだけでもこんなに大変♪」"
  },
  {
    "command": "update_character",
    "id": "right",
