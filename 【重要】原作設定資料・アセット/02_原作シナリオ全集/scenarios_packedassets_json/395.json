  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「『ねえさん』って、呼ばれたりしてさ……」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「でもね。あたしは正直、ゆきちゃんの気持ちのほうがよくわかるんだ。」"
  },
  {
    "command": "update_character",
