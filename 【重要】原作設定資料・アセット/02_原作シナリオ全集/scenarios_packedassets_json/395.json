  {
    "command": "talk",
    "speaker": "まい",
    "text": "「お姉さん、ってどうすりゃいいの？　あたしはどうせ妹だから、お姉さんぶっても限界があるんだよ」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「お姉ちゃんの真似してみても、できないし。」"
