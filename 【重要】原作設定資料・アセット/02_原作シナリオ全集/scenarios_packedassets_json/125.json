    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「パンツまで脱げとは言わないっちから、せめて裸足になるっち。」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「んで、そこの消毒槽に足つけて。はい十五秒数えて、よしよし」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「んで、プールに何か用っちか？　まだプール、水張ってないから泳げないっちよ？」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「ん？　しゃっちんを追いかけてきたっち？　まぁた何かやらかしたっちか？」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「ふぅん、風紀委員にね——あんた生徒会のパシリだっち？　色々やってるっちね、お疲れさまっち」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「しゃっちんなら、さっき超すごい勢いで駆けこんできて——」"
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「あぁうん、しゃっちん放課後は常に水着だっち、ちょっと変な子っちよね？」"
  },
  {
    "command": "update_character",
    "id": "center",
