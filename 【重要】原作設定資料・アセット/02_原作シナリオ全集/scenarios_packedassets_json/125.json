    }
  },
  {
    "command": "talk",
    "speaker": "ひびき",
    "text": "「そのまんま『水に飛びこむのは空に飛びこむのと同じ！』って変なこと言いながら——あっ、もしかして」"
  },
  {
    "command": "play_bgm",
