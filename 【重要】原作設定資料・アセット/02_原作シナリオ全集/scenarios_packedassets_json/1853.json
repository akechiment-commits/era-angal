  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「ゆゆ、おなかすいてるし、ちょうどいいお話だよね～☆」"
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「女の子たちが迷い込んだのは、お肉を加工する工場でした……♪」"
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「女の子のひとりが、興味を持って機械に近づくと、止まっていたはずの機械が急に動き出して……」"
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「がりがりがり！　ぐしゃあ！　びちゃあ！」"
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「えへへ……このお話ならきっとお目めぱっちりだね～☆」"
