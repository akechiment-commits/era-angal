    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「特訓、がんばります。きっと、『立派なレディ』になってみせます。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「せめて、むかしマルちゃんが憧れてくれた『お嬢さま』に」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
