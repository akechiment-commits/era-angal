    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「でないと。マルちゃん、優しい子だから……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいりのこと放っておけなくて、何度も駆け寄ってきちゃいますから。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「甘えん坊さん、ですからね」"
