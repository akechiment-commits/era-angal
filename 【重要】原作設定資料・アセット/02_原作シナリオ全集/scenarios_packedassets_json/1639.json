    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「でも、距離が遠ざかっても。あなたは、声が届くところにいる。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「それを実感できたから、かいりはもう怖くありません」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「いつだって。君咲学院に、あなたの声は響いてる」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「元気で、明るくて、前向きに、がんばってる……。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「あなたの声を聞くたびに、かいりも安心できる。」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「かいりも、あなたに心配させない程度の距離に、いつもいますから」"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「しんどくても、踏ん張ってでも、あなたのほんのすこし先を……。」"
