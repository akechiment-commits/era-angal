  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「ああ、行っちゃったあ……。どうしたんだろ、様子がおかしかったなあ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
    "dress": "old-worker",
    "pose": 0,
    "active": true,
    "expression": "old-worker_expression/amazed",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「ていうか。会長さん、まだ会計してない本を慌てて持って行っちゃったような。」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「いっけない、万引きになっちゃうなあ？」"
  },
  {
    "command": "update_character",
