    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「ああもう、しょうがないわねっ！　そこまで言うなら、すこしくらいは一緒に休んであげるわよっ！」"
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「あたしだって鬼じゃないからね、感謝しなさいよっ、まりあ？」"
