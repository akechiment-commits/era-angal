    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「いまどき、パンダを見るのに何時間も並ばなくてもいいと思うのですが……？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 18,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civvies_expression/sad",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「うぅ、日差しで『めまい』がしております。木陰で休みたいのですけど……」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "old-sp-civvies",
    "pose": 0,
