    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「ええ。梅ちゃんから誘っていただいたのに、すみません……」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 18,
