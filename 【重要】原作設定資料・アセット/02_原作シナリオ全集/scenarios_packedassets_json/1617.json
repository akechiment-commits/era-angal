    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「ですが、パンダは逃げませんものね。一息ついたら、ちゃんと見に行きますからね……♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civvies_expression/normal",
