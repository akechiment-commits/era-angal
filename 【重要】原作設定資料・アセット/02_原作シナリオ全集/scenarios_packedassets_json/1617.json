  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「そうでございますね、梅ちゃん。わたくしも、暑さのあまりぼーっとしております……」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
