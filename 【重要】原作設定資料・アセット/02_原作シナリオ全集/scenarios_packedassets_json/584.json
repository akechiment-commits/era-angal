  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（だめだ、ゆゆちゃんに当たっても仕方ないや。心配してくれたのに……。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（やだな、わたし。やな子だな）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（どうしよう。演劇部にまた依頼されて、新しい脚本を書かなくちゃいけないんだけど。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（何も思いつかないよ、もう〆切とっくに過ぎてるのに）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（演劇部の八雲先輩は優しいから、ずっと原稿を待ってくれるだろうけど。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（それに甘えてちゃいけないよね、がんばらなくちゃ）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（こないだ、ゆゆちゃんが書いた脚本がすごく評判よかったみたいで……。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（演劇部の脚本は、わたしがずっと書いてたのに。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（たった一回で、追い抜かれちゃった感じがして）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（わたしも、ゆゆちゃんみたいな脚本を書いたほうがいいのかなぁ。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（でも、わたしにはわたしの書きかたしかできないし。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（わたしなりに、ゆゆちゃんと同じぐらい面白い原稿を書ければいいんだけど。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（いきなり、そんな傑作なんか書けないよ～っ！）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（落ちこむなぁ、わたし才能ないのかなぁ。指が、固まって動かないよ）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（お話を書くのが好きだから、文芸部に入ったのに。近ごろは苦痛だよ、こんなのやだよ）"
