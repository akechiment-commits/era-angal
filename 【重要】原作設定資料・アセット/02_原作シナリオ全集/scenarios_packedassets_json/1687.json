    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「ま、時代が時代だから……」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「たぶん、あたしのこういう熱血な感じは受け入れられないのかなって、そう思ってた」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「だから……外の世界を見せてくれて、ありがとう。」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あたしが相方をアイドルの世界に連れていったように、あなたが日常の世界を、見せてくれたんだよね」"
  },
  {
    "command": "update_character",
