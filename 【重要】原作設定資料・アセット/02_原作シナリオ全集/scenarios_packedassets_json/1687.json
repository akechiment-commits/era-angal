  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「そんな申し訳なくしないでよ～。大丈夫。あたし、けっこう楽しめたから☆」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 65,
