    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あたしね、自分が近寄りがたい、古いタイプのアイドルなんだと思ってた」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 65,
    "dress": "old-a-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-a-civvies_expression/sad",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「最近のアイドルって、アイドルのレッスン一本じゃなくて、いろんな分野のことをしてる感じなんだよね～？」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「そういうのって、プロフェッショナルとしてどうかと思ってたんだけど」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 65,
