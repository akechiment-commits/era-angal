  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「えぇっ、わたしが部長なの？　聞いてないよ！」"
  },
  {
    "command": "talk",
    "speaker": "るか",
    "text": "「し、しずくちゃんのほうが楽器もできるし『しっかり』してるのに〜？」"
