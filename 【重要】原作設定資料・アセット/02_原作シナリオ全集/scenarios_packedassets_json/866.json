  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「部長と、いちかさんを発見しました。何をしてるのでしょうかね、あのふたり？」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「楽しそうな声は、聞こえてきますけれど……？」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「手拍子を打ちながら、飛び跳ねている？　あれは、剣道の修行なのでしょうか……？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sp-civves",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civves_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あぁ、転校生さんには経緯を説明してませんでしたかね。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「うちの剣道部のいちかさん、近ごろ腑抜けまくりなのでね。部長に、鍛え直してもらっているのですよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-sp-civves",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civves_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「これで、いちかさんも『しゃん』としてくれればいいのですけど……♪」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「部長の性格からいって、いちかさんを甘やかしているのではないかと心配していましたけど。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「よかった、どうやら杞憂だったようです」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ちゃんと身体を動かして、修行っぽいことをしてますね……♪」"
  },
