    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「部長～っ！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「いちかさんに剣道の修行をさせるようにと、わたし言いましたよね？　ちゃんと言ったのに！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ど、どう見ても遊んでるじゃないですか！　剣道の『け』の字もない！」"
