  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「よぉし、バッチリ！　いい写真が撮れてますよっ、テンションあがるぅ～！」"
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「ほんと手伝ってもらって助かります、先輩♪」"
