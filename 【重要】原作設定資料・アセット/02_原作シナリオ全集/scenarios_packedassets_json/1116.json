  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（転校生くん、そのへん『きちん』としてそうではあるけど。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（あんずさんに頼まれちゃったもん、『うちの弟の世話をしてあげて』って♪）"
