  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ふう、ベッドがあって助かったよ。ここで、寝かせてもらっていい？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「すこし、楽になったよ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「えっと、吹奏楽部のみんな。厚かましいかもしれないけど……」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「これから予定がないんだったら、転校生くんたちと遊んでくれないかな？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしが休んでる間、待たせちゃ可哀想だし。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「せっかくの遊園地なんだし、いろいろ巡ったりして時間つぶしててほしいんだ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「藤猪さんは、軽音部と合流しちゃうかもだし。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「そしたら転校生くんひとりになっちゃって寂しいかなって、……どうかな？」"
  },
