    "pose": 0,
    "active": false,
    "expression": "old-n-armband_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「そんな顔しないでください、生徒会長」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「生徒会長は、わたしがずっと言いたくて言えなかったことを言ってくれたんです」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 1,
    "dress": "old-w-ribbon",
    "pose": 0,
    "active": true,
    "expression": "old-w-ribbon_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 520
