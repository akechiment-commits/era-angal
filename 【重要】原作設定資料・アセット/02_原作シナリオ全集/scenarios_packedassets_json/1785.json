    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「空手部に体験入部した際の疲れが、まだ癒えていないのでしょう」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「今日はずっと、保健室で寝ておられたようでございます」"
