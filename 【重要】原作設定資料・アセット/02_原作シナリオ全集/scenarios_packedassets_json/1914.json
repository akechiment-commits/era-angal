  {
    "command": "update_character",
    "id": "center",
    "character": 36,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": -24,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「見返りを求めない好意は尊いっすけど、やっぱりちょっと心苦しいっすね～？」"
