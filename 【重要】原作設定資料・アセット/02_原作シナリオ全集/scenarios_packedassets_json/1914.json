    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": -24,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「古代君咲人の呪いがどうとか、その魂を鎮撫するとかどうとか～？」"
