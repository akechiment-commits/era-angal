  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（えぇっと……？）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『ごめんね、ゆきちゃん。ちょくせつお話しできるかわかんないから、お手紙にするね。』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『もうほんと死にそうだから手短に書くけど』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "『このドレスにはね、魔法をかけたんだ』"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『きっと、ゆきちゃんに勇気を与えてくれる』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『それを信じて。ううん、わたしを信じてくれると嬉しいな』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『あはは。眠くて文章まとまらないけど、とにかく……。だいじょうぶ、自信もって。』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『わたし、最高のドレスをつくったから。がんばったから。』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『それを誰にも見せないままにしちゃうのは、わたしもちょっとガッカリしちゃうから』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『だから、わたしのためだと思って、きっと着てね。』）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（『彼が……わたしの幼なじみが、誰を選ぶかはわからない。優しいひとだから、誰も選べないかもね。』）"
  },
  {
