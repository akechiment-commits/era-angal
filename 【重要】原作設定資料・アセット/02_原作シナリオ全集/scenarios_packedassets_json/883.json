  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「あらためて。このたびは、ほんとうにご迷惑をかけました」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私、今後は心を入れ替えたいと思います。できるだけ、素直になりたいです」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「夏野部長の言うとおりに、私は未熟な半人前です」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「ですから、どうか支えてください。そして叱って、導いてください」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私、ひとりで無理して踏ん張らずに、なるべくみんなを頼りたいと思います」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
