  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（女々しいな、わたし。もう、部長は卒業しちゃうのに）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（離ればなれになるのに、わたしはもう子供じゃいられないのに。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（泣いたりなんてしない、大人にならなくちゃいけないのに）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（でも、会いたい。会って笑ってお喋りして、抱きしめてほしい。甘やかしてほしい、）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（ほんとはもっとずっと一緒にいたかった）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（ちっとも部室にきてくれなくてもいい、たまにしか会えなくてもいい！）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（会うたびに憎まれ口を叩いちゃって、嫌われてもよかった！）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（そばにいてほしかったよぉ！　部長、部長～！）"
  },
