  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "（このまま手を引いて、どっかへ攫っていきたいけど）"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "（それは、だめね。あたしは『おおきく』なった、背がのびたから……。）"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "（ひかるちゃんとは、もう歩幅がちがうんだから）"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "（だから、ちがう道を歩くのよ。これは、仕方がないことなんだわ）"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "（でも、今だけは）"
  },
