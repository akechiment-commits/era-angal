  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「当然よ。ひかるちゃんとの思い出は、ぜんぶキラキラ輝く宝物よ。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「大事に、あたしの心のなかに保管してあるわ」"
