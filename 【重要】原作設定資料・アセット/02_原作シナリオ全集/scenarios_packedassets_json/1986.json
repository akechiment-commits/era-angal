  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「うん。そんなような話は聞いてたから、わたしもこうして屋上にきてみたんだ。」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「るかちゃんの行動をなぞれば、その気持ちもすこしは理解できるかなって」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「たいてい、屋上はいつも鍵が閉まってるから。マスターキーをもってるパパに頼んで、扉を開けてもらったんだ」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「るかちゃんにも会えるかも、っていう期待もあったんだけど」"
