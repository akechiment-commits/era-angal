  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（でも。舞踏会のときも、そんなふうに『うじうじ』考えてたら取りかえしのつかないことになりかけたし。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（もう後悔したくない、勇気をだすんだ……って決めたはずなのに）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（あれから、ずるずると何も変わんないまま今日まですごしちゃったもん。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（勇気をださなきゃいけないよ、同じことの繰りかえしになっちゃうよ）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（ううっ、でも怖いよ～っ！）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（わたし、どうしたいんだろ。もっと先輩と一緒にいたい、ふたりで水族館を歩くだけでとっても幸せだったもん。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（できれば、ずっと……）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（でも、わたしが何か言ったり行動したりすれば、この関係すら失っちゃうかもしれない。）"
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "（それは怖いよ、嫌だよ）"
