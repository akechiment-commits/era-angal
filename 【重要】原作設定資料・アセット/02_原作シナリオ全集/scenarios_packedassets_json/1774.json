  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「おかげで、今日もぶじに保健委員の仕事を終われそうだよ。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「けが人や、病気のひともいないみたいだし……」"
