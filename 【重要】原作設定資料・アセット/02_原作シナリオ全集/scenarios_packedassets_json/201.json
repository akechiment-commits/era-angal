  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ふふ、やはり姉弟だな。おまえは、あのひとに似ている」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「おまえを見ていると、思いだすよ。初めて、あのひとに出会ったときのことを」"
