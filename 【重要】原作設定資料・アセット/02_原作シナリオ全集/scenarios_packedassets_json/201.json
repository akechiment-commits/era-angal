    }
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ずっと、ずうっとだ」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ボクを見ると、みんなが違和感をおぼえる。」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「戸惑い、怯えて、理解できないから攻撃する。」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「ボクも、ちいさな子供のころはごく当たり前に、両親に、みんなに、愛されたいと望んでいた。」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「けれど、ボクが近づこうとすると、みんなが困ってしまう」"
  },
  {
    "command": "talk",
    "speaker": "すず",
    "text": "「そんなこと、ばかりだった。」"
