    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「実はね……クラスメイトに、こんなこと言われたんだ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 1,
    "dress": "old-w",
