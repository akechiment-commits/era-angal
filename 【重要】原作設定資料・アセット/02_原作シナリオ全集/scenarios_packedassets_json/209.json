    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「あぁ、そうかな。そうかもね……」"
  },
  {
    "command": "update_character",
    "id": "right",
