  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ゆゆさんと一緒に願掛けをするしかないような……そんな気がしていますわ」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「きっと叶いますわよね、わたしの願いは……」"
