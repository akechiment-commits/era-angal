      "x": -10,
      "y": 478
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ちづる",
    "text": "仕方ないかなって。新しく生徒会長になった……ひまりちゃんだっけ、その子のやりたいことは理解できるんだけど"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 60,
