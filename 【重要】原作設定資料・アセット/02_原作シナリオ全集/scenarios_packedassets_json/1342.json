    "command": "update_character",
    "id": "center",
    "character": 67,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "「ほとりちゃんと話せるように、って、練習したのに……」"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "「あいかのひと、ごめんなさい。るりがお手伝いできるのは、ここまでみたいです」"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "「るりはすこし、疲れました」"
