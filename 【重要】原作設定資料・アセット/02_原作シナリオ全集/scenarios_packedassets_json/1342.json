    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/normal",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "「るりとしても、脳の容量には限りがあるので覚えなくていい類の情報や記憶は、忘れていたいところです」"
  },
  {
    "command": "update_character",
