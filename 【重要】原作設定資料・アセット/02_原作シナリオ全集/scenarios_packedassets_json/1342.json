    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "「とはいえ、るりのことを覚えているひとなんてほとんどいないでしょうけど」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 67,
