    "character": 35,
    "dress": "old-kimono",
    "pose": 0,
    "active": true,
    "expression": "old-kimono_expression/amazed",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「あ、危ないですよ、天宮先輩……？」"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「というか。クリスマスのときの部長といい、どうして先輩たちは高いところに登りたがるんでしょうか……？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 67,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
