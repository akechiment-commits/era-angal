    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「そうしてくれると、助かります。今のところ、さっぱり何がなんだかわかりません」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「どうして、メリメロのふたりは喧嘩してるんですか？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 29,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": false,
    "expression": "old-sp-civvies_expression/sad",
