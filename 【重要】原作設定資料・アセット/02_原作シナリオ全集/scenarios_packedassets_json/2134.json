    "dress": "default",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": 14,
      "y": 488
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "今日が最終日なのにさ、チケットが余っちゃって。無駄にすんのも『もったいない』し、良かったら一緒にどう？"
  },
  {
    "command": "update_character",
