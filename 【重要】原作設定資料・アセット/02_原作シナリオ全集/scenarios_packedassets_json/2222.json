    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "ごめんなさい、夢中で歌っていたから気づかなかったのだけれど。あなた、あたしに何か用事かしら？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 66,
    "dress": "pajamas",
    "pose": "1",
    "expression": "pajamas_expression/amazed",
    "expression_position": {
      "x": -8,
      "y": 464
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "べつに用事があるわけじゃない……って、どういうこと？　じゃあ、どうして『じっ』と見ていたのかしら？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 66,
    "dress": "pajamas",
    "pose": "2",
