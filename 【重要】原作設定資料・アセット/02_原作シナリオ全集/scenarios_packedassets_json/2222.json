    "asset_code": "web:voice/character/66/habit-6.wav"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "ご、ごめんなさい。もしかしたら、うるさかった？　今日は談話室に誰もいないと思って、つい大声で歌っちゃったのだけれど……♪"
  },
  {
    "command": "update_character",
