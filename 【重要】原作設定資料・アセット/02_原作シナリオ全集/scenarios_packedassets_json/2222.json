    "active": true
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "ふぅん。お医者さんは、ただの風邪だって言ってたのね。よかった～、それなら安静にしてたらすぐ元気になるけれど♪"
  },
  {
    "command": "update_character",
