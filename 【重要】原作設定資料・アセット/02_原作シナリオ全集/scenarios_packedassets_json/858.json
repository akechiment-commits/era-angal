  {
    "command": "talk",
    "speaker": "そら",
    "text": "（服が、重いから？）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（ううん。違う。それはわたしが、人と人との関係に縛られているから）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（わたしは少しずつ、がんじがらめにされている）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（オカ研で双子と遊ぶのは、悪くない。むしろ、よい関係だけど）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（そのせいで、わたしは君咲学院に囚われている）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（今日も、学校の屋上で、ひとりで過ごしていた）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（もう、オカ研には、誰もいないのに）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（みんな、巣立ちの準備を始めているっていうのに）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（ひとりでＵＦＯなんて呼んでも、全然、つまらないのに）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（一歩を踏み出せないのは、わたしも同じ。）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（それどころか、一歩を踏み出すことすら、必要ないと思っている）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（いつまでも、幽霊のように、君咲学院に居ついてもいいって、思っている）"
