  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……行ってしまった）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……もう、どうしてわたしは、他人を傷つけるようなことを言ってしまうんだろう）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……わたしは、厳しすぎるんだろうか。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（この部に入ったときから、吹奏楽部はこんな感じだったから、すこし、麻痺しているのかもしれない）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……前の部長は、あまりに厳しいひとだった）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……機械のように、冷静に、残酷に。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（わたしたちの音を厳密に調整することが、あのひとにとっての吹奏楽だった）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……おかげで、音が気に入らないと罵られるひとも多かった。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（前の部長の言うことを聞かないひとは、実力があっても理不尽にパートリーダーを交代させられた）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……恐怖の独裁政治だった。たくさん、部員が辞めていった。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（三年生の先輩に至っては、今では誰も残っていない）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……顧問の先生も、女性恐怖症になるくらいに心に傷を負ってしまった。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（事実、去年の音楽室で行われていたのは、部活のあるべき姿とはほど遠い……）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……ただの、演奏をするための機械を生み出す場所だった）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……あのひとが、吹奏楽部を壊したんだ）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……そうして前の部長は、吹奏楽部を見るも無残な状態にしたあとに、ただひとこと）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……『飽きた』と）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……そう言って、吹奏楽部に姿を見せなくなってしまった）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……かわりに、わたしが部長を引き継ぐことになった）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……そうして、今までと違って楽しい部活動の姿に戻った）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……わたしは二度と、あんなむごい部の惨状を見たくない。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（だから守りたいって思う。この部活を、わたしの、居場所を）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……だけど、わたしはあのひとと同じように、みんなに厳しい練習を強いている。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（反発されて、信用を失っている）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……このままで、いいんだろうか。そう考えたことも、数知れないくらいにある）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……でも、ほかのやりかたが、わからないんだ。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（あのひとの、人間を人間とも思っていないような指導方法が、いまでもわたしの記憶の片隅にあって、）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（前の部長に似た厳しい態度を、後輩に対して取ってしまう）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……どうしたら、いいんだろう。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（いつまで経っても、わたしはあのひとの影から、逃れることができない）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……わたしは、ずっと）"
  }
]