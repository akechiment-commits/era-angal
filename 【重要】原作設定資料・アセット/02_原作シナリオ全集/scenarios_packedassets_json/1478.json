  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（北川さん、遅いなぁ）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（やっぱり、一緒に行ったほうがよかったかな。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（でも、わたしもいろいろ連絡とか手続きとかしなくちゃだったし。う～ん、迷子になっちゃったのかな？）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（探しに行きたいけど、いま北川さん携帯電話が壊れてるんだもんね。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（連絡もとらずに場所を移動したら、二重遭難っていうか……。入れ違いになるのが、怖いもん）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（やっぱり、ここで待ってよっと。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（北川さんにはこっちの電話番号を伝えといたし、ほんとに迷子になったなら公衆電話とかからかけてくるよね）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（待ってる間は、目的地のガイドブックとか読みこんでおこう）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（旅行はどっちも初心者だけど、気持ちに余裕がなくて北川さんはテンパっちゃってるし。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（わたしが『しっかり』と、フォローしないと。うん、がんばろう）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（わたしが困ってると、いつも部長がいつの間にか助けてくれていたみたいに。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（いや、あのひと『助ける』っていうか『一緒に困って泣いちゃう』感じだったけど）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（それだけでも、すごく心強かったもん。今度は、わたしの番だ）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（いろんなひとに支えられて、愛されて、ここまで歩いてきた。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（だけど、わたしもいつまでも泣いてばっかりの子供じゃいられない）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（強くなろう、大人になろう。ちいさな部長が背伸びして、お姉さんぶってくれたみたいに。）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（『甘えん坊』は卒業するんだ、わたし）"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（この旅行はきっと、そんな通過儀礼なんだ）"
  },
