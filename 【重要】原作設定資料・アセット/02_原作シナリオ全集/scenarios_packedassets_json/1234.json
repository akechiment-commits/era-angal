    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「だけど、このまま寝てると風邪ひいちゃうよ？　どれ、ねえさんがブランケットをかけてあげよう……♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 47,
