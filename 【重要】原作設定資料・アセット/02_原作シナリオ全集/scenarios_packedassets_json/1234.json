  {
    "command": "talk",
    "speaker": "まい",
    "text": "「しょうがないよね。ここ数日間、働きづめだったし。」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「それに、遅くまで残って、練習もしてたみたいだし……疲れも、溜まってるか」"
  },
  {
    "command": "update_character",
    "id": "right",
