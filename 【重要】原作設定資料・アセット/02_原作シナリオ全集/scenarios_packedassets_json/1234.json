    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「魔法が解けても、今日ゆきちゃんが頑張って勇気を出した経験は、消えないよ、ぜったい」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 47,
    "dress": "old-w",
    "pose": 0,
    "active": true,
