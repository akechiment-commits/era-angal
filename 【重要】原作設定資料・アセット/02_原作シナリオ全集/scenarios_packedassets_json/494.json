    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（あんな傍迷惑な子を受けいれて、好き勝手させてあげられるの、）"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（保健委員会とうちの園芸部ぐらいなんだから）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 52,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
    "expression": "old-pajamas_expression/joyful",
    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（あの子の居場所を、守ってあげたいな）"
