  {
    "command": "update_character",
    "id": "center",
    "character": 52,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
    "expression": "old-pajamas_expression/amazed",
    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「前にもこんなことがあった気がする……」"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「わたしも毎度毎度、よく死なないなぁ」"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「くるみちゃん、気合をいれればいれるほど邪悪な料理をつくっちゃう癖……」"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「どうにかならないかなぁ？」"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「悪い子じゃあ、ないんだけどね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 52,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
