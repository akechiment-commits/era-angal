    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（プレハブ小屋に運んで、寝かせてくれたの、くるみちゃんだろうし）"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（毛布もかけてくれてるし、看病もしてくれたっぽいなぁ）"
