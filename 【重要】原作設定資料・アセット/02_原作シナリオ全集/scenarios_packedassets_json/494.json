    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（いや、ふつうに救急車呼んでよっていう感じだけど）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 52,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
