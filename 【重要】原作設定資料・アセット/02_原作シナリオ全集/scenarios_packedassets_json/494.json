  {
    "command": "update_character",
    "id": "center",
    "character": 52,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
    "expression": "old-pajamas_expression/sad",
    "expression_position": {
      "x": 6,
      "y": 490
