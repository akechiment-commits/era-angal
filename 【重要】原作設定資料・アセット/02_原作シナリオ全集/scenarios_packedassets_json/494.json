  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（部員がすくないし、いろいろ問題も起こしてるしね）"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（だけど何とか廃部だけは避けたいって思って、緑化委員会の八雲先輩に相談したんだ）"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（緑化委員会に、校内での奉仕活動とか紹介してもらえないかなって）"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（植林したり、運動部のための炊きだしをしたり、お掃除をしたりね）"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "（そうやって学校の役に立てば……評価されて、廃部は免れるかも）"
