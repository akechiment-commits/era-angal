    "command": "update_character",
    "id": "center",
    "character": 52,
    "dress": "old-pajamas",
    "pose": 0,
    "active": true,
    "expression": "old-pajamas_expression/normal",
    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「あぁそっか、くるみちゃんの料理とドリンクを摂取しちゃって失神したんだ」"
