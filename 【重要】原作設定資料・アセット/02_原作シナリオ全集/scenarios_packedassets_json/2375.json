  {
    "command": "talk",
    "speaker": "クー",
    "text": "ン～、ゴメンネ。私、覚エタコトヲ忘レルノハ苦手ダカラ"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 54,
    "dress": "bride",
    "pose": "2",
    "expression": null,
