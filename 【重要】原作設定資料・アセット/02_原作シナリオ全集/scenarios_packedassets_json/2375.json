  },
  {
    "command": "play_voice",
    "asset_code": "web:voice/character/49/habit-5.wav"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "お礼を言う暇すら、与えてくれなくって……。でも、嬉しかった。ずっとずっと、感謝してました。でも、本人にとっては『どうでもいいこと』かもしれなくて"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "ありがとう、って一言さえも伝えられなくて……。ずるずると、とくに意味もなく何度も呼びだしちゃって"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "ヘルプマンとか、おかしな名前で呼んで、一方的に懐いて……。苦労をかけてばっかりだったのに、迷惑なら無視すればいいのに"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 49,
    "dress": "bride",
    "pose": "2",
    "expression": "bride_expression/sad1",
    "expression_position": {
      "x": -4,
      "y": 472
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "いつでもヘルプマンは、わたしが呼べば駆けつけてくれましたよぉ？"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "どれだけ我が侭を言っても、笑顔で受け入れてくれて……。どんなに忙しいときに呼びだしても、嫌な顔もせずに助けにきてくれて"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 49,
    "dress": "bride",
    "pose": "2",
    "expression": "bride_expression/weep",
