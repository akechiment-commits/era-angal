  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「とはいえ、羽森さんのほうは乗り気のようね」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「彼女は幼いころから芸能界で活動している。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「子役のころは両親とともにふつうに『バラエティ』にも出演してたようなのよ、経歴を見るかぎりね」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「彼女にはじゅうぶんに今回の依頼をこなせる技量と、経験があるわ」"
  },
  {
    "command": "update_character",
