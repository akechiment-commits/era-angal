    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「愛してますよ。な～んて、『愛』なんて言うと逆に嘘くさいけど！」"
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「とってもとっても、大好き！　時国先輩は、ちがうんですか～？」"
  },
