    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「転んでも立ちあがって、また転んだってへいきで、ひとより『のろま』だけど歩いていけるようになったのは」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 32,
    "dress": "old-raincourt",
    "pose": 0,
    "active": true,
    "expression": "old-raincourt_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
