    "pose": 0,
    "active": false,
    "expression": "old-raincourt_expression/surprise",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「ううん。早川さんが、謝ることなんてない。あなたは、何も悪いことをしていない。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 31,
    "dress": "old-fairy",
    "pose": 0,
    "active": true,
    "expression": "old-fairy_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「ふつうに家族を愛し、毎日を楽しんで、青春を……人生を謳歌してる」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 31,
    "dress": "old-fairy",
    "pose": 0,
    "active": true,
    "expression": "old-fairy_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「羨ましいよ、早川さん」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 31,
    "dress": "old-fairy",
    "pose": 0,
