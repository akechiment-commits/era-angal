    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「家族って、大事ですよ。お父さんたまに怖いし、お母さんは口喧しいし、妹は生意気だけど～？」"
  },
  {
    "command": "update_character",
