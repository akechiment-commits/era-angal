    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「そ、そうですか？　『羨ましい』なんて言われたことないな～、」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 32,
    "dress": "old-raincourt",
    "pose": 0,
    "active": true,
    "expression": "old-raincourt_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「ほんと時国先輩って変なことばっかり言うんだから♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 31,
    "dress": "old-fairy",
    "pose": 0,
    "active": true,
