  {
    "command": "update_character",
    "id": "left",
    "character": 32,
    "dress": "old-raincourt",
    "pose": 0,
    "active": true,
    "expression": "old-raincourt_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「あたしは、あのころ『それ』だけがほしかった」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 32,
    "dress": "old-raincourt",
    "pose": 0,
    "active": true,
    "expression": "old-raincourt_expression/joyful",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「そして、時国先輩が『それ』をくれたんです」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 32,
    "dress": "old-raincourt",
    "pose": 0,
    "active": true,
    "expression": "old-raincourt_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「うまく言えないや……。だから時国先輩、お願いだから『生まれてこなければよかった』なんて言わないで」"
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「時国先輩に、出会わなければ。あたしは今日までずっと、俯いて生きていたと思います」"
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「転んで、地べたに倒れたまま、一歩も動けなかった。」"
