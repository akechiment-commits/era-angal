    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「ほぇ？　えっとあの、ごめんなさい！　あたし、そうとは知らずに……!?」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 31,
    "dress": "old-fairy",
