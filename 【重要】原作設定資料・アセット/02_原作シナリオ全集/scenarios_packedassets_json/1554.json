  {
    "command": "set_background",
    "display_name": "城下町",
    "id": "2133",
    "timezone": "4"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あは！　あははは！　あははははははは……☆」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「これですよ、わたしが求めていたのはこれですよ！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「さぁ愛しあいましょう、刀の切っ先に命をのせて！　興奮する……！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「新撰組、推参！　治世を乱す狼藉者ども！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あなたたちの悪行を、天がゆるしても新撰組副長・悠木ともこはゆるしません！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「悪！　即！　斬！　今宵のぴょんぴょん丸は血に飢えていますよっ、あははははははは……☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（しかし、困りましたね。楽しすぎて『うっかり』深入りしすぎましたが、無謀だったかもしれません。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（ひとりで突っ走りすぎですね、反省反省♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/angry",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（けれど！）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（この『池田屋』に集まった連中は世を乱す倒幕派どもっ、どれだけ刀の錆にしても構わないのです！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（撫で切りにしてくれましょう、こういうのを待っていました……☆）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（あぁ楽しいっ、満ち足りる！　町の警邏や、詰め所での事務仕事には飽き飽きしていたんですよ！）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（斬りあいこそが、我が人生！　武士の本懐、ここにあり！）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（あぁ阿呆の将軍を無理やり説き伏せて、新撰組を結成してほんとによかった！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/angry",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（将軍のお守りには『うんざり』ですからね、わたしはわたしの道を征く！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（しかし、思いの外に歯ごたえがなくて残念ですね。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（幕府を転覆させようと目論むぐらいなのですから、もっと骨のある連中かと思ったのに～？）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（まぁ夜陰にまぎれての不意打ちですし、ろくな抵抗がないのも仕方ありませんね。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（同情はしませんよ、逃げ惑うだけの弱虫どもを狩るのではむしろ苛々が募りますけど）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/angry",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（常在戦場！　その心構えもない小悪党どもは、死んで骸を晒しなさい！）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（血の花を咲かせなさい！　華麗に！）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（それだけが！　血飛沫だけが、わたしの心の隙間を埋めてくれる……！）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「さぁさぁ、もっと楽しませてください！　死にもの狂いで足掻いてくださいよ、命が惜しいならば！」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「戦わないと生き残れないっ、それが『たったひとつ』の真実でしょうがあ～！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/amazed",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（む？　階下が騒がしいですね、新撰組の別働隊が到着してしまったのでしょうか。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（情報が曖昧でしたからね～、新撰組を二手にわけて別行動してたんですよね）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（監察のいちかさんの不在が、悔やまれます。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（まぁ、あれは戦力的には居ても居なくても問題ない程度の未熟者ですけど）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（諜報活動を担当する人間が足りないため、情報の確度が低くなっています。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（今回は、無駄足にならずに済んでよかったですけど）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（しかし、せっかく『当たり』を引いて倒幕派の巣に踏みこめたまではよかったものの……。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（獲物を独り占めできると思ったのに、もう援軍がきてしまうとは）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（仕方ないですね。今日のお楽しみはここまで、ということで。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（他の皆さんと合流して、戦況を把握しましょう。池田屋の周囲を固めて、あとは殲滅戦ですかね～？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（ひとりも逃しませんよ、ふっふっふ。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（『君咲幕府』に仇為すものは、新撰組の旗のもとに無残な亡骸を晒す運命です……♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-shinsengumi",
    "pose": 0,
    "active": true,
    "expression": "old-shinsengumi_expression/surprise",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（……!?　これは、殺気!?）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（馬鹿な！　めぼしい敵は、あらかた片付けたはず……!?）"
  },
