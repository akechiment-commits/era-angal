    "expression_position": {
      "x": 20,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "いかり",
    "text": "「う、うが～！　何でそこまで言われなくちゃいけないしっ、」"
  },
  {
    "command": "talk",
    "speaker": "いかり",
    "text": "「こっちは善意で『引っ越し』を手伝ってあげてるのに～！」"
