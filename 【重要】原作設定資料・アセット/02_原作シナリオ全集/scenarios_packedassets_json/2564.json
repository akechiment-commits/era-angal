    "active": true
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "窓の外に、何かが見えるんですか？　えぇっと、未確認飛行物体とかですか？"
  },
  {
    "command": "update_character",
    "id": "center",
