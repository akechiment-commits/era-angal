    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「スマホも圏外っぽいし、連絡もつかないな～……」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 23,
    "dress": "old-coat2",
    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/surprise",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「ど、どうしよう！　なんだか嫌な予感がしてきたんだけど？」"
  },
  {
    "command": "talk",
    "speaker": "もも",
