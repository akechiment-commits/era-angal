  {
    "command": "update_character",
    "id": "center",
    "character": 23,
    "dress": "old-coat2",
    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/surprise",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「だ、駄目だ～。いまのあたしにはこの扉は重すぎるよ！」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「ってことは……も、もしかしてあたし、閉じ込められちった感じかな？」"
