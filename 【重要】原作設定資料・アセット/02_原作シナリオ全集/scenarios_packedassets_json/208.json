  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（あ、もう放課後か）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（困ったな、授業ぜんぶサボっちゃった。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（あとで、さあやちゃんにノート見せてもらおう。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（あっ、今日は掃除当番だった。誰か、代わりにやってくれてるかな？）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（やだな。また、どうでもいいこと気にしてる）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（いろいろサボったりして、みんなに迷惑かけて、）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（心配させてたらやだな。嫌われたら、やだな。そんなことばっかり、考えてる）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（そういうことばかり考えて生きてきたんだ、これまで、わたし）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（でも、それの何がいけないんだろ。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（ゆうちゃんは、どうしてあんなこと言ったんだろ。わかんないや……）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（『みんな大好き』なわたしでいい。そう思うなら、こんなにぐじぐじ悩まないはずなのに。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（ゆうちゃんの言ったことなんて気にせずに、流しちゃえばいいのに。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（こんなふうに、蹲って、ずっと悩んで、苦しんでる）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（図星をさされた、のかな……？　だから動揺してる、のかな？）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（何で、こんなに落ちこんでるんだろ。自分のこと、よくわかんないや……）"
  },
