  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「まぁ、おじいちゃんパーティとか好きだからさ……。」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「ちいさな子供のころから、あたしこういう場にはよく同行してるのよ。」"
  },
  {
    "command": "talk",
