    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「今まで、生徒会の仕事で忙殺されてたからなあ、」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「じめじめとも、予定が合わずに一緒に遊びになんて行けなかったから！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そうか、カラオケじゃないのか……でも、じめじめと一緒に帰るんだな？」"
