    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「それで、誰と一緒に帰るんだ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-default",
    "pose": 0,
    "active": true,
