    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「ごく、ごく。あぁ、おいしい♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「歌うと体温があがるんだね、汗かいちゃったよ。あと、さすがに喉がちょっと痛いな」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-default",
    "pose": 0,
    "active": true,
