  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「わたしがお弁当とかつくってきて、食べさせてあげたいけど。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「持ち込み禁止みたいだし、店員さんに怒られちゃうよね」"
