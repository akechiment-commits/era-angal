    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「そっか。うん、いいよ。無理はしないでね、」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「こうして『からおけ』に付きあってくれるだけで嬉しいから」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「いつか、ちゃんとお礼をしないとね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 8,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「食べ物とか飲み物とか、好きなだけ注文してくれていいからね。」"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "「それがお礼になるかはわからないけど、遠慮しないでね」"
