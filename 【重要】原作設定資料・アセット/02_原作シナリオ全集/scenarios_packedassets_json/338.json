  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「体育委員会の仕事じゃないですよね、そんなの。」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「どっちかというと風紀委員がやるべきことでしょ、委員長はいつも安請けあいしちゃうんですから」"
  },
  {
    "command": "update_character",
