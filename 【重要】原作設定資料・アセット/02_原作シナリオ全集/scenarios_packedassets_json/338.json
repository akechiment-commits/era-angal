  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「ともあれ、だ。いくらゲーセンが一昔前に比べたら健全な遊び場になったとはいえ、」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「たま〜にトラブルも起きてるみたいでな」"
