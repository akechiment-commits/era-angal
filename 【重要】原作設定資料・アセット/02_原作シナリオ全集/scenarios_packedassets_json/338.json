  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「まぁ、今はそれでいいけどよ？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「んで一号、おまえよくゲーセンに遊びにくるんだろ？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「おまえのが詳しいんじゃね〜の、だから店内の案内してくれよ？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「最近、このゲーセンで問題になってる事例があってな。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「何かうちの生徒のひとりが、他の客とよく喧嘩になってるらしい」"
