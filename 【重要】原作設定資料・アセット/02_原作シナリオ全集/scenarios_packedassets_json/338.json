    "command": "update_character",
    "id": "right",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「そういったトラブルを解決すんのが、あたしたちの仕事だよ」"
