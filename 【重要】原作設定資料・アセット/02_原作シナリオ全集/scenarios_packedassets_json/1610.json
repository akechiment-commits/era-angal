    "command": "update_character",
    "id": "center",
    "character": 44,
    "dress": "old-white",
    "pose": 0,
    "active": true,
    "expression": "old-white_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「ＢＧＭは映像に集中できるように、クラシックが入ってるんですよ……」"
