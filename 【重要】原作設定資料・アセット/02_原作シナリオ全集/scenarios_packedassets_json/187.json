  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしだって、酷いことばかりするほんとの自分を隠してる。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「完璧に見える陛下だって、きっとそうよ」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「仮面をかぶって、演劇みたいに、役割を演じてんのよ。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あの生徒会長みたいな空気読まないやつは、」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「そういうの無視して、恥ずかしげもなく生きてるけどね」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「それを羨む必要なんてないわ、そんなの動物といっしょだもん」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「全裸で歩き回るみたいなもんよ。そんなの、あたしは御免だわ。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「人間だもの、高度な社会的生活を送ってるんだもの。えぇと、うまく言えないけど！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「だから、堂々としてなさいよ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「仮面でも演技でも、いいじゃないの！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしたちの役割は陛下の腰巾着、春秋コンビ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「　幸いにコンビだから、独りぼっちじゃないわ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「いつだって、あたしは、さくらさんの相棒よ！」"
