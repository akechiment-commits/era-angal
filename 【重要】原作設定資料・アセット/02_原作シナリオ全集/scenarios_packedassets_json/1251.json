    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「わたしはめんどくさいから、体育の授業はサボりますよ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「え～、いいじゃないですかぁ。めんどくさいことは後回し……☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
    "dress": "old-default",
    "pose": 0,
    "active": true,
