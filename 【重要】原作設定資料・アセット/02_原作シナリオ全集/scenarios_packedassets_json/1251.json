    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「そうだ。せっかくだから転校生くん、頼まれてくれませんか？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「わたしは体調が悪いので保健室に行った、って言伝しといてください♪」"
