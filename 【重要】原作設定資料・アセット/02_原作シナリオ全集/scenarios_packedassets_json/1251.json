    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「というか、ほかのクラスメイトたちは？　どこかいっちゃったんですかぁ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「ふぅん、体育の授業でみんな外に出てるんですねぇ？　道理で誰もいないわけですね？」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「あぁ。それでひとりきりの男子である転校生くんが、わたしを待っててくれたわけですねぇ。」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「ほかの生徒が欠席してわたしを待つよりは、転校生くんに任せたほうがなにかと便利ですからねぇ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 44,
