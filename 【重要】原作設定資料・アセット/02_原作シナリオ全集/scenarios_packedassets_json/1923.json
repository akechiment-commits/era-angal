  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「うん。あたしね、けっこう楽しみにしてたんだわ。」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「自分でも驚いたんだけど、まだあんたのことちょっとは好きだったみたい。」"
