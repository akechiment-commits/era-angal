    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「何なんだい、まったく。ほんとうに、深鳥くんは構ってちゃんだね。」"
  },
  {
    "command": "update_character",
    "id": "left",
