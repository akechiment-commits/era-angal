  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「……偶然にすぎないよ」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「ただ、少しだけ……昔が懐かしくなった」"
