    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「なんて。君を過小評価しているかもしれないね？　失礼だったなら、謝るよ」"
  },
  {
    "command": "update_character",
