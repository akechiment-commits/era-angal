  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「そのときのあたしは、新入生だったイチにも好戦的だったんだけどね～？」"
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「どこで丸くなっちゃったのか、今ではみんな仲良し。成長が待ち遠しくなっちゃってる」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「もちろん、急に峰打ちをしたりは今でもやってるけど……ただの『じゃれあい』みたいなものだわさ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
