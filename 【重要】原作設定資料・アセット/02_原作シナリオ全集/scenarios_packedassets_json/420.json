  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『夏休みだし、いちおう連絡はくれるんだけどね。やっぱり心配だし、あちこち探してるんだ』"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『こうやって、いろんなひとに電話をかけて、』"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『みづちゃんの行方を知らないか聞いたりしてるの』"
