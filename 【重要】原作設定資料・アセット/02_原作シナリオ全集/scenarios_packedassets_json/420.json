  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『うん。あんまり期待してなかったんだけど、大当たりかも。』"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『たぶん、みづちゃんは旧校舎にいる』"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『これから急いでそっちへ行こうと思うけど、到着までは時間がかかるから』"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "『あなたたち、現場に……旧校舎にいるんでしょ？』"
