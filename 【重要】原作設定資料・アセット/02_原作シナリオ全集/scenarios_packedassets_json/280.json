    "pose": 0,
    "active": false,
    "expression": "old-maid_expression/amazed",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「安条さんは、校則はきちんと守っている印象ですが」"
