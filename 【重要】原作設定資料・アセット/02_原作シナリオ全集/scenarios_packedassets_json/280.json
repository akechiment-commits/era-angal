  {
    "command": "update_character",
    "id": "left",
    "character": 47,
    "dress": "old-maid",
    "pose": 0,
    "active": true,
    "expression": "old-maid_expression/amazed",
    "expression_position": {
      "x": 10,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「教師もどこ見てんのかって感じだよね〜。」"
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "「ちゃっかり抜け目なく柊ちゃんとかは『メイド喫茶』組から外れてんだよ、ずるくない？」"
