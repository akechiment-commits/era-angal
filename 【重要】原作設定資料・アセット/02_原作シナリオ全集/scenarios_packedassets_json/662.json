  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/amazed",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（あ、あれ？　あたし、寝てた？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（あぁそっか、ずっと寝不足だったのよね。）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（ひよのが変なこと言うからさ～、モヤモヤしちゃって。）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（睡眠不足のまま、ついにバレンタイン当日になっちゃったのよね）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/amazed",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（ひよのったら、どういう意図で『あんなこと』言いだしたのかしら。本人には、聞くに聞けないし）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（おじいちゃんに相談したら、なぜか『創作意欲がわいてきた～っ！』とか盛りあがっちゃって、）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（書斎からでてこなくなるし）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（ううっ、だけど逃げるのはあたしの流儀に反するわ！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（ということで登校してきたわけだけど、正直ひよのと顔あわせたくないなぁ？）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（ん～っと。考えを整理したいのもあって、あと眠気に負けて部室に仮眠しにきたのよね。）"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（そのまま、寝ちゃったのかしらね？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（窓の外を見るかぎり、『落ちてた』のはほんの数分ってとこかしら……まだ早朝だわ。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 25,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（寝てる間に、バレンタインが終わってたらよかったのになぁ？）"
