    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "（あぁ、やっぱり部室は落ちつくわね。このまま、何も考えずにまどろんでいたい……♪）"
