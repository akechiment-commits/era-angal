    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「どなたも寄ってらっしゃい見てらっしゃい、もひとつおまけに食べてらっしゃ～い！」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「今ならタイムセールにつき、特別ご奉仕価格！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 48,
    "dress": "old-china2",
