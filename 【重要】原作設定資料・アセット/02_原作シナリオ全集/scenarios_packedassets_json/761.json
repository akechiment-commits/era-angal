  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「面白いアルね！」"
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「縁起もよければご飯もおいしいっ！　千客万来っ、食べたひとには福きたる～♪」"
