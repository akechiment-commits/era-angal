  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あたし、三波ん家で傘借りるか、もういっそ泊まってくわ。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「すごい雨だしね、電車とか動いてないかもしれないし」"
