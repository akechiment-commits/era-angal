  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「暗いし、雨で足場もよくないし。ひとりで帰るのは、すこし怖かったの」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「でも。あんたと、ふたりなら……」"
  },
