    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "「冷房のきいた建物のなかでのんびり掃除するほうを選んだっぽいですーっ☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 3,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "「なので人数が足りませんし、あたしたち『実行委員』は全員『農作業』のほうに従事することになります！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 3,
