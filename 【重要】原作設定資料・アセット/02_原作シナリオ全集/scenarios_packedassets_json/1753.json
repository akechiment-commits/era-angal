    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "「以上、現状の再確認でしたーっ☆」"
