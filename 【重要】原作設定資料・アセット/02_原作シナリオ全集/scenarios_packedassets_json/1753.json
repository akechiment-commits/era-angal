    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "「やっぱりみんなクソ暑いのに畑仕事なんかしたくないのか、」"
