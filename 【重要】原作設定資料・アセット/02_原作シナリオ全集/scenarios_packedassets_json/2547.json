    "command": "play_voice",
    "asset_code": "web:voice/character/58/emo_laugh-2.wav"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "思いの外に、楽しいから"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "君の敬愛する、神無月くんもこちらにいるしね。引っこみ思案な君も、気兼ねなく同席できるだろう"
