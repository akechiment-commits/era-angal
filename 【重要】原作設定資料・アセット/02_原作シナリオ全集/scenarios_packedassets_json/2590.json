      "x": 0,
      "y": 454
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "るな",
    "text": "『その確率、９６パーセント。スタミナや粘りがあるにしても、出来すぎや』"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 51,
    "dress": "spring-civvies",
    "pose": "1",
