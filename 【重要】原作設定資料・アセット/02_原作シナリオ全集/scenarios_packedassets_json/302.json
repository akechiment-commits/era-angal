    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「って、何ですか急に。あずさちゃん、外回りで手当てとかをしてたはずですけど〜。」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「そっちは片付いたんですか？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
