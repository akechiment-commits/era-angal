    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「お疲れさまです、くるみちゃんっ☆　大活躍だったみたいですね☆」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 17,
