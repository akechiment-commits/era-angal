    "active": true,
    "expression": "old-bloomer_expression/joyful",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「はいっ☆　あずさ、キラキラ笑顔で皆さんを治療しちゃいましたよっ☆」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 17,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/normal",
    "expression_position": {
      "x": 20,
      "y": 466
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「とりあえず、一段落したので援軍とともに帰参しましたっ☆」"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「保健委員会の先輩たち、つれてきましたよ〜☆」"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「皆さん、お昼休み返上でお手伝いしてくれるみたいです☆」"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「なので、この救護テントはあずさたちに任せてください。気づいてないっぽいですけど、もう昼休みですよ☆」"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "「くるみちゃんは、お昼ご飯を食べちゃってくださいっ☆」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 19,
