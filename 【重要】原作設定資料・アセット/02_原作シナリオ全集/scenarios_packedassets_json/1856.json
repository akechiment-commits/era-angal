    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 12,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「いいえ、その反対ですわ。自由奔放な『問題児』……♪」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 12,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「だから在学中はそんな常識外の存在だったゆゆさんのおばあさまを、」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「わたしのおばあさまはどうにか更生させようとしていたみたいですわね」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ですが、ゆゆさんのおばあさまには、悪気があったわけではないんですのよ」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ただ、純粋に……楽しさや目新しさを求めて。」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「そのせいで、わたしのおばあさまは、よく目くじらを立てていたそうですわ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
