    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ど、どうしたのかしら……かえでさん？」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「わたし、かえでさんを怒らせるようなこと、何か言いました？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/expressionless",
    "expression_position": {
