    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「そ、そうかしら……」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
