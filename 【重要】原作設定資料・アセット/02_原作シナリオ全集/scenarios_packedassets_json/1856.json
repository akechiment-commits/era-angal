    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「気になってたんだけど、木之下さんのおばあちゃんってどんなひとだったの？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんのおばあちゃんと仲が良かったってことは、やっぱり『いいとこ』の家のひとなのかしら？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんみたいに優等生なタイプ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": false,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 10,
