    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「よほど、おばあさまと話したいことがあったのでしょうね、ゆゆさんは。」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ずうっと、彼女はおばあさまを愛していて……その命が尽き果てるまで、一緒にいたのですから。」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「感慨もひとしおですわね……♪」"
  },
  {
    "command": "update_character",
