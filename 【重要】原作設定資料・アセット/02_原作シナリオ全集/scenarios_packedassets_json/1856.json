    "pose": 0,
    "active": false,
    "expression": "old-s-civvies_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「うん……いろいろ我慢してきたけど、やっぱり言っておかなくちゃいけないと思って。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしはさくらさんの親友だから、遠慮しないで言わせてもらうけどさ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「まだあの子のことを引きずってるの、さくらさんは？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「そろそろ、楽になったらいいと思うんだけど」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「だって、さくらさんはもう、じゅうぶんに反省したじゃない。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「過去ばかり見て、いつまでもあいつのこと引きずって、そんな後ろ向きな人生、つまらないじゃない！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「それをさ、うじうじうじうじ悩んでさ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「きっと仲直りできるだなんて言って、実際には何の行動も起こしてないじゃない！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「悲劇のヒロインぶりたかったらそれでもいいけど、あたしはね……」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/angry",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんがそうやって今も苦しめられてる姿、見たくないのよ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「もっとふっ切れるとか今を楽しむとか、したらいいじゃない！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしじゃ不服なの？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたし、さくらさんと一緒に過ごすことで……過去の苦しみをすこしでも忘れさせたいわよ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「でも、いつだってあんたは……さくらさんは過去を振り返ってばかりで！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「今、目の前にいるあたしのことなんて、ほとんど目に入ってない！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさん、あんたの目は節穴なの？　そのメガネ、度が間違ってるんじゃないの？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ねぇ、あたしじゃだめなの、さくらさん……」"
  },
