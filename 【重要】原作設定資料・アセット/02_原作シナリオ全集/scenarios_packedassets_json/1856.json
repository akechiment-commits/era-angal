    "active": false,
    "expression": "old-s-civvies_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「そうよ。思い出話をするときには、いつだってあいつのことばかり、言ってるじゃない」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": false,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 12,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「……かえでさんが言うのなら、そうかもしれませんわね。」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「彼女はわたしと一緒に、茶道部で青春のいちぶを過ごした、友人ですもの」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「だからこそ、今でもずっと……」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「心に『おもり』がついているように痛んで、」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ときどき思い出したように罪の意識に苦しめられるのかも、しれませんわね……」"
  },
