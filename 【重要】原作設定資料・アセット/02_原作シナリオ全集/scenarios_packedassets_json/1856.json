    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんは、あいつを転校させてしまったことをずっと気にしてんのね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
