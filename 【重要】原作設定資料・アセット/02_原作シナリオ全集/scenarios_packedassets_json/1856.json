    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさんに『そっくり』だったのね、さくらさんのおばあちゃんは？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 11,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": false,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": 10,
