  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（かいりがアイドル好きだから、っていうだけではありませんの。大事な、同じ合唱部の仲間だから。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（これから先もずっと、笑顔で、仲良く一緒の時間を過ごしたいから）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（見ていてください、つばさちゃん。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
