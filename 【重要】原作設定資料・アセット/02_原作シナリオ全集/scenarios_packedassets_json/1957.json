    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（付け焼き刃で、その場しのぎで……。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（これまで怠けていたぶんを、取り戻せるかどうかはわかりませんけど）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
