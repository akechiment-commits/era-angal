    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（こはるちゃん、ひめのちゃん、いさみちゃん……。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（落ちつきのない子たちですけど、さすがに場慣れしましたね。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（震えたり騒いだりせず、凜々しく前を見据えてますの）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（他の部員の子たちも、ついてきてくれてる。強行軍の連続にも弱音を吐かずに、一生懸命に……。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（部長も、さすがに本番になると見違えるほど堂々としてますのね）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（かいりが気を配る、必要なんてないぐらい。ひとの心配ができるほどの、余裕もありませんしね。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（部長やゆうちゃんに比べたら、経験が足りてませんし）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（かいりは、みんなも……。きっと、思いっきり歌う機会をずっと待ってましたの。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（気怠さや眠気、楽しい雑談とお菓子、そういった諸々に目を眩まされてましたけど）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（歌うのって、楽しいんですの。どんな国にも音楽はある、歌もある。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（これって人間の本能ですの、みんな歌うために合唱部に入ったはずですの）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（歌が、好きだから。だからこそ、全力で歌える日をずっと待ってましたの）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
