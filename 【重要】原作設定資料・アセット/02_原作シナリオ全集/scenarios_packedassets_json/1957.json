  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（かいりたち、合唱部になれましたよね）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（ううん、今こそ合唱部になるんですの）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（歌います。桐島かいり、心をこめて）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（花咲くような歌声を響かせましょう、みんな一緒に）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（『みんな一緒』というには、つばさちゃんが参加できないのが悔やまれるところですけど……。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（あの子はプロですもんね、アマチュアの大会を荒らせないんですの）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（本人は、参加したがってましたけど。ルール上、あの子は部員として認められません。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（事務所からも、きつく釘を刺されたみたいですし）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
