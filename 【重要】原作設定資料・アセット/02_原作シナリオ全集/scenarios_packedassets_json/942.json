    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「嫌がらせとも、思えないけど。それなら宝石じゃなくて、虫とか汚物とかいれるわよね？」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「誰かが、自分の鞄とまちがえたとか？」"
