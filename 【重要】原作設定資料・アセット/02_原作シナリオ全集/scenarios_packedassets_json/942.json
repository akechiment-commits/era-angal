    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「しかし何なのかしらね、この宝石は……？」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「あたし、ほんとに身に覚えがないのよ。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「でも、なぜかあたしの鞄のなかに入ってたみたい？」"
  },
  {
    "command": "update_character",
    "id": "center",
