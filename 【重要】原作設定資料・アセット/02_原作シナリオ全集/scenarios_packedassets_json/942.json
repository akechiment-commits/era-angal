  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「ん？　あなた、宝石店を知ってるの？」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「気になるなら、そこで鑑定してもらえばいいって……？」"
