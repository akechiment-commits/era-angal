    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「うん。あたし、生物部に戻れそうなの。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「生徒会長が例の校内放送とか、色々してくれたおかげでね？」"
  },
  {
    "command": "update_character",
    "id": "center",
