    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「この宝石、本物かしら？」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「本物なら高価なものだし、できれば持ち主に返してあげたいけど……？」"
  },
  {
    "command": "update_character",
