    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「あなた、男のくせに何で宝石店なんて知ってるのよ。女々しいわね、もっと男らしくしなさいよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 9,
    "dress": "old-default",
