    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「でも、これで清算できたわよね。せいせいした♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 9,
    "dress": "old-default",
    "pose": 0,
    "active": true,
