    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「しばらく、飼育小屋へは出入り禁止になってたんだけど。とりあえず、誤解もとけたみたい。」"
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「だからまぁ、あのアホにも感謝はしてるのよ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 9,
    "dress": "old-default",
    "pose": 0,
    "active": true,
