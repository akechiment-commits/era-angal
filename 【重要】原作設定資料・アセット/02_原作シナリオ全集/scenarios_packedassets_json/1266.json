  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「そう、ですね……人間、どうしようもないことで勘違いすることや、すれ違うこともある。」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「目的は同じでも、手段が違うこともある」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「たくさんの人間がはじめからまったく同じ考えで、同じ目標に同じ手段で向かっていることなんて……」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「そんなものは洗脳されたのと同じで」"
