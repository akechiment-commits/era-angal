    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「やっぱり校内では有名人ですもんね、去年まではこんなの想像もしてなかったですよぅ？」"
  },
  {
    "command": "update_character",
    "id": "right",
