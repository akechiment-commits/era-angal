    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「引き返すことも、逃げることもできないから。このまま卒業まで、支えあって歩いていこうね」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「生徒会で、みんなでね。いつだって、わたしたちはひよのちゃんの味方だよ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
