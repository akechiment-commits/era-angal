    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（るかちゃんが、姿を見せてくれなかったら……。）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（わたしの合図と同時に、軽音部の新入部員たちがステージに上がってくる）"
