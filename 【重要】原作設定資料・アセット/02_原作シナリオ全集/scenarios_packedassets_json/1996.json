    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（でも。わたしね、ちゃんと言ったことはなかったけど）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 29,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
    "expression": "old-bunny_expression/joyful",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（るかちゃんが、大好き）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（その歌声も、つくってくれる曲も歌詞も……。わたし、大好きだったよ）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（いつだって、るかちゃんは黒森先輩のことしか見てなかったけど）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（憧れのひとを追いかけてる、くりくりしたそのお目々が……。かわいく染まった、真っ赤な頬が）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（ふわふわの、女の子らしい、髪が……。すこしのことで傷ついて、すぐ垂れさがっちゃう眉が。）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（でも最後には弱気を振り払って、全力で前へ進むその姿が好きだったよ）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（あれが好きあれがやりたい、しずくちゃんも一緒にやろうって、いつでも手ぇ引いてくれたね……。）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（家族よりも、友達よりもずっと大事な、同じ魂を共有した仲間だった）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 29,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
    "expression": "old-bunny_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（でも。そのぜんぶを、わたしたちの幸せだった日々をかなぐり捨てて、前へ進まなくっちゃ。）"
  },
  {
    "command": "update_character",
    "id": "center",
