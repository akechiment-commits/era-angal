    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（るかちゃんのいない、ステージを……。そういう未来を、選ぶよ）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 29,
