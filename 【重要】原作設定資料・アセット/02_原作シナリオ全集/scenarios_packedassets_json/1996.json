    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（選ばなくっちゃ、今度こそ後悔しないために）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 29,
    "dress": "old-bunny",
