  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（なかなか、都合よくはいきませんね）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（それどころか、へたをすれば最下位に転落してしまうかも。）"
