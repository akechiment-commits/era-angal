    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「でも他にご予定とかありますよね、そうですよね。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「小松先輩、きれいですしね——恋人さんとのデートとかありますよねっ。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「ごめんなさい、他を当たってみます！」"
  },
