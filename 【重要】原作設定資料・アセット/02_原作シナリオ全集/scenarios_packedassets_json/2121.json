    "pose": "1",
    "expression": "lacrosse_expression/amazed",
    "expression_position": {
      "x": 0,
      "y": 454
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "るな",
    "text": "はん、図星みたいやなぁ。いつまでもお人好しすぎるで、転校生は。そのうち詐欺に引っかからんか心配になるくらいや？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 51,
    "dress": "lacrosse",
    "pose": "1",
