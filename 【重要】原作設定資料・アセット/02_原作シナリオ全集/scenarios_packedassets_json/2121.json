    "active": true
  },
  {
    "command": "talk",
    "speaker": "るな",
    "text": "なんて、聞かんでも察するわ。どうせまたぞろ生徒会の手伝いやら知り合いの手助けやら、慈善活動しとったんやろ"
  },
  {
    "command": "update_character",
