    "expression_position": {
      "x": 6,
      "y": 456
    }
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「あぁ、くたくたになるまで探し回ってしもた！」"
  },
  {
    "command": "update_character",
