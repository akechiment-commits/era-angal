    "pose": 0,
    "active": true,
    "expression": "old-closeeye-swim_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "かすみ",
    "text": "「改善点をこれから事細かに言うからぜんぶメモって、つくり直してね～……？」"
