    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「まぁいいや。それよりも、えっと……。強引に腕を引っぱってつれてきちゃってごめんなさい、あんずさん」"
  },
  {
    "command": "update_character",
