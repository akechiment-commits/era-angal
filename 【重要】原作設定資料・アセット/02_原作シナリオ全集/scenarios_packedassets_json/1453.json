    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「えっ？　趣味じゃないの……？」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「じゃあ何で、その……あんずさんっぽい格好してるの？」"
