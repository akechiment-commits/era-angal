  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「わたし、ただの幼なじみだしね。家族でも恋人でも、ないもん」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「でも、心配だよ」"
