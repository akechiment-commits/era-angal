    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「むしろ女装ネタとかパクパクいけちゃうほうだから、そういうの好きだからわたし！　ハァハァ……☆」"
  },
  {
    "command": "update_character",
