    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「でも！　そこまで追いつめられる前に相談してほしかったよぉ、うわあぁあ～ん！」"
