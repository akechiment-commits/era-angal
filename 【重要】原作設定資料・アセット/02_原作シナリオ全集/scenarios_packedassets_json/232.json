  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（あぁ、ぼんやり思いだしてきた。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（家庭科室でお菓子をつくって、転校生くんといっしょにあちこちに配り歩いたんだ。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（楽しかったなぁ、でもちょっと疲れたよ。学校中を巡ったからね）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（そのあと、生徒会のみんなとパーティを開いたんだ）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（余ったお菓子をぜんぶ持っていったら、ひまりのやつ喜んじゃってさ）"
  },
  {
    "command": "talk",
