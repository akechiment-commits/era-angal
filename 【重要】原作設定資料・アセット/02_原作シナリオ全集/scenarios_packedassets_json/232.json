  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（ともこも、双子もいて、途中かられいかまで参加してさ。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（賑やかだったなぁ、どんちゃん騒ぎだったよ。ほんと、飽きないよね。みんなと、いると……）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（んん？）"
