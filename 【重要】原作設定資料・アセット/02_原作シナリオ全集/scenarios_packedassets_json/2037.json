  {
    "command": "update_character",
    "id": "center",
    "character": 39,
    "dress": "default",
    "pose": "1",
    "expression": "default_expression/expressionless",
    "expression_position": {
      "x": 0,
      "y": 410
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "それに聞いたよ。部長ちゃんと一緒に、次の行事を準備してるんだよね。だから寝るのが遅くなっちゃって、うとうとしちゃったんでしょ"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 39,
    "dress": "default",
    "pose": "1",
    "expression": "default_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 410
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "どんなイベントなのか発表されてないから気になるなぁ、誰にも言わないから、ゆゆだけにこっそり教えてよ～☆"
  },
  {
    "command": "update_character",
