  {
    "command": "update_character",
    "id": "center",
    "character": 39,
    "dress": "default",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": 0,
      "y": 410
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "でも、すごいよね～。自分で考えたことを学校全体に広められるのって"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 39,
