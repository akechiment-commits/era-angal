    "active": true
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "ゆゆもそういうのやってみたいんだけど、あいかちゃんみたいに怖いものが苦手なひとが嫌がるかもしれないからね？"
  },
  {
    "command": "update_character",
