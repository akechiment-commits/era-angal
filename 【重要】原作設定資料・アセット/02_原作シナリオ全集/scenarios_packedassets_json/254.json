    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（あぁ、ぼんやり思いだしてきた）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（双子や、他のみんなが手伝ってくれて、地下へとつづく穴があいたんだ。）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（無事に、ちゃんと。朝陽が、のぼる前に）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（みんなで降りて、空洞のなかを調べてて。）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（でも、わたしは気が抜けちゃって、疲れてもいたから、ぐっすり眠っちゃったんだ）"
