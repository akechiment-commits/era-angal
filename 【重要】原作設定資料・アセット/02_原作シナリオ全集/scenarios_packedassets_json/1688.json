    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「まだ事務所は開いてないんだけど？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-detective",
    "pose": 0,
    "active": true,
    "expression": "old-detective_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「でも、よかった～。」"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「依頼人が来てくれるなら、これで今月もいちおう、ごはんの心配しなくていいかな……？」"
