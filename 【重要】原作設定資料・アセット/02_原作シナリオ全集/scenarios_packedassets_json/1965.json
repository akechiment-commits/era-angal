    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "old-future",
    "pose": 0,
    "active": true,
    "expression": "old-future_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "「だけど、『呪い』はわたしにとっての、長所でもあるって……教えてくれたのは、あなたたちだったんだよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "old-future",
    "pose": 0,
    "active": true,
    "expression": "old-future_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 498
