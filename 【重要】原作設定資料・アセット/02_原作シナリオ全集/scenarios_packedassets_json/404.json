    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「噂は聞いている！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「あちこちで色んな悩める生徒を応援して元気づけているのだろう、素晴らしいじゃないか！」"
  },
  {
    "command": "update_character",
