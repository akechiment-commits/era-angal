    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「ん？　あれは……？」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「て、転校生く〜んっ♪」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「何でこんなとこにいるのだっ、転校生くんも海に遊びにきたの〜っ？」"
  },
  {
    "command": "update_character",
    "id": "center",
