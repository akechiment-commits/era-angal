    "active": true,
    "expression": "old-swim2_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「何だか君は、私と似ている気がするなぁ♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 24,
    "dress": "old-swim2",
    "pose": 0,
    "active": true,
    "expression": "old-swim2_expression/surprise",
    "expression_position": {
      "x": -4,
