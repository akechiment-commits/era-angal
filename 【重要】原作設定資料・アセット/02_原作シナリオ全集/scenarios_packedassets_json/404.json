    "dress": "old-swim2",
    "pose": 0,
    "active": true,
    "expression": "old-swim2_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「ともあれ、よかった！　君がいてくれると心強いぞ〜♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 24,
