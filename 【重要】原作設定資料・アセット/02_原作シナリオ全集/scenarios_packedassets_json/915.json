  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「クイズの答えを考えていただく間に、少し、昔の話をしましょうか」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「あなたは知っているかもしれないけれど、」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「あんずさん……『アンジー』と呼ばれていた生徒は、君咲学院から転校していきました」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「昔から、同じ茶道部で、わたしといがみあっていた生徒で。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 12,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「だけど……すごく仲が悪かった、というわけではないんですのよ」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「わたしはお小言を彼女にぶつけていたけれど、でも、嫌いだからというわけではなくて」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ふたりとも、茶道部のことが好きでしたの」"
  },
  {
    "command": "update_character",
