    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「性格は真逆のようでしたけれど、そこだけは共通していましたから、」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「わたしは、あんずさんのことを、注意はするにせよ嫌いではありませんでした」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 12,
