    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「だけど、あんずさんは、黒森さんのような学院に馴染めていない生徒を守る『場所』を与えたかった。」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「茶道部を、そんな場所にしようとしていた」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「……わたしは、そんな彼女を許せませんでした」"
  },
  {
    "command": "update_character",
