  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/angry",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……背負って」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……いいから、早くわたしを背負え」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……このままじゃ、生き埋めになる。男に触れられるのは嫌だけど、わたしだって命は大事にしたいから」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……ほら、早く」"
