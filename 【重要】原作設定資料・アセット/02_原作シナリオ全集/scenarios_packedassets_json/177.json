    "id": "right",
    "character": 58,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "update_character",
