    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「？　よくわからないですけど、しおん先輩に褒められると嬉しいですっ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
