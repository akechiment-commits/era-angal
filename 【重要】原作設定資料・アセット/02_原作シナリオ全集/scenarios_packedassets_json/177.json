    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「あぁ——」"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「その。こないだわたし、ダニエルにうっかりお茶を零しちゃって——」"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「汚しちゃったんですよ。木之下さん、ぜんぜん怒らなかったんですけど」"
