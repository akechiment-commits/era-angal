      "y": 472
    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「うむ。ゆゆくんが怒る姿は想像もできないね。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「ぬいぐるみを常に抱きしめていることに、」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「ライナスの毛布のような心を安定させる効果があるのかな？　興味深いね」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「……ともあれ、それで？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-w",
    "pose": 0,
    "active": false,
    "expression": "old-w_expression/normal",
