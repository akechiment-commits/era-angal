    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「そうだろうね。」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「ゆゆくんにとって、すでにあのダニエルは身体のいちぶだろう。」"
