    "pose": 0,
    "active": true,
    "expression": "old-princess_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（わたしの脚本、舞台に使ってくれるんだもん。その宣伝だっていうし、協力するべき♪）"
