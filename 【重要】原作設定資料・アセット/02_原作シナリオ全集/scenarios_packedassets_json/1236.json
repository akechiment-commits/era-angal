    "pose": 0,
    "active": true,
    "expression": "old-princess_expression/amazed",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（でも湖南先輩、何でこんなドレスを着ていけなんて言ったんだろ……？）"
