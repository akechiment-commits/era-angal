  {
    "command": "update_character",
    "id": "center",
    "character": 35,
    "dress": "old-princess",
    "pose": 0,
    "active": true,
    "expression": "old-princess_expression/amazed",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（衣装だけ着て、みんなに見せてまわって、舞台の宣伝しろってことかな？）"
