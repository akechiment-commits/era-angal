    "dress": "old-princess",
    "pose": 0,
    "active": true,
    "expression": "old-princess_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "（まぁいいけど、このドレスかわいいし。コスプレが嫌いな文芸部はいませんっ♪）"
