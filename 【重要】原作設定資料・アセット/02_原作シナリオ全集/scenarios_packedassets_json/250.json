  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「……まったく、手間かけさせやがって」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「何か校内が騒がしいと思ったら、やっぱりおまえが原因か龍泉寺。」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「何のつもりだよ、いいかげんにしとけよ？」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「さっき、オカ研の連中が『桜の根元に埋まった屍体を掘る』っつうのを、」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「正式な部活動として学園側にも許可とったみたいだしさ。」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「今さら引っかき回されても困るんだよ、わかる？」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「おまえ生徒会の連中とか、無関係な生徒とか呼んで大騒ぎにするつもりみたいだったけど。」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「大人数がドタバタしながら穴掘ったら、それこそ地盤沈下して事故になるぞ？」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「いいから、勝手にやらせとけって。」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「オカ研含めた少人数でさ、そおっと穴掘れば事故にはなんないと思うし。ややこしくすんなよ、頼むから」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 27,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/amazed",
    "expression_position": {
      "x": -4,
      "y": 438
    }
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「つうか、どんだけ妨害しても、あいつらオカ研、絶対にまた何度でも同じことするから。」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「そのたびに騒ぎに巻きこまれても面倒だろ、さっさと終わらせようぜ〜？」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「おまえも諦めて、穴掘るの手伝えよ。」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「おまえ腕力はけっこうあるんだから、それを有効活用しろよ〜？」"
  },
  {
    "command": "talk",
    "speaker": "ひかる",
    "text": "「おい、聞いてんのか？　龍泉寺？」"
  },
  {
