  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "『よかったぁ、地中だから電波が通らなくて、』"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "『何とか空気穴にスマホ近づけて、ようやくアンテナ一本だけ立ったの！　奇跡的に！』"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "『えっと。何かぜんぜん、わたしたち掘りだされる気配がないんだけど！』"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "『そろそろ苦しくなってきたよ〜！』"
