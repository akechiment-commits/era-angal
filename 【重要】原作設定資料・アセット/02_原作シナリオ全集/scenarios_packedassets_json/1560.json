  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（血にまみれても。わたしの命が、擦り切れてなくなっちゃうまで。戦って、戦って、戦い抜いて生き残ろう。）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（そして命を次代に繋ぐ、未来の子孫たちへ）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（わたしの遠い子供かもしれない、わたしと同じ名前の『八朔つゆり』が……。）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（『君咲学院』っていうところで、転校生くんと出会えるような、奇跡があるかもしれないし）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（笑顔で、幸せに、暮らせる未来があるかもしれないし）"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "（わたし、そうなることを祈ってるよ。戦うよ、がんばるよ）"
  },
