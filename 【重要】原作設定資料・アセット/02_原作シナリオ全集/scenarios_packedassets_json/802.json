    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（おらは、いつまでも雛鳥じゃいけねぇんだ！）"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（つばさしゃんも、完璧な人間じゃない。）"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（目が届かないところがある、できないところもある。そこを、おらが埋めてみせる）"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（補いあうんだ。つばさしゃんが疲れたら、おらが。おらが疲れたら、つばさしゃんが）"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（支えあって羽ばたけば、無限に飛べる！　おらたちは、どこまでだって行ける！）"
  },
  {
    "command": "update_character",
    "id": "center",
