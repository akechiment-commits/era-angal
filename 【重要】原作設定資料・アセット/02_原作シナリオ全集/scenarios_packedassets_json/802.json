    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（ちょこっと、リードしたと思ったんだけどなぁ。）"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "（もうステージを……今回の対決の舞台を把握して、最適な動きをとってる）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 64,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
