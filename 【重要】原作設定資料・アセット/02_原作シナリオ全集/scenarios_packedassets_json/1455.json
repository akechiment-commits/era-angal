    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたも楽しんで、堪能してくれたらよろしくてよ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「そして、歯ぎしりして悔しがればいいわ。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「この君咲学院で巻き起こる愉快痛快な青春のなかに、自分の居場所がないことを」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「勝手に諦めて、『けじめ』をつけたつもりで、背を向けてしまったことを」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたとわたくしは似ているわね、あんずさん。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-exective",
    "pose": 0,
    "active": true,
    "expression": "old-exective_expression/sad",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「そのことに、もっと早く気づいていればね……。ちがった結果も、あったのかしら？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-exective",
    "pose": 0,
    "active": true,
    "expression": "old-exective_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「いいえ、こんなのは無意味な感傷ね。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「わたくしたちが犯した罪を、刻んでしまった傷跡を、『なかったこと』にしてはいけないんだわ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「せめて痛みを享受し、ともに蚊帳の外からでも愛でましょう」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「大丈夫よ、安心しなさい。わたくしの重荷を、ひまりが立派に背負ってくれたように。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「そして、もっと素晴らしいものに生まれ変わらせてくれたように」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたがすべてを押しつけた弟も、この君咲学院で……。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「たくさんの幸せを、青春という名の花を咲かせているわ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「それをゆっくり見学して、あなたもあなたの居場所に帰りなさい。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「今日は『授業参観』だもの、それが保護者の役目でしょう」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「満足して、家に帰って、たっぷり褒めてあげるといいわ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたの、かわいい弟を。我が校が誇る、宝物のような『転校生くん』をね」"
  }
