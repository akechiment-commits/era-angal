    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたもね、さくら。あぁでも、大人になるって寂しいことね……？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「もう二度と、こんなふうに後先考えずに行動はできない。わたくしには、円城寺の娘としての立場がある」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「いいえ。勝手に大人ぶって、子供じみた自分を覆い隠して……。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「逃げて、目を逸らしていたのはわたくし」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「ひまりが背中を押して、平和な青春のなかに迎えてくれたのに」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「けっきょく、最後の最後まで出遅れてしまったわ。まさに、後の祭りね」"
  },
  {
    "command": "update_character",
    "id": "left",
