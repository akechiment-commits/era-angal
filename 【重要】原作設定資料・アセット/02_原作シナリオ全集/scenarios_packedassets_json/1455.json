  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたたちは、いつもこんな景色のなかにいたのね……あんずさん♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-exective",
    "pose": 0,
    "active": true,
