  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「んん〜？　間違えましたか？」"
