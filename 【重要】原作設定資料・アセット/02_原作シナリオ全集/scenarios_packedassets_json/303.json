  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「えぇっとぉ……？」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「あっ、発見しましたよ〜？」"
  },
  {
    "command": "update_character",
