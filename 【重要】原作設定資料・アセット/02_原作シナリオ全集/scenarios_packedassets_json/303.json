    }
  },
  {
    "command": "set_still_image",
    "id": "card/evolved/321"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「んもう、先輩ったら。じゃあ、あ〜ん♪」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「ほら、食べられるでしょう？」"
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「わたしだって、いろいろ学習してるんですよ。」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「一年生ですもん、発展途上なんです。成長期なんですよ〜？」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「お芋掘りのときとか、朝顔を育てたときとか、」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/sad",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「わたし色々やりすぎちゃってみんなに迷惑かけちゃいましたけど」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「それで、覚えたんです。全力でがんばってがんばって、」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「でも、それは自己満足なんだなぁって。うまく、言えないですけど」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/expressionless",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「わたし、これまで自分ががんばることしか考えてなかったです。そうすれば、うまくいくって思ってました。」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「でも、受けとめるひとのことも考えなくちゃいけないんだって、わかったんです」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「保健委員会のお仕事も、お花を育てることも、料理だって、そうなんです。」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「治さなきゃ、育てなきゃ、美味しくつくらなきゃって、」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「気合をいれればいれるほど巧くいく……わけじゃあ、ないんですよね」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「先輩たちが、教えてくれたんです」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「だから今日は、ちょっとだけ上手にできたと思います。みんな、喜んでくれました〜♪」"
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「何だかわたし、『こういうことなんだ』って、わかっちゃった気がしますよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「えへへ。調子に乗りすぎですか？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 19,
    "dress": "old-bloomer",
    "pose": 0,
    "active": true,
    "expression": "old-bloomer_expression/normal",
    "expression_position": {
      "x": -4,
