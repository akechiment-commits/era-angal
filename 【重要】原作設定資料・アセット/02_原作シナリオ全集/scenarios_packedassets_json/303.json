    "active": true,
    "expression": "old-bloomer_expression/surprise",
    "expression_position": {
      "x": -4,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "くるみ",
    "text": "「む、無理だったらいいんですよ〜？　だいじょうぶですか、すごい顔色してますけど？」"
