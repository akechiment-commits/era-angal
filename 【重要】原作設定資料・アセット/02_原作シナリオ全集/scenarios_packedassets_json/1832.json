  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「私としても、手をこまねいているつもりはないよ」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「私はあらゆる物語を愛するが、原作を蔑ろにした二次創作ばかりが溢れかえる状態はあまり歓迎したくない。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 58,
    "dress": "old-default",
    "pose": 0,
    "active": true,
