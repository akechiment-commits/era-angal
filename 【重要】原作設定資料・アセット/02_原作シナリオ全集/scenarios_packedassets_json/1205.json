    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「でも、これで部費は多めに回してもらえるみたいだから、ある意味よかったのかもしれないけど」"
