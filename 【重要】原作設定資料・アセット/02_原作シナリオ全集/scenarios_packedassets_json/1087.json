    "pose": 0,
    "active": true,
    "expression": "old-yukata_expression/normal",
    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「こっちが心を開かないと、なかなか相手も距離を詰めにくいよ？」"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「だからわたし、くるみちゃんに対しては思ったことぜんぶ言うことにしてるよ。」"
