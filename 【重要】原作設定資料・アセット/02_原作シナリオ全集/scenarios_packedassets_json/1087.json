    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「くるみ様も、わたくしよりもみどり様に心を開いているように思います……♪」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 18,
    "dress": "old-yukata",
    "pose": 0,
    "active": true,
    "expression": "old-yukata_expression/sad",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「くるみ様は、わたくしに対してはまだどこか素っ気ないですから」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「仕事は、一生懸命してくれるのですが。」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「そんなにがんばらなくても、わたくしはあの子を愛しておりますのに」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「不安にさせている、わたくしの愛を感じていただけていない。そんな気がいたします。」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「もっと、姉のように母のように慕ってほしいのに」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「やはり、みどり様のように、くるみ様の料理をちゃんと食べてさしあげるべきなのでしょうか……？」"
  },
  {
