    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「それ、くるみちゃん本人にも言われたんだけど。わたし、そんなに老けてる？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 52,
    "dress": "old-yukata",
    "pose": 0,
    "active": false,
    "expression": "old-yukata_expression/amazed",
