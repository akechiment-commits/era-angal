    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「包容力があるということです。みどり様は、慈母のようです。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 18,
    "dress": "old-yukata",
    "pose": 0,
    "active": true,
