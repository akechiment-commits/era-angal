    "expression_position": {
      "x": 6,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「まずは、くるみ『様』っていう他人行儀な呼びかたをやめたらいいと思うけどね。」"
