  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「べつに無理しなくても、くるみちゃんはひとを素直に愛せる良い子だから。」"
  },
  {
    "command": "talk",
    "speaker": "みどり",
    "text": "「そんなに、思いつめなくても大丈夫だよ？」"
  },
  {
    "command": "update_character",
