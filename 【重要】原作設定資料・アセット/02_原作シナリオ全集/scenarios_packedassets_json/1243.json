    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あのひとの心情ばかりは、わたしの想像の及ぶところではありません」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
