  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「あぁ、衣装のことなら気にしないで。」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「こっちも『宣伝活動』にあんたを利用させてもらうからさ、持ちつ持たれつよ」"
