  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「いえあの、猫にやられたのです。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「わたしの好物を食べようとしたので、『駄目ですよ』とたしなめたら不機嫌になってしまいまして」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「爪で引っ掻いて制服をボロボロにするわ、お皿を引っくり返すわの大暴れです。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あんなに優しくしてあげたのに、膝の上で寝かせてあげたのに」"
