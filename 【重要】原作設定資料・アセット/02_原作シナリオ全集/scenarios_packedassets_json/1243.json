    "active": false,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「はあ。校内の警備などもありますから『ずっと』は無理ですが、ご恩には奉公で報いるのが武士道です」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-princess",
    "pose": 0,
    "active": false,
    "expression": "old-princess_expression/amazed",
