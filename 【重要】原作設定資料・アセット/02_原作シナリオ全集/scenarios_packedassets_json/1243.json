    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「やはり、畜生とはわかりあえません」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-princess",
    "pose": 0,
    "active": false,
    "expression": "old-princess_expression/angry",
