    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「じゃあ、おんぶしてあげますからあ、上から写真撮ってくださいねえ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 43,
