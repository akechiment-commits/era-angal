    "asset_code": "web:voice/character/4/emo_response-1.wav"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "うん。みなみんに頼んで、こしらえてもらったぞお。適当なタイミングでみんな着替えてね、せっかくの『雛祭り』なのだから♪"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "winter",
    "pose": "1",
    "expression": "winter_expression/honest",
    "expression_position": {
      "x": -4,
      "y": 446
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "ふふ。良かった、ちゃんと『転校生くん』が参加してくれて……。準備段階では珍しく顔を見せなかったから、不参加も有り得ると思ってたんだぞお？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "winter",
    "pose": "1",
    "expression": "winter_expression/joyful",
    "expression_position": {
      "x": -4,
