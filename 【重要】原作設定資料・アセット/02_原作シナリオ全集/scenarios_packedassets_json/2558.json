    "active": true
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "ん？　へぇ、お友達が困ってたからそっちを手伝ってたの？　その子……こよこよって子は、『転校生くん』にとって大事なお友達なんだなあ♪"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "winter",
    "pose": "1",
    "expression": "winter_expression/serious",
