  {
    "command": "play_emotion_effect",
    "id": "center",
    "effect": "good",
    "position": {
      "x": -4,
      "y": 446
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "衣装が、無駄にならなくて良かった。それに、久しぶりに喋れて嬉しかったぞお……。私はもうじき卒業しちゃうけど、できたら今後もずっと仲良くしてね"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "winter",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": -4,
      "y": 446
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "うん。じゃあね、せえとかいちょおはお仕事があるからもう行きます。存分に楽しむがいい、いつものようにっ♪"
  },
  {
    "command": "update_character",
