    "pose": "2",
    "expression": "winter_expression/sad1",
    "expression_position": {
      "x": -4,
      "y": 446
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "良いんだけどなあ、おまえはもう『下僕くん』ではないんだし。私のお手伝いをする義理はないから、自由に、好きなことをしてくれるのが『いちばん』なのだあ"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "winter",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": -4,
      "y": 446
