    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「ていうか。はやてちゃんは『白』組、あたしたちは『赤』組でしょうが！」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
