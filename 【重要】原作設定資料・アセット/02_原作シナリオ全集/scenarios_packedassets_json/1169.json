    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「あぁでも、そうなると夜霧さんが今より『遠い存在』になっちゃうかも～？」"
  },
  {
    "command": "update_character",
    "id": "left",
