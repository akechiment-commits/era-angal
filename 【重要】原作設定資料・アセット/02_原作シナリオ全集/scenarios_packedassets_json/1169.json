    "pose": 0,
    "active": true,
    "expression": "old-sports_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「でもでもっ！　みんなの憧れ、完全無欠の生徒会長になった夜霧さんを遠くから眺めるだけでもいい！」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「たまに微笑んでくれるだけでいいっ、きっとステキな生徒会長になっちゃいますぅ……はわわわわっ♪」"
  },
  {
    "command": "update_character",
