    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「見ればわかりますよ。その瞳……わたしと同じ、負けず嫌いの目です♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-rpg",
    "pose": 0,
    "active": true,
