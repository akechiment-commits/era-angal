    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「なんて、冗談もほどほどにしておこう」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「私たちが負ければ、星海くんが解放される。それでいいかい？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
