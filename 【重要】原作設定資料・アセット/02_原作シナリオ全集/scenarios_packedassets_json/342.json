    "expression_position": {
      "x": 12,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「あっ、でも本って日焼けすると紙が駄目になっちゃうんだよね——日向ぼっこしながら読書したいんだけど。」"
  },
  {
    "command": "update_character",
