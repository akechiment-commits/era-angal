    "expression_position": {
      "x": 12,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「あっ、おに〜さんっ。暇だったらそこでこの本を音読してくれないかな〜？」"
  },
  {
    "command": "update_character",
    "id": "center",
