      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（ありがとね）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（できれば、来年度も……。平和に仲良く、一緒に幸せな毎日を過ごしましょう）"
