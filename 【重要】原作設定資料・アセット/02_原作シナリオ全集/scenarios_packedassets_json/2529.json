  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（あぁ三波たちの、声援が聞こえる。みんなに、支えられてるのよね。応援しにきてくれて、ありがとね）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（あんたたちが、あたしのフォーカルポイントよ。それを見ると安心して、集中できるっていう……。照れくさくて、面と向かっては言えないけど）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
    "dress": "volley",
    "pose": "1",
    "expression": "volley_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（大好きよ。三波、春風、転校生……。みんな、だぁい好きよ）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（毎日、登校して……。あんたたちの顔を見るたびに、あたしは嬉しくなっちゃったわ。浮き浮きして、安心して、青春を満喫できたのよ）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
