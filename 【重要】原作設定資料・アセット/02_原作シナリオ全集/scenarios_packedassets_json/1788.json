    "expression_position": {
      "x": -10,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「まぁいいけど、あたしも引っ越しの準備ちゅうでさ～。さっさと帰りたいわさ、だから手短に済ますから」"
  },
  {
    "command": "update_character",
