  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": -10,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「あたしも、もう刀を振り回してはしゃげるほど若くないわさ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -10,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「でも、あたしたちの後継者が君咲学院をどう変えたのか……。ちょっと、見定めてみたくなってね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
