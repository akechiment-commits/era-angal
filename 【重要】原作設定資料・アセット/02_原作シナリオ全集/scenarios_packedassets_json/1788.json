    }
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「あんた変わったね、『図書室』の」"
  },
  {
    "command": "talk",
    "speaker": "ぎん",
    "text": "「前なら絶対、あたしの呼びだしなんて受けなかったのにさ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 61,
