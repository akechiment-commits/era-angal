    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「そのスクリーンの中心で、笑っている花音団員が見られたら……♪」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「私は、とっても満足だ！　やっぱり、元気な笑顔がいちばんいいっ☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 24,
    "dress": "old-sheriff",
    "pose": 0,
    "active": true,
    "expression": "old-sheriff_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「君咲学院ですごした、幸せな日々が！　青春が、この花咲くような賑やかで楽しい雰囲気が！」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「すこしでも映像として残るなら、嬉しい！」"
