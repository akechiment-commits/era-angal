    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（あぁ、そっか……。ようやく、モヤモヤしてたものの正体がわかったかも？）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（日滝先輩も、他の『三大賞金首』も……。みんな、三年生なんだ。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（ううん、もう君咲学院を卒業しちゃってるんだ）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（連休明けから、先輩たちが登校するのは君咲学院じゃない。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（わたしたちの知らない、大学とかなんだ。）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（それって、とっても寂しいな……？）"
  },
  {
    "command": "update_character",
    "id": "center",
