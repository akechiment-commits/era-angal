    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「もう思い残すことなど、何もないのだ！　わはははは☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-sheriff",
