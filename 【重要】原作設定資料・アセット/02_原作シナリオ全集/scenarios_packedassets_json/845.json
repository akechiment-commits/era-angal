    "expression_position": {
      "x": -4,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「そのお詫びというわけでもないが、曽根セイラについては私が『けじめ』をつける」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「それで、一区切りだ。」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「君咲学院のみんなのおかげで、花音団員の出演する映画は、最高にハッピーなものになる！」"
  },
  {
    "command": "update_character",
    "id": "center",
