  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「よし、すぐに衣装を受け取りにいこう。あぁでも、何か忙しそうだな……。いま行ったら、迷惑かな？」"
  },
  {
    "command": "update_character",
    "id": "center",
