  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「ときどき新聞部にアカウント乗っ取りとかのアタックを受けるから、とりあえずその対策もして、と。」"
  },
  {
    "command": "update_character",
