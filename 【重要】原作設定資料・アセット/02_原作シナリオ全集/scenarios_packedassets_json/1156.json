    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「お、お集まりの皆さん！　これはちがうんですわっ、何かのまちがい！」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「そこで騒いでる連中は我が校と縁もゆかりもなくっ、というか例外的な存在でありましてっ！」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「えぇっと、えぇっとぉ？」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「わ、我が校は～っ、伝統と格式ある女学院です！」"
  },
  {
    "command": "talk",
