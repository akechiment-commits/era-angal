  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（あれ。いつの間にか……るかちゃんと部長、ふつうに喋ってるな）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（たぶん、似たものどうしなんだよね。）"
