  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「さぁルカちゃん、あたしたちも舞台に立とう。手を、ひいてあげる」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「響かせよう、あたしたちの歌声を。忘れられてしまう人形たちに、鎮魂歌を捧げよう」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「お人形を相手に、一生懸命に歌って、演奏して……。」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「きっと、『馬鹿なことをしてる』って笑うひともいるでしょう」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「『時間の無駄』だって、『何の意味もない』って。でも、あたしは、それでいいと思うの」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「どこまでも無駄で、意味なんかなくて、でも楽しくて幸せなの。」"
  },
