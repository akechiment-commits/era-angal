    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「音と光と、ギャンブルしてるひとたちの欲望にあてられて、ふらふらしちゃう……。」"
