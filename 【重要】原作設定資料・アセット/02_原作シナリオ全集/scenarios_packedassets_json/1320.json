  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『半分冗談くらいに受け取ってください』"
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "『読んでもらえるだけで、足長おじさんに思いが伝わるだけで、わたしは十分にうれしいです』"
