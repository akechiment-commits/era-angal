  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 50,
    "dress": "old-w",
    "pose": 0,
    "active": false,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「やめてよ。これってやっぱり、ただの八つ当たりだと思うからさ」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「昔っから、気に食わねぇのよ。」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「親とか教師とか、偉そうな連中に無理やり頭を押さえつけられて言うこと聞かされるのはね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w",
    "pose": 0,
    "active": false,
    "expression": "old-w_expression/sad",
    "expression_position": {
