    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「頼りにしてますの～、湖南先輩。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 50,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「合唱部のために尽力してくれて嬉しいです、とっても感謝してますのよ♪」"
