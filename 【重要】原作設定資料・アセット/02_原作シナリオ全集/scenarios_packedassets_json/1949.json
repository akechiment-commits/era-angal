    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「まぁ、駄々っ子のお世話をするのは好きですけど……♪」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 50,
