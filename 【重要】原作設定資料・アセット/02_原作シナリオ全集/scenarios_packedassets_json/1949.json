    "id": "left",
    "character": 50,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/sad",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「はぁい。んもう、合唱部はみんな手がかかりすぎますの。」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 50,
