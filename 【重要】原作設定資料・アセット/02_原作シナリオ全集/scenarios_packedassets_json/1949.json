    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「……あら？　部長、どうして隅っこのほうで膝を抱えてブルブル震えてますの？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/surprise",
