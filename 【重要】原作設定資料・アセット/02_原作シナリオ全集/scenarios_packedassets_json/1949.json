    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「あはは、そう悪びれなくていいんですの。湖南先輩は、いいひとですの……♪」"
