    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "「部長～？　怖くありませんのよ、泣きやんでくださいね？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 50,
    "dress": "old-w",
    "pose": 0,
    "active": true,
