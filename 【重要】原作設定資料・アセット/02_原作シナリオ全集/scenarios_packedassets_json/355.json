    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「うん。ひめのさん、張りきっちゃってねぇ。思いっきり豪快に、笹を立てようとしたんだよ。」"
  },
  {
    "command": "update_character",
    "id": "center",
