    "expression_position": {
      "x": 6,
      "y": 518
    }
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「ひめのさんはねぇ。たぶんまだ、校内をうろついて短冊を探してるんだよねぇ」"
  },
  {
    "command": "talk",
    "speaker": "まり",
    "text": "「そんな後輩の子を置いて、あたしだけ帰るわけにもいかないしさ。」"
