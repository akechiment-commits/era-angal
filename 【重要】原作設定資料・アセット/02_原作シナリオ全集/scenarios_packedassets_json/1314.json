  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「購買のおばちゃんも『あんた、ちっちゃいねぇ！　たっぷり食べておおきくなんなよ！』って」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「売れ残りのサンドイッチとかくれんねん」"
