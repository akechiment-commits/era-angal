    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「さすがに去年と同じような『ちゃんとした』文化祭の流れを汲んでしまっては、つまらないんじゃないかしら？」"
  },
  {
    "command": "update_character",
