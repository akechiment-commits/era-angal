  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「あたしと同じように、お姉ちゃんとか、他の誰かを心配して尾行してる……。」"
  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「ってわけでも、なさそうだし？　う～ん？」"
  },
  {
    "command": "talk",
