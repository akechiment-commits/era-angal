  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「あたしが華麗に、退治してやる！」"
  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「『あなた……は？』『フフ、通りすがりの着ぐるみです』」"
  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「『もしかして、いちかなの？』『それは言えません。』」"
  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「『けれど、男なんかとデートするより、さっさと家に帰って妹さんを甘やかしてあげてください』」"
  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「『うん！　いつでも、わたしはいちかが世界でいちばん大好きだよ！』」"
  },
  {
    "command": "talk",
    "speaker": "？？？",
    "text": "「『助けてくれてありがとうね、ちゅっちゅ♪』みたいな展開も、期待できる！」"
  },
  {
    "command": "talk",
