    "character": 31,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（いつもはまわりの電波で、不快な気分になってたけど。意外と、役に立つんだね……♪）"
