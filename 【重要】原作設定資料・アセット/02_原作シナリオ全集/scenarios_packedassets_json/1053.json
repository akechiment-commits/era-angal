    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（……ん？）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（こんなところに、穴……？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
