    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（さっきまで歩いてきた道は、ほんの少しだけど、勾配になっていた）"
