    "active": true,
    "expression": "old-s-civvies_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（だけど。わたしには、確信がある。きっと、見つけられる）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（電波には、敏感なほうだから）"
  },
  {
    "command": "update_character",
