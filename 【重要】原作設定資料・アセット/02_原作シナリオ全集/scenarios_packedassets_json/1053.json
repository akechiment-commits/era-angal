    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（たとえ見つけられたとして、中のデータが壊れてたら、見つけた、とは言えない）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（ちょっと、厄介かもしれない）"
