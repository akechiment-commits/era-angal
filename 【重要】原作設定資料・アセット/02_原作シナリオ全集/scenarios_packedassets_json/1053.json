  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-s-civvies_expression/surprise",
    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（どこかへ、繋がっている？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "old-s-civvies",
