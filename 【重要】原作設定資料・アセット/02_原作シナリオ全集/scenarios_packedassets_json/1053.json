    "expression_position": {
      "x": -4,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（わたしのこんなところも、役に立つことがあるなんて……少し、嬉しいかもしれない）"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "（たぶん、変なところは通っていないはずだから、道なりに、足下を探して……）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "old-s-civvies",
    "pose": 0,
    "active": true,
