    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「うん、そうそう……。カロアさんは『特別』だけど、ボクちゃんもなかなか優秀ね。」"
