    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 6,
      "y": 484
    }
  },
  {
    "command": "talk",
    "speaker": "あやめ",
    "text": "「この調子なら、けっこう早いうちにあたしもお役御免になりそうね～？」"
