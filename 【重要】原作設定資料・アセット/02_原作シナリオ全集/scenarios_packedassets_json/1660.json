    "pose": 0,
    "active": true,
    "expression": "old-lacrosse_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「独りぼっちは寂しいよ～！」"
