    "active": false,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 452
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「そりゃあ、そうですけど……。ラクロス部の評判がよくないのも、だいたい柊先輩のせいじゃないですか！」"
