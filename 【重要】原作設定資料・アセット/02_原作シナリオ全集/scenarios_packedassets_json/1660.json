  {
    "command": "update_character",
    "id": "right",
    "character": 33,
    "dress": "old-lacrosse",
    "pose": 0,
    "active": true,
    "expression": "old-lacrosse_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「あたしたちは個々の技術や要所要所の局面ではなかなか良い感じですけど、」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「連携が苦手でバラバラでしょ？」"
