  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そういう地道な活動こそが、何より大事なのだあ！」"
