    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「『生徒会長再任選挙』に勝利できそうだからといって、そこで気を抜いて怠けてしまえば……」"
