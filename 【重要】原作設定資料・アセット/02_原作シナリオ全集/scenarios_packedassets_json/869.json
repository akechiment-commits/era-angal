  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「『生徒会長再任選挙』の序盤は、」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「こうして私と下僕くんのふたりで校内を駆けめぐっていたものだよなあ♪」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「何だか懐かしいぞお☆」"
