    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「あたしは家でゲームしてると、」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「お姉ちゃんが『目が悪くなるよ』『天気もいいし、お外で遊ぼう？』とかうるさいんで。」"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "「仕方なく、ゲーセンにきたんですよ」"
