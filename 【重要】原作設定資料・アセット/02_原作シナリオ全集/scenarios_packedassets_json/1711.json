    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "「すみません。あたしひとつのことに集中すると、他のこと考えられなくなっちゃうっぽいです。」"
  },
