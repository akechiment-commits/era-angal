  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「どうすれば、いいんでしょう……？」"
  },
  {
    "command": "set_still_image",
    "id": "card/normal/740"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「誰にも頼らずに、ひとりでも大丈夫だってふりをしてきたから！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「誰にも頼れなくて、潰れてしまいそうで、怖い！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「怖いよお！　嫌です、嫌なのに！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私の大事に積み重ねてきたつもりのものは、ぜんぶ砂上の楼閣で、それが崩れてしまう！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「あとには何も残らない！　それが怖くて、嫌なのに、誰にも相談できない！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「だって、『ひとりでも大丈夫だ』って偉そうに言いつづけてきたのは、私なんだから！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「その嘘を、みんなに信じこませるために、全力を尽くしてきたのは私なんだから！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「ぜんぶ、自業自得なんだから！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「『しっかりもの』の仮面を、脱ぎたくても脱げない！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「う、うう……！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「うぇ、うぇえん……！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
