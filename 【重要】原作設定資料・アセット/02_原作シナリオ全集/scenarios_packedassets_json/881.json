    }
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「…………」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「……し、失礼、しました」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「取り乱して、しまいました」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私らしくもない。いいえ、いつもの私らしくありませんでした」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「いちど嘘をついてしまったからには、もう引きかえせません」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「嘘でも、嫌でも、『しっかりもの』の演技をつづけるべきなのに」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「それが嘘をついて、早川さんや、みんなを騙してきた私の義務なのに」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「せめてもの、『けじめ』なのに」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「先輩は、おかしなひとですね。気がつけば、いろいろ喋らされてしまいました。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「内緒にしていた心のなかみを、暴かれてしまいましたよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/amazed",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「ちょっと、おっかないです。今後は、あまり近づかないようにしたいところです」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「チョコバナナ、おいしかったです。ありがとうございました」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「食べ終えましたので、このへんで失礼させていただきますね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/surprise",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「……ひゃわっ!?」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「な、何ですか？　なぜ、私を肩車するのですか？　ちいさな子供じゃあるまいしっ!?」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/amazed",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「え？　先輩は、私を探しにきたのですか？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「そして、マーチングバンドにつれ戻しにきた……のですか？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/surprise",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「おのれっ、追っ手でしたか！　くううっ、騙されました！　卑怯者！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「うわわっ、肩車したままダッシュしないで～っ！」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「落ちちゃうっ、怖いっ！　グラグラすると、落ちつきません！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/amazed",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「……な、何という、失礼なひとでしょう？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「呆れて、ものも言えません。夏野部長が、あなたを警戒していたのも納得です」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「くうっ。落ちて怪我したくないので、もう抵抗しませんけど」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「しかし、理解できませんね。先輩は、なぜこんなことをするのでしょう？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「初対面の、私などのために。労力を尽くして……。非合理的です」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「下心があるようにも、見えませんし。よく、わかりませんね？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「生徒会長さんが、よく全校集会などで言っている、みんなが笑顔で青春を満喫できる君咲学院を～。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「みたいな理想に、従っているのでしょうか？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「無理ですよ、そんなのは。絵空事です」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「みんなが笑顔で、幸せでありつづけることなんて、不可能です」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私のように、嘘をつきすぎて、ほんとの笑顔や幸福を忘れてしまったようなものもおります」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「誰かが笑顔になれば、そのぶん誰かが泣き顔になるのです。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私はまだ幼い、一年生ですが、それぐらい理解しております」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「だから……」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/amazed",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「あぁ、もう。あなたは、話を聞いているのかいないのか……？」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「相づちぐらい、打ってくださいよ。やりにくいったら、ありゃしないです」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/joyful",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「でも。何だかちょっと、ほっとしました」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「お説教や、アドバイスはいりません。ただ私は、黙って、話を聞いてほしかった。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私の心のなかみを、ぜんぶ吐きだしたかっただけなのかも」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/joyful",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「ありがとう、先輩。話を聞いてくれて、私を探しにきてくれて」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私のために、ではないのでしょうけど。それでも、嬉しかったです」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「ほんとの私は、傷つきやすくて怖がりで、でも誰かに見つけてもらいたかったのでしょう」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「あぁ……」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「夏野部長、怒ってるでしょうね。どの面さげて、帰ればいいのでしょう」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「早川さんも、みんなも心配してるでしょう」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「私、とても無様です。居たたまれません」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「だから先輩、最後まで責任をとってください。守ってください、あらゆる困難から。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「それが嫌なら、ここで放り捨てていただいて結構です」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「愚痴を吐いたら、すっきりしましたから。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「怖いけど、私は私がついた嘘と誤魔化しに『けじめ』をつけようと思います」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「一歩ずつでも、逃げるのではなく、前へ進みたいと思います」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「だからあなたも、どうか、そのまま格好つけていてくださいね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-brass",
    "pose": 0,
    "active": true,
    "expression": "old-brass_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「でないと。」"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "「そんなあなたに見つけられて、すこし救われてしまった私が、何だかとっても『みじめ』ですから」"
  },
  {
