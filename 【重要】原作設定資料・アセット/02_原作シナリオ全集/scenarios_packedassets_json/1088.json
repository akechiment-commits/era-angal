  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "（どんどん先に行っちゃうから、慌てて追いかけようとしたら転んで！）"
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "（そのうちに、なっちゃん先輩ともはぐれちゃって～！）"
