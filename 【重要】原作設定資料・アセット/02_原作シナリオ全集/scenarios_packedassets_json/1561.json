    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「あっ、ほんとだ！　転校生の先輩も、やっぱりというか何というか……巻きこまれちゃったんですね？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 35,
    "dress": "old-princess2",
    "pose": 0,
    "active": true,
    "expression": "old-princess2_expression/normal",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「でも。同じ未来の記憶っていうか、正しい記憶をもってるひとがいると安心します。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 35,
    "dress": "old-princess2",
    "pose": 0,
    "active": true,
    "expression": "old-princess2_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「正直、頭がおかしくなりそうでしたから♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 35,
    "dress": "old-princess2",
    "pose": 0,
    "active": false,
    "expression": "old-princess2_expression/joyful",
    "expression_position": {
      "x": -14,
