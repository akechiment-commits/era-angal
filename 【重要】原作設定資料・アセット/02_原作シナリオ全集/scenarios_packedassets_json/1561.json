    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "「そこの茂みのなかに隠れましょう、転校生のひともいますよ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 35,
    "dress": "old-princess2",
    "pose": 0,
    "active": true,
    "expression": "old-princess2_expression/surprise",
