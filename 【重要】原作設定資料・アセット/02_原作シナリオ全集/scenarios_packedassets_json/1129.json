    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-a-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-a-civvies_expression/amazed",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「憧れだけでやってらんないよ。だから、ことりんを見てるとたまに心配だな……。」"
