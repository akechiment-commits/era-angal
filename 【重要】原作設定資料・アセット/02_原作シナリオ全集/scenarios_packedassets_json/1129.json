  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-a-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-a-civvies_expression/normal",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あの子の起点は憧れで、でも憧れだけじゃそんなに高く、いつまでも飛んでられない」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「だから……あたしの翼がもげるまでは、あの子が自力で飛べるようになるまでは、あたしが支えて導くの」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「そのためになら、あたしの命も人生もぜんぶ使いきっても後悔しないよ」"
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「あの子は、あたしの夢なんだ。キラキラ輝くお星さまみたいな夢なんだ、夢があるって幸せだね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 65,
    "dress": "old-a-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-a-civvies_expression/joyful",
    "expression_position": {
      "x": -34,
      "y": 460
    }
  },
  {
    "command": "talk",
    "speaker": "つばさ",
    "text": "「今日は、本当にありがとう」"
  },
