  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「曽根さん、けっこう成績いいんだよ。さいあく大学とか専門学校とかに、一芸入試もできるしね。」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「だから、とくに何の問題もなく卒業できるんだ」"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "「『補習』さえ、受ければね。」"
