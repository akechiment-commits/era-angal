    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「あいかくんが借りていく本の傾向から考えれば、統計的に答えは導きだせる。考えるまでもないね？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「少年、君もおいで。図鑑はかさばるからね、私だけでは運べない」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 35,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「よろしくお願いしま～す。わたし、他に借りたい本がないか図書室を巡って探してますね？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "update_character",
