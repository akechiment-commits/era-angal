    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「さすがです、しおん先輩。相変わらず、ほしい本を的確に見抜いてくれる～♪」"
  },
  {
    "command": "update_character",
    "id": "right",
