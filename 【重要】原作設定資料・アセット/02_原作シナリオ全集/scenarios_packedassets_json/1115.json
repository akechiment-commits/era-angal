    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "あいか",
    "text": "「わわっ、ほんとですか？　楽しみです～、どんなのだろ♪」"
  },
  {
