    "pose": 0,
    "active": false,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「ふむ、それなら……。そちらの棚に、あいかくんの愛読する作家の新作があるよ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
