    "expression_position": {
      "x": -14,
      "y": 440
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「簡単な推理だよ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "old-default",
    "pose": 0,
    "active": true,
