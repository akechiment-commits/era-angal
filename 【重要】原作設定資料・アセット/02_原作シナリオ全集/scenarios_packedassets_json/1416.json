  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（いつの間に、背後に？　あんな遠くから、一足飛びで？　気配もなく、わたしのすぐ後ろに……？）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（動けない）"
  },
  {
    "command": "talk",
