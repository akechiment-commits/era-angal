    "text": "「…………」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 6,
    "dress": "old-coat",
    "pose": 0,
    "active": true,
    "expression": "old-coat_expression/surprise",
    "expression_position": {
      "x": -6,
