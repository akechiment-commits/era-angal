  },
  {
    "command": "remove_character",
    "id": "left"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（……おかしい。なぜか、背筋が粟立ちます）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（一瞬、いちかさんが見慣れたわたしの後輩ではなく、別人に見えました。）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（もっと禍々しい、異様なものに……？）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（わたしの、勘違いですよね？　あなたは、わたしのよく知る、いちかさんですよね？）"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「いちかさ……」"
  },
  {
    "command": "remove_character",
    "id": "center"
  },
