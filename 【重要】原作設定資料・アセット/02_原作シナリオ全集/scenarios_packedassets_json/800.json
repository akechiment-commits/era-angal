    "active": true,
    "expression": "old-mizugi_expression/angry",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「お礼はいいから、がんばって。ここまで振り回されて、けっきょく『勝てなかった』じゃ悔しいよ」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「せめて後悔しないようにがんばって、花音さん」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 64,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
    "expression": "old-mizugi_expression/joyful",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
