    "pose": 0,
    "active": false,
    "expression": "old-mizugi_expression/angry",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「うん。おらは島で生まれたんだ、水上戦はお手のもんだぁ！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 64,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
    "expression": "old-mizugi_expression/normal",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「コースは『はじめちゃんチーム』『つばさちゃんチーム』『ことりちゃんチーム』の順番で並んでる。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「現在、出発してるのは神樹先輩だけ」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「つばさしゃんが出てくるまでに、こっちも出発する。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「遠い『はじめちゃんチーム』のコースの影響は、受けにくいから。」"
  },
