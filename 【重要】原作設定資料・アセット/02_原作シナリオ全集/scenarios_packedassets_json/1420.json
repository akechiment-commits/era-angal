  {
    "command": "talk",
    "speaker": "もも",
    "text": "「遠見くん、演劇部で『トミ子』とか呼ばれて扱き使われてるっぽいしね～？」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 23,
    "dress": "old-snow",
    "pose": 0,
    "active": true,
    "expression": "old-snow_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「勝手にライバル認定されちゃったみたいだね、でぇへへ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-c-snow",
    "pose": 0,
    "active": true,
