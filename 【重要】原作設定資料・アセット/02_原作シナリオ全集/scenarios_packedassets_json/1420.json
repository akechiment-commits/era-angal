    }
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "「はじめの一歩を踏みだしちゃいましたので～♪」"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "「ヘルプマンレディの、次回の活躍に乞うご期待！」"
  },
  {
    "command": "talk",
    "speaker": "ちか",
    "text": "「ということで、今日はたくさんがんばったぶん甘々に甘やかして～♪」"
  },
