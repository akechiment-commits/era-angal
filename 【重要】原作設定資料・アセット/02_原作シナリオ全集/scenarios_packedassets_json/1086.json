    "pose": 0,
    "active": true,
    "expression": "old-yukata2_expression/normal",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……星海さんとか、誘ってあげればよかったのに。そうでなくても、あんたなら引く手あまただろうに」"
