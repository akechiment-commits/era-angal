    "active": true,
    "expression": "old-yukata2_expression/expressionless",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……ふぅん。地元のお祭りが懐かしくて、つい足を運んじゃった感じ？」"
