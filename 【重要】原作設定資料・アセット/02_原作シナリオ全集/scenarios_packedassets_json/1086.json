  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-yukata2",
    "pose": 0,
    "active": true,
    "expression": "old-yukata2_expression/sad",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……わたしなんかと一緒に巡ることになって、災難だね」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
