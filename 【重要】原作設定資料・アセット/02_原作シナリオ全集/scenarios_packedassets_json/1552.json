    "pose": 0,
    "active": true,
    "expression": "old-shogun_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「でも、『みんなが笑顔で人生を満喫できる国』を目指してがんばってるのに！」"
