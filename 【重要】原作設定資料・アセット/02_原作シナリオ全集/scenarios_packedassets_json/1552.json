    "expression_position": {
      "x": 12,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「口だけなら何とでも言えるよ、ちゃんと成果をだして実力を証明しないとね～？」"
