    "active": true,
    "expression": "old-princess_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「その資格もないのに、正当な手続きも踏まずに『なりゆき』で」"
  },
  {
    "command": "talk",
    "speaker": "ゆゆ",
    "text": "「不満をもってるひと、たくさんいるんだよぉ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 4,
    "dress": "old-shogun",
