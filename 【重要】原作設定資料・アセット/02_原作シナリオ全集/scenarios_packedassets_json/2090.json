    "expression": "default_expression/sad2",
    "expression_position": {
      "x": 4,
      "y": 442
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "肌寒いからね、今日は。わたし寒がりだから、吹きこんでくる風に凍えちゃって。さっきから、咳が止まらないの。コホ、コホ"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "default",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": 4,
      "y": 442
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "あぁ、大丈夫……。あったかくして休んでたら、咳も止まると思うから。風邪とかじゃないから、うつったりしないから安心してね"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
