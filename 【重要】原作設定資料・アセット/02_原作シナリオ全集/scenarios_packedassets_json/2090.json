      "x": 4,
      "y": 442
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "えへへ。それはともかく、そこの窓を閉めてもらえるかな？"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "default",
