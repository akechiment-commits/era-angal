  {
    "command": "play_voice",
    "asset_code": "web:voice/character/18/emo_laugh-1.wav"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "それに、転校生さんに午前中のお礼をする機会を逸していましたからね。せめて疲れを癒していただけると、わたくしとしても嬉しいです♪"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 18,
    "dress": "spring-civvies2",
    "pose": "1",
    "expression": null,
