    "active": true,
    "expression": "old-princess_expression/sad",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（ごめんね、ちょっとだけ嘘をついちゃった。歴史の修復のためだけに、あたしは残ったんじゃない）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（戦わなくちゃ、いけないの。あなたたちを、それに巻きこむわけにはいかない）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（もう、たくさん迷惑かけちゃったし。これ以上は、ちょっと申し訳ないから）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（あたしは、幸せになれた。でも無数の並行世界にいる、無数の『天宮るり』のなかには……。）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（幸せな未来に、辿りつけなかったものもいる）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（そんな『天宮るり』たちが、過去を変えようとして押し寄せてくる。だから、あたしはそれを迎撃する）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 67,
    "dress": "old-princess",
    "pose": 0,
    "active": true,
    "expression": "old-princess_expression/angry",
    "expression_position": {
      "x": 14,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（負けない。きっと勝って、ほとりちゃんのいる未来に帰るんだ）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（待っててなんて、言わない。きっと追いつくから。今度は、あたしの番だから）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（負けるもんか。独りで蹲って、現実を見ないふりして、悔やんでばかりの……）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（そんな、みじめったらしい『天宮るり』に！　絶望なんかに、負けない！）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（『あたし』は戦いつづける、何度も何度も押し寄せる絶望と。）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（そしてきっと打ち勝って、乗り越えて、あったかいところへ帰るんだ）"
  },
  {
    "command": "talk",
    "speaker": "るり",
    "text": "（だから、『さよなら』は言わない。また逢えるから、それを信じてるから）"
