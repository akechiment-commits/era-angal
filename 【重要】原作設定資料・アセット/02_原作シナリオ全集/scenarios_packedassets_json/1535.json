  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（涙が、でてきちゃったから）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（もっと話したいこと、いっぱいあった気がするのに。何も言えなかったなぁ、きっと天罰だね。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（ずっと周りを欺いて、嘘ばかりついてきたから）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（大事な、ほんとの気持ち……。最後まで、ちゃんと伝えられなかったね）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（ううん。自分でも、わからなくなってる。仮面の奥に、自分の素顔を隠して……。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（演技をしつづけるうちに、忘れちゃった）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（ねぇ、転校生くん。わたしはね、君を……。どう思ってたのかな、何を話したかったのかな。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（あぁ、わかんないよ）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（風が、強くなってきた。ずっと我慢してた涙を、ようやく隠さなくてもよくなったのに。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（すぐに風で流れて、消えちゃう）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（かわいいスカートが、ひらひら翻って。ようやく着られたのに、かわいいって言ってもらえたのに。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（もう、誰にも見てもらえない）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（独りぼっちの、舞踏会だ。）"
  },
  {
    "command": "talk",
    "speaker": "みつる",
    "text": "（わたしみたいな、嘘つきで馬鹿で……。かわいくないお姫さまを、王子さまは迎えにきてくれないよね）"
  },
