  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「それが地下に最初からあったトンネルに繋がってたのっ」"
  },
  {
    "command": "talk",
    "speaker": "やえ",
    "text": "「知ってるよねっ、わりと有名っぽいし♪」"
