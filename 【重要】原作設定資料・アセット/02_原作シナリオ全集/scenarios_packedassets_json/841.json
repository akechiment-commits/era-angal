  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「うむっ、ガッツがあれば何でもできるっ☆」"
  },
  {
    "command": "talk",
    "speaker": "ましろ",
    "text": "「見せてくれ！　奇跡を！　人間のちからというものを……！」"
