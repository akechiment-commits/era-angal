  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「う、うるさい！　陛下はちょっとママに似てるから、頭あがんないのよ！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「うう～っ、恥かいた！　泣いてるとこ、さくらさんに見られるなんて！」"
