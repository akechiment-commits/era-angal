    "expression_position": {
      "x": 0,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「途中参加の子とか、他に予定があって途中で抜ける子もいるけどね～？」"
  },
  {
    "command": "update_character",
    "id": "right",
