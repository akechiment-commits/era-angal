    "pose": 0,
    "active": true,
    "expression": "old-a-civvies_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「まだまだ仲良くなる機会は、これから先いくらでもあると思うし～♪」"
