    "expression_position": {
      "x": 0,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「名目上は『メリメロ歓迎パーティ』だから、ふたりには最後まで参加してほしいな♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 40,
    "dress": "old-a-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-a-civvies_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "「もちろん、アイドルが忙しいのは重々承知！　他に予定があったら、無理しなくていいからね」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 40,
