  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「あれ～、しおんちゃん何を食べてるの？」"
  },
  {
    "command": "talk",
    "speaker": "セイラ",
    "text": "「今日の晩ご飯、『そんなの』だったかしら？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 66,
    "dress": "old-pajamas",
    "pose": 0,
    "active": false,
    "expression": "old-pajamas_expression/surprise",
