    "active": true,
    "expression": "old-pajamas_expression/joyful",
    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「それに、私は幼いころは病弱でね、よく入院していたのだよ。」"
  },
  {
    "command": "talk",
    "speaker": "しおん",
