  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "「うん。じゃあ、そのへんにいて。ざっと、説明するよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 56,
    "dress": "old-bloomer",
