    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「転校生くんも、どうせ体験入部することになるなら、ひとりよりふたりのほうが心強いでしょ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-default",
