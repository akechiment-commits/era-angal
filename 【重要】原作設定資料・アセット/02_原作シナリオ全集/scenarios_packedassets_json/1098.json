  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（はぁ……結局、朝の悩みごとについては、誰にも相談できなかったなぁ）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（わたしが、考えすぎなだけかもしれないし……）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（なんだか、気分が浮かないかも）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（転校生くんと過ごした夏祭りは、とても楽しくて。ふたりで子供のころに戻れたような感じだった）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（なんだか、彼の特別な存在になれたようで。すごく、舞い上がっちゃってた）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（だけど、その翌日に、転校生くんはゆりちゃんたちと夏祭りを過ごしたって聞いて……）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（あまり仲の良くなかったふたりが、仲良くなれたことは嬉しいけど）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（なんだか、もやもやするなぁ）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（みんなが、転校生くんとどんどん仲良くなっていって……）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（わたしより、転校生くんと仲のいいひとも、きっといると思う）"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "（わたしは彼の、特別なひとなんかじゃないのかもしれない……）"
  },
