    "dress": "default",
    "pose": "1",
    "expression": "default_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 488
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "おいでってば、転校生。ついでに、そこの給水塔の陰にレジャーシートがあるからさ……。ここまで運んできてよ、立ってるもんは親でも使えってね"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 62,
    "dress": "default",
    "pose": "1",
    "expression": null,
    "expression_position": {
