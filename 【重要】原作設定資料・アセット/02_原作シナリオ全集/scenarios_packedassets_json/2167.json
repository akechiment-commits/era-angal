    "expression": null,
    "expression_position": {
      "x": -10,
      "y": 488
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "うん。あたし海外育ちだからさ、バーネットは必読書よね"
