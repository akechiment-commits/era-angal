  {
    "command": "update_character",
    "id": "center",
    "character": 62,
    "dress": "default",
    "pose": "2",
    "expression": "default_expression/amazed",
    "expression_position": {
      "x": -10,
      "y": 488
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "いやまぁ、もうそんな悪ふざけをするつもりはないけどさ。無意味なことを全力でできるのって、若者だけの特権でしょ？"
  },
  {
    "command": "update_character",
    "id": "center",
