    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「うるさい！　あんたが『夏祭り』の準備を任された～、ってところまではわかるのよ。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あんたの家柄なら、まぁ当然でしょうね？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「でも。何でまた、よりにもよってウチが『夏祭り』運営本部とかいうもんになってるのよっ？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「自分ちでやればいいでしょっ、無駄に広いんだから！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「うちのママなんかさ～、ふだん独りぼっちで引きこもってるからね？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「いきなり知らないひとが大量にきて、目ぇ回しちゃったのよ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 36,
