  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「書類仕事とか苦手なんで、やってもらえたら助かるっす～♪」"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "「あたしいちばん下っ端みたいに、雑用みたいなことばっかりしちゃってるっす♪」"
