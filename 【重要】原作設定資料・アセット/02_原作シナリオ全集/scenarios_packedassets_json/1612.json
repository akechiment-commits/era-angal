    "pose": 0,
    "active": true,
    "expression": "old-white_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「まったくもう。勤労意欲を出させるっていうもくろみにしても、さすがにこれはやりすぎです。」"
  },
  {
    "command": "talk",
    "speaker": "ゆう",
    "text": "「ノイローゼになっちゃいそうですよ……」"
