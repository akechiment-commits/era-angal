    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（さすがに場慣れしてますのね～、誰よりも堂々としてますの。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（頼もしいですの、演劇部のほうも大変だったはずなのに）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（毎日、付きあって……。どこまでも同伴して飛び回って、ぎゅうぎゅう詰めのスケジュールを管理して。）"
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（言うこと聞かないみんなを、指導してくれましたの）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 50,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": -10,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "かいり",
    "text": "（さすがに、疲労感が色濃いですけど……。あとで、いたわってあげませんとね♪）"
  },
  {
    "command": "update_character",
    "id": "center",
