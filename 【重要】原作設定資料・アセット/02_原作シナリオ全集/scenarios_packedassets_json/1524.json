  {
    "command": "update_character",
    "id": "center",
    "character": 20,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/amazed",
    "expression_position": {
      "x": 6,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "（……ん？　何よあれ、食堂の隅っこに人だかりができてる？）"
