  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「あぁ、お月さんがきれいやなぁ。そっか、今日は十五夜のお月さんやねんなぁ♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
    "expression": "old-bunny_expression/normal",
    "expression_position": {
      "x": 6,
      "y": 456
    }
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「ぼんやり、思いだしてきたわぁ。そや、お月見すんねんな」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「七夕と同じで、お月さん……」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
    "dress": "old-bunny",
    "pose": 0,
    "active": true,
