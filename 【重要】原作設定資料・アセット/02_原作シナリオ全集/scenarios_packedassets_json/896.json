  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「お店の飾りつけとか、備品の手配とかは、先輩たちがやってくれたしね」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「う～ん。いちおう、メール送ったら返信くれるし。」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「『がんばって接客する』って、メールに書いてあったし」"
  },
  {
    "command": "talk",
    "speaker": "ちあき",
    "text": "「時間になったら『ちゃんと』きてくれる、って信じたいけど」"
