  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「けれど約束どおり、くるみちゃんのチョコをすべて平らげることができました。」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「あの子は、とても喜んでくださいました」"
  },
  {
    "command": "update_character",
