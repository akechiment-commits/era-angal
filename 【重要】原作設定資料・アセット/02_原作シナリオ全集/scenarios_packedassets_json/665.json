  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「うう。何のお役にも立てずに、すみません」"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「……お互いに、大変なバレンタインになっておりますね」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 18,
    "dress": "old-w",
    "pose": 0,
    "active": true,
