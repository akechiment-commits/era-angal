    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「はあ……お腹が、苦しいです。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 18,
    "dress": "old-w",
