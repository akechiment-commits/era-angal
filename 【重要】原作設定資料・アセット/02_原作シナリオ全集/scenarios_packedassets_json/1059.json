    "active": true,
    "expression": "old-s-civvies_expression/expressionless",
    "expression_position": {
      "x": -6,
      "y": 426
    }
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「……ううん。そんなことは、しないつもりだよ」"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「日滝さんは、感情の揺さぶりかたをよくわかってるよ。チア部だものね」"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「わたしたちに、エゴを通させて……オカルト研究会のことを、正しいと思わせる」"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「そうやって、わたしたちに自信を付けさせるつもりだったんだよね」"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「自信があれば、『自分たちは正しい』って気分になる」"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「失敗続きの合宿も、正当化される」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 24,
    "dress": "old-abo",
