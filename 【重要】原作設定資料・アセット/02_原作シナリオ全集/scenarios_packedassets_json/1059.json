    }
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「好きなもののことを馬鹿にされて、怒らないわけがないよ」"
  },
  {
    "command": "talk",
    "speaker": "みなづき",
    "text": "「わたし……今はずいぶんと、怒ってるよ」"
