    "expression_position": {
      "x": -4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「おや、神無月くんじゃないか。どうやら勉強をしていて、眠りこけてしまったみたいだね。」"
  },
  {
    "command": "update_character",
