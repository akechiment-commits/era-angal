    }
  },
  {
    "command": "talk",
    "speaker": "いかり",
    "text": "「ぶちょ～？　どこ行ったんですか～っ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「やばいの。いかりんぐが近づいてくるの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「悪いけど、『あっちに行った』って言ってほしいの……ってもう近くまで来てるの！」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「策を考えてる暇はないの！　ついてきて！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-default",
