  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「この調子で、１００メートル踏破を目指しましょう♪」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「でも油断すると……きゃあ～ん♪　落ちちゃった～、これで失格！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
    "expression": "old-mizugi_expression/normal",
