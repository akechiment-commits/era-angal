    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
    "expression": "old-mizugi_expression/joyful",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「ただし制限時間も例によって三十分しかないので、なるべく急いでね♪」"
