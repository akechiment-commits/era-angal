  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-mizugi",
    "pose": 0,
    "active": true,
    "expression": "old-mizugi_expression/joyful",
    "expression_position": {
      "x": 54,
      "y": 524
