  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「このように、まずはスタート地点に立つ！」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「カメラに笑顔で手を振って～、任意のタイミングで最初の足場＝『浮き』に立つ！」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あとは自分の思うがまま、気の向くままに進むだけよ！」"
  },
