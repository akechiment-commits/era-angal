    "expression_position": {
      "x": -6,
      "y": 442
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「非常時にしか、立体映像はださないって約束じゃなかったっけ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 1,
    "dress": "old-s-child",
