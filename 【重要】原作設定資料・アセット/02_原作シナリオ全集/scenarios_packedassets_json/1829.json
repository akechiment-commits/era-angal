    "expression_position": {
      "x": -6,
      "y": 442
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「ほら、触られると生身の人間じゃないってばれちゃうから。この人混みだし、気をつけないと」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 1,
