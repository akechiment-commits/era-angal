    "expression": "s-civvies_expression/joyful",
    "expression_position": {
      "x": 10,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "まい",
    "text": "真面目でさ、頭よくてさ、すてきなお姉ちゃんだよ。あたしゃ尊敬してる、お姉ちゃんがいれば我が家は安泰だ♪"
