    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「ただ、おいしいものを食べるのが好きだから……。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「自分でつくれたら幸せだし、むかしから料理は好きでよくしてた。だから、料理研にも入ったのに」"
