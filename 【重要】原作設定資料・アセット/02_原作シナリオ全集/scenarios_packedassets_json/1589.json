  {
    "command": "update_character",
    "id": "center",
    "character": 34,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「めげちゃいそう。あぁもう、入る部活をまちがえたかなぁ？」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「料理研の他の部員は、やる気がないのかなぁ……？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 34,
