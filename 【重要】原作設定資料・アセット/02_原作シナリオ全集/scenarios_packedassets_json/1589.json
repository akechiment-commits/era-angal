    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「あぁ、『料理大会』はコンビで出場するんですよ。二人一組で……。」"
