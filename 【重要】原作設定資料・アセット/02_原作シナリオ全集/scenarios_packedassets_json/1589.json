    "character": 34,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「そうですそうです、料理研の先輩たちが誰も手伝ってくれなくて～？」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「う～ん、新入部員もわたしだけみたいだし。」"
