    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「わたし、お兄ちゃん先輩とはいつも姫ちゃんとかちあきちゃんとかの『ついで』にお会いするだけですし。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「あんまり、これまで個人的なご縁はなかったですけど」"
