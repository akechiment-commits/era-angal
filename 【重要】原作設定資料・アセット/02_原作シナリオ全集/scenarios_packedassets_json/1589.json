    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「わたし、どんなひとが料理研にいるのかもよく知らないんだけど！」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「仕事だけ押しつけられて～っ、『いちばん下っ端』として扱き使われてる！」"
