    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「あとでお礼に、おいしいお菓子とかつくって食べさせてあげますね♪」"
