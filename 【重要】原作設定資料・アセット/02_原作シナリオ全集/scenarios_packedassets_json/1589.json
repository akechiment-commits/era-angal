    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「調理器具の準備だけで、もう大変！」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「ぜんぜんお皿とかフライパンとか足りなくて、おばあちゃんのお店から借りたりもしたけど！」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「消毒して洗浄して、公平になるように参加者の人数ぶん同じものを用意して！」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「う～、目が回りそう！　不備があったら料理研の責任になっちゃうし、わたし新入部員なのに～！」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「どうして、料理研の先輩たちは誰も手伝ってくれないの～!?」"
