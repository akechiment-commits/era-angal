    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 20,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "いかり",
    "text": "「それでいつも失敗しちゃうんです！　にししっ、悪い癖ですし！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 42,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 20,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "いかり",
    "text": "「ん？　今も補習中だから大声で騒ぐのはよくない？　言われてみれば！」"
  },
  {
