    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「まぁいいわ、その子には用はないのよ。逃がしておあげなさいな。話があるのは、そっちの『転校生くん』だけよ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（うひゃっ、急に解放されたっ!?）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（でも、このまま帰るのも消化不良だしなぁ……。もうちょっと、様子を窺ってみよう。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（転校生さん警戒心なさそうだし、あたしが守らなくちゃ！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（あきらかに、ヤバそうな雰囲気だし。お姉ちゃんならこういうとき、自分だけ逃げたりはしないはず！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（う〜っ、矢でも鉄砲でも持ってこいって感じっ！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「まぁ、楽にしなさいな。時間はとらせないわ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「強引に呼びだして、悪いわね。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「わたくしも生徒会の後見人っぽいポジションにいるから、生徒会室で会えたかもしれないけど」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「ちょっと、ひまりには聞かせられない話がしたくてね？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「ふむ、その様子だと……すでに、おおまかな事情は聞き知っているようね。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「体育委員長の、夜霧さんあたりがすでに接触してるのかしら？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あの子は優秀よね、わたくしと同じ匂いがするわ。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「だからこそ、わたくしと同じ失敗をしそうなのだけど。まぁ、よろしくてよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/expressionless",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「単刀直入に言うわよ。あなた、わたくしたちの味方になりなさい」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「いま校内で話題の……『帰宅部争奪戦』、っていうの？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「まぁ、呼びやすい名前があるのはいいことだわ？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「その『帰宅部争奪戦』において、わたくしたちに肩入れしなさい」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「そこのふたり……かえでさんと、さくらさんは、文化系の部活動を牛耳ってるわ。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「それぞれ風紀委員長と、美化委員長としてね。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「このふたつの委員会は校則により、文化系の部長会議などを取りまとめる、発言力と権力があるの」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「彼女らにはいつもお世話になってるし、ちからになってあげたいのよ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「わたくしの顔を立てると思って、どうかしら？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなた、文化系の部活動に所属してくれない？　できれば、他の帰宅部の子たちも誘って……ね？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「そうすれば、余った予算を独占できて、『暗黒文化祭』から立場の弱い文化系の部活動も復興する。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「わたくしも、すこしは胸のつかえがとれてよ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「こないだの『暗黒文化祭』からこっち、文化系の部活動は教師の風当たりが強くてね。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「今回の『帰宅部争奪戦』も、体育会系の部活動を贔屓する出来レース感が強いの。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「ちょっとした制裁ね、文化系の部活動への」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「まぁ、学校を占拠して怪しげな文化祭なんか催したのだから、教師が快く思わないのは当然だけど。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「その首謀者としては、わたくしは心苦しくてね？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「迷惑をかけたぶん、すこしでも手助けしてあげたいのよ」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「だからこそ、すでに半ば引退した身の上なのに、こうして恥知らずにも出張ってきてるの」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「どう？　検討してくれるかしら？」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「あなたに、損はないはずよ。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「もちろん、言うことを聞いてくれたら、わたくしにできる範囲でよければ謝礼もしてよ？」"
  },
  {
    "command": "update_character",
    "id": "center",
