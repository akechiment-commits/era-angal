    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「けれど。もし断るというならば、覚悟を決めることね」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「わたくしは、夜霧さんほど甘くはないわ。」"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「いちど、痛烈に敗北したわたくしは猫にも噛みつく窮鼠……」"
  },
  {
    "command": "update_character",
    "id": "center",
