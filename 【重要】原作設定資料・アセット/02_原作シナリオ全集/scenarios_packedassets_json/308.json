    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "「よく、状況がわからなくてよ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-default",
    "pose": 0,
    "active": true,
