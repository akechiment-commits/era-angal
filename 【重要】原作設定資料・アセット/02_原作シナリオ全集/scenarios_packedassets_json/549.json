  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「授業サボらせちゃったぶん、たっぷりサービスしちゃうのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「って気が早いな、まだ修学旅行は始まったばかりなのだあ！」"
