  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「下僕くんもけっきょく、いっしょに修学旅行を楽しめることになったしな？」"
