  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「うちの教師たちは融通がきくというか、生徒に甘くてよかったのだあ♪」"
