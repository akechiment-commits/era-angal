    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そのぶん、学校の授業を休ませちゃって申し訳ないけどなあ？」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「夜も、下僕くんはもちろん教師といっしょの部屋だし。」"
