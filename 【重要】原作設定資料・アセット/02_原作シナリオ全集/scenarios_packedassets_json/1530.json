    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「おや？　言われてみればどことなく、見慣れぬ装い……？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "old-new-boy",
    "pose": 0,
    "active": true,
    "expression": "old-new-boy_expression/normal",
