    "expression": "old-new_expression/surprise",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "かな",
    "text": "「いや。あんた気づいてないみたいだけど、自分も君咲学院の制服を着てないからね？」"
