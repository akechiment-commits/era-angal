    "expression": "old-new_expression/joyful",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「はい、梅ちゃん……♪」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 18,
    "dress": "old-new",
    "pose": 0,
    "active": true,
    "expression": "old-new_expression/surprise",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「ところで。先ほどから気になっていたのですが、その服装は何ですか？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "old-new-boy",
    "pose": 0,
    "active": true,
    "expression": "old-new-boy_expression/amazed",
