    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「はい、梅ちゃんならば構いません。幼いころは、ともにお風呂に入った仲ですし♪」"
