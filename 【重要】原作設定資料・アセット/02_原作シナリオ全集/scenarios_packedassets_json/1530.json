    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "「梅ちゃん、おはようございます♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 20,
    "dress": "old-new-boy",
    "pose": 0,
    "active": true,
    "expression": "old-new-boy_expression/amazed",
