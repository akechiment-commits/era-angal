    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「どういうこと！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 61,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
