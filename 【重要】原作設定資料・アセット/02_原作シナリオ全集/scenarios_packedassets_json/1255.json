  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……ありがと。引き受けてくれるんだね」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……それじゃ、頼むよ。わたしの生き死には、あんたの頑張りにかかっていると思ってくれていい」"
