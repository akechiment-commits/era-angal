    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……そうか。声なら届くかも」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……大きい声を出すのは得意じゃないけど、転校生を呼んで、助けを呼んできてもらおう」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……お～い、転校生～」"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "「……」"
