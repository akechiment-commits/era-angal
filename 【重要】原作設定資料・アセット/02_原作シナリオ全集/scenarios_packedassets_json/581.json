    }
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「ああ！　だんだん楽しくなってきましたわ！」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
    "text": "「さっそくかえでさんと呼び名の研究をしませんと！」"
  },
  {
    "command": "talk",
    "speaker": "さくら",
