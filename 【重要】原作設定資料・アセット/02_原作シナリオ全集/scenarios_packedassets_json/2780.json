  {
    "command": "talk",
    "speaker": "あいか",
    "text": "そうですよ、酷い……。そ、そのことをみんなに説明すればいいじゃないですか。わたし、放送部に知りあいがいますし。みんなに、それを伝えられるかも"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 58,
    "dress": "default",
    "pose": "1",
    "expression": "default_expression/serious",
    "expression_position": {
      "x": -10,
      "y": 470
