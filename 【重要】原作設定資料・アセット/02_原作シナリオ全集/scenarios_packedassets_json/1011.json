    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「あうう～？」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「て、転校生さん、重いですぅ。どいてください～、動けないですよぅ」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「急に後ろ向きに倒れるんだもん、頭ぶつけちゃいましたぁ！」"
