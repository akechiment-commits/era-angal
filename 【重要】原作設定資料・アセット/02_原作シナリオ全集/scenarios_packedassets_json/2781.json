  {
    "command": "play_voice",
    "asset_code": "web:voice/character/58/emo_response-3.wav"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "物語を書きたまえ。文字にすれば心は整理される、気持ちもわずかに慰められる。何かを創作するということは、心理療法としても採択される冴えた方法のひとつだ"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "君は一年生だ、未来の物語の主人公だ。私たちの時代より、そして今の時代よりも幸せな結末を、今からでも模索して一文字ずつ紡ぎたまえ"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "感情のすべてを原稿用紙に叩きつければ、すこしは気もまぎれる。文芸部だろう、あいかくん。そのための物語だ、文章に現実を変えるほどのちからはないけれど"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "そんなちからがあると思いこみ、現実をねじ曲げようとして失敗した、私たち文学少女の愚かさを覚えていてほしい"
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "もう文学って時代じゃないし、みんなすぐに忘れてしまうだろうから"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
    "dress": "default",
    "pose": "1",
    "expression": null,
    "expression_position": {
      "x": -10,
      "y": 470
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "書き留めて、せめて物語にして、烏滸がましい話だけれど……。未来の若者たちへの、教訓にしてほしい"
  },
  {
    "command": "update_character",
