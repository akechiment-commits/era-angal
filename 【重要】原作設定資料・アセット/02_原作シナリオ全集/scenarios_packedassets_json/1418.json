    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「ほら早く、行ってあげなよ。ついでに、ひとつ教えてあげる」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「どんな悩みも、夢中で何かに熱中してたら、いつの間にか消えてるんだよね」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「だから、あたしは絵を描くの。悩みも喜びも怒りも哀しみも何もかも、絵の具に溶かしこんじゃう。」"
  },
  {
    "command": "update_character",
