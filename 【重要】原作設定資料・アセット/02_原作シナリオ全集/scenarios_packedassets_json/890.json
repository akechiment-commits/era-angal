    "expression_position": {
      "x": 22,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "「いやいや、本の貸しだしも図書委員の業務なのだよ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 58,
