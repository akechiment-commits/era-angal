  {
    "command": "update_character",
    "id": "center",
    "character": 58,
    "dress": "default",
    "pose": "2",
    "expression": "default_expression/blush",
    "expression_position": {
      "x": -10,
      "y": 470
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "古今東西、数えきれぬ才人が愛を語り、けれどなお語り尽くせてはいない。私のような未熟者には、とうてい表現ができるものではないね"
  },
  {
    "command": "update_character",
    "id": "center",
