    "expression_position": {
      "x": -10,
      "y": 470
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "『ぼろ』がでないうちに、単刀直入に用件を言おうか"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 58,
