    "id": "center",
    "effect": "favor",
    "position": {
      "x": -10,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "文法の正確さよりも、ニュアンスを愛するよ。休館日……あぁ、良い響きだ。『休刊日』みたいで、何だか悩ましい気分にもなってしまうけど"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 58,
    "dress": "default",
    "pose": "2",
    "expression": "default_expression/expressionless",
    "expression_position": {
      "x": -10,
      "y": 470
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "しおん",
    "text": "まぁいい。そんな話をするために、君を呼びだしたわけではない"
