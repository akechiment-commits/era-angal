    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「春休みなのに、ひとりでちゃんと起きてきたみて～だな。うん、えらいえらいっ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
