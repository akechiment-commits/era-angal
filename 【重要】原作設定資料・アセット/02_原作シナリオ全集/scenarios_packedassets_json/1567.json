    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「どうして、って……もしかしてひよの、覚えてね～の？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あたしたち、こないだ籍を入れたばっかりだと思うんだけど？」"
