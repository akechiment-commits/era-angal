    "dress": "old-apron",
    "pose": 0,
    "active": true,
    "expression": "old-apron_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「まさか一時の気の迷いでした～、だなんて言わね～よな？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 53,
    "dress": "old-apron",
    "pose": 0,
    "active": true,
