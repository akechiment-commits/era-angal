    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「ほら。ちゃんと『わたしたち結婚しました』って写真まで撮ってあるだろ？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「そこにある写真立てに、ちゃんと飾ってあるんだからさ。忘れた、だなんて言わせね～よ」"
