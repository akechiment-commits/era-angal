    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「まあ、ひとりで寂しくないから、いいですけど」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
    "dress": "old-new-civvies",
    "pose": 0,
    "active": true,
