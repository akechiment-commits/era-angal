    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「あぁ、猫に名前を付けるのって、難しいですぅ……♪」"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "「おや。餌が食べたいんですかね、待っててください。すぐにミルクを用意しますからね……♪」"
