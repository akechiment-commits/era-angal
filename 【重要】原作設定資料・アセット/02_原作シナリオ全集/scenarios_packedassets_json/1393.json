    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「んあ。ありがてぇけど、おら物覚えはいいだよ。ひととおり見せてもらえたら、たぶん大丈夫だぁ♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
