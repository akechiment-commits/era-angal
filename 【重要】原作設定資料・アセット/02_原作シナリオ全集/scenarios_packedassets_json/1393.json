    "pose": 0,
    "active": true,
    "expression": "old-worker_expression/amazed",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「あんがど。でも熊沢しゃん、何であんなに大量に制服のストックをもってたんだぁ？」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「そのうちの一着を借りられて、助かったげども……？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
    "dress": "old-worker",
    "pose": 0,
