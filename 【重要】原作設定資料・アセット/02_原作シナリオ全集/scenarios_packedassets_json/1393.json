    "dress": "old-worker",
    "pose": 0,
    "active": true,
    "expression": "old-worker_expression/joyful",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「そんなに心配しなくても、おら大丈夫だぁ♪」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「これでも、つばさしゃんにおんぶに抱っこだげどアイドルの仕事はちゃんとしてるし。」"
