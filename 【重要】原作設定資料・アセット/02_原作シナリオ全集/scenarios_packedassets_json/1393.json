    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「お客さんへの受け答えの仕方とか、わたしのやりかた見ててねえ。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
    "dress": "old-worker",
    "pose": 0,
    "active": true,
    "expression": "old-worker_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「台本とかつくっちゃう？　このお店によく文芸部の藍乃さんくるし、頼んでみよっかなあ～♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
