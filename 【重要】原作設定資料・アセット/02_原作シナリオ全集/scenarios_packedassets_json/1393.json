    "pose": 0,
    "active": false,
    "expression": "old-worker_expression/joyful",
    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「そっかあ、優秀な人材をスカウトしちゃったなあ。お給料あがっちゃうんじゃないかなあ、えへへ。」"
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「ことりちゃん、制服も似合ってるよお♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
    "dress": "old-worker",
    "pose": 0,
    "active": false,
    "expression": "old-worker_expression/joyful",
    "expression_position": {
