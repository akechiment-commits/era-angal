    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ひめの",
    "text": "「ドラマとかに出演したら教えてねえ、絶対に見るよお♪」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 43,
