  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「はぁ、はぁ……けっこう、遠かったね」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「君も疲れたんじゃない？　息、あがってるよ。大丈夫？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-s-child",
    "pose": 0,
    "active": true,
    "expression": "old-s-child_expression/normal",
    "expression_position": {
      "x": -6,
