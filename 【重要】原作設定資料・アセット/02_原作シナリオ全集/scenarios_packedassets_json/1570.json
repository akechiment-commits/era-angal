  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-s-child",
    "pose": 0,
    "active": true,
    "expression": "old-s-child_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 442
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「ここまで、しんどい思いをして登ってきたのが、消えてなくなるくらいの絶景だね♪」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「君とふたりで達成したことのひとつに、加えちゃおう♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-s-child",
    "pose": 0,
    "active": true,
    "expression": "old-s-child_expression/normal",
    "expression_position": {
      "x": -6,
      "y": 442
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「いろんなことが、今までにあったよね。いいことも、悪いことも……」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「その、ひとつひとつが、わたしを形作ってる。」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「君がいなかったら、わたしはわたしじゃない、別の誰かになっちゃってた、って思う」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「すこし、休もうか」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「そこにちょうどいい大きさの石もあるし、座れると思う」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「リュックサックに、お菓子もすこしだけ、詰めてきてるし……」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「歩いてお腹も空いただろうから、一緒に食べよう？」"
  },
