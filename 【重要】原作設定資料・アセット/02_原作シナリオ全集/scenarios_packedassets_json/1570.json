  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「大丈夫？　咳き込んでるけど、カレー辛かったかな？」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「ああ、急いで食べたから喉につかえちゃったんだ？」"
