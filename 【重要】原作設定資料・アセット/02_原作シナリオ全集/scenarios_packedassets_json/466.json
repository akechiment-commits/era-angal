    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（七夕のときも途中で寝ちゃって、いちかに家まで運んでもらったんだよね）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（みんなに、迷惑かけないようにしなくちゃ。そのうえで、自分にできることをする。）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（めいっぱい楽しむ。それでいいんだよね、ひ〜ちゃん）"
