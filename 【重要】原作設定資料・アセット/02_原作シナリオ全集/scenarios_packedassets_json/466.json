  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（ひ〜ちゃん、ぐっすり眠ってたな）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（七夕のときはみんな、天文部の部室に泊まったみたいだけど。）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（今回は園芸部とか、他の部活とかの許可をもらっていろんな部室を宿泊施設にしてるんだよね）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（すぐそこだったし、ひ〜ちゃん軽いから運ぶのはそんなに大変じゃなかったけど）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（もう寝てるひとがたくさんいたのが、ちょっと気になるな）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（やっぱり……お月さまがいちばんきれいに見える時間に起きていたくて、）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（今のうちから仮眠をとってるのかな？）"
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（ひとの心配してる、場合じゃないな）"
  },
  {
