    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「おっと、はしゃいでる場合じゃなかった。」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「花音さんが何かよくわからないけどピンチっぽいんだよね、急いで彼女のところに行ってあげないと。」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「えぇ～っと？」"
