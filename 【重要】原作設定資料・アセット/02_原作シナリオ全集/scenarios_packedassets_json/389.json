    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「いつもは校内で行事を開催する立場の私だが、」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「今日だけはいち参加者として楽しませてもらうぞお！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「できればお祭りの運営とか演出とか覚えて、今後の行事の参考にさせてもらうぞお！」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 4,
    "dress": "old-yukata",
    "pose": 0,
    "active": true,
    "expression": "old-yukata_expression/joyful",
    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そして学校のみんなにもっともっと、とびっきりの青春を満喫してもらうのだあっ♪」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「わ〜い、わ〜い！　お祭りなのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「みんな浴衣に着飾って、御神輿かついでワッショイワッショイ！」"
  },
  {
    "command": "set_still_image",
    "id": "card/normal/407"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「両手に綿あめ、たこ焼き……屋台飯をたっぷり山盛りなのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「かき氷も食べて夏の暑さも吹っ飛ばすぞお！」"
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「射的で遊んで金魚を釣って〜、櫓を囲んで盆踊り☆」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「クライマックスは、待ってましたの花火なのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「夏祭りの花火は町の名物だからなあ、今からとっても楽しみなのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「テンション最高潮！　素晴らしい一日になりそうなのだあ〜♪」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そして！　そんな日にかぎって迷子になっちゃうのが私！」"
