  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「うわああああん！　みんな、どこ〜っ!?　ここは、どこ〜っ!?」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「ミッチー！　ユッキー！　みんな〜っ、どこ〜っ!?」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「うわぁん、酷いのだあ！」"
