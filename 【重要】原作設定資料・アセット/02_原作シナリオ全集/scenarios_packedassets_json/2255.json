    "pose": "1",
    "expression": "s-civvies_expression/serious",
    "expression_position": {
      "x": -6,
      "y": 526
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "（うん、お布団は敷けました。本来ならば、仲居さんなどがやってくれるのでしょうけど。ここは、君咲学院が所有する合宿所ですしね）"
  },
  {
    "command": "update_character",
