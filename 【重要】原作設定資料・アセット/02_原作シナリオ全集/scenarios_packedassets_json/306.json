    }
  },
  {
    "command": "set_background",
    "display_name": "廊下",
    "id": "7",
    "timezone": "2"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「金が絡むとややこしくなるぜ〜？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「当然、予算がもらえりゃあ体育会系の部活動は生徒会に恩義を感じる。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「そんな事態がつづけば、この学校ではどんどん体育会系の部活動ばかりが優遇される、不公平な状況になっちまう」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「体育会系の連中は当然、喜ぶだろうけど。文化系の連中にとっちゃあ、由々しき事態だ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/expressionless",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「……お金を回して好感度を高める、ってのは紳士的じゃね～しな」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あんたんとこの生徒会長も、そんなの望んでね〜と思う。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あのひとの願いは『みんなが楽しく青春をすごせる君咲学院』らしいしな。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「体育会系だけが幸せになり、文化系が蔑ろにされるってのは、本意じゃね〜と思うんだ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あたしは体育委員長だけど、だからって体育会系の部活動ばかりが贔屓されるのは好ましくはない。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「せっかく平和になったこの学院が、文化系と体育会系で二分されてギスギスすんのは勘弁だしな。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 486
    }
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「下手すりゃあ、天下分け目の大戦争だぜ〜？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「だから、あたしがあんたに頼みたいのは……」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「いま、問題になってる帰宅部の生徒たちを……公平に、」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「文化系と体育会系の部活動に振りわけてほしい、ってことだ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「つまり、帰宅部の連中にあんたが接触して、」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「それぞれ平等に半分ずつ文化系と体育会系の部活動に入部させてほしいんだよ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「文化系と体育会系に、平等に部員が分配されれば、予算も公平に振りわけられる。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「そうすりゃあ、文化系の連中も文句は言わね〜だろ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「すくなくとも文化系と体育会系の全面戦争みたいな、最悪の事態だけは避けられるはずだ。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「面倒だと思うけど、よろしく頼むぜ？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あたしは体育会系の部活動のトップ、体育委員長だからな。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「表立っては動けね〜んだ、こそこそと陰謀を巡らせるようなのは好みじゃね〜んだけど」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「とりあえず、あたしの気持ちと現状だけは、理解しておいてくれ。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「あとは、あんたの好きにしてくれよ」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「たぶん、文化系の連中もあんたに接触してくると思うけどな。」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「いろいろ、誘惑もあるかもしれない。文化系の部活動に肩入れすればご褒美をあげる、とかな？」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「それに対してあんたがどう動くかは、あんたの自由だけど」"
  },
  {
    "command": "talk",
    "speaker": "はやて",
    "text": "「なるべくなら、穏便に済ますことを考えてくれよ。」"
  },
  {
