  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「この休暇で。おらたちは、いっときでも学校に通えるようになっだ」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「たとえ、仕事をしながらでも。つばさしゃんが、ようやく手にいれた『ふつうの生活』なんだ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 64,
    "dress": "old-default",
    "pose": 0,
    "active": true,
