    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「大事にしたいんだ。でも……」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「つばさしゃんは今、おかしなことをやらされてる。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「でも、つばさしゃんには『おかしい』ってわかんねぇんだ。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「『ふつう』がわからねぇがら、『ふつうじゃなくても』気づかねぇんだ」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「おら、何とか助けでやりてぇだ。そいで、今度こそ『ふつう』に学校生活さ楽しんでほしいだ。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「つばさしゃんが、おらを憧れてた『アイドル』にしでくれだみてぇに」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「今度はおらが、つばさしゃんの望みを叶えてやりてぇだよ」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「でも、どうしだらいいかわからなぐて。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「とりあえず事務所の指示どおりにチア部に所属しにきただよ、おらは流されてるだけだぁ」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「情けねぇ、だよ」"
  },
