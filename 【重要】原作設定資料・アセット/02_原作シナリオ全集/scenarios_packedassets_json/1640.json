    "expression_position": {
      "x": 0,
      "y": 478
    }
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "（けっきょく何もできないうちに、爆睡しちゃうとか！）"
  },
  {
    "command": "talk",
    "speaker": "みさき",
    "text": "（ありえない！　うう～っ、あたしはやっぱり『ちいさなマルちゃん』か！）"
