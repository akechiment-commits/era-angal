    "expression_position": {
      "x": 4,
      "y": 450
    }
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「私はそんな彼の努力に、報いることができているのだろうか？」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「『大歓迎会』で自己満足になっていないだろうか？」"
