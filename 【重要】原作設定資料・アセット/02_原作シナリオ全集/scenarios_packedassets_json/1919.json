    "expression_position": {
      "x": -24,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（おっと、気ぃ抜いちゃいけないっす。バスケの試合だって、最後の一秒まで結果はわかんないっすよ～？）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（ぎりぎり、花火玉の手配は間にあったっすけど。急いで運ばないと、お客さん帰っちゃうっすよね～？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 36,
    "dress": "old-yukata2",
    "pose": 0,
    "active": true,
    "expression": "old-yukata2_expression/normal",
    "expression_position": {
      "x": -24,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（ある程度は事前に用意したぶんがあるけど、足りなくなっちゃいそうなんすよね。）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（ほんの数分で打ち上げ花火が終わっちゃあ、味気ないっす）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（えぇっと川辺から打ち上げるんだから、そこまで花火玉を運んでけばいいんすよね。）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（大急ぎで用意すれば、お客さんを待たせずに最後までいけるっすかね～？）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（花火玉とか、そういう取扱注意のものは倉庫のほうに厳重に保管してあったはずっす……）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（倉庫の近くで作業してる誰かに連絡して、持ってきてもらうほうが早いっすかね？）"
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（ううん。こっちからも向かって、途中で合流するのがいちばんっすね。）"
  },
  {
    "command": "update_character",
