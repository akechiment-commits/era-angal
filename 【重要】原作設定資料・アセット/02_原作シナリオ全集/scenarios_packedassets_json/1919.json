    "expression_position": {
      "x": -24,
      "y": 502
    }
  },
  {
    "command": "talk",
    "speaker": "あすか",
    "text": "（あたしもいちおう役目を果たせたってことで、一安心っすね～♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 36,
