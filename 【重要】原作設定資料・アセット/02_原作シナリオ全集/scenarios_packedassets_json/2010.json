  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-goth-loli2",
    "pose": 0,
    "active": true,
    "expression": "old-goth-loli2_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「はい？　そうですね……もちろん、ねえさんのことは大好きですけど。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-goth-loli2",
    "pose": 0,
    "active": true,
    "expression": "old-goth-loli2_expression/sad",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「自分の幸せを後回しにして、わたしとかの応援ばっかりしてるから。たまに、心配です」"
