  {
    "command": "update_character",
    "id": "center",
    "character": 38,
    "dress": "old-goth-loli2",
    "pose": 0,
    "active": true,
    "expression": "old-goth-loli2_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「先輩。近ごろ、『帰宅部争奪戦』とかいうので大変なんでしょう？」"
