    "expression": "old-goth-loli2_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "ゆき",
    "text": "「転校生の先輩は、ほんとに話題の中心って感じで大変そうですよね」"
