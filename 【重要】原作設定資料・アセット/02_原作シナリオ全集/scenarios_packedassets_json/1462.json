    "text": "（はわわ……）"
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（つ、疲れましたぁ！　頭がフラフラしますぅ、寝ちゃいそう！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 26,
