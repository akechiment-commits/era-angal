    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「よしよし、きれいに掃除してやるから、ちからを貸してほしいアルよ。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 48,
