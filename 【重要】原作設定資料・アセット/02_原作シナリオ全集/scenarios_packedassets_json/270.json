    "pose": 0,
    "active": true,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 20,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "レンレン",
    "text": "「大自然のちからを借り受け、人間以上のちからを発揮するのが中国拳法アルよ〜！」"
  },
  {
    "command": "update_character",
    "id": "center",
