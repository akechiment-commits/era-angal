  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「えへ。おら、つばさしゃんの寝顔を見ると『いつまでも寝かせてやりてぇな』って思っちまうがらなぁ♪」"
  },
  {
    "command": "update_character",
    "id": "left",
