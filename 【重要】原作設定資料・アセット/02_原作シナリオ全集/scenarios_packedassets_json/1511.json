  {
    "command": "talk",
    "speaker": "うしお",
    "text": "（旧校舎に引きこもってたわたしと、似てるの。）"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "（わたしには、連れ出してくれる友達がいたけれど、もしかすると、この子には……）"
  },
  {
    "command": "talk",
    "speaker": "うしお",
