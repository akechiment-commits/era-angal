  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「さくらさん、たまにあたしを褒めるふりしてdisってない？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 13,
    "dress": "old-exective",
    "pose": 0,
    "active": true,
    "expression": "old-exective_expression/normal",
    "expression_position": {
      "x": 54,
      "y": 524
    }
  },
  {
    "command": "remove_character",
