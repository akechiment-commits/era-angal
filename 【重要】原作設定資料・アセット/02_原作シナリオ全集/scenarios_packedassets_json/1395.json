    "expression_position": {
      "x": 38,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「そうでねぇと、ほんとうに……。」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「つばさしゃんが見つけて、おらを愛してくれた。アイドルにしてくれた、その恩を仇で返すことになる」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「裏切っちまうんだ、そのほうが申し訳ねぇだ」"
  },
  {
    "command": "talk",
    "speaker": "ことり",
    "text": "「うまく言えねぇけど……。だから、安心してほしいんだ」"
