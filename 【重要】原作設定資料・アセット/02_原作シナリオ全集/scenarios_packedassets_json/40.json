  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "『安心しろ、生物部にもかけあって、飼育小屋にも出入りできるようにしてやる。うさちゃんも、いっぱい増やそう』"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "『あやめちゃんの好きなもので、あやめちゃんの周りを埋め尽くそう』"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "『もう、怯えて逃げて、不本意な立場で苦しんでいる必要はないのだ』"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "『あやめちゃんだけではない、生徒の誰ひとりとして――そんなふうに、自分を殺すようにして生きさせはしない』"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "『みんなが楽しい学校生活を送れる、そんな学校をつくるのが、せえとかいちょおとしての私の使命なのだ』"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "『よければ、あやめちゃんにも――協力してほしい』"
  },
