  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（『はじめちゃんチーム』は……さすが三年生、ぶれないな。）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（安定してるし、意外とチームワークもいい。たぶん、いい指標になる）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（わたしたちが失敗したら『はじめちゃんチーム』に遅れをとる、逆に大成功すれば追い抜ける）"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "（『はじめちゃんチーム』をベンチマークにして動けば、自分たちの立ち位置を把握しやすい。）"
  },
  {
    "command": "update_character",
