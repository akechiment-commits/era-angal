    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「でも考えて、失敗を繰り返して、慣れて、成長していかなくちゃ」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あたしたちの大嫌いな先輩たちが、たぶんそうしたように。」"
