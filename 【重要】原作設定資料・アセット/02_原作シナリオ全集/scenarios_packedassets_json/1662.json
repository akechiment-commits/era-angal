    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あたしたちも、後輩に憎まれても……。遠い未来に感謝してもらえるような、先輩になりましょう」"
  },
  {
    "command": "update_character",
