    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「うまくいかないわよね、二年生になって……。先輩たちの背中を追うだけじゃ、いけなくなって。」"
  },
  {
    "command": "update_character",
    "id": "right",
