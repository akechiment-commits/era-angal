  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「まったく——」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「陛下も人使いが荒いわね、」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「今どき連絡事項ぐらいメールで済ませればいいのに。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「『こういうのは面と向かって頼んだほうがいい』だなんて、陛下らしいけど」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ふん、休日の学校でパーティを開催だなんて。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「羽目を外した馬鹿どもが騒がなきゃいいけど、後片付けのことを考えただけで頭痛いわ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 11,
    "dress": "old-w",
    "pose": 0,
    "active": true,
    "expression": "old-w_expression/normal",
    "expression_position": {
      "x": 10,
      "y": 490
    }
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あんた、転校生。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「悪いけど——あたしは風紀委員の仕事があるからさ、合唱部への連絡は頼んだわよ？」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「いい？　ちゃんと陛下の布告を伝えるのよ、」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あんたがポカしたらあたしの責任になるんだから——」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「ほら、そこが合唱部の部室よ。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしは、そっちの軽音部に用があるからさ、ここでお別れよ」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「まったく、軽音部も何か不穏な動きしてるみたいだし……。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「あたしがしっかりと、校内の風紀を守らないと。」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「それが陛下から与えられた、あたしの使命！」"
  },
  {
    "command": "talk",
    "speaker": "かえで",
    "text": "「んじゃね、合唱部についてはあんたに任せたからね？」"
  },
  {
