    }
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「うああ〜、暇やからってうちをイジって遊ぶのやめてほしいわぁっ！　月ちゃん先輩の意地悪〜っ！」"
  },
  {
    "command": "update_character",
