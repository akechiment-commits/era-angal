    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「でも実際、わりと七夕は浪漫ちっくな行事ッスからね。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「運命に引き裂かれた恋人たちが、年にいちどの逢瀬を楽しむ……みたいな」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「織姫さまと彦星さまに自分たちをなぞらえて、ちちくりあってるバカップルがたくさんいそうッス。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「星ちゃんも、転校生くん誘えばよかったのに〜？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 45,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
