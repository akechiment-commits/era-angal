    "pose": 0,
    "active": false,
    "expression": "old-default_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「言われてみたら、節分やと豆まくし、クリスマスはプレゼント交換とかするけど。」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「七夕は飾りつけが終わったら、ほんまに何もやることあらへんなぁ？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 45,
    "dress": "old-default",
    "pose": 0,
    "active": false,
    "expression": "old-default_expression/normal",
    "expression_position": {
