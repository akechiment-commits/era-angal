  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ひゅうひゅう、星ちゃんったら君咲学院の織姫さまっ♪　ひゅうひゅう！」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 45,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/surprise",
