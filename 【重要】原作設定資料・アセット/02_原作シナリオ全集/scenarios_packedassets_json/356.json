    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「星ちゃんとこは過保護ッスね、うちは放任主義ッスけど。羨ましいような、そうでもないような。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「まぁ、転校生くんは苦労しそうッスね」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ともあれ、そうなると本格的に暇ッスね。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「せっかくお泊まりの許可をもらったのに、やることなさすぎて眠くなってきたッス」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 45,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 6,
      "y": 456
    }
  },
  {
