    "pose": 0,
    "active": true,
    "expression": "old-default_expression/normal",
    "expression_position": {
      "x": 0,
      "y": 496
    }
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「地方によってはいわゆる『七夕まつり』とか、縁日みたいなことやるみたいッスけどね。『こじつけ』くさいッス」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「蝋燭を川に流したり、本の虫干しをしたり、いろいろ燃やして雨乞いしたり……。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「そんな神事を執り行うところもあるっぽいスけど、あんまり一般的ではないッスね。」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「願いを短冊に書いて笹に吊してお終い、ってのが基本ッス」"
  },
  {
    "command": "talk",
    "speaker": "ほとり",
    "text": "「ちなみに織姫さまのように裁縫がじょうずになるように、糸みたいなもの＝麺類を食べる風習もあるみたいッスよ」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 59,
