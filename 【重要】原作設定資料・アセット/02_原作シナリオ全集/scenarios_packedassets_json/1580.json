    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（…………）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 32,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/surprise",
    "expression_position": {
      "x": 14,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "きこ",
    "text": "（あれ……三善さん。なんだか、表情にかげりがあるような？　なにかあったのかな？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……ふぅ。ソロパート、うまくいってよかった）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/sad",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……だけど、三善が吹いてるバスクラの音に、覇気を感じられない。）"
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（ほんのすこしだけ、音が濁ってる気がする）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 46,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/surprise",
    "expression_position": {
      "x": 22,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "ゆり",
    "text": "（……まさか、アクシデント？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 37,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civvies_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（……困りましたね。見通しが甘かった、みたいです）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（まさか、リードが欠けてしまうなんて、考えていませんでした）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（バスクラ本体の確認に時間をかけすぎて、リードの確認が甘かったのでしょうか？）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（ちゃんとしたコンサートであれば、曲と曲の合間に交換できるものを。まさか、こんなときに……）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（リードケースをステージ裏に置いてきたのが、裏目に出ましたね）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（ああ。次の曲では、ついにソロパートがありますね。）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（私ひとりで演奏しなくてはならないのに……万全の状態でないのが、悔やまれます）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（リードの交換さえできれば……よかったのですけど）"
  },
  {
    "command": "talk",
    "speaker": "かなえ",
    "text": "（万事休す。こんなとき、いったい、どうしたら……）"
  }
]