  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「気をつけて見ててあげてって、お医者さんに頼まれたから。放っとけなくて、心配だったし。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ほんとに、ただ何となくそうしてただけ」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「偉そうに同情して、暇つぶしみたいに……。見返りなんて、求めてなかったのに」"
