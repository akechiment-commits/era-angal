    "id": "left",
    "character": 16,
    "dress": "old-w-civvies2",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies2_expression/surprise",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたしを……？　それは嬉しいですけど、どうして？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/sad",
    "expression_position": {
      "x": -4,
