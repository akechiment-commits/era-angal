    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「うん。本人が言うと押しつけがましいから～って感じでシャイなあいつらはちゃんと説明してないだろうし、」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「あたしが空気読まずに言っちゃうけど」"
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「今日はね……。そもそも軽音部の連中、あんたを元気づけるために集まったのよ」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 62,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": false,
