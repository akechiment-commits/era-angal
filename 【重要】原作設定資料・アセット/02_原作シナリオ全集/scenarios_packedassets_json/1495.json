    "expression_position": {
      "x": 4,
      "y": 472
    }
  },
  {
    "command": "talk",
    "speaker": "ひよの",
    "text": "（そ、それとももしかして……やっぱり男のひとって、えっちな本を買うとか！）"
  },
  {
    "command": "talk",
