    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "さっき会ったときは美術部の遠征って聞きましたけど、いろんなひとたちと旅行に来てたんですか？　美術部も、そのひとつでしょうか……"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 29,
    "dress": "winter-civvies2",
    "pose": "1",
    "expression": "winter-civvies2_expression/joyful",
    "expression_position": {
