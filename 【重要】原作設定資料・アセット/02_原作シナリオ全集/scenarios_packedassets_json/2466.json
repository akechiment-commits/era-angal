  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "も、物真似しただけですから、無言で見つめるの、やめてもらえませんか……。笑いを狙ったつもりじゃないので、すごく複雑な気分です"
  },
  {
    "command": "update_character",
    "id": "center",
