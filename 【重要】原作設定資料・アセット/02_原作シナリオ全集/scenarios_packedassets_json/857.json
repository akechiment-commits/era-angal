    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「今日は楽しかったの。でも、振り回しちゃって、ごめんなさいなの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「今度、またお詫びをさせてほしいの」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civvies_expression/joyful",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「あんなデートでも、楽しかった、って言ってくれるんだね。嬉しいの」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-sp-civvies_expression/normal",
    "expression_position": {
      "x": 16,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「卒業したら、あまり会えなくなっちゃうけど」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「たまのお休みの日には、遊びに行かせてもらうの」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-sp-civvies",
    "pose": 0,
