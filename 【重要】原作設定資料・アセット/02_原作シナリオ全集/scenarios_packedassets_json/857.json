    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「……行っちゃったの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「楽しかった、だからこそ……その分、ひとりは寂しいの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「ひびきんぐ、夢に向かって頑張ってたの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「おかげで、昼間に言われたこと、ずきずき効いてるの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「胸が、痛いの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「『金魚ちんは、狭い金魚鉢の中に籠ってるだけっち』だなんて」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「実際、その通りなの。反論すら、できないの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「わたしは金魚」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「小さくて、不格好で、水族館にもいられないようなちっぽけな魚」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「いかりんぐやひびきんぐのような、大きな魚には敵わないの」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「だから、金魚鉢の中で生きて、夏祭りで掬われて、夏の間だけ、小さく生きる」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「夏が終わったら、死んじゃうの」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 63,
    "dress": "old-sp-civvies",
    "pose": 0,
    "active": true,
