    }
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「今日は、本当にありがとう」"
  },
  {
    "command": "talk",
    "speaker": "うしお",
    "text": "「ばいばい☆」"
  },
  {
    "command": "update_character",
