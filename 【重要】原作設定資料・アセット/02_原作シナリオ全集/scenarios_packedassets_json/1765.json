  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（急いで着替えて大広間に向かいませんと、もう朝餉の時間でございますね。）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（たしか、全員揃っていないと食事を始められないという話ですし）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（これ以上、皆さまにご迷惑をかけるわけにはいきません）"
  },
