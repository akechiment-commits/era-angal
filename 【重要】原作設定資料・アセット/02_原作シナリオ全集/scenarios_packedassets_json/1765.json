    "pose": 0,
    "active": true,
    "expression": "old-bath_expression/normal",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（おっと。こんな格好でお祈りしていては、身体が冷えてしまいますね。）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（風邪でもひいては大変です、せっかく快復してきましたのに）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（早く、着替えましょう。ここまで『実行委員』として役立たずでしたし、）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（今日一日、最終日だけでもがんばって皆さまのお手伝いをしなくては）"
