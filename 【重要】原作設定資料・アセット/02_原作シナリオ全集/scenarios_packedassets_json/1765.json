    "command": "update_character",
    "id": "center",
    "character": 18,
    "dress": "old-bath",
    "pose": 0,
    "active": true,
    "expression": "old-bath_expression/joyful",
    "expression_position": {
      "x": 42,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（しかし朝から温泉など、最高の贅沢ですね。ついつい、長風呂をしてしまいました。）"
  },
  {
    "command": "talk",
    "speaker": "まりあ",
    "text": "（悔い改めることもおおく、朝のお祈りにも時間をかけてしまいましたし……♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 18,
    "dress": "old-bath",
    "pose": 0,
    "active": true,
    "expression": "old-bath_expression/normal",
    "expression_position": {
      "x": 42,
      "y": 494
