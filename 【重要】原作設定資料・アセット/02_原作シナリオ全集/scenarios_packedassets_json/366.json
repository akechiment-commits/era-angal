    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あら何よ、転校生。その顔は……。あたしが笑ってるのが、そんなに珍しい？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あたしだって、楽しかったら笑うわよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
    "dress": "old-civvies",
