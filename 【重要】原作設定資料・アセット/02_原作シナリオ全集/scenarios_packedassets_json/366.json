    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あら？　そのへんに、搾ったミルクを置いたわよね。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「なくなってるけど。転校生、あんたもう飲んじゃったの？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「触ってない？　変ね、牛乳が蒸発するような気温じゃないし」"
