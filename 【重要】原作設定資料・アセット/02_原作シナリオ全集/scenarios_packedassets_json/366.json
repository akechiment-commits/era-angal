    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「ん、ん……。けっこう、握力がいるわね。あっ、でたっ♪」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「よしよし、たくさんだしたわね三波。良い子ね、三波……♪」"
