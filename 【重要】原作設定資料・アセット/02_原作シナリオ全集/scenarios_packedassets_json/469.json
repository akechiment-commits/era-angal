  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「うう。私は寝てるうちに、いつの間にか着替えさせられてたんだけど」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「私が眠ってる間に、会場にバニーガールの衣装が用意されてて〜。」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「なぜか『この衣装を着るのが、お月見への参加条件』って噂が広まってたのだあ〜っ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「それでみんな、しぶしぶバニーガールの衣装を着たみたいなんだけど」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「私は、そんな布告はだしてないっ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「たしかに衣装は用意したけど、かわいい和服とかだったのだあ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「舞踏会のときとちがって『着る、着ない』は参加者の自由にしようと思ってたし〜っ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「さっき見回りにきた教師に、『ハレンチな衣装を着るな！』ってすごい怒られたのだあ〜っ！」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「そこで私が『そんなの知らない、私の指示じゃない』って言ったら」"
  },
  {
    "command": "talk",
    "speaker": "ひまり",
    "text": "「他のみんなも怒り始めちゃって！　うう〜っ？」"
  },
