    "text": "「……ん？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「この子、は？　転校生くん、知りあい？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 16,
    "dress": "old-civvies2",
