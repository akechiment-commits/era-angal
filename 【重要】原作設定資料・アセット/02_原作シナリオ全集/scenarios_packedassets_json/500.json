    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 29,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「あぁ、申し遅れました。一年Ｃ組、軽音部の藤猪しずくです」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「そちらの転校生の先輩とは、何度か顔をあわせているので。」"
  },
  {
    "command": "talk",
    "speaker": "しずく",
    "text": "「勝手に、知りあいのように思ってました」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 16,
    "dress": "old-civvies2",
    "pose": 0,
    "active": true,
    "expression": "old-civvies2_expression/normal",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 29,
    "dress": "old-civvies",
    "pose": 0,
    "active": false,
    "expression": "old-civvies_expression/normal",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「んん。転校生くん、いろんな女の子と知りあいだね？」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 16,
    "dress": "old-civvies2",
    "pose": 0,
    "active": false,
