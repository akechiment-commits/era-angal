    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「へいき！　でも、あのねチッチ？　おいら、ほんとはね……？」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「チッチに、内緒にしてたことが……。」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「おいらを相方にして、仲良くして、抱きしめてくれたのに。」"
  },
  {
    "command": "talk",
    "speaker": "こはる",
    "text": "「おいら、ほんとはチッチの横に立つ資格がないんだ」"
  },
