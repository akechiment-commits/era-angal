  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（ひゃわわっ？　どうしましょう～っ、やっぱり知らないひとばっかりです！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（二年生で『学校説明会』に参加してるのって、あずさだけなんでしょうか？）"
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（当然ですよね、受験生のための『学校説明会』ですもん。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/surprise",
    "expression_position": {
      "x": 8,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（同じ学校のひともちらほら見かけるけど、みんな上級生です～！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（ううっ、ひとりだと不安です！　でもでも、一緒にきてくれるお友達もいませんし～？）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（みんな受験のことは『遠い将来のこと』って感じですもん、）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あんまりお勉強に一生懸命な中学校じゃないですからね～？）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あずさのほうが変なんです、きっと。将来のことを考えると、すごく心配になっちゃう。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（『やりたいこと』とか何にもないし、長所も特技もないし～？）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（こんなんじゃ……あずさ、ちゃんと『おとな』になれません。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（もっと将来のこととか、人生のこととか、社会のこととか考えないと！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（小学校までは、その日、楽しくすごせるかどうかだけが重要でしたけど。）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（もう中学生ですもん、しっかりしないと！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（『やりたいこと』を見つけて、えっと、お勉強とかしないと！）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 17,
    "dress": "old-past",
    "pose": 0,
    "active": true,
    "expression": "old-past_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 470
    }
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（みんなに置いてかれちゃいます～っ、きっと出遅れちゃいます！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あずさ、ひとより『のろま』ですから！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（でもお受験の本とか読んだり、学校の先生に相談してもよくわからなくて……。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（何かのヒントになればいいなって、近所の高校の『学校説明会』にきてみたんですけど）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（早くも帰りたいです～っ、あずさ場ちがいすぎます！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（みんな真面目にお受験のこととか考えてきてるのに、あずさだけフワフワしちゃってます～！）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（君咲学院って、お勉強とかできる子じゃないと入れない名門校らしいですしね。）"
  },
  {
    "command": "talk",
    "speaker": "あずさ",
    "text": "（あずさとはご縁がない気がします、回れ右して帰っちゃいましょうか……？）"
  },
  {
    "command": "update_character",
