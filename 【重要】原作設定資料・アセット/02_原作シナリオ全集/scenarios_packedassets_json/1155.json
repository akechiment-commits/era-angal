  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「お久しぶりです～♪　覚えてますかね、三波なつみです！」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「彼はまだ『あっち』ですか？　てっきり、あんずさんと一緒に戻ってくると思ったのに～♪」"
