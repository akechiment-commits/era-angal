  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「う～ん、見つからへんなぁ？」"
  },
  {
    "command": "talk",
    "speaker": "こよい",
    "text": "「月ちゃん先輩、うちの制服どこに置いてったんやろ？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 45,
    "dress": "old-idol",
    "pose": 0,
    "active": true,
