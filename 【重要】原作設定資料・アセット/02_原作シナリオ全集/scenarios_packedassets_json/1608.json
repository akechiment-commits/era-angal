  {
    "command": "talk",
    "speaker": "かすみ",
    "text": "「それを、ちょっと、思いだした……」"
  },
  {
    "command": "talk",
    "speaker": "かすみ",
    "text": "「思い出も感情も、料理のおいしさの絶対条件じゃない。」"
