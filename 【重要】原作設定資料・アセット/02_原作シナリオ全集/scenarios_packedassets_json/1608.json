  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「当たり前です。こはるちゃんは、ずっと部長が料理するときお手伝いしてたんでしょう？」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「部長の技術が、料理のつくりかたが、骨身に刻まれてる」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「これは、あなたの味です。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「こはるちゃんが大好きな……こはるちゃんのなかにいる、あなたの味ですよ」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「何の料理をつくるかは、わたしが決めちゃったから。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「目指す味は、こはるちゃんの理想にあわせようって思ったんです」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「わたし、こはるちゃんとは出会ったばかりだけど……。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「まだ何も知らないけど、お友達になりたかった。わかりあいたかった、運命みたいに相方になったから」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 34,
    "dress": "old-apron",
    "pose": 0,
    "active": true,
    "expression": "old-apron_expression/sad",
    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「わたしはずっと受け身で、ひとの話を聞いてばかりで……。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「ひとの気持ちを、心を、顔色を窺って生きてきました」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「ほんのすこしでも。そんな寂しいわたしの人生を、役立てたい。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「こはるちゃんの目指す味を、料理をつくるための指針ぐらいにはしたい」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「でないと。あんまりにも、寂しい。料理はひとりでもできるけど、ふたりでつくったほうが幸せだもん。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「どうせなら、気持ちをひとつにしてつくりたかった」"
  },
  {
    "command": "update_character",
    "id": "left",
    "character": 34,
    "dress": "old-apron",
    "pose": 0,
    "active": true,
    "expression": "old-apron_expression/normal",
    "expression_position": {
      "x": 8,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「わかりあえるって信じて、あとは手を動かして。全力で、つくりました」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「何度でも言います。これが、わたしたちが部長に食べてほしい、わたしたちの料理です。」"
  },
  {
    "command": "talk",
    "speaker": "ちよ",
    "text": "「お味のほうは、どうでしょう？」"
