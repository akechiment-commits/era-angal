  {
    "command": "play_voice",
    "asset_code": "web:voice/character/13/emo_expressionless-2.wav"
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "全力で怒って、叱責して、あるいは罵倒して……。けちょんけちょんに、してほしいのに。あ～、退屈だわ。うんざりする、隠居するって決めたのを後悔しそうよ"
  },
  {
    "command": "update_character",
