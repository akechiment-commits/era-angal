    "pose": "1",
    "expression": "default_expression/sad1",
    "expression_position": {
      "x": 0,
      "y": 520
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "れいか",
    "text": "やっぱり、ひまりでなくちゃ駄目なのかしら……。わたくしの、敵は。わたくしを楽しませてくれる、人生を輝かせてくれる他者は"
