    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「感心するよ、でも無理だけはしちゃだめだよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-civvies",
    "pose": 0,
    "active": true,
