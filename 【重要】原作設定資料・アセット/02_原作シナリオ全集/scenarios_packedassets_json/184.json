    "id": "card/normal/186"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「どうして旅館にいるの？　転校生くんも湯治？」"
  },
  {
    "command": "remove_still_image"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ふぅん、そういう事情なんだ……。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「旅館のお手伝いかぁ、色々やってるんだね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-civvies",
    "pose": 0,
