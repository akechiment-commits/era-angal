    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「え、どこにあるかわからないの？」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「たしかそのへんに……、そうそう。うん、わたし常連だから。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「だいたい、どこに何があるかわかるよ。」"
  },
  {
    "command": "update_character",
