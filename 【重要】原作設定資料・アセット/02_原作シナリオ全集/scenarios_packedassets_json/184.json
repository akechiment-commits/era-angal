  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「えぇっと、八朔つゆり、と。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あと、なっちゃんと、こよちゃんと……」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「うん？　そうだよ、わたしひとりじゃないよ。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「常連だから、サービス券とかもらってるの。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「せっかくだし、学校の友達とかを誘うことにしてるんだ、いつも」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ひとりじゃ寂しいしね。おっと、噂をすれば……」"
