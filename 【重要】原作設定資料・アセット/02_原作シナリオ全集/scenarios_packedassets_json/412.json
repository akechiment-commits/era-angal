  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「ん？　今の、聞いた？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「足音、かしらね？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「上のほう……二階から、聞こえた気がするけど。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「水泳部の連中、もう二階に辿りついたの？　それとも、他に誰かいるのかしら？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「いちど引きかえすことになるけど、旧校舎の昇降口のあたりに階段があったわよね。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「そこまで戻って、あたしたちも二階にあがってみる？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「二階の廊下が崩れて落ちたら、それこそ大怪我しちゃいそうで怖いけどね。」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/amazed",
    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「まったくもう、水泳部め……。手間かけさせてくれるわね」"
