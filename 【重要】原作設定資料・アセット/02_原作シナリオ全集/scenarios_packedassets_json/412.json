  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「もしかしたら、大声で呼びかければ声が届くかも？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「お〜い！　水泳部〜っ！」"
  },
  {
    "command": "talk",
