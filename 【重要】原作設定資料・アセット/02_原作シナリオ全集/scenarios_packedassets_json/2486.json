    "command": "play_voice",
    "asset_code": "web:voice/character/31/emo_laugh-2.wav"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "ふふ。病院の景色は退屈だからね。すこしでも、変化があればと思って……♪"
