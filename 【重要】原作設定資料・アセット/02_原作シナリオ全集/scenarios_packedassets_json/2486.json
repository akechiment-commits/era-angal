    "asset_code": "web:voice/character/31/emo_joyful-2.wav"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "叔父さんの音色、好きだよ。繊細で、すごく落ち着くんだ。耳触りのいい不思議な音楽……。お母さんにも、今度聴かせてあげたいな。一時退院できたら、きっとね"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 31,
    "dress": "winter",
    "pose": "1",
    "expression": "winter_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 496
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "うん。学校も、さいきんは楽しめてるんだ。この間はオカ研の子たちと、ミステリーツアーに行ったり、クリスマス会をしたよ"
  },
  {
    "command": "talk",
    "speaker": "そら",
    "text": "プレゼントも、もらったんだよ。わたしがさっきまでつけてた手袋が、そうなんだけど……"
