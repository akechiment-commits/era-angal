    "expression": "old-treasure_expression/sad",
    "expression_position": {
      "x": 6,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（せっかく着替えたのに、ズブ濡れになっちゃうな。まぁ、走ってれば乾くと思うけど。）"
