    "expression_position": {
      "x": 6,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（かなり機能的だよね、見た目より軽いし動きやすいし最高。）"
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（靴も、まだちょっと馴染んでないけどわりと『しっくり』くる）"
