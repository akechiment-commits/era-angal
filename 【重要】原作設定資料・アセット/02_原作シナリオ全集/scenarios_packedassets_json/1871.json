    "expression_position": {
      "x": 6,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "ぼたん",
    "text": "（あの子はわたしを何だと思ってるんだろうか、『運動のできる先輩』？　う～ん……？）"
