    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「でもさ、よかったの？　夏祭り、わたしとふたりっきりで……」"
  },
  {
    "command": "talk",
