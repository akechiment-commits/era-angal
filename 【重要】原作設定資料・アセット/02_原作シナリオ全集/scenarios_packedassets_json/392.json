  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-yukata",
    "pose": 0,
    "active": true,
    "expression": "old-yukata_expression/joyful",
    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「キューピー人形に当たったらキューピーくんと呼ぶ！　決定〜っ♪」"
