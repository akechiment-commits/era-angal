    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「夏祭りは町ぐるみだもんね、賑やかさが桁ちがいだよね〜？」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 1,
    "dress": "old-yukata",
    "pose": 0,
    "active": true,
