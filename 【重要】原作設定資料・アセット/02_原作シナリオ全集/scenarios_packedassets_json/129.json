  {
    "command": "talk",
    "speaker": "なな",
    "text": "「そうそう、この先のプレハブ小屋ですーっ！」"
  },
  {
    "command": "talk",
    "speaker": "なな",
    "text": "「あたしたちチア部には決まった部室はなくって、あっちこっちで活動してるんですけど——」"
  },
  {
    "command": "talk",
    "speaker": "なな",
