    "active": true
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "せっかくなので、流れた血を絵の具にできないか……。などと試しているうちに、ぜんぜん血が止まらなくなってしまって"
  },
  {
    "command": "update_character",
    "id": "center",
