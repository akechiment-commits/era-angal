    "dress": "default",
    "pose": "1",
    "expression": "default_expression/expressionless",
    "expression_position": {
      "x": 6,
      "y": 500
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "先輩は、保健委員なのでしょうか。ふむ、たまにお手伝いをしているだけ？　保健委員のかたや、保健室の先生はいらっしゃらないのでしょうか……？"
  },
  {
    "command": "update_character",
