    "asset_code": "web:voice/character/22/habit-12.wav"
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "そうですか、困りました。ちょっと指を怪我してしまったので、手当てをしてほしかったのですけど"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 22,
    "dress": "default",
    "pose": "2",
    "expression": "default_expression/expressionless",
    "expression_position": {
      "x": 6,
      "y": 500
    },
    "active": true
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "ええ。爪が伸びていて、絵を描くときに邪魔でしたので……。鉛筆を削る用のナイフで爪を削れないか、とチャレンジしてみたら大変なことに"
  },
  {
    "command": "update_character",
    "id": "center",
