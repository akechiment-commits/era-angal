    "active": true
  },
  {
    "command": "talk",
    "speaker": "すみれ",
    "text": "いつも、同じ美術部の三波先輩から話をうかがっております。ほんとうに男のかたなのですね、ふむ……？"
  },
  {
    "command": "update_character",
