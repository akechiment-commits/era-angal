    "expression": "old-coat2_expression/joyful",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「あなたのことを別世界の才覚だと思っていたので、共感するところがあるとは思いませんでしたよ」"
  },
  {
    "command": "update_character",
    "id": "right",
