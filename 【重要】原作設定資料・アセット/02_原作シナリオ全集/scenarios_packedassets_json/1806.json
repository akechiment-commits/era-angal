    "active": true,
    "expression": "old-coat2_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「そだね～♪　ごく、ごく……いやぁ、五臓六腑に染み渡るね～♪」"
