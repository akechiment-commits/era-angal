    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「冴木さんのように絵がうまくなるには、どうしたらいいのでしょうね。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「美術の授業で『そこそこ』のものしか描けないので、困っているのです」"
