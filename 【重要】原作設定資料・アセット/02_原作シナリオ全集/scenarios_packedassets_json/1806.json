  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-coat2",
    "pose": 0,
    "active": false,
    "expression": "old-coat2_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "update_character",
    "id": "left",
