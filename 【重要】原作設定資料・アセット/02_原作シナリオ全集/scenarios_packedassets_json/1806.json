    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/sad",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「あたしにも駄目ところはたくさんあるんだけどね～？」"
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「理想の構成とか、線とか、色味とか……いくら追及しても、まだまだ足りないよ」"
