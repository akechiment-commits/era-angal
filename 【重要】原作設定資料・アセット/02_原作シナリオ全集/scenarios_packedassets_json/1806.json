  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-coat2",
    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/sad",
    "expression_position": {
      "x": -6,
      "y": 526
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「さすがに、冴木さんほどのひとになれば、もう理想には追いついているのかもしれませんが……」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
    "dress": "old-coat2",
    "pose": 0,
    "active": false,
    "expression": "old-coat2_expression/sad",
    "expression_position": {
      "x": -6,
