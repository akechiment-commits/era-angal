    "pose": 0,
    "active": true,
    "expression": "old-coat2_expression/joyful",
    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "もも",
    "text": "「氷の食堂みたいな感じだったね～？　スタッフのひとは大変そうだったけど、涼めるのはいいよね♪」"
  },
  {
    "command": "update_character",
    "id": "right",
