  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「ええ。あらかじめ上着を持ってくるようにしていて正解でしたね。」"
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「おかげでマイナス二十度の世界も楽しく過ごせそうです」"
