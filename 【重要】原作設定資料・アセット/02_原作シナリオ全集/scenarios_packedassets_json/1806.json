    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「創作意欲の塊ですね、冴木さんは。わたしには真似できないから、尊敬します」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 6,
