    "expression_position": {
      "x": -2,
      "y": 412
    }
  },
  {
    "command": "talk",
    "speaker": "ともこ",
    "text": "「たしかに、そうかもしれませんね……理想の一太刀のために、素振りを続けることも、すくなくありません」"
