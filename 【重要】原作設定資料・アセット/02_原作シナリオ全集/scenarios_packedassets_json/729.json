    }
  },
  {
    "command": "talk",
    "speaker": "むつみ",
    "text": "「八朔さん、こっちこっち！　第四走者はあっしですぜ……☆」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 68,
