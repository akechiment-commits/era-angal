  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あはは……。そう言ってもらえたら、わたしも救われるよ」"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 16,
    "dress": "old-bloomer",
