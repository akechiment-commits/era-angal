    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「こうやって、学校でみんなと一緒に過ごせるだけで、心から元気が湧いてきて……」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ああ、もっと長生きしないとな、って思うんです」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 16,
    "dress": "old-default",
    "pose": 0,
    "active": true,
    "expression": "old-default_expression/sad",
    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「ちいさなころには、ほとんど友達なんていなかったんです。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
