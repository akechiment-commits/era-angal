    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたし、こんなに幸せで、いいんですかね？　なんだか、夢みたいですよね」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「いつ死ぬか、わからない命ですけど。来年の夏も、こうやって元気に過ごせてるか、わかりませんけど」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも、今のわたしは、生きているだけで幸せなんです。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「あるがままでいられて、それを友達に理解してもらえる」"
