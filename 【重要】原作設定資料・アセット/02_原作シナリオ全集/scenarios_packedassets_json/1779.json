    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「でも、ようやく、わかってきたんです。」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「自分がどういう体調のときなら外に出られるか、」"
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「どういう生活を心掛ければ、できるだけみんなと一緒に過ごせるか」"
