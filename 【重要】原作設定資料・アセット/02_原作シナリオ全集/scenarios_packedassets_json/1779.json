    "expression_position": {
      "x": 4,
      "y": 448
    }
  },
  {
    "command": "talk",
    "speaker": "つゆり",
    "text": "「わたし、入院してばかりで、遠くからみんなの幸せそうな姿を眺めてばかりだったから。」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 16,
    "dress": "old-default",
    "pose": 0,
    "active": true,
