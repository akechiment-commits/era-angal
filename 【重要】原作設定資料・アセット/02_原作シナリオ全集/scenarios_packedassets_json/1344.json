    "pose": 0,
    "active": true,
    "expression": "old-kimono_expression/normal",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「どちらにせよ、寂しかったんでしょうね。」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「『記者』と『取材対象』の関係だったから、友達にはなれなかったのかもしれないけど」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「たしかにそこには、孤独から逃れるほんのわずかな可能性があった。だから先代は天宮を追いかけた」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 25,
