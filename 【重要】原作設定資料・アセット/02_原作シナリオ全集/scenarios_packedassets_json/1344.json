    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「といっても、天宮の行動パターンを分析したものだから、現在も当てはまるかはわからないけどね」"
