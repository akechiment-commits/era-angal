    "pose": 0,
    "active": true,
    "expression": "old-kimono_expression/sad",
    "expression_position": {
      "x": 12,
      "y": 476
    }
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「今となっては、もう、意味のないことなのかもしれないけど……」"
  },
  {
    "command": "talk",
    "speaker": "ふみ",
    "text": "「あたしは天宮に、あんたは孤独じゃないって伝えてあげたい」"
  },
  {
    "command": "update_character",
    "id": "right",
    "character": 25,
    "dress": "old-kimono",
    "pose": 0,
    "active": true,
    "expression": "old-kimono_expression/normal",
    "expression_position": {
      "x": 12,
