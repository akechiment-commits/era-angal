    }
  },
  {
    "command": "talk",
    "speaker": "みづき",
    "text": "「貴重な本が太陽に照らされないためなのかもな～？　ほら、日焼けしちゃうと読めなくなっちゃうし？」"
  },
  {
    "command": "update_character",
