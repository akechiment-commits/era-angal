    "expression_position": {
      "x": -4,
      "y": 492
    }
  },
  {
    "command": "talk",
    "speaker": "やこ",
    "text": "「とはいえ、気を抜きすぎんじゃねぇわよ」"
  },
  {
    "command": "update_character",
