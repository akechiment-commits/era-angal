    "expression_position": {
      "x": 18,
      "y": 498
    }
  },
  {
    "command": "talk",
    "speaker": "はじめ",
    "text": "（ふふ。この子、にょんにょん鳴いて子猫ちゃんみたいでかわいいなぁ～♪）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 7,
    "dress": "old-w-civvies",
    "pose": 0,
    "active": true,
    "expression": "old-w-civvies_expression/surprise",
    "expression_position": {
      "x": 28,
      "y": 474
    }
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（あっ、お姉ちゃんの悪い癖がでてる気がする！）"
  },
  {
    "command": "talk",
    "speaker": "いちか",
    "text": "（駄目なひとを無限に慈しんじゃうんだよなぁ～っ!?）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 53,
