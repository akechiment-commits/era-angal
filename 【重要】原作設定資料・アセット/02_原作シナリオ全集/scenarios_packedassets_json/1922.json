  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（でも倉庫のなかが暗くて、あたし足を滑らせちゃって）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（転校生は、咄嗟に支えてくれようとしたのよね。）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（でも転んじゃって、ついでに倉庫に置かれてたものが『どさどさ』落ちてきちゃって）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（ほとんど、生き埋めに……。転校生、落ちてきたものが頭にぶつかって失神しちゃったみたいだし。）"
  },
  {
    "command": "update_character",
