  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（えっと。桃智さんに頼まれて、転校生は花火玉を取りにこの倉庫まできたのよね。）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（あたしも手が空いてたし、一緒にきたんだけど）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（『夏祭り』の準備してる間……倉庫の整理は、あたしの仕事だったから。）"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "（花火玉の保管場所とか、わかるし。役に立てるかな、って）"
  },
  {
    "command": "update_character",
    "id": "center",
    "character": 2,
