  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「て、転校生？　大丈夫？」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「起きてよ、もう先に用意してたっていう花火の打ち上げが始まっちゃってるわ。急がないと、ねぇ転校生？」"
  },
  {
    "command": "update_character",
