    "expression_position": {
      "x": -6,
      "y": 494
    }
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「起きてよ、お願いだから。あんた、いつも困ってるひとを助けてたでしょ。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「今回だって同じよ、あんたならできるわ」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「あたし信じてるから、あたしも何度も助けてもらったから」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「沖縄で、あたしの手をあんたは握ってくれた。」"
  },
  {
    "command": "talk",
    "speaker": "さあや",
    "text": "「優しくしてくれたわ、感謝してるのよ。あれから、あたし、あんたのこと」"
