    "expression_position": {
      "x": 0,
      "y": 520
    }
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「お昼休みはずっと寝ててご飯食べないゆうちゃんに」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「『それじゃ身体に悪いよ』ってつくってたら、楽しくなっちゃって」"
  },
  {
    "command": "talk",
    "speaker": "なつみ",
    "text": "「ほら、遠慮せずに食べてよ——ん？　これ？　あぁ、ゆでたまごだけど。」"
